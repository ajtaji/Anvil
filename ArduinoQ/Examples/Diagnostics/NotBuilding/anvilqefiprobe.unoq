  AddGuid("00720665-67eb-4a99-baf7-d3c33a1c7cc9", #GN_TCP4_SB)
  AddGuid("8a219718-4ef5-4761-91c8-c0f04bda9e56", #GN_DHCP4)
  AddGuid("9d9a39d8-bd42-4a73-a4d5-8ee94be11380", #GN_DHCP4_SB)
  AddGuid("78247c57-63db-4708-99c2-a8b4a9a61f6b", #GN_MTFTP4)
  AddGuid("9e23d768-d2f3-4366-9fc3-3a7aba864374", #GN_VLAN_CONFIG)
  AddGuid("7a59b29b-910b-4171-8242-a85a0df25b5b", #GN_HTTP)
