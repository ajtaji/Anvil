; ======================================================================
;  anvilqefiprobe.unoq - Arduino UNO Q (QCM2290): WALK THE WHOLE UEFI
;                       PROTOCOL DATABASE.
;
;  WHY THIS EXISTS. The console probe (anvilqconprobe.unoq, silicon
;  2026-09-02) asked this firmware FOUR questions - ConOut, ConIn, GOP and
;  a file on the ESP - and it built exactly four GUIDs to ask them with.
;  Everything anybody has since said about what this board's firmware
;  publishes has therefore been reasoning from a U-Boot defconfig, not a
;  measurement, and the vault note that surveys the link question
;  ("Networking on the UNO Q - the link question") says so in as many
;  words:
;
;      "EFI_SIMPLE_NETWORK_PROTOCOL has never been looked for on this
;       board. Neither has EFI_MANAGED_NETWORK_PROTOCOL,
;       EFI_PXE_BASE_CODE_PROTOCOL, EFI_USB2_HC_PROTOCOL,
;       EFI_USB_IO_PROTOCOL or EFI_RNG_PROTOCOL."
;
;  The GOP result is the reason to care rather than to assume. GOP was
;  EXPECTED and came back ABSENT; the ESP write was the long shot and it
;  WORKED. This firmware does not answer to expectation.
;
;  WHAT IT DOES, AND WHAT IT DELIBERATELY DOES NOT DO.
;
;    * It enumerates EVERY handle in the firmware's handle database
;      (BootServices->LocateHandleBuffer with SearchType AllHandles) and,
;      for each one, EVERY protocol installed on it
;      (BootServices->ProtocolsPerHandle). Both are read-only queries
;      defined in UEFI 2.10 s7.3.
;
;    * It prints each GUID in canonical text form, with a NAME where this
;      file knows one, and RAW where it does not. An unnamed GUID is a
;      finding, not a gap: it is a vendor protocol nobody here has seen,
;      and the digits are what somebody looks up next.
;
;    * It then asks LocateProtocol directly for the protocols the link
;      question turns on, so the answer for each is a single status code
;      and not an inference from a list.
;
;    * If EFI_SIMPLE_NETWORK_PROTOCOL is there it READS the
;      EFI_SIMPLE_NETWORK_MODE structure - state, MAC, MTU, media
;      present. It does NOT call Start, Initialize, Transmit or Receive.
;
;    * If EFI_RNG_PROTOCOL is there it asks for 32 bytes. That is the one
;      call here with a side effect and it is the point of the exercise:
;      "a real entropy source" has been the top owed item since
;      2026-08-23 and it is the only thing keeping drbg.pi4 off this
;      board.
;
;  NO REGISTER IS TOUCHED. There is no clock write, no TLMM write, no
;  GENI access and no peripheral read anywhere in this program. Every
;  address it dereferences was handed to it by the firmware. It cannot
;  hang the bus, which is the whole reason it is cheap to run.
;
;  It reports through both proven channels - the UEFI variable sink
;  (qsink.pi4 -> AnvilQTxt) and \EFI\anvil\qefiprobe.log on the ESP - then
;  resets back to Debian, which is the default boot entry, so the board
;  always comes back.
;
;  BUILD:  bash tools/build_unoq_efiprobe.sh
; ======================================================================

EnableExplicit

; ---- Q-local backends first (they define the seams the core needs) ---
XIncludeFile "ArduinoQ/Board/memmap_q.unoq"
XIncludeFile "ArduinoQ/Board/qsink.pi4"
XIncludeFile "ArduinoQ/Board/hwtimer_q.unoq"
XIncludeFile "ArduinoQ/Board/hwinfo_q.unoq"
; ---- the board's own UEFI plumbing: QCall, QEfiInit, QEspWrite, reset --
XIncludeFile "ArduinoQ/Board/qefi_q.unoq"
; ---- portable core, reused unchanged --------------------------------
XIncludeFile "Anvil/Core/format.pbi"

; ======================================================================
;  The three EFI_BOOT_SERVICES entries qefi_q.unoq does not already name.
;  EFI_BOOT_SERVICES is a 24-byte Hdr then the function table in the
;  spec's order (UEFI 2.10 s4.4); counting from HandleProtocol at $98,
;  which is proven on this board, gives:
;
;    $130  ProtocolsPerHandle
;    $138  LocateHandleBuffer
;    $048  FreePool
; ======================================================================
#BS_FREEPOOL            = $48
#BS_PROTOCOLSPERHANDLE  = $130
#BS_LOCATEHANDLEBUFFER  = $138

; EFI_LOCATE_SEARCH_TYPE (UEFI 2.10 s7.3)
#EFI_ALL_HANDLES        = 0

; EFI_SIMPLE_NETWORK_PROTOCOL (UEFI 2.10 s24.1). Revision is a UINT64 at
; $00, then the function pointers in declaration order, then the event
; and the mode pointer.
#SNP_START        = $08
#SNP_INITIALIZE   = $18
#SNP_GETSTATUS    = $58
#SNP_TRANSMIT     = $60
#SNP_RECEIVE      = $68
#SNP_WAITFORPKT   = $70
#SNP_MODE         = $78

; EFI_SIMPLE_NETWORK_MODE (s24.1). MCastFilter is 16 EFI_MAC_ADDRESS of
; 32 bytes each, which is what puts CurrentAddress as far down as $228.
#SNM_STATE            = $000
#SNM_HWADDRSIZE       = $004
#SNM_MEDIAHDRSIZE     = $008
#SNM_MAXPACKETSIZE    = $00C
#SNM_NVRAMSIZE        = $010
#SNM_RXFILTERMASK     = $018
#SNM_RXFILTERSETTING  = $01C
#SNM_CURRENTADDRESS   = $228
#SNM_BROADCASTADDRESS = $248
#SNM_PERMANENTADDRESS = $268
#SNM_IFTYPE           = $288
#SNM_MACCHANGEABLE    = $289
#SNM_MULTIPLETX       = $28A
#SNM_MEDIAPRESENTSUP  = $28B
#SNM_MEDIAPRESENT     = $28C

; EFI_RNG_PROTOCOL (UEFI 2.10 s37.5): GetInfo then GetRNG.
#RNG_GETINFO = $00
#RNG_GETRNG  = $08

; NON_VOLATILE | BOOTSERVICE_ACCESS | RUNTIME_ACCESS, for the variable sink
#EFI_ATTR = $7

; ======================================================================
;  THE KNOWN-GUID TABLE.
;
;  Each entry is registered by its CANONICAL TEXT, parsed at run time into
;  the sixteen bytes UEFI actually compares, and carries a numeric name id
;  written ON THE SAME LINE. The id is what PutGuidName renders.
;
;  WHY TEXT AND NOT SIXTEEN POKES EACH. The four GUIDs this tree already
;  builds are 16 hand-written PokeB calls apiece; fifty-odd of those is
;  eight hundred lines in which one transposed nibble is invisible and
;  would present as "the firmware does not publish that protocol", which
;  is exactly the wrong answer to come back with. A canonical GUID string
;  can be compared against the specification character by character.
;
;  WHY AN ID AND NOT A PARALLEL NAME LIST. Two lists in the same order is
;  a synchronisation bug waiting for its first insertion. The id travels
;  on the registration line, so a name can only ever be wrong the way a
;  typo is wrong - visibly, on one line, next to the digits it belongs to.
; ======================================================================
#GN_UNKNOWN        = 0
#GN_LOADED_IMAGE   = 1
#GN_LI_DEVPATH     = 2
#GN_DEVPATH        = 3
#GN_TXT_IN         = 4
#GN_TXT_IN_EX      = 5
#GN_TXT_OUT        = 6
#GN_SIMPLE_PTR     = 7
#GN_SERIAL_IO      = 8
#GN_LOAD_FILE      = 9
#GN_LOAD_FILE2     = 10
#GN_SIMPLE_FS      = 11
#GN_DISK_IO        = 12
#GN_DISK_IO2       = 13
#GN_BLOCK_IO       = 14
#GN_BLOCK_IO2      = 15
#GN_PARTITION_INFO = 16
#GN_GOP            = 17
#GN_DRIVER_BINDING = 18
#GN_COMPONENT_NAME = 19
#GN_COMPONENT_NAME2 = 20
#GN_DP_TO_TEXT     = 21
#GN_DP_FROM_TEXT   = 22
#GN_DP_UTIL        = 23
#GN_UNICODE_COLL   = 24
#GN_UNICODE_COLL2  = 25
#GN_HII_DATABASE   = 26
#GN_HII_STRING     = 27
#GN_HII_CONFIG_RT  = 28
#GN_HII_CONFIG_ACC = 29
#GN_TCG2           = 30
#GN_DT_FIXUP       = 31
#GN_HASH2          = 32
#GN_RNG            = 33
#GN_SNP            = 34
#GN_NII            = 35
#GN_NII31          = 36
#GN_MNP            = 37
#GN_MNP_SB         = 38
#GN_PXE_BC         = 39
#GN_PXE_BC_CB      = 40
#GN_ARP            = 41
#GN_ARP_SB         = 42
#GN_IP4            = 43
#GN_IP4_SB         = 44
#GN_IP4_CONFIG2    = 45
#GN_IP6            = 46
#GN_IP6_SB         = 47
#GN_UDP4           = 48
#GN_UDP4_SB        = 49
#GN_TCP4           = 50
#GN_TCP4_SB        = 51
#GN_DHCP4          = 52
#GN_DHCP4_SB       = 53
#GN_MTFTP4         = 54
#GN_VLAN_CONFIG    = 55
#GN_HTTP           = 56
#GN_HTTP_SB        = 57
#GN_ADAPTER_INFO   = 58
#GN_USB2_HC        = 59
#GN_USB_HC         = 60
#GN_USB_IO         = 61
#GN_USBFN_IO       = 62
#GN_SCSI_PASSTHRU  = 63
#GN_NVME_PASSTHRU  = 64
#GN_BLOCK_IO_CRYPT = 65
#GN_RESET_NOTIFY   = 66

#KNOWN_MAX  = 96          ; capacity of the known table
#SEEN_MAX   = 256         ; distinct GUIDs the tally can hold

Global Dim gKGuid.b[#KNOWN_MAX * 16]
Global Dim gKId.i[#KNOWN_MAX]
Global gKN.i

Global Dim gSeenGuid.b[#SEEN_MAX * 16]
Global Dim gSeenCount.i[#SEEN_MAX]
Global gSeenN.i
Global gSeenOverflow.i

; ---- walk results -----------------------------------------------------
Global gLhbStatus.i
Global gHandleCount.i
Global gHandleBuf.i
Global gProtoTotal.i
Global gPphFailures.i

; ---- the direct answers ----------------------------------------------
Global gSnpStatus.i
Global gSnp.i
Global gRngStatus.i
Global gRng.i

; ---- SNP mode readings ------------------------------------------------
Global gSnpMode.i
Global gSnpState.i
Global gSnpHwAddrSize.i
Global gSnpMediaHdr.i
Global gSnpMaxPacket.i
Global gSnpIfType.i
Global gSnpMediaPresent.i
Global gSnpMediaPresentSup.i

; ---- RNG readings -----------------------------------------------------
Global gRngInfoStatus.i
Global gRngInfoSize.i
Global gRngGetStatus.i
Global Dim gRngBytes.b[32]
Global gRngNonZero.i

; ---- scratch ----------------------------------------------------------
Global Dim gTmpGuid.b[16]
Global Dim gCellA.b[16]
Global Dim gCellB.b[16]

; ======================================================================
;  GUID text -> the sixteen bytes UEFI compares.
;
;  A GUID's first three fields are stored LITTLE-ENDIAN and its last two
;  BIG-ENDIAN. That asymmetry is the single most common way a hand-built
;  GUID is wrong, so it is done once, here, and every entry in the table
;  is written in the same canonical form the specification prints.
; ======================================================================
Procedure.i HexDigit(c.i)
  If c >= 48 And c <= 57
    ProcedureReturn c - 48
  EndIf
  If c >= 97 And c <= 102
    ProcedureReturn c - 87
  EndIf
  If c >= 65 And c <= 70
    ProcedureReturn c - 55
  EndIf
  ProcedureReturn -1
EndProcedure

; Two hex characters at text offset p, as one byte. -1 if either is not a
; hex digit, which can only happen if a table entry is malformed - and
; BuildKnownGuids checks for exactly that rather than storing a silent 0.
Procedure.i HexPair(*s, p.i)
  Define hi.i
  Define lo.i
  hi = HexDigit(PeekB(*s + p) & $FF)
  lo = HexDigit(PeekB(*s + p + 1) & $FF)
  If hi < 0 Or lo < 0
    ProcedureReturn -1
  EndIf
  ProcedureReturn (hi << 4) | lo
EndProcedure

; GuidFromText(*s, dst) - 1 on success, 0 if the text is not a canonical
; 36-character GUID. Returning a status rather than assuming makes a
; mistyped table entry a LOUD line in the transcript instead of a protocol
; that mysteriously never matches.
Procedure.i GuidFromText(*s, dst.i)
  Define i.i
  Define v.i
  ; the four separators must be where the specification puts them
  If (PeekB(*s + 8) & $FF) <> 45
    ProcedureReturn 0
  EndIf
  If (PeekB(*s + 13) & $FF) <> 45
    ProcedureReturn 0
  EndIf
  If (PeekB(*s + 18) & $FF) <> 45
    ProcedureReturn 0
  EndIf
  If (PeekB(*s + 23) & $FF) <> 45
    ProcedureReturn 0
  EndIf
  If (PeekB(*s + 36) & $FF) <> 0
    ProcedureReturn 0
  EndIf

  ; field 1: four bytes, little-endian
  i = 0
  While i < 4
    v = HexPair(*s, 6 - i * 2)
    If v < 0
      ProcedureReturn 0
    EndIf
    PokeB(dst + i, v)
    i = i + 1
  Wend
  ; field 2: two bytes, little-endian, text at 9..12
  v = HexPair(*s, 11)
  If v < 0
    ProcedureReturn 0
  EndIf
  PokeB(dst + 4, v)
  v = HexPair(*s, 9)
  If v < 0
    ProcedureReturn 0
  EndIf
  PokeB(dst + 5, v)
  ; field 3: two bytes, little-endian, text at 14..17
  v = HexPair(*s, 16)
  If v < 0
    ProcedureReturn 0
  EndIf
  PokeB(dst + 6, v)
  v = HexPair(*s, 14)
  If v < 0
    ProcedureReturn 0
  EndIf
  PokeB(dst + 7, v)
  ; field 4: two bytes, BIG-endian, text at 19..22
  v = HexPair(*s, 19)
  If v < 0
    ProcedureReturn 0
  EndIf
  PokeB(dst + 8, v)
  v = HexPair(*s, 21)
  If v < 0
    ProcedureReturn 0
  EndIf
  PokeB(dst + 9, v)
  ; field 5: six bytes, BIG-endian, text at 24..35
  i = 0
  While i < 6
    v = HexPair(*s, 24 + i * 2)
    If v < 0
      ProcedureReturn 0
    EndIf
    PokeB(dst + 10 + i, v)
    i = i + 1
  Wend
  ProcedureReturn 1
EndProcedure

; The canonical text of a GUID sitting in memory, printed back out. The
; same asymmetry, read the other way.
Procedure PutGuidText(b.i)
  Define i.i
  PutHexLower2(PeekA(b + 3))
  PutHexLower2(PeekA(b + 2))
  PutHexLower2(PeekA(b + 1))
  PutHexLower2(PeekA(b + 0))
  UartWrite(45)
  PutHexLower2(PeekA(b + 5))
  PutHexLower2(PeekA(b + 4))
  UartWrite(45)
  PutHexLower2(PeekA(b + 7))
  PutHexLower2(PeekA(b + 6))
  UartWrite(45)
  PutHexLower2(PeekA(b + 8))
  PutHexLower2(PeekA(b + 9))
  UartWrite(45)
  i = 10
  While i < 16
    PutHexLower2(PeekA(b + i))
    i = i + 1
  Wend
EndProcedure

Procedure.i GuidEq(a.i, b.i)
  Define i.i
  i = 0
  While i < 16
    If PeekA(a + i) <> PeekA(b + i)
      ProcedureReturn 0
    EndIf
    i = i + 1
  Wend
  ProcedureReturn 1
EndProcedure

; ======================================================================
;  The table itself. Every GUID below is written in the canonical form
;  the UEFI specification (or, where noted, the EDK2 header that defines
;  it) prints, so each line can be checked against the document without
;  decoding anything.
; ======================================================================
Global gKBadEntries.i

Procedure AddGuid(*text, id.i)
  If gKN >= #KNOWN_MAX
    gKBadEntries = gKBadEntries + 1
    ProcedureReturn
  EndIf
  If GuidFromText(*text, @gKGuid[gKN * 16]) = 0
    gKBadEntries = gKBadEntries + 1
    ProcedureReturn
  EndIf
  gKId[gKN] = id
  gKN = gKN + 1
EndProcedure

Procedure BuildKnownGuids()
  gKN = 0
  gKBadEntries = 0

  ; ---- the images, the paths and the console (UEFI 2.10 s9, s10, s12) --
  AddGuid("5b1b31a1-9562-11d2-8e3f-00a0c969723b", #GN_LOADED_IMAGE)
  AddGuid("bc62157e-3e33-4fec-9920-2d3b36d750df", #GN_LI_DEVPATH)
  AddGuid("09576e91-6d3f-11d2-8e39-00a0c969723b", #GN_DEVPATH)
  AddGuid("387477c1-69c7-11d2-8e39-00a0c969723b", #GN_TXT_IN)
  AddGuid("dd9e7534-7762-4698-8c14-f58517a625aa", #GN_TXT_IN_EX)
  AddGuid("387477c2-69c7-11d2-8e39-00a0c969723b", #GN_TXT_OUT)
  AddGuid("31878c87-0b75-11d5-9a4f-0090273fc14d", #GN_SIMPLE_PTR)
  AddGuid("bb25cf6f-f1d4-11d2-9a0c-0090273fc1fd", #GN_SERIAL_IO)
  AddGuid("9042a9de-23dc-4a38-96fb-7aded080516a", #GN_GOP)

  ; ---- media access (s13) ---------------------------------------------
  AddGuid("56ec3091-954c-11d2-8e3f-00a0c969723b", #GN_LOAD_FILE)
  AddGuid("4006c0c1-fcb3-403e-996d-4a6c8724e06d", #GN_LOAD_FILE2)
  AddGuid("964e5b22-6459-11d2-8e39-00a0c969723b", #GN_SIMPLE_FS)
  AddGuid("ce345171-ba0b-11d2-8e4f-00a0c969723b", #GN_DISK_IO)
  AddGuid("151c8eae-7f2c-472c-9e54-9828194f6a88", #GN_DISK_IO2)
  AddGuid("964e5b21-6459-11d2-8e39-00a0c969723b", #GN_BLOCK_IO)
  AddGuid("a77b2472-e282-4e9f-a245-c2c0e27bbcc1", #GN_BLOCK_IO2)
  AddGuid("8cf2f62c-bc9b-4821-808d-ec9ec421a1a0", #GN_PARTITION_INFO)
  AddGuid("a00490ba-3f1a-4b4c-ab90-4fa99726a1e8", #GN_BLOCK_IO_CRYPT)

  ; ---- the driver model and its naming (s11) --------------------------
  AddGuid("18a031ab-b443-4d1a-a5c0-0c09261e9f71", #GN_DRIVER_BINDING)
  AddGuid("107a772c-d5e1-11d4-9a46-0090273fc14d", #GN_COMPONENT_NAME)
