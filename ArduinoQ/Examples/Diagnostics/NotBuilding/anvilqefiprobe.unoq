  AddGuid("e5dd1403-d622-c24e-8488-c71b17f5e802", #GN_ADAPTER_INFO)

  ; ---- USB (s17) -------------------------------------------------------
  AddGuid("3e745226-9818-45b6-a2ac-d7cd0e8ba2bc", #GN_USB2_HC)
  AddGuid("f5089266-1aa0-4953-97d8-562f0a10b4e6", #GN_USB_HC)
  AddGuid("2b2f68d6-0cd2-44cf-8e8b-bba20b1b5b75", #GN_USB_IO)
  AddGuid("32d2963a-fe5d-4f30-b633-6e5dc55803cc", #GN_USBFN_IO)

  ; ---- pass-through controllers ---------------------------------------
  AddGuid("143b7632-b81b-4cb7-abd3-b625a5b9bffe", #GN_SCSI_PASSTHRU)
  AddGuid("52c78312-8edc-4233-98f2-1a1aa5e388a5", #GN_NVME_PASSTHRU)
EndProcedure

Procedure PutGuidName(id.i)
  Select id
    Case #GN_LOADED_IMAGE    : Print("EFI_LOADED_IMAGE_PROTOCOL")
    Case #GN_LI_DEVPATH      : Print("EFI_LOADED_IMAGE_DEVICE_PATH_PROTOCOL")
    Case #GN_DEVPATH         : Print("EFI_DEVICE_PATH_PROTOCOL")
    Case #GN_TXT_IN          : Print("EFI_SIMPLE_TEXT_INPUT_PROTOCOL")
    Case #GN_TXT_IN_EX       : Print("EFI_SIMPLE_TEXT_INPUT_EX_PROTOCOL")
    Case #GN_TXT_OUT         : Print("EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL")
    Case #GN_SIMPLE_PTR      : Print("EFI_SIMPLE_POINTER_PROTOCOL")
    Case #GN_SERIAL_IO       : Print("EFI_SERIAL_IO_PROTOCOL")
    Case #GN_GOP             : Print("EFI_GRAPHICS_OUTPUT_PROTOCOL")
