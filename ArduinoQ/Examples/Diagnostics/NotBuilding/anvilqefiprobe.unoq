  AddGuid("0379be4e-d706-437d-b037-edb82fb772a4", #GN_DP_UTIL)
  AddGuid("1d85cd7f-f43d-11d2-9a0c-0090273fc14d", #GN_UNICODE_COLL)
  AddGuid("a4c751fc-23ae-4c3e-92e9-4964cf63f349", #GN_UNICODE_COLL2)
  AddGuid("9da34ae0-eaf9-4bbf-8ec3-fd60226c44be", #GN_RESET_NOTIFY)

  ; ---- HII (s33-s35) ---------------------------------------------------
  AddGuid("ef9fc172-a1b2-4693-b327-6d32fc416042", #GN_HII_DATABASE)
