  EndSelect
EndProcedure

; The name id for a GUID sitting at b, or #GN_UNKNOWN.
Procedure.i GuidNameId(b.i)
  Define i.i
  i = 0
  While i < gKN
    If GuidEq(b, @gKGuid[i * 16]) <> 0
      ProcedureReturn gKId[i]
    EndIf
    i = i + 1
  Wend
  ProcedureReturn #GN_UNKNOWN
EndProcedure

; ======================================================================
;  THE PARSER HAS AN ORACLE ON THIS BOARD, AND IT IS USED.
;
;  Everything this probe concludes rests on GuidFromText producing the
;  same sixteen bytes the firmware compares against. A parser that got
;  the little-endian/big-endian split backwards would not crash and would
;  not print anything odd - it would simply report that this firmware
;  publishes nothing, which is the answer half the vault already expects,
;  and it would be believed.
;
;  qefi_q.unoq builds two GUIDs the OLD way, sixteen PokeB calls each, and
;  both are PROVEN on this silicon: the ESP write path went through
;  EFI_LOADED_IMAGE_PROTOCOL and EFI_SIMPLE_FILE_SYSTEM_PROTOCOL on
;  2026-09-02 and returned EFI_SUCCESS at every step. So there are two
;  independently-derived byte patterns sitting in memory to check the new
;  parser against, and the check costs nothing.
; ======================================================================
Global gParseCheckLi.i
Global gParseCheckSfs.i

Procedure SelfCheckParser()
  gParseCheckLi = 0
  gParseCheckSfs = 0
  If GuidFromText("5b1b31a1-9562-11d2-8e3f-00a0c969723b", @gTmpGuid[0]) <> 0
    gParseCheckLi = GuidEq(@gTmpGuid[0], @gQLiGuid[0])
  EndIf
  If GuidFromText("964e5b22-6459-11d2-8e39-00a0c969723b", @gTmpGuid[0]) <> 0
    gParseCheckSfs = GuidEq(@gTmpGuid[0], @gQSfsGuid[0])
  EndIf
EndProcedure

Procedure PutParserVerdict()
  Print("GUID parser vs the two hand-built GUIDs proven on this board: LOADED_IMAGE ")
  If gParseCheckLi <> 0
    Print("MATCHES")
  Else
    Print("DOES NOT MATCH")
  EndIf
  Print(", SIMPLE_FILE_SYSTEM ")
  If gParseCheckSfs <> 0
    Print("MATCHES")
  Else
    Print("DOES NOT MATCH")
  EndIf
  PrintNl()
  If gParseCheckLi = 0 Or gParseCheckSfs = 0
    PrintN("!! THE GUID PARSER IN THIS PROBE IS WRONG, so every ABSENT below is meaningless - a GUID that does not match cannot be found. Do not record any conclusion from this run; fix GuidFromText and run it again.")
  EndIf
EndProcedure

; ======================================================================
;  EFI_STATUS in words. Rule: an error is a full sentence carrying its
;  code, never a bare number. An EFI error has bit 63 set, which as a
;  signed .i is simply "negative", so the top-bit literal this tree
;  avoids is never needed.
; ======================================================================
Procedure PutEfiStatus(st.i)
  Define code.i
  PutHex16(st)
  Print(" ")
  If st = 0
    Print("EFI_SUCCESS")
    ProcedureReturn
  EndIf
  If st > 0
    Print("an EFI WARNING code this probe does not name")
    ProcedureReturn
  EndIf
  code = st & $7FFFFFFFFFFFFFFF
  Select code
    Case 1  : Print("EFI_LOAD_ERROR")
    Case 2  : Print("EFI_INVALID_PARAMETER")
    Case 3  : Print("EFI_UNSUPPORTED")
    Case 4  : Print("EFI_BAD_BUFFER_SIZE")
    Case 5  : Print("EFI_BUFFER_TOO_SMALL")
    Case 6  : Print("EFI_NOT_READY")
    Case 7  : Print("EFI_DEVICE_ERROR")
    Case 8  : Print("EFI_WRITE_PROTECTED")
    Case 9  : Print("EFI_OUT_OF_RESOURCES")
    Case 12 : Print("EFI_NO_MEDIA")
    Case 14 : Print("EFI_NOT_FOUND")
    Case 15 : Print("EFI_ACCESS_DENIED")
    Case 18 : Print("EFI_TIMEOUT")
    Case 19 : Print("EFI_NOT_STARTED")
    Case 20 : Print("EFI_ALREADY_STARTED")
    Case 21 : Print("EFI_ABORTED")
    Default : Print("an EFI error code this probe does not name")
  EndSelect
EndProcedure

; ======================================================================
;  The tally - every DISTINCT GUID in the database and how many handles
;  carry it. Printed after the per-handle listing because that is the
;  shape somebody reads first: the question "does this firmware have SNP
;  anywhere at all" should not require reading forty handles.
; ======================================================================
Procedure NoteSeen(b.i)
  Define i.i
  i = 0
  While i < gSeenN
    If GuidEq(b, @gSeenGuid[i * 16]) <> 0
      gSeenCount[i] = gSeenCount[i] + 1
      ProcedureReturn
    EndIf
    i = i + 1
  Wend
  If gSeenN >= #SEEN_MAX
    gSeenOverflow = gSeenOverflow + 1
    ProcedureReturn
  EndIf
  i = 0
  While i < 16
    gSeenGuid[gSeenN * 16 + i] = PeekA(b + i)
    i = i + 1
  Wend
  gSeenCount[gSeenN] = 1
  gSeenN = gSeenN + 1
EndProcedure

; ======================================================================
;  THE WALK. LocateHandleBuffer(AllHandles) then ProtocolsPerHandle on
;  each. Both allocate a pool buffer the caller must release, and both are
;  released here - a probe that leaks the firmware's pool and then hands
;  the board back is a probe that changed what it was measuring.
; ======================================================================
Procedure WalkHandles()
  Define i.i
  Define j.i
  Define h.i
  Define st.i
  Define pcount.i
  Define pbuf.i
  Define g.i

  If gQBs = 0
    ProcedureReturn
  EndIf

  PokeI(@gCellA[0], 0)
  PokeI(@gCellB[0], 0)
  ; LocateHandleBuffer(SearchType, Protocol, SearchKey, *NoHandles, **Buffer)
  gLhbStatus = QCall(PeekI(gQBs + #BS_LOCATEHANDLEBUFFER), #EFI_ALL_HANDLES, 0, 0, @gCellA[0], @gCellB[0])
  gHandleCount = PeekI(@gCellA[0])
  gHandleBuf = PeekI(@gCellB[0])

  Print("LocateHandleBuffer(AllHandles) = ")
  PutEfiStatus(gLhbStatus)
  PrintNl()
  If gLhbStatus <> #QEFI_SUCCESS
    PrintN("The firmware would not enumerate its handle database, so the per-handle listing below is empty. Check that BootServices is the table this image was handed - it is printed at the top of this report.")
    ProcedureReturn
  EndIf
  Print("handles in the database = ")
  PrintDec(gHandleCount)
  Print("   buffer at ")
  PutHex16(gHandleBuf)
  PrintNl()
  PrintNl()

  i = 0
  While i < gHandleCount
    h = PeekI(gHandleBuf + i * 8)
    PokeI(@gCellA[0], 0)
    PokeI(@gCellB[0], 0)
    ; ProtocolsPerHandle(Handle, ***ProtocolBuffer, *ProtocolBufferCount)
    st = QCall(PeekI(gQBs + #BS_PROTOCOLSPERHANDLE), h, @gCellA[0], @gCellB[0], 0, 0)
    pbuf = PeekI(@gCellA[0])
    pcount = PeekI(@gCellB[0])

    Print("h[")
    PrintDec(i)
    Print("] ")
    PutHex16(h)
    If st <> #QEFI_SUCCESS
      gPphFailures = gPphFailures + 1
      Print("   ProtocolsPerHandle = ")
      PutEfiStatus(st)
      PrintNl()
      i = i + 1
      Continue
    EndIf
    Print("   ")
    PrintDec(pcount)
    Print(" protocol")
    If pcount <> 1
      Print("s")
    EndIf
    PrintNl()

    j = 0
    While j < pcount
      g = PeekI(pbuf + j * 8)
      If g <> 0
        gProtoTotal = gProtoTotal + 1
        NoteSeen(g)
        Print("      ")
        PutGuidText(g)
        Print("  ")
        PutGuidName(GuidNameId(g))
        PrintNl()
      EndIf
      j = j + 1
    Wend

    If pbuf <> 0
      QCall(PeekI(gQBs + #BS_FREEPOOL), pbuf, 0, 0, 0, 0)
    EndIf
    i = i + 1
  Wend

  If gHandleBuf <> 0
    QCall(PeekI(gQBs + #BS_FREEPOOL), gHandleBuf, 0, 0, 0, 0)
    gHandleBuf = 0
  EndIf
EndProcedure

Procedure PrintTally()
  Define i.i
  PrintN("-- every DISTINCT protocol GUID in the database, with how many handles carry it --")
  i = 0
  While i < gSeenN
    Print("   x")
    PrintDec(gSeenCount[i])
    Print("  ")
    PutGuidText(@gSeenGuid[i * 16])
    Print("  ")
    PutGuidName(GuidNameId(@gSeenGuid[i * 16]))
    PrintNl()
    i = i + 1
  Wend
  Print("distinct GUIDs = ")
  PrintDec(gSeenN)
  Print("   protocol instances = ")
  PrintDec(gProtoTotal)
  PrintNl()
  If gSeenOverflow > 0
    Print("!! the distinct-GUID tally filled up and dropped ")
    PrintDec(gSeenOverflow)
    PrintN(" further instances, so this list is INCOMPLETE - raise #SEEN_MAX and run it again.")
  EndIf
EndProcedure

; ======================================================================
;  Ask LocateProtocol directly for one GUID, print the verdict on one
;  line, and hand back the interface pointer (0 when absent).
; ======================================================================
Procedure.i AskFor(*text, id.i)
  Define st.i
  Define p.i
  If GuidFromText(*text, @gTmpGuid[0]) = 0
    PrintN("!! a GUID literal inside this probe is malformed and was not asked for. That is a defect in the probe, not an answer about the board.")
    ProcedureReturn 0
  EndIf
  PokeI(@gCellA[0], 0)
  st = QCall(PeekI(gQBs + #QBS_LOCATEPROTOCOL), @gTmpGuid[0], 0, @gCellA[0], 0, 0)
  p = PeekI(@gCellA[0])
  Print("   ")
  PutGuidName(id)
  PrintNl()
  Print("      ")
  If st = #QEFI_SUCCESS And p <> 0
    Print("PRESENT   interface at ")
    PutHex16(p)
    Print("   status ")
    PutEfiStatus(st)
  Else
    Print("ABSENT    status ")
    PutEfiStatus(st)
  EndIf
  PrintNl()
  If st = #QEFI_SUCCESS
    ProcedureReturn p
  EndIf
  ProcedureReturn 0
EndProcedure

Procedure AskTheQuestions()
  PrintN("-- the questions this probe exists to answer, asked one at a time --")
  PrintN("   (LocateProtocol finds the FIRST handle carrying each; absence here is absence everywhere)")
  gSnp = AskFor("a19832b9-ac25-11d3-9a2d-0090273fc14d", #GN_SNP)
  AskFor("7ab33a91-ace5-4326-b572-e7ee33d39f16", #GN_MNP)
  AskFor("f36ff770-a7e1-42cf-9ed2-56f0f271f44c", #GN_MNP_SB)
  AskFor("03c4e603-ac28-11d3-9a2d-0090273fc14d", #GN_PXE_BC)
  AskFor("1aced566-76ed-4218-bc81-767f1f977a89", #GN_NII31)
  AskFor("3e745226-9818-45b6-a2ac-d7cd0e8ba2bc", #GN_USB2_HC)
  AskFor("2b2f68d6-0cd2-44cf-8e8b-bba20b1b5b75", #GN_USB_IO)
  AskFor("32d2963a-fe5d-4f30-b633-6e5dc55803cc", #GN_USBFN_IO)
  gRng = AskFor("3152bca5-eade-433d-862e-c01cdc291f44", #GN_RNG)
  AskFor("41d94cd2-35b6-455a-8258-d4e51334aadd", #GN_IP4)
  AskFor("65530bc7-a359-410f-b010-5aadc7ec2b62", #GN_TCP4)
  AskFor("3ad9df29-4501-478d-b1f8-7f7fe70e50f3", #GN_UDP4)
  AskFor("8a219718-4ef5-4761-91c8-c0f04bda9e56", #GN_DHCP4)
  AskFor("7a59b29b-910b-4171-8242-a85a0df25b5b", #GN_HTTP)
  AskFor("bb25cf6f-f1d4-11d2-9a0c-0090273fc1fd", #GN_SERIAL_IO)
  AskFor("9042a9de-23dc-4a38-96fb-7aded080516a", #GN_GOP)
EndProcedure

; ======================================================================
;  If SNP is there, read its MODE. Nothing is started and nothing is
;  transmitted: the question at this stage is what the link IS, and a
;  Start() on a driver nobody has looked at yet is a change to the board's
;  state made before anybody knew what the board's state was.
; ======================================================================
Procedure PutMac(b.i)
  Define i.i
  i = 0
  While i < 6
    If i > 0
      UartWrite(58)
    EndIf
    PutHexLower2(PeekA(b + i))
    i = i + 1
  Wend
EndProcedure

Procedure ReadSnpMode()
  PrintN("-- EFI_SIMPLE_NETWORK_PROTOCOL detail --")
  If gSnp = 0
    PrintN("   There is no EFI_SIMPLE_NETWORK_PROTOCOL on this firmware, so this board gets no link from UEFI and Anvil must carry its own. Nothing was started and nothing was read.")
    ProcedureReturn
  EndIf
  gSnpMode = PeekI(gSnp + #SNP_MODE)
  Print("   Revision   = ")
  PutHex16(PeekI(gSnp))
  PrintNl()
  Print("   Mode ptr   = ")
  PutHex16(gSnpMode)
  PrintNl()
  If gSnpMode = 0
    PrintN("   The protocol is published with a NULL Mode pointer, which UEFI 2.10 s24.1 does not allow. Nothing further was read off it.")
    ProcedureReturn
  EndIf
  gSnpState          = PeekL(gSnpMode + #SNM_STATE) & $FFFFFFFF
  gSnpHwAddrSize     = PeekL(gSnpMode + #SNM_HWADDRSIZE) & $FFFFFFFF
  gSnpMediaHdr       = PeekL(gSnpMode + #SNM_MEDIAHDRSIZE) & $FFFFFFFF
  gSnpMaxPacket      = PeekL(gSnpMode + #SNM_MAXPACKETSIZE) & $FFFFFFFF
  gSnpIfType         = PeekA(gSnpMode + #SNM_IFTYPE)
  gSnpMediaPresentSup = PeekA(gSnpMode + #SNM_MEDIAPRESENTSUP)
  gSnpMediaPresent   = PeekA(gSnpMode + #SNM_MEDIAPRESENT)

  Print("   State      = ")
  PrintDec(gSnpState)
  Select gSnpState
    Case 0 : Print("  (EfiSimpleNetworkStopped)")
    Case 1 : Print("  (EfiSimpleNetworkStarted)")
    Case 2 : Print("  (EfiSimpleNetworkInitialized)")
    Default : Print("  (not a state UEFI 2.10 s24.1 defines)")
  EndSelect
  PrintNl()
  Print("   HwAddrSize = ")
  PrintDec(gSnpHwAddrSize)
  Print("   MediaHeader= ")
  PrintDec(gSnpMediaHdr)
  Print("   MaxPacket  = ")
  PrintDec(gSnpMaxPacket)
  PrintNl()
  Print("   IfType     = ")
  PrintDec(gSnpIfType)
  Print("   (1 = Ethernet, RFC 1700)   MediaPresentSupported=")
  PrintDec(gSnpMediaPresentSup)
  Print("   MediaPresent=")
  PrintDec(gSnpMediaPresent)
  PrintNl()
  Print("   Current MAC   = ")
  PutMac(gSnpMode + #SNM_CURRENTADDRESS)
  PrintNl()
  Print("   Permanent MAC = ")
  PutMac(gSnpMode + #SNM_PERMANENTADDRESS)
  PrintNl()
  Print("   Broadcast MAC = ")
  PutMac(gSnpMode + #SNM_BROADCASTADDRESS)
  PrintNl()
  Print("   RxFilterMask = ")
  PutHex8(PeekL(gSnpMode + #SNM_RXFILTERMASK) & $FFFFFFFF)
  Print("   RxFilterSetting = ")
  PutHex8(PeekL(gSnpMode + #SNM_RXFILTERSETTING) & $FFFFFFFF)
  PrintNl()
EndProcedure

; ======================================================================
;  If RNG is there, take 32 bytes. This is the entropy question, settled.
; ======================================================================
Procedure ReadRng()
  Define i.i
  Define n.i
  PrintN("-- EFI_RNG_PROTOCOL detail (the entropy question) --")
  If gRng = 0
    PrintN("   There is no EFI_RNG_PROTOCOL on this firmware, so the Q still has no measured entropy source and drbg.pi4 still has nothing to seed from. The SoC does carry a hardware PRNG at 0x04453000 (qcom,prng-ee) which needs GCC_PRNG_AHB_CLK, and that is a register-touching driver, which this probe deliberately is not.")
    ProcedureReturn
  EndIf
  ; GetInfo(This, *RNGAlgorithmListSize, *RNGAlgorithmList) - asked with a
  ; zero size first, which is the spec's way of being told how big the
  ; list is (it answers EFI_BUFFER_TOO_SMALL and fills in the size).
  PokeI(@gCellA[0], 0)
  gRngInfoStatus = QCall(PeekI(gRng + #RNG_GETINFO), gRng, @gCellA[0], 0, 0, 0)
  gRngInfoSize = PeekI(@gCellA[0])
  Print("   GetInfo(size=0) = ")
  PutEfiStatus(gRngInfoStatus)
  Print("   algorithm list needs ")
  PrintDec(gRngInfoSize)
  PrintN(" bytes (16 per algorithm)")

  ; GetRNG(This, *RNGAlgorithm, RNGValueLength, *RNGValue). A NULL
  ; algorithm means "the default", which every conformant implementation
  ; must provide.
  i = 0
  While i < 32
    gRngBytes[i] = 0
    i = i + 1
  Wend
  gRngGetStatus = QCall(PeekI(gRng + #RNG_GETRNG), gRng, 0, 32, @gRngBytes[0], 0)
  Print("   GetRNG(default, 32) = ")
  PutEfiStatus(gRngGetStatus)
  PrintNl()
  If gRngGetStatus <> #QEFI_SUCCESS
    PrintN("   The protocol is published but would not produce bytes, so it is not an entropy source Anvil can use yet. The status above is the whole of what the firmware said.")
    ProcedureReturn
  EndIf
  n = 0
  Print("   32 bytes  = ")
  i = 0
  While i < 32
    PutHexLower2(gRngBytes[i] & $FF)
    If gRngBytes[i] <> 0
      n = n + 1
    EndIf
    i = i + 1
  Wend
  PrintNl()
  gRngNonZero = n
  Print("   non-zero bytes = ")
  PrintDec(n)
  PrintN(" of 32   (all-zero would mean the call succeeded and produced nothing, which is a defect worth seeing)")
EndProcedure

; ======================================================================
;  The report.
; ======================================================================
Procedure EmitReport()
  QOutReset()
  PrintN("== Anvil UNO Q  UEFI PROTOCOL DATABASE WALK ==")
  PrintN("   read-only: no register is written and no peripheral is read anywhere in this program")
  PrintNl()

  Print("SystemTable = ")
  PutHex16(gQSt)
  Print("   BootServices = ")
  PutHex16(gQBs)
  PrintNl()
  Print("RuntimeSvcs = ")
  PutHex16(gQRt)
  Print("   ConOut = ")
  PutHex16(gQConOut)
  Print("   ConIn = ")
  PutHex16(gQConIn)
  PrintNl()
  Print("CurrentEL   = ")
  PrintDec((RdCurrentEl() >> 2) & 3)
  Print("   ImageBase = ")
  PutHex16(QEfiImageBase())
  Print("   ImageSize = ")
  PrintDec(QEfiImageSize())
  PrintNl()
  Print("known-GUID table = ")
  PrintDec(gKN)
  Print(" entries")
  If gKBadEntries > 0
    Print("   !! ")
    PrintDec(gKBadEntries)
    Print(" entries in this probe's own table are malformed and were dropped, so some GUIDs below will read as unnamed that should not. That is a defect in the probe.")
  EndIf
  PrintNl()
  PutParserVerdict()
  PrintNl()

  AskTheQuestions()
  PrintNl()
  ReadSnpMode()
  PrintNl()
  ReadRng()
  PrintNl()

  PrintN("-- the whole handle database, handle by handle --")
  WalkHandles()
  PrintNl()
  PrintTally()
  If gPphFailures > 0
    Print("handles whose protocol list could not be read = ")
    PrintDec(gPphFailures)
    PrintNl()
  EndIf
  PrintNl()
  Print("transcript used ")
  PrintDec(gQOutLen)
  Print(" of ")
  PrintDec(#Q_OUT_MAX)
  Print(" bytes, dropped ")
  PrintDec(gQTrunc)
  PrintNl()
  PrintN("== end of walk ==")
EndProcedure

; ======================================================================
Global Dim gVarName.b[24]      ; UTF-16LE "AnvilQTxt", 0
Global Dim gVarGuid.b[16]

Procedure BuildSinkNames()
  Define b.i
  b = @gVarName[0]
  QPb(b,0,65) :QPb(b,1,0) : QPb(b,2,110):QPb(b,3,0)
  QPb(b,4,118):QPb(b,5,0) : QPb(b,6,105):QPb(b,7,0)
  QPb(b,8,108):QPb(b,9,0) : QPb(b,10,81):QPb(b,11,0)
  QPb(b,12,84):QPb(b,13,0): QPb(b,14,120):QPb(b,15,0)
  QPb(b,16,116):QPb(b,17,0):QPb(b,18,0):QPb(b,19,0)
  ; the same vendor GUID the core proof and the console probe use
  GuidFromText("a1b2c3d4-5566-7788-99aa-bbccddeeff00", @gVarGuid[0])
EndProcedure

Procedure.i Main()
  Define ih.i
  Define st.i

  ; ---- CAPTURE x0/x1 FIRST (UEFI ImageHandle / SystemTable) ----------
  ASM
    adrp x9, global_gqih
    add  x9, x9, #:lo12:global_gqih
    str  x0, [x9]
    adrp x9, global_gqst
    add  x9, x9, #:lo12:global_gqst
    str  x1, [x9]
  EndASM

  ih = gQIh
  st = gQSt
  If QEfiInit(ih, st) = 0
    ; Nothing here is safe to touch, and there is no channel to say so on.
    ProcedureReturn 0
  EndIf

  BuildKnownGuids()
  BuildSinkNames()
  SelfCheckParser()

  QEfiOutStr("Anvil UNO Q - walking the UEFI protocol database...")

  EmitReport()

  QEspWrite("\EFI\anvil\qefiprobe.log", @gQOut[0], gQOutLen)
  QCall(PeekI(gQRt + #QRT_SETVARIABLE), @gVarName[0], @gVarGuid[0], #EFI_ATTR, gQOutLen, @gQOut[0])

  QEfiOutStr("walk complete - resetting back to Debian")
  QEfiReset()
  ProcedureReturn 0
EndProcedure
