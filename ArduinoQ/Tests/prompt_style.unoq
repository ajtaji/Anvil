; Desk-only UEFI text-attribute emission fixture. Never boot this file.
XIncludeFile "ArduinoQ/Board/qefi_q.unoq"

Procedure.i Main()
  Protected saved.i
  saved=QEfiConAttribute()
  If QEfiSetConAttribute(#QTXT_LIGHTGREEN)=0
    ProcedureReturn 1
  EndIf
  ProcedureReturn Bool(QEfiSetConAttribute(saved)=1)
EndProcedure
