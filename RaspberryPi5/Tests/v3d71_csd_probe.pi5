; v3d71_csd_probe.pi5 - step 3 of the Pi 5 GPU port: a compute dispatch on
; V3D 7.1, its program built by the 7.1 QPU packer.
;
; DIAGNOSTIC. Does not ship. Calls the libraries built -t pi5:
;   RaspberryPi4/Lib/v3d.pi4      V3dInit, the V3D MMU, the 7.1 CSD queue
;                                 ($930.., CFG7 = 0, CSDDONE bit 6)
;   RaspberryPi4/Lib/v3dqpu.pi4   the #PMF_CHIP = 2712 packer and its
;                                 register-file operand API
;
; THE PROGRAM, sixteen lanes, one workgroup - the Pi 4 CSD probe's
; (pi4V3dCsd.pi4) job in the 7.1 operand model, with no accumulators:
;
;    nop ; nop ; ldunifrf.rf0      rf0 = output base (uniform 0)
;    nop ; nop ; ldunifrf.rf1      rf1 = seed        (uniform 1)
;    eidx rf2 ; nop                rf2 = lane
;    nop ; nop                     (a gap before rf2 is read)
;    shl rf3, rf2, 2 ; nop         rf3 = lane * 4
;    or rf4, rf2, rf1 ; nop        rf4 = seed | lane
;    add rf3, rf3, rf0 ; nop       rf3 = base + lane * 4
;    nop ; mov tmud, rf4           the data
;    nop ; mov tmua, rf3           the address - this write fires the store
;    tmuwt - ; nop                 wait for it
;    + the eight-instruction thread end (last-THRSW pair, delay slots,
;      program-end THRSW, three slots)
;
; Every word is compared on the desk with tools/v3d71_qpu.py's
; pack(assemble(text)) of exactly the text above
; (tools/a64/a64_v3d71_csd_check.py).
;
; RETURN: $71 when the dispatch completed (NUM_COMPLETED moved, CSDDONE
; raised) and all sixteen words read seed | lane with nothing written past
; them. Otherwise $100 + V3dInit's error, $200 + the MMU's, $300 + the
; packer's (negated), $400 + the CSD's, $500 if CSDDONE was not raised,
; $600 + wrong words, $700 if a word past the output changed.
;
; WHERE IT RUNS: the Pi 5 monitor's low payload window (see
; v3d71_tfu_probe.pi5): image at $04000000, stack top $08000000.
;   PureMetalForge.exe --compile RaspberryPi5\Tests\v3d71_csd_probe.pi5
;       -t pi5 --entry-returns --load-addr 0x4000000 --stack-addr 0x8000000

XIncludeFile "RaspberryPi4/Lib/mailbox.pi4"
XIncludeFile "RaspberryPi4/Lib/v3d.pi4"
XIncludeFile "RaspberryPi4/Lib/v3dqpu.pi4"

#P5_UART_DR = $1F00030000
#P5_UART_FR = $1F00030018

#CP_PT       = $04400000      ; V3D page table, 16 KiB, VAs 0..$FFFFFF
#CP_PT_BYTES = 16384
#CP_ILLEGAL  = $04408000
#CP_CODE     = $04410000      ; physical pages ...
#CP_UNIF     = $04411000
#CP_OUT      = $04412000
#CP_CODE_VA  = $00010000      ; ... and the GPU's view of them
#CP_UNIF_VA  = $00011000
#CP_OUT_VA   = $00012000
#CP_PAGE     = 4096

#CP_LANES  = 16
#CP_SEED   = $A5C30000        ; low four bits clear so seed | lane is exact
#CP_POISON = $A5A5A5A5
#CP_WAIT_US = 100000

#MW_NOP  = 6                  ; magic write addresses, qpu_instr.h:88-133
#MW_TMUD = 11
#MW_TMUA = 12

Procedure PutC(c.i)
  Protected f.i
  Repeat
    f = PeekN(#P5_UART_FR)
  Until (f & 32) = 0
  PokeL(#P5_UART_DR, c)
EndProcedure

Procedure PutS(*s)
  Protected i.i
  Protected c.i
  i = 0
  Repeat
    c = PeekA(*s + i)
    If c = 0 : Break : EndIf
    PutC(c)
    i = i + 1
  ForEver
EndProcedure

Procedure PutHex(v.i, digits.i)
  Protected i.i
  Protected n.i
  For i = digits - 1 To 0 Step -1
    n = (v >> (i * 4)) & $F
    If n < 10
      PutC(48 + n)
    Else
      PutC(55 + n)
    EndIf
  Next
EndProcedure

Procedure Row(*name, v.i)
  PutS("  ") : PutS(*name) : PutS(" $") : PutHex(v, 8) : PutC(13) : PutC(10)
EndProcedure

; The program, emitted through the 7.1 operand API. Returns #V3DQ_OK or the
; packer's refusal.
Procedure.i BuildProgram()
  Protected r.i
  r = V3dQpuProgramBegin(#CP_CODE, #CP_PAGE)
  If r = #V3DQ_OK : r = V3dQpuNopSig(#V3DQ_SIG_LDUNIFRF, 0, 0) : EndIf
  If r = #V3DQ_OK : r = V3dQpuNopSig(#V3DQ_SIG_LDUNIFRF, 1, 0) : EndIf
  If r = #V3DQ_OK : r = V3dQpuAdd0(#V3DQ_A_EIDX, 2, 0) : EndIf
  If r = #V3DQ_OK : r = V3dQpuNop() : EndIf
  If r = #V3DQ_OK : r = V3dQpuAddRfImm(#V3DQ_A_SHL, 3, 0, 2, 2) : EndIf
  If r = #V3DQ_OK : r = V3dQpuAddRf2(#V3DQ_A_OR, 4, 0, 2, 1) : EndIf
  If r = #V3DQ_OK : r = V3dQpuAddRf2(#V3DQ_A_ADD, 3, 0, 3, 0) : EndIf
  If r = #V3DQ_OK : r = V3dQpuMovRf(#MW_TMUD, 1, 4) : EndIf
  If r = #V3DQ_OK : r = V3dQpuMovRf(#MW_TMUA, 1, 3) : EndIf
  If r = #V3DQ_OK : r = V3dQpuAdd0(#V3DQ_A_TMUWT, #MW_NOP, 1) : EndIf
  If r = #V3DQ_OK : r = V3dQpuThreadEnd() : EndIf
  If r = #V3DQ_OK : r = V3dQpuProgramEnd() : EndIf
  ProcedureReturn r
EndProcedure

Procedure.i Main()
  Protected r.i
  Protected i.i
  Protected bad.i
  Protected spill.i
  Protected got.i

  PutS("=== V3D 7.1 CSD PROBE (Pi 5) ===") : PutC(13) : PutC(10)

  r = V3dInit()
  Row("V3dInit           ", r)
  If r <> #V3D_OK
    ProcedureReturn $100 + r
  EndIf

  r = BuildProgram()
  Row("QPU program       ", r)
  Row("  instructions    ", V3dQpuCount())
  If r <> #V3DQ_OK
    Row("  hazard          ", V3dQpuHazardName())
    ProcedureReturn $300 - r
  EndIf

  PokeL(#CP_UNIF, #CP_OUT_VA)
  PokeL(#CP_UNIF + 4, #CP_SEED)
  For i = 0 To (#CP_PAGE / 4) - 1
    PokeL(#CP_OUT + (i * 4), #CP_POISON)
  Next

  r = V3dMmuInit(#CP_PT, #CP_PT_BYTES, #CP_ILLEGAL)
  If r = #V3D_OK : r = V3dMmuMap(#CP_CODE_VA, #CP_CODE, #CP_PAGE) : EndIf
  If r = #V3D_OK : r = V3dMmuMap(#CP_UNIF_VA, #CP_UNIF, #CP_PAGE) : EndIf
  If r = #V3D_OK : r = V3dMmuMap(#CP_OUT_VA, #CP_OUT, #CP_PAGE) : EndIf
  If r <> #V3D_OK
    Row("MMU refused       ", r)
    ProcedureReturn $200 + r
  EndIf

  ; One workgroup of sixteen, the Pi 4 probe's shape. No flags: the
  ; program is integer-only and single-threaded.
  r = V3dCsdBegin(1, 1, 1, #CP_LANES, #CP_LANES)
  If r = #V3D_OK : r = V3dCsdCode(#CP_CODE_VA, V3dQpuProgramBytes(), 0) : EndIf
  If r = #V3D_OK : r = V3dCsdUniforms(#CP_UNIF_VA, 8) : EndIf
  If r = #V3D_OK
    V3dCsdOutput(#CP_OUT_VA, #CP_PAGE)
    r = V3dCsdSubmit()
  EndIf
  If r = #V3D_OK : r = V3dCsdWait(#CP_WAIT_US) : EndIf
  Row("CSD result        ", r)
  Row("CSD_STATUS after  ", V3dCsdStatusAfter())
  Row("CTL_INT_STS       ", V3dCsdIntStsAfter())
  Row("MMU_CTL           ", V3dCsdMmuCtlAfter())
  If r <> #V3D_OK
    ProcedureReturn $400 + r
  EndIf
  If (V3dCsdIntStsAfter() & #V3D_CTL_INT_CSDDONE) = 0
    PutS("verdict: NUM_COMPLETED moved but CSDDONE was never raised") : PutC(13) : PutC(10)
    ProcedureReturn $500
  EndIf

  ; The bytes. The CPU reads the PHYSICAL page; the GPU wrote the VA.
  bad = 0
  For i = 0 To #CP_LANES - 1
    got = PeekL(#CP_OUT + (i * 4)) & $FFFFFFFF
    If got <> (#CP_SEED | i)
      bad = bad + 1
    EndIf
  Next
  spill = 0
  For i = #CP_LANES To (#CP_PAGE / 4) - 1
    If (PeekL(#CP_OUT + (i * 4)) & $FFFFFFFF) <> #CP_POISON
      spill = spill + 1
    EndIf
  Next
  Row("words wrong       ", bad)
  Row("words past output ", spill)
  If bad <> 0
    ProcedureReturn $600 + bad
  EndIf
  If spill <> 0
    ProcedureReturn $700
  EndIf
  PutS("verdict: OK - V3D 7.1 ran a 7.1-packed compute program") : PutC(13) : PutC(10)
  ProcedureReturn $71
EndProcedure
