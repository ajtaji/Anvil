; Raspberry Pi 5 first-entry diagnostic. This is a board-specific boot probe,
; not the Pi 4 monitor or a working network-capable Anvil release.
;
; The firmware selects ANVIL5.IMG from config.txt and is expected to hand the
; live FDT to x0. Its early console is the BCM2712 PL011 on the dedicated
; Pi 5 debug connector, not the RP1 header UART or the Pi 4 register map.
; The pinned Pi 5 tree selects serial10 at bus $7D001000; the /soc ranges
; translate it to CPU physical $107D001000. Before this
; address is used for anything beyond the first diagnostic, the live FDT must
; be parsed and its ranges verified on real hardware.

LoadAddress  $200000
BssAddress   $400000
StackAddress $800000

#PI5_UART_DR = $107D001000
#PI5_UART_FR = $107D001018
#PI5_UART_TXFF = $20

Global gPi5Dtb.q

Procedure Pi5PutByte(value.l)
  Define spins.l = 0
  While (PeekL(#PI5_UART_FR) & #PI5_UART_TXFF) <> 0
    spins = spins + 1
    If spins = 1000000
      ProcedureReturn
    EndIf
  Wend
  PokeL(#PI5_UART_DR, value)
EndProcedure

Procedure Pi5PutBanner()
  Pi5PutByte(65)  ; A
  Pi5PutByte(78)  ; N
  Pi5PutByte(86)  ; V
  Pi5PutByte(73)  ; I
  Pi5PutByte(76)  ; L
  Pi5PutByte(32)
  Pi5PutByte(80)  ; P
  Pi5PutByte(73)  ; I
  Pi5PutByte(53)  ; 5
  Pi5PutByte(13)
  Pi5PutByte(10)
EndProcedure

Procedure Pi5PutStatus(code.l)
  Pi5PutByte(70)  ; F
  Pi5PutByte(68)  ; D
  Pi5PutByte(84)  ; T
  Pi5PutByte(32)
  Pi5PutByte(code) ; 0 absent, 1 magic present, 2 bad magic
  Pi5PutByte(13)
  Pi5PutByte(10)
EndProcedure

Procedure Main()
  ; The A64 entry preamble and Main prologue leave x0 alone. Capture it as
  ; the first statement, before calling the serial output helpers.
  ASM
    adrp x1, global_gpi5dtb
    add  x1, x1, #:lo12:global_gpi5dtb
    str  x0, [x1]
  EndASM

  Pi5PutBanner()
  If gPi5Dtb = 0
    Pi5PutStatus(48)
  ; PeekL is signed: the loaded magic sign-extends, so mask to 32 bits before
  ; comparing or a valid FDT reads as bad magic.
  ElseIf (PeekL(gPi5Dtb) & $FFFFFFFF) = $EDFE0DD0
    Pi5PutStatus(49)
  Else
    Pi5PutStatus(50)
  EndIf

  Repeat
  ForEver
EndProcedure

Main()
