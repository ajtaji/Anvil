XIncludeFile "Anvil/Network/dns_codec.pbi"

#PAYNET_DNS_NAME=256
#PAYNET_DNS_CACHE=4
#PAYNET_DNS_CACHE_MS=300000
#PAYNET_DNS_TRY_MS=1500
#PAYNET_DNS_TRIES=3
Global Dim paynet_cacheName.a[1024]
Global Dim paynet_cacheIp.i[4]
Global Dim paynet_cacheAt.i[4]
Global Dim paynet_cacheMs.i[4]
Global Dim paynet_cacheUsed.i[4]
Global paynet_cacheNext.i
Global Dim wire.a[4096]
Procedure.i paynet_Lower(c.i)
  If c >= 65 And c <= 90
    ProcedureReturn c + 32
  EndIf
  ProcedureReturn c
EndProcedure

; Length of a NUL-terminated name, or -1 past 253 characters (RFC 1035
; 2.3.4 allows 255 octets on the wire, which is 253 characters written out).
Procedure.i paynet_NameLen(*name)
  Define i.i
  i = 0
  While (PeekA(*name + i) & $FF) <> 0
    i = i + 1
    If i > 253
      ProcedureReturn -1
    EndIf
  Wend
  ProcedureReturn i
EndProcedure

; Host names are compared without regard to case (RFC 4343).
Procedure.i paynet_SameName(*a, *b)
  Define i.i
  Define ca.i
  Define cb.i
  i = 0
  Repeat
    ca = paynet_Lower(PeekA(*a + i) & $FF)
    cb = paynet_Lower(PeekA(*b + i) & $FF)
    If ca <> cb
      ProcedureReturn 0
    EndIf
    If ca = 0
      ProcedureReturn 1
    EndIf
    i = i + 1
  Until i >= #PAYNET_DNS_NAME
  ProcedureReturn 0
EndProcedure

Procedure paynet_CopyName(*dst, *src)
  Define i.i
  Define c.i
  i = 0
  c = PeekA(*src) & $FF
  While c <> 0 And i < #PAYNET_DNS_NAME - 1
    PokeA(*dst + i, c)
    i = i + 1
    c = PeekA(*src + i) & $FF
  Wend
  PokeA(*dst + i, 0)
EndProcedure

Procedure.i paynet_CacheFind(*name, now.i)
  Define i.i
  For i = 0 To #PAYNET_DNS_CACHE - 1
    If paynet_cacheUsed[i] <> 0
      If ((now - paynet_cacheAt[i]) & $FFFFFFFF) >= paynet_cacheMs[i]
        paynet_cacheUsed[i] = 0
      ElseIf paynet_SameName(@paynet_cacheName[i * #PAYNET_DNS_NAME], *name) <> 0
        ; TTL zero is a one-delivery transaction result, never reusable.
        If paynet_cacheUsed[i]=2 : paynet_cacheUsed[i]=0 : EndIf
        ProcedureReturn paynet_cacheIp[i]
      EndIf
    EndIf
  Next
  ProcedureReturn 0
EndProcedure

Procedure paynet_CachePut(*name, ip.i, now.i, ttl.i)
  Define i.i
  Define slot.i
  slot = -1
  For i = 0 To #PAYNET_DNS_CACHE - 1
    If paynet_cacheUsed[i] <> 0
      If paynet_SameName(@paynet_cacheName[i * #PAYNET_DNS_NAME], *name) <> 0
        slot = i
      EndIf
    EndIf
  Next
  If slot < 0
    slot = paynet_cacheNext
    paynet_cacheNext = (paynet_cacheNext + 1) % #PAYNET_DNS_CACHE
  EndIf
  paynet_CopyName(@paynet_cacheName[slot * #PAYNET_DNS_NAME], *name)
  paynet_cacheIp[slot] = ip
  paynet_cacheAt[slot] = now
  If ttl<1
    paynet_cacheUsed[slot]=2
    paynet_cacheMs[slot]=#PAYNET_DNS_TRY_MS * #PAYNET_DNS_TRIES
  Else
    If ttl>#PAYNET_DNS_CACHE_MS/1000 : ttl=#PAYNET_DNS_CACHE_MS/1000 : EndIf
    paynet_cacheMs[slot]=ttl*1000
    paynet_cacheUsed[slot]=1
  EndIf
EndProcedure


Procedure Run(index.i,bytes.i,expected.i,qtype.i)
 Define i.i,p.i,rc.i
 For i=0 To bytes-1 : Read.a wire[i] : Next
 p=$E1C00100+index*64
 rc=DnsParseReplyTypeFor(@wire[0],bytes,$1234,expected,qtype)
 PokeI(p,rc) : PokeI(p+8,DnsError()) : PokeI(p+16,DnsResultCount())
 PokeI(p+24,DnsResultIp(0)) : PokeI(p+32,DnsResultTtl(0))
 PokeI(p+40,DnsResultTtl(-1)) : PokeI(p+48,DnsResultTtl(DnsResultCount()))
 p=$E1C02000+index*32
 PokeI(p,DnsResultIp6(0,p+8))
EndProcedure
Procedure Cache(index.i,ttl.i,at.i,first.i,second.i)
 Define i.i,p.i
 For i=0 To 3 : paynet_cacheUsed[i]=0 : Next
 paynet_cacheNext=0
 paynet_CachePut("example.test",$01020304,at,ttl)
 p=$E1C01000+index*32
 PokeI(p,paynet_CacheFind("EXAMPLE.TEST",first))
 PokeI(p+8,paynet_CacheFind("example.test",second))
EndProcedure
