XIncludeFile "Anvil/Kernel/Scheduler/scheduler.pbi"
XIncludeFile "Anvil/Kernel/Scheduler/cooperative_a64.pbi"
Global a.i,b.i,c.i,hook.i,count.i,nested.i,busy.i,localGood.i,hookGood.i
Global Dim trace.i[16]
Procedure Add(value.i)
 trace[count]=value : count=count+1
EndProcedure
Procedure.i TaskA()
 Define value.i
 value=ScArgument() : Add(10)
 If ScYield()=0 : ProcedureReturn -1 : EndIf
 Add(11) : ProcedureReturn value
EndProcedure
Procedure.i TaskB()
 Define value.i
 value=ScArgument()
 If hook=2 : hookGood=hookGood+1 : EndIf
 nested=Bool(ScRunHandle(a)=0) : busy=Bool(SchedTake(a)=0)
 Add(20)
 If ScYield()=0 : ProcedureReturn -2 : EndIf
 localGood=Bool(value=202)
 If hook=2 : hookGood=hookGood+1 : EndIf
 Add(21)
 If ScWait(7,500)=0 : ProcedureReturn -3 : EndIf
 If hook=2 : hookGood=hookGood+1 : EndIf
 Add(22) : ProcedureReturn value
EndProcedure
Procedure.i TaskC()
 Add(30) : ProcedureReturn ScArgument()
EndProcedure
Procedure.i Main()
 Define i.i,foreign.i,replacement.i
 For i=0 To 65535 : PokeA($04000000+i,0) : Next
 PokeI($04000000,$55445331)
PokeI($04000008,58)
PokeI($04000100+0,ScConfigure(@TaskA,@Main-@TaskA))
a=ScCreate(@TaskA,101) : b=ScCreate(@TaskB,202) : c=ScCreate(@TaskC,303)
PokeI($04000100+8,Bool(a>0 And b>0 And c>0))
hook=2
PokeI($04000100+16,Bool(ScRunHandle(b)=b))
hook=0
PokeI($04000100+24,count)
PokeI($04000100+32,trace[0])
PokeI($04000100+40,SchedState(a))
PokeI($04000100+48,SchedState(c))
PokeI($04000100+56,nested)
PokeI($04000100+64,busy)
PokeI($04000100+72,Bool(ScRunOne()=a))
PokeI($04000100+80,trace[1])
hook=2
PokeI($04000100+88,Bool(ScRunHandle(b)=b))
hook=0
PokeI($04000100+96,localGood)
PokeI($04000100+104,trace[2])
PokeI($04000100+112,SchedState(b))
PokeI($04000100+120,ScRunHandle(b))
PokeI($04000100+128,count)
PokeI($04000100+136,Bool(ScRunOne()=c))
PokeI($04000100+144,ScResult(c))
PokeI($04000100+152,ScRunHandle(c))
PokeI($04000100+160,count)
PokeI($04000100+168,Bool(ScRunOne()=a))
PokeI($04000100+176,ScResult(a))
PokeI($04000100+184,ScRunOne())
PokeI($04000100+192,SchedWake(7,1))
hook=2
PokeI($04000100+200,Bool(ScRunHandle(b)=b))
hook=0
PokeI($04000100+208,ScResult(b))
PokeI($04000100+216,hookGood)
PokeI($04000100+224,count)
PokeI($04000100+232,trace[0])
PokeI($04000100+240,trace[1])
PokeI($04000100+248,trace[2])
PokeI($04000100+256,trace[3])
PokeI($04000100+264,trace[4])
PokeI($04000100+272,trace[5])
foreign=SchedCreate()
PokeI($04000100+280,ScRunHandle(foreign))
PokeI($04000100+288,SchedState(foreign))
PokeI($04000100+296,SchedCancel(foreign))
PokeI($04000100+304,SchedReap(foreign))
PokeI($04000100+312,ScReap(b))
replacement=ScCreate(@TaskC,404)
PokeI($04000100+320,Bool(replacement<>b And replacement%32=b%32))
PokeI($04000100+328,ScRunHandle(b))
PokeI($04000100+336,SchedTake(b))
PokeI($04000100+344,SchedState(replacement))
PokeI($04000100+352,ScRunHandle(0))
PokeI($04000100+360,ScRunHandle(-1))
PokeI($04000100+368,count)
PokeI(ScStack(SchedSlot(replacement)),0)
PokeI($04000100+376,Bool(ScRunHandle(replacement)=replacement))
PokeI($04000100+384,ScResult(replacement))
PokeI($04000100+392,count)
PokeI($04000100+400,SchedState(replacement))
PokeI($04000100+408,ScReap(replacement))
PokeI($04000100+416,ScReap(a))
PokeI($04000100+424,ScReap(c))
PokeI($04000100+432,sched_count)
PokeI($04000100+440,sched_waitcount)
PokeI($04000100+448,sched_running)
PokeI($04000100+456,sc_active)
ProcedureReturn 0
EndProcedure
