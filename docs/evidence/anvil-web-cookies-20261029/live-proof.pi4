#WEB_KERNEL_BINDING=0
XIncludeFile "Anvil/Network/web_url.pbi"
XIncludeFile "Anvil/Network/web_request.pbi"
XIncludeFile "Anvil/Network/web_response.pbi"
XIncludeFile "Anvil/Network/web_transport.pbi"
XIncludeFile "Anvil/Network/web_client.pbi"
XIncludeFile "Anvil/Network/web_cookie_date.pbi"
XIncludeFile "Anvil/Network/web_cookies.pbi"
XIncludeFile "Anvil/Network/web_cookie_response.pbi"
XIncludeFile "RaspberryPi4/Lib/mmu.pi4"
Global u.WebUrl
Global q.WebRequest
Global a.WebResponse
Global client.WebClient
Global jar.WebCookies
Global Dim storage.a[4*#WEB_COOKIE_STRIDE]
Global Dim host.a[256]
Global Dim target.a[1024]
Global Dim qh.a[2048]
Global Dim ah.a[4096]
Global Dim line.a[1024]
Global Dim tx.a[512]
Global Dim rx.a[512]
Global Dim output.a[64]
Global Dim scratch.a[2048]
Global *wirePet,*wireTime
Global wtable.i
Procedure CaptureTable()
 ASM
 adrp x1, global_wtable
 add x1, x1, #:lo12:global_wtable
 str x0, [x1]
 EndASM
EndProcedure
Procedure.i Main()
 Define i.i,j.i,rc.i,start.i,n.i,v.i,p.i,step.i,length.i,k.i,now.i,captured.i,sent.i
 CaptureTable()
 For i=0 To 32767 : PokeA($E1C00000+i,0) : Next
 PokeI($E1C00000,$57434B32)
 rc=WebPayloadBind(wtable) : If rc<>0 : ProcedureReturn 1 : EndIf
 wirePet=PeekI(wtable+16+6*8) : wireTime=PeekI(wtable+16+11*8)
 MmuClearNc() : MmuAddNc($08A00000,$09200000) : MmuAddNc($08100000,$08180000)
 rc=MmuBuildTables($4F80000) : If rc<>0 : ProcedureReturn 2 : EndIf
 MmuEnableCached()
 rc=WebCookiesInit(@jar,@storage[0],4,0)
 For i=0 To 3
  p=$E1C00100+i*4096 : length=0
  u\host=@host[0] : u\hostCapacity=256 : u\target=@target[0] : u\targetCapacity=1024
  If i=0
   v="https://httpbingo.org/response-headers?Set-Cookie=anvil_session%3Dready%3B%20Path%3D%2F%3B%20Secure%3B%20HttpOnly%3B%20Max-Age%3D120"
  ElseIf i=2
   v="https://httpbingo.org/response-headers?Set-Cookie=anvil_session%3Dgone%3B%20Path%3D%2F%3B%20Secure%3B%20Max-Age%3D0"
  Else
   v="https://httpbingo.org/cookies"
  EndIf
  n=0 : While PeekA(v+n)<>0 : n=n+1 : Wend
  rc=WebUrlParse(v,n,1,@u)
  If rc=0 : rc=WebRequestInit(@q,@u,"GET",3,0,0,@qh[0],2048) : EndIf
  If rc=0 : rc=WebRequestHeader(@q,"User-Agent",10,"Anvil",5) : EndIf
  If rc=0 : rc=WebRequestHeader(@q,"Accept-Encoding",15,"identity",8) : EndIf
  sent=0
  If rc=0 And i>0
   sent=WebCookieHeader(@jar,@u,now,1,0,@scratch[0],2048)
   If sent<0 : rc=sent : EndIf
   wckWipe(@scratch[0],2048)
  EndIf
  If rc=0 : rc=WebRequestHeader(@q,"Cookie",6,"stale=discard",13) : EndIf
  If rc=0 : rc=WebRequestHeader(@q,"cOOkie",6,"duplicate=discard",17) : EndIf
  If rc=0 And i % 2=0 : rc=WebCookiesApply(@jar,@u,@q,now,1,0,@scratch[0],2048) : EndIf
  If rc=0 : rc=WebRequestFinishHeaders(@q) : EndIf
  If rc=0 And i % 2=1 : rc=WebCookiesApply(@jar,@u,@q,now,1,0,@scratch[0],2048) : EndIf
  If rc=0 : rc=WebResponseInit(@a,@line[0],1024,@ah[0],4096,0) : EndIf
  start=wireTime()/1000
  If rc=0 : rc=WebClientStart(@client,@u,@q,@a,@tx[0],512,@rx[0],512,start,20000) : EndIf
  While rc=0
   wirePet() : WebPayloadService(1)
   step=WebClientStep(@client,0,0,1,@output[0],31,wireTime()/1000)
   n=client\written
   If length+n>3072 : rc=-993 : Break : EndIf
   For j=0 To n-1 : PokeA(p+64+length+j,output[j]) : Next
   length=length+n
   If step<>0 : rc=step : Break : EndIf
  Wend
  captured=-1
  If rc=1
   n=WebResponseHeader(@a,"date",0,@scratch[0],2048)
   If n<0 : rc=n : Else : now=WebCookieDate(@scratch[0],n) : If now<0 : rc=-994 : EndIf : EndIf
   If rc=1 : captured=WebCookiesCapture(@jar,@u,@a,now,@scratch[0],2048) : If captured<0 : rc=captured : EndIf : EndIf
  EndIf
  PokeI(p,rc) : PokeI(p+8,a\status) : PokeI(p+16,wireTime()/1000-start) : PokeI(p+24,length) : PokeI(p+32,sent) : PokeI(p+40,captured) : PokeI(p+48,now)
  WebClientClose(@client) : wckWipe(@qh[0],2048) : wckWipe(@ah[0],4096) : wckWipe(@scratch[0],2048)
  If rc<0 : Break : EndIf
 Next
 PokeI($E1C00008,rc)
 rc=WebCookiesClear(@jar)
 For i=0 To 4*#WEB_COOKIE_STRIDE-1 : If storage[i]<>0 : rc=-995 : EndIf : Next
 PokeI($E1C00010,rc)
 MmuDisableCachedFlushed() : ProcedureReturn 0
EndProcedure
