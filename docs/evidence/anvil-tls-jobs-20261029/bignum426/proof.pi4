 BnJobFixture(11,?V11,32,32)
 BnJobFixture(12,?V12,48,48)
 BnJobFixture(13,?V13,48,48)
 BnJobFixture(14,?V14,48,48)
 BnJobFixture(15,?V15,66,66)
 BnJobFixture(16,?V16,66,66)
 BnJobFixture(17,?V17,66,66)
 BnJobFixture(18,?V18,128,3)
 BnJobFixture(19,?V19,128,3)
 BnJobFixture(20,?V20,128,3)
 BnJobFixture(21,?V21,256,3)
 BnJobFixture(22,?V22,256,3)
 BnJobFixture(23,?V23,256,3)
 PokeI($E1C00008,24)
 MmuDisableCachedFlushed() : ProcedureReturn 0
EndProcedure
