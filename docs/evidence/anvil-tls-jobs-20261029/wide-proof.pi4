XIncludeFile "Anvil/Crypto/bignum.pbi"
XIncludeFile "Anvil/Crypto/ec256.pbi"
XIncludeFile "Anvil/Crypto/ecp.pbi"
XIncludeFile "Anvil/Crypto/ecdsa.pbi"
XIncludeFile "RaspberryPi4/Lib/mmu.pi4"
XIncludeFile "Anvil/Crypto/bignum_job.pbi"
XIncludeFile "Anvil/Crypto/ecdsa_job.pbi"
XIncludeFile "Anvil/Crypto/ecp_job.pbi"
Global wtable.i
Global *pet,*timer
Global Dim key.a[256]
Global Dim digest.a[128]
Global Dim signature.a[512]
Procedure CaptureTable()
 ASM
 adrp x1, global_wtable
 add x1, x1, #:lo12:global_wtable
 str x0, [x1]
 EndASM
EndProcedure
Procedure Run(index.i,q.i,qn.i,h.i,hn.i,s.i,sn.i,param.i)
 Define i.i,rc.i,t.i,elapsed.i,p.i,kind.i,curve.i,err.i,stepTime.i,maxStep.i,steps.i,der.i,wide.i,rawBytes.i
 For i=0 To qn-1 : key[i]=PeekA(q+i) : Next
 For i=0 To hn-1 : digest[i]=PeekA(h+i) : Next
 For i=0 To sn-1 : signature[i]=PeekA(s+i) : Next
 pet() : kind=param & 255 : curve=(param>>24) & 255
 t=timer()
 der=1 : If kind=1 Or kind=4 : der=0 : EndIf
 wide=0 : If curve=24 Or curve=25 : wide=1 : EndIf
 stepTime=timer()
 If wide<>0
  rawBytes=sn
  For i=0 To sn-1 : PokeA(@EcdsaRsig+i,signature[i]) : Next
  If der<>0 : rawBytes=EcdsaAsn1ToRaw(@EcdsaRsig,sn) : EndIf
  If rawBytes=0
   EcpLastErr=#ECDSA_ERR_MALFORMED : EcpJobResult=0 : rc=1
  Else
   rc=EcpJobBegin(curve,@digest[0],hn,@key[0],qn,@EcdsaRsig,rawBytes)
  EndIf
 ElseIf kind=2 And curve<>23
  EcdsaJobResult=EcdsaVrfy(curve,@digest[0],hn,@key[0],qn,@signature[0],sn) : rc=1
 Else
  rc=EcdsaJobBegin(@digest[0],hn,@key[0],qn,@signature[0],sn,der)
 EndIf
 maxStep=timer()-stepTime : steps=0
 While rc=0
  stepTime=timer()
  If wide<>0 : rc=EcpJobStep() : Else : rc=EcdsaJobStep() : EndIf
  stepTime=timer()-stepTime
  If stepTime>maxStep : maxStep=stepTime : EndIf
  steps=steps+1 : pet()
 Wend
 If wide<>0 : rc=EcpJobResult : EcdsaLastErr=EcpLastErr : Else : rc=EcdsaJobResult : EndIf
 PokeI($E1C03000+index*16,maxStep) : PokeI($E1C03008+index*16,steps)
 err=EcdsaLastErr : If kind=4 : err=EcpLastErr : EndIf
 elapsed=timer()-t : p=$E1C00100+index*32
 PokeI(p,index) : PokeI(p+8,rc) : PokeI(p+16,err) : PokeI(p+24,elapsed)
EndProcedure
Procedure.i Main()
 Define i.i,rc.i
 CaptureTable()
 For i=0 To 16383 : PokeA($E1C00000+i,0) : Next
 PokeI($E1C00000,$45434431)
 pet=PeekI(wtable+16+6*8) : timer=PeekI(wtable+16+11*8)
 MmuClearNc() : MmuAddNc($08A00000,$09200000) : MmuAddNc($08100000,$08180000)
 rc=MmuBuildTables($4F80000) : If rc<>0 : ProcedureReturn 2 : EndIf
 MmuEnableCached()
