 NeighborFixture(10,?IPv6NeighborVector10,48)
 NeighborFixture(11,?IPv6NeighborVector11,80)
 NeighborFixture(12,?IPv6NeighborVector12,72)
 NeighborFixture(13,?IPv6NeighborVector13,72)
 NeighborFixture(14,?IPv6NeighborVector14,64)
 NeighborFixture(15,?IPv6NeighborVector15,72)
 NeighborFixture(16,?IPv6NeighborVector16,72)
 NeighborFixture(17,?IPv6NeighborVector17,72)
 NeighborFixture(18,?IPv6NeighborVector18,72)
 NeighborFixture(19,?IPv6NeighborVector19,56)
 NeighborFixture(20,?IPv6NeighborVector20,48)
 NeighborFixture(21,?IPv6NeighborVector21,72)
 NeighborFixture(22,?IPv6NeighborVector22,72)
 NeighborFixture(23,?IPv6NeighborVector23,80)
 NeighborFixture(24,?IPv6NeighborVector24,72)
 NeighborFixture(25,?IPv6NeighborVector25,80)
 NeighborFixture(26,?IPv6NeighborVector26,64)
 NeighborFixture(27,?IPv6NeighborVector27,80)
 NeighborFixture(28,?IPv6NeighborVector28,72)
 NeighborFixture(29,?IPv6NeighborVector29,72)
 PokeI($E1C00008,30)
 MmuDisableCachedFlushed()
 ProcedureReturn 0
EndProcedure
