XIncludeFile "Anvil/Network/ipv6_address.pbi"
XIncludeFile "Anvil/Network/ipv6_packet.pbi"
Global Dim a.a[16]
Global Dim b.a[64]
Global view.IPv6PacketView
Procedure.i Main()
 Define rc.i
 rc=IPv6AddressParse("::1",3,@a[0])
 rc=IPv6AddressFormat(@a[0],@b[0],64)
 rc=IPv6AddressPrefix(@a[0],@a[0],128)
 rc=IPv6PacketHeader(@b[0],64,@a[0],@a[0],0,59,64,0,0)
 rc=IPv6PacketParse(@b[0],40,@view)
 ProcedureReturn rc
EndProcedure
