Procedure.i HooksClear()
 ProcedureReturn Bool(X509PauseHook=0 And TlsRootsPauseHook=0 And TlsRecDecryptHook=0 And TlsRecEncryptHook=0 And Tls13PauseHook=0 And Tls13SetupPauseHook=0 And EcdsaVerifyHook=0 And RsaPublicHook=0 And X25519ComputeHook=0)
EndProcedure
Global Dim rxData.a[65536]
Global Dim rxBits.a[8192]
Global Dim txData.a[8192]
Global Dim txBits.a[2048]
Global Dim ackRanges.a[2048]
Global Dim sentSlots.a[8192]
Global Dim sentMeta.a[4096]
Global Dim originalId.a[8]
Global Dim clientId.a[8]
Global Dim peerId.a[20]
Global Dim packet.a[1472]
Global Dim output.a[1472]
