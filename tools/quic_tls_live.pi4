Global Dim tlsHs.a[32768]
Global Dim tlsRecv.a[16645]
Global Dim tlsConfig.a[48]
Global Dim localParameters.a[128]
Global Dim peerParameters.a[4096]
Global Dim parameterEntries.a[2048]
Procedure CaptureTable()
 ASM
 adrp x1, global_services
 add x1, x1, #:lo12:global_services
 str x0, [x1]
 EndASM
EndProcedure
Procedure.i Service()
 Define t.i,rc.i,cost.i
 pet() : t=clock()
 If lastPump<>0 And t-lastPump>maxPumpGap : maxPumpGap=t-lastPump : EndIf
 lastPump=t : rc=UdpPayloadService() : cost=clock()-t
 If cost>maxService : maxService=cost : EndIf
 If rc<0 : ProcedureReturn rc : EndIf
 If connection\phase=1
  rc=QuicConnectionCheckDeadline(@connection,HwMicros())
  If rc<>0 : ProcedureReturn rc : EndIf
 EndIf
 ProcedureReturn rc
EndProcedure
Procedure.i Pump()
 Define rc.i
 rc=Service()
 If rc<0 : ProcedureReturn rc : EndIf
 ProcedureReturn rc
EndProcedure
Procedure.i KeyDone(rc.i)
 Define p.i,n.i,t.i,cost.i
 If rc<>0 : ProcedureReturn rc : EndIf
 n=Tls13ContextSave(@ownerSnapshot[0],#TLS13_CONTEXT_SIZE)
 rc=QuicTlsOperationBegin(@connection\tlsOp,@ownerSnapshot[0],#TLS13_CONTEXT_SIZE,5,@connection\keyjob,connection\keyjob\keys,0,0,20000000)
 If rc<>1 : ProcedureReturn rc : EndIf
 Repeat
  TlsSliceBefore()
  t=HwMicros() : rc=QuicTlsOperationStep(@connection\tlsOp) : cost=HwMicros()-t
  TlsSliceAfter(cost)
  If rc<>0 : Break : EndIf
  p=Service() : If p<0 : rc=p : Break : EndIf
 ForEver
 If rc=1
  n=Tls13ContextRestore(@ownerSnapshot[0],#TLS13_CONTEXT_SIZE)
  If connection\tlsOp\result=1 : ProcedureReturn 0 : EndIf
  ProcedureReturn connection\tlsOp\result
 EndIf
 If connection\tlsOp\phase=1 : QuicTlsOperationCancel(@connection\tlsOp) : EndIf
 ProcedureReturn rc
EndProcedure
Procedure.i StartHandshake()
 Define rc.i,n.i,t.i,cost.i,pending.i
 rc=PrepareTlsProbe(1,0) : If rc<>1 : ProcedureReturn rc : EndIf
 rc=QuicConnectionStartBegin(@connection,20000000) : If rc<>0 : ProcedureReturn rc : EndIf
 If QuicConnectionStartBegin(@connection,20000000)<>#QUIC_START_STATE : startupFault=1 : EndIf
 If QuicConnectionSendBegin(@connection,0,0)<>#QUIC_SEND_STATE : startupFault=2 : EndIf
 If QuicConnectionReceiveBegin(@connection,0,@packet[0],1)<>#QUIC_RECEIVE_STATE : startupFault=3 : EndIf
 Repeat
  If connection\startup\phase=6 And operationProbes=1
   n=Tls13ContextRestore(@ownerSnapshot[0],#TLS13_CONTEXT_SIZE)
   rc=PrepareTlsProbe(2,@connection\initial) : If rc<>1 : ProcedureReturn rc : EndIf
  EndIf
  pending=Bool(connection\startup\phase=2 Or connection\startup\phase=5 Or connection\startup\phase=7)
  If pending : TlsSliceBefore() : EndIf
  t=HwMicros() : rc=QuicConnectionStartStep(@connection) : cost=HwMicros()-t
  If pending : TlsSliceAfter(cost) : EndIf
  startupSteps=startupSteps+1 : If cost>maxStartupStep : maxStartupStep=cost : EndIf
  n=Service() : If n<0 : ProcedureReturn n : EndIf
  If rc<>0 : Break : EndIf
 ForEver
 If rc<>1 : ProcedureReturn rc : EndIf
 If QuicConnectionStartStep(@connection)<>1 Or QuicConnectionStartBegin(@connection,20000000)<>#QUIC_START_STATE : startupFault=4 : EndIf
 If connection\initial\readKeys\ready<>1 Or connection\initial\writeKeys\ready<>1 Or connection\initial\tx\tail<=0 : startupFault=5 : EndIf
 startupChecks=1
 n=Tls13ContextRestore(@ownerSnapshot[0],#TLS13_CONTEXT_SIZE)
 ProcedureReturn 0
EndProcedure
Procedure.i SendSpace(*s.QuicConnectionSpace)
 Define rc.i,n.i,t.i,cost.i,held.i,i.i,number.i,inFlight.i
 rc=QuicConnectionSendBegin(@connection,*s\level,peerBytes)
 If rc<>0 : ProcedureReturn rc : EndIf
 Repeat
  n=Pump() : If n<0 : ProcedureReturn n : EndIf
  t=clock() : rc=QuicConnectionSendStep(@connection) : cost=clock()-t
  If cost>maxSendStep : maxSendStep=cost : EndIf
  sendSteps=sendSteps+1
  If connection\outgoing\worker\phase=1
   If TlsWorkerBegin(@otherJob,@CloseHoldEntry,0)<>#TLSWORK_BUSY : sendFault=1 : EndIf
  EndIf
  If rc=2
   If held=0
    number=connection\outgoing\number : inFlight=*s\history\inFlight
    For i=0 To 1199 : probeOutput[i]=output[i] : Next
    If QuicConnectionSendBegin(@connection,*s\level,peerBytes)<>#QUIC_SEND_STATE : sendFault=2 : EndIf
    If QuicConnectionSendAccepted(@connection,1199,clock())<>#QUIC_SEND_ARGUMENT : sendFault=3 : EndIf
    If QuicConnectionSendCompleted(@connection,0)<>#QUIC_SEND_STATE : sendFault=4 : EndIf
    If QuicConnectionSendStep(@connection)<>2 Or connection\outgoing\number<>number Or *s\history\inFlight<>inFlight : sendFault=5 : EndIf
    For i=0 To 1199 : If probeOutput[i]<>output[i] : sendFault=6 : EndIf : Next
    held=1 : sendProbes=sendProbes+1
   Else
    n=UdpPayloadSendTo(handle,@ep,QuicConnectionBuffer(@connection,16),connection\outgoing\bytes)
    If n<>#SVC_EAGAIN
     If n<1 : ProcedureReturn n : EndIf
     ; UDP returns an acceptance ticket, not a byte count. A positive ticket
     ; owns the whole datagram; acknowledge its requested length separately.
     n=QuicConnectionSendAccepted(@connection,connection\outgoing\bytes,clock())
     If n<>0 : ProcedureReturn n : EndIf
    EndIf
   EndIf
  ElseIf rc=3
   n=UdpPayloadStatus(handle,@status) : If n<>0 : ProcedureReturn n : EndIf
   If status\txState=#UDP_TX_SENT
    rc=QuicConnectionSendCompleted(@connection,0)
    If rc=1 : sent=sent+1 : initialDiscarded=connection\initialRetired : EndIf
   ElseIf status\txState=#UDP_TX_FAILED
    rc=QuicConnectionSendCompleted(@connection,status\txError)
   EndIf
  EndIf
  If rc<0 : ProcedureReturn rc : EndIf
 Until rc=1
 ProcedureReturn 0
EndProcedure
; Force an otherwise-due poll while a real ledger job holds its lock.
; This is a lifecycle refusal test, not a simulated wire timeout.
Procedure CheckRecoveryLocked(kind.i)
 Define before.QuicProbeTimer,i.i,rc.i,a.i,h.i,p.i
 a=connection\initial\history\busy : h=connection\handshake\history\busy : p=connection\applicationHistory\busy
 If a=0 And h=0 And p=0 : pollGuardFault=1 : ProcedureReturn : EndIf
 If a : pollSpaceMask=pollSpaceMask|1 : EndIf
 If h : pollSpaceMask=pollSpaceMask|2 : EndIf
 If p : pollSpaceMask=pollSpaceMask|4 : EndIf
 For i=0 To SizeOf(QuicProbeTimer)-1 : PokeA(@before+i,PeekA(@connection\recoveryTimer+i)) : Next
 rc=QuicConnectionRecoveryPoll(@connection,$7FFFFFFFFFFFFFFF)
 If rc<>#QUIC_SENT_BUSY : pollGuardFault=2 : EndIf
 For i=0 To SizeOf(QuicProbeTimer)-1
  If PeekA(@before+i)<>PeekA(@connection\recoveryTimer+i) : pollGuardFault=3 : EndIf
 Next
 If a<>connection\initial\history\busy Or h<>connection\handshake\history\busy Or p<>connection\applicationHistory\busy : pollGuardFault=4 : EndIf
 If kind=1 : pollAckChecks=pollAckChecks+1 : Else : pollLossChecks=pollLossChecks+1 : EndIf
EndProcedure
Procedure.i HandleAck(*s.QuicConnectionSpace)
 Define rc.i,n.i,phase.i,t.i,cost.i,authenticated.i
 phase=connection\acknowledge\phase
 authenticated=connection\receive\authenticated : connection\receive\authenticated=0
 rc=QuicConnectionAckBegin(@connection)
 If rc<>#QUIC_CONNECTION_ACK_STATE Or connection\acknowledge\phase<>phase Or *s\history\busy<>0 : ackFault=1 : EndIf
 connection\receive\authenticated=authenticated
 If authenticated<>1 : ackFault=7 : EndIf
 rc=QuicConnectionAckBegin(@connection)
 If rc<>0 : ProcedureReturn rc : EndIf
 If QuicConnectionAckBegin(@connection)<>#QUIC_CONNECTION_ACK_STATE : ackFault=2 : EndIf
 If QuicConnectionSendBegin(@connection,*s\level,peerBytes)<>#QUIC_SENT_BUSY : ackFault=3 : EndIf
 Repeat
  n=Pump() : If n<0 : ProcedureReturn n : EndIf
  If *s\history\busy<>0 : CheckRecoveryLocked(1) : EndIf
  t=clock() : rc=QuicConnectionAckStep(@connection) : cost=clock()-t
  ackSteps=ackSteps+1 : If cost>maxAckStep : maxAckStep=cost : EndIf
  If rc=0 And connection\receive\process\phase<>2 : ackFault=4 : EndIf
 Until rc<>0
 If rc<>1 : ProcedureReturn rc : EndIf
 If connection\receive\process\phase<>1 Or *s\history\busy<>0 : ackFault=5 : EndIf
 If QuicConnectionAckStep(@connection)<>1 Or QuicConnectionAckBegin(@connection)<>#QUIC_CONNECTION_ACK_STATE : ackFault=6 : EndIf
 If connection\acknowledge\rttSample=1
  If handshakeRttCount>=16 : ProcedureReturn -9497 : EndIf
  handshakeRttTrace[handshakeRttCount*5]=connection\ackJob\largest
  handshakeRttTrace[handshakeRttCount*5+1]=connection\incoming\receivedAt
  handshakeRttTrace[handshakeRttCount*5+2]=connection\ackJob\rttSentAt
  handshakeRttTrace[handshakeRttCount*5+3]=connection\ackJob\rttDelay
  handshakeRttTrace[handshakeRttCount*5+4]=connection\acknowledge\level
  handshakeRttCount=handshakeRttCount+1
 EndIf
 ackEvents=ackEvents+connection\acknowledge\events : ackChecks=ackChecks+1
 ProcedureReturn 0
EndProcedure
Procedure.i FeedTls(*s.QuicConnectionSpace)
 Define rc.i,n.i,t.i,cost.i,pending.i
 n=Tls13ContextSave(@ownerSnapshot[0],#TLS13_CONTEXT_SIZE)
 If operationProbes=2 : OperationProbe(3) : OperationProbe(4) : OperationProbe(5) : EndIf
 otherJob\result=773 : refusedJob\snapshot=771 : refusedJob\capacity=772 : refusedJob\worker\result=773
 rc=QuicConnectionTlsBegin(@connection,*s\level,peerBytes,20000000)
 If rc<>0 : ProcedureReturn rc : EndIf
 If QuicConnectionTlsBegin(@connection,*s\level,peerBytes,20000000)<>#QUIC_FEED_STATE : feedFault=1 : EndIf
 Repeat
  n=Pump() : If n<0 : ProcedureReturn n : EndIf
  pending=Bool(connection\tlsOp\phase=1)
  If pending : TlsSliceBefore() : EndIf
  t=HwMicros() : rc=QuicConnectionTlsStep(@connection) : cost=HwMicros()-t
  If pending : TlsSliceAfter(cost) : EndIf
  feedSteps=feedSteps+1 : If cost>maxFeedStep : maxFeedStep=cost : EndIf
 Until rc<>0
 n=Tls13ContextRestore(@ownerSnapshot[0],#TLS13_CONTEXT_SIZE)
 hsReady=Bool(connection\handshake\readKeys\ready=1 And connection\handshake\writeKeys\ready=1)
 paramsReady=connection\feed\parametersReady
 If rc<>1 : ProcedureReturn rc : EndIf
 If QuicConnectionTlsStep(@connection)<>1 : feedFault=2 : EndIf
 ProcedureReturn 0
EndProcedure
Procedure.i ApplicationCrypt(packetAddress.i,bytes.i,idBytes.i,number.i,encrypt.i)
 Define rc.i,n.i,t.i,cost.i,*keys.QuicKeys
 *keys=@connection\appRead : If encrypt : *keys=@connection\appWrite : EndIf
 rc=QuicApplicationPacketBegin(@connection\application,*keys,packetAddress,bytes,idBytes,number,encrypt)
 If rc<>0 : ProcedureReturn rc : EndIf
 If QuicApplicationPacketBegin(@connection\application,*keys,packetAddress,bytes,idBytes,number,encrypt)<>#QUIC_APP_PACKET_STATE : applicationFault=1 : EndIf
 If QuicConnectionSendBegin(@connection,0,peerBytes)<>#QUIC_SEND_STATE : applicationFault=2 : EndIf
 If connection\handshakeConfirmed=0 And QuicConnectionHandshakeDone(@connection)<>#QUIC_CONNECTION_STATE : confirmFault=1 : EndIf
 If TlsWorkerBegin(@otherJob,@CloseHoldEntry,0)<>#TLSWORK_BUSY : applicationFault=3 : EndIf
 Repeat
  t=HwMicros() : rc=QuicApplicationPacketStep(@connection\application) : cost=HwMicros()-t
  applicationSteps=applicationSteps+1 : If cost>maxApplicationStep : maxApplicationStep=cost : EndIf
  n=Service() : If n<0 : ProcedureReturn n : EndIf
 Until rc<>0
 If QuicApplicationPacketStep(@connection\application)<>rc : applicationFault=4 : EndIf
 ProcedureReturn rc
EndProcedure
Procedure.i SendApplicationPing()
 Define rc.i,n.i,t.i,cost.i,i.i
 If applicationPing<>0 Or connection\appWrite\ready<>1 : ProcedureReturn -9441 : EndIf
 applicationWriteReady=1
 controlDelay=QuicApplicationAckDelay(@connection\applicationState,HwMicros(),3)
 rc=QuicConnectionControlBegin(@connection,HwMicros(),3,1) : If rc<>0 : ProcedureReturn rc : EndIf
 If connection\controlNumber<>0 Or connection\applicationState\nextNumber<>1 : controlFault=1 : EndIf
 If QuicConnectionControlBegin(@connection,HwMicros(),3,1)<>#QUIC_CONTROL_STATE : controlFault=2 : EndIf
 If QuicConnectionControlCompleted(@connection,0)<>#QUIC_CONTROL_STATE : controlFault=3 : EndIf
 Repeat
  t=HwMicros() : rc=QuicConnectionControlStep(@connection) : cost=HwMicros()-t
  applicationSteps=applicationSteps+1 : If cost>maxApplicationStep : maxApplicationStep=cost : EndIf
  n=Service() : If n<0 : ProcedureReturn n : EndIf
 Until rc<>0
 If rc<>2 : ProcedureReturn rc : EndIf
 If QuicConnectionControlStep(@connection)<>2 Or connection\applicationState\ack\pending<>1 : controlFault=4 : EndIf
 If QuicConnectionSendBegin(@connection,2,peerBytes)<>#QUIC_SEND_STATE : controlFault=5 : EndIf
 For i=0 To connection\controlBytes-1 : controlSaved[i]=output[i] : Next
 Repeat
  n=Service() : If n<0 : ProcedureReturn n : EndIf
  rc=UdpPayloadSendTo(handle,@ep,@output[0],connection\controlBytes)
 Until rc<>#SVC_EAGAIN
 If rc<1 : ProcedureReturn rc : EndIf
 rc=QuicConnectionControlAccepted(@connection,HwMicros()) : If rc<>0 : ProcedureReturn rc : EndIf
 If QuicConnectionControlStep(@connection)<>3 Or connection\applicationState\ack\pending<>1 : controlFault=6 : EndIf
 If QuicConnectionControlAccepted(@connection,HwMicros())<>#QUIC_CONTROL_STATE : controlFault=7 : EndIf
 Repeat
  n=Service() : If n<0 : ProcedureReturn n : EndIf
  rc=UdpPayloadStatus(handle,@status) : If rc<>0 : ProcedureReturn rc : EndIf
  If status\txState=#UDP_TX_FAILED : ProcedureReturn status\txError : EndIf
 Until status\txState=#UDP_TX_SENT
 For i=0 To connection\controlBytes-1 : If controlSaved[i]<>output[i] : controlFault=8 : EndIf : Next
 rc=QuicConnectionControlCompleted(@connection,0) : If rc<>1 : ProcedureReturn rc : EndIf
 If QuicConnectionControlStep(@connection)<>1 Or connection\applicationState\ack\pending<>0 : controlFault=9 : EndIf
 If QuicConnectionControlCompleted(@connection,0)<>#QUIC_CONTROL_STATE : controlFault=10 : EndIf
 controlChecked=1 : applicationPing=1 : ProcedureReturn 0
EndProcedure

Procedure.i SendApplicationProbe(expected.i)
 Define rc.i,n.i,i.i
 If connection\applicationState\ack\pending<>0 : probeFault=1 : ProcedureReturn -9491 : EndIf
 If QuicConnectionControlBegin(@connection,HwMicros(),3,0)<>#QUIC_CONTROL_STATE : probeFault=2 : EndIf
 If QuicConnectionControlBegin(@connection,-1,3,1)<>#QUIC_CONTROL_ARGUMENT : probeFault=3 : EndIf
 If connection\applicationState\nextNumber<>expected : probeFault=4 : EndIf
 rc=QuicConnectionControlBegin(@connection,HwMicros(),3,1) : If rc<>0 : ProcedureReturn rc : EndIf
 probeNumber=connection\controlNumber : probeBytes=connection\controlBytes
 If probeNumber<>expected Or connection\applicationState\nextNumber<>expected+1 Or connection\controlHasAck<>0 Or connection\controlToken<>0 Or probeBytes<>22+peerBytes : probeFault=5 : EndIf
 Repeat
  rc=QuicConnectionControlStep(@connection)
  n=Service() : If n<0 : ProcedureReturn n : EndIf
 Until rc<>0
 If rc<>2 : ProcedureReturn rc : EndIf
 For i=0 To probeBytes-1 : controlSaved[i]=output[i] : Next
 Repeat
  n=Service() : If n<0 : ProcedureReturn n : EndIf
  rc=UdpPayloadSendTo(handle,@ep,@output[0],probeBytes)
 Until rc<>#SVC_EAGAIN
 If rc<1 : ProcedureReturn rc : EndIf
 rc=QuicConnectionControlAccepted(@connection,HwMicros()) : If rc<>0 : ProcedureReturn rc : EndIf
 If connection\recoveryTimer\armed<>1 Or connection\recoveryTimer\level<>4 : rearmFault=1 : EndIf
 If expected=2 : probeRearmDue=connection\recoveryTimer\deadline : EndIf
 If expected=3 : thirdProbeDue=connection\recoveryTimer\deadline : EndIf
 rearmChecked=rearmChecked+1
 Repeat
  n=Service() : If n<0 : ProcedureReturn n : EndIf
  rc=UdpPayloadStatus(handle,@status) : If rc<>0 : ProcedureReturn rc : EndIf
  If status\txState=#UDP_TX_FAILED : ProcedureReturn status\txError : EndIf
 Until status\txState=#UDP_TX_SENT
 For i=0 To probeBytes-1 : If controlSaved[i]<>output[i] : probeFault=6 : EndIf : Next
 rc=QuicConnectionControlCompleted(@connection,0) : If rc<>1 : ProcedureReturn rc : EndIf
 If connection\applicationState\ack\pending<>0 Or connection\applicationHistory\issued<>expected+1 Or connection\applicationHistory\first<>1 Or connection\applicationHistory\inFlight<>expected*probeBytes : probeFault=7 : EndIf
 probeChecked=1 : ProcedureReturn 0
EndProcedure
Procedure.i ConfirmHandshake()
 Define rc.i,n.i,i.i,expected.i,beforeRead.QuicKeys,beforeWrite.QuicKeys
 CheckHandshakeSecretRetirement()
 For i=0 To #TLS13_CONTEXT_SIZE-1 : retrySnapshot[i]=ownerSnapshot[i] : Next
 For i=0 To SizeOf(QuicKeys)-1
  PokeA(@beforeRead+i,PeekA(@connection\appRead+i))
  PokeA(@beforeWrite+i,PeekA(@connection\appWrite+i))
 Next
 confirmForeign=Bool(peerBytes=0)
 If confirmForeign : ForeignContext() : EndIf
 n=Tls13ContextSave(@beforeSnapshot[0],#TLS13_CONTEXT_SIZE)
 rc=TlsWorkerBegin(@closeHold,@CloseHoldEntry,0)
 If rc<>1 : confirmFault=3 : ProcedureReturn rc : EndIf
 If QuicConnectionHandshakeDone(@connection)<>#TLSWORK_BUSY Or connection\handshakeConfirmed<>0 : confirmFault=4 : EndIf
 If TlsWorkerCancel(@closeHold)<>1 : confirmFault=5 : EndIf
 rc=QuicConnectionHandshakeDone(@connection)
 If rc<>1 : confirmFault=6 : ProcedureReturn rc : EndIf
 n=Tls13ContextSave(@afterSnapshot[0],#TLS13_CONTEXT_SIZE)
 For i=0 To #TLS13_CONTEXT_SIZE-1
  expected=retrySnapshot[i]
  If (i>=272 And i<=367) Or (i>=400 And i<=463) Or (i>=528 And i<=623)
   If expected<>0 : confirmSecretPresent=confirmSecretPresent+1 : EndIf
   expected=0
  EndIf
  If ownerSnapshot[i]<>expected : confirmFault=7 : EndIf
  If confirmForeign
   If beforeSnapshot[i]<>afterSnapshot[i] : confirmFault=8 : EndIf
  Else
   If ownerSnapshot[i]<>afterSnapshot[i] : confirmFault=9 : EndIf
  EndIf
 Next
 For i=0 To SizeOf(QuicKeys)-1
  If PeekA(@connection\handshake\readKeys+i)<>0 Or PeekA(@connection\handshake\writeKeys+i)<>0 : confirmFault=10 : EndIf
  If PeekA(@connection\appRead+i)<>PeekA(@beforeRead+i) Or PeekA(@connection\appWrite+i)<>PeekA(@beforeWrite+i) : confirmFault=11 : EndIf
 Next
 If confirmSecretPresent=0 : confirmFault=12 : EndIf
 If connection\handshakeConfirmed<>1 Or connection\timeout<>0 Or connection\handshake\history\phase<>2 Or connection\handshake\history\inFlight<>0 Or connection\handshake\rx\phase<>3 Or connection\handshake\tx\phase<>3 : confirmFault=13 : EndIf
 If QuicConnectionHandshakeDone(@connection)<>1 : confirmFault=14 : EndIf
 If QuicConnectionReceiveBegin(@connection,2,@packet[0],1)<>6 : confirmFault=15 : EndIf
 If QuicConnectionSendBegin(@connection,2,peerBytes)<>#QUIC_SEND_STATE : confirmFault=16 : EndIf
 If QuicConnectionTlsBegin(@connection,2,peerBytes,20000000)<>#QUIC_FEED_STATE : confirmFault=17 : EndIf
 If QuicConnectionCheckDeadline(@connection,connection\started+20000001)<>0 : confirmFault=18 : EndIf
 If connection\applicationState\ack\count<>0 : confirmFault=19 : EndIf
 n=Tls13ContextRestore(@ownerSnapshot[0],#TLS13_CONTEXT_SIZE)
 n=Tls13ContextWipe(@retrySnapshot[0],#TLS13_CONTEXT_SIZE)
 confirmChecked=1 : ProcedureReturn 1
EndProcedure
Procedure.i PacketOne(p.i,bytes.i)
 Define rc.i,i.i,t.i,cost.i,old.i,known.i,count.i,cursor.i,n.i,receivedAt.i,eliciting.i,*s.QuicConnectionSpace
 receivedAt=datagramReceivedAt
 rc=QuicPacketRead(@connection\header,p,bytes,8) : If rc<>1 : ProcedureReturn -9307 : EndIf
 If connection\header\kind=4
  If connection\header\destinationBytes<>8 : ProcedureReturn -9308 : EndIf
  For i=0 To 7 : If PeekA(p+connection\header\destinationOffset+i)<>clientId[i] : ProcedureReturn -9309 : EndIf : Next
  If Tls13State<>#TLS13_ST_CONNECTED : ProcedureReturn -9310 : EndIf
  If connection\peerIds\phase=0
   rc=QuicConnectionPeerIdsInit(@connection,2) : If rc<>0 : ProcedureReturn rc : EndIf
   If QuicPeerIdsFind(@connection\peerIds,0)<=0 : peerIdsFault=1 : EndIf
   peerIdsChecked=1
  EndIf
  savedApplicationBytes=connection\header\packetBytes
  For i=0 To savedApplicationBytes-1 : savedApplication[i]=PeekA(p+i) : Next
  For i=0 To SizeOf(QuicKeys)-1 : PokeA(@savedApplicationKeys+i,PeekA(@connection\appRead+i)) : Next
  PokeA(p+savedApplicationBytes-1,PeekA(p+savedApplicationBytes-1)!1)
  rc=ApplicationCrypt(p,savedApplicationBytes,8,connection\applicationState\largestAuthenticated,0)
  If rc<>#QUIC_CRYPTO_AUTH : applicationFault=5 : ProcedureReturn -9442 : EndIf
  For i=0 To savedApplicationBytes-1
   old=savedApplication[i] : If i=savedApplicationBytes-1 : old=old!1 : EndIf
   If PeekA(p+i)<>old : applicationFault=6 : EndIf
  Next
  If connection\applicationState\largestAuthenticated<>-1 : applicationStateFault=2 : EndIf
  If QuicConnectionHandshakeDone(@connection)<>#QUIC_CONNECTION_STATE Or connection\handshakeConfirmed<>0 : confirmFault=2 : EndIf
  applicationBadTag=1
  For i=0 To savedApplicationBytes-1 : PokeA(p+i,savedApplication[i]) : Next
  rc=ApplicationCrypt(p,savedApplicationBytes,8,connection\applicationState\largestAuthenticated,0) : If rc<>1 : ProcedureReturn rc : EndIf
  applicationNumber=connection\application\crypto\number
  old=QuicApplicationAuthenticated(@connection\applicationState,applicationNumber)
  If old<>0 Or connection\applicationState\largestAuthenticated<>applicationNumber Or connection\applicationState\ack\count<>0 : applicationStateFault=3 : EndIf
  cursor=0
  While cursor<connection\application\crypto\plainBytes
   n=QuicApplicationFrameRead(p+connection\application\crypto\plainOffset+cursor,connection\application\crypto\plainBytes-cursor,@applicationFrame)
   If n<1 : ProcedureReturn n : EndIf
   cursor=cursor+n
   If applicationFrame\base\kind<>0 And applicationFrame\base\kind<>1 And applicationFrame\base\kind<>24 And applicationFrame\base\kind<>30 : ProcedureReturn -9471 : EndIf
   eliciting=eliciting | applicationFrame\base\eliciting
   If applicationFrame\base\kind<>0 : applicationFrames=applicationFrames+1 : EndIf
   If applicationFrame\base\kind=30
    doneSeen=1 : rc=ConfirmHandshake() : If rc<>1 : ProcedureReturn rc : EndIf
   EndIf
   If applicationFrame\base\kind=24
    rc=QuicConnectionPeerIdAdd(@connection,applicationFrame\sequence,applicationFrame\retire,applicationFrame\base\data,applicationFrame\idBytes,applicationFrame\resetToken)
    If rc<0 : ProcedureReturn rc : EndIf
    peerIdsFrames=peerIdsFrames+1
    old=QuicPeerIdsFind(@connection\peerIds,applicationFrame\sequence)
    If old<=0 : peerIdsFault=2 : ProcedureReturn -9461 : EndIf
    If PeekI(old+8)<>applicationFrame\idBytes Or PeekI(old+24)<>1 : peerIdsFault=3 : EndIf
    For i=0 To applicationFrame\idBytes-1 : If PeekA(old+32+i)<>PeekA(applicationFrame\base\data+i) : peerIdsFault=4 : EndIf : Next
    For i=0 To 15 : If PeekA(old+52+i)<>PeekA(applicationFrame\resetToken+i) : peerIdsFault=5 : EndIf : Next
    If QuicConnectionPeerIdAdd(@connection,applicationFrame\sequence,applicationFrame\retire,applicationFrame\base\data,applicationFrame\idBytes,applicationFrame\resetToken)<>0 : peerIdsFault=6 : EndIf
   EndIf
   rc=Pump() : If rc<0 : ProcedureReturn rc : EndIf
  Wend
  rc=QuicApplicationProcessed(@connection\applicationState,applicationNumber,eliciting,receivedAt)
  If rc<>1 : ProcedureReturn rc : EndIf
  controlReceipt=applicationNumber
  appAuthenticated=1 : ProcedureReturn 0
 EndIf
 If connection\header\kind=0 : *s=@connection\initial
 ElseIf connection\header\kind=2 : *s=@connection\handshake
 Else : ProcedureReturn -9311 : EndIf
 If savedReceiveBytes=0 And *s\level=0
  savedReceiveBytes=connection\header\packetBytes
  For i=0 To savedReceiveBytes-1 : savedReceive[i]=PeekA(p+i) : Next
  For i=0 To 7 : savedOriginal[i]=originalId[i] : savedClient[i]=clientId[i] : Next
 EndIf
 known=connection\peerIdKnown : count=connection\peerIdBytes
 old=PeekA(p+connection\header\destinationOffset)
 PokeA(p+connection\header\destinationOffset,old!1)
 rc=QuicConnectionReceivePacketBeginAt(@connection,p,connection\header\packetBytes,receivedAt)
 PokeA(p+connection\header\destinationOffset,old)
 If rc<>6 Or connection\peerIdKnown<>known Or connection\peerIdBytes<>count : cidFault=1 : EndIf
 If known<>0 And count>0
  old=PeekA(p+connection\header\sourceOffset)
  PokeA(p+connection\header\sourceOffset,old!1)
  rc=QuicConnectionReceivePacketBeginAt(@connection,p,connection\header\packetBytes,receivedAt)
  PokeA(p+connection\header\sourceOffset,old)
  If rc<>6 Or connection\peerIdKnown<>known Or connection\peerIdBytes<>count : cidFault=2 : EndIf
 EndIf
 rc=QuicConnectionReceivePacketBeginAt(@connection,p,connection\header\packetBytes,receivedAt)
 If rc=6 : ProcedureReturn 0 : EndIf
 If rc<>0 : ProcedureReturn rc : EndIf
 If connection\peerIdKnown<>known Or connection\peerIdBytes<>count : cidFault=3 : EndIf
 cidChecks=cidChecks+1
 Repeat
  rc=Pump() : If rc<0 : ProcedureReturn rc : EndIf
  t=clock() : rc=QuicConnectionReceiveStep(@connection) : cost=clock()-t
  receiveSteps=receiveSteps+1 : If cost>maxReceiveStep : maxReceiveStep=cost : EndIf
  If TlsWorkerOwns(@connection\incoming\worker)=1
   If QuicConnectionReceiveBegin(@connection,*s\level,p,connection\header\packetBytes)<>#QUIC_RECEIVE_STATE : receiveFault=1 : EndIf
   If QuicConnectionSendBegin(@connection,*s\level,peerBytes)<>#QUIC_SEND_STATE : receiveFault=2 : EndIf
  EndIf
  If rc=2 : rc=HandleAck(*s) : If rc=0 : rc=1 : EndIf : EndIf
 Until rc<>1
 If rc=6 : ProcedureReturn 0 : EndIf
 If rc<>4 : ProcedureReturn rc : EndIf
 If QuicConnectionReceiveStep(@connection)<>4 : receiveFault=3 : EndIf
 peerBytes=connection\peerIdBytes
 If connection\peerIdKnown<>1 Or peerBytes<>connection\header\sourceBytes : cidFault=4 : EndIf
 rc=FeedTls(*s) : If rc<>0 : ProcedureReturn rc : EndIf
 ProcedureReturn SendSpace(*s)
EndProcedure


Procedure.i CheckDeliveryRefusals()
 Define f.QuicHandshakeFrame,range.i,rc.i
 f\kind=2 : f\count=1 : f\rangeBytes=1 : f\ranges=@range : f\largest=1
 rc=QuicHandshakeSentAckBegin(@connection\applicationAck,@connection\applicationHistory,2,@f)
 If rc<>#QUIC_SENT_ARGUMENT Or connection\applicationHistory\busy<>0 : deliveryFault=3 : ProcedureReturn -9487 : EndIf
 deliveryProbes=deliveryProbes+1
 rc=QuicHandshakeSentAckBegin(@connection\applicationAck,@connection\applicationHistory,4,@f)
 If rc<>0 : ProcedureReturn rc : EndIf
 CheckRecoveryLocked(1)
 rc=QuicHandshakeSentAckStep(@connection\applicationAck)
 If rc<>#QUIC_SENT_UNSENT Or connection\applicationHistory\acked<>0 Or connection\applicationHistory\busy<>0 Or connection\applicationHistory\inFlight<>connection\controlBytes : deliveryFault=4 : ProcedureReturn -9488 : EndIf
 deliveryProbes=deliveryProbes+1 : f\largest=0
 rc=QuicHandshakeSentAckBegin(@connection\applicationAck,@connection\applicationHistory,4,@f)
 If rc<>0 : ProcedureReturn rc : EndIf
 CheckRecoveryLocked(1)
 rc=QuicHandshakeSentAckStep(@connection\applicationAck)
 If rc<>0 Or connection\applicationAck\phase<>2 Or connection\applicationHistory\acked<>0 : deliveryFault=5 : ProcedureReturn -9489 : EndIf
 CheckRecoveryLocked(1)
 rc=QuicHandshakeSentAckCancel(@connection\applicationAck)
 If rc<>#QUIC_SENT_CANCELLED Or connection\applicationHistory\busy<>0 Or connection\applicationHistory\acked<>0 Or connection\applicationHistory\inFlight<>connection\controlBytes : deliveryFault=6 : ProcedureReturn -9490 : EndIf
 deliveryProbes=deliveryProbes+1 : ProcedureReturn 0
EndProcedure

; Continue the actual exchange after TX; consume authenticated peer ACKs.
Procedure.i ReceiveApplicationAck()
 Define peerExponent.i,peerDelay.i,beforeAcked.i,*parameter.QuicParameter
 Define rc.i,n.i,i.i,p.i,bytes.i,cursor.i,used.i,pn.i,seen.i,eliciting.i,receivedAt.i,untilTime.i
 peerExponent=3 : peerDelay=25000
 *parameter=QuicParametersFind(@connection\params,10)
 If *parameter : peerExponent=*parameter\value : EndIf
 *parameter=QuicParametersFind(@connection\params,11)
 If *parameter : peerDelay=*parameter\value*1000 : EndIf
 If lossPhase=0
  rc=CheckDeliveryRefusals() : If rc<>0 : ProcedureReturn rc : EndIf
 EndIf
 untilTime=HwMicros()+3000000
 While (lossPhase=0 And applicationDelivery=0) Or (lossPhase=1 And lossAckCount<3-2*#PTO_PROBE_TEST)
  n=Service() : If n<0 : ProcedureReturn n : EndIf
  If HwMicros()>untilTime : ProcedureReturn -9481 : EndIf
  bytes=UdpPayloadReceive(handle,@info,@packet[0],1472)
  If bytes=#SVC_EAGAIN : Continue : EndIf
  If bytes<1 : ProcedureReturn bytes : EndIf
  If info\family<>4 Or info\peerPort<>55442 : ProcedureReturn -9482 : EndIf
  For i=0 To 15 : If PeekA(@info\peerAddress+i)<>PeekA(@ep\address+i) : ProcedureReturn -9483 : EndIf : Next
  p=@packet[0] : receivedAt=HwMicros()
  rc=QuicPacketRead(@connection\header,p,bytes,8) : If rc<>1 : Continue : EndIf
  If connection\header\kind<>4 : Continue : EndIf
  If connection\header\destinationBytes<>8 : ProcedureReturn -9484 : EndIf
  For i=0 To 7 : If PeekA(p+connection\header\destinationOffset+i)<>clientId[i] : ProcedureReturn -9485 : EndIf : Next
  rc=ApplicationCrypt(p,connection\header\packetBytes,8,connection\applicationState\largestAuthenticated,0)
  If rc<>1 : ProcedureReturn rc : EndIf
  pn=connection\application\crypto\number
  seen=QuicApplicationAuthenticated(@connection\applicationState,pn)
  If seen<0 : ProcedureReturn seen : EndIf
  If seen=1 : Continue : EndIf
  cursor=0 : eliciting=0
  While cursor<connection\application\crypto\plainBytes
   used=QuicApplicationFrameRead(p+connection\application\crypto\plainOffset+cursor,connection\application\crypto\plainBytes-cursor,@applicationFrame)
   If used<1 : ProcedureReturn used : EndIf
   cursor=cursor+used : eliciting=eliciting | applicationFrame\base\eliciting
   If applicationFrame\base\kind=0 Or applicationFrame\base\kind=1
    ElseIf applicationFrame\base\kind=2 Or applicationFrame\base\kind=3
     beforeAcked=connection\applicationHistory\acked
     rc=QuicHandshakeSentAckBegin(@connection\applicationAck,@connection\applicationHistory,4,@applicationFrame\base)
     If rc<>0 : ProcedureReturn rc : EndIf
     Repeat
      CheckRecoveryLocked(1)
      rc=QuicHandshakeSentAckStep(@connection\applicationAck) : deliverySteps=deliverySteps+1
      If rc=1
       If lossPhase=1
        lossAckCount=lossAckCount+1
        If connection\applicationAck\number<2 Or connection\applicationAck\number>4 Or connection\applicationAck\packetBytes<>probeBytes Or connection\applicationAck\inFlightBytes<>probeBytes : lossFault=1 : EndIf
       Else
       deliveryEvents=deliveryEvents+1
       If connection\applicationAck\number<>0 Or connection\applicationAck\packetBytes<>connection\controlBytes Or connection\applicationAck\inFlightBytes<>connection\controlBytes : deliveryFault=1 : EndIf
       EndIf
      EndIf
      n=Service() : If n<0 : ProcedureReturn n : EndIf
     Until rc=2 Or rc<0
     If rc<>2 : ProcedureReturn rc : EndIf
     rc=QuicRttAck(@connection\recoveryRtt,@connection\applicationAck,receivedAt,peerExponent,peerDelay,connection\handshakeConfirmed)
     If rc<0 : ProcedureReturn rc : EndIf
     If rc=1
      If rttSamples<4
       rttTrace[rttSamples*8]=connection\applicationAck\largest
       rttTrace[rttSamples*8+1]=receivedAt : rttTrace[rttSamples*8+2]=connection\applicationAck\rttSentAt
       rttTrace[rttSamples*8+3]=connection\applicationAck\rttDelay
       rttTrace[rttSamples*8+4]=peerExponent : rttTrace[rttSamples*8+5]=peerDelay
       rttTrace[rttSamples*8+6]=4 : rttTrace[rttSamples*8+7]=connection\handshakeConfirmed
      Else
       rttFault=1
      EndIf
      rttSamples=rttSamples+1
     EndIf
     rc=QuicConnectionRecoveryRearm(@connection,Bool(connection\applicationHistory\acked>beforeAcked And connection\handshakeConfirmed=1))
     If rc<0 : ProcedureReturn rc : EndIf
     If lossPhase=1 : ackRearmDue=connection\recoveryTimer\deadline : EndIf
     If lossPhase=0 And connection\applicationHistory\acked=1
      If connection\applicationHistory\inFlight<>0 Or connection\applicationHistory\largestAcked<>0 : deliveryFault=2 : EndIf
      applicationDelivery=1 : deliveryNumber=pn
      rc=QuicHandshakeSentPrune(@connection\applicationHistory,64)
      If rc<>1 Or connection\applicationHistory\first<>1 Or connection\applicationHistory\issued<>1 : deliveryFault=7 : EndIf
     EndIf
    ElseIf applicationFrame\base\kind=24
     rc=QuicConnectionPeerIdAdd(@connection,applicationFrame\sequence,applicationFrame\retire,applicationFrame\base\data,applicationFrame\idBytes,applicationFrame\resetToken)
     If rc<0 : ProcedureReturn rc : EndIf
    ElseIf applicationFrame\base\kind=30
     rc=QuicConnectionHandshakeDone(@connection) : If rc<>1 : ProcedureReturn rc : EndIf
    Else
     ProcedureReturn -9486
   EndIf
  Wend
  rc=QuicApplicationProcessed(@connection\applicationState,pn,eliciting,receivedAt)
  If rc<>1 : ProcedureReturn rc : EndIf
 Wend
 ProcedureReturn 0
EndProcedure

; Real missing-datagram proof. Legacy mode uses three later deliveries; PTO
; modes wait for deadlines, with optional consecutive encrypted datagram drops.
Procedure.i CheckProbeLoss()
 Define rc.i,n.i,i.i,highest.i,delay.i
 highest=4-2*#PTO_PROBE_TEST+#REPEAT_PROBE_TEST
 If #PTO_PROBE_TEST
  timerBase=QuicHandshakeSentProbeTime(@connection\applicationHistory)
  If connection\recoveryTimer\armed<>1 Or connection\recoveryTimer\level<>4 : ProcedureReturn -9493 : EndIf
  timerDue=connection\recoveryTimer\deadline
  Repeat
   n=Service() : If n<0 : QuicProbeTimerDiscard(@connection\recoveryTimer) : ProcedureReturn n : EndIf
   timerFired=HwMicros() : rc=QuicConnectionRecoveryPoll(@connection,timerFired)
  Until rc<>0
  If rc<>1 : ProcedureReturn rc : EndIf
  timerCount=timerCount+1
  If connection\recoveryTimer\level<>4 Or connection\recoveryTimer\backoff<>1 Or timerFired<timerDue : timerFault=1 : EndIf
  If QuicConnectionRecoveryPoll(@connection,HwMicros())<>0 : timerFault=2 : EndIf
  If connection\applicationHistory\inFlight<>probeBytes Or connection\applicationHistory\acked<>1 : timerFault=3 : EndIf
 EndIf
 For i=2 To highest
  If #REPEAT_PROBE_TEST And i=3
   repeatBase=QuicHandshakeSentProbeTime(@connection\applicationHistory)
   repeatDue=connection\recoveryTimer\deadline
   If connection\recoveryTimer\armed<>1 Or connection\recoveryTimer\backoff<>1 : timerFault=6 : EndIf
   Repeat
    n=Service() : If n<0 : ProcedureReturn n : EndIf
    repeatFired=HwMicros() : rc=QuicConnectionRecoveryPoll(@connection,repeatFired)
   Until rc<>0
   If rc<>1 : ProcedureReturn rc : EndIf
   timerCount=timerCount+1
   If connection\recoveryTimer\backoff<>2 Or connection\recoveryTimer\level<>4 Or repeatFired<repeatDue : timerFault=7 : EndIf
   If connection\applicationHistory\inFlight<>2*probeBytes Or connection\applicationHistory\acked<>1 : timerFault=8 : EndIf
   If QuicConnectionRecoveryPoll(@connection,HwMicros())<>0 : timerFault=9 : EndIf
  EndIf
  rc=SendApplicationProbe(i) : If rc<>0 : ProcedureReturn rc : EndIf
 Next
 rc=QuicConnectionLossBegin(@connection,4,HwMicros(),$7FFFFFFFFFFFFFFF,3)
 If rc<>0 : ProcedureReturn rc : EndIf
 If connection\applicationHistory\busy<>0 : CheckRecoveryLocked(2) : EndIf
 rc=QuicConnectionLossStep(@connection)
 If rc<>2 Or connection\applicationHistory\inFlight<>highest*probeBytes : lossFault=2 : EndIf
 If connection\recoveryLoss\phase=1 : QuicHandshakeSentLossCancel(@connection\recoveryLoss) : ProcedureReturn -9492 : EndIf
 lossPhase=1
 rc=ReceiveApplicationAck() : If rc<>0 : ProcedureReturn rc : EndIf
 If lossAckCount<>highest-1-#REPEAT_PROBE_TEST Or connection\applicationHistory\acked<>highest-#REPEAT_PROBE_TEST Or connection\applicationHistory\largestAcked<>highest Or connection\applicationHistory\inFlight<>(1+#REPEAT_PROBE_TEST)*probeBytes : lossFault=3 : EndIf
 delay=$7FFFFFFFFFFFFFFF
 If #PTO_PROBE_TEST
  delay=QuicRttLossDelay(@connection\recoveryRtt)
  If connection\recoveryTimer\backoff<>0 : timerFault=4 : EndIf
  lossDispatchAt=HwMicros()
  rc=QuicConnectionRecoveryPoll(@connection,lossDispatchAt)
  If rc<>#QUIC_RECOVERY_LOSS Or connection\recoveryLevel<>4 : ProcedureReturn -9494 : EndIf
  If connection\applicationHistory\inFlight<>(1+#REPEAT_PROBE_TEST)*probeBytes Or connection\recoveryTimer\backoff<>0 : ProcedureReturn -9495 : EndIf
  rc=QuicConnectionLossBegin(@connection,connection\recoveryLevel,lossDispatchAt,delay,3)
  lossDispatchChecked=1
 Else
  rc=QuicConnectionLossBegin(@connection,4,HwMicros(),delay,3)
 EndIf
 If rc<>0 : ProcedureReturn rc : EndIf
 Repeat
  If connection\applicationHistory\busy<>0 : CheckRecoveryLocked(2) : EndIf
  rc=QuicConnectionLossStep(@connection)
  If rc=1
   lossEvents=lossEvents+1
   If connection\recoveryLoss\number<>lossEvents Or connection\recoveryLoss\packetBytes<>probeBytes Or connection\recoveryLoss\inFlightBytes<>probeBytes Or connection\recoveryLoss\sentAt<=0 : lossFault=4 : EndIf
  EndIf
  n=Service()
  If n<0
   If connection\recoveryLoss\phase=1 : QuicHandshakeSentLossCancel(@connection\recoveryLoss) : EndIf
   ProcedureReturn n
  EndIf
 Until rc=2 Or rc<0
 If rc<>2 : ProcedureReturn rc : EndIf
 If lossEvents<>1+#REPEAT_PROBE_TEST Or connection\applicationHistory\inFlight<>0 Or connection\applicationHistory\busy<>0 : lossFault=5 : EndIf
 If #PTO_PROBE_TEST
  If connection\recoveryTimer\armed<>0 : timerFault=5 : EndIf
  lossDispatchDone=HwMicros()
  If QuicConnectionRecoveryPoll(@connection,lossDispatchDone)<>0 : ProcedureReturn -9496 : EndIf
 EndIf
 rc=QuicHandshakeSentPrune(@connection\applicationHistory,64)
 If rc<>0 Or connection\applicationHistory\first<>1 Or connection\applicationHistory\issued<>highest+1 : lossFault=6 : EndIf
 rc=QuicConnectionLossBegin(@connection,4,HwMicros(),$7FFFFFFFFFFFFFFF,3)
 If rc<>0 : ProcedureReturn rc : EndIf
 If connection\applicationHistory\busy<>0 : CheckRecoveryLocked(2) : EndIf
 rc=QuicConnectionLossStep(@connection)
 If rc<>2 Or connection\applicationHistory\inFlight<>0 : lossFault=7 : EndIf
 If connection\recoveryLoss\phase=1 : QuicHandshakeSentLossCancel(@connection\recoveryLoss) : ProcedureReturn -9493 : EndIf
 lossChecked=1 : ProcedureReturn 0
EndProcedure

 ; Isolated scheduler unit cases with synthetic timestamps and ledgers.
; They do not authenticate packets, own a socket or alter the live connection.
Procedure PriorityAssert(actual.i,wanted.i)
 priorityChecks=priorityChecks+1
 If actual<>wanted And priorityFault=0
  priorityFault=priorityChecks : priorityActual=actual : priorityWanted=wanted
 EndIf
EndProcedure
Procedure PrioritySpace(*s.QuicHandshakeSent,slots.i,level.i,sent.i)
 Define job.QuicHandshakeSentAck,f.QuicHandshakeFrame,range.i,rc.i,i.i
 PriorityAssert(QuicHandshakeSentInit(*s,level,slots,4),0)
 PriorityAssert(QuicHandshakeSentReserve(*s),0)
 PriorityAssert(QuicHandshakeSentCommit(*s,0,10,sent,1,0,0),0)
 PriorityAssert(QuicHandshakeSentReserve(*s),1)
 PriorityAssert(QuicHandshakeSentCommit(*s,1,10,500,1,0,0),0)
 f\kind=2 : f\count=1 : f\rangeBytes=1 : f\ranges=@range : f\largest=1
 PriorityAssert(QuicHandshakeSentAckBegin(@job,*s,level,@f),0)
 For i=0 To 7
  rc=QuicHandshakeSentAckStep(@job)
  If rc=2 Or rc<0 : Break : EndIf
 Next
 PriorityAssert(rc,2)
EndProcedure
Procedure PriorityScan(level.i,now.i)
 Define rc.i,i.i
 rc=QuicConnectionLossBegin(@priorityContext,level,now,QuicRttLossDelay(@priorityContext\recoveryRtt),3)
 PriorityAssert(rc,0) : If rc<>0 : ProcedureReturn : EndIf
 For i=0 To 7
  rc=QuicConnectionLossStep(@priorityContext)
  If rc=1 : priorityLossEvents=priorityLossEvents+1 : EndIf
  If rc=2 Or rc<0 : Break : EndIf
 Next
 PriorityAssert(rc,2)
EndProcedure
Procedure CheckRecoveryPriority()
 Define before.QuicProbeTimer,i.i,rc.i,due.i
 priorityContext\phase=1 : priorityContext\handshakeConfirmed=1
 priorityContext\feed\parametersReady=1 : priorityContext\params\result=1
 priorityContext\initial\writeKeys\ready=1 : priorityContext\handshake\writeKeys\ready=1 : priorityContext\appWrite\ready=1
 PriorityAssert(QuicRttInit(@priorityContext\recoveryRtt,1000,1),0)
 PriorityAssert(QuicProbeTimerInit(@priorityContext\recoveryTimer),0)
 PrioritySpace(@priorityContext\initial\history,@prioritySlots[0],0,300)
 PrioritySpace(@priorityContext\handshake\history,@prioritySlots[16],2,200)
 PrioritySpace(@priorityContext\applicationHistory,@prioritySlots[32],4,100)
 PriorityAssert(QuicConnectionRecoveryPoll(@priorityContext,500),2) : PriorityAssert(priorityContext\recoveryLevel,0)
 PriorityScan(0,500)
 PriorityAssert(QuicConnectionRecoveryPoll(@priorityContext,500),2) : PriorityAssert(priorityContext\recoveryLevel,2)
 PriorityScan(2,500)
 PriorityAssert(QuicConnectionRecoveryPoll(@priorityContext,500),2) : PriorityAssert(priorityContext\recoveryLevel,4)
 PriorityScan(4,500)
 ; Deliberately make the stored PTO candidate earlier than the loss deadline.
 priorityContext\recoveryTimer\deadline=1
 For i=0 To SizeOf(QuicProbeTimer)-1 : PokeA(@before+i,PeekA(@priorityContext\recoveryTimer+i)) : Next
 PriorityAssert(QuicConnectionRecoveryPoll(@priorityContext,1224),0)
 PriorityAssert(QuicConnectionRecoveryPoll(@priorityContext,1225),2) : PriorityAssert(priorityContext\recoveryLevel,4)
 PriorityAssert(QuicConnectionRecoveryPoll(@priorityContext,1225),2)
 For i=0 To SizeOf(QuicProbeTimer)-1
  PriorityAssert(PeekA(@priorityContext\recoveryTimer+i),PeekA(@before+i))
 Next
 PriorityAssert(priorityContext\applicationHistory\inFlight,10)
 PriorityScan(4,1225) : PriorityAssert(priorityLossEvents,1)
 PriorityAssert(QuicConnectionRecoveryPoll(@priorityContext,1324),0)
 PriorityAssert(QuicConnectionRecoveryPoll(@priorityContext,1325),2) : PriorityAssert(priorityContext\recoveryLevel,2)
 priorityContext\handshake\writeKeys\ready=0
 PriorityAssert(QuicConnectionRecoveryPoll(@priorityContext,1325),0)
 PriorityAssert(QuicConnectionRecoveryPoll(@priorityContext,1425),2) : PriorityAssert(priorityContext\recoveryLevel,0)
 PriorityAssert(QuicHandshakeSentDiscard(@priorityContext\initial\history),0)
 PriorityAssert(QuicHandshakeSentDiscard(@priorityContext\handshake\history),0)
 PriorityAssert(QuicConnectionRecoveryRearm(@priorityContext,0),0)
 PriorityAssert(QuicConnectionRecoveryPoll(@priorityContext,1500),0)
 PriorityAssert(QuicHandshakeSentReserve(@priorityContext\applicationHistory),2)
 PriorityAssert(QuicHandshakeSentCommit(@priorityContext\applicationHistory,2,10,1500,1,0,0),0)
 PriorityAssert(QuicConnectionRecoveryRearm(@priorityContext,0),1)
 due=priorityContext\recoveryTimer\deadline
 PriorityAssert(QuicConnectionRecoveryPoll(@priorityContext,due),1) : PriorityAssert(priorityContext\recoveryLevel,4)
 PriorityAssert(priorityContext\recoveryTimer\backoff,1)
 PriorityAssert(QuicConnectionRecoveryPoll(@priorityContext,due),0)
 priorityContext\recoveryRtt\smoothed=2000
 PriorityAssert(QuicConnectionRecoveryPoll(@priorityContext,due),2) : PriorityAssert(priorityContext\recoveryLevel,4)
 PriorityAssert(priorityContext\recoveryTimer\backoff,1)
 PriorityAssert(QuicConnectionRecoveryPoll(@priorityContext,-1),#QUIC_CONNECTION_ARGUMENT)
 For i=0 To SizeOf(QuicConnection)-1 : PokeA(@priorityContext+i,0) : Next
 For i=0 To 383 : PokeA(@prioritySlots[0]+i,0) : Next
EndProcedure

Procedure RetryAssert(actual.i,wanted.i)
 retryChecks=retryChecks+1
 If actual<>wanted And retryFault=0 : retryFault=retryChecks : retryActual=actual : retryWanted=wanted : EndIf
EndProcedure
Procedure CheckCryptoRetry(level.i,cancelled.i)
 Define *s.QuicConnectionSpace,job.QuicHandshakeSentAck,f.QuicHandshakeFrame,range.i,rc.i,i.i,v.QuicCryptoSlice
 priorityContext\phase=1 : priorityContext\peerIdKnown=1 : priorityContext\peerIdBytes=8
 If level=0 : *s=@priorityContext\initial : Else : *s=@priorityContext\handshake : EndIf
 *s\level=level : *s\metadata=@retryMeta[0] : *s\writeKeys\ready=1
 RetryAssert(QuicRttInit(@priorityContext\recoveryRtt,1000,1),0)
 RetryAssert(QuicProbeTimerInit(@priorityContext\recoveryTimer),0)
 RetryAssert(QuicCryptoTxInit(@*s\tx,level,@retryData[0],4096,@retryStates[0],1024),0)
 For i=0 To 599 : retrySource[i]=i&255 : Next
 RetryAssert(QuicCryptoTxAppend(@*s\tx,@retrySource[0],600),600)
 RetryAssert(QuicCryptoTxSent(@*s\tx,0,600),0)
 RetryAssert(QuicCryptoTxAck(@*s\tx,100,100),0)
 RetryAssert(QuicHandshakeSentInit(@*s\history,level,@prioritySlots[0],4),0)
 retryMeta[0]=0 : retryMeta[1]=600 : retryMeta[2]=600 : retryMeta[3]=0
 RetryAssert(QuicHandshakeSentReserve(@*s\history),0)
 RetryAssert(QuicHandshakeSentCommit(@*s\history,0,620,100,1,0,@retryMeta[0]),0)
 RetryAssert(QuicHandshakeSentReserve(@*s\history),1)
 RetryAssert(QuicHandshakeSentCommit(@*s\history,1,20,200,1,0,@retryMeta[2]),0)
 f\kind=2 : f\count=1 : f\rangeBytes=1 : f\ranges=@range : f\largest=1
 RetryAssert(QuicHandshakeSentAckBegin(@job,@*s\history,level,@f),0)
 For i=0 To 7
  rc=QuicHandshakeSentAckStep(@job) : If rc=2 Or rc<0 : Break : EndIf
 Next
 RetryAssert(rc,2)
 If cancelled>=2
  RetryAssert(QuicConnectionProbeBegin(@priorityContext,level,-1),#QUIC_SENT_ARGUMENT)
  RetryAssert(QuicConnectionProbeBegin(@priorityContext,level,1),#QUIC_SENT_STATE)
  RetryAssert(QuicConnectionProbeBegin(@priorityContext,level,0),0)
  RetryAssert(QuicConnectionProbeBegin(@priorityContext,level,0),#QUIC_CONNECTION_STATE)
  RetryAssert(QuicConnectionRecoveryPoll(@priorityContext,3000),#QUIC_SENT_BUSY)
  RetryAssert(QuicConnectionSendBegin(@priorityContext,level,8),#QUIC_SENT_BUSY)
  RetryAssert(QuicConnectionSendBegin(@priorityContext,2-level,8),#QUIC_SENT_BUSY)
  RetryAssert(QuicConnectionReceiveBegin(@priorityContext,level,0,1),#QUIC_SENT_BUSY)
  RetryAssert(QuicConnectionReceivePacketBegin(@priorityContext,0,1),#QUIC_SENT_BUSY)
  RetryAssert(QuicConnectionTlsBegin(@priorityContext,level,8,1000),#QUIC_SENT_BUSY)
  RetryAssert(QuicConnectionProbeStep(@priorityContext),0)
  RetryAssert(priorityContext\probe\remaining,344)
  If cancelled=3
   RetryAssert(QuicConnectionClose(@priorityContext,0),0)
   RetryAssert(QuicConnectionCloseStep(@priorityContext),0)
   RetryAssert(priorityContext\probe\phase,-1)
   RetryAssert(*s\history\busy,0)
   RetryAssert(*s\history\phase,2)
   RetryAssert(QuicConnectionProbeStep(@priorityContext),#QUIC_CONNECTION_STATE)
   RetryAssert(*s\tx\phase,3)
   RetryAssert(priorityContext\probe\remaining,344)
  Else
   RetryAssert(QuicConnectionProbeStep(@priorityContext),0)
   RetryAssert(priorityContext\probe\remaining,88)
   RetryAssert(QuicConnectionProbeStep(@priorityContext),1)
   RetryAssert(priorityContext\probe\remaining,0)
   RetryAssert(QuicConnectionProbeStep(@priorityContext),1)
   RetryAssert(*s\history\inFlight,620)
   RetryAssert(PeekI(@prioritySlots[0])&32,0)
   RetryAssert(QuicCryptoTxFind(@*s\tx,0,1024,@v),1) : RetryAssert(v\offset,0) : RetryAssert(v\bytes,100)
   RetryAssert(QuicCryptoTxFind(@*s\tx,100,1024,@v),1) : RetryAssert(v\offset,200) : RetryAssert(v\bytes,400)
  EndIf
  For i=0 To SizeOf(QuicConnection)-1 : PokeA(@priorityContext+i,0) : Next
  For i=0 To 383 : PokeA(@prioritySlots[0]+i,0) : Next
  ProcedureReturn
 EndIf
 RetryAssert(QuicConnectionLossBegin(@priorityContext,level,2000,100,3),0)
 RetryAssert(QuicConnectionLossStep(@priorityContext),0)
 RetryAssert(priorityContext\recoveryRetryRemaining,600)
 RetryAssert(QuicConnectionSendBegin(@priorityContext,level,8),#QUIC_SENT_BUSY)
 RetryAssert(QuicConnectionLossBegin(@priorityContext,level,2000,100,3),#QUIC_CONNECTION_STATE)
 RetryAssert(QuicConnectionLossStep(@priorityContext),0)
 RetryAssert(priorityContext\recoveryRetryRemaining,344)
 If cancelled=1
  RetryAssert(QuicHandshakeSentLossCancel(@priorityContext\recoveryLoss),#QUIC_SENT_CANCELLED)
  RetryAssert(*s\history\busy,0)
  RetryAssert(QuicConnectionSendBegin(@priorityContext,level,8),#QUIC_SENT_BUSY)
  RetryAssert(priorityContext\outgoing\phase,0)
  RetryAssert(QuicConnectionRecoveryPoll(@priorityContext,3000),#QUIC_SENT_BUSY)
  RetryAssert(QuicConnectionLossBegin(@priorityContext,level,3000,100,3),#QUIC_CONNECTION_STATE)
  RetryAssert(QuicConnectionLossStep(@priorityContext),#QUIC_CONNECTION_STATE)
  RetryAssert(priorityContext\phase,2)
  RetryAssert(priorityContext\recoveryTimer\phase,0)
  RetryAssert(priorityContext\recoveryRetryRemaining,344)
  RetryAssert(QuicConnectionSendBegin(@priorityContext,level,8),#QUIC_SEND_STATE)
  RetryAssert(((PeekA(@retryStates[0]+255/4)>>((255&3)*2))&3),2)
  RetryAssert(((PeekA(@retryStates[0]+256/4)>>((256&3)*2))&3),1)
  RetryAssert(((PeekA(@retryStates[0]+100/4)>>((100&3)*2))&3),3)
  For i=0 To SizeOf(QuicConnection)-1 : PokeA(@priorityContext+i,0) : Next
  For i=0 To 383 : PokeA(@prioritySlots[0]+i,0) : Next
  ProcedureReturn
 EndIf
 RetryAssert(QuicConnectionLossStep(@priorityContext),0)
 RetryAssert(priorityContext\recoveryRetryRemaining,88)
 RetryAssert(QuicConnectionLossStep(@priorityContext),1)
 RetryAssert(priorityContext\recoveryRetryRemaining,0)
 RetryAssert(priorityContext\recoveryLoss\number,0)
 For i=0 To 599
  RetryAssert(PeekA(@retryData[0]+i),i&255)
  If i>=100 And i<200 : RetryAssert(((PeekA(@retryStates[0]+i/4)>>((i&3)*2))&3),3)
  Else : RetryAssert(((PeekA(@retryStates[0]+i/4)>>((i&3)*2))&3),2) : EndIf
 Next
 RetryAssert(QuicCryptoTxFind(@*s\tx,0,1024,@v),1) : RetryAssert(v\offset,0) : RetryAssert(v\bytes,100)
 RetryAssert(QuicCryptoTxFind(@*s\tx,100,1024,@v),1) : RetryAssert(v\offset,200) : RetryAssert(v\bytes,400)
 RetryAssert(QuicConnectionLossStep(@priorityContext),2)
 RetryAssert(QuicConnectionLossStep(@priorityContext),2)
 RetryAssert(*s\history\inFlight,0)
 For i=0 To SizeOf(QuicConnection)-1 : PokeA(@priorityContext+i,0) : Next
 For i=0 To 383 : PokeA(@prioritySlots[0]+i,0) : Next
EndProcedure

Procedure.i InitialProbe()
 Define rc.i,n.i,offset.i,bytes.i
 initialProbeBefore=connection\initial\history\inFlight
 initialProbeDue=connection\recoveryTimer\deadline
 Repeat
  rc=Service() : If rc<0 : ProcedureReturn rc : EndIf
  initialProbeFired=HwMicros() : rc=QuicConnectionRecoveryPoll(@connection,initialProbeFired)
 Until rc<>0
 If rc<>#QUIC_RECOVERY_PROBE Or connection\recoveryLevel<>0 Or connection\recoveryTimer\backoff<>1 : ProcedureReturn -9498 : EndIf
 If connection\initial\history\inFlight<>initialProbeBefore Or connection\initial\history\acked<>0 : ProcedureReturn -9499 : EndIf
 ; A PTO requests a fresh probe, not a declaration of packet loss.
 rc=QuicConnectionProbeBegin(@connection,0,0) : If rc<>0 : ProcedureReturn rc : EndIf
 Repeat
  rc=QuicConnectionProbeStep(@connection)
  n=Service() : If n<0 : ProcedureReturn n : EndIf
 Until rc<>0
 If rc<>1 : ProcedureReturn rc : EndIf
 rc=SendSpace(@connection\initial) : If rc<>0 : ProcedureReturn rc : EndIf
 initialProbeAfter=connection\initial\history\inFlight
 If connection\outgoing\number<>1 Or initialProbeAfter<>2*initialProbeBefore : ProcedureReturn -9500 : EndIf
 If (PeekI(connection\initial\history\entries)&32)<>0 : ProcedureReturn -9501 : EndIf
 initialProbeChecked=1 : ProcedureReturn 0
EndProcedure

Procedure.i Run()
 Define rc.i,n.i,i.i,p.i,packetBytes.i
 stage=1
 X509ResetAnchors() : X509AddAnchorEC(1,?RootDn,#ROOT_DN_BYTES,23,?RootKey,65)
 Tls13SetHsBuffer(@tlsHs[0],32768) : Tls13SetRecvBuffer(@tlsRecv[0],16645)
 QuicCipherInvalidateHook=@Tls13RecInvalidateCipher
 rc=Tls13Init(?HostName,15,#TEST_UNIX) : If rc<>1 : ProcedureReturn -9316 : EndIf
 stage=2
 rc=DrbgAutoSeed() : If rc<>1 : ProcedureReturn rc : EndIf
 rc=DrbgGenerate(@originalId[0],8) : If rc<>8 : ProcedureReturn -9317 : EndIf
 rc=DrbgGenerate(@clientId[0],8) : If rc<>8 : ProcedureReturn -9318 : EndIf
 rc=Tls13SetAlpn(?Alpn,3) : If rc<>1 : ProcedureReturn -9320 : EndIf
 For i=0 To #LOCAL_PARAMETER_BYTES-1 : localParameters[i]=PeekA(?LocalTemplate+i) : Next
 For i=0 To 7 : localParameters[i+2]=clientId[i] : Next
 rc=Tls13SetQuicParameters(@tlsConfig[0],@localParameters[0],#LOCAL_PARAMETER_BYTES,@peerParameters[0],4096)
 If rc<>1 : ProcedureReturn -9321 : EndIf
 stage=3
 rc=StartHandshake() : If rc<>0 : ProcedureReturn rc : EndIf
 rc=SendSpace(@connection\initial) : If rc<>0 : ProcedureReturn rc : EndIf
 If #INITIAL_PROBE_TEST : rc=InitialProbe() : If rc<>0 : ProcedureReturn rc : EndIf : EndIf
 stage=4
 While appAuthenticated=0
  rc=Pump() : If rc<0 : ProcedureReturn rc : EndIf
  n=UdpPayloadReceive(handle,@info,@packet[0],1472)
  If n<>#SVC_EAGAIN
   If n<1 : ProcedureReturn n : EndIf
   datagramReceivedAt=HwMicros()
   If info\family<>4 Or info\peerPort<>55442 : ProcedureReturn -9322 : EndIf
   For i=0 To 15 : If PeekA(@info\peerAddress+i)<>PeekA(@ep\address+i) : ProcedureReturn -9323 : EndIf : Next
   received=received+1 : p=0
   While p<n
    ; An unparseable datagram remainder is discarded, not a connection error.
    ; Already authenticated coalesced packets retain their effects.
    rc=QuicPacketRead(@connection\header,@packet[p],n-p,8) : If rc<>1 : Break : EndIf
    packetBytes=connection\header\packetBytes
    rc=PacketOne(@packet[p],packetBytes) : If rc<>0 : ProcedureReturn rc : EndIf
    p=p+packetBytes
   Wend
  EndIf
 Wend
 stage=5 : rc=SendApplicationPing() : If rc<>0 : ProcedureReturn rc : EndIf
 rc=ReceiveApplicationAck() : If rc<>0 : ProcedureReturn rc : EndIf
 rc=SendApplicationProbe(1) : If rc<>0 : ProcedureReturn rc : EndIf
 If #DROP_PROBE_TEST : ProcedureReturn CheckProbeLoss() : EndIf
 ProcedureReturn 0
EndProcedure
Procedure.i LiveEntry()
 Define *s.QuicConnectionSpace
 *s=liveSpace
 Select liveOperation
  Case 1 : liveResult=Tls13NewKeyShare()
  Case 2 : liveResult=QuicTlsOutputBegin(@connection\tlsOutput,@*s\tx,@tlsBytes[0],2048)
  Case 3 : liveResult=QuicCryptoTlsStep(@*s\rx)
  Default : liveResult=-9325
 EndSelect
 ProcedureReturn 1
EndProcedure
; Compare complete snapshots, not just a few state flags. The foreground
; deliberately selects unrelated metadata while the real connection is paused.
Procedure ForeignContext()
 Tls13State=901 : Tls13Err=902 : TlsNameLen=42 : TlsQuicConfig=0
 TlsClientRandom[0]=167 : TlsSessionId[0]=89 : TlsGroup=903
EndProcedure
Procedure CheckContext()
 Define i.i,n.i
 n=Tls13ContextSave(@afterSnapshot[0],#TLS13_CONTEXT_SIZE)
 For i=0 To #TLS13_CONTEXT_SIZE-1
  If beforeSnapshot[i]<>afterSnapshot[i] : contextFault=1 : EndIf
  ; White-box check: the temporary foreground secret snapshot is wiped.
  If PeekA(@tlsctxw_caller[0]+i)<>0 : contextFault=2 : EndIf
 Next
 contextChecks=contextChecks+1
EndProcedure
Procedure OperationProbe(kind.i)
 Define i.i,rc.i,n.i,ticks.i,t.i
 For i=0 To #TLS13_CONTEXT_SIZE-1 : probeSnapshot[i]=ownerSnapshot[i] : Next
 ForeignContext() : n=Tls13ContextSave(@beforeSnapshot[0],#TLS13_CONTEXT_SIZE)
 Select kind
  Case 1
   rc=QuicTlsOperationBegin(@deadlineOp,@probeSnapshot[0],#TLS13_CONTEXT_SIZE,1,0,0,0,0,1)
   If rc<>1 : operationFault=1 : ProcedureReturn : EndIf
   t=HwMicros() : While HwMicros()-t<3 : Wend
   rc=QuicTlsOperationStep(@deadlineOp) : CheckContext() : extraContextChecks=extraContextChecks+1
   If rc<>#QUIC_OP_TIMEOUT Or deadlineOp\phase<>-1 Or TlsWorkerBusy()<>0 : operationFault=2 : EndIf
   If QuicTlsOperationBegin(@deadlineOp,@probeSnapshot[0],#TLS13_CONTEXT_SIZE,1,0,0,0,0,1000)<>#QUIC_OP_STATE : operationFault=3 : EndIf
  Case 2
   rc=QuicCryptoTxInit(@probeTx,0,@probeData[0],4096,@probeBits[0],1024)
   If rc<>0 : operationFault=4 : ProcedureReturn : EndIf
   rc=QuicTlsOperationBegin(@outputOp,@probeSnapshot[0],#TLS13_CONTEXT_SIZE,2,@probeTx,@probeOut,@probeOutput[0],2048,20000000)
   If rc<>1 : operationFault=5 : ProcedureReturn : EndIf
   ; Deterministic cancellation checkpoint only: restore the production slice
   ; immediately afterward. Live connection\handshake timing never uses this test setting.
   ticks=tlsjob_sliceTicks : tlsjob_sliceTicks=1
   rc=QuicTlsOperationStep(@outputOp) : tlsjob_sliceTicks=ticks
   CheckContext() : extraContextChecks=extraContextChecks+1
   If rc<>0 Or probeOut\phase<>3 : operationFault=6 : EndIf
   rc=QuicTlsOperationCancel(@outputOp) : CheckContext() : extraContextChecks=extraContextChecks+1
   If rc<>#QUIC_OP_CANCELLED Or probeOut\phase<>-1 Or probeTx\phase<>3 Or TlsWorkerBusy()<>0 : operationFault=7 : EndIf
   If QuicCryptoTxAppend(@probeTx,@probeOutput[0],1)<>#QUIC_TX_STATE : operationFault=8 : EndIf
  Case 3
   rc=QuicCryptoRxInit(@probeRx,0,@probeData[0],4096,@probeBits[0],512)
   If rc<>0 : operationFault=9 : ProcedureReturn : EndIf
   rc=QuicTlsOperationBegin(@inputOp,@probeSnapshot[0],#TLS13_CONTEXT_SIZE,3,@probeRx,0,0,0,20000000)
   If rc<>1 : operationFault=10 : ProcedureReturn : EndIf
   rc=QuicTlsOperationCancel(@inputOp) : CheckContext() : extraContextChecks=extraContextChecks+1
   If rc<>#QUIC_OP_CANCELLED Or probeRx\phase<>3 Or probeRx\offered<>0 Or TlsWorkerBusy()<>0 : operationFault=11 : EndIf
  Case 4
   rc=QuicTlsOperationBegin(@keyOp,@probeSnapshot[0],#TLS13_CONTEXT_SIZE,4,@probeKey,@probeKeys,Tls13ContextTrafficSecret(@probeSnapshot[0],#TLS13_CONTEXT_SIZE,1,0),32,20000000)
   If rc<>1 : operationFault=13 : ProcedureReturn : EndIf
   ticks=tlsjob_sliceTicks : tlsjob_sliceTicks=1
   rc=QuicTlsOperationStep(@keyOp) : tlsjob_sliceTicks=ticks
   CheckContext() : extraContextChecks=extraContextChecks+1
   If rc<>0 Or probeKey\phase=0 : operationFault=14 : EndIf
   rc=QuicTlsOperationCancel(@keyOp) : CheckContext() : extraContextChecks=extraContextChecks+1
   If rc<>#QUIC_OP_CANCELLED Or probeKey\phase<>0 Or TlsWorkerBusy()<>0 : operationFault=15 : EndIf
   For i=0 To SizeOf(QuicKeys)-1 : If PeekA(@probeKeys+i)<>0 : operationFault=16 : EndIf : Next
   keyCancelled=1
  Case 5
   rc=QuicInitialKeysBegin(@probeKey,@probeKeys,@originalId[0],8,1)
   If rc<>0 : operationFault=17 : ProcedureReturn : EndIf
   ; A mismatched output owner must be refused without adopting or wiping it.
   rc=QuicTlsOperationBegin(@preparedKeyOp,@probeSnapshot[0],#TLS13_CONTEXT_SIZE,5,@probeKey,@connection\appWrite,0,0,20000000)
   If rc<>#QUIC_OP_STATE Or preparedKeyOp\phase<>0 Or probeKey\phase<>1 Or TlsWorkerBusy()<>0 : operationFault=18 : EndIf
   rc=QuicTlsOperationBegin(@preparedKeyOp,@probeSnapshot[0],#TLS13_CONTEXT_SIZE,5,@probeKey,@probeKeys,0,0,20000000)
   If rc<>1 : operationFault=19 : ProcedureReturn : EndIf
   ticks=tlsjob_sliceTicks : tlsjob_sliceTicks=1
   rc=QuicTlsOperationStep(@preparedKeyOp) : tlsjob_sliceTicks=ticks
   CheckContext() : extraContextChecks=extraContextChecks+1
   If rc<>0 Or probeKey\phase=0 : operationFault=20 : EndIf
   rc=QuicTlsOperationCancel(@preparedKeyOp) : CheckContext() : extraContextChecks=extraContextChecks+1
   If rc<>#QUIC_OP_CANCELLED Or probeKey\phase<>0 Or TlsWorkerBusy()<>0 : operationFault=21 : EndIf
   For i=0 To SizeOf(QuicKeys)-1 : If PeekA(@probeKeys+i)<>0 : operationFault=22 : EndIf : Next
 EndSelect
 For i=0 To #TLS13_CONTEXT_SIZE-1 : If probeSnapshot[i]<>0 : operationFault=12 : EndIf : Next
 n=Tls13ContextRestore(@ownerSnapshot[0],#TLS13_CONTEXT_SIZE)
 operationProbes=operationProbes+1
EndProcedure
Procedure TlsSliceBefore()
 Define n.i
  If TlsWorkerBegin(@otherJob,@LiveEntry,0)<>#TLSWORK_BUSY : ownershipFault=1 : EndIf
  If TlsWorkerStep(@otherJob)<>#TLSWORK_OWNER Or TlsWorkerCancel(@otherJob)<>#TLSWORK_OWNER : ownershipFault=2 : EndIf
  If otherJob\task<>0 Or otherJob\phase<>0 Or otherJob\result<>773 : ownershipFault=3 : EndIf
  If HooksClear()<>1 Or TlsWorkerBusy()<>1 : ownershipFault=4 : EndIf
  If TlsContextWorkerBegin(@refusedJob,@ownerSnapshot[0],#TLS13_CONTEXT_SIZE,@LiveEntry,0)<>#TLSWORK_BUSY : contextFault=6 : EndIf
  If TlsContextWorkerStep(@refusedJob)<>#TLSWORK_OWNER Or TlsContextWorkerCancel(@refusedJob)<>#TLSWORK_OWNER : contextFault=7 : EndIf
  If refusedJob\snapshot<>771 Or refusedJob\capacity<>772 Or refusedJob\worker\result<>773 Or refusedJob\worker\task<>0 : contextFault=8 : EndIf
  ownershipChecks=ownershipChecks+1
  ForeignContext() : n=Tls13ContextSave(@beforeSnapshot[0],#TLS13_CONTEXT_SIZE)
EndProcedure
Procedure TlsSliceAfter(cost.i)
  CheckContext()
  If cost>maxWorkerStep : maxWorkerStep=cost : EndIf
  workerSteps=workerSteps+1
  If HooksClear()<>1 : ownershipFault=5 : EndIf
EndProcedure
Procedure.i PrepareTlsProbe(operation.i,space.i)
 Define rc.i,t.i,cost.i,n.i,i.i
 liveOperation=operation : liveSpace=space
 otherJob\result=773
 refusedJob\snapshot=771 : refusedJob\capacity=772 : refusedJob\worker\result=773
 n=Tls13ContextSave(@ownerSnapshot[0],#TLS13_CONTEXT_SIZE)
 If TlsContextWorkerBegin(@refusedJob,@refusedJob,#TLS13_CONTEXT_SIZE,@LiveEntry,0)<>#TLSWORK_STATE : contextFault=5 : EndIf
 If operation=1 And cancelChecked=0
  For i=0 To #TLS13_CONTEXT_SIZE-1 : retrySnapshot[i]=ownerSnapshot[i] : Next
  rc=TlsContextWorkerBegin(@liveJob,@ownerSnapshot[0],#TLS13_CONTEXT_SIZE,@LiveEntry,0)
  If rc<>1 : ProcedureReturn rc : EndIf
  ForeignContext() : n=Tls13ContextSave(@beforeSnapshot[0],#TLS13_CONTEXT_SIZE)
  rc=TlsContextWorkerStep(@liveJob) : CheckContext()
  If rc<>0 : contextFault=3 : ProcedureReturn -9326 : EndIf
  rc=TlsContextWorkerCancel(@liveJob) : CheckContext()
  If rc<>1 : ProcedureReturn rc : EndIf
  For i=0 To #TLS13_CONTEXT_SIZE-1
   If ownerSnapshot[i]<>0 : contextFault=4 : EndIf
   ownerSnapshot[i]=retrySnapshot[i]
  Next
  n=Tls13ContextRestore(@ownerSnapshot[0],#TLS13_CONTEXT_SIZE)
  n=Tls13ContextWipe(@retrySnapshot[0],#TLS13_CONTEXT_SIZE)
  cancelChecked=1
 EndIf
 If operationProbes=operation-1 : OperationProbe(operation) : EndIf
 If operationFault<>0 : ProcedureReturn -9327 : EndIf
 ProcedureReturn 1
EndProcedure
Procedure SetupSpans()
 PokeI(@connectionSpans[0]+0,@rxData[0]) : PokeI(@connectionSpans[0]+8,QuicConnectionBufferBytes(0))
 PokeI(@connectionSpans[0]+16,@rxBits[0]) : PokeI(@connectionSpans[0]+24,QuicConnectionBufferBytes(1))
 PokeI(@connectionSpans[0]+32,@txData[0]) : PokeI(@connectionSpans[0]+40,QuicConnectionBufferBytes(2))
 PokeI(@connectionSpans[0]+48,@txBits[0]) : PokeI(@connectionSpans[0]+56,QuicConnectionBufferBytes(3))
 PokeI(@connectionSpans[0]+64,@ackRanges[0]) : PokeI(@connectionSpans[0]+72,QuicConnectionBufferBytes(4))
 PokeI(@connectionSpans[0]+80,@sentSlots[0]) : PokeI(@connectionSpans[0]+88,QuicConnectionBufferBytes(5))
 PokeI(@connectionSpans[0]+96,@sentMeta[0]) : PokeI(@connectionSpans[0]+104,QuicConnectionBufferBytes(6))
 PokeI(@connectionSpans[0]+112,@ownerSnapshot[0]) : PokeI(@connectionSpans[0]+120,QuicConnectionBufferBytes(7))
 PokeI(@connectionSpans[0]+128,@tlsHs[0]) : PokeI(@connectionSpans[0]+136,QuicConnectionBufferBytes(8))
 PokeI(@connectionSpans[0]+144,@tlsRecv[0]) : PokeI(@connectionSpans[0]+152,QuicConnectionBufferBytes(9))
 PokeI(@connectionSpans[0]+160,@tlsBytes[0]) : PokeI(@connectionSpans[0]+168,QuicConnectionBufferBytes(10))
 PokeI(@connectionSpans[0]+176,@tlsConfig[0]) : PokeI(@connectionSpans[0]+184,QuicConnectionBufferBytes(11))
 PokeI(@connectionSpans[0]+192,@localParameters[0]) : PokeI(@connectionSpans[0]+200,QuicConnectionBufferBytes(12))
 PokeI(@connectionSpans[0]+208,@peerParameters[0]) : PokeI(@connectionSpans[0]+216,QuicConnectionBufferBytes(13))
 PokeI(@connectionSpans[0]+224,@parameterEntries[0]) : PokeI(@connectionSpans[0]+232,QuicConnectionBufferBytes(14))
 PokeI(@connectionSpans[0]+240,@packet[0]) : PokeI(@connectionSpans[0]+248,QuicConnectionBufferBytes(15))
 PokeI(@connectionSpans[0]+256,@output[0]) : PokeI(@connectionSpans[0]+264,QuicConnectionBufferBytes(16))
 PokeI(@connectionSpans[0]+272,@originalId[0]) : PokeI(@connectionSpans[0]+280,QuicConnectionBufferBytes(17))
 PokeI(@connectionSpans[0]+288,@clientId[0]) : PokeI(@connectionSpans[0]+296,QuicConnectionBufferBytes(18))
 PokeI(@connectionSpans[0]+304,@peerId[0]) : PokeI(@connectionSpans[0]+312,QuicConnectionBufferBytes(19))
EndProcedure
Procedure.i CloseHoldEntry()
 closeHoldRuns=closeHoldRuns+1
 If ScYield()<>1 : ProcedureReturn 0 : EndIf
 closeHoldRuns=closeHoldRuns+1 : ProcedureReturn 1
EndProcedure
Procedure.i CloseConnection(reason.i)
 Define rc.i,n.i,i.i,j.i,p.i,t.i,cost.i,saved.i
 If reason=0
  rc=QuicConnectionLossBegin(@connection,4,HwMicros(),$7FFFFFFFFFFFFFFF,3)
  If rc<>0 Or connection\applicationHistory\busy<>@connection\recoveryLoss : recoveryCloseFault=1 : EndIf
  rc=QuicProbeTimerArm(@connection\recoveryTimer,@connection\recoveryRtt,1,25000,-1,-1,HwMicros())
  If rc<>1 : recoveryCloseFault=2 : EndIf
  If QuicConnectionRecoveryRearm(@connection,1)<>#QUIC_SENT_BUSY Or connection\recoveryTimer\armed<>1 : rearmFault=2 : EndIf
 EndIf
 rc=TlsWorkerBegin(@closeHold,@CloseHoldEntry,0)
 If rc=1
 rc=TlsWorkerStep(@closeHold)
 If rc<>0 Or closeHoldRuns<>1 : closeFault=1 : EndIf
 rc=QuicConnectionClose(@connection,reason)
 If reason=0
  If connection\recoveryTimer\armed<>0 Or connection\recoveryTimer\phase<>0 : recoveryCloseFault=3 : EndIf
  If QuicConnectionRecoveryPoll(@connection,$7FFFFFFFFFFFFFFF)<>#QUIC_CONNECTION_STATE : recoveryCloseFault=4 : EndIf
  If QuicConnectionLossStep(@connection)<>#QUIC_CONNECTION_STATE : recoveryCloseFault=5 : EndIf
 EndIf
 saved=Tls13State : rc=QuicConnectionCloseStep(@connection)
 If rc<>#TLSWORK_BUSY Or connection\closeStage<>0 Or Tls13State<>saved Or SchedState(closeHold\task)<>#SCHED_READY : closeFault=2 : EndIf
 rc=TlsWorkerStep(@closeHold)
 If rc<>1 Or closeHoldRuns<>2 : closeFault=3 : EndIf
 If reason=0
  t=HwMicros() : rc=QuicConnectionCloseStep(@connection) : cost=HwMicros()-t
  closeCalls=closeCalls+1 : If cost>maxCloseStep : maxCloseStep=cost : EndIf
  If rc<>0 Or connection\closeStage<>1 Or connection\recoveryLoss\phase<>-1 Or connection\applicationHistory\busy<>0 : recoveryCloseFault=6 : EndIf
  recoveryCloseChecked=1
 EndIf
 Else
  closeFault=8
  rc=QuicConnectionClose(@connection,reason)
 EndIf
 Repeat
  t=HwMicros() : rc=QuicConnectionCloseStep(@connection) : cost=HwMicros()-t
  If cost>maxCloseStep : maxCloseStep=cost : EndIf
  closeCalls=closeCalls+1
  If rc=2
   If QuicConnectionSocketClosed(@connection,handle+1,0)<>#QUIC_CONNECTION_STATE Or connection\socket<>handle : closeFault=4 : EndIf
   If QuicConnectionSocketClosed(@connection,handle,-1)<>#QUIC_CONNECTION_IO Or connection\socket<>handle : closeFault=5 : EndIf
   n=UdpPayloadClose(handle)
   n=QuicConnectionSocketClosed(@connection,handle,n)
   If n<>0 : ProcedureReturn n : EndIf
  ElseIf rc<0
   ProcedureReturn rc
  EndIf
  n=Service() : If n<0 : ProcedureReturn n : EndIf
 Until rc=1
 bufferWiped=1
 For i=0 To 19
  p=PeekI(@connectionSpans[0]+i*16) : n=QuicConnectionBufferBytes(i)
  For j=0 To n-1 : If PeekA(p+j)<>0 : bufferWiped=0 : EndIf : Next
 Next
 For i=16 To SizeOf(QuicConnection)-1 : If PeekA(@connection+i)<>0 : closeFault=6 : EndIf : Next
 If connection\result<>reason Or TlsHsAddr<>0 Or TlsRecvAddr<>0 : closeFault=7 : EndIf
 If QuicConnectionCloseStep(@connection)<>1 Or QuicConnectionClose(@connection,123)<>1 Or connection\result<>reason : closeFault=8 : EndIf
 ProcedureReturn 0
EndProcedure
Procedure CheckConnectionLifecycle()
 Define rc.i,n.i,i.i,j.i,p.i,slice.i,socket.i
 socket=UdpPayloadOpen(4,0,55013)
 If socket<=0 : lifecycleFault=1 : ProcedureReturn : EndIf
 rc=QuicConnectionBegin(@connection,@connectionSpans[0],socket,HwMicros(),20000000)
 If rc<>0 : lifecycleFault=2 : n=UdpPayloadClose(socket) : ProcedureReturn : EndIf
 Tls13SetHsBuffer(@tlsHs[0],32768) : Tls13SetRecvBuffer(@tlsRecv[0],16645)
 rc=Tls13Init(?HostName,15,#TEST_UNIX)
 If rc<>1 : lifecycleFault=3 : EndIf
 rc=Tls13ContextSave(@ownerSnapshot[0],#TLS13_CONTEXT_SIZE)
 Tls13SetHsBuffer(@foreignHs[0],32768) : Tls13SetRecvBuffer(@foreignRecv[0],16645)
 rc=Tls13Init(?HostName,15,#TEST_UNIX)
 If rc<>1 : lifecycleFault=4 : EndIf
 foreignHs[0]=68 : foreignHs[32767]=69 : foreignRecv[0]=51 : foreignRecv[16644]=52
 rc=Tls13ContextSave(@beforeSnapshot[0],#TLS13_CONTEXT_SIZE)
 rc=QuicTlsOperationBegin(@connection\tlsOp,@ownerSnapshot[0],#TLS13_CONTEXT_SIZE,1,0,0,0,0,20000000)
 If rc<>1 : lifecycleFault=5 : EndIf
 slice=tlsjob_sliceTicks : tlsjob_sliceTicks=1
 rc=QuicTlsOperationStep(@connection\tlsOp)
 tlsjob_sliceTicks=slice
 If rc<>0 Or connection\tlsOp\phase<>1 Or TlsWorkerBusy()<>1 : lifecycleFault=6 : EndIf
 ; Advance the caller-supplied overall clock to its boundary, without sleeping
 ; or expiring the independent operation timer. Cancellation must stop a live
 ; suspended crypto context before erasing storage.
 rc=QuicConnectionCheckDeadline(@connection,connection\started+connection\timeout-1)
 If rc<>0 Or connection\phase<>1 : lifecycleFault=7 : EndIf
 rc=QuicConnectionCheckDeadline(@connection,connection\started+connection\timeout)
 If rc<>#QUIC_CONNECTION_TIMEOUT Or connection\phase<>2 Or connection\result<>#QUIC_CONNECTION_TIMEOUT : lifecycleFault=8 : EndIf
 lifecycleProbes=lifecycleProbes+1
 rc=QuicConnectionCloseStep(@connection)
 If rc<>0 Or connection\closeStage<>1 Or connection\tlsOp\phase<>-1 Or TlsWorkerBusy()<>0 : lifecycleFault=9 : EndIf
 If connection\initial\rx\phase<>3 Or connection\handshake\rx\phase<>3 Or connection\initial\tx\phase<>3 Or connection\handshake\tx\phase<>3 : lifecycleFault=17 : EndIf
 lifecycleProbes=lifecycleProbes+1
 Repeat
  rc=QuicConnectionCloseStep(@connection)
  If rc=2
   n=UdpPayloadClose(socket) : n=QuicConnectionSocketClosed(@connection,socket,n)
   If n<>0 : lifecycleFault=10 : ProcedureReturn : EndIf
  ElseIf rc<0
   lifecycleFault=11 : ProcedureReturn
  EndIf
  n=Service()
 Until rc=1
 For i=0 To 19
  p=PeekI(@connectionSpans[0]+i*16) : n=QuicConnectionBufferBytes(i)
  For j=0 To n-1 : If PeekA(p+j)<>0 : lifecycleFault=12 : EndIf : Next
 Next
 If connection\result<>#QUIC_CONNECTION_TIMEOUT : lifecycleFault=13 : EndIf
 rc=Tls13ContextSave(@afterSnapshot[0],#TLS13_CONTEXT_SIZE)
 For i=0 To #TLS13_CONTEXT_SIZE-1 : If beforeSnapshot[i]<>afterSnapshot[i] : lifecycleFault=14 : EndIf : Next
 If foreignHs[0]<>68 Or foreignHs[32767]<>69 Or foreignRecv[0]<>51 Or foreignRecv[16644]<>52 : lifecycleFault=15 : EndIf
 If TlsWorkerBusy()<>0 Or GcmJobBusy()<>0 Or HooksClear()<>1 : lifecycleFault=16 : EndIf
 lifecycleProbes=lifecycleProbes+1
 rc=Tls13ContextRestore(@ownerSnapshot[0],#TLS13_CONTEXT_SIZE)
EndProcedure
Procedure CheckPacketCancellation()
 Define rc.i,n.i,i.i,socket.i,slice.i
 socket=UdpPayloadOpen(4,0,55013)
 If socket<=0 : sendFault=7 : ProcedureReturn : EndIf
 rc=QuicConnectionBegin(@connection,@connectionSpans[0],socket,HwMicros(),20000000)
 If rc<>0 : sendFault=8 : n=UdpPayloadClose(socket) : ProcedureReturn : EndIf
 n=DrbgGenerate(@originalId[0],8)
 rc=KeyDone(QuicInitialKeysBegin(@connection\keyjob,@connection\initial\writeKeys,@originalId[0],8,0))
 If n<>8 Or rc<>0 : sendFault=9 : EndIf
 rc=QuicCryptoTxAppend(@connection\initial\tx,@probeData[0],8)
 If rc<>8 : sendFault=10 : EndIf
 rc=QuicConnectionSendBegin(@connection,0,0)
 If rc<>0 : sendFault=11 : EndIf
 For i=0 To 7
  rc=QuicConnectionSendStep(@connection)
  If rc<>0 : sendFault=12 : EndIf
  If connection\outgoing\encryptStarted=1 : Break : EndIf
 Next
 slice=tlsjob_sliceTicks : tlsjob_sliceTicks=1
 rc=QuicConnectionSendStep(@connection)
 tlsjob_sliceTicks=slice
 If rc<>0 Or connection\sendJob\phase=0 Or TlsWorkerOwns(@connection\outgoing\worker)<>1 : sendFault=13 : EndIf
 rc=QuicConnectionClose(@connection,-9420)
 rc=QuicConnectionCloseStep(@connection)
 If rc<>0 Or connection\closeStage<>1 Or TlsWorkerBusy()<>0 Or GcmJobBusy()<>0 Or connection\sendJob\phase<>0 : sendFault=14 : EndIf
 Repeat
  rc=QuicConnectionCloseStep(@connection)
  If rc=2
   n=UdpPayloadClose(socket) : n=QuicConnectionSocketClosed(@connection,socket,n)
   If n<>0 : sendFault=15 : ProcedureReturn : EndIf
  ElseIf rc<0
   sendFault=16 : ProcedureReturn
  EndIf
  n=Service()
 Until rc=1
 If connection\result<>-9420 Or QuicConnectionSendStep(@connection)<>#QUIC_SEND_STATE Or HooksClear()<>1 : sendFault=17 : EndIf
 packetCancelChecked=1
EndProcedure
Procedure CheckReceiveCancellation()
 Define socket.i,rc.i,n.i,i.i,slice.i
 socket=UdpPayloadOpen(4,0,55013)
 If socket<=0 : receiveFault=4 : ProcedureReturn : EndIf
 rc=QuicConnectionBegin(@connection,@connectionSpans[0],socket,HwMicros(),20000000)
 If rc<>0 : receiveFault=5 : n=UdpPayloadClose(socket) : ProcedureReturn : EndIf
 For i=0 To 7 : originalId[i]=savedOriginal[i] : clientId[i]=savedClient[i] : Next
 For i=0 To savedReceiveBytes-1 : packet[i]=savedReceive[i] : Next
 rc=KeyDone(QuicInitialKeysBegin(@connection\keyjob,@connection\initial\readKeys,@originalId[0],8,1))
 If rc<>0 : receiveFault=6 : EndIf
 packet[savedReceiveBytes-1]=packet[savedReceiveBytes-1]!1
 rc=QuicConnectionReceivePacketBegin(@connection,@packet[0],savedReceiveBytes)
 If rc<>0 : cidFault=5 : EndIf
 Repeat
  rc=QuicConnectionReceiveStep(@connection) : n=Service()
 Until rc<>1
 If rc<>6 Or connection\peerIdKnown<>0 Or connection\peerIdBytes<>0 Or connection\initial\largest<>-1 : cidFault=6 : EndIf
 For i=0 To 19 : If peerId[i]<>0 : cidFault=7 : EndIf : Next
 For i=0 To savedReceiveBytes-1 : packet[i]=savedReceive[i] : Next
 rc=QuicConnectionReceivePacketBegin(@connection,@packet[0],savedReceiveBytes)
 If rc<>0 : receiveFault=7 : EndIf
 rc=QuicConnectionReceiveStep(@connection)
 If rc<>1 : receiveFault=8 : EndIf
 slice=tlsjob_sliceTicks : tlsjob_sliceTicks=1
 rc=QuicConnectionReceiveStep(@connection)
 tlsjob_sliceTicks=slice
 If rc<>1 Or TlsWorkerOwns(@connection\incoming\worker)<>1 : receiveFault=9 : EndIf
 rc=QuicConnectionClose(@connection,-9430)
 rc=QuicConnectionCloseStep(@connection)
 If rc<>0 Or connection\closeStage<>1 Or TlsWorkerBusy()<>0 Or GcmJobBusy()<>0 Or connection\receive\crypto\phase<>0 : receiveFault=10 : EndIf
 Repeat
  rc=QuicConnectionCloseStep(@connection)
  If rc=2
   n=UdpPayloadClose(socket) : n=QuicConnectionSocketClosed(@connection,socket,n)
   If n<>0 : receiveFault=11 : ProcedureReturn : EndIf
  ElseIf rc<0
   receiveFault=12 : ProcedureReturn
  EndIf
  n=Service()
 Until rc=1
 If connection\result<>-9430 Or QuicConnectionReceiveStep(@connection)<>#QUIC_RECEIVE_STATE Or HooksClear()<>1 : receiveFault=13 : EndIf
 receiveCancelled=1
EndProcedure
Procedure CheckApplicationCancellation()
 Define socket.i,rc.i,n.i,i.i,slice.i
 If savedApplicationBytes=0 : applicationFault=7 : ProcedureReturn : EndIf
 socket=UdpPayloadOpen(4,0,55013)
 If socket<=0 : applicationFault=8 : ProcedureReturn : EndIf
 rc=QuicConnectionBegin(@connection,@connectionSpans[0],socket,HwMicros(),20000000)
 If rc<>0 : applicationFault=9 : n=UdpPayloadClose(socket) : ProcedureReturn : EndIf
 For i=0 To savedApplicationBytes-1 : packet[i]=savedApplication[i] : Next
 For i=0 To SizeOf(QuicKeys)-1 : PokeA(@connection\appRead+i,PeekA(@savedApplicationKeys+i)) : Next
 rc=QuicApplicationPacketBegin(@connection\application,@connection\appRead,@packet[0],savedApplicationBytes,8,-1,0)
 If rc<>0 : applicationFault=10 : EndIf
 slice=tlsjob_sliceTicks : tlsjob_sliceTicks=1
 rc=QuicApplicationPacketStep(@connection\application) : tlsjob_sliceTicks=slice
 If rc<>0 Or connection\application\crypto\phase=0 Or TlsWorkerOwns(@connection\application\worker)<>1 : applicationFault=11 : EndIf
 rc=QuicConnectionClose(@connection,-9443) : rc=QuicConnectionCloseStep(@connection)
 If rc<>0 Or connection\closeStage<>1 Or TlsWorkerBusy()<>0 Or GcmJobBusy()<>0 Or connection\application\crypto\phase<>0 : applicationFault=12 : EndIf
 If QuicApplicationPacketStep(@connection\application)<>#QUIC_APP_PACKET_CANCELLED : applicationFault=13 : EndIf
 Repeat
  rc=QuicConnectionCloseStep(@connection)
  If rc=2
   n=UdpPayloadClose(socket) : n=QuicConnectionSocketClosed(@connection,socket,n)
   If n<>0 : applicationFault=14 : ProcedureReturn : EndIf
  ElseIf rc<0
   applicationFault=15 : ProcedureReturn
  EndIf
  n=Service()
 Until rc=1
 QuicKeysWipe(@savedApplicationKeys)
 If connection\result<>-9443 Or HooksClear()<>1 : applicationFault=16 : EndIf
 applicationCancelled=1
EndProcedure
Procedure CheckHandshakeSecretRetirement()
 Define i.i,n.i,expected.i
 For i=0 To #TLS13_CONTEXT_SIZE-1 : probeSnapshot[i]=ownerSnapshot[i] : Next
 If Tls13ContextRetireHandshakeSecrets(0,#TLS13_CONTEXT_SIZE)<>0 : retireFault=1 : EndIf
 If Tls13ContextRetireHandshakeSecrets($7FFFFFFFFFFFFFF0,#TLS13_CONTEXT_SIZE)<>0 : retireFault=2 : EndIf
 If Tls13ContextRetireHandshakeSecrets(@probeSnapshot[0],#TLS13_CONTEXT_SIZE-1)<>0 : retireFault=3 : EndIf
 For i=0 To #TLS13_CONTEXT_SIZE-1 : If probeSnapshot[i]<>ownerSnapshot[i] : retireFault=4 : EndIf : Next
 PokeI(@probeSnapshot[0]+168,#TLS13_ST_SEND_FINISHED)
 For i=0 To #TLS13_CONTEXT_SIZE-1 : retrySnapshot[i]=probeSnapshot[i] : Next
 If Tls13ContextRetireHandshakeSecrets(@probeSnapshot[0],#TLS13_CONTEXT_SIZE)<>0 : retireFault=5 : EndIf
 For i=0 To #TLS13_CONTEXT_SIZE-1
  If probeSnapshot[i]<>retrySnapshot[i] : retireFault=6 : EndIf
  probeSnapshot[i]=ownerSnapshot[i]
 Next
 ForeignContext() : n=Tls13ContextSave(@beforeSnapshot[0],#TLS13_CONTEXT_SIZE)
 If Tls13ContextRetireHandshakeSecrets(@probeSnapshot[0],#TLS13_CONTEXT_SIZE)<>1 : retireFault=7 : EndIf
 n=Tls13ContextSave(@afterSnapshot[0],#TLS13_CONTEXT_SIZE)
 For i=0 To #TLS13_CONTEXT_SIZE-1
  If beforeSnapshot[i]<>afterSnapshot[i] : retireFault=8 : EndIf
  expected=ownerSnapshot[i]
  If (i>=272 And i<=367) Or (i>=400 And i<=463) Or (i>=528 And i<=623) : expected=0 : EndIf
  If probeSnapshot[i]<>expected : retireFault=9 : EndIf
 Next
 If Tls13ContextRetireHandshakeSecrets(@probeSnapshot[0],#TLS13_CONTEXT_SIZE)<>1 : retireFault=10 : EndIf
 n=Tls13ContextRestore(@probeSnapshot[0],#TLS13_CONTEXT_SIZE)
 n=Tls13ContextSave(@afterSnapshot[0],#TLS13_CONTEXT_SIZE)
 For i=0 To #TLS13_CONTEXT_SIZE-1 : If afterSnapshot[i]<>probeSnapshot[i] : retireFault=11 : EndIf : Next
 n=Tls13ContextRestore(@ownerSnapshot[0],#TLS13_CONTEXT_SIZE)
 n=Tls13ContextWipe(@probeSnapshot[0],#TLS13_CONTEXT_SIZE)
 n=Tls13ContextWipe(@retrySnapshot[0],#TLS13_CONTEXT_SIZE)
 retireChecked=1
EndProcedure
Procedure FixtureMark(value.i)
 PokeI($E1C0FF00,value) : MmuCleanRange($E1C0FF00,64)
EndProcedure
