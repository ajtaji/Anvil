Global controlFault.i,controlChecked.i,controlDelay.i,controlReceipt.i
Global peerIdsFault.i,peerIdsChecked.i,peerIdsFrames.i
Global confirmFault.i,confirmChecked.i,confirmForeign.i,confirmSecretPresent.i
Global applicationStateFault.i
Global applicationFault.i,applicationBadTag.i,applicationCancelled.i,applicationPing.i
Global lossPhase.i,lossAckCount.i,lossFault.i,lossEvents.i,lossChecked.i
Global probeFault.i,probeChecked.i,probeNumber.i,probeBytes.i
Global deliveryProbes.i
Global applicationDelivery.i,deliveryFault.i,deliveryEvents.i,deliverySteps.i,deliveryNumber.i
Global applicationSteps.i,maxApplicationStep.i,applicationNumber.i,applicationWriteReady.i
Global savedApplicationBytes.i,savedApplicationKeys.QuicKeys
Global Dim savedApplication.a[1472]
Global startupFault.i,startupChecks.i,startupSteps.i,maxStartupStep.i
Global ackFault.i,ackChecks.i,ackSteps.i,maxAckStep.i
Global receiveFault.i,receiveCancelled.i,receiveSteps.i,maxReceiveStep.i,savedReceiveBytes.i
Global Dim savedReceive.a[1472]
Global Dim savedOriginal.a[8]
Global deadlineOp.QuicTlsOperation,outputOp.QuicTlsOperation,inputOp.QuicTlsOperation
Global probeTx.QuicCryptoTx,probeRx.QuicCryptoRx,probeOut.QuicTlsOutput
Global operationFault.i,operationProbes.i,extraContextChecks.i
Global Dim probeData.a[4096]
Global Dim probeBits.a[1024]
Global Dim probeOutput.a[2048]
Global Dim probeSnapshot.a[#TLS13_CONTEXT_SIZE]
Global liveJob.TlsContextWorkerJob,otherJob.TlsWorkerJob
Global refusedJob.TlsContextWorkerJob
Global contextFault.i,contextChecks.i,cancelChecked.i
Global Dim ownerSnapshot.a[#TLS13_CONTEXT_SIZE]
Global Dim retrySnapshot.a[#TLS13_CONTEXT_SIZE]
Global Dim beforeSnapshot.a[#TLS13_CONTEXT_SIZE]
Global Dim afterSnapshot.a[#TLS13_CONTEXT_SIZE]
