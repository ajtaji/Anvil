; Physical interoperability fixture, NOT a production connection scheduler.
; Generated header supplies shared TLS, QUIC, UDP, board entropy and test CA.
; Runs TLS arithmetic through the shared cooperative worker; UDP stays in
; the foreground dispatcher, outside the worker context.
; No Retry, migration, complete recovery scheduler or HTTP/3 requests.
; The first protected 1-RTT packet is authenticated and its frame syntax is
; decoded. HANDSHAKE_DONE and NEW_CONNECTION_ID effects run; ACK transmission
; now produces an application ACK/PING after all supported effects succeed.
; Other frame kinds are refused without committing an application receipt.
; TLS completion is also checked independently by the server.
Global recoveryCloseFault.i,recoveryCloseChecked.i
Global initialProbeChecked.i,initialProbeDue.i,initialProbeFired.i,initialProbeBefore.i,initialProbeAfter.i
Global retryChecks.i,retryFault.i,retryActual.i,retryWanted.i
Global Dim retryData.a[4096]
Global Dim retryStates.a[1024]
Global Dim retrySource.a[600]
Global Dim retryMeta.i[8]
Global handshakeRttCount.i,datagramReceivedAt.i
Global Dim handshakeRttTrace.i[80]
Global lossDispatchChecked.i,lossDispatchAt.i,lossDispatchDone.i
Global priorityContext.QuicConnection
Global Dim prioritySlots.i[48]
Global priorityChecks.i,priorityFault.i,priorityActual.i,priorityWanted.i,priorityLossEvents.i
Global pollGuardFault.i,pollAckChecks.i,pollLossChecks.i,pollSpaceMask.i
Global rearmFault.i,rearmChecked.i,probeRearmDue.i,ackRearmDue.i
Global repeatBase.i,repeatDue.i,repeatFired.i,thirdProbeDue.i
Global timerFault.i,timerBase.i,timerDue.i,timerFired.i,timerCount.i
Global pathRtt.QuicRtt,rttSamples.i,rttFault.i
Global Dim rttTrace.i[32]
Global connection.QuicConnection
Global Dim connectionSpans.i[40]
Global bufferWiped.i,closeFault.i,storageRefused.i,closeCalls.i,maxCloseStep.i
Global closeHold.TlsWorkerJob,closeHoldRuns.i
Global lifecycleFault.i,lifecycleProbes.i
Global Dim foreignHs.a[32768]
Global Dim foreignRecv.a[16645]
Global services.i,*pet,*clock,started.i,handle.i,maxService.i
Global ep.UdpEndpoint,info.UdpDatagramInfo,status.UdpSocketStatus
Global peerBytes.i,hsReady.i,paramsReady.i,initialDiscarded.i
Global received.i,sent.i,ackEvents.i,appAuthenticated.i,stage.i
Global lastPump.i,maxPumpGap.i,maxTlsStep.i,maxSendStep.i,sendSteps.i
Global sendFault.i,sendProbes.i,packetCancelChecked.i
Global cidFault.i,cidChecks.i
Global Dim savedClient.a[8]
Global feedFault.i,keyCancelled.i,feedSteps.i,maxFeedStep.i
Global keyOp.QuicTlsOperation,probeKey.QuicKeyJob,probeKeys.QuicKeys
Global preparedKeyOp.QuicTlsOperation
Global applicationFrame.QuicApplicationFrame,applicationFrames.i,doneSeen.i
Global retireFault.i,retireChecked.i
