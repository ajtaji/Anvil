; Returning RK3399 Mali-T860 48x48 private linear fragment proof.
; It rechecks PMU/CRU admission, follows Linux Panfrost reset/power/AS0 setup,
; then submits one Mesa Midgard v5 FRAGMENT job to a guarded private RGBA8
; surface. The GPU MMU maps only the private 2 MiB descriptor/surface window.
; The resident payload command arms Anvil's physical deadman before entry.
; No scanout framebuffer or filesystem memory is a job target. Compile and run
; only through tools/rockpi4c_mali_fragment_proof.py: it reads the live stage,
; links at that address, checks the stack gap, and uses the deadman uploader.
;
; Wire format when infrastructure is admitted:
;   G1 <PWRDN_CON> <PWRDN_ST> <IDLE_REQ> <IDLE_ST> <IDLE_ACK>
;      <CLKSEL13> <CLKGATE13> <CLKGATE30> <SOFTRST18> <INFRA_REFUSAL>
;      <GPU_ID> <MMU_FEATURES> <AS_PRESENT> <JS_PRESENT> <GPU_STATUS>
;      <JOB_INT_JS_STATE> <MMU_INT_STAT> <GPU_REFUSAL> CR LF
;
; If INFRA_REFUSAL is nonzero, that word is followed immediately by CR LF
; and return.  No address in 0xFF9A0000..0xFF9AFFFF is then accessed.
;
; INFRA_REFUSAL bits:
;   0 PWRDN_CON[15], 1 PWRDN_ST[15], 2 IDLE_REQ[0],
;   3 IDLE_ST[0], 4 IDLE_ACK[0], 5 CLKGATE13[0],
;   6 CLKGATE30[8], 7 SOFTRST18[2:0], 8 CLKSEL13 parent > 4.
; GPU_REFUSAL bits:
;   0 GPU_ID product is not 0x0860, 1 MMU VA/PA width is zero,
;   2 AS_PRESENT is zero, 3 JS_PRESENT is zero.
; R2 is reset IRQ and poll count; P0/P1/P2 are L2/shader/tiler present/ready.
; M0 is AS0 TRANSTAB, MEMATTR, STATUS. F0 is fragment interrupt, private
; surface first/last pixel, guards, job exception, JS0 status and AS0 fault.
; Success returns 0x47514000.
;
; pmf:target rockpi4c

#GPU_REACH_UART2_THR = $FF1A0000
#GPU_REACH_UART2_LSR = $FF1A0014
#GPU_REACH_UART2_THRE = $20
#GPU_REACH_UART_SPINS = 1000000

#GPU_REACH_PWRDN_CON = $FF310014
#GPU_REACH_PWRDN_ST = $FF310018
#GPU_REACH_IDLE_REQ = $FF310060
#GPU_REACH_IDLE_ST = $FF310064
#GPU_REACH_IDLE_ACK = $FF310068
#GPU_REACH_CLKSEL13 = $FF760134
#GPU_REACH_CLKGATE13 = $FF760334
#GPU_REACH_CLKGATE30 = $FF760378
#GPU_REACH_SOFTRST18 = $FF760448

#GPU_REACH_GPU_ID = $FF9A0000
#GPU_REACH_MMU_FEATURES = $FF9A0014
#GPU_REACH_AS_PRESENT = $FF9A0018
#GPU_REACH_JS_PRESENT = $FF9A001C
#GPU_REACH_GPU_STATUS = $FF9A0034
#GPU_REACH_JOB_INT_JS_STATE = $FF9A1010
#GPU_REACH_MMU_INT_STAT = $FF9A200C
#GPU_REACH_INT_RAWSTAT = $FF9A0020
#GPU_REACH_INT_CLEAR = $FF9A0024
#GPU_REACH_INT_MASK = $FF9A0028
#GPU_REACH_CMD = $FF9A0030
#GPU_REACH_WDT_CRR = $FF84800C
#GPU_REACH_SHADER_PRESENT = $FF9A0100
#GPU_REACH_TILER_PRESENT = $FF9A0110
#GPU_REACH_L2_PRESENT = $FF9A0120
#GPU_REACH_SHADER_READY = $FF9A0140
#GPU_REACH_TILER_READY = $FF9A0150
#GPU_REACH_L2_READY = $FF9A0160
#GPU_REACH_SHADER_PWRON = $FF9A0180
#GPU_REACH_TILER_PWRON = $FF9A0190
#GPU_REACH_L2_PWRON = $FF9A01A0
#GPU_REACH_JM_CONFIG = $FF9A0F00
#GPU_REACH_SHADER_CONFIG = $FF9A0F04
#GPU_REACH_TILER_CONFIG = $FF9A0F08
#GPU_REACH_AS0_TRANSTAB_LO = $FF9A2400
#GPU_REACH_AS0_TRANSTAB_HI = $FF9A2404
#GPU_REACH_AS0_MEMATTR_LO = $FF9A2408
#GPU_REACH_AS0_MEMATTR_HI = $FF9A240C
#GPU_REACH_AS0_COMMAND = $FF9A2418
#GPU_REACH_AS0_FAULTSTATUS = $FF9A241C
#GPU_REACH_AS0_FAULTADDRESS_LO = $FF9A2420
#GPU_REACH_AS0_FAULTADDRESS_HI = $FF9A2424
#GPU_REACH_AS0_STATUS = $FF9A2428
#GPU_REACH_JOB_INT_RAWSTAT = $FF9A1000
#GPU_REACH_JOB_INT_CLEAR = $FF9A1004
#GPU_REACH_JS1_HEAD_NEXT_LO = $FF9A18C0
#GPU_REACH_JS1_HEAD_NEXT_HI = $FF9A18C4
#GPU_REACH_JS1_AFFINITY_NEXT_LO = $FF9A18D0
#GPU_REACH_JS1_AFFINITY_NEXT_HI = $FF9A18D4
#GPU_REACH_JS1_CONFIG_NEXT = $FF9A18D8
#GPU_REACH_JS1_COMMAND_NEXT = $FF9A18E0
#GPU_REACH_JS1_STATUS = $FF9A18A4
#GPU_REACH_JS0_HEAD_NEXT_LO = $FF9A1840
#GPU_REACH_JS0_HEAD_NEXT_HI = $FF9A1844
#GPU_REACH_JS0_AFFINITY_NEXT_LO = $FF9A1850
#GPU_REACH_JS0_AFFINITY_NEXT_HI = $FF9A1854
#GPU_REACH_JS0_CONFIG_NEXT = $FF9A1858
#GPU_REACH_JS0_COMMAND_NEXT = $FF9A1860
#GPU_REACH_JS0_STATUS = $FF9A1824
#GPU_RGA_BASE = $FF680000
#GPU_RGA_PMU = $FF310000
#GPU_RGA_CRU = $FF760000
#GPU_RGA_VERSION = $03218218

Global Dim gpu_l0.a[8192]
Global Dim gpu_l1.a[8192]
Global Dim gpu_l2.a[8192]
Global Dim gpu_job.a[128]
Global Dim gpu_fbd.a[512]
Global Dim gpu_polygon.a[5120]
Global Dim gpu_surface.a[16384]
Global Dim gpu_rga_dst.l[2306]
Global Dim gpu_rga_src_pages.a[528]
Global Dim gpu_rga_dst_pages.a[528]
Global Dim gpu_rga_command.a[256]

Procedure.i GpuReachTx(value.i)
  Protected attempt.i
  For attempt=0 To #GPU_REACH_UART_SPINS-1
    If (PeekL(#GPU_REACH_UART2_LSR) & #GPU_REACH_UART2_THRE)<>0
      PokeL(#GPU_REACH_UART2_THR,value & 255)
      ProcedureReturn 1
    EndIf
  Next
  ProcedureReturn 0
EndProcedure

Procedure.i GpuReachHex32(value.i)
  Protected shift.i
  Protected digit.i
  For shift=28 To 0 Step -4
    digit=(value >> shift) & 15
    If digit<10
      If GpuReachTx(48+digit)=0 : ProcedureReturn 0 : EndIf
    Else
      If GpuReachTx(55+digit)=0 : ProcedureReturn 0 : EndIf
    EndIf
  Next
  ProcedureReturn 1
EndProcedure

Procedure.i GpuReachWord(value.i)
  If GpuReachHex32(value)=0 : ProcedureReturn 0 : EndIf
  ProcedureReturn GpuReachTx(32)
EndProcedure

Procedure.i GpuReachNewline()
  If GpuReachTx(13)=0 : ProcedureReturn 0 : EndIf
  ProcedureReturn GpuReachTx(10)
EndProcedure

Procedure.i GpuRgaMap(table.i,buffer.i,bytes.i)
  Protected first.i
  Protected offset.i
  Protected pages.i
  Protected index.i
  If table=0 Or buffer=0 Or bytes<1 : ProcedureReturn -1 : EndIf
  first=buffer & ~$FFF
  offset=buffer-first
  pages=(offset+bytes+4095)/4096
  If pages<1 Or pages>128 : ProcedureReturn -1 : EndIf
  For index=0 To pages-1
    PokeL(table+index*4,first+index*4096)
  Next
  ProcedureReturn offset
EndProcedure

Procedure.i Main()
  Protected pwrdnCon.i
  Protected pwrdnSt.i
  Protected idleReq.i
  Protected idleSt.i
  Protected idleAck.i
  Protected clksel13.i
  Protected clkgate13.i
  Protected clkgate30.i
  Protected softrst18.i
  Protected infraRefusal.i
  Protected gpuId.i
  Protected mmuFeatures.i
  Protected asPresent.i
  Protected jsPresent.i
  Protected gpuStatus.i
  Protected jobIntJsState.i
  Protected mmuIntStat.i
  Protected gpuRefusal.i
  Protected resetRaw.i
  Protected resetAttempt.i
  Protected l2Present.i
  Protected shaderPresent.i
  Protected tilerPresent.i
  Protected coreMask.i
  Protected expected.i
  Protected ready.i
  Protected phase.i
  Protected root.i
  Protected level1.i
  Protected level2.i
  Protected job.i
  Protected fbd.i
  Protected polygon.i
  Protected target.i
  Protected pixelIndex.i
  Protected badPixels.i
  Protected firstPixel.i
  Protected lastPixel.i
  Protected guardBefore.i
  Protected guardAfter.i
  Protected jobRaw.i
  Protected jobAttempt.i
  Protected row.i
  Protected column.i
  Protected goodInRow.i
  Protected rgaBlocked.i
  Protected rgaVersion.i
  Protected rgaDst.i
  Protected rgaSrcTable.i
  Protected rgaDstTable.i
  Protected rgaCommand.i
  Protected rgaSrcOffset.i
  Protected rgaDstOffset.i
  Protected rgaInterrupt.i
  Protected rgaPoll.i
  Protected rgaPrevious.i
  Protected rgaMismatch.i
  Protected rgaFirstBad.i

  If GpuReachTx(71)=0 : ProcedureReturn $E501 : EndIf
  If GpuReachTx(49)=0 : ProcedureReturn $E502 : EndIf
  If GpuReachTx(32)=0 : ProcedureReturn $E503 : EndIf

  pwrdnCon=PeekL(#GPU_REACH_PWRDN_CON) & $FFFFFFFF
  If GpuReachWord(pwrdnCon)=0 : ProcedureReturn $E504 : EndIf
  pwrdnSt=PeekL(#GPU_REACH_PWRDN_ST) & $FFFFFFFF
  If GpuReachWord(pwrdnSt)=0 : ProcedureReturn $E505 : EndIf
  idleReq=PeekL(#GPU_REACH_IDLE_REQ) & $FFFFFFFF
  If GpuReachWord(idleReq)=0 : ProcedureReturn $E506 : EndIf
  idleSt=PeekL(#GPU_REACH_IDLE_ST) & $FFFFFFFF
  If GpuReachWord(idleSt)=0 : ProcedureReturn $E507 : EndIf
  idleAck=PeekL(#GPU_REACH_IDLE_ACK) & $FFFFFFFF
  If GpuReachWord(idleAck)=0 : ProcedureReturn $E508 : EndIf
  clksel13=PeekL(#GPU_REACH_CLKSEL13) & $FFFFFFFF
  If GpuReachWord(clksel13)=0 : ProcedureReturn $E509 : EndIf
  clkgate13=PeekL(#GPU_REACH_CLKGATE13) & $FFFFFFFF
  If GpuReachWord(clkgate13)=0 : ProcedureReturn $E50A : EndIf
  clkgate30=PeekL(#GPU_REACH_CLKGATE30) & $FFFFFFFF
  If GpuReachWord(clkgate30)=0 : ProcedureReturn $E50B : EndIf
  softrst18=PeekL(#GPU_REACH_SOFTRST18) & $FFFFFFFF
  If GpuReachWord(softrst18)=0 : ProcedureReturn $E50C : EndIf

  infraRefusal=0
  If (pwrdnCon & $00008000)<>0 : infraRefusal=infraRefusal | $001 : EndIf
  If (pwrdnSt & $00008000)<>0 : infraRefusal=infraRefusal | $002 : EndIf
  If (idleReq & $00000001)<>0 : infraRefusal=infraRefusal | $004 : EndIf
  If (idleSt & $00000001)<>0 : infraRefusal=infraRefusal | $008 : EndIf
  If (idleAck & $00000001)<>0 : infraRefusal=infraRefusal | $010 : EndIf
  If (clkgate13 & $00000001)<>0 : infraRefusal=infraRefusal | $020 : EndIf
  If (clkgate30 & $00000100)<>0 : infraRefusal=infraRefusal | $040 : EndIf
  If (softrst18 & $00000007)<>0 : infraRefusal=infraRefusal | $080 : EndIf
  If ((clksel13 >> 5) & 7)>4 : infraRefusal=infraRefusal | $100 : EndIf

  If infraRefusal<>0
    If GpuReachHex32(infraRefusal)=0 : ProcedureReturn $E50D : EndIf
    If GpuReachNewline()=0 : ProcedureReturn $E50E : EndIf
    ProcedureReturn $47511000 | infraRefusal
  EndIf
  If GpuReachWord(infraRefusal)=0 : ProcedureReturn $E50F : EndIf

  ASM
    dsb sy
  ENDASM
  gpuId=PeekL(#GPU_REACH_GPU_ID) & $FFFFFFFF
  If GpuReachWord(gpuId)=0 : ProcedureReturn $E510 : EndIf
  mmuFeatures=PeekL(#GPU_REACH_MMU_FEATURES) & $FFFFFFFF
  If GpuReachWord(mmuFeatures)=0 : ProcedureReturn $E511 : EndIf
  asPresent=PeekL(#GPU_REACH_AS_PRESENT) & $FFFFFFFF
  If GpuReachWord(asPresent)=0 : ProcedureReturn $E512 : EndIf
  jsPresent=PeekL(#GPU_REACH_JS_PRESENT) & $FFFFFFFF
  If GpuReachWord(jsPresent)=0 : ProcedureReturn $E513 : EndIf
  gpuStatus=PeekL(#GPU_REACH_GPU_STATUS) & $FFFFFFFF
  If GpuReachWord(gpuStatus)=0 : ProcedureReturn $E514 : EndIf
  jobIntJsState=PeekL(#GPU_REACH_JOB_INT_JS_STATE) & $FFFFFFFF
  If GpuReachWord(jobIntJsState)=0 : ProcedureReturn $E515 : EndIf
  mmuIntStat=PeekL(#GPU_REACH_MMU_INT_STAT) & $FFFFFFFF
  If GpuReachWord(mmuIntStat)=0 : ProcedureReturn $E516 : EndIf

  gpuRefusal=0
  If ((gpuId >> 16) & $FFFF)<>$0860 : gpuRefusal=gpuRefusal | $1 : EndIf
  If (mmuFeatures & $FF)=0 Or ((mmuFeatures >> 8) & $FF)=0
    gpuRefusal=gpuRefusal | $2
  EndIf
  If asPresent=0 : gpuRefusal=gpuRefusal | $4 : EndIf
  If jsPresent=0 : gpuRefusal=gpuRefusal | $8 : EndIf
  If GpuReachHex32(gpuRefusal)=0 : ProcedureReturn $E517 : EndIf
  If GpuReachNewline()=0 : ProcedureReturn $E518 : EndIf
  If gpuRefusal<>0 : ProcedureReturn $47512000 | gpuRefusal : EndIf

  ; Linux panfrost_gpu_soft_reset(): mask IRQs, clear the reset-complete
  ; status, request SOFT_RESET, then poll RAWSTAT for bit 8.
  PokeL(#GPU_REACH_WDT_CRR,$76)
  PokeL(#GPU_REACH_INT_MASK,0)
  PokeL(#GPU_REACH_INT_CLEAR,$100)
  ASM
    dsb sy
  ENDASM
  PokeL(#GPU_REACH_CMD,1)
  resetRaw=0
  For resetAttempt=0 To 999999
    resetRaw=PeekL(#GPU_REACH_INT_RAWSTAT) & $FFFFFFFF
    If (resetRaw & $100)<>0 : Break : EndIf
    If (resetAttempt & $FFF)=0 : PokeL(#GPU_REACH_WDT_CRR,$76) : EndIf
  Next
  If GpuReachTx(82)=0 : ProcedureReturn $E519 : EndIf
  If GpuReachTx(50)=0 : ProcedureReturn $E51A : EndIf
  If GpuReachTx(32)=0 : ProcedureReturn $E51B : EndIf
  If GpuReachWord(resetRaw)=0 : ProcedureReturn $E51C : EndIf
  If GpuReachHex32(resetAttempt)=0 : ProcedureReturn $E51D : EndIf
  If GpuReachNewline()=0 : ProcedureReturn $E51E : EndIf
  If (resetRaw & $100)=0 : ProcedureReturn $47513001 : EndIf
  ; Linux clears all known GPU status bits and re-enables fault reporting.
  PokeL(#GPU_REACH_INT_CLEAR,$30781)
  PokeL(#GPU_REACH_INT_MASK,$30081)
  ASM
    dsb sy
  ENDASM
  ; T860-r2p0 quirks and power order from panfrost_gpu_init_quirks()
  ; and panfrost_gpu_power_on().
  PokeL(#GPU_REACH_SHADER_CONFIG,$00010000)
  PokeL(#GPU_REACH_TILER_CONFIG,(PeekL(#GPU_REACH_TILER_CONFIG) & $FFFFFFFF) | 1)
  PokeL(#GPU_REACH_JM_CONFIG,$000001F8)
  l2Present=PeekL(#GPU_REACH_L2_PRESENT) & $FFFFFFFF
  shaderPresent=PeekL(#GPU_REACH_SHADER_PRESENT) & $FFFFFFFF
  tilerPresent=PeekL(#GPU_REACH_TILER_PRESENT) & $FFFFFFFF
  If l2Present=0 Or shaderPresent=0 Or tilerPresent=0 : ProcedureReturn $47513002 : EndIf
  coreMask=$FFFFFFFF
  If l2Present<>1
    coreMask=(~(l2Present-1)) & (l2Present-2) & $FFFFFFFF
  EndIf
  For phase=0 To 2
    Select phase
      Case 0
        expected=l2Present & coreMask
        PokeL(#GPU_REACH_L2_PWRON,expected)
      Case 1
        expected=shaderPresent & coreMask
        PokeL(#GPU_REACH_SHADER_PWRON,expected)
      Case 2
        expected=tilerPresent
        PokeL(#GPU_REACH_TILER_PWRON,expected)
    EndSelect
    ready=0
    For resetAttempt=0 To 199999
      Select phase
        Case 0 : ready=PeekL(#GPU_REACH_L2_READY) & $FFFFFFFF
        Case 1 : ready=PeekL(#GPU_REACH_SHADER_READY) & $FFFFFFFF
        Case 2 : ready=PeekL(#GPU_REACH_TILER_READY) & $FFFFFFFF
      EndSelect
      If ready=expected : Break : EndIf
      If (resetAttempt & $FFF)=0 : PokeL(#GPU_REACH_WDT_CRR,$76) : EndIf
    Next
    If GpuReachTx(80)=0 : ProcedureReturn $E51F : EndIf
    If GpuReachTx(48+phase)=0 : ProcedureReturn $E520 : EndIf
    If GpuReachTx(32)=0 : ProcedureReturn $E521 : EndIf
    If GpuReachWord(expected)=0 : ProcedureReturn $E522 : EndIf
    If GpuReachHex32(ready)=0 : ProcedureReturn $E523 : EndIf
    If GpuReachNewline()=0 : ProcedureReturn $E524 : EndIf
    If ready<>expected : ProcedureReturn $47513010 | phase : EndIf
  Next
  ; io-pgtable-arm.c ARM_MALI_LPAE attributes, but only one private 2-MiB
  ; level-2 block at 0x10000000 is mapped. No scanout or monitor memory is
  ; GPU-addressable if a descriptor is malformed. CPU cache is disabled.
  root=(@gpu_l0[0]+4095) & ~$FFF
  level1=(@gpu_l1[0]+4095) & ~$FFF
  level2=(@gpu_l2[0]+4095) & ~$FFF
  job=(@gpu_job[0]+63) & ~$3F
  fbd=(@gpu_fbd[0]+63) & ~$3F
  polygon=(@gpu_polygon[0]+4095) & ~$FFF
  target=((@gpu_surface[0]+63) & ~$3F)+64
  If root<$10000000 Or level1<$10000000 Or level2<$10000000 Or job<$10000000 Or fbd<$10000000 Or polygon<$10000000 Or target<$10000000
    ProcedureReturn $47514020
  EndIf
  If root+4096>$10200000 Or level1+4096>$10200000 Or level2+4096>$10200000 Or job+64>$10200000 Or fbd+256>$10200000 Or polygon+512>$10200000 Or target+9220>$10200000
    ProcedureReturn $47514021
  EndIf
  ; Clear the entire aligned translation pages, not only the three used
  ; entries. A flat recovery payload cannot rely on prior DDR contents.
  For pixelIndex=0 To 1023
    PokeL(root+pixelIndex*4,0)
    PokeL(level1+pixelIndex*4,0)
    PokeL(level2+pixelIndex*4,0)
  Next
  PokeL(root,level1 | 3)
  PokeL(root+4,0)
  PokeL(level1,level2 | 3)
  PokeL(level1+4,0)
  PokeL(level2+128*8,$100002C1)
  PokeL(level2+128*8+4,$00600000)
  PokeL(target-4,$11223344)
  For pixelIndex=0 To 2303
    PokeL(target+pixelIndex*4,$A5A5A5A5)
  Next
  PokeL(target+9216,$55667788)
  ASM
    dsb sy
  ENDASM
  ; Linux panfrost_mmu_enable(): flush, publish TRANSTAB/MEMATTR, UPDATE.
  If (PeekL(#GPU_REACH_AS0_STATUS) & 1)<>0 : ProcedureReturn $47513021 : EndIf
  PokeL(#GPU_REACH_AS0_COMMAND,5)
  For resetAttempt=0 To 99999
    If (PeekL(#GPU_REACH_AS0_STATUS) & 1)=0 : Break : EndIf
    If (resetAttempt & $FFF)=0 : PokeL(#GPU_REACH_WDT_CRR,$76) : EndIf
  Next
  If (PeekL(#GPU_REACH_AS0_STATUS) & 1)<>0 : ProcedureReturn $47513022 : EndIf
  PokeL(#GPU_REACH_AS0_TRANSTAB_LO,root | 7)
  PokeL(#GPU_REACH_AS0_TRANSTAB_HI,0)
  PokeL(#GPU_REACH_AS0_MEMATTR_LO,$00888D88)
  PokeL(#GPU_REACH_AS0_MEMATTR_HI,0)
  ASM
    dsb sy
  ENDASM
  PokeL(#GPU_REACH_AS0_COMMAND,1)
  For resetAttempt=0 To 99999
    If (PeekL(#GPU_REACH_AS0_STATUS) & 1)=0 : Break : EndIf
    If (resetAttempt & $FFF)=0 : PokeL(#GPU_REACH_WDT_CRR,$76) : EndIf
  Next
  If GpuReachTx(77)=0 : ProcedureReturn $E525 : EndIf
  If GpuReachTx(48)=0 : ProcedureReturn $E526 : EndIf
  If GpuReachTx(32)=0 : ProcedureReturn $E527 : EndIf
  If GpuReachWord(PeekL(#GPU_REACH_AS0_TRANSTAB_LO))=0 : ProcedureReturn $E528 : EndIf
  If GpuReachWord(PeekL(#GPU_REACH_AS0_MEMATTR_LO))=0 : ProcedureReturn $E529 : EndIf
  If GpuReachHex32(PeekL(#GPU_REACH_AS0_STATUS))=0 : ProcedureReturn $E52A : EndIf
  If GpuReachNewline()=0 : ProcedureReturn $E52B : EndIf
  If (PeekL(#GPU_REACH_AS0_STATUS) & 1)<>0 Or (PeekL(#GPU_REACH_AS0_FAULTSTATUS) & $FFFFFFFF)<>0
    ProcedureReturn $47513023
  EndIf

  ; Mesa panfrost/genxml/v5.xml: a 48x48, single-sample RGBA8 FBD, one
  ; linear private render target and the clear-only disabled Midgard tiler.
  ; Panfrost's FBD emitter uses an effective 256-pixel tile, 1 KiB color
  ; buffer, and forces clean pixel writeback for a cleared RT.
  ; Recovery executes a flat payload whose separate BSS may retain bytes
  ; left by an earlier payload. Every descriptor word must be initialized.
  For pixelIndex=0 To 63 : PokeL(fbd+pixelIndex*4,0) : Next
  For pixelIndex=0 To 15 : PokeL(job+pixelIndex*4,0) : Next
  For pixelIndex=0 To 127 : PokeL(polygon+pixelIndex*4,0) : Next
  PokeL(fbd+4,31)                 ; no WLS instances
  PokeL(fbd+32,$002F002F)        ; width/height, minus one
  PokeL(fbd+40,$002F002F)        ; bound max X/Y
  PokeL(fbd+44,$01001080)        ; sample 1, tie break 2, tile 256, cbuf 1 KiB
  PokeL(fbd+48,$00010000)        ; default D24 internal Z, no Z target
  PokeL(fbd+56,512)              ; minimum polygon-list header
  PokeL(fbd+60,4096)             ; MALI_MIDGARD_TILER_DISABLED
  PokeL(fbd+64,polygon)
  PokeL(fbd+72,polygon+512)
  PokeL(fbd+80,polygon)
  PokeL(fbd+88,polygon)
  PokeL(fbd+128,$04000000)      ; R8G8B8A8 tilebuffer internal format
  PokeL(fbd+132,$86888899)      ; write RGBA8, linear block=2, swizzle 0x688, clean
  PokeL(fbd+160,target)          ; RT writeback buffer base
  PokeL(fbd+168,192)             ; 48-pixel destination canvas pitch
  For pixelIndex=0 To 3
    PokeL(fbd+176+pixelIndex*4,$7F00FF00) ; clear RGBA
  Next
  ; v5 FRAGMENT job uses slot 0. Bounds cover three tiles in each axis.
  PokeL(job+16,$00010013)        ; index 1, 64-bit, type FRAGMENT (9)
  PokeL(job+32,0)                ; tile bounds min X/Y both zero
  PokeL(job+36,$00020002)        ; tile bounds max X/Y both two
  PokeL(job+40,fbd | 1)          ; MFBD pointer tag, one RT
  ASM
    dsb sy
  ENDASM
  If (PeekL(#GPU_REACH_JS0_COMMAND_NEXT) & $FFFFFFFF)<>0 : ProcedureReturn $47514024 : EndIf
  PokeL(#GPU_REACH_JOB_INT_CLEAR,$00010001)
  PokeL(#GPU_REACH_JS0_HEAD_NEXT_LO,job)
  PokeL(#GPU_REACH_JS0_HEAD_NEXT_HI,0)
  PokeL(#GPU_REACH_JS0_AFFINITY_NEXT_LO,shaderPresent)
  PokeL(#GPU_REACH_JS0_AFFINITY_NEXT_HI,0)
  PokeL(#GPU_REACH_JS0_CONFIG_NEXT,$00083300)
  ASM
    dsb sy
  ENDASM
  PokeL(#GPU_REACH_JS0_COMMAND_NEXT,1)
  jobRaw=0
  For jobAttempt=0 To 999999
    jobRaw=PeekL(#GPU_REACH_JOB_INT_RAWSTAT) & $FFFFFFFF
    If (jobRaw & $00010001)<>0 : Break : EndIf
    If (jobAttempt & $FFF)=0 : PokeL(#GPU_REACH_WDT_CRR,$76) : EndIf
  Next
  firstPixel=PeekL(target) & $FFFFFFFF
  lastPixel=PeekL(target+9212) & $FFFFFFFF
  guardBefore=PeekL(target-4) & $FFFFFFFF
  guardAfter=PeekL(target+9216) & $FFFFFFFF
  badPixels=0
  For pixelIndex=0 To 2303
    If (PeekL(target+pixelIndex*4) & $FFFFFFFF)<>$7F00FF00
      badPixels=badPixels+1
    EndIf
  Next
  If GpuReachTx(70)=0 : ProcedureReturn $E52C : EndIf
  If GpuReachTx(48)=0 : ProcedureReturn $E52D : EndIf
  If GpuReachTx(32)=0 : ProcedureReturn $E52E : EndIf
  If GpuReachWord(jobRaw)=0 : ProcedureReturn $E52F : EndIf
  If GpuReachWord(firstPixel)=0 : ProcedureReturn $E530 : EndIf
  If GpuReachWord(lastPixel)=0 : ProcedureReturn $E531 : EndIf
  If GpuReachWord(badPixels)=0 : ProcedureReturn $E532 : EndIf
  If GpuReachWord(guardBefore)=0 : ProcedureReturn $E533 : EndIf
  If GpuReachWord(guardAfter)=0 : ProcedureReturn $E534 : EndIf
  If GpuReachWord(PeekL(job) & $FFFFFFFF)=0 : ProcedureReturn $E535 : EndIf
  If GpuReachWord(PeekL(#GPU_REACH_JS0_STATUS) & $FFFFFFFF)=0 : ProcedureReturn $E536 : EndIf
  If GpuReachHex32(PeekL(#GPU_REACH_AS0_FAULTSTATUS) & $FFFFFFFF)=0 : ProcedureReturn $E537 : EndIf
  If GpuReachNewline()=0 : ProcedureReturn $E534 : EndIf
  If GpuReachTx(68)=0 : ProcedureReturn $E53D : EndIf
  If GpuReachTx(49)=0 : ProcedureReturn $E53E : EndIf
  If GpuReachTx(32)=0 : ProcedureReturn $E53F : EndIf
  If GpuReachWord(target)=0 : ProcedureReturn $E540 : EndIf
  If GpuReachWord(PeekL(#GPU_REACH_AS0_FAULTADDRESS_LO) & $FFFFFFFF)=0 : ProcedureReturn $E541 : EndIf
  If GpuReachHex32(PeekL(#GPU_REACH_AS0_FAULTADDRESS_HI) & $FFFFFFFF)=0 : ProcedureReturn $E542 : EndIf
  If GpuReachNewline()=0 : ProcedureReturn $E543 : EndIf
  If GpuReachTx(67)=0 : ProcedureReturn $E538 : EndIf
  If GpuReachTx(49)=0 : ProcedureReturn $E539 : EndIf
  If GpuReachTx(32)=0 : ProcedureReturn $E53A : EndIf
  For row=0 To 47
    goodInRow=0
    For column=0 To 47
      If (PeekL(target+(row*48+column)*4) & $FFFFFFFF)=$7F00FF00
        goodInRow=goodInRow+1
      EndIf
    Next
    If GpuReachWord(goodInRow)=0 : ProcedureReturn $E53B : EndIf
  Next
  If GpuReachNewline()=0 : ProcedureReturn $E53C : EndIf
  If (jobRaw & 1)=0 Or (jobRaw & $00010000)<>0 Or badPixels<>0
    ProcedureReturn $47514025
  EndIf
  If guardBefore<>$11223344 Or guardAfter<>$55667788
    ProcedureReturn $47514026
  EndIf

  ; The Mali target is now verified. RGA2 copies the 48x48 linear surface
  ; into a separate guarded private buffer; scanout is not mapped or touched.
  rgaBlocked=0
  If ((PeekL(#GPU_RGA_PMU+$14) | PeekL(#GPU_RGA_PMU+$18)) & (1 << 18))<>0 : rgaBlocked=rgaBlocked | 1 : EndIf
  If ((PeekL(#GPU_RGA_PMU+$60) | PeekL(#GPU_RGA_PMU+$64) | PeekL(#GPU_RGA_PMU+$68)) & (1 << 5))<>0 : rgaBlocked=rgaBlocked | 2 : EndIf
  If (PeekL(#GPU_RGA_CRU+$310) & $700)<>0 : rgaBlocked=rgaBlocked | 4 : EndIf
  If (PeekL(#GPU_RGA_CRU+$340) & $F00)<>0 : rgaBlocked=rgaBlocked | 8 : EndIf
  If (PeekL(#GPU_RGA_CRU+$418) & $680)<>0 : rgaBlocked=rgaBlocked | 16 : EndIf
  If rgaBlocked<>0 : ProcedureReturn $47515010 | rgaBlocked : EndIf
  rgaVersion=PeekL(#GPU_RGA_BASE+$28) & $FFFFFFFF
  If rgaVersion<>#GPU_RGA_VERSION : ProcedureReturn $47515020 : EndIf
  rgaDst=@gpu_rga_dst[1]
  rgaSrcTable=(@gpu_rga_src_pages[0]+15) & ~$F
  rgaDstTable=(@gpu_rga_dst_pages[0]+15) & ~$F
  rgaCommand=(@gpu_rga_command[0]+15) & ~$F
  If rgaDst<0 Or rgaDst>$FFFFFFFF Or rgaSrcTable<0 Or rgaSrcTable>$FFFFFFFF Or rgaDstTable<0 Or rgaDstTable>$FFFFFFFF Or rgaCommand<0 Or rgaCommand>$FFFFFFFF
    ProcedureReturn $47515021
  EndIf
  PokeL(rgaDst-4,$AABBCCDD)
  For pixelIndex=0 To 2303
    PokeL(rgaDst+pixelIndex*4,$A5A5A5A5)
  Next
  PokeL(rgaDst+9216,$55667788)
  rgaSrcOffset=GpuRgaMap(rgaSrcTable,target,9216)
  rgaDstOffset=GpuRgaMap(rgaDstTable,rgaDst,9216)
  If rgaSrcOffset<0 Or rgaDstOffset<0 : ProcedureReturn $47515022 : EndIf
  rgaPrevious=PeekL(#GPU_RGA_BASE+$10) & $FFFFFFFF
  If (rgaPrevious & 15)<>0
    PokeL(#GPU_RGA_BASE+$10,(rgaPrevious & 15) << 4)
    If (PeekL(#GPU_RGA_BASE+$10) & 15)<>0 : ProcedureReturn $47515023 : EndIf
  EndIf
  For pixelIndex=0 To 31 : PokeL(rgaCommand+pixelIndex*4,0) : Next
  PokeL(rgaCommand+$00,$40)
  PokeL(rgaCommand+$04,$10)
  PokeL(rgaCommand+$08,rgaSrcOffset)
  PokeL(rgaCommand+$18,(48 << 16) | 48)
  PokeL(rgaCommand+$1C,(47 << 16) | 47)
  PokeL(rgaCommand+$38,$10)
  PokeL(rgaCommand+$3C,rgaDstOffset)
  PokeL(rgaCommand+$48,48)
  PokeL(rgaCommand+$4C,(47 << 16) | 47)
  PokeL(rgaCommand+$6C,$777)
  PokeL(rgaCommand+$70,rgaSrcTable >> 4)
  PokeL(rgaCommand+$74,rgaDstTable >> 4)
  PokeL(rgaCommand+$78,rgaDstTable >> 4)
  ASM
    dsb sy
  ENDASM
  PokeL(#GPU_RGA_BASE+$08,rgaCommand)
  PokeL(#GPU_RGA_BASE+$00,0)
  PokeL(#GPU_RGA_BASE+$00,$22)
  PokeL(#GPU_RGA_BASE+$10,$600)
  ASM
    dsb sy
  ENDASM
  PokeL(#GPU_RGA_BASE+$04,1)
  rgaInterrupt=0
  For rgaPoll=0 To 99999
    rgaInterrupt=PeekL(#GPU_RGA_BASE+$10) & $FFFFFFFF
    If (rgaInterrupt & 15)<>0 : Break : EndIf
    If (rgaPoll & $FFF)=0 : PokeL(#GPU_REACH_WDT_CRR,$76) : EndIf
  Next
  If (rgaInterrupt & 15)<>0 : PokeL(#GPU_RGA_BASE+$10,(rgaInterrupt & 15) << 4) : EndIf
  rgaMismatch=0
  rgaFirstBad=$FFFFFFFF
  For pixelIndex=0 To 2303
    If (PeekL(target+pixelIndex*4) & $FFFFFFFF)<>$7F00FF00
      If rgaMismatch=0 : rgaFirstBad=$80000000 | pixelIndex : EndIf
      rgaMismatch=rgaMismatch+1
    EndIf
    If (PeekL(rgaDst+pixelIndex*4) & $FFFFFFFF)<>$7F00FF00
      If rgaMismatch=0 : rgaFirstBad=pixelIndex : EndIf
      rgaMismatch=rgaMismatch+1
    EndIf
  Next
  If (PeekL(target-4) & $FFFFFFFF)<>$11223344 : rgaMismatch=rgaMismatch+1 : EndIf
  If (PeekL(target+9216) & $FFFFFFFF)<>$55667788 : rgaMismatch=rgaMismatch+1 : EndIf
  If (PeekL(rgaDst-4) & $FFFFFFFF)<>$AABBCCDD : rgaMismatch=rgaMismatch+1 : EndIf
  If (PeekL(rgaDst+9216) & $FFFFFFFF)<>$55667788 : rgaMismatch=rgaMismatch+1 : EndIf
  If GpuReachTx(82)=0 : ProcedureReturn $E550 : EndIf
  If GpuReachTx(49)=0 : ProcedureReturn $E551 : EndIf
  If GpuReachTx(32)=0 : ProcedureReturn $E552 : EndIf
  If GpuReachWord(rgaVersion)=0 : ProcedureReturn $E553 : EndIf
  If GpuReachWord(rgaInterrupt)=0 : ProcedureReturn $E554 : EndIf
  If GpuReachWord(rgaMismatch)=0 : ProcedureReturn $E555 : EndIf
  If GpuReachWord(rgaFirstBad)=0 : ProcedureReturn $E556 : EndIf
  If GpuReachWord(PeekL(rgaDst-4) & $FFFFFFFF)=0 : ProcedureReturn $E557 : EndIf
  If GpuReachHex32(PeekL(rgaDst+9216) & $FFFFFFFF)=0 : ProcedureReturn $E558 : EndIf
  If GpuReachNewline()=0 : ProcedureReturn $E559 : EndIf
  If (rgaInterrupt & 4)=0 Or (rgaInterrupt & 3)<>0 Or rgaMismatch<>0
    ProcedureReturn $47515025
  EndIf
  ProcedureReturn $47515000 & $FFFFFFFF
EndProcedure
