; Test-only reachability fixture for emitted sdmmc.pbi A64 tests. The runner
; calls individual compiled procedures with mocked MMIO and does not execute
; Main, so this keeps the production code path unchanged.
XIncludeFile "RockPi4C/Lib/soc.pbi"
XIncludeFile "RockPi4C/Lib/arch_timer.pbi"
XIncludeFile "RockPi4C/Lib/display_mode.pbi"
XIncludeFile "RockPi4C/Lib/uart2.pbi"
XIncludeFile "RockPi4C/Lib/cru.pbi"
XIncludeFile "RockPi4C/Lib/sdmmc.pbi"

Procedure Main()
  rock_sd_command(0, 0, 0)
  rock_sd_r1ok()
  rock_sd_cardData(17, 0, 1, @rock_sd_sector[0])
  RockSdReadBlocks(0, 1, @rock_sd_sector[0])
  RockSdWriteBlocks(0, 1, @rock_sd_sector[0])
  RockSdFlush()
EndProcedure
