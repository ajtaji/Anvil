; Bounded RK3399 RGA2 40x40 private-memory blit proof. No display address is
; touched. Run only through tools/rockpi4c_rga_blit_proof.py, which links to
; the live stage and enters behind Anvil's hardware deadman.
; pmf:target rockpi4c

#RGA_TEST_BASE = $FF680000
#RGA_TEST_PMU = $FF310000
#RGA_TEST_CRU = $FF760000
#RGA_TEST_WDT = $FF84800C
#RGA_TEST_UART_THR = $FF1A0000
#RGA_TEST_UART_LSR = $FF1A0014
#RGA_TEST_VERSION = $03218218
#RGA_TEST_WIDTH = 48
#RGA_TEST_HEIGHT = 40
#RGA_TEST_COPY_WIDTH = 40
#RGA_TEST_COPY_HEIGHT = 40
#RGA_TEST_UNTOUCHED = $11223344

Global Dim rga_test_src.l[#RGA_TEST_WIDTH * #RGA_TEST_HEIGHT]
Global Dim rga_test_dst.l[#RGA_TEST_WIDTH * #RGA_TEST_HEIGHT + 2]
Global Dim rga_test_src_pages.a[272]
Global Dim rga_test_dst_pages.a[272]
Global Dim rga_test_command.a[256]

Procedure.i RgaTestTx(value.i)
  Protected spin.i
  For spin=0 To 999999
    If (PeekL(#RGA_TEST_UART_LSR) & $20)<>0
      PokeL(#RGA_TEST_UART_THR,value & 255)
      ProcedureReturn 1
    EndIf
  Next
  ProcedureReturn 0
EndProcedure

Procedure RgaTestHex(value.i)
  Protected shift.i
  Protected digit.i
  For shift=28 To 0 Step -4
    digit=(value >> shift) & 15
    If digit<10
      RgaTestTx(48+digit)
    Else
      RgaTestTx(55+digit)
    EndIf
  Next
  RgaTestTx(32)
EndProcedure

Procedure.i RgaTestMap(table.i,buffer.i,bytes.i)
  Protected first.i
  Protected offset.i
  Protected count.i
  Protected index.i
  If table=0 Or buffer=0 Or bytes<1 : ProcedureReturn -1 : EndIf
  first=buffer & ~$FFF
  offset=buffer-first
  count=(offset+bytes+4095)/4096
  If count<1 Or count>64 : ProcedureReturn -1 : EndIf
  For index=0 To count-1
    PokeL(table+index*4,first+index*4096)
  Next
  ProcedureReturn offset
EndProcedure

Procedure.i Main()
  Protected blocked.i
  Protected version.i
  Protected source.i
  Protected destination.i
  Protected sourceTable.i
  Protected destinationTable.i
  Protected command.i
  Protected sourceOffset.i
  Protected destinationOffset.i
  Protected interrupt.i
  Protected poll.i
  Protected x.i
  Protected y.i
  Protected index.i
  Protected expected.i
  Protected observed.i
  Protected mismatch.i
  Protected firstIndex.i
  Protected firstExpected.i
  Protected firstObserved.i
  Protected previous.i

  blocked=0
  If ((PeekL(#RGA_TEST_PMU+$14) | PeekL(#RGA_TEST_PMU+$18)) & (1 << 18))<>0 : blocked=blocked | 1 : EndIf
  If ((PeekL(#RGA_TEST_PMU+$60) | PeekL(#RGA_TEST_PMU+$64) | PeekL(#RGA_TEST_PMU+$68)) & (1 << 5))<>0 : blocked=blocked | 2 : EndIf
  If (PeekL(#RGA_TEST_CRU+$310) & $700)<>0 : blocked=blocked | 4 : EndIf
  If (PeekL(#RGA_TEST_CRU+$340) & $F00)<>0 : blocked=blocked | 8 : EndIf
  If (PeekL(#RGA_TEST_CRU+$418) & $680)<>0 : blocked=blocked | 16 : EndIf
  If blocked<>0
    RgaTestTx(82) : RgaTestTx(71) : RgaTestTx(49) : RgaTestTx(32)
    RgaTestHex(blocked) : RgaTestTx(13) : RgaTestTx(10)
    ProcedureReturn $52474110 | blocked
  EndIf

  version=PeekL(#RGA_TEST_BASE+$28) & $FFFFFFFF
  If version<>#RGA_TEST_VERSION : ProcedureReturn $52474120 : EndIf
  source=@rga_test_src[0]
  destination=@rga_test_dst[1]
  sourceTable=(@rga_test_src_pages[0]+15) & ~$F
  destinationTable=(@rga_test_dst_pages[0]+15) & ~$F
  command=(@rga_test_command[0]+15) & ~$F
  If source<0 Or destination<0 Or sourceTable<0 Or destinationTable<0 Or command<0
    ProcedureReturn $52474121
  EndIf
  If source>$FFFFFFFF Or destination>$FFFFFFFF Or sourceTable>$FFFFFFFF Or destinationTable>$FFFFFFFF Or command>$FFFFFFFF
    ProcedureReturn $52474122
  EndIf

  For y=0 To #RGA_TEST_HEIGHT-1
    For x=0 To #RGA_TEST_WIDTH-1
      index=y*#RGA_TEST_WIDTH+x
      PokeL(source+index*4,$FF000000 | (index << 16) | ((x*13) << 8) | (y*29))
      PokeL(destination+index*4,#RGA_TEST_UNTOUCHED)
    Next
  Next
  PokeL(destination-4,$AABBCCDD)
  PokeL(destination+#RGA_TEST_WIDTH*#RGA_TEST_HEIGHT*4,$55667788)

  sourceOffset=RgaTestMap(sourceTable,source,#RGA_TEST_WIDTH*#RGA_TEST_HEIGHT*4)
  destinationOffset=RgaTestMap(destinationTable,destination,#RGA_TEST_WIDTH*#RGA_TEST_HEIGHT*4)
  If sourceOffset<0 Or destinationOffset<0 : ProcedureReturn $52474123 : EndIf

  previous=PeekL(#RGA_TEST_BASE+$10) & $FFFFFFFF
  If (previous & 15)<>0
    PokeL(#RGA_TEST_BASE+$10,(previous & 15) << 4)
    If (PeekL(#RGA_TEST_BASE+$10) & 15)<>0 : ProcedureReturn $52474124 : EndIf
  EndIf
  For index=0 To 31 : PokeL(command+index*4,0) : Next
  PokeL(command+$00,$40)
  PokeL(command+$04,$10)
  PokeL(command+$08,sourceOffset)
  PokeL(command+$18,(#RGA_TEST_WIDTH << 16) | #RGA_TEST_WIDTH)
  PokeL(command+$1C,((#RGA_TEST_COPY_HEIGHT-1) << 16) | (#RGA_TEST_COPY_WIDTH-1))
  PokeL(command+$38,$10)
  PokeL(command+$3C,destinationOffset)
  PokeL(command+$48,#RGA_TEST_WIDTH)
  PokeL(command+$4C,((#RGA_TEST_COPY_HEIGHT-1) << 16) | (#RGA_TEST_COPY_WIDTH-1))
  PokeL(command+$6C,$777)
  PokeL(command+$70,sourceTable >> 4)
  PokeL(command+$74,destinationTable >> 4)
  PokeL(command+$78,destinationTable >> 4)
  ASM
    dsb sy
  ENDASM
  PokeL(#RGA_TEST_BASE+$08,command)
  PokeL(#RGA_TEST_BASE+$00,0)
  PokeL(#RGA_TEST_BASE+$00,$22)
  PokeL(#RGA_TEST_BASE+$10,$600)
  ASM
    dsb sy
  ENDASM
  PokeL(#RGA_TEST_BASE+$04,1)
  interrupt=0
  For poll=0 To 99999
    interrupt=PeekL(#RGA_TEST_BASE+$10) & $FFFFFFFF
    If (interrupt & 15)<>0 : Break : EndIf
    If (poll & $FFF)=0 : PokeL(#RGA_TEST_WDT,$76) : EndIf
  Next
  If (interrupt & 15)<>0 : PokeL(#RGA_TEST_BASE+$10,(interrupt & 15) << 4) : EndIf
  If (interrupt & 4)=0 Or (interrupt & 3)<>0 : ProcedureReturn $52474125 : EndIf

  mismatch=0
  firstIndex=$FFFFFFFF
  For y=0 To #RGA_TEST_HEIGHT-1
    For x=0 To #RGA_TEST_WIDTH-1
      index=y*#RGA_TEST_WIDTH+x
      expected=$FF000000 | (index << 16) | ((x*13) << 8) | (y*29)
      If (PeekL(source+index*4) & $FFFFFFFF)<>expected
        If mismatch=0
          firstIndex=$80000000 | index
          firstExpected=expected
          firstObserved=PeekL(source+index*4) & $FFFFFFFF
        EndIf
        mismatch=mismatch+1
      EndIf
      If x>=#RGA_TEST_COPY_WIDTH : expected=#RGA_TEST_UNTOUCHED : EndIf
      observed=PeekL(destination+index*4) & $FFFFFFFF
      If observed<>expected
        If mismatch=0
          firstIndex=index
          firstExpected=expected
          firstObserved=observed
        EndIf
        mismatch=mismatch+1
      EndIf
    Next
  Next
  If (PeekL(destination-4) & $FFFFFFFF)<>$AABBCCDD
    If mismatch=0
      firstIndex=$FFFFFFFE
      firstExpected=$AABBCCDD
      firstObserved=PeekL(destination-4) & $FFFFFFFF
    EndIf
    mismatch=mismatch+1
  EndIf
  If (PeekL(destination+#RGA_TEST_WIDTH*#RGA_TEST_HEIGHT*4) & $FFFFFFFF)<>$55667788
    If mismatch=0
      firstIndex=$FFFFFFFD
      firstExpected=$55667788
      firstObserved=PeekL(destination+#RGA_TEST_WIDTH*#RGA_TEST_HEIGHT*4) & $FFFFFFFF
    EndIf
    mismatch=mismatch+1
  EndIf
  RgaTestTx(82) : RgaTestTx(71) : RgaTestTx(49) : RgaTestTx(32)
  RgaTestHex(version) : RgaTestHex(interrupt) : RgaTestHex(mismatch)
  RgaTestHex(firstIndex) : RgaTestHex(firstExpected) : RgaTestHex(firstObserved)
  RgaTestTx(13) : RgaTestTx(10)
  If mismatch<>0 : ProcedureReturn $52474126 : EndIf
  ProcedureReturn $52474100
EndProcedure
