; Original ROCK Pi 4C v1.2 / RK3399 foundation constants.
; These are RK3399 addresses, not BCM2711 aliases.
#ROCK_IMAGE_BASE = $02000000
#ROCK_CODE_BASE = $02000040
#ROCK_CODE_LIMIT = $02800000
#ROCK_BSS_BASE = $02800000
#ROCK_BSS_LIMIT = $04000000
#ROCK_STACK_BASE = $04F00000
#ROCK_STACK_BYTES = $00100000
#ROCK_STACK_LIMIT = $05000000
#ROCK_PRIMARY_STACK = $05000000
#ROCK_RESERVE_END = $05100000
#ROCK_DTB_EXPECTED = $12000000
#ROCK_DTB_MAX_BYTES = $00200000

#ROCK_UART2 = $FF1A0000
#ROCK_UART_THR = $00
#ROCK_UART_LSR = $14
#ROCK_UART_USR = $7C
#ROCK_UART_LSR_THRE = $20
#ROCK_UART_USR_BUSY = $01

#ROCK_GICD = $FEE00000
#ROCK_GICD_BYTES = $00010000
#ROCK_GICR = $FEF00000
#ROCK_GICR_BYTES = $000C0000
#ROCK_GICR_STRIDE = $00020000
#ROCK_GICR_FRAMES = 6
#ROCK_GICR_SGI = $00010000
#ROCK_GIC_TIMER_INTID = 26
