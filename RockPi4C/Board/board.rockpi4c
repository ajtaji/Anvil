; Original ROCK Pi 4C v1.2 / RK3399 foundation. Not for the 4C+.
; pmf:target rockpi4c
; pmf:load $00041000
; pmf:bss $02800000
; pmf:stack $05000000
#ANVIL_BUILD = 147 ; pmf:build
#ANVIL_BUILD_DATE = 20260923 ; pmf:builddate
#ANVIL_BUILD_TIME = 231343 ; pmf:buildtime
