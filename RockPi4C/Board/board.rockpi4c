Procedure RockPark()
  ASM
    msr daifset, #15
rock_cold_park:
    wfe
    b rock_cold_park
  ENDASM
EndProcedure

Procedure.i RockScreenWorkPending(now.i)
  If rock_display_ready = 0 Or rock_screen_fault <> 0
    ProcedureReturn 0
  EndIf
  If rock_screen_ready = 0 Or rock_screen_scroll_active <> 0 Or rock_screen_cpu_dirty <> 0 Or rock_screen_head <> rock_screen_tail
    ProcedureReturn 1
  EndIf
  If rock_screen_row_buffer_dirty <> 0
    If now < rock_screen_row_last_ticks Or now - rock_screen_row_last_ticks >= (rock_timer_frequency / 1000000) * #ROCK_SCREEN_ROW_IDLE_US
      ProcedureReturn 1
    EndIf
  EndIf
  ProcedureReturn 0
EndProcedure

Procedure RockRecoveryLoop()
  Protected windowStart.i
  Protected sampleEnd.i
  Protected loopNow.i
  Protected lastPet.i
  Protected windowIdle.i
  Protected idleTicks.i
  Protected consumed.i
  Protected windowTicks.i
  Protected usage.i
  Protected idleReady.i
  ; Only entered after the direct-SD EL3/timer/UART contract has passed.
  ; IRQ stays masked. The timer event stream sends a wake every 341.3 us;
  ; received UART bytes are drained before another idle wait.
  If RockRecoveryInit() = 0 : RockPark() : EndIf
  If rock_idle_skip_after_watchdog = 0 And rock_watchdog_armed = 0
    If RockWatchdogArm() = 0 And rock_uart_ready <> 0
      RockUartLine("IDLE TIMER SKIPPED: DEADMAN REFUSED; BUSY-POLL RECOVERY CONTINUES")
    EndIf
  EndIf
  idleReady = RockIdleTimerInit()
  windowStart = RockTimerTicks()
  lastPet = windowStart
  Repeat
    ; A watchdog armed by HDMI stays live for the rest of this healthy
    ; recovery session. Pet it only from the ordinary command loop; fatal
    ; exception recovery deliberately cannot hide a wedged subsystem.
    loopNow = RockTimerTicks()
    If loopNow < lastPet Or loopNow - lastPet >= rock_timer_frequency / 10
      RockWatchdogPet()
      lastPet = loopNow
    EndIf
    consumed = RockRecoveryPoll()
    If RockScreenWorkPending(RockTimerTicks()) <> 0
      RockScreenService()
    EndIf
    If idleReady <> 0 And consumed = 0
      idleTicks = RockIdleTimerWait()
      If idleTicks < 0 Or idleTicks > rock_timer_frequency
        ; An anomalous timer reading must never distort CPU usage or keep
        ; selecting WFE. The recovery loop remains live on its polling path.
        idleReady = 0
        windowIdle = 0
      Else
        windowIdle = windowIdle + idleTicks
      EndIf
    ElseIf idleReady = 0
      ; A missing deadman or a watchdog reset keeps the proven busy-poll
      ; recovery path available, with a truthful 100.00% reading.
      RockTimerWaitUs(1000)
    EndIf
    sampleEnd = RockTimerTicks()
    If sampleEnd < windowStart
      windowStart = sampleEnd
      windowIdle = 0
    ElseIf sampleEnd - windowStart >= rock_timer_frequency
      windowTicks = sampleEnd - windowStart
      usage = 10000
      If idleReady <> 0 And windowIdle <= windowTicks
        usage = ((windowTicks - windowIdle) * 10000 + windowTicks / 2) / windowTicks
      EndIf
      If usage < 0 : usage = 0 : EndIf
      If usage > 10000 : usage = 10000 : EndIf
      RockScreenCpuUsageUpdate(usage)
      windowStart = sampleEnd
      windowIdle = 0
    EndIf
  ForEver
EndProcedure

Procedure Main()
  Protected resetStatus.i
  ; The generic A64 startup preserves firmware x0 through BSS clear and sets
  ; SP to the explicit profile value before calling Main.
  ASM
    msr daifset, #15
    adrp x9, global_rock_dtb
    add x9, x9, #:lo12:global_rock_dtb
    str x0, [x9]
    adrp x9, global_rock_entry_sp
    add x9, x9, #:lo12:global_rock_entry_sp
    mov x10, sp
    str x10, [x9]
  ENDASM
  ; Establish and reject the actual execution level before timer, UART or any
  ; board service executes. A lower-level Image handoff is never promoted.
  RockCaptureEnvironment()
  If rock_current_el <> 12 : RockPark() : EndIf
  If (rock_entry_sp & 15) <> 0 : RockPark() : EndIf
  RockCaptureSctlrEl3()
  ; Direct SD entry contract: stage the linked physical image with EL3 MMU,
  ; data cache and instruction cache disabled. Do not guess at translation
  ; tables or silently change firmware cache ownership here.
  If (rock_sctlr_el3 & $1005) <> 0 : RockPark() : EndIf
  If RockExceptionInstall() = 0 : RockPark() : EndIf
  If RockTimerInit() = 0 : RockPark() : EndIf
  ; A watchdog armed by a previous warm session can survive CPU reset. Adopt
  ; and feed it before any boot diagnostics; a cold disabled watchdog is left
  ; untouched until a deadman-protected operation explicitly arms it.
  If (PeekL(#ROCK_WATCHDOG_BASE+#ROCK_WATCHDOG_CR) & 1) <> 0
    rock_watchdog_active=1
    RockWatchdogPet()
  EndIf
  ; UART is adopted before DT parsing so malformed handoffs remain visible.
  If RockUartAdopt() <> 0
    RockUartLine("ANVIL ROCK PI 4C V1.2 RK3399 EL3 EARLY UART2 1500000")
  EndIf
  If RockValidateEntry() = 0
    If rock_uart_ready <> 0 : RockUartLine("STOP: RK3399 DIRECT SD HANDOFF REFUSED") : EndIf
    RockPark()
  EndIf
  ; The RK3399 BootROM protects DDR/SRAM regions during its first stage.
  ; Release and verify those EL3-owned regions before SDMMC or display DMA.
  If RockSecurityReleaseDma()=0
    If rock_uart_ready<>0
      RockUartLine("STOP: RK3399 DMA SECURITY RELEASE REFUSED")
      RockSecurityTelemetry()
    EndIf
    RockPark()
  EndIf
  RockSecurityTelemetry()
  ; If a previous WFE ever failed to wake, the resident deadman resets the
  ; board. Preserve the busy-poll fallback on that boot instead of retrying.
  If (PeekL(#ROCK_CRU+$514) & $30) <> 0
    rock_idle_skip_after_watchdog = 1
  EndIf
  ; EL3 GIC/timer and display ownership are explicit opt-in capabilities.
  ; Keep IRQ masked. HDMI VOPB has an explicit serial command for the initial
  ; direct-loader proof; automatic initialization remains a build-time opt-in.
  If #ROCK_DIRECTSD_GIC_ENABLED <> 0
    If RockGicInitTimerFoundation() = 0
      If rock_uart_ready <> 0 : RockUartLine("STOP: RK3399 GICV3 FOUNDATION REFUSED") : EndIf
      RockPark()
    EndIf
  EndIf
  If #ROCK_DIRECTSD_DISPLAY_ENABLED <> 0
    If RockDisplayUp() = 0
      If rock_uart_ready <> 0 : RockUartLine("STOP: RK3399 MINIDP BRING-UP REFUSED") : EndIf
      RockRecoveryLoop()
    EndIf
  EndIf
  If #ROCK_DIRECTSD_HDMI_ENABLED <> 0 And #ROCK_DIRECTSD_HDMI_AUTO <> 0
    ; Boot-time HDMI runs the same one-shot RockHdmiDisplayUp as the serial
    ; `hdmi` command, behind the same deadman. Every wait inside it is bounded
    ; (HPD 300 ms, DDC 10 ms per byte, PHY lock 10 ms, first frame 50 ms), and
    ; any refusal prints its reason and falls through to serial recovery, so a
    ; missing monitor never costs the COM7 console.
    ; CRU_GLB_RST_ST[5:4] (W1C) records a watchdog-triggered hot reset. That
    ; may have been a wedged display bring-up, so never retry it automatically:
    ; skip to recovery, where `hdmi` remains available for one attempt.
    resetStatus=PeekL(#ROCK_CRU+$514) & $3F
    PokeL(#ROCK_CRU+$514,resetStatus)
    If (resetStatus & $30)<>0
      If rock_uart_ready<>0 : RockUartLine("HDMI AUTO SKIPPED: LAST RESET WAS WATCHDOG; TYPE hdmi TO RETRY") : EndIf
    ElseIf RockWatchdogArm()=0
      If rock_uart_ready<>0
        RockUartLine("HDMI AUTO SKIPPED: DEADMAN REFUSED; RECOVERY CONTINUES")
        RockWatchdogTelemetry()
      EndIf
    Else
      RockWatchdogPet()
      ; Latch before touching shared display hardware. Recovery cannot issue a
      ; second attempt if initialization partially transitions before failing.
      rock_recovery_hdmi_attempted=1
      If rock_uart_ready<>0 : RockUartLine("HDMI AUTO INIT BEGIN; DEADMAN ARMED") : EndIf
      If RockHdmiDisplayUp()=0
        If rock_uart_ready<>0 : RockUartLine("HDMI AUTO INIT FAILED; RECOVERY CONTINUES") : EndIf
      ElseIf rock_uart_ready<>0
        RockUartLine("HDMI INIT READY")
      EndIf
    EndIf
  EndIf
  If rock_uart_ready <> 0
    If #ROCK_DIRECTSD_DISPLAY_ENABLED <> 0
      RockUartLine("ANVIL ROCK PI 4C EL3 FOUNDATION READY; IRQ STILL MASKED")
    ElseIf #ROCK_DIRECTSD_HDMI_ENABLED <> 0 And #ROCK_DIRECTSD_HDMI_AUTO <> 0
      RockUartLine("ANVIL ROCK PI 4C EL3 READY; HDMI VOPB; AUTO ON")
    ElseIf #ROCK_DIRECTSD_HDMI_ENABLED <> 0
      RockUartLine("ANVIL ROCK PI 4C EL3 READY; TYPE HDMI; VOPB; AUTO OFF")
    Else
      RockUartLine("ANVIL ROCK PI 4C EL3 ENTRY READY; GIC/DISPLAY DEFERRED")
    EndIf
  EndIf
  RockRecoveryLoop()
EndProcedure
