XIncludeFile "RaspberryPi3/Lib/timer.pbi"
; Clock service dependency is supplied deterministically; controller/timer
; operations remain real emitted MMIO and are modeled by the host gate.
Global sd_gate_clock_queries.i
Procedure.i Pi3ClockRate(id.i)
  sd_gate_clock_queries + 1
  ProcedureReturn 250000000
EndProcedure
XIncludeFile "RaspberryPi3/Lib/sdhost.pbi"
; Three blocks' worth, so a ranged transfer has somewhere to land.
Global Dim sd_gate_buffer.l[384]
Procedure.i Main()
  If Pi3SdError() = 99
    Pi3SdSetBootClock(250000000)
    Pi3SdInit(400000000, 0, $8000000)
    Pi3SdReadBlock(42, @sd_gate_buffer[0])
    Pi3SdSetWriteWindow(40, 10)
    Pi3SdWriteBlock(42, @sd_gate_buffer[0])
    Pi3SdReadBlocks(42, 1, @sd_gate_buffer[0])
    Pi3SdWriteBlocks(42, 1, @sd_gate_buffer[0])
    Pi3SdBlockCount()
  EndIf
  ProcedureReturn 0
EndProcedure
