; Generated by tools/pi3_wifi_bringup_check.py with compact synthetic DTBs
; and the exact packaged 43430 NVRAM. Calls exact production helpers.
#CYW43_EVMASK_JOIN = 1
#CYW43_IO_OK = 0
XIncludeFile "RaspberryPi3/Lib/wifi_profile.pi3"
XIncludeFile "RaspberryPi3/Lib/wifi_bringup.pi3"

Global gate_fs_kind.i
Global gate_fs_offset.i
Global gate_fs_max_chunk.i
Global gate_fs_opens.i
Global gate_fs_closes.i
Global gate_wifi_sequence.i
Global gate_wifi_calls.i
Global gate_wifi_reset_calls.i
Global gate_mac_gets.i
Global gate_mac_sets.i
Global gate_mac_fail_get.i
Global gate_mac_fail_set.i
Global gate_mac_fail_second_get.i
Global gate_mac_bad_readback.i
Global gate_rng_fail.i
Global Dim gate_radio_mac.a[6]

Procedure.i HwStorageUp() : ProcedureReturn 1 : EndProcedure
Procedure.i Pi3FirmwareGpioConfigureOutput(id.i,state.i) : ProcedureReturn 1 : EndProcedure
Procedure.i Pi3FirmwareGpioSetState(id.i,state.i) : ProcedureReturn 1 : EndProcedure
Procedure.i HwFileOpen(path.i)
  gate_fs_kind = 0 : gate_fs_offset = 0 : gate_fs_opens = gate_fs_opens + 1
  If p3wfEqual(path, path + 64, "2:/wifi/brcmfmac43430-sdio.bin") : gate_fs_kind = 1 : ProcedureReturn 1 : EndIf
  If p3wfEqual(path, path + 64, "2:/wifi/brcmfmac43430-sdio.clm_blob") : gate_fs_kind = 2 : ProcedureReturn 1 : EndIf
  If p3wfEqual(path, path + 64, "2:/wifi/brcmfmac43430-sdio.raspberrypi,3-model-b.txt") : gate_fs_kind = 3 : ProcedureReturn 1 : EndIf
  ProcedureReturn 0
EndProcedure
Procedure.i HwFileSize()
  Select gate_fs_kind
    Case 1 : ProcedureReturn #PI3_WIFI_FW_BYTES
    Case 2 : ProcedureReturn #PI3_WIFI_CLM_BYTES
    Case 3 : ProcedureReturn #GATE_NVRAM_BYTES
  EndSelect
  ProcedureReturn 0
EndProcedure
Procedure.i HwFileReadAt(offset.i,dst.i,n.i)
  Protected i.i
  If offset <> gate_fs_offset Or n < 1 Or n > 4096 : ProcedureReturn -1 : EndIf
  If n > gate_fs_max_chunk : gate_fs_max_chunk = n : EndIf
  If gate_fs_kind = 3
    For i = 0 To n - 1 : PokeA(dst + i, PeekA(?nvram + offset + i)) : Next
  EndIf
  gate_fs_offset = gate_fs_offset + n
  ProcedureReturn n
EndProcedure
Procedure HwFileClose()
  gate_fs_closes = gate_fs_closes + 1
  gate_fs_kind = 0 : gate_fs_offset = 0
EndProcedure

Procedure.i Cyw43Attached() : ProcedureReturn 1 : EndProcedure
Procedure.i Cyw43ChipId() : ProcedureReturn #PI3_WIFI_CHIP_43430 : EndProcedure
Procedure.i Cyw43ChipRev() : ProcedureReturn 1 : EndProcedure
Procedure Cyw43SetVerify(mode.i) : If mode <> 2 : gate_wifi_sequence = 99 : EndIf : EndProcedure
Procedure.i Cyw43PrepareDownload()
  If gate_wifi_sequence <> 0 : ProcedureReturn 0 : EndIf
  gate_wifi_sequence = 1 : gate_wifi_calls = gate_wifi_calls + 1 : ProcedureReturn 1
EndProcedure
Procedure.i Cyw43UploadFirmware(image.i,length.i,scratch.i,scratchLen.i)
  If gate_wifi_sequence <> 1 Or length <> #PI3_WIFI_FW_BYTES Or scratchLen < 4 : ProcedureReturn 0 : EndIf
  gate_wifi_sequence = 2 : gate_wifi_calls = gate_wifi_calls + 1 : ProcedureReturn 1
EndProcedure
Procedure.i Cyw43UploadNvram(text.i,length.i,work.i,workMax.i,scratch.i,scratchLen.i)
  If gate_wifi_sequence <> 2 Or length <= 0 Or workMax < length + 8 : ProcedureReturn 0 : EndIf
  gate_wifi_sequence = 3 : gate_wifi_calls = gate_wifi_calls + 1 : ProcedureReturn 1
EndProcedure
Procedure.i Cyw43Start()
  If gate_wifi_sequence <> 3 : ProcedureReturn 0 : EndIf
  gate_wifi_sequence = 4 : gate_wifi_calls = gate_wifi_calls + 1 : ProcedureReturn 1
EndProcedure
Procedure.i Cyw43HtClock()
  If gate_wifi_sequence <> 4 : ProcedureReturn 0 : EndIf
  gate_wifi_sequence = 5 : gate_wifi_calls = gate_wifi_calls + 1 : ProcedureReturn 1
EndProcedure
Procedure.i Cyw43AnnounceHost()
  If gate_wifi_sequence <> 5 : ProcedureReturn 0 : EndIf
  gate_wifi_sequence = 6 : gate_wifi_calls = gate_wifi_calls + 1 : ProcedureReturn 1
EndProcedure
Procedure.i Pi3SdioEnableFunction(fn.i)
  If gate_wifi_sequence <> 6 Or fn <> 2 : ProcedureReturn 0 : EndIf
  gate_wifi_sequence = 7 : gate_wifi_calls = gate_wifi_calls + 1 : ProcedureReturn 1
EndProcedure
Procedure.i Cyw43WifiUpBegin()
  If gate_wifi_sequence <> 7 : ProcedureReturn -1 : EndIf
  gate_wifi_reset_calls = gate_wifi_reset_calls + 1
  gate_wifi_sequence = 8 : gate_wifi_calls = gate_wifi_calls + 1 : ProcedureReturn 0
EndProcedure
Procedure.i Cyw43WifiUpAfterTransportReset(clm.i,length.i,eventMask.i,timeout.i)
  If gate_wifi_sequence <> 8 Or length <> #PI3_WIFI_CLM_BYTES Or eventMask <> #CYW43_EVMASK_JOIN Or timeout <> 2000 : ProcedureReturn -1 : EndIf
  gate_wifi_sequence = 9 : gate_wifi_calls = gate_wifi_calls + 1 : ProcedureReturn 0
EndProcedure
Procedure.i Cyw43MacAddress(*out,timeout.i)
  Protected i.i
  gate_mac_gets = gate_mac_gets + 1
  If gate_wifi_sequence <> 8 Or timeout <> 2000 Or gate_mac_fail_get <> 0 Or (gate_mac_fail_second_get <> 0 And gate_mac_gets >= 1) : ProcedureReturn -1 : EndIf
  For i = 0 To 5 : PokeA(*out + i, gate_radio_mac[i]) : Next
  ProcedureReturn 0
EndProcedure
Procedure.i Cyw43SetIovarData(*name,nameLen.i,*data,bytes.i,timeout.i)
  Protected i.i
  gate_mac_sets = gate_mac_sets + 1
  If gate_wifi_sequence <> 8 Or nameLen <> 13 Or bytes <> 6 Or timeout <> 2000 Or gate_mac_fail_set <> 0 : ProcedureReturn -1 : EndIf
  For i = 0 To 5 : gate_radio_mac[i] = PeekA(*data + i) : Next
  If gate_mac_bad_readback <> 0 : gate_radio_mac[5] = (gate_radio_mac[5] + 1) & $FF : EndIf
  ProcedureReturn 0
EndProcedure
Procedure.i Pi3WifiRngBytes(*out,bytes.i,timeout.i)
  Protected i.i
  If bytes <> 8 Or timeout <> #PI3_WIFI_MAC_RNG_TIMEOUT_US : ProcedureReturn -1 : EndIf
  If gate_rng_fail <> 0 : ProcedureReturn 0 : EndIf
  For i = 0 To 7 : PokeA(*out + i, $80 + i) : Next
  ProcedureReturn 8
EndProcedure

Global Dim gate_mac.a[6]
Global Dim gate_output.a[2048]
Global Dim gate_output2.a[2048]
Global Dim gate_badmac.a[6]
Global Dim gate_firmware.a[399344]
Global Dim gate_clm.a[4733]
Global Dim gate_nvram_text.a[16384]
Global Dim gate_nvram_runtime.a[16384]
Global Dim gate_nvram_work.a[16384]
Global Dim gate_scratch.a[2048]
Global gate_n.i
Global gate_n2.i
Global gate_firmware_bytes.i
Global gate_clm_bytes.i
Global gate_runtime_bytes.i

Procedure.i gateMacIs(p.i,a.i,b.i,c.i,d.i,e.i,f.i)
  ProcedureReturn (PeekA(p) & $FF) = a And (PeekA(p + 1) & $FF) = b And (PeekA(p + 2) & $FF) = c And (PeekA(p + 3) & $FF) = d And (PeekA(p + 4) & $FF) = e And (PeekA(p + 5) & $FF) = f
EndProcedure

Procedure.i Main()
  Protected n.i
  If p3wfBe32(?dtb_good) <> #PI3_WIFI_FDT_MAGIC : ProcedureReturn 90 : EndIf
  If Pi3WifiReadLocalMacFromDtb(?dtb_good, ?dtb_good + #GATE_DTB_GOOD_BYTES, @gate_mac[0]) <> 1 : ProcedureReturn 1 : EndIf
  If gateMacIs(@gate_mac[0],$02,$11,$22,$33,$44,$55) = 0 : ProcedureReturn 2 : EndIf
  ; Linux property precedence: invalid mac-address falls through to a valid
  ; local-mac-address; short properties are never read beyond their span.
  If Pi3WifiReadLocalMacFromDtb(?dtb_fallback, ?dtb_fallback + #GATE_DTB_FALLBACK_BYTES, @gate_mac[0]) <> 1 : ProcedureReturn 3 : EndIf
  If gateMacIs(@gate_mac[0],$02,$66,$77,$88,$99,$AA) = 0 : ProcedureReturn 4 : EndIf
  If Pi3WifiReadLocalMacFromDtb(?dtb_parent_mismatch, ?dtb_parent_mismatch + #GATE_DTB_PARENT_MISMATCH_BYTES, @gate_mac[0]) <> 0 : ProcedureReturn 5 : EndIf
  If Pi3WifiReadLocalMacFromDtb(?dtb_child_mismatch, ?dtb_child_mismatch + #GATE_DTB_CHILD_MISMATCH_BYTES, @gate_mac[0]) <> 0 : ProcedureReturn 6 : EndIf
  If Pi3WifiReadLocalMacFromDtb(?dtb_invalid, ?dtb_invalid + #GATE_DTB_INVALID_BYTES, @gate_mac[0]) <> 0 : ProcedureReturn 7 : EndIf
  ; The staged Model B DTB's exact relevant structure uses
  ; mmcnr@7e300000 + bcm2835-sdhci/reg + wifi@1, but has no static MAC.
  ; Refuse it without modifying the caller's output; a firmware-injected
  ; local-mac-address on the same structure is accepted below.
  For n = 0 To 5 : PokeA(@gate_mac[0] + n, $A5) : Next
  If Pi3WifiReadLocalMacFromDtb(?dtb_staged_shape_no_mac, ?dtb_staged_shape_no_mac + #GATE_DTB_STAGED_SHAPE_NO_MAC_BYTES, @gate_mac[0]) <> 0 : ProcedureReturn 33 : EndIf
  If gateMacIs(@gate_mac[0],$A5,$A5,$A5,$A5,$A5,$A5) = 0 : ProcedureReturn 34 : EndIf
  If Pi3WifiReadLocalMacFromDtb(?dtb_firmware_mac, ?dtb_firmware_mac + #GATE_DTB_FIRMWARE_MAC_BYTES, @gate_mac[0]) <> 1 : ProcedureReturn 35 : EndIf
  If gateMacIs(@gate_mac[0],$02,$11,$22,$33,$44,$55) = 0 : ProcedureReturn 36 : EndIf
  If #GATE_HAS_STAGED_MODEL_B_DTB <> 0
    For n = 0 To 5 : PokeA(@gate_mac[0] + n, $A5) : Next
    If Pi3WifiReadLocalMacFromDtb(?dtb_staged_model_b, ?dtb_staged_model_b + #GATE_DTB_STAGED_MODEL_B_BYTES, @gate_mac[0]) <> 0 : ProcedureReturn 37 : EndIf
    If gateMacIs(@gate_mac[0],$A5,$A5,$A5,$A5,$A5,$A5) = 0 : ProcedureReturn 38 : EndIf
  EndIf
  If Pi3WifiReadLocalMacFromDtb(?dtb_good, ?dtb_good + 39, @gate_mac[0]) <> 0 : ProcedureReturn 8 : EndIf
  If Pi3WifiMacValid(@gate_badmac[0]) <> 0 : ProcedureReturn 9 : EndIf

  n = Pi3WifiNvramWithMac(?nvram, #GATE_NVRAM_BYTES, ?expected_mac, @gate_output[0], 2048)
  If n <> #GATE_NVRAM_EXPECTED_BYTES : ProcedureReturn 10 : EndIf
  gate_n = n
  ; Existing text without one key receives both a consistent runtime pair.
  n = Pi3WifiNvramWithMac(?nvram_minimal, #GATE_NVRAM_MINIMAL_BYTES, ?expected_mac, @gate_output2[0], 2048)
  gate_n2 = n
  If n <> #GATE_NVRAM_MINIMAL_EXPECTED_BYTES : ProcedureReturn 12 : EndIf
  If Pi3WifiNvramWithMac(?nvram, #GATE_NVRAM_BYTES, @gate_badmac[0], @gate_output[0], 2048) <> 0 : ProcedureReturn 14 : EndIf
  If Pi3WifiNvramWithMac(?nvram, #GATE_NVRAM_BYTES, ?expected_mac, @gate_output[0], 16) <> 0 : ProcedureReturn 15 : EndIf
  If Pi3WifiNvramWithMac(?nvram, #GATE_NVRAM_BYTES, ?expected_mac, ?nvram, 2048) <> 0 : ProcedureReturn 16 : EndIf

  ; Only an exact supported board/radio/profile receives candidate paths.
  If Pi3WifiBoardProfile($00A22082) <> #PI3_WIFI_BOARD_B : ProcedureReturn 20 : EndIf
  If Pi3WifiResolveProfile($00A22082, #PI3_WIFI_CHIP_43430, 1) <> #PI3_WIFI_RADIO_43430_A1 : ProcedureReturn 21 : EndIf
  If p3wfEqual(Pi3WifiFirmwarePath(), Pi3WifiFirmwarePath() + 40, "2:/wifi/brcmfmac43430-sdio.bin") = 0 : ProcedureReturn 22 : EndIf
  If p3wfEqual(Pi3WifiNvramPath(), Pi3WifiNvramPath() + 64, "2:/wifi/brcmfmac43430-sdio.raspberrypi,3-model-b.txt") = 0 : ProcedureReturn 23 : EndIf
  If p3wfEqual(Pi3WifiClmPath(), Pi3WifiClmPath() + 40, "2:/wifi/brcmfmac43430-sdio.clm_blob") = 0 : ProcedureReturn 24 : EndIf
  If Pi3WifiPrepareSelectedAssets($00A22082, ?dtb_good, ?dtb_good + #GATE_DTB_GOOD_BYTES, @gate_firmware[0], 399344, @gate_firmware_bytes, @gate_clm[0], 4733, @gate_clm_bytes, @gate_nvram_text[0], 16384, @gate_nvram_runtime[0], 16384, @gate_runtime_bytes) <> #PI3_WIFI_RADIO_43430_A1
    ProcedureReturn 25
  EndIf
  If gate_firmware_bytes <> 399344 Or gate_clm_bytes <> 4733 Or gate_fs_opens <> 3 Or gate_fs_closes <> 3 Or gate_fs_max_chunk > 4096 : ProcedureReturn 26 : EndIf
  If gate_runtime_bytes <> #GATE_NVRAM_EXPECTED_BYTES : ProcedureReturn 27 : EndIf
  If Pi3WifiResolveProfile($00A22082, #PI3_WIFI_CHIP_4345, 0) <> 0 Or Pi3WifiFirmwarePath() <> 0 : ProcedureReturn 28 : EndIf
  gate_wifi_sequence = 0 : gate_wifi_calls = 0 : gate_wifi_reset_calls = 0
  gate_mac_gets = 0 : gate_mac_sets = 0 : gate_mac_fail_get = 0 : gate_mac_fail_set = 0
  gate_radio_mac[0]=$02 : gate_radio_mac[1]=$90 : gate_radio_mac[2]=$4C : gate_radio_mac[3]=$C5 : gate_radio_mac[4]=$12 : gate_radio_mac[5]=$38
  If Pi3WifiStartSelectedRadio(#PI3_WIFI_RADIO_43430_A1, @gate_firmware[0], 399344, @gate_nvram_runtime[0], gate_runtime_bytes, @gate_nvram_work[0], 16384, @gate_clm[0], 4733, @gate_scratch[0], 2048) <> 1 : ProcedureReturn 29 : EndIf
  If gate_wifi_sequence <> 9 Or gate_wifi_calls <> 9 Or gate_wifi_reset_calls <> 1 Or pi3_wifi_bringup_stage <> 15 : ProcedureReturn 30 : EndIf
  ; A platform/DTB address takes precedence: no initial firmware-address GET
  ; may block SET, and the transport-generation reset occurs only once.
  If gate_mac_gets <> 1 Or gate_mac_sets <> 1 Or pi3_wifi_mac_result <> 2 Or gateMacIs(@gate_radio_mac[0],$02,$11,$22,$33,$44,$55) = 0 : ProcedureReturn 39 : EndIf

  ; With no optional DTB MAC, preserve the packaged NVRAM bytes and follow
  ; brcmfmac's firmware-address/placeholder path after transport begin.
  If Pi3WifiPrepareSelectedAssets($00A22082, ?dtb_staged_shape_no_mac, ?dtb_staged_shape_no_mac + #GATE_DTB_STAGED_SHAPE_NO_MAC_BYTES, @gate_firmware[0], 399344, @gate_firmware_bytes, @gate_clm[0], 4733, @gate_clm_bytes, @gate_nvram_text[0], 16384, @gate_nvram_runtime[0], 16384, @gate_runtime_bytes) <> #PI3_WIFI_RADIO_43430_A1 : ProcedureReturn 40 : EndIf
  gate_wifi_sequence = 0 : gate_wifi_calls = 0 : gate_wifi_reset_calls = 0
  gate_mac_gets = 0 : gate_mac_sets = 0 : gate_mac_fail_get = 0 : gate_mac_fail_set = 0
  gate_radio_mac[0]=$00 : gate_radio_mac[1]=$90 : gate_radio_mac[2]=$4C : gate_radio_mac[3]=$C5 : gate_radio_mac[4]=$12 : gate_radio_mac[5]=$38
  If Pi3WifiStartSelectedRadio(#PI3_WIFI_RADIO_43430_A1, @gate_firmware[0], 399344, @gate_nvram_runtime[0], gate_runtime_bytes, @gate_nvram_work[0], 16384, @gate_clm[0], 4733, @gate_scratch[0], 2048) <> 1 : ProcedureReturn 41 : EndIf
  If gate_wifi_sequence <> 9 Or gate_wifi_reset_calls <> 1 Or gate_mac_gets <> 2 Or gate_mac_sets <> 1 Or pi3_wifi_mac_result <> 3 : ProcedureReturn 42 : EndIf
  If gateMacIs(@gate_radio_mac[0],$82,$81,$82,$83,$84,$85) = 0 : ProcedureReturn 43 : EndIf

  ; A valid firmware-provided address is retained without RNG or SET_VAR.
  If Pi3WifiPrepareSelectedAssets($00A22082, ?dtb_staged_shape_no_mac, ?dtb_staged_shape_no_mac + #GATE_DTB_STAGED_SHAPE_NO_MAC_BYTES, @gate_firmware[0], 399344, @gate_firmware_bytes, @gate_clm[0], 4733, @gate_clm_bytes, @gate_nvram_text[0], 16384, @gate_nvram_runtime[0], 16384, @gate_runtime_bytes) <> #PI3_WIFI_RADIO_43430_A1 : ProcedureReturn 44 : EndIf
  gate_wifi_sequence = 0 : gate_wifi_calls = 0 : gate_wifi_reset_calls = 0
  gate_mac_gets = 0 : gate_mac_sets = 0
  gate_radio_mac[0]=$02 : gate_radio_mac[1]=$AA : gate_radio_mac[2]=$BB : gate_radio_mac[3]=$CC : gate_radio_mac[4]=$DD : gate_radio_mac[5]=$EE
  If Pi3WifiStartSelectedRadio(#PI3_WIFI_RADIO_43430_A1, @gate_firmware[0], 399344, @gate_nvram_runtime[0], gate_runtime_bytes, @gate_nvram_work[0], 16384, @gate_clm[0], 4733, @gate_scratch[0], 2048) <> 1 : ProcedureReturn 45 : EndIf
  If gate_mac_gets <> 1 Or gate_mac_sets <> 0 Or pi3_wifi_mac_result <> 1 Or gateMacIs(@gate_radio_mac[0],$02,$AA,$BB,$CC,$DD,$EE) = 0 : ProcedureReturn 46 : EndIf

  ; Fail-closed MAC cases: invalid firmware address, GET failure, RNG failure,
  ; SET failure, missing readback, and mismatched readback.
  gate_wifi_sequence = 8 : gate_mac_gets = 0 : gate_mac_sets = 0
  gate_mac_fail_get = 0 : gate_mac_fail_second_get = 0 : gate_mac_fail_set = 0 : gate_mac_bad_readback = 0 : gate_rng_fail = 0
  pi3_wifi_mac_override = 0
  gate_radio_mac[0]=$01 : gate_radio_mac[1]=$AA : gate_radio_mac[2]=$BB : gate_radio_mac[3]=$CC : gate_radio_mac[4]=$DD : gate_radio_mac[5]=$EE
  If Pi3WifiFinalizeMac() <> 0 Or pi3_wifi_mac_result <> 11 Or gate_mac_sets <> 0 : ProcedureReturn 47 : EndIf
  gate_mac_gets = 0 : gate_mac_fail_get = 1
  If Pi3WifiFinalizeMac() <> 0 Or pi3_wifi_mac_result <> 10 Or gate_mac_sets <> 0 : ProcedureReturn 48 : EndIf
  gate_mac_gets = 0 : gate_mac_fail_get = 0 : gate_rng_fail = 1
  gate_radio_mac[0]=$00 : gate_radio_mac[1]=$90 : gate_radio_mac[2]=$4C : gate_radio_mac[3]=$C5 : gate_radio_mac[4]=$12 : gate_radio_mac[5]=$38
  If Pi3WifiFinalizeMac() <> 0 Or pi3_wifi_mac_result <> 12 Or gate_mac_sets <> 0 : ProcedureReturn 49 : EndIf
  pi3_wifi_mac_override = 1
  For n = 0 To 5 : pi3_wifi_selected_mac[n] = gate_mac[0+n] : Next
  gate_mac_sets = 0 : gate_mac_gets = 0 : gate_rng_fail = 0 : gate_mac_fail_set = 1
  If Pi3WifiFinalizeMac() <> 0 Or pi3_wifi_mac_result <> 14 Or gate_mac_gets <> 0 Or gate_mac_sets <> 1 : ProcedureReturn 50 : EndIf
  gate_mac_fail_set = 0 : gate_mac_fail_second_get = 1 : gate_mac_sets = 0 : gate_mac_gets = 0
  If Pi3WifiFinalizeMac() <> 0 Or pi3_wifi_mac_result <> 15 Or gate_mac_gets <> 1 Or gate_mac_sets <> 1 : ProcedureReturn 51 : EndIf
  gate_mac_fail_second_get = 0 : gate_mac_bad_readback = 1 : gate_mac_sets = 0 : gate_mac_gets = 0
  If Pi3WifiFinalizeMac() <> 0 Or pi3_wifi_mac_result <> 16 Or gate_mac_gets <> 1 Or gate_mac_sets <> 1 : ProcedureReturn 52 : EndIf

  gate_wifi_sequence = 0 : gate_wifi_calls = 0
  If Pi3WifiStartSelectedRadio(#PI3_WIFI_RADIO_43430_B0, @gate_firmware[0], 399344, @gate_nvram_runtime[0], gate_runtime_bytes, @gate_nvram_work[0], 16384, @gate_clm[0], 4733, @gate_scratch[0], 2048) <> 0 : ProcedureReturn 31 : EndIf
  If gate_wifi_calls <> 0 : ProcedureReturn 32 : EndIf
  ProcedureReturn 0
EndProcedure

DataSection
; @@GENERATED_BLOBS@@
EndDataSection
