; BCM2837 Cortex-A53 architectural operations; no Pi4 peripheral aliases.
@TARGET BCM2837
@INTRINSIC a64_wait_for_event
@ARGS 0
@DOC Wait for an architectural event.
@SIG a64_wait_for_event()
@ASM
  wfe
@END
@INTRINSIC a64_send_event
@ARGS 0
@DOC Send an architectural event.
@SIG a64_send_event()
@ASM
  sev
@END
@INTRINSIC a64_barrier
@ARGS 0
@DOC Complete accesses and synchronize instructions.
@SIG a64_barrier()
@ASM
  dsb sy
  isb
@END

@INTRINSIC a64_fsqrt_d
@ARGS 1
@RETURNS_VALUE
@DOC The IEEE-754 binary64 square root of a 64-bit bit pattern, as a 64-bit bit pattern: one fsqrt, correctly rounded. Takes and returns the PATTERN, not a number - RaspberryPi4/Lib/mathd.pi4's SqrD(x.d) wraps it for a .d. sqrt(-0) is -0; a negative or NaN argument gives a NaN.
@SIG a64_fsqrt_d(bits)
@EXAMPLE PokeI(@r, a64_fsqrt_d(PeekI(@x)))      ; r.d = sqrt(x.d)
@ASM
  fmov d0, %2
  fsqrt d0, d0
  fmov %1, d0
@END
