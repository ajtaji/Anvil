EndProcedure
Procedure.i HwMmcErrorText()
  ProcedureReturn "this board has no raw block family: its card is reached through the filesystem seam, not through mmc"
EndProcedure
Procedure.i HwMmcInfo()
  ProcedureReturn 0
EndProcedure
