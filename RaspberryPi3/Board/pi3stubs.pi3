; The general TCP service remains unavailable on this Pi 3 composition.
; The shared UDP console/DHCP path is linked separately; unknown TCP frames
; reach this explicit drop seam until a TCP backend is composed and proven.
Procedure.i TcpInput()
  ProcedureReturn 0
EndProcedure

Procedure TcpTick()
EndProcedure

Procedure WifiLinkTick()
  ; Automatic bring-up/join runs only in the idle prompt. A command may call
  ; ReadLine recursively, but its foreground owner suppresses Wi-Fi mutation.
  If pi3_wifi_foreground_active = 0
    Pi3WifiAutoLinkTick()
  EndIf
  ; In the idle/no-address interval NetConsole has no receive ownership yet.
  ; The Wi-Fi adapter advances one bounded RX/protocol turn; after the shared
  ; console claims that interface its pump consumes the queue instead.
  If pi3_wifi_link_active <> 0
    Pi3WifiNetworkRxTick()
  EndIf
EndProcedure

; ======================================================================
;  CACHE MAINTENANCE - and on this board it is REAL, not a stub.
;
;  The memory family flushes a range before running code that was just
;  written into it, so the instruction fetch sees the new bytes rather
;  than whatever the instruction cache had. On a board with the caches
;  off that can be nothing; this monitor turns them ON during boot, so it
;  has to be the real maintenance or `run` would branch into stale lines.
;
;  CLEAN TO THE POINT OF UNIFICATION, THEN INVALIDATE THE INSTRUCTION
;  LINE, which is the ARM-documented pair for exactly this: `dc cvau`
;  pushes the data the processor wrote out to where an instruction fetch
;  will see it, and `ic ivau` throws away any instruction line that was
;  already holding the old bytes. One without the other is the failure
;  that produces no message at all.
;
;  SIXTY-FOUR BYTES IS THE A53's CACHE LINE, the same as the A72's, so
;  the other board's step carries over unchanged.
;
;  THE ADDRESS GOES THROUGH A GLOBAL because an ASM block cannot take a
;  local as an operand here. Its own procedure, so the loop around it
;  stays readable.
; ======================================================================
Global gPi3FlushAddr.i

Procedure Pi3CacheLine()
  ASM
    adrp x9, global_gpi3flushaddr
    add  x9, x9, #:lo12:global_gpi3flushaddr
    ldr  x9, [x9]
    dc cvau, x9
    ic ivau, x9
  EndASM
EndProcedure

Procedure CacheFlushRange(lo.i, hi.i)
  Define a.i
  If hi < lo
    ProcedureReturn
  EndIf
  a = (lo >> 6) << 6
  While a <= hi
    gPi3FlushAddr = a
    Pi3CacheLine()
    a = a + 64
  Wend
  ASM
    dsb sy
    isb
  EndASM
EndProcedure

; ======================================================================
;  AUTOBOOT - THIS BOARD HAS SOMETHING BETTER AND DOES NOT NEED IT.
;
;  On the Pi 4 an autoboot cell in preserved memory holds an entry point
;  to run without being asked. This board's equivalent is the A/B slot
;  machinery itself: the loader already chooses what runs, verifies it,
;  gives it a trial and falls back if it does not confirm. An autoboot
;  cell beside that would be a second, weaker answer to a question this
;  board has already answered well.
;
;  So there is no armed entry and nothing to store, and Banner() reports
;  none - which is true rather than merely unimplemented.
; ======================================================================
Procedure.i AutoEntry()
  ProcedureReturn 0            ; 0 = no autoboot entry armed
EndProcedure

Procedure AutoSet(a.i)
  ; Nothing to store. The command that calls this says so rather than
  ; falling silent.
EndProcedure

; ======================================================================
;  RunAt(a) - BRANCH INTO A PAYLOAD AND COME BACK.
;
;  This is `run` and `go`, and it is the one place this monitor hands the
;  processor to code it did not compile. It is here rather than in a stub
;  section because it is REAL: it is short because there is very little a
;  board has to do, not because there is nothing.
;
;  THE ADDRESS IS NOT CHECKED HERE and that is not an omission. The
;  command that got it has already been through the address guard and the
;  monitor-window refusals, which is where an address is judged; a second
;  opinion at the branch would either agree, and be noise, or disagree,
;  and leave two answers to one question.
;
;  ZERO IS THE ONE VALUE REFUSED, because it is what every "no entry
;  point" answer in this tree is spelled as - AutoEntry() above returns it
;  - and branching to it would turn a missing payload into a fault at
;  address nothing.
;
;  THE INSTRUCTION CACHE IS THE CALLER'S PROBLEM AND IT IS HANDLED. A
;  payload that arrived over the serial line was WRITTEN as data with the
;  caches on, so the instruction fetch at its entry point could see
;  whatever was there before. Anvil/Core/memcmd.pbi calls
;  CacheFlushRange() over the received range before it calls this, which
;  is exactly why the real maintenance above is not a no-op on this
;  board.
;
;  THE PAYLOAD IS ENTERED WITH THIS MONITOR RESIDENT. It returns here,
;  and everything this board owns - the card, the console, the page
;  tables - is still owned when it does.
; ======================================================================
Procedure RunAt(a.i)
  Define dead.i
  Define stop.i
  If a = 0
    ProcedureReturn
  EndIf
  dead = pi3_deadman_seconds
  ; Consume before the branch, including an arm refusal, so a later
  ; unrelated payload cannot inherit a stale safety setting.
  pi3_deadman_seconds = 0
  If dead > 0
    ; Let the operator's announcement leave PL011 before the timer starts.
    UartDrain()
    If Pi3MonDeadmanStart(dead) = 0
      ; Start rolls back a failed partial arm itself. Retry only a watchdog
      ; still explicitly marked as ours; external owners are never stopped.
      stop=Pi3MonDeadmanStop()
      PrintN("!! payload refused: the hardware watchdog could not be armed")
      PrintN("   without taking over another owner's active watchdog.")
      If stop=0 And pi3_mon_deadman_owned<>0
        PrintN("!! rollback was not verified; reset before attempting another payload.")
      EndIf
      ProcedureReturn
    EndIf
    Print("## hardware watchdog armed for ")
    PrintDec(dead)
    PrintN(" seconds; entering payload.")
    UartDrain()
  EndIf
  Pi3EnterPayload(a)
  If dead > 0
    If Pi3MonDeadmanStop() = 0
      PrintN("!! the payload returned, but its owned watchdog did not verify")
      PrintN("   stopped. Reset before entering another payload.")
    Else
      PrintN("## returned; the owned hardware watchdog is stopped.")
    EndIf
  EndIf
EndProcedure
