; ======================================================================
;  #CAP_BOOT_EL1 = 0 - AND ON THIS BOARD THAT IS NOT A PLATFORM LIMIT.
;
;  The Arduino UNO Q answers 0 here because UEFI runs it at EL1 and there
;  is no higher exception level from which to install one. This board's
;  monitor runs at EL3, so a lower-level handoff is architecturally
;  reachable but remains unimplemented.
;
;  IT IS NOT WRITTEN BECAUSE THE PIECES AROUND IT ARE NOT. Dropping an
;  arm64 Image to EL1 means handing it a device tree - this board has
;  one, pinned at $1000000 - and it means the caches and MMU this monitor
;  just turned on being put back exactly as the kernel expects to find
;  them, which on this part has never been done and cannot be proven
;  without a kernel to boot. That is a milestone of its own.
; ======================================================================

Procedure HwBootToEl1(entry.i, dtb.i)
  ; Unreachable: #CAP_BOOT_EL1 = 0 gates every caller. If it is ever
  ; reached, a capability was declared without a backend, and saying so
  ; is far better than branching somewhere with the wrong exception
  ; level and the caches in an unknown state.
  PrintN("!! HwBootToEl1 was reached on a board that declares #CAP_BOOT_EL1 = 0.")
  PrintN("   That is a bug in this board's capability declaration, not in the")
  PrintN("   command. Nothing was done and nothing was branched to.")
EndProcedure

; ======================================================================
;  HwFirmwareDtb() - AND THIS ONE IS A REAL ANSWER, NOT A STUB.
;
;  It sits in this file because it is one procedure and has no family to
;  live with, not because this board cannot answer it. The Pi 3 CAN: the
;  device tree is at $1000000, pinned there by the boot arrangement -
;  Pi3UpdateConfigure() refuses any other value, the loader passes it in
;  x0 when it branches, and Pi3BootMemory() has already walked its header
;  and checked its magic and its length before this monitor printed
;  anything.
;
;  SO IT RETURNS pi3_dtb AND NOT A CONSTANT. If boot validation refused,
;  pi3_dtb is left at whatever it was and the boot stopped long before
;  here; if it succeeded, this is a pointer somebody has already checked.
;  Returning $1000000 unconditionally would be the same number with none
;  of that behind it.
; ======================================================================

Procedure.i HwFirmwareDtb()
  ProcedureReturn pi3_dtb
EndProcedure

; ======================================================================
;  THE CONSTANTS AND GLOBALS THE SHARED CORE READS FROM ITS BOARD.
;
;  Not a seam and not a capability: a handful of names that shared files
;  reference directly and that only a board can fill in. The Arduino
;  UNO Q keeps its set at the foot of qstubs_q.unoq for the same reason.
; ======================================================================

; The console's own base, which the banner prints so an operator can see
; WHICH port the text they are reading came out of. A real address here,
; unlike the UNO Q, whose console is a firmware protocol with no base.
#UART_BASE = $3F201000

; ----------------------------------------------------------------------
;  THE BOOT COUNTER - THIS BOARD HAS NONE, AND SAYS SO.
;
;  Anvil/Core/uptime.pbi reads a cell that survives a reset and holds a
;  magic and a count, so `uptime` can say how many times the board has
;  restarted. On the Pi 4 a library maintains it; nothing maintains one
;  here, and writing one would be new work in a lane that has been told
;  not to add libraries that do not exist yet.
;
;  SO THE MAGIC IS ZERO AND CAN NEVER MATCH, which is what makes uptime
;  report the count as not available instead of reporting a number that
;  came from whatever was in memory. The address still has to be one that
;  is safe to READ, because the read happens before the magic is tested:
;  the loader's handoff page is mapped, owned by the boot arrangement,
;  and never holds this magic.
;
;  WHAT A REAL ONE WOULD NEED, so nobody starts it by accident: a cell
;  outside both the monitor's BSS and the loader's, in a region
;  memmap.pi3 declares so that `fill` cannot reach it, incremented once
;  per boot before anything can fault, and reset by a confirmed update.
;  That is a milestone, not a constant.
; ----------------------------------------------------------------------
#SAFETY_COUNT_ADDR = $1FF0000      ; the loader handoff page - readable,
                                   ; and never this magic
#SAFETY_MAGIC      = $00000000     ; can never match; the count is absent

; ----------------------------------------------------------------------
;  Globals the shared line editor and commands read. On the Pi 4 they
;  live in that board's display globals; this board has no display
;  service and no USB input, so they are constants that say so.
; ----------------------------------------------------------------------
Global gMouseTried.i = 1     ; 1 = "already tried", so ReadLine never asks
Global gKbdH.i = 0           ; no USB HID keyboard on this board
Global gLastCR.i = 0         ; the line editor's CR/LF de-duplication state
Global gBootTicks.i = 0      ; the counter at entry, set by Main()
Global gBase.i = 0           ; the `base` command's address base
Global gMbx.i = 0            ; the mailbox library keeps its own state

; ======================================================================
;  THE SERVICE HOOKS THE PROMPT CALLS ON EVERY SPIN.
;
;  Anvil's core is one set of bytes for every board, so the command loop
;  and the line editor call these unconditionally. A board that has none
;  of the hardware behind them still has to make the NAMES resolve, and
;  the honest answer is a no-op that says which kind of nothing it is.
;
;  THE TWO THAT RETURN VALUES ARE THE DANGEROUS ONES. KeyboardChar() and
;  NetConsoleGetc() feed the line editor; the only safe answers here are
;  "no character" and "idle", and anything else is a phantom keystroke in
;  somebody's command.
; ======================================================================

Declare ScreenServiceTick()

Procedure ScreenPump()
  ScreenServiceTick()
EndProcedure

Procedure ScreenBannerTick()
  ScreenServiceTick()
EndProcedure

Procedure Pi3DisplayLifecycleStart()
  If pi3_fb_deferred_ready<>0
    ScreenConnectionRegister(1000)
  EndIf
EndProcedure

Procedure.i Pi3DisplayProbe()
  Protected revision.i=HwMemoryRevision()
  Protected model.i=(revision>>4)&$FF
  Protected raw.i
  Protected rc.i
  If model=$08
    rc=Pi3FirmwareGpioGetStateStep(#PI3_FIRMWARE_HDMI0_HPD,@raw)
    If rc=0 : ProcedureReturn #SCREEN_CONNECTION_PENDING : EndIf
    If rc<0 : ProcedureReturn -10 : EndIf
    If raw=0 : Pi3FbInitialPresence(1) : ProcedureReturn #SCREEN_CONNECTION_COMPLETE : EndIf
    Pi3FbInitialPresence(0) : ProcedureReturn #SCREEN_CONNECTION_RESULT_ABSENT
  EndIf
  ; Pi 3B+/3A+ route active-low HDMI0 HPD to SoC GPIO28.
  If model=$0D Or model=$0E
    raw=(PeekL($3F200034)>>28)&1
    If raw=0 : Pi3FbInitialPresence(1) : ProcedureReturn #SCREEN_CONNECTION_COMPLETE : EndIf
    Pi3FbInitialPresence(0) : ProcedureReturn #SCREEN_CONNECTION_RESULT_ABSENT
  EndIf
  ProcedureReturn -11
EndProcedure

Procedure.i Pi3DisplayAttachStep()
  Protected rc.i=Pi3FbAttachStep()
  If rc=0 : ProcedureReturn #SCREEN_CONNECTION_PENDING : EndIf
  If rc=2 : ProcedureReturn #SCREEN_CONNECTION_RETRY : EndIf
  If rc<0 : ProcedureReturn -20 : EndIf
  If Pi3FbDmaInit()=0 : ProcedureReturn -200-Pi3FbDmaError() : EndIf
  ProcedureReturn #SCREEN_CONNECTION_COMPLETE
EndProcedure

Procedure.i Pi3DisplayDetachStep()
  Protected rc.i=Pi3FbDetachStep()
  If rc=0 : ProcedureReturn #SCREEN_CONNECTION_PENDING : EndIf
  pi3_display_redraw_phase=0
  pi3_screen_attached=0 : pi3_screen_initialized=0 : gScreen=0
  pi3_screen_scroll_pending=0 : pi3_screen_frame=0
  If rc<0 : ProcedureReturn -30 : EndIf
  ProcedureReturn #SCREEN_CONNECTION_COMPLETE
EndProcedure

Procedure.i Pi3DisplayRedraw()
  Protected rc.i
  If pi3_display_redraw_phase=0
    pi3_screen_fault=0 : pi3_screen_attached=0 : pi3_screen_initialized=0
    pi3_screen_init_state=0 : pi3_screen_banner_phase=0
    pi3_screen_banner_pos=0 : pi3_screen_logo_row=0
    pi3_display_redraw_phase=1
  EndIf
  If pi3_display_redraw_phase=1
    Pi3ScreenDrain()
    If pi3_screen_fault<>0 : pi3_display_redraw_phase=0 : ProcedureReturn -40 : EndIf
    If pi3_screen_initialized=0 Or Pi3FbPresentPending()<>0 Or pi3_fb_dirty<>0 Or pi3_fb_dma_active<>0 Or pi3_fb_clear_pending<>0 : ProcedureReturn #SCREEN_CONNECTION_PENDING : EndIf
    pi3_display_redraw_phase=2
  EndIf
  If pi3_display_redraw_phase=2
    rc=Pi3FbPowerBegin(1)
    If rc=0 : ProcedureReturn #SCREEN_CONNECTION_PENDING : EndIf
    If rc<0 : pi3_display_redraw_phase=0 : ProcedureReturn -41 : EndIf
    pi3_display_redraw_phase=3 : ProcedureReturn #SCREEN_CONNECTION_PENDING
  EndIf
  If pi3_display_redraw_phase=3
    rc=Pi3FbPowerPoll()
    If rc=0 : ProcedureReturn #SCREEN_CONNECTION_PENDING : EndIf
    If rc<0 : pi3_display_redraw_phase=0 : ProcedureReturn -42 : EndIf
    pi3_display_redraw_phase=4
  EndIf
  If pi3_display_redraw_phase=4
    rc=Pi3FbBlankBegin(0)
    If rc=0 : ProcedureReturn #SCREEN_CONNECTION_PENDING : EndIf
    If rc<0 : pi3_display_redraw_phase=0 : ProcedureReturn -43 : EndIf
    pi3_display_redraw_phase=5 : ProcedureReturn #SCREEN_CONNECTION_PENDING
  EndIf
  rc=Pi3FbBlankPoll()
  If rc=0 : ProcedureReturn #SCREEN_CONNECTION_PENDING : EndIf
  pi3_display_redraw_phase=0
  If rc<0 : ProcedureReturn -44 : EndIf
  ProcedureReturn #SCREEN_CONNECTION_COMPLETE
EndProcedure

Procedure ScreenServiceTick()
  Protected action.i
  Protected result.i
  Protected now.i=millis()
  If pi3_screen_service_busy<>0
    ProcedureReturn
  EndIf
  pi3_screen_service_busy=1
  action=ScreenConnectionNextAction(now)
  Select action
    Case #SCREEN_CONNECTION_ACTION_PROBE : result=Pi3DisplayProbe()
    Case #SCREEN_CONNECTION_ACTION_ATTACH : result=Pi3DisplayAttachStep()
    Case #SCREEN_CONNECTION_ACTION_DETACH : result=Pi3DisplayDetachStep()
    Case #SCREEN_CONNECTION_ACTION_REDRAW : result=Pi3DisplayRedraw()
  EndSelect
  If action<>#SCREEN_CONNECTION_ACTION_NONE
    ScreenConnectionComplete(action,result,now)
  EndIf
  If ScreenConnectionState()=#SCREEN_CONNECTION_ATTACHED
    Pi3ScreenDrain()
    Pi3ScreenUsageTick()
  EndIf
  pi3_screen_service_busy=0
EndProcedure

; No USB host in this image, so no keyboard and no mouse to attach.
