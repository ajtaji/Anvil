XIncludeFile "RaspberryPi3/Lib/wifi_network.pi3"

; NetCfg is intentionally not imported: that module owns the Pi 4 wired
; compatibility globals and configuration commands. The common DHCP worker
; needs only this per-interface lease tail on Pi 3.
Procedure NetAddressBound(kind.i, ip.i, mask.i, gw.i, src.i)
  NetIfSet(kind, ip, mask, gw, src)
  If src = #NET_ADDR_LEASE
    NetIfSetLease(kind, DhcpClientLeaseLeft(kind), millis())
    NetIfSetDns(kind, DhcpClientDns(kind))
  Else
    NetIfSetLease(kind, 0, 0)
    NetIfSetDns(kind, 0)
  EndIf
  HwLinkAddressBound(kind, ip, mask, gw)
  NetConsoleRearm()
EndProcedure

Procedure NetAddressLost(kind.i)
  NetIfClear(kind)
  HwLinkAddressBound(kind, 0, 0, 0)
  NetConsoleRearm()
EndProcedure

