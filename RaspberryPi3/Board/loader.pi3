; Immutable first-stage SD loader. Not deployed; explicit counted target.
; load0x80000 BSS0x180000 stack0x200000; slot entry0x200000.
LoadAddress $80000
BssAddress $180000
StackAddress $200000
#ANVIL_BUILD = 8 ; pmf:build
#ANVIL_BUILD_DATE = 20260912 ; pmf:builddate
#ANVIL_BUILD_TIME = 154328 ; pmf:buildtime
XIncludeFile "RaspberryPi3/Board/update_boot_support.pbi"
Procedure.i Pi3LoaderBootProgress()
  Protected phase.i=pi3_up_boot_phase
  Select phase
    Case 1 : Pi3Say("L1: verify selected slot")
    Case 2 : Pi3Say("L2: write and read back TRIED record")
    Case 3 : Pi3Say("L3: reverify selected slot")
    Case 4 : Pi3Say("L4: copy payload to entry address")
    Default : ProcedureReturn 0
  EndSelect
  ; Alternating steady states preserve a visible last stage if serial is lost.
  Pi3StatusLed(phase & 1)
  ProcedureReturn 1
EndProcedure
Procedure Main()
  Protected start.i
  Protected now.i
  Protected key.i
  Protected spin.i
  Protected fallback.i
  Protected bytes.i
  ASM
    adrp x1, global_pi3_dtb
    add x1, x1, #:lo12:global_pi3_dtb
    str x0, [x1]
  EndASM
  If Pi3UpdateBootStart(1) = 0 : Pi3Park() : EndIf
  PokeI(#PI3_UPDATE_HANDOFF, 0)
  Pi3Say("U: serial recovery; F: older confirmed slot; auto boot in 3 seconds")
  start = Pi3Micros()
  If start < 0 : Pi3Say("STOP: timer unavailable") : Pi3Park() : EndIf
  For spin = 0 To 9999999
    key = Pi3UartRead()
    If key = 85 Or key = 117 : Pi3UpdateServe() : Pi3Park() : EndIf
    If key = 70 Or key = 102 : fallback = 1 : Break : EndIf
    now = Pi3Micros()
    If now < start : Pi3Say("STOP: timer moved backwards") : Pi3Park() : EndIf
    If now - start >= 3000000 : Break : EndIf
  Next
  If spin > 9999999 : Pi3Say("STOP: timer stalled") : Pi3Park() : EndIf
  Pi3Say("L0: arm 15-second pre-branch watchdog")
  If Pi3UpdateBootProgressHandler(@Pi3LoaderBootProgress)=0 : Pi3Say("STOP: boot progress owner refused") : Pi3Park() : EndIf
  If Pi3UpdateWatchdogArmWindow()=0 : Pi3Say("STOP: pre-branch watchdog could not be armed") : Pi3Park() : EndIf
  If fallback <> 0 : bytes = Pi3UpdateLoadFallback() : Else : bytes = Pi3UpdateLoad() : EndIf
  If bytes = 0
    Pi3Say("STOP: slot load/refallback refused; control records preserved")
    Pi3Park()
  EndIf
  Pi3Say("L5: write handoff identity") : Pi3StatusLed(1)
  If Pi3UpdatePrepareHandoff(pi3_dtb) = 0 : Pi3Say("STOP: boot identity refused") : Pi3Park() : EndIf
  Pi3Say("L6: watchdog owned; branch to payload") : Pi3StatusLed(0)
  Pi3UpdateEnter()
  Pi3Park()
EndProcedure
