; DejaVu faces as anti-aliased coverage maps, drawn by DrawSmoothText.
XIncludeFile "RaspberryPi4/Monitor/anvil_fonts.pi4"

XIncludeFile "RaspberryPi4/Board/memmap.pi4"

; The resident secondary-core acceptance owner is deliberately assembled
; before cache.pi4: RunAt and the cache command must be able to refuse a
; machine-policy handoff while cores 1..3 own these rows, stacks and code.
; Nothing here releases a core at boot; only the explicit `coretest run`
; command does that.  core_accept selects the job-capable composition of the
; same raw worker that the standalone emitted gates exercise.
XIncludeFile "RaspberryPi4/Lib/mmu_secondary.pi4"
XIncludeFile "RaspberryPi4/Lib/core_accept.pi4"

; ======================================================================
;  THIS BOARD'S CAPABILITIES - what it offers Anvil's command families.
;
;  The per-board half of the capability model. Anvil/Hal/hal.pbi has the
;  whole reasoning and the seam-group contract; this is the DECLARATION for
;  the Pi 4, one line per group. 1 = this board offers the group and a
;  command gated behind it may assume the board's Hw<group> backend works;
;  0 = Anvil cannot reach the group here. These are read by RequireCap at
;  the top of each gated command; nothing else consults them, and the core
;  never asks which board this is.
;
;  This follows the #ANVIL_CACHE / #ANVIL_V3D_CONSOLE precedent already in
;  this file: a compile-time truth about what the board includes, declared
;  where the board is assembled and reviewable against it.
;
;  IT IS NOT KB-GATING. None of these is 0 to shrink the image (the U-Boot
;  inventory S5.7 forbids that). A 0 here means one thing only: there is
;  genuinely no backend in Anvil's reach on this board - no driver exists
;  to include - never that one was left out to save space. #CAP_I2C was
;  that 0 until 2026-09-01, when the BSC driver was written and it flipped
;  to 1 with no other change (its own line below records that); as of that
;  date nothing in this block is 0.
; ======================================================================
#CAP_STORAGE  = 1   ; a block medium + FAT filesystem. USB stick and SD
                    ; card, driven by Lib/usbmsc + Lib/emmc under Lib/fat -
                    ; load / save / mount work today.
#CAP_NET      = 1   ; an IP-capable interface. Gigabit Ethernet via
                    ; Lib/genet under Lib/net + Lib/tftp - get / put / net.
#CAP_GPIO     = 1   ; general-purpose I/O. Lib/gpio over the HwGpio* seam
                    ; (RaspberryPi4/Board/hw_gpio.pi4) - the `gpio` command.
#CAP_I2C      = 1   ; the header I2C bus (BSC1 on GPIO 2/3), driven by
                    ; Lib/i2c.pi4 under the HwI2c* seam
                    ; (RaspberryPi4/Board/hw_i2c.pi4) - the `i2c` command.
                    ; Flipped from 0 to 1 on 2026-09-01 when the BSC driver
                    ; was written; the `i2c` command that refused before now
                    ; works, with no other change - which is the whole point
                    ; of the capability model.
#CAP_TOUCH    = 1   ; a touch panel controller Anvil can reach. The Goodix
                    ; GT9xx of the Waveshare DSI panel, driven by
                    ; Lib/touch_goodix.pi4 with Lib/dsi_panel_v2.pi4 beside
                    ; it for the panel's power MCU - the `touch` command.
                    ; UNLIKE EVERY OTHER 1 IN THIS BLOCK, this one does not
                    ; mean the hardware has been talked to: it means the
                    ; driver is compiled in and the command exists. Nothing
                    ; has answered on a wire, and `touch` says so in words
                    ; when nothing does. The handler is this board's own
                    ; (Board/touch_cmd.pi4) rather than Core's, because one
                    ; board is not enough examples to shape an Hw* seam
                    ; from; this constant exists so the SHARED help can
                    ; mention the command only where it exists.
#CAP_MMC      = 1   ; the SD/eMMC controller, present and driven by
                    ; Lib/emmc. The raw `mmc` family will ride HwMmc* over
                    ; it; the controller is here, so the capability is 1
                    ; even though that command is not written yet.
#CAP_USB      = 1   ; the PCIe + VL805 xHCI host, present and driven by
                    ; Lib/pcie + Lib/xhci + Lib/usbmsc. The raw `usb` family
                    ; will ride HwUsb* over it.
#CAP_PWM      = 1   ; a modulated output AND the part's own temperature -
                    ; the pair the `fan` command needs. Lib/pwm.pi4 drives
                    ; the two BCM2711 PWM blocks (and a software toggle for
                    ; a pin that has no PWM function), Lib/thermal.pi4
                    ; reads the AVS monitor register with the firmware
                    ; temperature tag as its fallback, and
                    ; Board/hw_pwm.pi4 is the seam over both.
                    ; IT IS 1 THOUGH NO FAN HAS EVER BEEN DRIVEN FROM IT.
                    ; That is the right reading of this flag and it is
                    ; worth being explicit: the capability says the BOARD
                    ; offers the hardware group to Anvil and a backend
                    ; exists, not that the wiring outside the connector has
                    ; been proven. A 0 here would make `fan` refuse on a
                    ; part that plainly has two PWM controllers and a
                    ; thermal sensor, which would be a lie in the other
                    ; direction. The honest not-yet lives in the command's
                    ; own report and in the pin being unset until somebody
                    ; types one.
#CAP_BOOT_EL1 = 1   ; AArch64, and Anvil runs above EL1, so it can install
                    ; an EL1 and drop to it - the arm64 Image / booti
                    ; handoff is feasible on this SoC. HwBootToEl1 is
                    ; written: Board/hw_boot.pi4 is this board's backend
                    ; and Anvil/Core/boot_cmd.pbi calls it for booti and
                    ; bootm. The refusal paths ran on the board on
                    ; 2026-09-02; the EL2->EL1 handoff itself still owes a
                    ; silicon run.
                    ;
                    ; IT STAYS 1 AT EL3, AND THE REFUSAL MOVED INSTEAD.
                    ; This used to say "Anvil runs at EL2", which is true
                    ; of one boot path and not the other. A capability is
                    ; a fact about the BOARD - this one can host an EL1
                    ; either way - and it is a compile-time constant, so it
                    ; cannot answer a question whose answer is decided by
                    ; which stub is on the card. HwBootToEl1 makes the EL3
                    ; refusal itself, in a whole sentence, before it takes
                    ; the machine apart. See its header for what an
                    ; EL3-to-EL1 handover would need.

; ----------------------------------------------------------------------
;  THE SEVEN GROUPS THE PAYLOAD ABI ADDED, 2026-09-04.
;
;  Anvil/Hal/abi.pbi hands a payload a service table, and a payload is an
;  APPLICATION rather than a diagnostic - so it needs classes of hardware
;  the monitor's own command families never wanted. Each is declared here
;  exactly like the seven above, and each has its Hw<GROUP>* contract in
;  Anvil/Hal/hal.pbi's SEAM GROUPS section.
;
;  SIX OF THE SEVEN ARE 0 ON THIS BOARD TODAY, AND NOT ONE OF THEM IS 0 TO
;  SAVE SPACE. The U-Boot inventory S5.7 forbids that and hal.pi4 repeats
;  it. They are 0 because the backend does not exist yet, or because the
;  hardware is genuinely not wired to this board - and from the payload's
;  seat those are the same fact and the same honest refusal.
; ----------------------------------------------------------------------
#CAP_CONSOLE  = 1   ; A PIXEL SURFACE ANVIL CAN HAND TO A PAYLOAD, over the
                    ; HwCon* seam (RaspberryPi4/Board/hw_con.pi4) on
                    ; Lib/display.pi4's mailbox framebuffer and
                    ; Board/display.pi4's rasteriser. Not the monitor's own
                    ; terminal grid - that stays Anvil's.
; #CAP_TOUCH IS DECLARED ONCE, FURTHER UP THIS BLOCK, AND IT IS 1.
; It is not repeated here, and the reason is worth the four lines it
; costs. This branch was written when no board in the tree could reach a
; touch controller at all, so it declared #CAP_TOUCH = 0 in this second
; block; while it was paused the Goodix GT9xx of the DSI panel landed on
; the trunk with its own driver and its own `touch` command, and that
; work declared #CAP_TOUCH = 1 above. Two declarations of one name is two
; meanings of one name, which is the defect this merge could have left
; behind, so there is one - the trunk's - and the payload ABI reads it.
;
; WHAT THE PAYLOAD SEES, and the two codes are different on purpose:
; SvcCapGet(#SVCCAP_TOUCH) answers 1, because this board really does have
; a touch controller Anvil can reach. The touch SLOTS answer #SVC_ENOSYS,
; because the HwTouch* seam over that driver is not written - the slot is
; not implemented in this Anvil, which is a different sentence from the
; board not having the hardware, and a payload that can tell them apart
; can say which one it is looking at. Phase A item 2c writes the seam and
; the slots start answering; nothing here changes when it does.
#CAP_GNSS     = 0   ; NO BACKEND YET, and no receiver on the bench. The UBX
                    ; decoder exists as an AVR example and has to be lifted
                    ; into a Lib; Phase A item 2b.
#CAP_UART     = 0   ; NO BACKEND YET. The part has spare PL011s, but WHICH
                    ; one is free depends on what else the board is using,
                    ; and that decision belongs in a backend that also names
                    ; the pins through HwGpioReservedReason() - or the next
                    ; person to type `gpio` gets a surprise.
#CAP_SPI      = 0   ; THERE IS NO SPI LIBRARY IN THIS TREE AT ALL. SPI0 is
                    ; on GPIO 7-11 (ALT0) and nothing drives it. It stays on
                    ; the critical path because LoRa is a module on SPI and
                    ; LoRa is the vehicle link's second transport.
#CAP_VEHLINK  = 0   ; NO BACKEND YET. This is the seam that REPLACED CAN on
                    ; 2026-09-04: this product does not hook to the engine
                    ; port at all. A separate device plugs into that port
                    ; and reaches this board over Wi-Fi or LoRa, so what
                    ; lands here is a radio link and not a bus. The Pi 4
                    ; already has the Wi-Fi to carry it and
                    ; Anvil already brings that radio up; what is missing is
                    ; the wire format to the second unit, which is that
                    ; unit's own design note. Phase A item 2a.
#CAP_RTC      = 0   ; THIS PART HAS NO REAL-TIME CLOCK, and that is measured
                    ; rather than assumed: grepping the four device trees
                    ; for an rtc@ node gives five hits, all of them uartclk
                    ; (Raspberry Pi 4/A wall clock and a task list
                    ; 2026-08-28). 1 here would mean a DS3231 is wired to
                    ; the header I2C bus, and none is - so every cold boot
                    ; starts #HW_CLK_UNSET and says so.

; The board's identity for the payload ABI, one of Anvil/Hal/abi.pbi's
; #SVC_BOARD_* codes. INFORMATIONAL ONLY - a payload that branches on it
; has re-forked the thing the capability model exists to prevent, and
; tools/a64/a64_abi_check.py looks for exactly that.
#SVC_BOARD_ID = 1   ; #SVC_BOARD_PI4

; ----------------------------------------------------------------------
;  THE HAL FOUNDATION IS INCLUDED FURTHER UP THIS FILE, next to fat.pi4
;  and Anvil/Storage/hwfile.pbi, and this note is where it used to be so that
;  nobody looks for it here and concludes it is missing.
;
;  IT MOVED BECAUSE THE STORAGE SEAM FORCED IT. Anvil/Storage/hwfile.pbi speaks
;  the #HW_FILE_* vocabulary that hal.pi4 declares, and hwfile.pbi must
;  come before Anvil/Core/settings.pbi, which is included right after
;  fat.pi4 - so hal.pi4 has to be earlier than both.
;
;  NOTHING BREAKS BY MOVING IT EARLIER, and the reason is worth stating
;  rather than trusting. hal.pi4 contains constant declarations and one
;  procedure, RequireCap, which takes the capability BY VALUE - it never
;  names a #CAP_ constant in code, only in its documentation. So it does
;  not depend on the #CAP_* block below, and it needs nothing but uart.pi4
;  for the sentence it prints. What still matters, and still holds, is
;  that it comes before every gated command handler; all of those are
;  further down than it now is.
; ----------------------------------------------------------------------
; The Pi 4 HwGpio* backend, thin wrappers over Lib/gpio.pi4 (included
; above) returning the #HW_* codes hal.pi4 defines. This is the one file
; that knows the BCM2711's GPIO encoding; the `gpio` command above it does
; not.
XIncludeFile "RaspberryPi4/Board/hw_gpio.pi4"
; The Pi 4 HwI2c* backend, thin wrappers over Lib/i2c.pi4 (included above)
; returning the #HW_I2C_* codes hal.pi4 defines. This is the one board file
; that knows the BCM2711 has BSC1 on the header; the `i2c` command above it
; knows only bus numbers and portable result codes.
XIncludeFile "RaspberryPi4/Board/hw_i2c.pi4"
; The Pi 4 HwPwm* and HwTemp* backend, thin wrappers over Lib/pwm.pi4 and
; Lib/thermal.pi4 (both included above) returning the #HW_PWM_* and
; #HW_TEMP_* codes hal.pi4 defines. IT MUST COME AFTER hw_gpio.pi4, and
; not only after hal.pi4: it asks HwGpioReservedReason() and
; HwGpioUserMax() rather than keeping a second copy of the reserved-pin
; list, so that the pins `fan` refuses and the pins `gpio` refuses can
; never drift apart.
XIncludeFile "RaspberryPi4/Board/hw_pwm.pi4"

XIncludeFile "Anvil/Core/state.pbi"
XIncludeFile "RaspberryPi4/Board/display_globals.pi4"
XIncludeFile "Anvil/Core/format.pbi"
XIncludeFile "Anvil/Core/build_identity.pbi"
XIncludeFile "RaspberryPi4/Board/banner_identity.pi4"
XIncludeFile "Anvil/Core/rxbreak.pbi"
XIncludeFile "RaspberryPi4/Lib/http.pi4"
XIncludeFile "Anvil/Core/crc.pbi"
; THE INPUT SEAM, AHEAD OF THE LINE READER THAT NOW SITS ON IT.
; input_events.pbi normalizes every producer - serial, USB keyboard,
; network console and the soft keyboard - into one queue with focus and
; capture; text_edit.pbi is the single edited line and caret underneath
; ReadLine. Both must follow state.pbi (gLine, #LINE_MAX) and
; display_globals.pi4 (gLastCR), and both must precede parse.pbi.
XIncludeFile "Anvil/Core/input_events.pbi"
XIncludeFile "Anvil/Core/text_edit.pbi"
; The touch keyboard's model - what the keys MEAN. It is portable Anvil
; code with no coordinates in it, and it belongs HERE, beside the
; dispatcher and the editor it feeds, rather than beside the screen. It
; must precede console.pi4, which includes the keyboard's view: the view
; asks the model for its keys, its labels and which of them is the hide
; chevron, and the model asks the view exactly one question back.
XIncludeFile "Anvil/Core/touch_keyboard.pbi"
XIncludeFile "Anvil/Core/parse.pbi"
; THE MESSAGE LOG. What background services say is kept here and never
; written on the command line; the banner caption shows the newest and
; `messages` prints them. The diversion itself is in RaspberryPi4/Lib/uart.pi4.
XIncludeFile "Anvil/Core/messages.pbi"
XIncludeFile "Anvil/Core/memrange.pbi"
; HOW MUCH MEMORY THIS BOARD HAS. Decoded from the firmware's board
; revision code, asked once and remembered. It comes FIRST because the
; address-safety answer below is built on it: an address past the top of
; memory is the one thing this board refuses. It needs mailbox.pi4
; (asked lazily, and quietly - see the file), hal.pi4 for
; #HW_MEM_UNKNOWN and format.pi4 for PrintDec, all included above.
XIncludeFile "RaspberryPi4/Board/hw_mem.pi4"
; THE ADDRESS-SAFETY SEAM. The board's answer first, then the core side
; that asks it - the same backend-before-family order hw_gpio.pi4 and
; gpio_cmd.pi4 have. hw_addr.pi4 needs hal.pi4 (the #HW_ADDR_* codes,
; included above), format.pi4 (it prints a paragraph into `info`),
; mmu.pi4 (#MMU_PERIPH_BASE, the boundary the memory arithmetic turns
; on) and hw_mem.pi4 immediately above, and addrsafe.pi4 must precede
; every command that takes an address from the operator - which is most
; of what follows.
XIncludeFile "RaspberryPi4/Board/hw_addr.pi4"
XIncludeFile "Anvil/Core/addrsafe.pbi"
; IS THE MONITOR TO KEEP THE PAYLOAD'S LAST FRAME? One boolean and a
; sequence number, and they are core rather than board because the
; question is the same everywhere and only the answer - which bytes the
; panel is scanning, and where a copy fits - belongs to a board. It comes
; in before cache.pi4, whose RunAt takes the arm on the way back from a
; payload, and before bootfile_cmd.pbi, where `boot mem <addr> shot` sets
; it.
XIncludeFile "Anvil/Core/shotarm.pbi"
XIncludeFile "RaspberryPi4/Board/runrecord.pi4"
XIncludeFile "RaspberryPi4/Board/cache.pi4"
; The retained boot-timing record. After cache.pi4 because it cleans its
; own page to the point of coherency through CacheCleanRangePoc, and
; after memmap.pi4 because its fixed address is the last page of the DSI
; framebuffer window declared there. Before every file that marks - the
; screen, the console, the GPU adapter and the two boot halves - which is
; everything below this line.
XIncludeFile "RaspberryPi4/Board/boot_timing.pi4"
; The board's half of the driver-module contract: where a module may
; live, how to make written bytes executable, what devices are here, and
; which seams the core reaches without one. After cache.pi4 because it
; calls CacheFlushRange, and before abi.pbi because SvcCapGet asks it.
XIncludeFile "RaspberryPi4/Board/hw_mod.pi4"
XIncludeFile "Anvil/Core/xfer.pbi"
XIncludeFile "Anvil/Core/memcmd.pbi"
; readback - bulk bytes OFF the board, base64 with a length and a crc32
; line at the end. After memcmd because it is the same family of
; commands, and after netconsole.pbi, crc.pbi, parse.pbi and addrsafe.pbi
; because it reaches all four: it asks the network console whether the
; peer typed this line, and sends the payload to whoever did.
XIncludeFile "Anvil/Core/readback.pbi"
XIncludeFile "RaspberryPi4/Board/mailbox_info.pi4"
XIncludeFile "Anvil/Core/uptime.pbi"
; i2c - the second family to ride the capability model. Core, chip-free; it
; gates on #CAP_I2C through RequireCap and drives the bus through the HwI2c*
; seam the board backend supplies. Comes after hal.pi4, hw_i2c.pi4,
; state.pi4, parse.pi4, rxbreak.pi4 and format.pi4, all above.
;
; IT SITS HERE, ABOVE clock_info.pi4, AND NOT WITH THE OTHER COMMAND
; FAMILIES. `info` (in clock_info.pi4) reports which pins the I2C bus is
; on and what they are doing, and it does that by calling this file's
; I2cSayPins() rather than by growing a second copy of the same prose that
; could drift from what `i2c speed` says. A procedure has to be defined
; before it is called, so this include has to come first. Moving it back
; down breaks the build at CmdInfo - loudly, which is the right failure.
XIncludeFile "Anvil/Core/i2c_cmd.pbi"
; Pi-specific DSI/MMIO commands follow the shared address/abort guards.
; Touch's hardware backend follows screen geometry below, because input
; and presentation must use the same rotation and physical coordinates.
XIncludeFile "RaspberryPi4/Board/dsi_cmd.pi4"
XIncludeFile "RaspberryPi4/Board/clock_info.pi4"
XIncludeFile "Anvil/Core/auto.pbi"
; THE DISPLAY SEAM, ahead of everything that reports on a screen or
; draws on one. It is the whole of what the two kinds of screen on this
; board have in common - HDMI, whose framebuffer the FIRMWARE allocates,
; and the DSI panel, whose framebuffer THIS MONITOR allocates because
; the firmware owns no DSI display and will not on a stock config.txt.
; Board's display.pi4 asks it which screen the picture is on;
; screen_cmd.pi4 drives it.
; The seam's arithmetic first - the boot choice, the font rule, the
; rotation map and the transpose. Its own file because every procedure
; in it is a function of its arguments, which is what lets the emulator
; gate execute the shipped image of it on a machine with no VideoCore.
XIncludeFile "RaspberryPi4/Board/screen_geom.pi4"
XIncludeFile "RaspberryPi4/Board/screen_source.pi4"
XIncludeFile "RaspberryPi4/Board/hw_touch.pi4"
XIncludeFile "RaspberryPi4/Board/banner_status.pi4"
XIncludeFile "RaspberryPi4/Board/display.pi4"
; THE ONE CONSOLE CORE - the shared terminal grid + the output hub
; (ScreenPump). Every screen renderer below paints THIS grid; serial and
; wifi are byte-stream endpoints off the same output. Included before the
; renderers and the input loop that pump it.
XIncludeFile "RaspberryPi4/Board/console.pi4"
XIncludeFile "RaspberryPi4/Board/cursor_input.pi4"
; The V3D/NeonArcade console backend, after the DMA console layer it draws
; alongside (it reuses DrawBanner/DisplayConsole to hand the screen back)
; and before screen_cmd.pi4, whose ScreenPump delegates to it and whose
; CmdScreen switches between the two with `screen v3d` / `screen dma`.
CompilerIf #ANVIL_V3D_CONSOLE = 1
XIncludeFile "RaspberryPi4/Board/v3d_console.pi4"
CompilerEndIf
; THE VULKAN / TRUEType CONSOLE, behind #ANVIL_VULKAN_CONSOLE. It uses
; the same V3D/Neon device backend plus the resident Chrome's single atlas;
; the console module owns its Vulkan target and switches only on `screen
; vulkan`. The caller still owns the default DMA console until selected.
; This path requires the V3D/Neon libraries above; setting Vulkan on while
; those dependencies are compiled out is an invalid board configuration.
CompilerIf #ANVIL_VULKAN_CONSOLE = 1 And #ANVIL_V3D_CONSOLE = 0
CompilerError "#ANVIL_VULKAN_CONSOLE requires #ANVIL_V3D_CONSOLE"
CompilerEndIf
CompilerIf #ANVIL_VULKAN_CONSOLE = 1
XIncludeFile "Anvil/Graphics/Vulkan/vk_api.pbi"
XIncludeFile "Anvil/Graphics/Vulkan/vk_spirv_fixtures.pbi"
XIncludeFile "Anvil/Graphics/Vulkan/vk_v3d_shader.pi4"
XIncludeFile "Anvil/Graphics/Vulkan/vk_v3d_backend.pi4"
XIncludeFile "Anvil/Graphics/Vulkan/neon_vk_chrome.pi4"
XIncludeFile "Anvil/Graphics/truetype_renderer.pbi"
XIncludeFile "Anvil/Graphics/truetype_raster_neon.pbi"
XIncludeFile "RaspberryPi4/Board/vulkan_console.pi4"
CompilerEndIf
XIncludeFile "RaspberryPi4/Board/banner_clock.pi4"
XIncludeFile "RaspberryPi4/Board/screen_cmd.pi4"
XIncludeFile "RaspberryPi4/Board/touch_visual_test.pi4"
XIncludeFile "RaspberryPi4/Board/touch_cmd.pi4"
XIncludeFile "RaspberryPi4/Board/power.pi4"
XIncludeFile "RaspberryPi4/Board/storage.pi4"
; hw_mmc - the Pi 4 HwMmc* backend for the raw `mmc` command, over
; Lib/emmc.pi4 (included far above). Comes after hal.pi4 (the #HW_MMC_*
; vocabulary), emmc.pi4, and storage.pi4 (whose gSdUp bring-up record it
; shares, so the two never reset the card controller under each other).
XIncludeFile "RaspberryPi4/Board/hw_mmc.pi4"
; The Pi 4 HwUsb* backend, thin wrappers over Lib/pcie + Lib/xhci +
; Lib/usbmsc and the UsbEnumerate walk in cursor_input.pi4 (all above),
; returning the portable #HW_USB_* codes hal.pi4 defines. This is the one
; file that knows the VL805 xHCI stack; the `usb` command above it does
; not. After cursor_input.pi4 (UsbEnumerate) and storage.pi4.
XIncludeFile "RaspberryPi4/Board/hw_usb.pi4"
; data:/ paths and the data.path setting - pure, before the commands that
; take storage paths.
XIncludeFile "Anvil/Core/datapath.pbi"
XIncludeFile "Anvil/Core/fs_cmd.pbi"
XIncludeFile "Anvil/Core/argfmt.pbi"
XIncludeFile "Anvil/Core/settings_cmd.pbi"
XIncludeFile "Anvil/Core/time_cmd.pbi"
XIncludeFile "Anvil/Core/wifi_cmd.pbi"
XIncludeFile "RaspberryPi4/Board/eth_globals.pi4"
XIncludeFile "RaspberryPi4/Board/eth_mac.pi4"
XIncludeFile "Anvil/Core/netcfg.pbi"
; netll - RFC 3927 link-local, the THIRD way this board can hold an
; address, after a lease and a saved one (Core, portable). AFTER
; netcfg.pi4, whose NetAddressBound is the tail it ends in and whose
; #NET_ADDR_LINKLOCAL it names; after netfmt.pi4 (PutIp, EthWhyNet) and
; eth_globals.pi4 (gEthLlIp) just above; after link.pi4 and
; netconsole.pi4 far above. BEFORE eth.pi4, whose EthBootWired calls it
; as the third step of the boot's wired policy, and before boot.pi4,
; which registers its surrender hook and calls it for the radio. Its
; packets, its conflict test and every one of the RFC's numbers are in
; RaspberryPi4/Lib/net.pi4.
XIncludeFile "Anvil/Core/netll.pbi"
XIncludeFile "RaspberryPi4/Board/eth.pi4"
; The console half of `net recv`. Core, gated on #CAP_NET. It comes
; BEFORE net_cmd.pi4 because CmdNet dispatches to CmdNetRecv, and AFTER
; eth.pi4 because it calls LinkBringUp. Its other callees - the
; NetRecv* engine (Core/netrecv.pi4, up with tcp.pi4), PayloadTop and
; InPayload (Core/memrange.pi4), AddrAllowed (Core/addrsafe.pi4), PutIp
; (Core/netfmt.pi4) and ArgWord (Core/argfmt.pi4) - are all above.
XIncludeFile "Anvil/Core/netrecv_cmd.pbi"
XIncludeFile "Anvil/Core/net_cmd.pbi"
XIncludeFile "Anvil/Core/tcp_cmd.pbi"
XIncludeFile "Anvil/Services/Http/monitor.pbi"
; The Pi 4 HwBootEl1 backend (booti/bootm's EL2->EL1 handoff). Comes after
; cache.pi4 (CacheDisable/gCacheOn) and eth.pi4 (EthDown), which it calls to
; quiesce the machine before it hands over, and it declares gBootDtb which
; Main() captures x0 into. The core boot_cmd.pi4 below rides its seam.
XIncludeFile "RaspberryPi4/Board/hw_boot.pi4"
; flow_cmd (echo, sleep, version) uses ArgWord from argfmt.pi4 and the
; timer, so it comes after those and before the main loop that calls it.
; hw_id - THIS BOARD'S IDENTITY (forum 575). The core's banner and
; `version` no longer state any board's facts as prose; they ask the HwId*
; seam, and this file is this board's answer. It comes after Lib/mmu.pi4
; (MmuEl), Board/memmap.pi4 (#MON_LO), Core/format.pi4 (PutAddr) and
; Board/storage.pi4 + Anvil/Storage/hwfile.pbi (the image length off the boot
; medium), all above, and before flow_cmd.pi4 and help.pi4 which call it.
XIncludeFile "RaspberryPi4/Board/hw_id.pi4"
XIncludeFile "Anvil/Core/flow_cmd.pbi"
; hash_cmd (sha1sum, sha256sum) rides Lib/sha1.pi4 and Lib/sha256.pi4,
; both included far above, so it comes after them and before the loop.
XIncludeFile "Anvil/Core/hash_cmd.pbi"
; crypto - THE ON-BOARD KNOWN-ANSWER SELF-TEST for every crypto module,
; on the same vectors the desktop gates use. The table comes first and
; is GENERATED (tools/gen_pi4_crypto_selftest.py) - it is pure data, no
; code, and the command file is declared from its #CRY_MAX_* constants,
; so the two cannot be built from different trees without the board
; saying so. Both come after every crypto library above, after
; Lib/timer.pi4 for CNTPCT_EL0, after Core/format.pi4 for PutHex16 and
; after Core/rxbreak.pi4 for the any-key stop.
; ----------------------------------------------------------------------
; THE PUBLIC-KEY HALF - part two of the crypto campaign. Nothing in the
; monitor CALLED these until now, and an unreachable module in a boot
; image is an unrequested feature; the `crypto` self-test below is what
; makes them reachable, so they are here because something in the image
; runs them, not in case something might.
;
; THE ORDER IS A DEPENDENCY ORDER, NOT A PREFERENCE. bignum first -
; every other file here is built on the i15 core. ec256 and x25519 next;
; ecdsa needs ec256, rsa needs bignum. t0vm and its bytecode blob before
; x509, which drives that VM to walk a certificate. #X509_SIG_LINKED = 1
; compiles out x509's own stubs for RsaSetPubKey, RsaVrfy and EcdsaVrfy,
; and those three names are the ONLY collisions between this block and
; the rest of the image - the stubs exist for a build that has no
; signature modules, which this one is not.
;
; This is the configuration tools/a64/a64_x509_check.py calls MODE C:
; the whole seam linked, nothing stubbed - an image no 32-bit family in
; this tree can build, because their nine-argument RsaVrfy does not
; compile on this backend at all. That refusal is what RsaSetPubKey
; exists for and it is filed, not fixed.
XIncludeFile "RaspberryPi4/Lib/bignum.pi4"
XIncludeFile "RaspberryPi4/Lib/ec256.pi4"
XIncludeFile "RaspberryPi4/Lib/x25519.pi4"
XIncludeFile "RaspberryPi4/Lib/ecdsa.pi4"
XIncludeFile "RaspberryPi4/Lib/rsa.pi4"
XIncludeFile "RaspberryPi4/Lib/t0vm.pi4"
XIncludeFile "RaspberryPi4/Lib/x509_blob.pi4"
#X509_SIG_LINKED = 1
XIncludeFile "RaspberryPi4/Lib/x509.pi4"
XIncludeFile "Anvil/Core/cryptotest_vectors.pbi"
XIncludeFile "Anvil/Core/crypto_cmd.pbi"
; boot - THE BOOTLOADER. The payload container (.pmf), the `boot` command
; family, and BootFileWait(), the persisted-boot-target countdown Main()
; runs after BootWait(). Core and chip-free: storage through the HwFile*
; seam, the jump through this board's RunAt(), the digest through
; Anvil/Core/sha256.pbi, the target through the settings store. It comes
; after hash_cmd.pi4 because it prints digests with that file's
; PutHexLower2, and after Board/storage.pi4 because it calls HwStorageUp().
; THE PAYLOAD ABI. Three files, in this order, and the order is forced:
;
;   hw_board.pi4  the board's own identity, reset and MMU-state answers.
;                 After safety.pi4 (SafetyToFirmware), mmu.pi4
;                 (MmuSctlrEl2) and cache.pi4, all far above.
;   hw_con.pi4    the HwCon* pixel surface. After Lib/display.pi4,
;                 Monitor/anvil_fonts.pi4 and Board/display.pi4, whose
;                 DrawSmoothText and SmoothTextWidth it is thin over.
;   abi.pi4       the service table itself. It calls both of the above and
;                 every Hw* seam in this build, so it comes after all of
;                 them - AND BEFORE pmfboot.pi4, which is the one caller
;                 of BuildServiceTable(). A procedure has to be defined
;                 before it is called in this language, so moving abi.pi4
;                 below pmfboot.pi4 breaks the build at PmfEnter - loudly,
;                 which is the right failure.
XIncludeFile "RaspberryPi4/Board/hw_board.pi4"
XIncludeFile "RaspberryPi4/Board/hw_con.pi4"
XIncludeFile "Anvil/Hal/abi_version.pbi"
XIncludeFile "Anvil/Hal/abi.pbi"
XIncludeFile "Anvil/Core/pmfboot.pbi"
; ----------------------------------------------------------------------
;  THE DRIVER-MODULE LOADER. After pmfboot.pbi because the two are the
;  same job on two container formats and this is the order a reader wants
;  them in; after abi.pbi because a module is entered with the service
;  table's address; after format.pbi, parse.pbi and argfmt.pbi because
;  the console file uses all three.
;
;  The SEAM REGISTRY is not here - it is at the top of this file, with
;  the contract, for the reason given there.
; ----------------------------------------------------------------------
XIncludeFile "Anvil/Core/mod_container.pbi"
XIncludeFile "Anvil/Core/mod_arena.pbi"
XIncludeFile "Anvil/Core/mod_lifecycle.pbi"
XIncludeFile "Anvil/Core/mod_manifest.pbi"
XIncludeFile "Anvil/Core/mod_cmd.pbi"
; ... and its console side: the `boot` command word, the four boot.*
; settings, and BootFileWait(). Separate from the engine above so the
; engine can be built - and gated - without a line editor.
XIncludeFile "Anvil/Core/bootfile_cmd.pbi"
; Text/reporting half of the explicit multicore acceptance command. Its
; hardware owner was included above cache.pi4 so the payload and cache paths
; can see the ownership boundary. This reporting half uses the console's real
; PrintDec routine already included above; it defines no private formatter.
XIncludeFile "RaspberryPi4/Board/core_accept_cmd.pi4"
; fan - the temperature, the curve and the pulse width. Core, chip-free;
; it gates on #CAP_PWM through RequireCap (Anvil/Hal/hal.pbi), drives the
; pin through the HwPwm* seam and reads the part through HwTemp*. It comes
; after bootfile_cmd.pi4 deliberately and not by accident: PmfDecOf and
; PmfPutDec live there, and a second copy of "a decimal string, or the
; documented default when it is not one" is a second chance to disagree
; about what "30x" means.
XIncludeFile "Anvil/Core/fan.pbi"
XIncludeFile "Anvil/Core/fan_cmd.pbi"
; gpio - the demonstrator of the capability model. Core, chip-free; it
; gates on #CAP_GPIO through RequireCap (Anvil/Hal/hal.pbi) and reports the
; pins through the HwGpio* seam the board backend supplies. Comes after
; hal.pi4, hw_gpio.pi4, state.pi4, parse.pi4 and argfmt.pi4, all above.
XIncludeFile "Anvil/Core/gpio_cmd.pbi"
; booti / bootm - boot an OS from memory. Core, chip-free; they gate on
; #CAP_BOOT_EL1 through RequireCap (Anvil/Hal/hal.pbi), validate the image,
; choose the device tree, and hand off through the HwBootToEl1 seam the board
; backend (hw_boot.pi4, above) supplies. Comes after hal.pi4, hw_boot.pi4,
; state.pi4, parse.pi4, format.pi4 and memmap.pi4, all above.
XIncludeFile "Anvil/Core/boot_cmd.pbi"
; i2c IS NOT INCLUDED HERE ANY MORE. It moved up, above clock_info.pi4, so
; that `info` can call its I2cSayPins() - the note is at the new include.
; This signpost stays so nobody re-adds the line here and ends up with two
; definitions of every procedure in that file.
; mmc - the raw block command. Core, chip-free; it gates on #CAP_MMC
; through RequireCap and works the card through the HwMmc* seam the board
; backend (hw_mmc.pi4, above) supplies. Comes after hal.pi4, hw_mmc.pi4,
; memrange.pi4 (HitsMonitor), parse.pi4 and format.pi4, all above.
XIncludeFile "Anvil/Core/mmc_cmd.pbi"
; usb - the USB diagnostics command. Core, chip-free; it gates on #CAP_USB
; through RequireCap and reports the host, the devices and a raw block read
; through the HwUsb* seam hw_usb.pi4 supplies. After hal.pi4, hw_usb.pi4,
; memrange.pi4 (payload-window checks), parse.pi4 and format.pi4, all above.
XIncludeFile "Anvil/Core/usb_cmd.pbi"
; TrueType is a memory-only parser. The monitor's font command supplies a
; bounded file read and resident-slot memory; graphics code only borrows the
; selected face and never owns a filesystem handle.
XIncludeFile "Anvil/Graphics/truetype_renderer.pbi"
XIncludeFile "Anvil/Core/font_cmd.pbi"
XIncludeFile "Anvil/Core/help.pbi"
XIncludeFile "RaspberryPi4/Board/boot.pi4"
XIncludeFile "Anvil/Kernel/exceptions.pbi"
XIncludeFile "RaspberryPi4/Lib/interrupts.pi4"
; Explicit only: neither the secure timer nor its controlled-fault acceptance
; runs during boot.  `el3test` below is the sole production entry point.
XIncludeFile "Anvil/Kernel/Scheduler/timer_el3.pbi"
XIncludeFile "RaspberryPi4/Board/el3_acceptance.pi4"
XIncludeFile "RaspberryPi4/Board/exception_support.pi4"

Procedure Main()
  Define c.i
  Define hz.i

  ASM
    ; CAPTURE THE FIRMWARE DEVICE-TREE POINTER, FIRST, BEFORE ANYTHING
    ; TOUCHES x0.
    ;
    ; The selected Raspberry Pi armstub enters kernel8.img with x0 = the
    ; firmware's flattened-device-tree pointer and x1=x2=x3=0. The stock stub
    ; enters EL2h; Anvil's optional checked stub retains EL3. Both use the same
    ; handoff (Datasheets/pi4/armstub8.S:163-171: primary_cpu loads w0 from
    ; dtb_ptr32, then br x4). Anvil is kernel8.img, so x0 is that DTB at
    ; _start. Nothing between _start and here has touched it:
    ; EmitCore_A64.pbi's preamble uses x9,x10,x16,x17,x18 for the stack,
    ; BSS-zero and the FP gate; Main()'s prologue uses x29,x30; and this is
    ; Main()'s FIRST statement. So x0 still holds the DTB, and booti reads
    ; it back through HwFirmwareDtb() (RaspberryPi4/Board/hw_boot.pi4).
    ;
    ; x1 is a safe scratch: the stub set it to 0 at entry and nothing reads
    ; it here. The store lands in DRAM because the caches are still off (the
    ; selected stub's active SCTLR bank has C=0 and Anvil has not enabled the MMU yet), which
    ; is why HwFirmwareDtb() reads the right value however the D-cache is set
    ; later. global_gbootdtb is gBootDtb (hw_boot.pi4), already zeroed by the
    ; BSS-zero pass that ran before Main; this overwrites that zero.
    adrp x1, global_gbootdtb
    add  x1, x1, #:lo12:global_gbootdtb
    str  x0, [x1]

    ; MOVE THE MONITOR'S STACK OFF $08000000.
    ;
    ; The emitted prologue put sp at a hardcoded $08000000 and every
    ; payload's prologue will put its own sp at the same address. One
    ; of us has to move, and it has to be us, because we are the one
    ; that has to still be here afterwards. #MON_STACK = $00100000,
    ; growing down through free DRAM and stopping well above the
    ; firmware's spin table at $0..$FFF.
    ;
    ; Main()'s own frame is stranded on the old stack by this, which is
    ; harmless ONLY because Main() never returns.
    ;
    ; movz zeroes the whole 64-bit register and movk writes one field
    ; without disturbing the rest, so this is a full 64-bit constant
    ; even though only one field is non-zero.
    movz x16, #0
    movk x16, #0x0010, lsl #16
    mov  sp, x16
  EndASM

  ; ADOPT the port, do not initialise it. uart.pi4 offers both calls and
  ; the wrong one here would disable the PL011, reprogram it and flush
  ; whatever the loader had queued - see the header.
  ; 115200 regardless of what the firmware or a loader left behind. The
  ; baud command can raise it afterwards; coming up at anything else
  ; would mean the first line out is unreadable to a host that has not
  ; been told yet.
  ; Capture synchronous failures from the earliest driver initialization.
  ; This installs only the current EL's vectors; it never unmasks IRQs.
  HwExceptionPrepare()
  UartInit(115200)
  If gExceptionReady = 0
    Print("!! Processor exception installation failed with code ")
    PrintDec(ExceptionError()) : PrintNl()
    PrintN("   Processor exception vectors could not be installed. Check the")
    PrintN("   primary-core EL2/EL3 boot configuration before using this image.")
  EndIf
  HwInterruptPrepare()
  If gInterruptReady = 0
    PrintN("!! The interrupt controller was not prepared; IRQs remain masked.")
    PrintN("   Polling remains available. Check the GIC identity and vector setup.")
  EndIf

  ; THE ARM CLOCK, BEFORE ANYTHING THAT IS SLOW.
  ;
  ; The firmware hands a Pi 4 to its kernel at 600 MHz, not the 1500 MHz
  ; the part is rated for. That is not a fault - it is the conservative
  ; boot state, and every real kernel raises it. This monitor never did,
  ; so for a long time every glyph drawn, every block copied and every
  ; CRC computed here ran at 40 percent of the speed available, for
  ; nothing.
  ;
  ; It was found the embarrassing way: the HDMI console was slow enough
  ; to be reported as a fault from the bench, and `i` had been printing
  ; "ARM configured 600000000" at the top of every session for weeks
  ; while nobody read it. A 2.5x speedup was sitting in the output of a
  ; command we ran constantly.
  ;
  ; ClockInit() asks the firmware for its OWN reported maximum rather
  ; than naming a number here - see clocks.pi4:161. The firmware knows
  ; what this board can do, raises the core voltage to match, and clamps
  ; silently if it disagrees, which is why `c` prints APPLIED and then
  ; MEASURED separately.
  ;
  ; IT IS NOT FATAL IF IT FAILS. A board running at 600 MHz is slow, not
  ; broken, and refusing to boot the monitor over it would turn a
  ; performance question into a dead board with no console.
  If ClockInit() = 0
    PrintN("!! the ARM clock could not be raised - running at the firmware's")
    PrintN("   boot speed. Everything here still works, just slower. 'c' shows it.")
  EndIf

  ; TimerInit() does two things and only the second is worth calling
  ; for: it caches CNTFRQ_EL0, which Micros()/millis() would do lazily
  ; anyway, and it WATCHES THE COUNTER MOVE. Having a frequency and
  ; having a running counter are different claims.
  If TimerInit() = 0
    PrintN("!! the architectural counter is not running - every timeout")
    PrintN("   in this monitor is guesswork. Transfers may not time out.")
  EndIf

  ; SAMPLE THE BOOT TICK, and do it here rather than at the top of Main:
  ; TimerInit() has just proved the counter is actually moving, and a
  ; boot stamp taken from a frozen counter would make every later uptime
  ; wrong in the one direction that matters - it would never appear to
  ; reset. CNTPCT_EL0 is cleared by a reboot, so this is zero-based per
  ; boot with nothing to subtract.
  gBootTicks = Ticks()
  WallClockInit()

  ; Two seconds of silence ends a transfer. ubsend.py pauses 4 ms
  ; between records in S-record mode and 600 ms after the command, and
  ; in raw mode it waits on our own acks, so this is generous by two
  ; orders of magnitude in both and still leaves a live prompt when the
  ; host goes away.
  hz = TickHz()
  If hz <= 0 Or hz > 1000000000
    hz = 54000000                ; the BCM2711's counter, as a fallback
  EndIf
  gToTicks = hz + hz

  gBad = 0
  gFail = 0
  gHaveEntry = 0
  gMbx = 0

  ; THE TIMING RECORD, BEFORE THE FIRST THING WORTH TIMING. TimerInit()
  ; above has just proved the counter is moving, which is the one
  ; precondition a table of ticks has. See Board/boot_timing.pi4 - it is
  ; at a fixed address in the display's own reserved window, it survives
  ; the boot it describes, and `screen timing` reads it back.
  BootTimingBegin(hz, ClockMeasuredHz(#MBX_CLK_ARM))

  ScreenEarlyLogStart()
  Banner()

  ; ------------------------------------------------------------------
  ;  THE SCREEN FIRST. THEN THE CONFIGURATION. THEN THE NETWORK.
  ;
  ;  THIS ORDER IS A CHANGE AND IT HAS TO ANSWER THE ONE THAT WAS HERE.
  ;  BootConfigUp() - PCIe, the xHCI host, the USB devices, the boot
  ;  medium and SETTINGS.TXT - used to run FIRST, and the argument was
  ;  sound: the screen is configured hardware, so a screen brought up
  ;  before the store existed could only come up in a default and would
  ;  have to be TORN DOWN AND REBUILT when the real answer arrived,
  ;  erasing the boot log it was brought up early to carry.
  ;
  ;  THE CONCLUSION FOLLOWED FROM TWO THINGS THAT ARE NO LONGER TRUE.
  ;  A geometry change is no longer a teardown: ScrDsiReadoptBegin
  ;  re-points the HVS at its other fixed display list and re-installs
  ;  the drawing surface with the panel still scanning - no power, no
  ;  reset, no DSI host, no pixel valve, no allocation. And the boot log
  ;  no longer lives only on the glass: Anvil/Core/boot_transcript.pbi
  ;  retains the byte stream the console was built from, so a grid
  ;  rebuilt at a new geometry is restored from WHAT WAS SAID rather
  ;  than from pixels that are the wrong shape.
  ;
  ;  WHAT IT BUYS, AND IT IS THE WHOLE POINT: the slow half of the boot
  ;  now PRINTS ON THE PANEL AS IT HAPPENS. USB enumeration and the boot
  ;  medium are the longest things before the radio and they were the
  ;  lines nobody could see. The stated cost of the old order - "the USB
  ;  and boot-medium lines now reach the wire before the glass exists,
  ;  so they are not on the panel" - is paid back here.
  ;
  ;  AND THE COMMON CASE COSTS NOTHING AT ALL. SETTINGS.TXT on this
  ;  bench names no rotation, so the stored answer IS the default and
  ;  ScreenApplyStoredGeometry finds nothing to change.
  ;
  ;  THE NETWORK IS STILL LAST, which is what the original ordering
  ;  really existed for: it is the long, hang-prone half, and a board
  ;  that stalls in the radio says so on the glass.
  ;
  ;  ScreenUp() is never fatal and it CHOOSES: the DSI panel if one
  ;  answered on the display connector, else an HDMI display if the
  ;  firmware found one, else none - and it says which. The prompt
  ;  arrives on the wire either way.
  ;
  ;  NOTHING IN ScreenUp() READS THE SETTINGS STORE FOR ANYTHING BUT
  ;  GEOMETRY. The panel is found over I2C, the firmware is asked over
  ;  the mailbox, and the framebuffers are at fixed addresses this
  ;  monitor chose - so there is nothing here that needs the boot medium
  ;  to have mounted. The two things the store can say, rotation and
  ;  magnification, are exactly the two ScreenApplyStoredGeometry
  ;  corrects below.
  ; ------------------------------------------------------------------
  ; Opt in only for the existing panel/touch boot transactions. Capture is
  ; bounded RAM history, not extra probes; disable retains it for touch trace.
  ScreenDsiEarlyCacheArm()
  I2cTraceEnable(1)
  ScreenUp()
  TouchBoot()
  I2cTraceEnable(0)
  BootTimingMark(#BTM_TOUCH_END, 0, 0)
  ; Paint whatever the pre-screen lines left queued the instant the glass
  ; exists, so the banner is followed by the log rather than by a pause.
  ScreenServiceTick()

  ; The slow half, now with somewhere to print. Every line of it lands on
  ; the panel as it is produced: StorageUp and UsbEnumerate call
  ; ScreenServiceTick themselves (boot.pi4), so this is live progress and
  ; not a buffer flushed at the end.
  BootTimingMark(#BTM_CONFIG_BEGIN, 0, 0)
  BootConfigUp()
  BootTimingMark(#BTM_CONFIG_END, gFatUp, 0)

  ; THE STORE EXISTS NOW. If it names a geometry the default bring-up did
  ; not use, the console moves to it in place and the retained boot log is
  ; replayed into the rebuilt grid. Returns without touching anything when
  ; the stored answer and the default agree.
  ScreenApplyStoredGeometry()
  ScreenServiceTick()

  TimeBoot()
  NtpServiceBoot()
  ; Switch the established surface to the preferred V3D renderer before the
  ; long network bring-up paints its progress. ScreenUp's initial banner is
  ; necessarily drawn once by the CPU/DMA tier because V3D needs that live
  ; surface. Failure is non-fatal: V3dConAutoStart leaves the DMA/CPU
  ; renderer active, which is a readable console and not a degraded one.
  CompilerIf #ANVIL_V3D_CONSOLE = 1
  V3dConAutoStart()
  BootTimingMark(#BTM_V3D_END, gV3dConOn, 0)
  CompilerElse
  BootTimingMark(#BTM_V3D_END, 0, 0)
  CompilerEndIf
  ScreenEarlyLogFinish()
  GenetSetProgressHook(@ScreenServiceTick)
  NetWaitSetProgressHook(@ScreenServiceTick)
  WifiSetProgressHook(@ScreenServiceTick)
  ; Draw whatever is already waiting the instant the glass is up, so the
  ; screen shows it immediately rather than holding it - with the whole
  ; network bring-up behind it - until the first prompt.
  ScreenServiceTick()
  BootTimingMark(#BTM_NET_BEGIN, 0, 0)
  BootNetUp()
  BootTimingMark(#BTM_NET_END, 0, 0)

  ; ------------------------------------------------------------------
  ;  THE DRIVER MODULES, HERE, AND THE POSITION IS THE WHOLE ARGUMENT.
  ;
  ;  AFTER THE CONSOLE so that a refusal is seen. A module that will not
  ;  load is exactly the thing an operator has to be told about, and a
  ;  walk that ran before the glass and the wire were up would print its
  ;  sentences into a buffer nobody reads.
  ;
  ;  BEFORE BootWait() so that a driver is in place before autoboot can
  ;  hand the whole board to a payload. A payload entered with the
  ;  service table is entitled to find the seams a loaded module fills;
  ;  loading them afterwards would mean the same card produced two
  ;  different machines depending on how fast somebody pressed a key.
  ;
  ;  BEFORE FanBoot() for the same reason one step smaller: the fan
  ;  policy reads a temperature, and whether that reading comes off the
  ;  part or out of the firmware is decided by whether THERMAL.MOD
  ;  loaded. Running the walk afterwards would start the fan on the slow
  ;  source and silently keep it there.
  ;
  ;  IT IS NEVER FATAL. No manifest, no module, or a refused module all
  ;  reach the prompt: every seam a module would fill has a core answer
  ;  or an honest refusal behind it.
  ; ------------------------------------------------------------------
  ModBoot()
  ScreenServiceTick()

  ; THE DRAM AUTOBOOT RECORD FIRST, THE PERSISTED BOOT TARGET SECOND, and
  ; the order is the precedence. BootWait() takes `autoboot <addr>`, which
  ; somebody typed at this prompt during THIS power cycle and which lives
  ; in DRAM across a reset; it returns at once when nothing is armed.
  ; BootFileWait() then takes `boot.file` out of the settings store, which
  ; survives a power cycle. The deliberate, just-typed thing wins over the
  ; standing configuration, and on a cold start the DRAM record correctly
  ; fails its magic so the persisted target is what acts.
  BootWait()
  BootFileWait()

  ; THE FAN, LAST, AND AFTER THE SETTINGS ARE IN. FanBoot() resets the
  ; curve to its documented defaults, lets SETTINGS.TXT override what it
  ; names, and starts driving the stored pin if there is one. It is here
  ; rather than in BootBringUp() because the settings load happens in
  ; there and this has to be after it, and because a fan that starts
  ; while PCIe is still enumerating would be a fan running on a
  ; temperature nobody has read yet. It prints one line when a fan is
  ; configured and nothing at all when one is not.
  FanBoot()
  ScreenServiceTick()

  ; THE BOOT LOG ENDS HERE, AND WITH IT THE LAST TIME A BACKGROUND SERVICE
  ; MAY SPEAK ON THE CONSOLE. From the first prompt on, anything that is not
  ; the answer to a typed command goes to the message log instead - see
  ; Anvil/Core/messages.pbi. Everything above this line was the boot, and
  ; stays on every console exactly as before.
  MessagesStart()

  Repeat
    ; "pmf> " IS A PROTOCOL STRING - the five characters, the space
    ; included, and no newline after them. FOUR host tools wait for it:
    ;
    ;   tools/anvil.py     prompt() and setbaud() grep for "pmf>"
    ;   tools/ubsend.py    PROMPTS = (b"U-Boot> ", b"=> ", b"pmf> ") and
    ;                      it matches with tail.endswith(), so THE
    ;                      TRAILING SPACE IS LOAD BEARING - without it
    ;                      the sender never believes it has a prompt and
    ;                      every transfer fails at the first step
    ;   tools/monsession.py waits for b"pmf>" before it types anything
    ;   tools/ubfs.py      uses b"pmf>" to notice Anvil is up and reset
    ;                      into U-Boot
    ;
    ; It is not prose and it is not swept. Do not spell it out, do not
    ; capitalise it, and do not put a newline after it.
    ; ONE ROW, THE FIRST TIME ONLY. The record has a fixed number of rows
    ; and a prompt printed every command would fill it with the least
    ; interesting event in the boot; BootTimingPromptOnce keeps the first.
    BootTimingPromptOnce()
    ; Screen colour is sideband metadata on the primary mirror only. The
    ; five protocol bytes below still reach PL011 and the network tap
    ; unchanged, so every host tool continues to match exact b"pmf> ".
    UartScreenStyle(#UART_SCREEN_STYLE_PROMPT)
    Print("pmf> ")
    UartScreenStyle(#UART_SCREEN_STYLE_NORMAL)
    ; ================================================================
    ;  AND IT HAS TO REACH THE NETWORK CONSOLE TOO.  2026-09-07.
    ;
    ;  MEASURED ON SILICON tonight, over the cable: every command's
    ;  OUTPUT arrived at the laptop and the prompt NEVER DID - not once,
    ;  in any capture. The reason is one line in
    ;  RaspberryPi4/Lib/uart.pi4 (uart_AuxPut): the tap that feeds the
    ;  network console flushes ON A LINE BOUNDARY - `c = 10` - or when
    ;  its ring is nearly full. That rule is right for everything else,
    ;  because flushing per character would put one datagram on the wire
    ;  for every byte of a screenful.
    ;
    ;  "pmf> " HAS NO NEWLINE. That is deliberate and it is stated
    ;  directly above: four host tools match on those five characters
    ;  INCLUDING THE TRAILING SPACE and with nothing after them. So the
    ;  one string the tools wait for is the one string the per-line rule
    ;  can never release, and a console that never delivers it is a
    ;  console those tools cannot drive - `tools/pi4_upload.py --console
    ;  net` gave up with "no Anvil prompt" against a board that was
    ;  answering `version` on that same address in the same second.
    ;
    ;  ONE EXPLICIT FLUSH, HERE, WHERE THE PROTOCOL STRING IS EMITTED.
    ;  Not a change to the per-line rule, which would cost a datagram
    ;  per byte on every long print; and not a special case inside the
    ;  UART, which has no business knowing what a prompt is. It costs
    ;  one call per command line, it is a no-op when no console is armed
    ;  and another when there is no peer, and it is re-entry guarded.
    ; ================================================================
    NetConsoleFlush()
    ; Release only after the command's output and following prompt have
    ; reached its owner; nested ReadLine subprompts retain that owner.
    NetConsoleCommandDone()
    ReadLine()
    ; The line is taken; a command runs under its owner from here, and the
    ; console is not handed to another host until it finishes (forum 888).
    NetConsoleCommandBegin()
    ; Armed AFTER the line is read, so the Enter that submitted it - and
    ; anything typed ahead of it - cannot count as an abort of the
    ; command it is about to start. See STOPPING A LONG PRINT.
    OutBreakArm()
    gPos = 0
    SkipSpace()
    gWordAt = gPos
    c = gLine[gPos] & $FF
    SkipWord()
    gWordLen = gPos - gWordAt

    ; `measure <command line>` - see MEASURE A COMMAND in Core/parse.pbi.
    ; Two call sites, both of them core, because the command chain below
    ; is inline here and there is nothing for a wrapper to re-enter. When
    ; the word moves, the single-letter character moves with it; a refusal
    ; sets that character to zero, which the chain's first arm already
    ; treats as an empty line and runs nothing for.
    Define tmv.i
    tmv = TimeArm()
    If tmv = 1
      c = gLine[gWordAt] & $FF
    ElseIf tmv = 2
      c = 0
    EndIf

    ; ================================================================
    ;  THE WIDTH SUFFIX  -  U-Boot's .b / .w / .l on the command word.
    ;
    ;  U-Boot carries the object size ON THE COMMAND WORD - md.l, mw.w,
    ;  cp.b - and reads it back off argv[0] (v2025.01_cmd_mem.c:143).
    ;  This monitor matches whole words, so a word ending in .b/.w/.l
    ;  would never match "md". Strip it ONCE here, record the width in
    ;  gMemWidth for the handler that is about to run, and shorten
    ;  gWordLen so WordIs sees the bare word. gMemWidth is RESET every
    ;  command so a width cannot leak from one to the next.
    ;
    ;  Only the memory family reads gMemWidth; stripping a .b/.w/.l off
    ;  any other word is harmless because no other command has that
    ;  suffix and the width is simply ignored. A word that is only ".b"
    ;  (gWordLen 2, nothing before the dot) is left alone - it is not a
    ;  suffix on anything.
    ; ================================================================
    gMemWidth = 0
    ; THE SAFETY OVERRIDE AGES HERE, FOR THE SAME REASON gMemWidth IS
    ; RESET HERE: state that leaks from one command into the next is a
    ; trap. `force <address>` arms one address for the NEXT command line
    ; and this is what ends it - used or not, and whether or not the line
    ; in between was even a command this monitor knows. See
    ; Anvil/Core/addrsafe.pbi.
    ForceAge()
    If gWordLen >= 3 And gLine[gWordAt + gWordLen - 2] = 46   ; 46 = '.'
      Define suf.i
      suf = gLine[gWordAt + gWordLen - 1] & $FF
      If suf = 98 Or suf = 66                                 ; b / B
        gMemWidth = 1
      ElseIf suf = 119 Or suf = 87                            ; w / W
        gMemWidth = 2
      ElseIf suf = 108 Or suf = 76                            ; l / L
        gMemWidth = 4
      EndIf
      If gMemWidth <> 0
        gWordLen = gWordLen - 2                               ; hide ".x"
      EndIf
    EndIf

    ; THE WORD FIRST, THE LETTER SECOND. Both reach the same handler;
    ; the word is what a reader of the transcript sees.
    If c = 0
      ; An empty line reprints the prompt and does nothing else.

    ElseIf WordIs("receive") <> 0 Or LetterIs(98) <> 0   ; b
      CmdBlock()

    ; wb - the same, over the air. Two letters, so it cannot collide with
    ; b (LetterIs matches only a one-letter word) and no U-Boot script
    ; types it. The handler always exists; its body is what the radio flag
    ; gates, so this line compiles on a target that has no Wi-Fi.
    ElseIf WordIs("wb") <> 0
      CmdWirelessBlock()

    ; "loads" is what ubsend.py types at U-Boot, and it lands here.
    ElseIf WordIs("srecord") <> 0 Or WordIs("loads") <> 0 Or LetterIs(108) <> 0   ; l
      SrecLoad()

    ; "go" likewise.
    ElseIf WordIs("run") <> 0 Or WordIs("go") <> 0 Or LetterIs(103) <> 0   ; g
      CmdGo()

    ; booti - boot an arm64 Linux Image. bootm - boot a container (a legacy
    ; uImage single kernel, else a loud refusal). Both are whole words, so no
    ; single-letter alias and no collision with run/go. Core handlers in
    ; Anvil/Core/boot_cmd.pbi, gated on #CAP_BOOT_EL1.
    ElseIf WordIs("booti") <> 0
      CmdBooti()

    ElseIf WordIs("bootm") <> 0
      CmdBootm()

    ; boot - THE BOOTLOADER COMMAND, and it is a different job from the
    ; two above rather than a shorter spelling of them. booti and bootm
    ; take an operating system already in memory at an address somebody
    ; typed. `boot <name>` takes a PAYLOAD CONTAINER off the boot medium,
    ; reads the load address, entry point and SHA-256 the compiler put in
    ; it, places the image, proves it, and enters it - with no address
    ; typed anywhere. Core handler in Anvil/Core/pmfboot.pbi, gated on
    ; #CAP_STORAGE except for `boot mem`, which touches no medium.
    ElseIf WordIs("boot") <> 0
      CmdBoot()

    ; "md" IS U-BOOT'S NAME FOR THIS and it is dispatched. The help text
    ; has said "coming from U-Boot: md is memory" for as long as the memory
    ; family has existed, and mw, cmp and cp were all wired up as aliases -
    ; md alone was not, so the one U-Boot spelling the help named FIRST was
    ; the one that did not work. A transcript pasted out of a U-Boot session
    ; got "? unknown command" on its first line.
    ElseIf WordIs("memory") <> 0 Or WordIs("dump") <> 0 Or WordIs("md") <> 0 Or LetterIs(109) <> 0   ; m
      CmdMem()

    ; readback - the same range, for a MACHINE instead of a person. No
    ; single-letter alias and no U-Boot spelling, because U-Boot has no
    ; such command: it is base64 with a byte count and a crc32 on the
    ; last line, and the payload goes to whichever console typed the
    ; line rather than to all of them. See Anvil/Core/readback.pbi for
    ; the measurement that produced it.
    ElseIf WordIs("readback") <> 0
      CmdReadback()

    ElseIf WordIs("write") <> 0 Or WordIs("poke") <> 0 Or LetterIs(119) <> 0   ; w
      CmdWrite()

    ; THE MEMORY FAMILY, from RaspberryPi4/Reference/v2025.01_cmd_mem.c.
    ; Anvil's word first and U-Boot's spelling as an alias, so a
    ; transcript copied out of U-Boot still runs. None of these can
    ; collide with the single letters above: LetterIs only matches a
    ; word of length one.
    ElseIf WordIs("compare") <> 0 Or WordIs("cmp") <> 0
      CmdCompare()

    ElseIf WordIs("copy") <> 0 Or WordIs("cp") <> 0
      CmdCopy()

    ElseIf WordIs("crc32") <> 0 Or WordIs("checksum") <> 0
      CmdCrc32()

    ; THE CRYPTOGRAPHIC CHECKSUMS, from U-Boot's hash family. Same job as
    ; crc32 with a stronger function underneath - the digest a published
    ; image is checked against - riding Lib/sha1.pi4 and Lib/sha256.pi4.
    ElseIf WordIs("sha1sum") <> 0
      CmdSha1sum()

    ElseIf WordIs("sha256sum") <> 0
      CmdSha256sum()

    ; THE CRYPTO SELF-TEST. A whole word, no single-letter alias and no
    ; abbreviation: it is the command that says whether this board's
    ; cryptography is right, and a transcript of it is evidence, so the
    ; word in the transcript should be the word. Core handler in
    ; Anvil/Core/crypto_cmd.pbi; it gates on nothing at all, because
    ; every module it drives is pure computation over .bss.
    ElseIf WordIs("crypto") <> 0
      CmdCrypto()

    ElseIf WordIs("fill") <> 0 Or WordIs("mw") <> 0
      CmdFill()

    ; mm / nm - interactive memory modify, U-Boot's own names (whole
    ; words already, so no alias needed). mm auto-increments, nm holds.
    ; Both honour the .b/.w/.l width the SUFFIX block set. See ModMem in
    ; memcmd.pi4 for how the sub-prompt escapes.
    ElseIf WordIs("mm") <> 0
      CmdMm()

    ElseIf WordIs("nm") <> 0
      CmdNm()

    ; mtest - destructive RAM test. U-Boot's name. Requires an explicit
    ; range inside a payload window and says so; see CmdMtest.
    ElseIf WordIs("mtest") <> 0
      CmdMtest()

    ElseIf WordIs("base") <> 0
      CmdBase()

    ; force - arm one address the board refused, for the next command
    ; line only. NO SINGLE-LETTER ALIAS and no abbreviation, deliberately:
    ; this is the confirmation step for an access that can take a board
    ; down, and a one-character way to type it would be exactly the
    ; accident it exists to prevent. See Anvil/Core/addrsafe.pbi.
    ElseIf WordIs("force") <> 0
      CmdForce()

    ; The settings store, and the two Wi-Fi keys over it. These are what
    ; U-Boot's printenv / setenv / saveenv were for; they are NOT
    ; accepted as aliases, because setenv's argument shape is different
    ; enough that the alias would be a trap rather than a convenience.
    ElseIf WordIs("settings") <> 0
      CmdSettings()

    ElseIf WordIs("wifi") <> 0
      CmdWifi()

    ; THE U-BOOT ENV NAMES over the same settings store. These ARE
    ; accepted as aliases, unlike the memory family's setenv note that
    ; used to live here: printenv/setenv/saveenv take the same
    ; name-then-value shape settings set does, so a line pasted out of a
    ; U-Boot session runs and does the right thing. The two places
    ; U-Boot and Anvil differ - setenv-with-no-value, and secret masking
    ; - are handled by SAYING SO inside the handlers, not by a surprise.
    ; See CmdEnvSet / CmdEnvPrint in settings_cmd.pi4.
    ElseIf WordIs("printenv") <> 0
      CmdEnvPrint()

    ElseIf WordIs("setenv") <> 0
      CmdEnvSet()

    ElseIf WordIs("saveenv") <> 0
      CmdSettingsSave()

    ElseIf WordIs("env") <> 0
      CmdEnv()

    ; The cursor sensitivity, live. See CmdMouse - it is a feel found at
    ; the bench, so it is a command and not a rebuild.
    ElseIf WordIs("mouse") <> 0
      CmdMouse()

    ; THE NETWORK. No U-Boot aliases here, and that is a ruling rather
    ; than an omission: U-Boot's tftpboot and tftpput take the address
    ; first and the filename second, and get and put take the name first
    ; to match this monitor's own load and save. An alias that accepted a
    ; U-Boot line and did something else with it would be a trap, which
    ; is the same reason setenv is not accepted for settings set.
    ElseIf WordIs("net") <> 0
      CmdNet()

    ElseIf WordIs("get") <> 0
      CmdGet()

    ElseIf WordIs("put") <> 0
      CmdPut()

    ; ping, dns and dhcp are Core (Anvil/Core/net_cmd.pbi) and gate on
    ; #CAP_NET through RequireCap, so these three lines compile and
    ; dispatch on every board and refuse cleanly on one with no network.
    ; No reserved-word collision: `run` is go, and none of these is it.
    ElseIf WordIs("ping") <> 0
      CmdPing()

    ElseIf WordIs("dns") <> 0
      CmdDns()

    ElseIf WordIs("dhcp") <> 0
      CmdDhcp()

    ; tcp and http get are Core too (Anvil/Core/tcp_cmd.pbi) and gate on
    ; #CAP_NET the same way. `http get` is the smoke test for everything
    ; underneath it: a real server, a real handshake, a real close.
    ElseIf WordIs("tcp") <> 0
      CmdTcp()

    ElseIf WordIs("http") <> 0
      CmdHttp()

    ElseIf WordIs("uptime") <> 0 Or WordIs("up") <> 0
      CmdUptime()

    ; What background services reported. They never print on the command
    ; line; this is where they are read (Anvil/Core/messages.pbi).
    ElseIf WordIs("messages") <> 0
      CmdMessages()

    ; THE PORTABLE CONSOLE/FLOW COMMANDS, from U-Boot. Hardware-agnostic,
    ; so they live in Anvil/Core/flow_cmd.pbi and every board that builds
    ; the core gets them. echo and version keep their U-Boot names; sleep
    ; is interruptible here because this board's recovery story is that
    ; the prompt stays reachable.
    ElseIf WordIs("echo") <> 0
      CmdEcho()

    ElseIf WordIs("sleep") <> 0
      CmdSleep()

    ElseIf WordIs("version") <> 0 Or WordIs("ver") <> 0
      CmdVersion()

    ; setexpr - evaluate an expression into the settings store. The expr
    ; corner of U-Boot's flow family; see CmdSetexpr in flow_cmd.pi4.
    ElseIf WordIs("setexpr") <> 0
      CmdSetexpr()

    ; map - the memory map as the running image measures it. Core, chip-free,
    ; no capability: every board can say where it put itself. A whole word
    ; only; m is the memory dump. See CmdMap in Anvil/Core/memcmd.pbi for
    ; why it is a command of its own and not a section of `info`.
    ElseIf WordIs("map") <> 0
      CmdMap()

    ElseIf WordIs("info") <> 0 Or WordIs("board") <> 0 Or LetterIs(105) <> 0   ; i
      CmdInfo()

    ElseIf WordIs("time") <> 0
      CmdTime()
    ElseIf WordIs("clock") <> 0 Or LetterIs(99) <> 0   ; c
      CmdClock()

    ElseIf WordIs("autoboot") <> 0 Or LetterIs(97) <> 0   ; a
      CmdAuto()

    ElseIf WordIs("mount") <> 0 Or WordIs("fatload") <> 0 Or WordIs("load") <> 0 Or LetterIs(102) <> 0   ; f
      CmdFat()

    ; fatls / ls - list the mounted FAT root directory. Core logic, gated
    ; on #CAP_STORAGE through RequireCap (Anvil/Hal/hal.pbi), so this same
    ; line compiles and dispatches on a board with no storage, where it
    ; degrades to the honest "not available" refusal. ls is the generic
    ; front-end name U-Boot uses; both land in the same handler.
    ElseIf WordIs("fatls") <> 0 Or WordIs("ls") <> 0
      CmdFatls()

    ; cat - print a small text file off the boot medium without loading
    ; it into a payload window. Core logic, gated on #CAP_STORAGE through
    ; RequireCap like fatls above, and it reads and never writes. It
    ; exists because reading four lines of configuration out of a hex
    ; dump is how a character gets transcribed wrongly.
    ElseIf WordIs("cat") <> 0
      CmdCat()

    ElseIf WordIs("baud") <> 0
      CmdBaud()

    ElseIf WordIs("save") <> 0
      CmdSave()

    ; mkdir / rm / rename - directory-level changes on the storage medium,
    ; write-gated through the same seam as save. Whole words only: md is
    ; the memory dump. See Anvil/Core/fs_cmd.pbi.
    ElseIf WordIs("mkdir") <> 0
      CmdMkdir()
    ElseIf WordIs("rmdir") <> 0
      CmdRmdir()
    ElseIf WordIs("rm") <> 0 Or WordIs("del") <> 0
      CmdRemove()
    ElseIf WordIs("rename") <> 0 Or WordIs("mv") <> 0
      CmdRename()

    ElseIf WordIs("reset") <> 0 Or WordIs("reboot") <> 0 Or LetterIs(114) <> 0   ; r
      CmdReset()

    ; The D-cache switch. No single-letter alias - c is clock - so it is
    ; a whole word only. Caches are off at boot; see CmdCache.
    ElseIf WordIs("cache") <> 0
      CmdCache()

    ; gpio - report the pins. A whole word only, no single-letter alias -
    ; g is go. The handler is Core and gates on #CAP_GPIO through
    ; RequireCap, so this same line compiles and dispatches on a board with
    ; no GPIO, where it degrades to the honest "not available" refusal.
    ElseIf WordIs("gpio") <> 0
      CmdGpio()

    ; i2c - talk to devices on the header I2C bus. A whole word only, no
    ; single-letter alias. Core and gates on #CAP_I2C through RequireCap, so
    ; this line compiles and dispatches on a board with no I2C too, where it
    ; degrades to the honest "not available" refusal.
    ElseIf WordIs("i2c") <> 0
      CmdI2c()

    ; touch - the DSI panel's touch controller and its power MCU. A whole
    ; word only; t is not free, and this family is not worth a letter
    ; before it has answered a real panel once. The handler is this
    ; board's own (Board/touch_cmd.pi4), so unlike every arm around it
    ; there is no RequireCap: a board without the include does not have
    ; the command at all.
    ElseIf WordIs("touch") <> 0
      CmdTouch()
    ; dsi - the other half of the same ribbon: the SoC's DSI1 host, the
    ; panel's own init table, and the HVS and pixel valve behind them.
    ; A whole word only; d is dump. This board's own, so no RequireCap.
    ElseIf WordIs("dsi") <> 0
      CmdDsi()
    ; mmio - ONE 32-bit load. It exists because `memory` reads BYTES and
    ; the peripheral blocks on this part answer a sub-word read with a
    ; block-identity string, so `memory.l` over MMIO returns a plausible
    ; register dump that is not one. It reads and never writes.
    ElseIf WordIs("mmio") <> 0
      CmdMmio()
    ; fan - the fan policy. A whole word only, no single-letter alias -
    ; f is fatload. Core and gates on #CAP_PWM through RequireCap, so this
    ; line compiles and dispatches on a board with no modulator and no
    ; thermometer too, where it degrades to the honest refusal.
    ElseIf WordIs("fan") <> 0
      CmdFan()

    ; mod - the driver-module loader. A whole word only and no
    ; single-letter alias: m is memory and d is deadman, and a monitor
    ; that guesses which destructive command a letter meant is not one
    ; anybody should trust. The handler is Core; the board supplies the
    ; arena, the cache maintenance and the device list.
    ElseIf WordIs("mod") <> 0
      CmdMod()

    ; mmc - raw SD/eMMC block access. Core, gates on #CAP_MMC through
    ; RequireCap, so this same line compiles and dispatches on a board with
    ; no card controller, where it degrades to the honest refusal.
    ElseIf WordIs("mmc") <> 0
      CmdMmc()

    ; usb - USB diagnostics. A whole word only, no single-letter alias.
    ; The handler is Core and gates on #CAP_USB through RequireCap, so this
    ; same line compiles and dispatches on a board with no USB host, where
    ; it degrades to the honest "not available" refusal.
    ElseIf WordIs("usb") <> 0
      CmdUsb()

    ; `font` owns bounded file slots and reports/selects the active
    ; TrueType face. The Vulkan and framebuffer renderers consume that same
    ; selected memory face when their screen backend is active.
    ElseIf WordIs("font") <> 0
      CmdFont()

    ; EL3 acceptance is never a boot side effect.  The whole word, exact
    ; arity and explicit transcript make a timer interrupt or controlled BRK
    ; impossible to trigger through an abbreviation or a mistyped tail.
    ElseIf WordIs("el3test") <> 0
      SkipSpace()
      If gLine[gPos] <> 0
        PrintN("? el3test takes no arguments; nothing was tested.")
      Else
        CmdEl3Accept()
      EndIf

    ; Resident multicore acceptance has an intentionally small grammar.
    ; A bare word is read-only status. `run` owns cores 1..3 until restart;
    ; `stop` parks them permanently and still retains that ownership.
    ElseIf WordIs("coretest") <> 0
      SkipSpace()
      gWordAt = gPos
      SkipWord()
      gWordLen = gPos - gWordAt
      If gWordLen = 0
        CmdCoreAcceptStatus()
      Else
        SkipSpace()
        If gLine[gPos] <> 0
          PrintN("? coretest takes exactly run, stop, status, or no argument.")
        ElseIf WordIs("run") <> 0
          CmdCoreAcceptRun()
        ElseIf WordIs("stop") <> 0
          CmdCoreAcceptStop()
        ElseIf WordIs("status") <> 0
          CmdCoreAcceptStatus()
        Else
          PrintN("? coretest takes run, stop, status, or no argument.")
        EndIf
      EndIf

    ElseIf WordIs("deadman") <> 0 Or LetterIs(100) <> 0   ; d
      CmdDeadman()

    ; last run - what happened to the last payload: returned and with what,
    ; stopped at an exception, or reset underneath by the deadman. Two whole
    ; words and no letter; a host whose return line was lost asks this.
    ElseIf WordIs("last") <> 0
      SkipSpace()
      gWordAt = gPos
      SkipWord()
      gWordLen = gPos - gWordAt
      SkipSpace()
      If WordIs("run") <> 0 And gLine[gPos] = 0
        CmdLastRun()
      Else
        PrintN("? last takes exactly one word: last run.")
      EndIf

    ; trail - the boot trail, this boot's and the previous one's, one step
    ; per line with its millisecond (forum 880). A whole word, no letter.
    ElseIf WordIs("trail") <> 0
      CmdTrail()

    ; shot - the KEPT picture: the capture area, not the live screen.
    ; A whole word only and no single letter - s is screen and p is the
    ; live screenshot, and a monitor that guesses which of three screen
    ; commands a letter meant is not one anybody should trust. It comes
    ; before pr and p for no reason but that the three belong together;
    ; WordIs matches whole words, so the order does not decide anything.
    ElseIf WordIs("shot") <> 0
      CmdShot()

    ; pr - the RELIABLE screenshot, for the wireless console: the same
    ; picture as p, but as acknowledged binary datagrams with a CRC, so a
    ; busy screen survives the air. tools/pmfshot_wifi.py speaks it.
    ElseIf WordIs("pr") <> 0
      CmdPicR()

    ; screenshot BEFORE screen, and WordIs matches whole words anyway -
    ; belt and braces, because getting this pair the wrong way round
    ; would photograph the screen every time somebody turned it on.
    ElseIf WordIs("screenshot") <> 0 Or LetterIs(112) <> 0   ; p
      CmdPic()

    ElseIf WordIs("screen") <> 0 Or LetterIs(115) <> 0   ; s
      CmdScreen()

    ; "?" IS DISPATCHED HERE, and this is the second time it has had to be
    ; fixed. The help text advertised "[h, ?, commands]" while this line
    ; read  Or LetterIs(104) <> 0   ; h Or c = 63  - the comment named the
    ; question mark and the CONDITION never tested for it, so "?" fell
    ; through to the unknown-command arm and answered "? unknown command
    ; - type help. (?)". An earlier pass found the same drift and fixed it
    ; by deleting the claim from the help; it came back, because "?" is
    ; the first thing anybody types at an unfamiliar prompt.
    ;
    ; 63 is the question mark. This language has no character literals, so
    ; the code is passed and the character is named in the comment - see
    ; LetterIs(). LetterIs only matches a word of exactly one character,
    ; so this cannot collide with anything else.
    ElseIf WordIs("help") <> 0 Or WordIs("commands") <> 0 Or LetterIs(104) <> 0 Or LetterIs(63) <> 0   ; h, ?
      Help()
      PrintNl()
      PrintN("PI 4 EL3 ACCEPTANCE")
      PrintN("  el3test              one bounded secure-timer IRQ, then one controlled BRK")
      PrintN("  coretest status      resident secondary-core ownership and last result")
      PrintN("  coretest run         16 coherent job rounds on cores 1, 2 and 3")
      PrintN("  coretest stop        acknowledge and permanently park those workers")
      PrintN("These are explicit diagnostics, never boot actions. After coretest run,")
      PrintN("restart before changing cache policy or entering a payload.")

    Else
      ; ECHO WHAT WAS ACTUALLY TYPED. "unknown command" with no subject is
      ; the least useful thing a prompt can say, and it is the one that
      ; hides a line editor that dropped or mangled a character.
      Define k.i
      Print("? this monitor does not know the command ")
      k = 0
      While k < gWordLen And k < 24
        UartWrite(gLine[gWordAt + k] & $FF)
        k = k + 1
      Wend
      PrintN(", so nothing was done.")
      PrintN("  Type help, or just a question mark, for the list of commands.")
      PrintN("  Every command is a whole word; the old single letters still work.")
    EndIf
    ; What the command above cost, on this board's own counter, if the
    ; line began with `measure`. Silent otherwise.
    TimeReport()
  ForEver
EndProcedure

Main()
