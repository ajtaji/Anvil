; Resident Vulkan endpoint for the shared console grid.
;
; The console core remains the sole owner of output draining and model state.
; This file owns the Vulkan target/Chrome lifetime and paints the already
; drained grid when registered through ConSetRenderer(). It does not install
; a second text engine: NeonVkChrome's callback family backs the same Neon
; widget/text calls used by the V3D renderer.

XIncludeFile "Anvil/Graphics/Vulkan/neon_vk_present_target.pbi"
XIncludeFile "Anvil/Graphics/Vulkan/neon_vk_service_targets.pbi"
XIncludeFile "Anvil/Graphics/Vulkan/neon_vk_service_caret.pbi"
Global avcWsiMain.NeonVkPresentTarget, avcWsiBanner.NeonVkPresentTarget
Global avcWsiPresentN.i
Global avcSurfaceQueryN.i
Global avcBanImage.i, avcBanMemory.i, avcBanView.i, avcBanFramebuffer.i
Global avcBanBase.i, avcBanPitch.i, avcBanW.i, avcBanH.i, avcBanReady.i
Global avcBanLastClock.i = -1, avcBanLastGlint.i = -2, avcBanShown.i


#AVC_OK                 = 0
#AVC_ERR_DISPLAY        = -22101
#AVC_ERR_V3D            = -22102
#AVC_ERR_WINDOW         = -22103
#AVC_ERR_VK              = -22104
#AVC_ERR_TARGET         = -22105
#AVC_ERR_CHROME         = -22106
#AVC_ERR_PRESENT        = -22107
#AVC_WINDOW_BASE        = #MON_VK_HEAP_LO
#AVC_WINDOW_BYTES       = #MON_VK_HEAP_BYTES
#AVC_ARENA_BASE         = $0A000000
#AVC_ARENA_BYTES        = $01000000
#AVC_MAX_DRAWS          = #NEON_VK_CHROME_MAX_QUADS
#AVC_UI_QUAD_RESERVE    = 512
; The vertex heap is sized for actual visible ink, not the maximum byte-grid
; storage. Reserving every possible byte cell would waste the 16 MiB GPU heap.
#AVC_MAX_QUADS          = 20992     ; the console's own vertex budget (3,022,848 bytes); not the adapter's ceiling

Global avcReady.i
Global avcActive.i
Global avcQuarantined.i
Global avcDeviceUnsafe.i
Global avcDisplayCopyPending.i    ; a failed copy may still reference its source
Global avcNeonAllowed.i = 1
Global avcError.i
; Failure stage and original Chrome error survive checked resource teardown.
Global avcPresentStage.i, avcLastFailStage.i, avcLastFailReason.i, avcLastFailChrome.i
Global avcInstance.i
Global avcPhysical.i
Global avcDevice.i
Global avcQueue.i
Global avcPool.i
Global avcImage.i
Global avcMemory.i
Global avcView.i
Global avcRenderPass.i
Global avcFramebuffer.i
Global avcImageBase.i
Global avcImagePitch.i
Global avcImageBytes.i
Global avcWidth.i
Global avcHeight.i
Global avcLogicalW.i
Global avcLogicalH.i
Global avcPitch.i
Global avcRotation.i
Global avcUiHeight.i
Global avcFallbackPaint.i
Global avcBannerFrameReady.i
Global avcFramePresented.i
Global avcPayloadWasActive.i
; A resident application borrows this owner's target, never a second driver.
Global avsContext.i, avsEpoch.i, avsReady.i, avsFrame.i, avsFontCount.i, avsError.i
Global Dim avsFont.NeonVkPortFontRef[32]
Global Dim avsSprite.NeonVkPortSpriteRef[#NEON_SERVICE_MAX_SPRITES]
Global Dim avsSpriteHandle.i[#NEON_SERVICE_MAX_SPRITES]
Global avsSpriteClock.i,avsBatch.i
Global Dim avsOwnedFont.i[#NEON_SERVICE_MAX_FONT_ASSETS]
Global avsPreviousFont.i=-1,avsPreviousFontGeneration.i
Global avsParticleReady.i,avsParticleCount.i
Global avsParticleCameraX.f,avsParticleCameraY.f,avsParticleCameraZoom.f
; Diagnostic ticks for the latest resident application. No payload ABI change.
; End stages: GPU completion/publication, DMA, cache clean, display flip, other,
; and total. Totals and the worst complete End survive Close for vkstat.
Global avcCopyDmaTicks.i,avcCopyCleanTicks.i,avcCopyPublishTicks.i
Global avsEndFrames.i,avsEndFailed.i,avsEndWorstFrame.i,avsEndWorstRc.i
Global Dim avsEndTotal.i[6]
Global Dim avsEndWorst.i[6]
Global Dim avcClear.l[4]
Global Dim avcGlyph.a[2]
Global Dim avcGridGlyphs.l[#NEON_VK_CHROME_TT_CACHE_MAX]
Global Dim avcLayoutGlyph.i[#CON_MAXCOLS]
Global Dim avcLayoutX.i[#CON_MAXCOLS]
Global Dim avcLayoutY.i[#CON_MAXCOLS]
Global Dim avcLayoutAdvance.i[#CON_MAXCOLS]

; THE BANNER CHANGES EVERY SECOND (the clock) AND EVERY 350 ms WHILE THE LOGO
; GLINTS, AND THE TEXT UNDER IT DOES NOT. This used to mark the whole grid, so
; each tick laid out every line of TrueType text again, rebuilt every glyph
; quad and copied the full four-megabyte frame: 38% of core 0 at a quiet
; prompt on build 248, against 4% for the native V3D console. A banner change
; now asks for a frame that holds the banner alone; the pump copies only the
; banner strip to the display and the text on the glass is left as it is.
Global avcBannerDirty.i
Declare avcDestroyBannerTarget()
Declare.i avcCreateBannerTarget()
; Where a console frame's time goes, counted on the board's own counter since
; the last `vkstat`: [0] building the frame on the processor, [1] submitting it
; and waiting for the GPU, [2] copying it to the display. Banner-only frames
; and whole frames are kept apart.
Global Dim avcStatBanner.i[3]
Global Dim avcStatFull.i[3]
Global avcStatBannerN.i, avcStatFullN.i, avcStatSince.i, avcStatBeginTicks.i

Procedure avcBannerInvalidate()
  avcBannerDirty = 1
  gConDirty = 1                 ; wakes ScreenPump; no row is marked
EndProcedure

; 1 when the text grid itself has something to repaint.
Procedure.i avcGridNeedsPaint()
  Define r.i
  If ConGridFullClear() <> 0 : ProcedureReturn 1 : EndIf
  For r = 0 To ConGridRows() - 1
    If ConGridRowDirty(r) <> 0 : ProcedureReturn 1 : EndIf
  Next
  ProcedureReturn 0
EndProcedure

Procedure.i VulkanConsoleError()
  ProcedureReturn avcError
EndProcedure

; Validate public surface metadata against this real provider-owned source.
Procedure.i avcCheckPublicSurface(*target.NeonVkPresentTarget, width.i, height.i)
  Define caps.VkSurfaceCapabilitiesKHR, format.VkSurfaceFormatKHR
  Define count.i, supported.i, mode.i, rc.i
  supported = 0
  rc = vkGetPhysicalDeviceSurfaceSupportKHR(avcPhysical, 0, *target\surface, @supported)
  If rc <> #VK_SUCCESS : ProcedureReturn rc : EndIf
  If supported <> 1 : ProcedureReturn #AVC_ERR_PRESENT : EndIf
  rc = vkGetPhysicalDeviceSurfaceCapabilitiesKHR(avcPhysical, *target\surface, @caps)
  If rc <> #VK_SUCCESS : ProcedureReturn rc : EndIf
  If caps\currentExtent\width <> width Or caps\currentExtent\height <> height
    ProcedureReturn #AVC_ERR_PRESENT
  EndIf
  count = 1
  rc = vkGetPhysicalDeviceSurfaceFormatsKHR(avcPhysical, *target\surface, @count, @format)
  If rc <> #VK_SUCCESS : ProcedureReturn rc : EndIf
  If count <> 1 Or format\format <> #VK_FORMAT_B8G8R8A8_UNORM Or format\colorSpace <> 0
    ProcedureReturn #AVC_ERR_PRESENT
  EndIf
  count = 1 : mode = 0
  rc = vkGetPhysicalDeviceSurfacePresentModesKHR(avcPhysical, *target\surface, @count, @mode)
  If rc <> #VK_SUCCESS : ProcedureReturn rc : EndIf
  If count <> 1 Or mode <> #VK_PRESENT_MODE_FIFO_KHR : ProcedureReturn #AVC_ERR_PRESENT : EndIf
  avcSurfaceQueryN = avcSurfaceQueryN + 1
  ProcedureReturn #VK_SUCCESS
EndProcedure

Procedure.i avcCreateTarget()
  Define rc.i
  Define count.i
  Define priority.l
  Define surfaceName.i
  Define ici.VkInstanceCreateInfo
  Define qci.VkDeviceQueueCreateInfo
  Define dci.VkDeviceCreateInfo
  Define pci.VkCommandPoolCreateInfo
  Define imageInfo.VkImageCreateInfo
  Define imageProps.VkImageFormatProperties
  Define formatProps.VkFormatProperties
  Define req.VkMemoryRequirements
  Define alloc.VkMemoryAllocateInfo
  Define viewInfo.VkImageViewCreateInfo
  Define attachment.VkAttachmentDescription
  Define attachmentRef.VkAttachmentReference
  Define subpass.VkSubpassDescription
  Define passInfo.VkRenderPassCreateInfo
  Define frameInfo.VkFramebufferCreateInfo
  Define mapped.i

  If NeonGpuRangeMapped(#AVC_WINDOW_BASE, #AVC_WINDOW_BYTES) = 0
    ProcedureReturn #AVC_ERR_WINDOW
  EndIf
  If AnvilVkV3dWindow(#AVC_WINDOW_BASE, #AVC_WINDOW_BYTES) <> #VK_SUCCESS
    ProcedureReturn #AVC_ERR_WINDOW
  EndIf
  ici\sType = #VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO
  If gScrSrc = #SCR_SRC_DSI
    surfaceName = avkSurfaceExtensionName()
    ici\enabledExtensionCount = 1 : ici\ppEnabledExtensionNames = @surfaceName
  EndIf
  rc = vkCreateInstance(@ici, 0, @avcInstance)
  If rc <> #VK_SUCCESS : ProcedureReturn #AVC_ERR_VK : EndIf
  count = 1
  rc = vkEnumeratePhysicalDevices(avcInstance, @count, @avcPhysical)
  If rc <> #VK_SUCCESS Or count <> 1 Or avcPhysical = 0 : ProcedureReturn #AVC_ERR_VK : EndIf

  priority = 0
  qci\sType = #VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO
  qci\queueCount = 1 : qci\pQueuePriorities = @priority
  dci\sType = #VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO
  dci\queueCreateInfoCount = 1 : dci\pQueueCreateInfos = @qci
  rc = vkCreateDevice(avcPhysical, @dci, 0, @avcDevice)
  If rc <> #VK_SUCCESS : ProcedureReturn #AVC_ERR_VK : EndIf
  vkGetDeviceQueue(avcDevice, 0, 0, @avcQueue)
  pci\sType = #VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO
  pci\flags = #VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT
  rc = vkCreateCommandPool(avcDevice, @pci, 0, @avcPool)
  If rc <> #VK_SUCCESS : ProcedureReturn #AVC_ERR_VK : EndIf

  vkGetPhysicalDeviceFormatProperties(avcPhysical, #VK_FORMAT_B8G8R8A8_UNORM, @formatProps)
  If (formatProps\linearTilingFeatures & #VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT) = 0
    ProcedureReturn #AVC_ERR_TARGET
  EndIf
  rc = vkGetPhysicalDeviceImageFormatProperties(avcPhysical, #VK_FORMAT_B8G8R8A8_UNORM, #VK_IMAGE_TYPE_2D, #VK_IMAGE_TILING_LINEAR, #VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | #VK_IMAGE_USAGE_TRANSFER_SRC_BIT, 0, @imageProps)
  If rc <> #VK_SUCCESS Or imageProps\maxExtent\width < avcWidth Or imageProps\maxExtent\height < avcHeight
    ProcedureReturn #AVC_ERR_TARGET
  EndIf

  imageInfo\sType = #VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO
  imageInfo\imageType = #VK_IMAGE_TYPE_2D
  imageInfo\format = #VK_FORMAT_B8G8R8A8_UNORM
  imageInfo\extent\width = avcWidth : imageInfo\extent\height = avcHeight : imageInfo\extent\depth = 1
  imageInfo\mipLevels = 1 : imageInfo\arrayLayers = 1
  imageInfo\samples = #VK_SAMPLE_COUNT_1_BIT
  imageInfo\tiling = #VK_IMAGE_TILING_LINEAR
  imageInfo\usage = #VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | #VK_IMAGE_USAGE_TRANSFER_SRC_BIT
  imageInfo\sharingMode = #VK_SHARING_MODE_EXCLUSIVE
  imageInfo\initialLayout = #VK_IMAGE_LAYOUT_UNDEFINED
  rc = vkCreateImage(avcDevice, @imageInfo, 0, @avcImage)
  If rc <> #VK_SUCCESS : ProcedureReturn #AVC_ERR_TARGET : EndIf
  vkGetImageMemoryRequirements(avcDevice, avcImage, @req)
  If req\size <= 0 Or req\size > #AVC_WINDOW_BYTES Or imageProps\maxResourceSize < req\size
    ProcedureReturn #AVC_ERR_TARGET
  EndIf
  alloc\sType = #VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO
  alloc\allocationSize = req\size : alloc\memoryTypeIndex = 0
  rc = vkAllocateMemory(avcDevice, @alloc, 0, @avcMemory)
  If rc = #VK_SUCCESS : rc = vkBindImageMemory(avcDevice, avcImage, avcMemory, 0) : EndIf
  If rc <> #VK_SUCCESS : ProcedureReturn #AVC_ERR_TARGET : EndIf
  avcImageBase = AnvilVkImageAddress(avcImage)
  avcImagePitch = AnvilVkImageRowPitch(avcImage)
  avcImageBytes = req\size
  If avcImageBase = 0 Or avcImagePitch < avcWidth * 4 Or avcImagePitch * avcHeight > req\size
    ProcedureReturn #AVC_ERR_TARGET
  EndIf
  mapped = 0
  rc = vkMapMemory(avcDevice, avcMemory, 0, #VK_WHOLE_SIZE, 0, @mapped)
  If rc <> #VK_SUCCESS Or mapped <> avcImageBase : ProcedureReturn #AVC_ERR_TARGET : EndIf
  vkUnmapMemory(avcDevice, avcMemory)

  viewInfo\sType = #VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO
  viewInfo\image = avcImage : viewInfo\viewType = #VK_IMAGE_VIEW_TYPE_2D
  viewInfo\format = #VK_FORMAT_B8G8R8A8_UNORM
  viewInfo\subresourceRange\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT
  viewInfo\subresourceRange\levelCount = 1 : viewInfo\subresourceRange\layerCount = 1
  rc = vkCreateImageView(avcDevice, @viewInfo, 0, @avcView)
  If rc <> #VK_SUCCESS : ProcedureReturn #AVC_ERR_TARGET : EndIf

  attachment\format = #VK_FORMAT_B8G8R8A8_UNORM
  attachment\samples = #VK_SAMPLE_COUNT_1_BIT
  attachment\loadOp = #VK_ATTACHMENT_LOAD_OP_CLEAR
  attachment\storeOp = #VK_ATTACHMENT_STORE_OP_STORE
  attachment\stencilLoadOp = #VK_ATTACHMENT_LOAD_OP_DONT_CARE
  attachment\stencilStoreOp = #VK_ATTACHMENT_STORE_OP_DONT_CARE
  attachment\initialLayout = #VK_IMAGE_LAYOUT_UNDEFINED
  attachment\finalLayout = #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL
  attachmentRef\attachment = 0 : attachmentRef\layout = #VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL
  subpass\pipelineBindPoint = #VK_PIPELINE_BIND_POINT_GRAPHICS
  subpass\colorAttachmentCount = 1 : subpass\pColorAttachments = @attachmentRef
  passInfo\sType = #VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO
  passInfo\attachmentCount = 1 : passInfo\pAttachments = @attachment
  passInfo\subpassCount = 1 : passInfo\pSubpasses = @subpass
  rc = vkCreateRenderPass(avcDevice, @passInfo, 0, @avcRenderPass)
  If rc <> #VK_SUCCESS : ProcedureReturn #AVC_ERR_TARGET : EndIf
  frameInfo\sType = #VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO
  frameInfo\renderPass = avcRenderPass : frameInfo\attachmentCount = 1
  frameInfo\pAttachments = @avcView : frameInfo\width = avcWidth
  frameInfo\height = avcHeight : frameInfo\layers = 1
  rc = vkCreateFramebuffer(avcDevice, @frameInfo, 0, @avcFramebuffer)
  If rc <> #VK_SUCCESS : ProcedureReturn #AVC_ERR_TARGET : EndIf

  rc = NeonVkChromeCreateWithCapacities(avcPhysical, avcDevice, avcQueue, avcPool, avcRenderPass, avcFramebuffer, avcWidth, avcHeight, #AVC_MAX_DRAWS, #AVC_MAX_QUADS)
  If rc <> #VK_SUCCESS : ProcedureReturn #AVC_ERR_CHROME : EndIf
  rc = NeonVkChromeRebind(avcFramebuffer, avcLogicalW, avcLogicalH, avcWidth, avcHeight, avcPitch, avcRotation)
  If rc <> #VK_SUCCESS : ProcedureReturn #AVC_ERR_CHROME : EndIf
  ProcedureReturn #AVC_OK
EndProcedure

Procedure.i VulkanConsoleDestroy()
  Define idleRc.i
  ; GPU idle says nothing about the display DMA channel. A pending copy was
  ; entered only while DMA was ready, so its selected registers are valid.
  If avcDisplayCopyPending <> 0
    If DmaQuarantined() <> 0
      avcDeviceUnsafe = 1 : ProcedureReturn 0
    EndIf
    If DmaQuiescent() = 0
      avcDeviceUnsafe = 1 : ProcedureReturn 0
    EndIf
    avcDisplayCopyPending = 0
  EndIf
  If ScrFrameRestore() = 0
    avcDeviceUnsafe = 1 : ProcedureReturn 0
  EndIf
  idleRc = #VK_SUCCESS
  If avcDevice <> 0
    idleRc = vkDeviceWaitIdle(avcDevice)
  EndIf
  If idleRc <> #VK_SUCCESS
    avcDeviceUnsafe = 1
    ProcedureReturn 0
  EndIf
  ; Partial/failed Chrome teardown can retain a device while Ready is false.
  ; Do not destroy the caller's target or lend its hardware to a fallback
  ; renderer unless the adapter confirms its own resources were released.
  If avcDevice <> 0
    If NeonVkChromeDestroyChecked() <> #VK_SUCCESS
      avcDeviceUnsafe = 1
      ProcedureReturn 0
    EndIf
  EndIf
  ; Checked Chrome teardown has rolled back any acquired/pending source.
  ; Provider refusal must retain the physical image and every parent handle.
  If NeonVkPresentTargetDestroy(avcInstance, avcDevice, @avcWsiBanner) <> #VK_SUCCESS
    avcDeviceUnsafe = 1 : ProcedureReturn 0
  EndIf
  If NeonVkPresentTargetDestroy(avcInstance, avcDevice, @avcWsiMain) <> #VK_SUCCESS
    avcDeviceUnsafe = 1 : ProcedureReturn 0
  EndIf
  NeonVkChromeLogoSource(0, 0, 0)
  If avcDevice <> 0
    avcDestroyBannerTarget()
    If avcFramebuffer <> 0 : vkDestroyFramebuffer(avcDevice, avcFramebuffer, 0) : EndIf
    If avcRenderPass <> 0 : vkDestroyRenderPass(avcDevice, avcRenderPass, 0) : EndIf
    If avcView <> 0 : vkDestroyImageView(avcDevice, avcView, 0) : EndIf
    If avcImage <> 0 : vkDestroyImage(avcDevice, avcImage, 0) : EndIf
    If avcMemory <> 0 : vkFreeMemory(avcDevice, avcMemory, 0) : EndIf
    If avcPool <> 0 : vkDestroyCommandPool(avcDevice, avcPool, 0) : EndIf
    vkDestroyDevice(avcDevice, 0)
  EndIf
  If avcInstance <> 0 : vkDestroyInstance(avcInstance, 0) : EndIf
  avcInstance = 0 : avcPhysical = 0 : avcDevice = 0 : avcQueue = 0 : avcPool = 0
  avcImage = 0 : avcMemory = 0 : avcView = 0 : avcRenderPass = 0 : avcFramebuffer = 0
  avcImageBase = 0 : avcImagePitch = 0 : avcImageBytes = 0 : avcReady = 0
  ProcedureReturn Bool(idleRc = #VK_SUCCESS)
EndProcedure

; All asynchronous pump failures enter this one-way transition. CPU painting
; is permitted only after both Vulkan idle and resident V3D invalidation prove
; that no device can still own the target. Otherwise leave the screen detached.
Procedure avcCpuCursorRefresh(wasShown.i)
  ; This is deliberately the direct CPU branch of PointerShow. Calling
  ; PointerShow here would make the compiler's callback graph recurse through
  ; ConRepaint -> gConPaint -> VulkanConsolePump -> avcFailover.
  If wasShown = 0 Or DisplayMemorySafe() = 0
    ProcedureReturn
  EndIf
  CursorSave(gCurX, gCurY)
  CursorDraw(gCurX, gCurY)
  gCurShown = 1
EndProcedure

Procedure.i avcFailover(reason.i)
  Define idleSafe.i, v3dSafe.i, hadCursor.i
  avcLastFailStage = avcPresentStage
  avcLastFailReason = reason
  avcLastFailChrome = NeonVkChromeError()
  hadCursor = gCurShown
  If avcError = 0 : avcError = reason : EndIf
  AnvilTrueTypeRasterAlphaHandlerSet(0)
  *gBannerGpuInvalidate = 0
  avcBannerFrameReady = 0
  avcFramePresented = 0
  avcActive = 0
  avcReady = 0
  ConNoRenderer()
  idleSafe = VulkanConsoleDestroy()
  If idleSafe = 0
    avcQuarantined = 1
    avcFallbackPaint = 0
    ProcedureReturn 0
  EndIf
  v3dSafe = V3dConInvalidate()
  avcQuarantined = Bool(v3dSafe = 0)
  If avcQuarantined <> 0
    avcFallbackPaint = 0
    ProcedureReturn 0
  EndIf
  ; Ownership changes only after both idle and invalidation succeeded. An
  ; unsafe quarantine must keep pointer events away from CPU save-under writes.
  gCursorGpuOwned = 0
  gCurShown = 0
  NeonGpuExtraMap(0, 0)
  ; Do not probe the blitter from the console callback: its diagnostics would
  ; re-enter the UART pump. Use the proven CPU framebuffer painter here.
  gDma = 0 : DisplayUseDma(0)
  If avcFallbackPaint = 0 : avcFallbackPaint = @ConPaintDma : EndIf
  If gScreenDeferFirstFrame <> 0
    ConNoRenderer()
    avcFallbackPaint = 0
    ProcedureReturn 1
  EndIf
  If gScreen <> 0
    DisplayClear(gScreenBg) : DrawBanner()
    DisplayConsole(0, LogoHeight(), DisplayWidth(), DisplayHeight() - LogoHeight())
    ConSetRenderer(avcFallbackPaint)
    ConOverlayMarkWhole() : ConGridMarkAll() : ConPaintDma()
    TouchKeyboardComposeCpu()
    ScrPresentAll()
    avcCpuCursorRefresh(hadCursor)
  Else
    ConNoRenderer()
  EndIf
  avcFallbackPaint = 0
  ProcedureReturn 1
EndProcedure

Procedure.i avcStartupFallback(reason.i)
  avcError = reason
  *gBannerGpuInvalidate = 0
  avcBannerFrameReady = 0
  ConNoRenderer()
  If V3dConInvalidate() = 0
    avcQuarantined = 1
    avcFallbackPaint = 0
    ProcedureReturn 0
  EndIf
  avcQuarantined = 0
  NeonGpuExtraMap(0, 0)
  gDma = ScreenDmaUp()
  If gScreenDeferFirstFrame <> 0 : ProcedureReturn 1 : EndIf
  ConSetRenderer(@ConPaintDma) : ConPaintDma() : TouchKeyboardComposeCpu() : ScrPresentAll()
  ProcedureReturn 1
EndProcedure

Procedure.i VulkanConsoleStart()
  Define rc.i
  Define fbBase.i, fbBytes.i
  Define dramBytes.i
  If avcActive <> 0 : ProcedureReturn #AVC_OK : EndIf
  AnvilTrueTypeRasterAlphaHandlerSet(0)
  *gBannerGpuInvalidate = 0
  avcBannerFrameReady = 0
  avcFramePresented = 0
  avcError = 0
  If gScreen = 0 Or DisplayBase() = 0 Or DisplayBytesPerPixel() <> 4
    avcError = #AVC_ERR_DISPLAY
    ProcedureReturn #AVC_ERR_DISPLAY
  EndIf
  If gScrSrc = #SCR_SRC_DSI And gScrRot <> 0 And gScrRot <> 90 And gScrRot <> 180 And gScrRot <> 270
    avcError = #AVC_ERR_DISPLAY : ProcedureReturn #AVC_ERR_DISPLAY
  EndIf
  ; Static reservations are checked in memmap; also check the firmware's
  ; live allocation because HDMI framebuffer addresses are dynamic.
  fbBase = DisplayBase() : fbBytes = DisplaySize()
  If fbBase <= 0 Or fbBytes <= 0
    avcError = #AVC_ERR_DISPLAY : ProcedureReturn #AVC_ERR_DISPLAY
  EndIf
  dramBytes = HwMemoryBytes()
  If dramBytes = #HW_MEM_UNKNOWN Or #AVC_WINDOW_BASE + #AVC_WINDOW_BYTES > dramBytes
    avcError = #AVC_ERR_WINDOW : ProcedureReturn #AVC_ERR_WINDOW
  EndIf
  If HwAddrCheck(#AVC_WINDOW_BASE, #AVC_WINDOW_BASE + #AVC_WINDOW_BYTES - 1, 0) <> #HW_ADDR_SAFE
    avcError = #AVC_ERR_WINDOW : ProcedureReturn #AVC_ERR_WINDOW
  EndIf
  If fbBase < #AVC_WINDOW_BASE + #AVC_WINDOW_BYTES And #AVC_WINDOW_BASE < fbBase + fbBytes
    avcError = #AVC_ERR_WINDOW : ProcedureReturn #AVC_ERR_WINDOW
  EndIf
  If avcQuarantined <> 0
    If avcDeviceUnsafe <> 0
      avcError = #AVC_ERR_VK : ProcedureReturn #AVC_ERR_VK
    EndIf
    If V3dConInvalidate() = 0
      avcError = #AVC_ERR_V3D : ProcedureReturn #AVC_ERR_V3D
    EndIf
    avcQuarantined = 0
  EndIf
  ; Retire any prior Neon page table before changing its extra map. The heap
  ; occupies a separately reserved monitor region; it is not an extension of
  ; the framebuffer or of the Neon arena.
  If gV3dConOn <> 0 : V3dConStop() : EndIf
  If V3dConInvalidate() = 0
    avcError = #AVC_ERR_V3D : ProcedureReturn #AVC_ERR_V3D
  EndIf
  ConSetRenderer(@ConPaintDma)
  If NeonGpuExtraMap(#AVC_WINDOW_BASE, #AVC_WINDOW_BYTES) <> #NEON_OK
    avcStartupFallback(#AVC_ERR_V3D)
    ProcedureReturn #AVC_ERR_V3D
  EndIf
  If V3dConSetupOnce() = 0
    avcStartupFallback(#AVC_ERR_V3D)
    ProcedureReturn #AVC_ERR_V3D
  EndIf
  ; Vulkan is now eligible as the first GPU tier at boot. Native V3D used
  ; to enable the data cache before this path ran; make that guarantee here
  ; as well so full-screen vertex and atlas work uses the coherent fast path.
  CompilerIf #ANVIL_V3D_CACHE_AUTO = 1
  CacheEnable()
  CompilerEndIf
  If gV3dConOn <> 0 : V3dConStop() : EndIf
  avcLogicalW = DisplayWidth() : avcLogicalH = DisplayHeight()
  avcWidth = ScrGpuPhysicalW() : avcHeight = ScrGpuPhysicalH()
  avcPitch = ScrGpuPitch() : avcRotation = ScrGpuRotation()
  If avcLogicalW < 1 Or avcLogicalH < 1 Or avcWidth < 1 Or avcHeight < 1 Or avcPitch < avcWidth * 4
    avcStartupFallback(#AVC_ERR_DISPLAY)
    ProcedureReturn #AVC_ERR_DISPLAY
  EndIf
  If gDma = 0 Or DmaReady() = 0
    gDma = ScreenDmaUp()
  EndIf
  If gDma = 0 Or DmaReady() = 0
    avcStartupFallback(#AVC_ERR_PRESENT)
    ProcedureReturn #AVC_ERR_PRESENT
  EndIf
  If NeonVkChromeLogoSource(?anvilPix, #ANVIL_PIC_W, #ANVIL_PIC_H) <> #NEON_VK_CHROME_OK
    avcStartupFallback(#AVC_ERR_CHROME)
    ProcedureReturn #AVC_ERR_CHROME
  EndIf
  rc = avcCreateTarget()
  If rc = #AVC_OK
    avcCreateBannerTarget()                       ; optional: without it the banner uses the whole target
    If gScrSrc = #SCR_SRC_DSI
      If ScrFrameFront() = 0
        rc = #AVC_ERR_PRESENT
      Else
        rc = NeonVkPresentTargetCreate(avcInstance, avcDevice, avcImage, avcFramebuffer, avcWidth, avcHeight, @avcWsiMain)
        If rc = #VK_SUCCESS : rc = avcCheckPublicSurface(@avcWsiMain, avcWidth, avcHeight) : EndIf
        If rc = #VK_SUCCESS And avcBanReady <> 0
          rc = NeonVkPresentTargetCreate(avcInstance, avcDevice, avcBanImage, avcBanFramebuffer, avcBanW, avcBanH, @avcWsiBanner)
          If rc = #VK_SUCCESS : rc = avcCheckPublicSurface(@avcWsiBanner, avcBanW, avcBanH) : EndIf
        EndIf
      EndIf
    EndIf
  EndIf
  If rc <> #AVC_OK
    avcError = rc
    avcActive = 0
    ConNoRenderer()
    If VulkanConsoleDestroy() = 0
      avcQuarantined = 1
      avcFallbackPaint = 0
      ProcedureReturn rc
    EndIf
    If V3dConInvalidate() = 0
      avcQuarantined = 1
      avcFallbackPaint = 0
      ProcedureReturn rc
    EndIf
    avcQuarantined = 0
    NeonGpuExtraMap(0, 0)
    gDma = ScreenDmaUp()
    If gScreenDeferFirstFrame <> 0 : ProcedureReturn rc : EndIf
    ConSetRenderer(@ConPaintDma) : ConPaintDma() : TouchKeyboardComposeCpu() : ScrPresentAll()
    ProcedureReturn rc
  EndIf
  avcFallbackPaint = @ConPaintDma
  ; Retire any framebuffer save-under before the Vulkan renderer takes
  ; cursor ownership. It is redrawn into each rendered frame below.
  If gCurShown <> 0 And gCursorGpuOwned = 0
    CursorRestore(gCurX, gCurY)
    ScrPresent(gCurY, gCurY + #CUR_H - 1)
  EndIf
  gCursorGpuOwned = 1
  ; The Pi 4 armstub enables CPACR_EL1.FPEN before entering this monitor.
  ; Keep SIMD opt-in for this known boot context; payload handoff permanently
  ; returns the dispatch to scalar until reset.
  If avcNeonAllowed <> 0
    AnvilTrueTypeRasterAlphaHandlerSet(@AnvilTrueTypeCoverageCountsToAlphaNeon)
  EndIf
  NeonFontSetup(#NEON_FONT_BOLD, 3, 1)
  NeonFontSetup(#NEON_FONT_SMALL, 1, 0)
  ConSetRenderer(@VulkanConsolePump)
  *gBannerGpuInvalidate = @avcBannerInvalidate
  avcActive = 1 : avcReady = 1 : avcError = 0
  ConGridMarkAll()
  ProcedureReturn #AVC_OK
EndProcedure

Procedure.i VulkanConsoleStop()
  Define hadCursor.i
  hadCursor = gCurShown
  *gBannerGpuInvalidate = 0
  avcBannerFrameReady = 0
  If avcActive = 0 And avcReady = 0
    If avcQuarantined <> 0
      If avcDeviceUnsafe <> 0 : ConNoRenderer() : ProcedureReturn 0 : EndIf
      If V3dConInvalidate() = 0 : ConNoRenderer() : ProcedureReturn 0 : EndIf
      avcQuarantined = 0
      NeonGpuExtraMap(0, 0)
      gCursorGpuOwned = 0
      gCurShown = 0
      If gScreen <> 0 And gScreenDeferFirstFrame = 0
        DisplayClear(gScreenBg) : DrawBanner()
        DisplayConsole(0, LogoHeight(), DisplayWidth(), DisplayHeight() - LogoHeight())
        ConOverlayMarkWhole() : ConGridMarkAll()
        ConSetRenderer(@ConPaintDma) : ConPaintDma() : TouchKeyboardComposeCpu() : ScrPresentAll()
        avcCpuCursorRefresh(hadCursor)
      EndIf
    EndIf
    ProcedureReturn 1
  EndIf
  avcActive = 0
  avcReady = 0
  AnvilTrueTypeRasterAlphaHandlerSet(0)
  ConNoRenderer()
  If VulkanConsoleDestroy() = 0
    avcQuarantined = 1
    avcFallbackPaint = 0
    ProcedureReturn 0
  EndIf
  If V3dConInvalidate() = 0
    avcQuarantined = 1
    avcFallbackPaint = 0
    ProcedureReturn 0
  EndIf
  avcQuarantined = 0
  NeonGpuExtraMap(0, 0)
  gCursorGpuOwned = 0
  gCurShown = 0
  avcFallbackPaint = 0
  gDma = 0 : DisplayUseDma(0)
  If gScreen <> 0 And gScreenDeferFirstFrame = 0
    DisplayClear(gScreenBg) : DrawBanner()
    DisplayConsole(0, LogoHeight(), DisplayWidth(), DisplayHeight() - LogoHeight())
    ConOverlayMarkWhole() : ConGridMarkAll()
    ConSetRenderer(@ConPaintDma) : ConPaintDma() : TouchKeyboardComposeCpu() : ScrPresentAll()
    avcCpuCursorRefresh(hadCursor)
  EndIf
  ProcedureReturn 1
EndProcedure

; The returning payload is a different image/BSS and may reprogram V3D MMU
; state. Release Vulkan/Chrome while the monitor still owns the GPU, then
; reconstruct this opt-in tier only after the existing V3D payload owner has
; returned the engine. 0 means it was not selected before handoff.
Procedure.i VulkanConsolePayloadSuspend()
  avcNeonAllowed = 0
  AnvilTrueTypeRasterAlphaHandlerSet(0)
  If avcActive = 0
    avcPayloadWasActive = 0
    If avcQuarantined <> 0 : ProcedureReturn -1 : EndIf
    ProcedureReturn 0
  EndIf
  avcPayloadWasActive = 1
  If VulkanConsoleStop() = 0
    avcPayloadWasActive = 0
    ProcedureReturn -1
  EndIf
  ProcedureReturn 1
EndProcedure

Procedure.i VulkanConsolePayloadResume(state.i)
  If state = 0 Or avcPayloadWasActive = 0
    avcPayloadWasActive = 0
    ProcedureReturn 1
  EndIf
  avcPayloadWasActive = 0
  If gScreen = 0 : ProcedureReturn 0 : EndIf
  ProcedureReturn Bool(VulkanConsoleStart() = #AVC_OK)
EndProcedure

Procedure.i VulkanConsoleReady()
  ProcedureReturn avcReady
EndProcedure

Procedure.i VulkanConsoleQuarantined()
  ProcedureReturn avcQuarantined
EndProcedure

Procedure.i avcWarmGrid()
  Define pass.i, r.i, c.i, n.i, rc.i, i.i, at.i, height.i
  Define cp.i, glyph.q, j.i, found.i, glyphCount.i
  If AnvilTrueTypeSlotSelected() < 0 : ProcedureReturn #VK_SUCCESS : EndIf
  avcUiHeight = AnvilTrueTypePixelHeight()
  If avcUiHeight < 1 Or avcUiHeight > 512 : avcUiHeight = NeonBitmapLineHeight(#NEON_FONT_UI) : EndIf
  If NeonVkChromeFontHeightSet(#NEON_FONT_UI, avcUiHeight) <> #NEON_VK_CHROME_OK
    ProcedureReturn #NEON_VK_CHROME_ERR_ARGS
  EndIf
  If avcUiHeight < 1 Or avcUiHeight > 512 : ProcedureReturn #NEON_VK_CHROME_ERR_ATLAS : EndIf
  For pass = 0 To 1
    rc = #VK_SUCCESS
    glyphCount = 0
    For r = 0 To ConGridRows() - 1
      For c = 0 To ConGridCols() - 1
        cp = ConGridCell(r, c)
        ; Layout emits a positioned glyph for spaces too. Cache its zero-ink
        ; entry before Begin so the append path never mistakes a valid space
        ; for a missing atlas glyph in the middle of a frame.
        glyph = AnvilTrueTypeGlyphForCodepoint(cp)
        If glyph < 0 Or glyph >= AnvilTrueTypeGlyphCount()
          rc = #NEON_VK_CHROME_ERR_ATLAS : Break
        EndIf
        found = 0
        For j = 0 To glyphCount - 1
          If avcGridGlyphs[j] = glyph : found = 1 : Break : EndIf
        Next
        If found = 0
          If glyphCount >= #NEON_VK_CHROME_TT_CACHE_MAX
            rc = #NEON_VK_CHROME_ERR_CAPACITY : Break
          EndIf
          avcGridGlyphs[glyphCount] = glyph
          glyphCount + 1
        EndIf
      Next
      If rc < 0 : Break : EndIf
    Next
    If rc >= 0
      rc = NeonVkChromeGridWarm(@avcGridGlyphs[0], glyphCount, avcUiHeight)
    EndIf
    ; The touch-keyboard labels are another set of the same Neon text calls.
    ; Warm their exact scaled mono faces before Begin as well; painting them
    ; after Begin must never trigger rasterization or an atlas upload.
    If rc >= 0 And TouchKeyboardLayoutOk() <> 0
      n = TouchKeyboardPaint(#TKB_RENDER_GPU, #TKB_DAMAGE_ALL)
      If TouchKeyboardDrawOverflowed() <> 0 : rc = #NEON_VK_CHROME_ERR_CAPACITY : EndIf
      For i = 0 To n - 1
        If rc < 0 : Break : EndIf
        If TouchKeyboardDrawKind(i) = #TKB_DRAW_TEXT
      at = TouchKeyboardDrawScale(i)
      NeonFontSetup(#NEON_FONT_MONO, at, 0)
      height = NeonVkChromeFontPixelHeight(#NEON_FONT_MONO)
          rc = NeonVkChromeWarmTrueTypeText(height, TouchKeyboardDrawText(i))
          If rc < 0 : Break : EndIf
        EndIf
      Next
      NeonFontSetup(#NEON_FONT_MONO, gScrScale, 0)
    EndIf
    If rc >= 0
      If NeonVkChromeFontHeightSet(#NEON_FONT_BOLD, 48) <> #NEON_VK_CHROME_OK
        rc = #NEON_VK_CHROME_ERR_ARGS
      ElseIf NeonVkChromeFontHeightSet(#NEON_FONT_SMALL, 16) <> #NEON_VK_CHROME_OK
        rc = #NEON_VK_CHROME_ERR_ARGS
      EndIf
    EndIf
    If rc >= 0 : rc = NeonVkChromeWarmTrueTypeText(48, "PureMetal Forge") : EndIf
    If rc >= 0 : rc = NeonVkChromeWarmTrueTypeText(16, BannerPlatformText()) : EndIf
    If rc >= 0 : rc = NeonVkChromeWarmTrueTypeText(16, AnvilBuildLabel(#ANVIL_BUILD, #ANVIL_BUILD_DATE, #ANVIL_BUILD_TIME)) : EndIf
    If rc >= 0 : rc = NeonVkChromeWarmTrueTypeText(16, @gBannerClockText[0]) : EndIf
    If rc >= 0 : rc = NeonVkChromeWarmTrueTypeText(16, "A N V I L") : EndIf
    If rc >= 0 : ProcedureReturn #VK_SUCCESS : EndIf
    ; Atlas capacity can be recovered only outside an active frame. Reset the
    ; complete cache, then warm the exact current grid again before Begin.
    If pass <> 0 : ProcedureReturn rc : EndIf
    If NeonVkChromeTTCacheReset() <> #NEON_VK_CHROME_OK : ProcedureReturn rc : EndIf
  Next
  ProcedureReturn rc
EndProcedure

Procedure.i avcRenderBanner()
  Define args.NeonVkBannerArgs
  args\width = avcLogicalW : args\height = avcLogicalH
  args\logoWidth = #ANVIL_PIC_W : args\logoHeight = #ANVIL_PIC_H
  args\platformText = BannerPlatformText()
  args\buildText = AnvilBuildLabel(#ANVIL_BUILD, #ANVIL_BUILD_DATE, #ANVIL_BUILD_TIME)
  args\clockText = @gBannerClockText[0]
  args\glintActive = Bool(gBannerAnimPhase >= 0)
  If args\glintActive <> 0
    args\glintX = BannerGlintX(gBannerAnimPhase)
    args\glintY = BannerGlintY(gBannerAnimPhase)
  EndIf
  ProcedureReturn NeonVkBannerRender(@args)
EndProcedure

; Compose both the small keyboard button and the expanded key band into the
; Vulkan frame. Native V3D retains its separate CPU key-band compositor.
Procedure.i avcRenderKeyboard()
  Define n.i, i.i, kind.i, colour.i, scale.i, priorScale.i
  Define x.i, y.i, w.i, h.i, textWidth.i, lineHeight.i, rc.i
  If TouchKeyboardLayoutOk() = 0 : ProcedureReturn #NEON_VK_CHROME_OK : EndIf
  n = TouchKeyboardPaint(#TKB_RENDER_GPU, #TKB_DAMAGE_ALL)
  If TouchKeyboardDrawOverflowed() <> 0 : ProcedureReturn #NEON_VK_CHROME_ERR_CAPACITY : EndIf
  priorScale = gScrScale
  NeonFontSetup(#NEON_FONT_MONO, priorScale, 0)
  For i = 0 To n - 1
    kind = TouchKeyboardDrawKind(i)
    colour = TouchKeyboardDrawFg(i)
    x = TouchKeyboardDrawX(i) : y = TouchKeyboardDrawY(i)
    w = TouchKeyboardDrawW(i) : h = TouchKeyboardDrawH(i)
    If kind = #TKB_DRAW_RECT
      rc = Neon_Box(x, y, w, h, Neon_RGBA((colour >> 16) & $FF, (colour >> 8) & $FF, colour & $FF, 255))
    ElseIf kind = #TKB_DRAW_TEXT
      scale = TouchKeyboardDrawScale(i)
       If scale < 1 Or scale > #TKB_SCALE_MAX : rc = #NEON_VK_CHROME_ERR_ARGS : Break : EndIf
      NeonFontSetup(#NEON_FONT_MONO, scale, 0)
      textWidth = Neon_TextWidth(#NEON_FONT_MONO, TouchKeyboardDrawText(i))
      lineHeight = Neon_LineHeight(#NEON_FONT_MONO)
      If textWidth < 0 Or lineHeight < 1 : rc = #NEON_VK_CHROME_ERR_ARGS : Break : EndIf
      rc = Neon_Text(#NEON_FONT_MONO, x + (w - textWidth) / 2, y + (h - lineHeight) / 2, TouchKeyboardDrawText(i), Neon_RGBA((colour >> 16) & $FF, (colour >> 8) & $FF, colour & $FF, 255))
    EndIf
    If rc <> #NEON_VK_CHROME_OK : Break : EndIf
  Next
  NeonFontSetup(#NEON_FONT_MONO, priorScale, 0)
  ProcedureReturn rc
EndProcedure

; Copy one Vulkan-rendered rectangle with the display DMA channel. The source
; was written by V3D and is already in DRAM after the completed queue submit;
; cleaning its CPU alias could write stale cache lines over those GPU pixels.
; The destination may contain CPU-painted banner or keyboard pixels, so evict
; its cache lines on both sides of the bus-master write.
Procedure.i avcDmaCopyRect(dst.i, dstPitch.i, src.i, srcPitch.i, x.i, y.i, w.i, h.i)
  Define d.i, s.i, rowBytes.i
  If w <= 0 Or h <= 0 : ProcedureReturn 1 : EndIf
  rowBytes = w * 4
  d = dst + y * dstPitch + x * 4
  s = src + y * srcPitch + x * 4
  DmaCacheRect(d, dstPitch, rowBytes, h)
  If DmaCopy2D(d, dstPitch, s, srcPitch, rowBytes, h) = 0
    ProcedureReturn 0
  EndIf
  DmaCacheRect(d, dstPitch, rowBytes, h)
  ProcedureReturn 1
EndProcedure

; Copy the physical Vulkan raster into the established display draw surface.
; The source already has the physical orientation selected by Chrome's rebind.
; Leave the existing banner rectangle untouched, then use the display layer's
; ordinary present path (including DSI rotation/HVS ownership) to publish it.
Procedure.i avcCopyFullToDisplay()
  Define dst.i, pitch.i, width.i, height.i,t0.i,t1.i,t2.i,rc.i
  avcCopyDmaTicks=0 : avcCopyCleanTicks=0 : avcCopyPublishTicks=0
  If DisplayMemorySafe() = 0 Or gDma = 0 Or DmaReady() = 0 : ProcedureReturn 0 : EndIf
  dst = ScrGpuBase()
  If gScrSrc = #SCR_SRC_DSI : dst = ScrFrameBack() : EndIf
  pitch = ScrGpuPitch() : width = ScrGpuPhysicalW() : height = ScrGpuPhysicalH()
  If dst = 0 Or pitch < width * 4 Or width <> avcWidth Or height <> avcHeight : ProcedureReturn 0 : EndIf
  t0=Ticks()
  rc=avcDmaCopyRect(dst,pitch,avcImageBase,avcImagePitch,0,0,width,height)
  t1=Ticks() : avcCopyDmaTicks=t1-t0
  If rc=0 : ProcedureReturn 0 : EndIf
  ; The completed DMA helper already invalidated/cleaned the destination
  ; rectangle and issued its visibility barrier. No CPU pixel writes follow
  ; it here, so a second full-frame clean would repeat that ownership handoff.
  t2=Ticks() : avcCopyCleanTicks=t2-t1
  If gScrSrc = #SCR_SRC_DSI
    rc=ScrFramePublish(dst) : avcCopyPublishTicks=Ticks()-t2
    ProcedureReturn rc
  EndIf
  ProcedureReturn 1
EndProcedure

Procedure.i avcCopyToDisplay()
  Define dst.i, dstPitch.i, width.i, height.i, bx.i, by.i, bw.i, bh.i, rotation.i
  Define keepKeyboard.i, keyboardY0.i, keyboardY1.i
  Define topEnd.i, bottomStart.i
  Define keyboardX.i, keyboardY.i, keyboardW.i, keyboardH.i
  If DisplayMemorySafe() = 0 : ProcedureReturn 0 : EndIf
  dst = ScrGpuBase()
  If gScrSrc = #SCR_SRC_DSI : dst = ScrFrameBack() : EndIf
  dstPitch = ScrGpuPitch()
  width = ScrGpuPhysicalW() : height = ScrGpuPhysicalH()
  If dst = 0 Or dstPitch < width * 4 Or width <> avcWidth Or height <> avcHeight
    ProcedureReturn 0
  EndIf
  If avcBannerFrameReady <> 0
    ProcedureReturn avcCopyFullToDisplay()
  EndIf
  bx = 0 : by = 0 : bw = width : bh = LogoHeight()
  rotation = ScrGpuRotation()
  keepKeyboard = 0 : keyboardY0 = 0 : keyboardY1 = -1
  If TouchKeyboardLayoutOk() <> 0 And TouchKeyboardViewVisible() <> 0
    keepKeyboard = 1
    keyboardY0 = TouchKeyboardBandY()
    keyboardY1 = keyboardY0 + TouchKeyboardBandH() - 1
  EndIf
  If rotation = 90
    bx = width - LogoHeight() : by = 0 : bw = LogoHeight() : bh = height
  ElseIf rotation = 270
    bx = 0 : by = 0 : bw = LogoHeight() : bh = height
  EndIf
  If bx < 0 Or by < 0 Or bw < 0 Or bh < 0 Or bx + bw > width Or by + bh > height
    ProcedureReturn 0
  EndIf
  If gDma = 0 Or DmaReady() = 0 : ProcedureReturn 0 : EndIf
  If gScrSrc = #SCR_SRC_DSI
    ; The established present path restores the transformed banner and
    ; keyboard from scanout after this complete physical-frame copy.
    If avcDmaCopyRect(dst, dstPitch, avcImageBase, avcImagePitch, 0, 0, width, height) = 0
      ProcedureReturn 0
    EndIf
  ElseIf rotation = 0
    ; HDMI scans the destination in place. Preserve its CPU keyboard band
    ; and top banner by submitting only the remaining full-width spans.
    topEnd = by + bh
    If keepKeyboard <> 0
      If keyboardY0 > topEnd
        If avcDmaCopyRect(dst, dstPitch, avcImageBase, avcImagePitch, 0, topEnd, width, keyboardY0 - topEnd) = 0
          ProcedureReturn 0
        EndIf
      EndIf
      bottomStart = keyboardY1 + 1
      If bottomStart < topEnd : bottomStart = topEnd : EndIf
    Else
      bottomStart = topEnd
    EndIf
    If bottomStart < height
      If avcDmaCopyRect(dst, dstPitch, avcImageBase, avcImagePitch, 0, bottomStart, width, height - bottomStart) = 0
        ProcedureReturn 0
      EndIf
    EndIf
  Else
    ProcedureReturn 0
  EndIf
  ; DSI's front contains the correctly transformed CPU banner and keyboard.
  ; Restore their physical rectangles with DMA before the full-frame present.
  If gScrSrc = #SCR_SRC_DSI
    If avcDmaCopyRect(dst, dstPitch, ScrFrameFront(), dstPitch, bx, by, bw, bh) = 0
      ProcedureReturn 0
    EndIf
    If keepKeyboard <> 0
      keyboardX = 0 : keyboardY = keyboardY0
      keyboardW = width : keyboardH = keyboardY1 - keyboardY0 + 1
      If rotation = 90
        keyboardX = width - keyboardY1 - 1 : keyboardY = 0
        keyboardW = keyboardY1 - keyboardY0 + 1 : keyboardH = height
      ElseIf rotation = 270
        keyboardX = keyboardY0 : keyboardY = 0
        keyboardW = keyboardY1 - keyboardY0 + 1 : keyboardH = height
      EndIf
      If keyboardX < 0 Or keyboardY < 0 Or keyboardW < 1 Or keyboardH < 1 Or keyboardX + keyboardW > width Or keyboardY + keyboardH > height
        ProcedureReturn 0
      EndIf
      If avcDmaCopyRect(dst, dstPitch, ScrFrameFront(), dstPitch, keyboardX, keyboardY, keyboardW, keyboardH) = 0
        ProcedureReturn 0
      EndIf
    EndIf
  EndIf
  ; Every destination write above was completed through avcDmaCopyRect.
  ; Its post-DMA cache maintenance/barrier already made those pixels visible;
  ; there are no CPU pixel stores requiring an additional whole-frame clean.
  If gScrSrc = #SCR_SRC_DSI : ProcedureReturn ScrFramePublish(dst) : EndIf
  ProcedureReturn 1
EndProcedure

; ----------------------------------------------------------------------
;  THE BANNER'S OWN TARGET, AND ONLY THE PIXELS THAT CHANGED.
;
;  The backend renders a whole framebuffer or nothing (a smaller render area
;  is refused), so a banner frame drawn into the console's own 800 x 1280
;  target made the GPU render and store every tile of the screen for a band
;  120 pixels deep: 8.4 ms of waiting, four times a second (vkstat, build 253).
;  The banner now has a target of its own, the size of the band, and the
;  adapter is rebound to it for the frame and back afterwards (a rebind is a
;  few field stores). If that target could not be made, the old whole-target
;  banner frame is used.
;
;  Of that band only what changed goes to the display: the clock line when its
;  text changed, the logo when the glint moved, the whole band otherwise (the
;  first frame, a geometry change). Copying the whole 614 KB strip twice was
;  the other 5.7 ms.
; ----------------------------------------------------------------------

Procedure avcDestroyBannerTarget()
  If avcDevice <> 0
    If avcBanFramebuffer <> 0 : vkDestroyFramebuffer(avcDevice, avcBanFramebuffer, 0) : EndIf
    If avcBanView <> 0 : vkDestroyImageView(avcDevice, avcBanView, 0) : EndIf
    If avcBanImage <> 0 : vkDestroyImage(avcDevice, avcBanImage, 0) : EndIf
    If avcBanMemory <> 0 : vkFreeMemory(avcDevice, avcBanMemory, 0) : EndIf
  EndIf
  avcBanFramebuffer = 0 : avcBanView = 0 : avcBanImage = 0 : avcBanMemory = 0
  avcBanBase = 0 : avcBanPitch = 0 : avcBanReady = 0 : avcBanShown = 0
EndProcedure

; 1 when the band's own target exists. Any failure leaves none and the old path in use.
Procedure.i avcCreateBannerTarget()
  Define rc.i, mapped.i
  Define imageInfo.VkImageCreateInfo
  Define req.VkMemoryRequirements
  Define alloc.VkMemoryAllocateInfo
  Define viewInfo.VkImageViewCreateInfo
  Define frameInfo.VkFramebufferCreateInfo
  avcDestroyBannerTarget()
  If avcDevice = 0 Or avcRenderPass = 0 Or LogoHeight() < 1 : ProcedureReturn 0 : EndIf
  If avcRotation = 90 Or avcRotation = 270
    avcBanW = LogoHeight() : avcBanH = avcHeight
  Else
    avcBanW = avcWidth : avcBanH = LogoHeight()
  EndIf
  imageInfo\sType = #VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO
  imageInfo\imageType = #VK_IMAGE_TYPE_2D
  imageInfo\format = #VK_FORMAT_B8G8R8A8_UNORM
  imageInfo\extent\width = avcBanW : imageInfo\extent\height = avcBanH : imageInfo\extent\depth = 1
  imageInfo\mipLevels = 1 : imageInfo\arrayLayers = 1
  imageInfo\samples = #VK_SAMPLE_COUNT_1_BIT
  imageInfo\tiling = #VK_IMAGE_TILING_LINEAR
  imageInfo\usage = #VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | #VK_IMAGE_USAGE_TRANSFER_SRC_BIT
  imageInfo\sharingMode = #VK_SHARING_MODE_EXCLUSIVE
  imageInfo\initialLayout = #VK_IMAGE_LAYOUT_UNDEFINED
  rc = vkCreateImage(avcDevice, @imageInfo, 0, @avcBanImage)
  If rc <> #VK_SUCCESS : avcDestroyBannerTarget() : ProcedureReturn 0 : EndIf
  vkGetImageMemoryRequirements(avcDevice, avcBanImage, @req)
  alloc\sType = #VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO
  alloc\allocationSize = req\size : alloc\memoryTypeIndex = 0
  rc = vkAllocateMemory(avcDevice, @alloc, 0, @avcBanMemory)
  If rc = #VK_SUCCESS : rc = vkBindImageMemory(avcDevice, avcBanImage, avcBanMemory, 0) : EndIf
  If rc <> #VK_SUCCESS : avcDestroyBannerTarget() : ProcedureReturn 0 : EndIf
  avcBanBase = AnvilVkImageAddress(avcBanImage)
  avcBanPitch = AnvilVkImageRowPitch(avcBanImage)
  If avcBanBase = 0 Or avcBanPitch < avcBanW * 4 : avcDestroyBannerTarget() : ProcedureReturn 0 : EndIf
  mapped = 0
  rc = vkMapMemory(avcDevice, avcBanMemory, 0, #VK_WHOLE_SIZE, 0, @mapped)
  If rc <> #VK_SUCCESS Or mapped <> avcBanBase : avcDestroyBannerTarget() : ProcedureReturn 0 : EndIf
  vkUnmapMemory(avcDevice, avcBanMemory)
  viewInfo\sType = #VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO
  viewInfo\image = avcBanImage : viewInfo\viewType = #VK_IMAGE_VIEW_TYPE_2D
  viewInfo\format = #VK_FORMAT_B8G8R8A8_UNORM
  viewInfo\subresourceRange\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT
  viewInfo\subresourceRange\levelCount = 1 : viewInfo\subresourceRange\layerCount = 1
  rc = vkCreateImageView(avcDevice, @viewInfo, 0, @avcBanView)
  If rc <> #VK_SUCCESS : avcDestroyBannerTarget() : ProcedureReturn 0 : EndIf
  frameInfo\sType = #VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO
  frameInfo\renderPass = avcRenderPass : frameInfo\attachmentCount = 1
  frameInfo\pAttachments = @avcBanView : frameInfo\width = avcBanW
  frameInfo\height = avcBanH : frameInfo\layers = 1
  rc = vkCreateFramebuffer(avcDevice, @frameInfo, 0, @avcBanFramebuffer)
  If rc <> #VK_SUCCESS : avcDestroyBannerTarget() : ProcedureReturn 0 : EndIf
  avcBanReady = 1
  ProcedureReturn 1
EndProcedure

; A DMA copy of a rectangle between two different places in two surfaces.
Procedure.i avcDmaCopyRectAt(dst.i, dstPitch.i, dx.i, dy.i, src.i, srcPitch.i, sx.i, sy.i, w.i, h.i)
  Define d.i, s.i, rowBytes.i
  If w <= 0 Or h <= 0 : ProcedureReturn 1 : EndIf
  rowBytes = w * 4
  d = dst + dy * dstPitch + dx * 4
  s = src + sy * srcPitch + sx * 4
  DmaCacheRect(d, dstPitch, rowBytes, h)
  If DmaCopy2D(d, dstPitch, s, srcPitch, rowBytes, h) = 0
    ProcedureReturn 0
  EndIf
  DmaCacheRect(d, dstPitch, rowBytes, h)
  ProcedureReturn 1
EndProcedure

; One rectangle of the band, given in LOGICAL banner coordinates (x across the
; screen, y down the band), from the band's source to the display draw buffer
; and, on DSI, the scan buffer. The source is the band's own target, or the
; console's whole target when the band has none (bandInSource = 0).
Procedure.i avcCopyBandRect(lx.i, ly.i, lw.i, lh.i, src.i, srcPitch.i, bandInSource.i)
  Define dst.i, dstPitch.i, width.i, height.i, band.i
  Define px.i, py.i, pw.i, ph.i, ox.i, oy.i, sx.i, sy.i
  band = LogoHeight()
  If lx < 0 : lw = lw + lx : lx = 0 : EndIf
  If ly < 0 : lh = lh + ly : ly = 0 : EndIf
  If lx + lw > avcLogicalW : lw = avcLogicalW - lx : EndIf
  If ly + lh > band : lh = band - ly : EndIf
  If lw < 1 Or lh < 1 : ProcedureReturn 1 : EndIf
  dst = ScrGpuBase()
  If gScrSrc = #SCR_SRC_DSI : dst = ScrFrameBack() : EndIf
  dstPitch = ScrGpuPitch()
  width = ScrGpuPhysicalW() : height = ScrGpuPhysicalH()
  If dst = 0 Or dstPitch < width * 4 Or width <> avcWidth Or height <> avcHeight : ProcedureReturn 0 : EndIf
  ; the rectangle in the band's physical coordinates, and where the band sits on the display
  ox = 0 : oy = 0
  If avcRotation = 90
    px = band - (ly + lh) : py = lx : pw = lh : ph = lw : ox = width - band
  ElseIf avcRotation = 270
    px = ly : py = avcLogicalW - (lx + lw) : pw = lh : ph = lw
  ElseIf avcRotation = 180
    px = avcLogicalW - (lx + lw) : py = band - (ly + lh) : pw = lw : ph = lh : oy = height - band
  Else
    px = lx : py = ly : pw = lw : ph = lh
  EndIf
  sx = px : sy = py
  If bandInSource = 0 : sx = px + ox : sy = py + oy : EndIf
  If avcDmaCopyRectAt(dst, dstPitch, px + ox, py + oy, src, srcPitch, sx, sy, pw, ph) = 0 : ProcedureReturn 0 : EndIf

  ProcedureReturn 1
EndProcedure

; A number that changes when the banner's text line changes.
Procedure.i avcClockSum()
  Define i.i, c.i, h.i
  h = 0
  For i = 0 To #BANNER_CLOCK_MAX
    c = gBannerClockText[i] & $FF
    If c = 0 : Break : EndIf
    h = ((h * 31) + c) & $FFFFFFFF
  Next
  ProcedureReturn h
EndProcedure

; Copies the parts of the band that changed since the last banner frame.
Procedure.i avcCopyBannerToDisplay(src.i, srcPitch.i, bandInSource.i)
  Define clock.i, glint.i, any.i, logoX.i
  If DisplayMemorySafe() = 0 : ProcedureReturn 0 : EndIf
  If gDma = 0 Or DmaReady() = 0 : ProcedureReturn 0 : EndIf
  If gScrSrc = #SCR_SRC_DSI
    If ScrFrameCloneBack() = 0 : ProcedureReturn 0 : EndIf
  EndIf
  clock = avcClockSum() : glint = gBannerAnimPhase
  If avcBanShown = 0
    any = avcCopyBandRect(0, 0, avcLogicalW, LogoHeight(), src, srcPitch, bandInSource)
  Else
    any = 1
    If clock <> avcBanLastClock                     ; the build, date, clock and status line
      any = avcCopyBandRect(0, 88, avcLogicalW - #ANVIL_PIC_W - 12, 28, src, srcPitch, bandInSource)
    EndIf
    If any <> 0 And glint <> avcBanLastGlint        ; the logo, where the glint runs
      logoX = avcLogicalW - #ANVIL_PIC_W - 12
      any = avcCopyBandRect(logoX - 2, 10, #ANVIL_PIC_W + 4, #ANVIL_PIC_H + 4, src, srcPitch, bandInSource)
    EndIf
  EndIf
  If any = 0 : ProcedureReturn 0 : EndIf
  If gScrSrc = #SCR_SRC_DSI
    If ScrFramePublish(ScrFrameBack()) = 0 : ProcedureReturn 0 : EndIf
  EndIf
  avcBanLastClock = clock : avcBanLastGlint = glint : avcBanShown = 1
  ProcedureReturn 1
EndProcedure

; While a banner-only frame waits for the GPU the core sleeps between polls,
; exactly as the prompt does between services, and the time is counted as idle.
; Only when the prompt's own wait has been qualified on this board.
Procedure avcGpuWaitIdle()
  Define t0.i, dt.i
  If anvil_promptWfeEnabled = 0 Or anvil_promptWfeReady = 0
    ProcedureReturn
  EndIf
  If MmuEl() <> 3
    ProcedureReturn
  EndIf
  CompilerIf #CAP_PWM = 1
    If HwPwmKind() = #HW_PWM_KIND_SOFT
      ProcedureReturn
    EndIf
  CompilerEndIf
  t0 = Ticks()
  Asm
    wfe
  EndAsm
  dt = Ticks() - t0
  If dt > 0
    anvil_promptIdleTicks = anvil_promptIdleTicks + dt
  EndIf
EndProcedure

; The completed render remains owned during the synchronous display transfer.
; A failed transfer leaves the record and possible DMA ownership for checked
; teardown; it must not be reported as a successful presentation.
Procedure.i avcPresentRenderedFrame(bannerOnly.i, bandTarget.i)
  Define ok.i
  avcPresentStage = 10
  If NeonVkChromePresentPending() <> 1 : ProcedureReturn 0 : EndIf
  If NeonVkChromePresentValidate() <> 1 : ProcedureReturn 0 : EndIf
  avcPresentStage = 11
  avcDisplayCopyPending = DmaReady()
  If bannerOnly <> 0
    If bandTarget <> 0
      ok = avcCopyBannerToDisplay(avcBanBase, avcBanPitch, 1)
    Else
      ok = avcCopyBannerToDisplay(avcImageBase, avcImagePitch, 0)
    EndIf
  Else
    ok = avcCopyToDisplay()
  EndIf
  If ok = 0 : ProcedureReturn 0 : EndIf
  avcDisplayCopyPending = 0
  avcPresentStage = 12
  If NeonVkChromePresentConsume() <> 1 : ProcedureReturn 0 : EndIf
  If gScrSrc = #SCR_SRC_DSI : avcWsiPresentN = avcWsiPresentN + 1 : EndIf
  ProcedureReturn 1
EndProcedure

; A frame that holds the banner and nothing else, for a change of the clock or
; the glint while the text is unchanged. Returns 1 when it was presented.
Procedure.i avcPumpBannerOnly()
  Define rc.i, endRc.i, t0.i, t1.i, t2.i, own.i, tBegin0.i
  t0 = Ticks()
  ; Clock/status text changes independently of the grid. Admit new glyphs
  ; before Begin; drawing inside the pass must never mutate the atlas.
  avcPresentStage = 19
  If AnvilTrueTypeSlotSelected() >= 0
    rc = NeonVkChromeWarmTrueTypeText(16, @gBannerClockText[0])
    If rc < 0 : ProcedureReturn 0 : EndIf
  EndIf
  avcPresentStage = 20
  own = 0
  If avcBanReady <> 0
    If NeonVkChromeRebind(avcBanFramebuffer, avcLogicalW, LogoHeight(), avcBanW, avcBanH, avcBanPitch, avcRotation) = #VK_SUCCESS
      own = 1
    Else
      NeonVkChromeRebind(avcFramebuffer, avcLogicalW, avcLogicalH, avcWidth, avcHeight, avcPitch, avcRotation)
      If NeonVkPresentTargetDestroy(avcInstance, avcDevice, @avcWsiBanner) <> #VK_SUCCESS : ProcedureReturn 0 : EndIf
      avcDestroyBannerTarget()                      ; never again this session: the whole-target frame is used
    EndIf
  EndIf
  avcClear[0] = 0 : avcClear[1] = 0 : avcClear[2] = 0 : avcClear[3] = $3F800000
  If gScrSrc = #SCR_SRC_DSI
    If own <> 0
      rc = NeonVkPresentTargetAcquire(avcDevice, avcBanImage, @avcWsiBanner)
    Else
      rc = NeonVkPresentTargetAcquire(avcDevice, avcImage, @avcWsiMain)
    EndIf
    If rc <> #VK_SUCCESS : ProcedureReturn 0 : EndIf
  EndIf
  tBegin0 = Ticks()
  avcPresentStage = 21
  If NeonVkChromeBegin(@avcClear[0]) <> #VK_SUCCESS
    ProcedureReturn 0
  EndIf
  avcStatBeginTicks = avcStatBeginTicks + (Ticks() - tBegin0)
  avcBannerFrameReady = 0
  avcPresentStage = 22
  rc = avcRenderBanner()
  t1 = Ticks()
  *gV3dWaitIdle = @avcGpuWaitIdle
  avcPresentStage = 23
  endRc = NeonVkChromeEnd()
  *gV3dWaitIdle = 0
  t2 = Ticks()
  If rc <> #NEON_VK_CHROME_OK Or NeonVkChromeError() <> 0 Or endRc <> #VK_SUCCESS
    ProcedureReturn 0
  EndIf
  ; Use only the prompt-qualified idle provider, and never retain it after
  ; presentation returns (including refusal). Other display owners still poll.
  *gScrFrameWaitIdle = @avcGpuWaitIdle
  rc = avcPresentRenderedFrame(1, own)
  *gScrFrameWaitIdle = 0
  If rc = 0 : ProcedureReturn 0 : EndIf
  ; Retarget only after the banner copy and ownership consumption complete.
  avcPresentStage = 25
  If own <> 0
    If NeonVkChromeRebind(avcFramebuffer, avcLogicalW, avcLogicalH, avcWidth, avcHeight, avcPitch, avcRotation) <> #VK_SUCCESS
      ProcedureReturn 0
    EndIf
  EndIf
  avcStatBanner[0] = avcStatBanner[0] + (t1 - t0)
  avcStatBanner[1] = avcStatBanner[1] + (t2 - t1)
  avcStatBanner[2] = avcStatBanner[2] + (Ticks() - t2)
  avcStatBannerN = avcStatBannerN + 1
  ProcedureReturn 1
EndProcedure

Procedure VulkanConsolePump()
  Define r.i, c.i, n.i, y.i, ch.i, cw.i, colour.i, rc.i, endRc.i, pass.i
  Define st0.i, st1.i, st2.i
  Define layoutCount.i, layoutLines.i, layoutWidth.i, baseline.i, visible.i
  If avsContext <> 0 : ProcedureReturn : EndIf
  If avcReady = 0 Or avcActive = 0 Or gScreen = 0 Or avcDisplayCopyPending <> 0
    ProcedureReturn
  EndIf
  ; Only the banner changed, and a whole frame is already on the glass: draw
  ; the banner alone. Failure may retain a frame or DMA source, so enter the
  ; checked failure path rather than starting another frame on that owner.
  If avcBannerDirty <> 0 And avcFramePresented <> 0 And gConOverlayDirty = 0
    If avcGridNeedsPaint() = 0
      If avcPumpBannerOnly() <> 0
        avcBannerDirty = 0
        ConGridClearDirty()
        avcError = 0
        ProcedureReturn
      EndIf
      avcFailover(#AVC_ERR_PRESENT)
      ProcedureReturn
    EndIf
  EndIf
  avcBannerDirty = 0
  st0 = Ticks()
  rc = avcWarmGrid()
  If rc < 0
    avcFailover(#AVC_ERR_CHROME)
    ProcedureReturn
  EndIf
  avcClear[0] = 0 : avcClear[1] = 0 : avcClear[2] = 0 : avcClear[3] = $3F800000
  If gScrSrc = #SCR_SRC_DSI
    If NeonVkPresentTargetAcquire(avcDevice, avcImage, @avcWsiMain) <> #VK_SUCCESS
      avcFailover(#AVC_ERR_PRESENT) : ProcedureReturn
    EndIf
  EndIf
  If NeonVkChromeBegin(@avcClear[0]) <> #VK_SUCCESS
    avcFailover(#AVC_ERR_CHROME)
    ProcedureReturn
  EndIf
  avcBannerFrameReady = 0
  rc = avcRenderBanner()
  If rc <> #NEON_VK_CHROME_OK
    avcFailover(#AVC_ERR_CHROME)
    ProcedureReturn
  EndIf
  avcBannerFrameReady = 1
  ; The console row follows the face's measured advances and pair positioning.
  ; Every quad keeps the atlas bitmap's exact pixel dimensions.
  ch = DisplayCharHeight() : cw = DisplayCharWidth()
  If AnvilTrueTypeSlotSelected() >= 0
    ; Layout each full row before separating its styles. This preserves
    ; kerning across a colour change while retaining two bounded draw calls.
    visible = #AVC_UI_QUAD_RESERVE
    For r = 0 To ConGridRows() - 1
      For c = 0 To ConGridCols() - 1
        If ConGridCell(r, c) <> 32 : visible = visible + 1 : EndIf
      Next
    Next
    rc = NeonVkChromeGridBatchBegin()
    If rc = #NEON_VK_CHROME_OK
      rc = NeonVkChromeGridBatchReserve(visible, 2)
    EndIf
    If rc = #NEON_VK_CHROME_OK
      baseline = NeonVkChromeGridBaseline()
      For pass = 0 To 1
        If pass = 0 : colour = V3dCon_Ink() : Else : colour = V3dCon_PromptInk() : EndIf
        For r = 0 To ConGridRows() - 1
          y = LogoHeight() + r * ch
          n = ConGridRowText(r, @gConRowBuf[0])
          If n > 0
            If AnvilTrueTypeLayoutUtf8(@gConRowBuf[0], n, avcUiHeight, 0, ch, @avcLayoutGlyph[0], @avcLayoutX[0], @avcLayoutY[0], @avcLayoutAdvance[0], #ANVIL_TTL_ALIGN_LEFT, #CON_MAXCOLS, @layoutCount, @layoutLines, @layoutWidth) = 0 Or layoutCount <> n Or layoutLines <> 1
              rc = #NEON_VK_CHROME_ERR_ATLAS : Break
            EndIf
          EndIf
          For c = 0 To n - 1
            If (pass = 1 And ConGridCellStyle(r, c) = #UART_SCREEN_STYLE_PROMPT) Or (pass = 0 And ConGridCellStyle(r, c) <> #UART_SCREEN_STYLE_PROMPT)
              rc = NeonVkChromeGridGlyphAppendPositioned(avcLayoutGlyph[c], avcUiHeight, avcLayoutX[c], y + baseline, avcLayoutY[c])
              If rc <> #NEON_VK_CHROME_OK : Break : EndIf
            EndIf
          Next
          If rc <> #NEON_VK_CHROME_OK : Break : EndIf
        Next
        If rc <> #NEON_VK_CHROME_OK : Break : EndIf
        rc = NeonVkChromeGridBatchFlush(colour)
        If rc <> #NEON_VK_CHROME_OK : Break : EndIf
      Next
    EndIf
    If rc = #NEON_VK_CHROME_OK
      rc = NeonVkChromeGridBatchEnd()
    EndIf
    If rc <> #NEON_VK_CHROME_OK
      avcFailover(#AVC_ERR_CHROME)
      ProcedureReturn
    EndIf
  Else
    For r = 0 To ConGridRows() - 1
      y = LogoHeight() + r * ch : c = 0
      While c < ConGridCols()
        If ConGridCellStyle(r, c) = #UART_SCREEN_STYLE_PROMPT
          colour = V3dCon_PromptInk()
        Else
          colour = V3dCon_Ink()
        EndIf
        n = ConGridStyleRunText(r, c, @gConRowBuf[0])
        If n > 0
          Neon_Text(#NEON_FONT_UI, c * cw, y, @gConRowBuf[0], colour)
          c = c + n
        Else
          c + 1
        EndIf
      Wend
    Next
  EndIf
  rc = avcRenderKeyboard()
  If rc <> #NEON_VK_CHROME_OK
    avcFailover(#AVC_ERR_CHROME)
    ProcedureReturn
  EndIf
  V3dConRenderCursor()
  rc = NeonVkChromeError()
  st1 = Ticks()
  endRc = NeonVkChromeEnd()
  st2 = Ticks()
  If rc <> 0 Or endRc <> #VK_SUCCESS
    avcFailover(#AVC_ERR_CHROME)
    ProcedureReturn
  EndIf
  If avcPresentRenderedFrame(0, 0) = 0
    avcFailover(#AVC_ERR_PRESENT)
    ProcedureReturn
  EndIf
  avcFramePresented = 1
  avcBanShown = 1 : avcBanLastClock = avcClockSum() : avcBanLastGlint = gBannerAnimPhase
  ConGridClearDirty()
  avcStatFull[0] = avcStatFull[0] + (st1 - st0)
  avcStatFull[1] = avcStatFull[1] + (st2 - st1)
  avcStatFull[2] = avcStatFull[2] + (Ticks() - st2)
  avcStatFullN = avcStatFullN + 1
  ; ScreenPump invokes the overlay immediately after this renderer. Marking
  ; it dirty here would schedule another whole GPU frame on every prompt
  ; service tick, even when the console and keyboard had not changed.
  avcError = 0
EndProcedure

Procedure avcStatLine(*label, n.i, sum0.i, sum1.i, sum2.i, hz.i)
  Print("  ")
  UartWriteStr(*label)
  PrintDec(n)
  If n > 0 And hz > 0
    Print(" frames; per frame, microseconds: build ")
    PrintDec(((sum0 / n) * 1000000) / hz)
    Print(", submit and GPU wait ")
    PrintDec(((sum1 / n) * 1000000) / hz)
    Print(", copy to the display ")
    PrintDec(((sum2 / n) * 1000000) / hz)
  EndIf
  PrintNl()
EndProcedure

; vkstat - what the Vulkan console's frames cost since the last vkstat.
; The application service shares the console's checked Vulkan/display owner.
; Context and font IDs are epochs, never caller-provided kernel pointers.
Procedure.i avsRestoreFont()
  If avsPreviousFont<0
    If AnvilTrueTypeSlotDeselect()=0 : ProcedureReturn #NEON_SERVICE_ERR_PROVIDER : EndIf
    ProcedureReturn 0
  EndIf
  If AnvilTrueTypeSlotBytes(avsPreviousFont)<1 Or AnvilTrueTypeSlotGeneration(avsPreviousFont)<>avsPreviousFontGeneration
    ProcedureReturn #NEON_SERVICE_ERR_STALE
  EndIf
  If AnvilTrueTypeSlotSelect(avsPreviousFont)=0 : ProcedureReturn #NEON_SERVICE_ERR_PROVIDER : EndIf
  ProcedureReturn 0
EndProcedure

Procedure.i avsClose()
  Define i.i
  Define rc.i
  avsReady = 0
  If avsContext = 0 : ProcedureReturn 0 : EndIf
  rc=NeonVkTargetsClose(avsContext)
  If rc<>0 : avsError=rc : ProcedureReturn rc : EndIf
  If VulkanConsoleStop() = 0
    avsError = #AVC_ERR_PRESENT : ProcedureReturn avsError
  EndIf
  ; GPU/device retirement precedes font-byte retirement. A failed restore or
  ; release retains the context and all not-yet-released generation tokens.
  rc=avsRestoreFont()
  If rc<>0 : avsError=rc : ProcedureReturn rc : EndIf
  For i=0 To #NEON_SERVICE_MAX_FONT_ASSETS-1
    If avsOwnedFont[i]<>0
      If AnvilFontReleaseMemory(i,avsOwnedFont[i])=0 : avsError=#NEON_SERVICE_ERR_STALE : ProcedureReturn avsError : EndIf
      avsOwnedFont[i]=0
    EndIf
  Next
  NeonVkPortSpriteFrameRetired()
  For i=0 To #NEON_SERVICE_MAX_SPRITES-1 : avsSpriteHandle[i]=0 : Next
  avsBatch=0
  avsParticleReady=0 : avsParticleCount=0
  avsContext = 0 : avsFrame = 0 : avsFontCount = 0 : avsError = 0
  ProcedureReturn 0
EndProcedure

Procedure.i VulkanNeonServiceReset()
  ProcedureReturn avsClose()
EndProcedure

Procedure.i avsRecord(request.i, bytes.i, expected.i)
  If bytes <> expected : ProcedureReturn 0 : EndIf
  If expected = 0 : ProcedureReturn Bool(request = 0) : EndIf
  ProcedureReturn Bool(request <> 0 And (request & 7) = 0)
EndProcedure

; Reject NaN/infinity before conversion to coordinates or packed channels.
Procedure.i avsFloats(request.i,count.i)
  ProcedureReturn NeonServiceFloatsValid(request,count)
EndProcedure

Procedure.i avsFontIndex(font.i)
  Define index.i
  If font >= 0 And font <= 3 : ProcedureReturn 0 : EndIf
  If (font >> 16) <> avsContext : ProcedureReturn -1 : EndIf
  index = font & $FFFF
  If index < 1 Or index > avsFontCount : ProcedureReturn -1 : EndIf
  ProcedureReturn index
EndProcedure

Procedure.i avsFontBytesRequest(op.i,request.i,bytes.i)
  Define *load.NeonServiceFontLoadRequest,*unload.NeonServiceFontUnloadRequest
  Define slot.i,index.i,generation.i,rc.i
  If avsFrame<>0 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
  If op=#NEON_SERVICE_FONT_LOAD
    If avsRecord(request,bytes,SizeOf(NeonServiceFontLoadRequest))=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    *load=request
    If *load\data<1 Or *load\bytes<1 Or *load\bytes>#NEON_SERVICE_MAX_FONT_BYTES Or *load\role<0 Or *load\role>3 Or *load\pixels<1 Or *load\pixels>512
      ProcedureReturn #NEON_SERVICE_ERR_ARGS
    EndIf
    If *load\data+*load\bytes-1<*load\data : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    If InPayload(*load\data,*load\data+*load\bytes-1)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    If avsFontCount>=32 : ProcedureReturn #NEON_SERVICE_ERR_CAPACITY : EndIf
    slot=0
    While slot<#NEON_SERVICE_MAX_FONT_ASSETS
      If avsOwnedFont[slot]=0 And AnvilTrueTypeSlotBytes(slot)=0 : Break : EndIf
      slot=slot+1
    Wend
    If slot>=#NEON_SERVICE_MAX_FONT_ASSETS : ProcedureReturn #NEON_SERVICE_ERR_CAPACITY : EndIf
    generation=AnvilFontLoadMemory(slot,*load\data,*load\bytes)
    If generation<1 : ProcedureReturn #NEON_SERVICE_ERR_FORMAT : EndIf
    avsOwnedFont[slot]=generation
    rc=NeonVkPortFontBind(@avsFont[avsFontCount],slot,*load\role,*load\pixels)
    If rc<>0
      If AnvilFontReleaseMemory(slot,generation)<>0 : avsOwnedFont[slot]=0 : EndIf
      ProcedureReturn rc
    EndIf
    avsFontCount=avsFontCount+1
    ProcedureReturn (avsContext << 16) | avsFontCount
  EndIf
  If op=#NEON_SERVICE_FONT_UNLOAD
    If avsRecord(request,bytes,SizeOf(NeonServiceFontUnloadRequest))=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    *unload=request : index=avsFontIndex(*unload\font)
    If index<1 : ProcedureReturn #NEON_SERVICE_ERR_STALE : EndIf
    slot=avsFont[index-1]\slot : generation=avsFont[index-1]\generation
    If slot<0 Or slot>=#NEON_SERVICE_MAX_FONT_ASSETS : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
    If avsOwnedFont[slot]=0 Or avsOwnedFont[slot]<>generation : ProcedureReturn #NEON_SERVICE_ERR_STALE : EndIf
    If AnvilTrueTypeSlotSelected()=slot
      rc=avsRestoreFont() : If rc<>0 : ProcedureReturn rc : EndIf
    EndIf
    If AnvilFontReleaseMemory(slot,generation)=0 : ProcedureReturn #NEON_SERVICE_ERR_STALE : EndIf
    avsOwnedFont[slot]=0 : ProcedureReturn 0
  EndIf
  ProcedureReturn #NEON_SERVICE_ERR_ARGS
EndProcedure

Procedure.i avsMeasure(font.i, text.i, height.i)
  Define index.i, measured.i
  Define width.f
  index = avsFontIndex(font)
  If index < 0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
  If height <> 0
    If index = 0
      measured = NeonVkChromeMeasureLineHeight(font)
    Else
      measured = NeonVkPortFontLineHeight(@avsFont[index - 1])
    EndIf
    If measured < 0 : ProcedureReturn measured : EndIf
    ProcedureReturn measured * 65536
  EndIf
  If text = 0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
  If index = 0
    width = NeonVkPortTextWidth(font, text, 1)
  Else
    width = NeonVkPortFontTextWidth(@avsFont[index - 1], text, 1)
  EndIf
  If width < 0.0 Or width > 1000000.0 : ProcedureReturn #NEON_SERVICE_ERR_PROVIDER : EndIf
  ProcedureReturn MathFToInt(width * 65536.0)
EndProcedure

Procedure.i avsSpriteIndex(handle.i)
  Define i.i
  If handle<1 : ProcedureReturn -1 : EndIf
  For i=0 To #NEON_SERVICE_MAX_SPRITES-1
    If avsSpriteHandle[i]=handle : ProcedureReturn i : EndIf
  Next
  ProcedureReturn -1
EndProcedure

Procedure.i avsSpriteRequest(op.i,request.i,bytes.i)
  Define *limits.NeonServiceSpriteLimits,*upload.NeonServiceSpriteUploadRequest
  Define *handle.NeonServiceSpriteHandleRequest,*draw.NeonServiceSpriteDrawRequest
  Define *camera.NeonServiceCameraRequest,*batch.NeonServiceSpriteBatchRequest
  Define candidate.NeonVkPortSpriteRef,index.i,rc.i,needed.i
  Select op
    Case #NEON_SERVICE_SPRITE_LIMITS
      If avsRecord(request,bytes,SizeOf(NeonServiceSpriteLimits))=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      *limits=request : *limits\slots=#NEON_SERVICE_MAX_SPRITES
      *limits\maxDimension=#NEON_SERVICE_MAX_SPRITE_DIM : *limits\maxUploadBytes=#NEON_SERVICE_MAX_SPRITE_BYTES
      *limits\maxBatch=#NEON_SERVICE_MAX_SPRITE_BATCH
      ProcedureReturn 0
    Case #NEON_SERVICE_SPRITE_UPLOAD
      If avsFrame<>0 Or avsBatch<>0 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
      If avsRecord(request,bytes,SizeOf(NeonServiceSpriteUploadRequest))=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      *upload=request
      If *upload\slot<1 Or *upload\slot>#NEON_SERVICE_MAX_SPRITES Or *upload\pixels<1 Or *upload\width<1 Or *upload\height<1 Or *upload\width>#NEON_SERVICE_MAX_SPRITE_DIM Or *upload\height>#NEON_SERVICE_MAX_SPRITE_DIM Or (*upload\bgra<>0 And *upload\bgra<>1)
        ProcedureReturn #NEON_SERVICE_ERR_ARGS
      EndIf
      If NeonVkTargetsOwnsSprite(*upload\slot)<>0 : ProcedureReturn #NEON_SERVICE_ERR_BUSY : EndIf
      needed=*upload\width * *upload\height * 4
      If *upload\sourceBytes<needed Or *upload\pixels+needed-1<*upload\pixels : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      If InPayload(*upload\pixels,*upload\pixels+needed-1)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      If avsSpriteClock=$7FFFFFFFFFFFFFFF : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
      rc=NeonVkPortSpriteUpload(@candidate,*upload\slot,*upload\pixels,*upload\width,*upload\height,*upload\bgra)
      If rc<>0 : ProcedureReturn rc : EndIf
      index=*upload\slot-1
      avsSprite[index]\id=candidate\id : avsSprite[index]\width=candidate\width
      avsSprite[index]\height=candidate\height : avsSprite[index]\generation=candidate\generation
      avsSpriteClock=avsSpriteClock+1 : avsSpriteHandle[index]=avsSpriteClock
      ProcedureReturn avsSpriteClock
    Case #NEON_SERVICE_SPRITE_CLEAR
      If avsFrame<>0 Or avsBatch<>0 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
      If avsRecord(request,bytes,SizeOf(NeonServiceSpriteHandleRequest))=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      *handle=request : index=avsSpriteIndex(*handle\handle)
      If index<0 : ProcedureReturn #NEON_SERVICE_ERR_STALE : EndIf
      rc=NeonVkPortSpriteClear(@avsSprite[index])
      If rc=0 : avsSpriteHandle[index]=0 : EndIf
      ProcedureReturn rc
    Case #NEON_SERVICE_SPRITE_DRAW
      If avsFrame<>1 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
      If avsRecord(request,bytes,SizeOf(NeonServiceSpriteDrawRequest))=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      *draw=request
      If avsFloats(request+8,8)=0 Or avsFloats(request+48,4)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      If (*draw\scaled<>0 And *draw\scaled<>1) Or (*draw\ignoreCamera<>0 And *draw\ignoreCamera<>1) : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      index=avsSpriteIndex(*draw\handle)
      If index<0 : ProcedureReturn #NEON_SERVICE_ERR_STALE : EndIf
      ProcedureReturn NeonVkPortSprite(@avsSprite[index],*draw\x,*draw\y,*draw\angle,*draw\scale,*draw\r,*draw\g,*draw\b,*draw\a,*draw\scaled,*draw\srcX,*draw\srcY,*draw\srcW,*draw\srcH,*draw\ignoreCamera)
    Case #NEON_SERVICE_CAMERA
      If avsFrame=2 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
      If avsRecord(request,bytes,SizeOf(NeonServiceCameraRequest))=0 Or avsFloats(request,3)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      *camera=request
      If *camera\reserved<>0 Or *camera\zoom<=0.0 Or *camera\zoom>16.0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      ProcedureReturn NeonVkPortCamera(*camera\x,*camera\y,*camera\zoom)
    Case #NEON_SERVICE_SPRITE_BATCH_BEGIN
      If avsFrame<>1 Or avsBatch<>0 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
      If avsRecord(request,bytes,SizeOf(NeonServiceSpriteHandleRequest))=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      *handle=request : index=avsSpriteIndex(*handle\handle)
      If index<0 : ProcedureReturn #NEON_SERVICE_ERR_STALE : EndIf
      rc=NeonVkPortSpriteBatchBegin(@avsSprite[index])
      If rc=0 : avsBatch=1 : EndIf
      ProcedureReturn rc
    Case #NEON_SERVICE_SPRITE_BATCH_ADD
      If avsFrame<>1 Or avsBatch<>1 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
      If avsRecord(request,bytes,SizeOf(NeonServiceSpriteBatchRequest))=0 Or avsFloats(request,9)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      *batch=request
      If *batch\reserved<>0 Or (*batch\ignoreCamera<>0 And *batch\ignoreCamera<>1) : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      ProcedureReturn NeonVkPortSpriteBatchAdd(*batch\x,*batch\y,*batch\w,*batch\h,*batch\angle,*batch\r,*batch\g,*batch\b,*batch\a,*batch\ignoreCamera)
    Case #NEON_SERVICE_SPRITE_BATCH_END
      If avsFrame<>1 Or avsBatch<>1 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
      If avsRecord(request,bytes,0)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      rc=NeonVkPortSpriteBatchEnd()
      If rc=0 : avsBatch=0 : Else : avsFrame=2 : EndIf
      ProcedureReturn rc
  EndSelect
  ProcedureReturn #NEON_SERVICE_ERR_ARGS
EndProcedure

; Optional mapped drawing reuses the resident port and its single GPU owner.
Procedure.i avsMappingRequest(op.i,request.i,bytes.i)
  Define *canvas.NeonServiceCanvasRequest,*clip.NeonServiceScissorRequest
  Define *box.NeonServiceMappedBoxRequest,*poly.NeonServiceMappedPolygonRequest
  Define *text.NeonServiceMappedTextRequest,*lines.NeonServiceStaticLinesRequest
  Define index.i,rc.i,count.i,needed.i
  If op=#NEON_SERVICE_CANVAS
    If avsFrame<>0 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
    If avsRecord(request,bytes,16)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    *canvas=request
    If *canvas\width<1 Or *canvas\height<1 Or *canvas\width>8192 Or *canvas\height>8192 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    rc=NeonVkTargetsBoundWidth() : count=NeonVkTargetsBoundHeight()
    If rc=0 : rc=avcLogicalW : count=avcLogicalH : EndIf
    rc=NeonVkPortCanvas(*canvas\width,*canvas\height,rc,count)
    If rc=0 : avsParticleReady=0 : EndIf
    ProcedureReturn rc
  EndIf
  If avsFrame<>1 Or avsBatch<>0 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
  Select op
    Case #NEON_SERVICE_SCISSOR_SET
      If avsRecord(request,bytes,16)=0 Or avsFloats(request,4)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      *clip=request
      rc=NeonVkPortScissorSet(*clip\x,*clip\y,*clip\w,*clip\h)
      If rc=0 : rc=NeonVkChromeError() : EndIf
    Case #NEON_SERVICE_SCISSOR_CLEAR
      If avsRecord(request,bytes,0)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      rc=NeonVkPortScissorClear()
      If rc=0 : rc=NeonVkChromeError() : EndIf
    Case #NEON_SERVICE_BOX_MAPPED
      If avsRecord(request,bytes,48)=0 Or avsFloats(request,8)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      *box=request
      If (*box\scaled<>0 And *box\scaled<>1) Or (*box\ignoreCamera<>0 And *box\ignoreCamera<>1) : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      rc=NeonVkPortBox(*box\x,*box\y,*box\w,*box\h,*box\r,*box\g,*box\b,*box\a,*box\scaled,*box\ignoreCamera)
    Case #NEON_SERVICE_POLYGON_MAPPED
      If avsRecord(request,bytes,64)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      If avsFloats(request,4)=0 Or avsFloats(request+24,4)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      *poly=request
      If (*poly\scaled<>0 And *poly\scaled<>1) Or (*poly\ignoreCamera<>0 And *poly\ignoreCamera<>1) Or (*poly\solid<>0 And *poly\solid<>1) : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      rc=NeonVkPortPolygon(*poly\x,*poly\y,*poly\rx,*poly\ry,*poly\sides,*poly\r,*poly\g,*poly\b,*poly\a,*poly\solid,*poly\scaled,*poly\ignoreCamera)
    Case #NEON_SERVICE_TEXT_MAPPED
      If avsRecord(request,bytes,56)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      If avsFloats(request+8,2)=0 Or avsFloats(request+24,4)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      *text=request : index=avsFontIndex(*text\font)
      If index<0 Or *text\text=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      If (*text\scaled<>0 And *text\scaled<>1) Or (*text\ignoreCamera<>0 And *text\ignoreCamera<>1) : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      If index=0
        rc=NeonVkPortText(*text\font,*text\x,*text\y,*text\text,*text\r,*text\g,*text\b,*text\a,*text\scaled,*text\ignoreCamera)
      Else
        rc=NeonVkPortFontText(@avsFont[index-1],*text\x,*text\y,*text\text,*text\r,*text\g,*text\b,*text\a,*text\scaled,*text\ignoreCamera)
      EndIf
    Case #NEON_SERVICE_STATIC_LINES
      If avsRecord(request,bytes,48)=0 Or avsFloats(request+24,4)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      *lines=request
      If *lines\vertexCount<0 Or *lines\vertexCount>#NEON_SERVICE_MAX_STATIC_LINE_VERTICES Or *lines\limitVertices<0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      needed=*lines\vertexCount*8
      If *lines\sourceBytes<needed : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      If needed>0
        If *lines\data<1 Or (*lines\data & 3)<>0 Or *lines\data+needed-1<*lines\data : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
        If InPayload(*lines\data,*lines\data+needed-1)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
        If avsFloats(*lines\data,*lines\vertexCount*2)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      EndIf
      rc=NeonVkPortStaticLines(*lines\data,*lines\vertexCount,*lines\r,*lines\g,*lines\b,*lines\a,*lines\limitVertices)
    Default
      ProcedureReturn #NEON_SERVICE_ERR_ARGS
  EndSelect
  ProcedureReturn rc
EndProcedure

Procedure avsEndProfile(start.i,afterGpu.i,result.i)
  Define finish.i,total.i,gpu.i,other.i
  finish=Ticks() : total=finish-start : gpu=afterGpu-start
  other=total-gpu-avcCopyDmaTicks-avcCopyCleanTicks-avcCopyPublishTicks
  avsEndFrames=avsEndFrames+1
  If result<>0 : avsEndFailed=avsEndFailed+1 : EndIf
  avsEndTotal[0]=avsEndTotal[0]+gpu
  avsEndTotal[1]=avsEndTotal[1]+avcCopyDmaTicks
  avsEndTotal[2]=avsEndTotal[2]+avcCopyCleanTicks
  avsEndTotal[3]=avsEndTotal[3]+avcCopyPublishTicks
  avsEndTotal[4]=avsEndTotal[4]+other
  avsEndTotal[5]=avsEndTotal[5]+total
  If avsEndFrames=1 Or total>avsEndWorst[5]
    avsEndWorstFrame=avsEndFrames : avsEndWorstRc=result
    avsEndWorst[0]=gpu : avsEndWorst[1]=avcCopyDmaTicks
    avsEndWorst[2]=avcCopyCleanTicks : avsEndWorst[3]=avcCopyPublishTicks
    avsEndWorst[4]=other : avsEndWorst[5]=total
  EndIf
EndProcedure

Procedure.i VulkanNeonServiceDispatch(op.i, context.i, request.i, bytes.i)
  Define *api.NeonServiceApi, *surface.NeonServiceSurface
  Define *box.NeonServiceBoxRequest, *text.NeonServiceTextRequest
  Define *measure.NeonServiceMeasureRequest, *polygon.NeonServicePolygonRequest
  Define *font.NeonServiceFontRequest, index.i, rc.i, pixels.i
  Define *spacing.NeonServiceFontAdvanceRequest
  Define *snap.NeonServiceFontSnapRequest
  Define *controls.NeonServiceFontControlsRequest
  Define *derive.NeonServiceFontDeriveRequest
  Define *caret.NeonServiceFontCaretRequest
  Define endStart.i,endAfterGpu.i,profileIndex.i,parentFrame.i
  Define *particleLimits.NeonServiceParticleLimits,*particlePrepare.NeonServiceParticlePrepareRequest,needed.i
  If op = #NEON_SERVICE_QUERY
    If context <> 0 Or avsRecord(request, bytes, SizeOf(NeonServiceApi)) = 0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    *api = request
    *api\magic = #NEON_SERVICE_MAGIC : *api\major = #NEON_SERVICE_MAJOR : *api\minor = #NEON_SERVICE_ROLE_CARETS_MINOR
    *api\bytes = SizeOf(NeonServiceApi) : *api\flags = #NEON_SERVICE_VULKAN | #NEON_SERVICE_FONT_REFS | #NEON_SERVICE_SPRITES | #NEON_SERVICE_FONT_BYTES | #NEON_SERVICE_PARTICLES | #NEON_SERVICE_MAPPING | #NEON_SERVICE_FONT_SPACING | #NEON_SERVICE_FONT_SNAP | #NEON_SERVICE_FONT_CONTROLS | #NEON_SERVICE_FONT_DERIVE | #NEON_SERVICE_TARGETS | #NEON_SERVICE_TARGET_CONTINUATION | #NEON_SERVICE_TARGET_LOAD | #NEON_SERVICE_TARGET_RETRO | #NEON_SERVICE_FONT_CARETS | #NEON_SERVICE_ROLE_CARETS
    *api\maxFonts = 32 : *api\dispatch = @GraphicsServiceCall
    ProcedureReturn 0
  EndIf
  If op = #NEON_SERVICE_OPEN
    If context <> 0 Or avsRecord(request, bytes, SizeOf(NeonServiceSurface)) = 0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    If avsContext <> 0 : ProcedureReturn #NEON_SERVICE_ERR_BUSY : EndIf
    If avsEpoch >= $7FFFFFFF : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
    avsEpoch = avsEpoch + 1 : avsContext = avsEpoch
    avsReady = 0 : avsFrame = 0 : avsFontCount = 0
    avsEndFrames=0 : avsEndFailed=0 : avsEndWorstFrame=0 : avsEndWorstRc=0
    For profileIndex=0 To 5 : avsEndTotal[profileIndex]=0 : avsEndWorst[profileIndex]=0 : Next
    avsParticleReady=0 : avsParticleCount=0
    avsPreviousFont=AnvilTrueTypeSlotSelected()
    avsPreviousFontGeneration=AnvilTrueTypeSlotGeneration(avsPreviousFont)
    *surface = request
    *surface\bytes = SizeOf(NeonServiceSurface) : *surface\logicalW = 0 : *surface\logicalH = 0
    *surface\flags = 0 : *surface\maxFonts = 0
    rc=NeonVkTargetsOpen(avsContext)
    If rc=0 : rc=VulkanConsoleStart() : EndIf
    ConNoRenderer() : *gBannerGpuInvalidate = 0
    If rc = 0 : rc = NeonVkPortCanvas(avcLogicalW, avcLogicalH, avcLogicalW, avcLogicalH) : EndIf
    If rc = 0
      avsReady = 1 : avsError = 0
      *surface\logicalW = avcLogicalW : *surface\logicalH = avcLogicalH
      *surface\flags = #NEON_SERVICE_VULKAN | #NEON_SERVICE_FONT_REFS | #NEON_SERVICE_SPRITES | #NEON_SERVICE_FONT_BYTES | #NEON_SERVICE_PARTICLES | #NEON_SERVICE_MAPPING | #NEON_SERVICE_FONT_SPACING | #NEON_SERVICE_FONT_SNAP | #NEON_SERVICE_FONT_CONTROLS | #NEON_SERVICE_FONT_DERIVE | #NEON_SERVICE_TARGETS | #NEON_SERVICE_TARGET_CONTINUATION | #NEON_SERVICE_TARGET_LOAD | #NEON_SERVICE_TARGET_RETRO | #NEON_SERVICE_FONT_CARETS | #NEON_SERVICE_ROLE_CARETS : *surface\maxFonts = 32
    Else
      avsError = rc
    EndIf
    ; Even failed startup returns ownership: invalid surface forces checked
    ; Close in the client. A refused Close must retain this context.
    ProcedureReturn avsContext
  EndIf
  If context = 0 Or context <> avsContext : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
  If op = #NEON_SERVICE_CLOSE
    If avsRecord(request, bytes, 0) = 0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    ProcedureReturn avsClose()
  EndIf
  If op = #NEON_SERVICE_ERROR
    If avsRecord(request, bytes, 0) = 0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    ProcedureReturn avsError
  EndIf
  If avsReady = 0 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
  If (op>=#NEON_SERVICE_TARGET_CREATE And op<=#NEON_SERVICE_TARGET_LIMITS) Or op=#NEON_SERVICE_TARGET_RETRO_PREPARE Or op=#NEON_SERVICE_TARGET_RETRO_DRAW
    If (op=#NEON_SERVICE_TARGET_BIND Or op=#NEON_SERVICE_TARGET_UNBIND) And avsBatch<>0 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
    parentFrame=NeonVkTargetsParentFrame()
    rc=NeonVkTargetsDispatch(op,context,request,bytes,avsFrame)
    If rc=0 And op=#NEON_SERVICE_TARGET_BIND : avsFrame=0 : EndIf
    If rc=0 And op=#NEON_SERVICE_TARGET_UNBIND : avsFrame=parentFrame : EndIf
    If op=#NEON_SERVICE_TARGET_BIND Or op=#NEON_SERVICE_TARGET_UNBIND : avsParticleReady=0 : EndIf
    If rc<0 And NeonVkTargetsFailed()<>0 : avsReady=0 : EndIf
    If op=#NEON_SERVICE_TARGET_CREATE And rc>0 : avsError=0 : ProcedureReturn rc : EndIf
    If rc>0 : rc=#NEON_SERVICE_ERR_PROVIDER : EndIf
    avsError=rc : ProcedureReturn rc
  EndIf
  If op>=#NEON_SERVICE_FONT_CARET_POINT And op<=#NEON_SERVICE_FONT_TEXT_COLUMN
    If avsFrame=2 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
    If avsRecord(request,bytes,SizeOf(NeonServiceFontCaretRequest))=0 Or NeonByteSpan(request,bytes)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    If InPayload(request,request+bytes-1)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    *caret=request : index=avsFontIndex(*caret\font)
    If index<0 : ProcedureReturn #NEON_SERVICE_ERR_STALE : EndIf
    If *caret\textBytes<1 Or *caret\textBytes>4096 Or NeonByteSpan(*caret\text,*caret\textBytes)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    If InPayload(*caret\text,*caret\text+*caret\textBytes-1)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    If index=0
      rc=NeonVkServiceCaret(op,0,*caret,bytes)
    Else
      rc=NeonVkServiceCaret(op,@avsFont[index-1],*caret,bytes)
    EndIf
    If rc>0 : rc=#NEON_SERVICE_ERR_PROVIDER : EndIf
    avsError=rc : ProcedureReturn rc
  EndIf
  If op=#NEON_SERVICE_FONT_DERIVE_CREATE
    If avsFrame<>0 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
    If avsRecord(request,bytes,SizeOf(NeonServiceFontDeriveRequest))=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    *derive=request : index=avsFontIndex(*derive\font)
    If index<1 Or *derive\role<0 Or *derive\role>3 Or *derive\pixels<1 Or *derive\pixels>512 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    If avsFontCount>=32 : ProcedureReturn #NEON_SERVICE_ERR_CAPACITY : EndIf
    rc=NeonVkPortFontDerive(@avsFont[avsFontCount],@avsFont[index-1],*derive\role,*derive\pixels)
    If rc<>0 : avsError=rc : ProcedureReturn rc : EndIf
    avsFontCount=avsFontCount+1 : avsError=0
    ProcedureReturn (avsContext << 16) | avsFontCount
  EndIf
  If op=#NEON_SERVICE_FONT_CONTROLS_SET
    If avsFrame<>0 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
    If avsRecord(request,bytes,SizeOf(NeonServiceFontControlsRequest))=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    *controls=request : index=avsFontIndex(*controls\font)
    If index<1 Or *controls\mode<0 Or *controls\mode>2 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    rc=NeonVkPortFontSetControlMode(@avsFont[index-1],*controls\mode)
    If rc>0 : rc=#NEON_SERVICE_ERR_PROVIDER : EndIf
    avsError=rc : ProcedureReturn rc
  EndIf
  If op=#NEON_SERVICE_FONT_SNAP_SET
    If avsFrame<>0 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
    If avsRecord(request,bytes,SizeOf(NeonServiceFontSnapRequest))=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    *snap=request : index=avsFontIndex(*snap\font)
    If index<1 Or *snap\enabled<0 Or *snap\enabled>1 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    rc=NeonVkPortFontSetSnapToPixel(@avsFont[index-1],*snap\enabled)
    If rc>0 : rc=#NEON_SERVICE_ERR_PROVIDER : EndIf
    avsError=rc : ProcedureReturn rc
  EndIf
  If op=#NEON_SERVICE_FONT_ADVANCE
    If avsFrame<>0 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
    If avsRecord(request,bytes,SizeOf(NeonServiceFontAdvanceRequest))=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    *spacing=request : index=avsFontIndex(*spacing\font)
    If index<1 Or *spacing\advanceQ16<0 Or *spacing\advanceQ16>536870912 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    rc=NeonVkPortFontSetFixedAdvanceQ16(@avsFont[index-1],*spacing\advanceQ16)
    If rc>0 : rc=#NEON_SERVICE_ERR_PROVIDER : EndIf
    avsError=rc : ProcedureReturn rc
  EndIf
  If op>=#NEON_SERVICE_CANVAS And op<=#NEON_SERVICE_STATIC_LINES
    rc=avsMappingRequest(op,request,bytes)
    If rc>0 : rc=#NEON_SERVICE_ERR_PROVIDER : EndIf
    avsError=rc : ProcedureReturn rc
  EndIf
  If op=#NEON_SERVICE_PARTICLE_LIMITS
    If avsRecord(request,bytes,SizeOf(NeonServiceParticleLimits))=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    *particleLimits=request : *particleLimits\maxCount=#NEON_SERVICE_MAX_PARTICLES
    *particleLimits\recordBytes=#NEON_SERVICE_PARTICLE_RECORD_BYTES : *particleLimits\coordinateFractionBits=8
    avsError=0 : ProcedureReturn 0
  EndIf
  If op=#NEON_SERVICE_PARTICLE_PREPARE
    If avsFrame<>0 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
    avsParticleReady=0
    If avsRecord(request,bytes,SizeOf(NeonServiceParticlePrepareRequest))=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    *particlePrepare=request
    If *particlePrepare\count<0 Or *particlePrepare\count>#NEON_SERVICE_MAX_PARTICLES Or *particlePrepare\sourceBytes<0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    needed=*particlePrepare\count*#NEON_SERVICE_PARTICLE_RECORD_BYTES
    If *particlePrepare\sourceBytes<needed : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    If needed>0
      If *particlePrepare\data<1 Or (*particlePrepare\data & 3)<>0 Or *particlePrepare\data+needed-1<*particlePrepare\data : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      If InPayload(*particlePrepare\data,*particlePrepare\data+needed-1)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    EndIf
    avsParticleCameraX=NeonVkPortCameraX() : avsParticleCameraY=NeonVkPortCameraY() : avsParticleCameraZoom=NeonVkPortCameraZoom()
    rc=NeonVkChromeParticlesPrepareFloat32(*particlePrepare\data,*particlePrepare\count,avsParticleCameraX,avsParticleCameraY,avsParticleCameraZoom)
    If rc=0 : avsParticleReady=1 : avsParticleCount=*particlePrepare\count : EndIf
    avsError=rc : ProcedureReturn rc
  EndIf
  If op=#NEON_SERVICE_PARTICLE_DRAW
    If avsFrame<>1 Or avsBatch<>0 Or avsParticleReady=0 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
    If avsRecord(request,bytes,0)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    If NeonVkPortCameraX()<>avsParticleCameraX Or NeonVkPortCameraY()<>avsParticleCameraY Or NeonVkPortCameraZoom()<>avsParticleCameraZoom : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
    rc=0
    If avsParticleCount>0 : rc=NeonVkChromeParticlesDrawPrepared() : EndIf
    avsError=rc : ProcedureReturn rc
  EndIf
  If op=#NEON_SERVICE_FONT_LOAD Or op=#NEON_SERVICE_FONT_UNLOAD
    rc=avsFontBytesRequest(op,request,bytes)
    If op=#NEON_SERVICE_FONT_LOAD And rc>0 : avsError=0 : ProcedureReturn rc : EndIf
    If rc>0 : rc=#NEON_SERVICE_ERR_PROVIDER : EndIf
    avsError=rc : ProcedureReturn rc
  EndIf
  If op>=#NEON_SERVICE_SPRITE_LIMITS And op<=#NEON_SERVICE_SPRITE_BATCH_END
    rc=avsSpriteRequest(op,request,bytes)
    If op=#NEON_SERVICE_SPRITE_UPLOAD And rc>0 : avsError=0 : ProcedureReturn rc : EndIf
    If rc>0 : rc=#NEON_SERVICE_ERR_PROVIDER : EndIf
    avsError=rc : ProcedureReturn rc
  EndIf
  If op = #NEON_SERVICE_WIDTH Or op = #NEON_SERVICE_HEIGHT Or op = #NEON_SERVICE_PREPARE
    If avsFrame = 2 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
    If avsRecord(request, bytes, 16) = 0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    *measure = request
    index = avsFontIndex(*measure\font)
    If index < 0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
    If op <> #NEON_SERVICE_PREPARE : ProcedureReturn avsMeasure(*measure\font, *measure\text, Bool(op = #NEON_SERVICE_HEIGHT)) : EndIf
    If avsFrame <> 0 Or *measure\text = 0 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
    If index = 0
      ; Raster cache keys use the face's pixel size, not its line-box spacing.
      pixels = NeonVkChromeFontPixelHeight(*measure\font)
      If pixels < 1 Or NeonVkChromeMeasureLineHeight(*measure\font) < 1 : ProcedureReturn #NEON_SERVICE_ERR_PROVIDER : EndIf
      rc = NeonVkChromeWarmTrueTypeText(pixels, *measure\text)
      If rc >= 0 : rc = 0 : EndIf
    Else
      rc = NeonVkPortFontWarm(@avsFont[index - 1], *measure\text)
    EndIf
    If rc > 0 : rc = #NEON_SERVICE_ERR_PROVIDER : EndIf
    avsError = rc : ProcedureReturn rc
  EndIf
  Select op
    Case #NEON_SERVICE_TARGET_BEGIN_LOAD
      If avsFrame<>0 Or NeonVkTargetsBound()=0 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
      If avsRecord(request,bytes,0)=0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      rc=NeonVkTargetsFrameBeginLoad()
      If rc=0 : avsFrame=1 : EndIf
    Case #NEON_SERVICE_BEGIN
      If avsFrame <> 0 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
      If avsRecord(request, bytes, 16) = 0 Or avsFloats(request, 4) = 0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      If NeonVkTargetsBound()<>0 : rc=NeonVkTargetsFrameBegin(request)
      Else : rc=NeonVkChromeBegin(request) : EndIf
      If rc = 0 : avsFrame = 1 : EndIf
    Case #NEON_SERVICE_END
      If avsFrame <> 1 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
      If avsBatch<>0 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
      If avsRecord(request, bytes, 0) = 0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      If NeonVkTargetsBound()<>0
        endStart=Ticks()
        rc=NeonVkTargetsFrameEnd()
        avcCopyDmaTicks=0 : avcCopyCleanTicks=0 : avcCopyPublishTicks=0
        If rc=0 : avsFrame=0 : Else : avsFrame=2 : EndIf
        avsEndProfile(endStart,Ticks(),rc)
        avsError=rc : ProcedureReturn rc
      EndIf
      avsFrame = 2
      avcCopyDmaTicks=0 : avcCopyCleanTicks=0 : avcCopyPublishTicks=0
      endStart=Ticks()
      rc = NeonVkChromeEnd()
      endAfterGpu=Ticks()
      If rc = 0
        rc = #AVC_ERR_PRESENT
        If NeonVkChromePresentValidate() = 1
          avcDisplayCopyPending = DmaReady()
          If avcCopyFullToDisplay() <> 0
            avcDisplayCopyPending = 0
            If NeonVkChromePresentConsume() = 1
              rc = 0 : avsFrame = 0
              If gScrSrc = #SCR_SRC_DSI : avcWsiPresentN = avcWsiPresentN + 1 : EndIf
            EndIf
          EndIf
        EndIf
      EndIf
      avsEndProfile(endStart,endAfterGpu,rc)
    Case #NEON_SERVICE_ABORT
      If avsFrame = 0 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
      If avsRecord(request, bytes, 0) = 0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      If NeonVkTargetsBound()<>0 : rc=NeonVkTargetsFrameAbort()
      Else : rc=NeonVkChromeAbort() : EndIf
      If rc = 0
        NeonVkPortSpriteFrameRetired() : avsBatch=0 : avsFrame=0
      Else
        avsFrame=2
      EndIf
    Case #NEON_SERVICE_FONT_REGISTER
      If avsFrame <> 0 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
      If avsRecord(request, bytes, 24) = 0 Or avsFontCount >= 32 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      *font = request
      rc = NeonVkPortFontBind(@avsFont[avsFontCount], *font\slot, *font\role, *font\pixels)
      If rc <> 0 : ProcedureReturn rc : EndIf
      avsFontCount = avsFontCount + 1
      ProcedureReturn (avsContext << 16) | avsFontCount
    Case #NEON_SERVICE_BOX
      If avsFrame <> 1 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
      If avsRecord(request, bytes, 32) = 0 Or avsFloats(request, 8) = 0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      *box = request
      rc = NeonVkPortBox(*box\x, *box\y, *box\w, *box\h, *box\r, *box\g, *box\b, *box\a, 1, 1)
    Case #NEON_SERVICE_TEXT
      If avsFrame <> 1 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
      If avsRecord(request, bytes, 40) = 0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      If avsFloats(request + 8, 2) = 0 Or avsFloats(request + 24, 4) = 0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      *text = request : index = avsFontIndex(*text\font)
      If index < 0 Or *text\text = 0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      If index = 0
        rc = NeonVkPortText(*text\font, *text\x, *text\y, *text\text, *text\r, *text\g, *text\b, *text\a, 1, 1)
      Else
        rc = NeonVkPortFontText(@avsFont[index - 1], *text\x, *text\y, *text\text, *text\r, *text\g, *text\b, *text\a, 1, 1)
      EndIf
    Case #NEON_SERVICE_POLYGON
      If avsFrame <> 1 : ProcedureReturn #NEON_SERVICE_ERR_STATE : EndIf
      If avsRecord(request, bytes, 48) = 0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      If avsFloats(request, 4) = 0 Or avsFloats(request + 24, 4) = 0 : ProcedureReturn #NEON_SERVICE_ERR_ARGS : EndIf
      *polygon = request
      rc = NeonVkPortPolygon(*polygon\x, *polygon\y, *polygon\rx, *polygon\ry, *polygon\sides, *polygon\r, *polygon\g, *polygon\b, *polygon\a, *polygon\solid, 1, 1)
    Default
      ProcedureReturn #NEON_SERVICE_ERR_ARGS
  EndSelect
  If rc > 0 : rc = #NEON_SERVICE_ERR_PROVIDER : EndIf
  avsError = rc
  ProcedureReturn rc
EndProcedure

; Registration installs callbacks only; it does not acquire a GPU or display.
GraphicsServiceBind(@VulkanNeonServiceDispatch, @VulkanNeonServiceReset)

Procedure avsEndProfileLine(worst.i,values.i)
  If worst=0 : Print("  total ticks: ") : Else : Print("  worst ticks: ") : EndIf
  Print("gpu ") : PrintDec(PeekI(values))
  Print(", dma ") : PrintDec(PeekI(values+8))
  Print(", clean ") : PrintDec(PeekI(values+16))
  Print(", publish ") : PrintDec(PeekI(values+24))
  Print(", other ") : PrintDec(PeekI(values+32))
  Print(", end ") : PrintDec(PeekI(values+40)) : PrintNl()
EndProcedure

Procedure CmdVkStat()
  Define hz.i, span.i, busy.i, share.i
  Print("  last Vulkan failure: stage ") : PrintDec(avcLastFailStage)
  Print(", console ") : PrintDec(avcLastFailReason)
  Print(", Chrome ") : PrintDec(avcLastFailChrome) : PrintNl()
  If gScrSrc = #SCR_SRC_DSI
    Print("  DSI frame-boundary presents since boot ") : PrintDec(gScrFramePresentN)
    Print(", restores ") : PrintDec(gScrFrameRestoreN)
    Print(", timeouts ") : PrintDec(gScrFrameTimeoutN) : PrintNl()
  EndIf
  Print("  completed private WSI source transactions since boot ") : PrintDec(avcWsiPresentN) : PrintNl()
  Print("  public surface targets checked since boot ") : PrintDec(avcSurfaceQueryN) : PrintNl()
  hz = TickHz()
  Print("Resident Neon End timings: frames ") : PrintDec(avsEndFrames)
  Print(", failed ") : PrintDec(avsEndFailed) : Print(", tick Hz ") : PrintDec(hz) : PrintNl()
  If avsEndFrames>0
    avsEndProfileLine(0,@avsEndTotal[0])
    Print("  worst End frame ") : PrintDec(avsEndWorstFrame)
    Print(", result ") : PrintDec(avsEndWorstRc) : PrintNl()
    avsEndProfileLine(1,@avsEndWorst[0])
  EndIf
  span = Ticks() - avcStatSince
  If avcActive = 0
    PrintN("The Vulkan console is not the active renderer now (type screen vulkan).")
  EndIf
  Print("Vulkan console frames over the last ")
  If hz > 0 : PrintDec(span / hz) : EndIf
  PrintN(" seconds:")
  avcStatLine("banner only: ", avcStatBannerN, avcStatBanner[0], avcStatBanner[1], avcStatBanner[2], hz)
  avcStatLine("whole frame: ", avcStatFullN, avcStatFull[0], avcStatFull[1], avcStatFull[2], hz)
  If avcStatBannerN > 0 And hz > 0
    Print("  of a banner frame's build, microseconds: starting the frame ")
    PrintDec(((avcStatBeginTicks / avcStatBannerN) * 1000000) / hz)
    Print(", the text ")
    PrintDec(((gVkBanTicksText / avcStatBannerN) * 1000000) / hz)
    Print(", the logo ")
    PrintDec(((gVkBanTicksLogo / avcStatBannerN) * 1000000) / hz)
    PrintNl()
  EndIf
  Print("  text layouts reused ") : PrintDec(nvcTTLCHits) : Print(", shaped afresh ") : PrintDec(nvcTTLCMisses) : PrintNl()
  nvcTTLCHits = 0 : nvcTTLCMisses = 0
  avcStatBeginTicks = 0 : gVkBanTicksText = 0 : gVkBanTicksLogo = 0
  busy = avcStatBanner[0] + avcStatBanner[1] + avcStatBanner[2] + avcStatFull[0] + avcStatFull[1] + avcStatFull[2]
  If span > 0
    share = (busy * 10000) / span
    Print("  their share of the time, the GPU waits included: ")
    PrintDec(share / 100) : Print(".") : PrintDec(share % 100) : PrintN("%")
  EndIf
  avcStatBannerN = 0 : avcStatFullN = 0
  avcStatBanner[0] = 0 : avcStatBanner[1] = 0 : avcStatBanner[2] = 0
  avcStatFull[0] = 0 : avcStatFull[1] = 0 : avcStatFull[2] = 0
  avcStatSince = Ticks()
EndProcedure
