; ======================================================================
;  hw_usb.pi4 - the Pi 4 HwUsb* backend. THE ONE FILE THAT KNOWS THE
;  VL805 + xHCI + Bulk-Only stack; the `usb` command above it knows only
;  the portable #HW_USB_* vocabulary in Anvil/Hal/hal.pbi.
;
;  This is the board side of the HwUsb* seam declared in Anvil/Hal/hal.pbi.
;  Anvil/Core/usb_cmd.pbi (the `usb` diagnostics command) calls these names
;  and never touches Xhci*, Msc*, Pcie* or Hid* directly; this file is thin
;  wrappers over the EXISTING host stack:
;
;    RaspberryPi4/Lib/pcie.pi4     the PCIe root complex and the VL805 id
;    RaspberryPi4/Lib/xhci.pi4     the xHCI host, ports, slots, descriptors
;    RaspberryPi4/Lib/usbmsc.pi4   the Bulk-Only mass-storage LUN
;    RaspberryPi4/Board/cursor_input.pi4  UsbEnumerate() - the ONE bring-up
;                                  and hub-aware attach walk, run once
;
;  IT EXPOSES, IT DOES NOT RE-DRIVE. Every device on this bus is brought
;  up exactly once by UsbEnumerate() - the same walk the cursor and the
;  boot stick already ride. This file adds no second enumeration and
;  resets no port; it reads back what that walk left in the stack's state
;  and, for the vendor/product/class the walk read but discarded, re-reads
;  the 18-byte device descriptor on endpoint zero. That re-read is a
;  read-only control transfer issued at the prompt, between HID polls, so
;  it disturbs neither the live cursor nor the mounted filesystem.
;
;  INCLUDE ORDER, and it is not arbitrary:
;    * Lib/pcie.pi4, Lib/xhci.pi4, Lib/usbmsc.pi4, Lib/hid.pi4 BEFORE this
;      file - they define the Xhci*/Msc*/Pcie*/Hid* entry points wrapped
;      here. board.pi4 lists all four far above (a library never includes
;      a library, house rule).
;    * Anvil/Hal/hal.pbi BEFORE this file - it defines the #HW_USB_*
;      vocabulary these wrappers return.
;    * RaspberryPi4/Board/cursor_input.pi4 BEFORE this file - it defines
;      UsbEnumerate(), the single bring-up HwUsbEnumerate() rides.
;
;  #CAP_USB IS 1 ON THIS BOARD, so this real backend is what runs. A board
;  that declares #CAP_USB = 0 provides no HwUsb backend and RequireCap in
;  Anvil/Core/usb_cmd.pbi refuses the command before any of these are
;  reached - so these wrappers never have to defend against being called
;  on a board with no USB host.
;
;  NOT HARDWARE-VERIFIED IN THIS SESSION. The underlying stack HAS run on
;  silicon (usbmsc.pi4's header records a real Samsung stick read and
;  written 2026-08-26, and xhci.pi4 records real port/descriptor reads);
;  this file is COMPILE-VERIFIED ONLY here. A real device listing is owed
;  a Pi 4 with a stick and/or a keyboard attached - the enumeration and
;  the descriptor re-reads cannot be exercised on a bench with no silicon.
; ======================================================================

; ----------------------------------------------------------------------
;  hwusb_MapSpeed - the controller's raw xHCI speed id, normalised to the
;  portable #HW_USB_SPEED_* vocabulary. xhci.pi4's #XHCI_SPEED_* are the
;  PORTSC-encoded values (FULL 1, LOW 2, HIGH 3, SUPER 4); undoing that
;  ordering here is exactly why the core is handed a #HW_USB_SPEED_* code
;  and not a raw port-status field.
; ----------------------------------------------------------------------
Procedure.i hwusb_MapSpeed(xs.i)
  Select xs
    Case #XHCI_SPEED_LOW
      ProcedureReturn #HW_USB_SPEED_LOW
    Case #XHCI_SPEED_FULL
      ProcedureReturn #HW_USB_SPEED_FULL
    Case #XHCI_SPEED_HIGH
      ProcedureReturn #HW_USB_SPEED_HIGH
    Case #XHCI_SPEED_SUPER
      ProcedureReturn #HW_USB_SPEED_SUPER
  EndSelect
  ProcedureReturn #HW_USB_SPEED_UNKNOWN
EndProcedure

; ======================================================================
;  THE DEVICE INVENTORY - one flat list of addressed devices.
;
;  The enumeration walk records what it found in three places - HID
;  handles, the "other" slot list, and the mass-storage slot - each
;  keyed differently. This flattens them into one slot-keyed table so the
;  `usb tree` command can walk devices without knowing any of that. Built
;  once (a bench does not hotplug), from the state the walk already left.
; ----------------------------------------------------------------------
#HWUSB_MAX = 16
Global Dim hwusb_slot.i[#HWUSB_MAX]
Global Dim hwusb_kind.i[#HWUSB_MAX]
Global Dim hwusb_speed.i[#HWUSB_MAX]
Global Dim hwusb_route.i[#HWUSB_MAX]
Global Dim hwusb_addr.i[#HWUSB_MAX]
Global Dim hwusb_vid.i[#HWUSB_MAX]
Global Dim hwusb_pid.i[#HWUSB_MAX]
Global Dim hwusb_class.i[#HWUSB_MAX]
Global hwusb_count.i = 0
Global hwusb_built.i = 0
Global Dim hwusb_desc.a[32]     ; a device descriptor, re-read per slot

Procedure.i hwusb_Find(slot.i)
  Define i.i
  i = 0
  While i < hwusb_count
    If hwusb_slot[i] = slot
      ProcedureReturn i
    EndIf
    i = i + 1
  Wend
  ProcedureReturn -1
EndProcedure

; Record one device by slot, reading back its speed, route, address and -
; via a fresh 18-byte device-descriptor read - its vendor, product and
; class. A slot already in the table is a COMPOSITE (a keyboard and a
; mouse on one receiver share a slot); promote OTHER to a concrete kind
; but never rewrite one concrete kind with another.
Procedure hwusb_Add(slot.i, kind.i)
  Define idx.i
  Define n.i
  If slot <= 0
    ProcedureReturn
  EndIf
  idx = hwusb_Find(slot)
  If idx >= 0
    If hwusb_kind[idx] = #HW_USB_KIND_OTHER And kind <> #HW_USB_KIND_OTHER
      hwusb_kind[idx] = kind
    EndIf
    ProcedureReturn
  EndIf
  If hwusb_count >= #HWUSB_MAX
    ProcedureReturn
  EndIf
  idx = hwusb_count
  hwusb_slot[idx]  = slot
  hwusb_kind[idx]  = kind
  hwusb_speed[idx] = #HW_USB_SPEED_UNKNOWN
  hwusb_route[idx] = 0
  hwusb_addr[idx]  = 0
  hwusb_vid[idx]   = -1
  hwusb_pid[idx]   = -1
  hwusb_class[idx] = -1
  ; XhciUseSlot restores this slot's recorded speed, one-tier route and
  ; endpoint-0 context, so speed/route/address are free. The descriptor
  ; is the part the walk did not keep; HidAttach already corrected this
  ; slot's ep0 max packet, so the full 18 bytes come back on every speed.
  If XhciUseSlot(slot) <> 0
    hwusb_speed[idx] = hwusb_MapSpeed(XhciSlotSpeed())
    hwusb_route[idx] = XhciSlotRoute()
    hwusb_addr[idx]  = XhciDeviceAddress()
    n = XhciGetDeviceDescriptor(@hwusb_desc[0], 18)
    If n >= 5
      hwusb_class[idx] = PeekA(@hwusb_desc[0] + 4)
    EndIf
    If n >= 12
      hwusb_vid[idx] = PeekA(@hwusb_desc[0] + 8) | (PeekA(@hwusb_desc[0] + 9) << 8)
      hwusb_pid[idx] = PeekA(@hwusb_desc[0] + 10) | (PeekA(@hwusb_desc[0] + 11) << 8)
    EndIf
  EndIf
  hwusb_count = idx + 1
EndProcedure

Procedure HwUsbBuild()
  Define h.i
  Define i.i
  Define slot.i
  Define proto.i
  Define kind.i
  If hwusb_built <> 0
    ProcedureReturn
  EndIf
  If XhciReady() = 0
    ProcedureReturn
  EndIf
  hwusb_count = 0
  ; The internal / root hub heads the list the way it heads the topology:
  ; every low/full-speed device on this controller hangs off it.
  If XhciHubSlot() <> 0
    hwusb_Add(XhciHubSlot(), #HW_USB_KIND_HUB)
  EndIf
  ; The HID devices, by their attached handles.
  h = 1
  While h <= #HID_MAX_DEVS
    slot = HidSlot(h)
    If slot <> 0
      proto = HidProtocol(h)
      If proto = #HID_PROTO_KEYBOARD
        kind = #HW_USB_KIND_KEYBOARD
      ElseIf proto = #HID_PROTO_MOUSE
        kind = #HW_USB_KIND_MOUSE
      Else
        kind = #HW_USB_KIND_OTHER
      EndIf
      hwusb_Add(slot, kind)
    EndIf
    h = h + 1
  Wend
  ; Every other addressed slot the walk noted but did not keep as HID.
  ; The mass-storage LUN is one of these; name it storage, the rest OTHER.
  i = 0
  While i < HidOtherCount()
    slot = HidOtherSlot(i)
    If slot <> 0 And slot = XhciBulkReady()
      hwusb_Add(slot, #HW_USB_KIND_STORAGE)
    Else
      hwusb_Add(slot, #HW_USB_KIND_OTHER)
    EndIf
    i = i + 1
  Wend
  ; Belt and braces: if a mass-storage LUN is up but its slot did not
  ; come through the "other" list, still name it.
  If XhciBulkReady() <> 0 And hwusb_Find(XhciBulkReady()) < 0
    hwusb_Add(XhciBulkReady(), #HW_USB_KIND_STORAGE)
  EndIf
  ; Leave the storage slot selected if there is one, so nothing that
  ; follows has to re-select it. Harmless when there is none.
  If XhciBulkReady() <> 0
    XhciUseSlot(XhciBulkReady())
  EndIf
  hwusb_built = 1
EndProcedure

; ======================================================================
;  THE SEAM - the HwUsb* entry points the core calls.
; ======================================================================

; The one-time bring-up. UsbEnumerate() starts PCIe and the xHCI host and
; runs the hub-aware attach walk exactly once; 1 if the host came up (with
; or without devices), 0 if PCIe or xHCI would not start.
Procedure.i HwUsbEnumerate()
  ProcedureReturn UsbEnumerate()
EndProcedure

; Ensure enumerated, build the inventory, return the device count - or -1
; if the host is not up (so the command can say so rather than print an
; empty tree).
Procedure.i HwUsbTree()
  If HwUsbEnumerate() = 0
    ProcedureReturn -1
  EndIf
  If XhciReady() = 0
    ProcedureReturn -1
  EndIf
  HwUsbBuild()
  ProcedureReturn hwusb_count
EndProcedure

; ---- the host controller ---------------------------------------------
Procedure.i HwUsbHostPresent() : ProcedureReturn XhciReady() : EndProcedure
Procedure.i HwUsbHostVid()     : ProcedureReturn XhciDeviceId() & $FFFF : EndProcedure
Procedure.i HwUsbHostPid()     : ProcedureReturn (XhciDeviceId() >> 16) & $FFFF : EndProcedure
Procedure.i HwUsbHostVersion() : ProcedureReturn XhciVersion() : EndProcedure
; The PCIe link to the VL805 and its firmware (Linux xhci-pci.c
; xhci_vl805_get_fw_version reads configuration offset $50).
Procedure.i HwUsbHostLinkSpeed() : ProcedureReturn PcieLinkSpeed() : EndProcedure
Procedure.i HwUsbHostLinkWidth() : ProcedureReturn PcieLinkWidth() : EndProcedure
Procedure.i HwUsbHostLinkSsc()   : ProcedureReturn PcieSscOk() : EndProcedure
Procedure.i HwUsbHostFirmware()  : ProcedureReturn PcieCfgRead32(1, 0, 0, $50) : EndProcedure

; ======================================================================
;  THE LINK, IN RAW WORDS - the seam behind `usb link`
; ======================================================================
;  WHY THIS EXISTS. `usb tree` prints one cooked sentence about the link,
;  and it ends "spread-spectrum clocking on". That sentence comes from a
;  boolean, and a boolean is indistinguishable from a constant to the
;  person reading it: it cannot say whether this driver turned spread
;  spectrum ON or merely found it on, whether the override bits it wrote
;  actually stuck, or what the link is running at underneath. A feature
;  proved by its own summary is not proved.
;
;  So the board publishes the registers themselves. The core prints rows
;  it is handed - a name, a raw word, the named fields inside it, and a
;  sentence saying what the upstream drivers leave there - and learns
;  nothing about Broadcom in the process. Every offset, every bit
;  position and every reference claim below is this file's, which is
;  where chip knowledge belongs.
;
;  READ LIVE WHERE THAT IS POSSIBLE. The eight controller registers are
;  read at the moment the command runs, so they are the machine's current
;  state and not a recollection. The two PHY registers cannot be: reaching
;  them means writing the MDIO block-select and driving a bus transaction,
;  which is a change to the link in order to observe the link. They are
;  captured inside pcie_SetSsc at the instant the reference sequence reads
;  them and handed back here unaltered.
; ----------------------------------------------------------------------
#HWUSB_LINK_SSC_CNTL   = 0
#HWUSB_LINK_SSC_STATUS = 1
#HWUSB_LINK_LNKCAP     = 2
#HWUSB_LINK_LNKCTL     = 3
#HWUSB_LINK_LNKSTA     = 4
#HWUSB_LINK_MISC_CTRL  = 5
#HWUSB_LINK_HARD_DEBUG = 6
#HWUSB_LINK_ROOT_CAP   = 7
#HWUSB_LINK_REVISION   = 8
#HWUSB_LINK_STATUS     = 9
#HWUSB_LINK_REGS       = 10

Procedure.i HwUsbLinkRegCount()
  ProcedureReturn #HWUSB_LINK_REGS
EndProcedure

Procedure.i HwUsbLinkRegName(r.i)
  Select r
    Case #HWUSB_LINK_SSC_CNTL   : ProcedureReturn "MDIO SSC_CNTL    PHY block $1100 register $02"
    Case #HWUSB_LINK_SSC_STATUS : ProcedureReturn "MDIO SSC_STATUS  PHY block $1100 register $01"
    Case #HWUSB_LINK_LNKCAP     : ProcedureReturn "LNKCAP           root complex capability block + $0C"
    Case #HWUSB_LINK_LNKCTL     : ProcedureReturn "LNKCTL           root complex capability block + $10"
    Case #HWUSB_LINK_LNKSTA     : ProcedureReturn "LNKSTA           root complex capability block + $12"
    Case #HWUSB_LINK_MISC_CTRL  : ProcedureReturn "MISC_CTRL        controller register $4008"
    Case #HWUSB_LINK_HARD_DEBUG : ProcedureReturn "HARD_DEBUG       controller register $4204"
    Case #HWUSB_LINK_ROOT_CAP   : ProcedureReturn "ROOT_CAP         controller register $04F8"
    Case #HWUSB_LINK_REVISION   : ProcedureReturn "MISC_REVISION    controller register $406C"
    Case #HWUSB_LINK_STATUS     : ProcedureReturn "PCIE_STATUS      controller register $4068"
  EndSelect
  ProcedureReturn "unknown register"
EndProcedure

; What the two upstream drivers leave in each register on a BCM2711, so
; that the reader is comparing rather than admiring. Every claim here was
; taken from the source on 2026-09-18 and is cited in the audit note.
Procedure.i HwUsbLinkRegNote(r.i)
  Select r
    Case #HWUSB_LINK_SSC_CNTL
      ProcedureReturn "both drivers set OVRD_EN and OVRD_VAL here and change nothing else; read back after the write, both standing at 1 is the proof the override took"
    Case #HWUSB_LINK_SSC_STATUS
      ProcedureReturn "read one millisecond after the override; both drivers require SSC and PLL_LOCK together and report a failure to enter spread spectrum if either is clear"
    Case #HWUSB_LINK_LNKCAP
      ProcedureReturn "this part is a single lane at up to 5.0 GT/s; ASPM_SUPPORT is 0 because this monitor advertises no low-power link state - Linux leaves 3 there and U-Boot never writes the field"
    Case #HWUSB_LINK_LNKCTL
      ProcedureReturn "neither driver programs ASPM control, common clock or a retrain on this root port, so all three read 0 after a clean train"
    Case #HWUSB_LINK_LNKSTA
      ProcedureReturn "the word usb tree prints in English: speed 2 is 5.0 GT/s, width 1 is one lane, and TRAINING must be 0 once the link is up"
    Case #HWUSB_LINK_MISC_CTRL
      ProcedureReturn "Linux sets burst 0 which is 128 bytes on this part, plus SCB_ACCESS_EN, CFG_READ_UR, RCB_MPS and RCB_64B; U-Boot sets the first three and has no RCB bits at all. SCB0_SIZE is the inbound window as log2(bytes) minus 15"
    Case #HWUSB_LINK_HARD_DEBUG
      ProcedureReturn "the safe clock policy is REFCLK_OVRD_EN and REFCLK_OVRD_OUT set with CLKREQ_DEBUG and L1SS_ENABLE clear; SERDES_IDDQ must be 0 or the physical layer is powered down"
    Case #HWUSB_LINK_ROOT_CAP
      ProcedureReturn "Linux writes L1SS_MODE 2 whenever it drives the reference clock, so that no endpoint is invited into an L1 substate behind a CLKREQ the root complex is holding"
    Case #HWUSB_LINK_REVISION
      ProcedureReturn "the controller's own revision word, read for the record; neither driver acts on it"
    Case #HWUSB_LINK_STATUS
      ProcedureReturn "both drivers require PHYLINKUP and DL_ACTIVE together before calling the link up, and PORT_IS_RC tells root complex from endpoint mode"
  EndSelect
  ProcedureReturn ""
EndProcedure

Procedure.i HwUsbLinkRegValue(r.i)
  Define v.i
  Select r
    Case #HWUSB_LINK_SSC_CNTL   : ProcedureReturn PcieSscCntlRaw()
    Case #HWUSB_LINK_SSC_STATUS : ProcedureReturn PcieSscStatusRaw()
    Case #HWUSB_LINK_LNKCAP     : ProcedureReturn PcieRcPeek($B8)
    Case #HWUSB_LINK_LNKCTL
      ; LNKCTL and LNKSTA are halfwords sharing one aligned word. Split it
      ; here rather than making the core know that.
      v = PcieRcPeek($BC)
      If v < 0
        ProcedureReturn -1
      EndIf
      ProcedureReturn v & $FFFF
    Case #HWUSB_LINK_LNKSTA
      v = PcieRcPeek($BC)
      If v < 0
        ProcedureReturn -1
      EndIf
      ProcedureReturn (v >> 16) & $FFFF
    Case #HWUSB_LINK_MISC_CTRL  : ProcedureReturn PcieRcPeek($4008)
    Case #HWUSB_LINK_HARD_DEBUG : ProcedureReturn PcieRcPeek($4204)
    Case #HWUSB_LINK_ROOT_CAP   : ProcedureReturn PcieRcPeek($04F8)
    Case #HWUSB_LINK_REVISION   : ProcedureReturn PcieRcPeek($406C)
    Case #HWUSB_LINK_STATUS     : ProcedureReturn PcieRcPeek($4068)
  EndSelect
  ProcedureReturn -1
EndProcedure

Procedure.i HwUsbLinkFieldCount(r.i)
  Select r
    Case #HWUSB_LINK_SSC_CNTL   : ProcedureReturn 2
    Case #HWUSB_LINK_SSC_STATUS : ProcedureReturn 2
    Case #HWUSB_LINK_LNKCAP     : ProcedureReturn 3
    Case #HWUSB_LINK_LNKCTL     : ProcedureReturn 3
    Case #HWUSB_LINK_LNKSTA     : ProcedureReturn 3
    Case #HWUSB_LINK_MISC_CTRL  : ProcedureReturn 6
    Case #HWUSB_LINK_HARD_DEBUG : ProcedureReturn 5
    Case #HWUSB_LINK_ROOT_CAP   : ProcedureReturn 1
    Case #HWUSB_LINK_REVISION   : ProcedureReturn 0
    Case #HWUSB_LINK_STATUS     : ProcedureReturn 3
  EndSelect
  ProcedureReturn 0
EndProcedure

Procedure.i HwUsbLinkFieldName(r.i, f.i)
  Select r
    Case #HWUSB_LINK_SSC_CNTL
      Select f
        Case 0 : ProcedureReturn "OVRD_EN         bit 15"
        Case 1 : ProcedureReturn "OVRD_VAL        bit 14"
      EndSelect
    Case #HWUSB_LINK_SSC_STATUS
      Select f
        Case 0 : ProcedureReturn "SSC             bit 10"
        Case 1 : ProcedureReturn "PLL_LOCK        bit 11"
      EndSelect
    Case #HWUSB_LINK_LNKCAP
      Select f
        Case 0 : ProcedureReturn "MAX_SPEED       bits 3:0"
        Case 1 : ProcedureReturn "MAX_WIDTH       bits 9:4"
        Case 2 : ProcedureReturn "ASPM_SUPPORT    bits 11:10"
      EndSelect
    Case #HWUSB_LINK_LNKCTL
      Select f
        Case 0 : ProcedureReturn "ASPM_CONTROL    bits 1:0"
        Case 1 : ProcedureReturn "RETRAIN_LINK    bit 5"
        Case 2 : ProcedureReturn "COMMON_CLOCK    bit 6"
      EndSelect
    Case #HWUSB_LINK_LNKSTA
      Select f
        Case 0 : ProcedureReturn "CURRENT_SPEED   bits 3:0"
        Case 1 : ProcedureReturn "NEGOTIATED_WIDTH bits 9:4"
        Case 2 : ProcedureReturn "LINK_TRAINING   bit 11"
      EndSelect
    Case #HWUSB_LINK_MISC_CTRL
      Select f
        Case 0 : ProcedureReturn "MAX_BURST       bits 21:20"
        Case 1 : ProcedureReturn "CFG_READ_UR     bit 13"
        Case 2 : ProcedureReturn "SCB_ACCESS_EN   bit 12"
        Case 3 : ProcedureReturn "RCB_MPS_MODE    bit 10"
        Case 4 : ProcedureReturn "RCB_64B_MODE    bit 7"
        Case 5 : ProcedureReturn "SCB0_SIZE       bits 31:27"
      EndSelect
    Case #HWUSB_LINK_HARD_DEBUG
      Select f
        Case 0 : ProcedureReturn "CLKREQ_DEBUG    bit 1"
        Case 1 : ProcedureReturn "REFCLK_OVRD_EN  bit 16"
        Case 2 : ProcedureReturn "REFCLK_OVRD_OUT bit 20"
        Case 3 : ProcedureReturn "L1SS_ENABLE     bit 21"
        Case 4 : ProcedureReturn "SERDES_IDDQ     bit 27"
      EndSelect
    Case #HWUSB_LINK_ROOT_CAP
      Select f
        Case 0 : ProcedureReturn "L1SS_MODE       bits 7:3"
      EndSelect
    Case #HWUSB_LINK_STATUS
      Select f
        Case 0 : ProcedureReturn "PHYLINKUP       bit 4"
        Case 1 : ProcedureReturn "DL_ACTIVE       bit 5"
        Case 2 : ProcedureReturn "PORT_IS_RC      bit 7"
      EndSelect
  EndSelect
  ProcedureReturn "unknown field"
EndProcedure

; The field's value, taken out of the SAME word the row printed. -1 when
; the register itself could not be read, so a field never shows a plausible
; zero for a register nothing answered.
Procedure.i HwUsbLinkFieldValue(r.i, f.i)
  Define v.i
  v = HwUsbLinkRegValue(r)
  If v < 0
    ProcedureReturn -1
  EndIf
  Select r
    Case #HWUSB_LINK_SSC_CNTL
      Select f
        Case 0 : ProcedureReturn (v >> 15) & 1
        Case 1 : ProcedureReturn (v >> 14) & 1
      EndSelect
    Case #HWUSB_LINK_SSC_STATUS
      Select f
        Case 0 : ProcedureReturn (v >> 10) & 1
        Case 1 : ProcedureReturn (v >> 11) & 1
      EndSelect
    Case #HWUSB_LINK_LNKCAP
      Select f
        Case 0 : ProcedureReturn v & $0F
        Case 1 : ProcedureReturn (v >> 4) & $3F
        Case 2 : ProcedureReturn (v >> 10) & 3
      EndSelect
    Case #HWUSB_LINK_LNKCTL
      Select f
        Case 0 : ProcedureReturn v & 3
        Case 1 : ProcedureReturn (v >> 5) & 1
        Case 2 : ProcedureReturn (v >> 6) & 1
      EndSelect
    Case #HWUSB_LINK_LNKSTA
      Select f
        Case 0 : ProcedureReturn v & $0F
        Case 1 : ProcedureReturn (v >> 4) & $3F
        Case 2 : ProcedureReturn (v >> 11) & 1
      EndSelect
    Case #HWUSB_LINK_MISC_CTRL
      Select f
        Case 0 : ProcedureReturn (v >> 20) & 3
        Case 1 : ProcedureReturn (v >> 13) & 1
        Case 2 : ProcedureReturn (v >> 12) & 1
        Case 3 : ProcedureReturn (v >> 10) & 1
        Case 4 : ProcedureReturn (v >> 7) & 1
        Case 5 : ProcedureReturn (v >> 27) & $1F
      EndSelect
    Case #HWUSB_LINK_HARD_DEBUG
      Select f
        Case 0 : ProcedureReturn (v >> 1) & 1
        Case 1 : ProcedureReturn (v >> 16) & 1
        Case 2 : ProcedureReturn (v >> 20) & 1
        Case 3 : ProcedureReturn (v >> 21) & 1
        Case 4 : ProcedureReturn (v >> 27) & 1
      EndSelect
    Case #HWUSB_LINK_ROOT_CAP
      Select f
        Case 0 : ProcedureReturn (v >> 3) & $1F
      EndSelect
    Case #HWUSB_LINK_STATUS
      Select f
        Case 0 : ProcedureReturn (v >> 4) & 1
        Case 1 : ProcedureReturn (v >> 5) & 1
        Case 2 : ProcedureReturn (v >> 7) & 1
      EndSelect
  EndSelect
  ProcedureReturn -1
EndProcedure

; ---- the root ports --------------------------------------------------
Procedure.i HwUsbPortCount()       : ProcedureReturn XhciMaxPorts() : EndProcedure
Procedure.i HwUsbPortConnected(p.i) : ProcedureReturn XhciPortConnected(p) : EndProcedure
Procedure.i HwUsbPortSpeed(p.i)    : ProcedureReturn hwusb_MapSpeed(XhciPortSpeed(p)) : EndProcedure
; PORTSC Port Link State (bits 8:5; 0 = U0) and PORTPMSC (U1 and U2 timeouts).
Procedure.i HwUsbPortLinkState(p.i)
  Define v.i
  v = XhciPortSc(p)
  If v < 0
    ProcedureReturn -1
  EndIf
  ProcedureReturn (v >> 5) & $0F
EndProcedure
Procedure.i HwUsbPortPowerTimeouts(p.i) : ProcedureReturn XhciPortPmsc(p) : EndProcedure

; ---- the internal / root hub -----------------------------------------
Procedure.i HwUsbHubPresent()   : ProcedureReturn Bool(XhciHubSlot() <> 0) : EndProcedure
Procedure.i HwUsbHubRootPort()  : ProcedureReturn XhciHubRootPort() : EndProcedure
Procedure.i HwUsbHubPorts()     : ProcedureReturn XhciHubPorts() : EndProcedure
Procedure.i HwUsbHubPortConnected(p.i) : ProcedureReturn XhciHubPortConnected(p) : EndProcedure
Procedure.i HwUsbHubPortSpeed(p.i)     : ProcedureReturn hwusb_MapSpeed(XhciHubPortSpeed(p)) : EndProcedure

; ======================================================================
;  THE CONTROL-TRANSFER SHIMS - this board's half of the USB core's seam
; ======================================================================
;  Anvil/Bus/usb_core.pbi carries the USB protocol for every board:
;  the descriptor fetches, the walk over a configuration descriptor, the
;  string reader and the class names. The one thing it cannot do for
;  itself is carry a control transfer, so this board hands it these two.
;
;  THE IN TAKES THE DESTINATION. The xHCI driver leaves a control IN's
;  bytes in its own bounce buffer for a second call to copy out; that is
;  an xHCI detail and it stays here. Handing the core a buffer it can
;  read immediately means there is no window in which a later transfer
;  can overwrite what an earlier one fetched - a shape that has already
;  cost this tree one very long evening.
; ----------------------------------------------------------------------
Procedure.i hwusb_CtrlIn(rt.i, req.i, val.i, idx.i, *dst, len.i)
  Define n.i
  n = XhciControlIn(rt, req, val, idx, len)
  If n < 0
    ProcedureReturn -1
  EndIf
  If n > 0 And *dst <> 0
    If XhciCopyIn(*dst, n) <= 0
      ProcedureReturn -1
    EndIf
  EndIf
  ProcedureReturn n
EndProcedure

Procedure.i hwusb_CtrlOut(rt.i, req.i, val.i, idx.i, *src, len.i)
  ProcedureReturn XhciControlOut(rt, req, val, idx, *src, len)
EndProcedure

; Called once, before anything enumerates. Idempotent, so a second caller
; costs two stores and changes nothing.
Procedure HwUsbBindCore()
  UsbCoreSetHost(@hwusb_CtrlIn, @hwusb_CtrlOut)
EndProcedure

; ======================================================================
;  THE RAW DESCRIPTOR VIEW - the seam behind `usb devices`
; ======================================================================
;  WHAT THE CORE GETS AND WHAT IT DOES NOT. It gets bytes: the device
;  descriptor, the configuration descriptor with everything nested under
;  it, and three strings already flattened to ASCII. It decodes every one
;  of them itself, which is why the listing is a CORE command and not a
;  Pi 4 command - nothing about an interface descriptor is specific to
;  this controller, this bus or this board, and a second copy of that
;  decoding written for the next board would be a defect (rule 30).
;
;  ONE DEVICE AT A TIME, ON DEMAND. The alternative is a store filled at
;  enumeration, which costs a kilobyte per slot for a command nobody may
;  ever type, and which goes stale the moment a device is reconfigured.
;  This loads the device the listing is about to print and then the next
;  one. The buffer is stated rather than hidden: #HWUSB_DESC_CFG_BYTES,
;  and a configuration descriptor longer than that is READ AS FAR AS IT
;  FITS and reported as truncated, never silently cut.
;
;  IS IT SAFE WHILE MASS STORAGE IS MOUNTED? YES, and it is the same
;  answer `usb tree` has been relying on since build 174: hwusb_Add above
;  already re-reads the 18-byte device descriptor of every slot at the
;  moment the command runs, including the boot stick's, and has done so
;  on every board run since. The reason it is safe is not that control
;  transfers are special - it is that this monitor is single-threaded.
;  No storage command is in flight while the console is running one, the
;  bulk rings are not touched here, and the event ring is drained by the
;  control transfer that owns it. What would NOT be safe is issuing these
;  from an interrupt or from a second core, and nothing does.
; ----------------------------------------------------------------------
; The board's whole remaining part: choose WHICH device, then let the USB
; core fetch and hold it. Everything that used to be here - the buffers,
; the two-step configuration read, the string flattening, the three-state
; string result - moved into Anvil/Bus/usb_core.pbi, because none of
; it is about this controller and the next board would have needed it all
; again (rule 30).
;
;  IS IT SAFE WHILE MASS STORAGE IS MOUNTED? YES, and it is the same
;  answer `usb tree` has relied on since build 174: hwusb_Add above
;  already re-reads the 18-byte device descriptor of every slot at the
;  moment the command runs, the boot stick's included, and has done so on
;  every board run since. The reason is not that control transfers are
;  special - it is that this monitor is single-threaded. No storage
;  command is in flight while the console is running one, the bulk rings
;  are not touched here, and the event ring is drained by the control
;  transfer that owns it. What would NOT be safe is issuing these from an
;  interrupt or from a second core, and nothing does.
Global hwusb_dLoaded.i = -1

Procedure.i HwUsbDescLoad(i.i)
  hwusb_dLoaded = -1
  If hwusb_Ok(i) = 0
    ProcedureReturn 0
  EndIf
  If XhciReady() = 0
    ProcedureReturn 0
  EndIf
  HwUsbBindCore()
  If XhciUseSlot(hwusb_slot[i]) = 0
    ProcedureReturn 0
  EndIf
  If UsbLoadDescriptors() = 0
    ProcedureReturn 0
  EndIf
  hwusb_dLoaded = i
  ProcedureReturn 1
EndProcedure

Procedure.i HwUsbDescLoaded()   : ProcedureReturn hwusb_dLoaded : EndProcedure

; The root port a device came in on, and the hub slot above it (0 when it
; is on a root port). Together with HwUsbDevRoute these make the port
; path: 3, or 1.4 for the fourth downstream port of a hub on root port 1.
Procedure.i HwUsbDevRootPort(i.i)
  If hwusb_Ok(i) = 0 : ProcedureReturn 0 : EndIf
  ProcedureReturn XhciDevicePort(hwusb_slot[i])
EndProcedure
Procedure.i HwUsbDevParent(i.i)
  If hwusb_Ok(i) = 0 : ProcedureReturn 0 : EndIf
  If hwusb_route[i] = 0 : ProcedureReturn 0 : EndIf
  ProcedureReturn XhciHubSlot()
EndProcedure

; Which driver, if any, has claimed one interface of one device. A
; POINTER to words the board owns, so the core neither knows nor invents
; the names of this board's drivers.
Procedure.i HwUsbDevIfaceDriver(i.i, ifnum.i)
  If hwusb_Ok(i) = 0 : ProcedureReturn "no driver" : EndIf
  If XhciBulkReady() <> 0 And XhciBulkReady() = hwusb_slot[i] And ifnum = MscInterface()
    ProcedureReturn "claimed by mass storage"
  EndIf
  If HidClaimsInterface(hwusb_slot[i], ifnum) <> 0
    ProcedureReturn "claimed by the human-interface driver"
  EndIf
  ProcedureReturn "no driver"
EndProcedure

; ---- the device inventory --------------------------------------------
Procedure.i HwUsbDevCount() : ProcedureReturn hwusb_count : EndProcedure

Procedure.i hwusb_Ok(i.i)
  If i < 0 Or i >= hwusb_count
    ProcedureReturn 0
  EndIf
  ProcedureReturn 1
EndProcedure

Procedure.i HwUsbDevSlot(i.i)
  If hwusb_Ok(i) = 0 : ProcedureReturn -1 : EndIf
  ProcedureReturn hwusb_slot[i]
EndProcedure
Procedure.i HwUsbDevKind(i.i)
  If hwusb_Ok(i) = 0 : ProcedureReturn #HW_USB_KIND_OTHER : EndIf
  ProcedureReturn hwusb_kind[i]
EndProcedure
Procedure.i HwUsbDevSpeed(i.i)
  If hwusb_Ok(i) = 0 : ProcedureReturn #HW_USB_SPEED_UNKNOWN : EndIf
  ProcedureReturn hwusb_speed[i]
EndProcedure
; The one-tier route: 0 means the device is on a root port; anything else
; is the downstream port number of the internal hub.
Procedure.i HwUsbDevRoute(i.i)
  If hwusb_Ok(i) = 0 : ProcedureReturn 0 : EndIf
  ProcedureReturn hwusb_route[i]
EndProcedure
Procedure.i HwUsbDevAddress(i.i)
  If hwusb_Ok(i) = 0 : ProcedureReturn 0 : EndIf
  ProcedureReturn hwusb_addr[i]
EndProcedure
Procedure.i HwUsbDevVid(i.i)
  If hwusb_Ok(i) = 0 : ProcedureReturn -1 : EndIf
  ProcedureReturn hwusb_vid[i]
EndProcedure
Procedure.i HwUsbDevPid(i.i)
  If hwusb_Ok(i) = 0 : ProcedureReturn -1 : EndIf
  ProcedureReturn hwusb_pid[i]
EndProcedure
Procedure.i HwUsbDevClass(i.i)
  If hwusb_Ok(i) = 0 : ProcedureReturn -1 : EndIf
  ProcedureReturn hwusb_class[i]
EndProcedure

; ---- the mass-storage LUN --------------------------------------------
Procedure.i HwUsbStorageReady()      : ProcedureReturn MscReady() : EndProcedure
Procedure.i HwUsbStorageVendor()     : ProcedureReturn MscVendor() : EndProcedure
Procedure.i HwUsbStorageProduct()    : ProcedureReturn MscProduct() : EndProcedure
Procedure.i HwUsbStorageBlockSize()  : ProcedureReturn MscBlockSize() : EndProcedure
Procedure.i HwUsbStorageBlockCount() : ProcedureReturn MscBlockCount() : EndProcedure
Procedure.i HwUsbStorageError()      : ProcedureReturn MscErrorText() : EndProcedure

; ---- the raw block read ----------------------------------------------
; A raw block read IS exposed on this board: usbmsc.pi4 gives MscReadBlock,
; which range-checks the LBA and bounces through an aligned DMA buffer.
Procedure.i HwUsbReadAvailable() : ProcedureReturn 1 : EndProcedure

Procedure.i HwUsbReadBlock(lba.i, *buf)
  If XhciBulkReady() = 0
    ProcedureReturn 0
  EndIf
  ProcedureReturn MscReadBlock(lba, *buf)
EndProcedure

; A run of blocks - as few READ (10) commands as usbmsc.pi4 allows
; (#MSC_XFER_BLOCKS per command). What `usb read` uses, so the raw
; instrument measures the same transport the filesystems ride.
Procedure.i HwUsbReadBlocks(lba.i, count.i, *buf)
  If XhciBulkReady() = 0
    ProcedureReturn 0
  EndIf
  ProcedureReturn MscReadBlocks(lba, count, *buf)
EndProcedure

; ======================================================================
;  THE ENUMERATION WALK'S WITNESS, passed straight through.
;
;  The walk lives in Lib/hid.pi4 and records one row per port it stopped
;  at, with the PORTSC word, how far the port got, the driver's error
;  code and the controller's last completion code. `usb tree` prints it
;  when nothing was addressed, or when some port stopped short. See the
;  block over #HID_WALK_MAX.
;
;  These are pass-throughs and deliberately so: the core command must not
;  include hid.pi4, and a board with no such walk answers zero rows and
;  the report simply does not print.
; ======================================================================
; ----------------------------------------------------------------------
;  THE WAIT LEDGER, straight through. Every row is the driver's own, and
;  the seam adds nothing to it - a board layer that computed anything here
;  would be a second opinion about a measurement, which is the one thing a
;  measurement cannot have.
; ----------------------------------------------------------------------
Procedure.i HwUsbWaitCount()      : ProcedureReturn XhciWaitSites()      : EndProcedure
Procedure.i HwUsbWaitName(i.i)    : ProcedureReturn XhciWaitName(i)      : EndProcedure
Procedure.i HwUsbWaitVisits(i.i)  : ProcedureReturn XhciWaitCount(i)     : EndProcedure
Procedure.i HwUsbWaitTotalUs(i.i) : ProcedureReturn XhciWaitUs(i)        : EndProcedure
Procedure.i HwUsbWaitWorstUs(i.i) : ProcedureReturn XhciWaitWorstUs(i)   : EndProcedure
Procedure.i HwUsbWaitFirstUs(i.i) : ProcedureReturn XhciWaitFirstUs(i)   : EndProcedure
Procedure.i HwUsbWaitLastUs(i.i)  : ProcedureReturn XhciWaitLastUs(i)    : EndProcedure
Procedure.i HwUsbWaitBytes()      : ProcedureReturn XhciWaitBulkBytes()  : EndProcedure
Procedure HwUsbWaitLedgerReset()  : XhciWaitLedgerReset()                : EndProcedure

; bMaxBurst as the two bulk endpoints were actually configured, which is
; not always what the companion descriptor said: a mass-storage bulk OUT
; behind a hub is forced to 0 on this controller (the VL805 errata Linux
; calls XHCI_VLI_SS_BULK_OUT_BUG). Printing the CONFIGURED value rather
; than the descriptor's is the difference between what the hardware is
; doing and what it was asked to do.
Procedure.i HwUsbStorageUas()       : ProcedureReturn MscUasAdvertised()    : EndProcedure
Procedure.i HwUsbStorageConfigLen() : ProcedureReturn MscConfigLength()     : EndProcedure
Procedure.i HwUsbStorageProtocol()  : ProcedureReturn MscInterfaceProtocol(): EndProcedure

Procedure.i HwUsbBurstOut()       : ProcedureReturn XhciBurstOut()       : EndProcedure
Procedure.i HwUsbBurstIn()        : ProcedureReturn XhciBurstIn()        : EndProcedure

Procedure.i HwUsbWalkCount()      : ProcedureReturn HidWalkCount()      : EndProcedure
Procedure.i HwUsbWalkPort(i.i)    : ProcedureReturn HidWalkPort(i)      : EndProcedure
Procedure.i HwUsbWalkIsHub(i.i)   : ProcedureReturn HidWalkIsHub(i)     : EndProcedure
Procedure.i HwUsbWalkPortsc(i.i)  : ProcedureReturn HidWalkPortsc(i)    : EndProcedure
Procedure.i HwUsbWalkStep(i.i)    : ProcedureReturn HidWalkStep(i)      : EndProcedure
Procedure.i HwUsbWalkErr(i.i)     : ProcedureReturn HidWalkErr(i)       : EndProcedure
Procedure.i HwUsbWalkComp(i.i)    : ProcedureReturn HidWalkComp(i)      : EndProcedure
Procedure.i HwUsbWalkSlot(i.i)    : ProcedureReturn HidWalkSlot(i)      : EndProcedure
Procedure.i HwUsbWalkStepText(s.i): ProcedureReturn HidWalkStepText(s)  : EndProcedure
Procedure.i HwUsbWalkUsbSts()     : ProcedureReturn HidWalkUsbSts()     : EndProcedure
Procedure.i HwUsbWalkUsbCmd()     : ProcedureReturn HidWalkUsbCmd()     : EndProcedure
; The driver's own error sentence for a code the walk recorded, so the
; core command never has to know what an xHCI error number means.
Procedure.i HwUsbWalkErrText(c.i)
  ProcedureReturn XhciErrorTextOf(c)
EndProcedure
; 1 if this port got all the way to being addressed, 0 if the walk
; stopped short of it. A predicate rather than an exported constant,
; because the shared command must not have to know hid.pi4's step
; numbering to ask the only question it actually has.
Procedure.i HwUsbWalkReached(i.i)
  ProcedureReturn Bool(HidWalkStep(i) = #HID_STEP_OK)
EndProcedure
