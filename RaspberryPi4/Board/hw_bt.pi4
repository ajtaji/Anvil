; ======================================================================
;  hw_bt.pi4 - the HwBt* seam (Anvil/Hal/hal.pbi): the Bluetooth HCI UART
;  as a byte pipe, for Anvil/Net/hci.pbi. Thin wrappers that pick the
;  chip's host file:
;    BCM2712 (Pi 5)  RaspberryPi4/Lib/bt_uart_7271.pi4 - uarta, a 16550-
;                    class brcm,bcm7271-uart; the board must first say the
;                    pinctrl stepping with Bt7SetPinctrl(1 = C0 / 2 = D0)
;    BCM2711 (Pi 4)  RaspberryPi4/Lib/bt_uart.pi4 - the PL011 on GPIO 30-33
;  The board includes exactly one of those two, under the same
;  CompilerIf #PMF_CHIP = 2712, before this file.
;  THE PI 4 LENDS ITS CONSOLE (2026-10-16): the console's PL011 is the
;  only one that reaches the controller, so HwBtOpen borrows it
;  (bt_uart.pi4, THE BORROW) and tells uart.pi4 the PL011 is lent: the
;  serial wire goes quiet until HwBtClose, the screen and the network
;  console keep every line. The Pi 5's Bluetooth UART is its own.
; ======================================================================
CompilerIf #PMF_CHIP = 2712

Procedure.i HwBtOpen()
  ProcedureReturn Bt7Open()
EndProcedure

Procedure HwBtClose()
  Bt7Close()
EndProcedure

Procedure.i HwBtPut(b.i)
  ProcedureReturn Bt7Put(b)
EndProcedure

Procedure.i HwBtGet()
  ProcedureReturn Bt7Get()
EndProcedure

Procedure.i HwBtSetBaud(baud.i)
  ProcedureReturn Bt7SetBaud(baud)
EndProcedure

Procedure.i HwBtWhy()
  ProcedureReturn Bt7Why()
EndProcedure

Procedure.i HwBtConsoleLent()
  ProcedureReturn 0
EndProcedure

Procedure HwBtDiag()
  PrintN("No Pi 5 Bluetooth diagnostics yet.")
EndProcedure

CompilerElse

Procedure.i HwBtOpen()
  Define lend.i
  BtuMayBorrowConsole(1)
  lend = BtuConsoleOnPl011()
  If lend <> 0 : UartLend(1) : EndIf
  If BtuOpen() = 0
    UartLend(0)
    ProcedureReturn 0
  EndIf
  ProcedureReturn 1
EndProcedure

Procedure HwBtClose()
  BtuClose()
  UartLend(0)
EndProcedure

; 1 while the serial console is lent to Bluetooth (the Pi 4 only).
Procedure.i HwBtConsoleLent()
  ProcedureReturn BtuBorrowed()
EndProcedure

; `bt diag`: what the PL011, the pins and BT_ON say right now.
Procedure HwBtDiag()
  Print("BT_ON reads ")
  PrintDec(BtuPowerState())
  Print(" (before the first open: ")
  PrintDec(btu_powerBefore)
  Print(", mailbox failures ")
  PrintDec(btu_powerErr)
  Print("); UART open ")
  PrintDec(btu_open)
  Print(", console lent ")
  PrintDec(btu_borrowed)
  PrintN(".")
  Print("PL011 FR ")
  PrintDec(BtuRd(#BTU_FR) & $FFFF)
  Print(" CR ")
  PrintDec(BtuRd(#BTU_CR) & $FFFF)
  Print(" IBRD ")
  PrintDec(BtuRd(#BTU_IBRD))
  Print(" FBRD ")
  PrintDec(BtuRd(#BTU_FBRD))
  Print(" LCRH ")
  PrintDec(BtuRd(#BTU_LCRH) & $FF)
  Print("; GPIO 30-33 functions ")
  PrintDec(PinModeGet(30))
  Print(" ")
  PrintDec(PinModeGet(31))
  Print(" ")
  PrintDec(PinModeGet(32))
  Print(" ")
  PrintDec(PinModeGet(33))
  Print(" (ALT3 = ")
  PrintDec(#PIN_ALT3)
  Print("), 14/15 ")
  PrintDec(PinModeGet(14))
  Print(" ")
  PrintDec(PinModeGet(15))
  Print(", CTS (GPIO 30) level ")
  PrintDec(DigitalRead(30))
  PrintN(".")
EndProcedure

Procedure.i HwBtPut(b.i)
  ProcedureReturn BtuPut(b)
EndProcedure

Procedure.i HwBtGet()
  ProcedureReturn BtuGet()
EndProcedure

Procedure.i HwBtSetBaud(baud.i)
  ProcedureReturn BtuSetBaud(baud)
EndProcedure

Procedure.i HwBtWhy()
  ProcedureReturn BtuWhy()
EndProcedure

CompilerEndIf
