; Pi radio maintenance provider. Included after the existing Wi-Fi driver.
XIncludeFile "Anvil/Services/wifi_maintenance.pbi"
Procedure.i HwWifiMaintenanceDispatch(operation.i)
  Select operation
    Case #WIFI_MAINTENANCE_TICK : WifiLinkTick()
    Case #WIFI_MAINTENANCE_CHECK_NOW : WifiLinkCheckNow()
  EndSelect
  ProcedureReturn 0
EndProcedure
WifiMaintenanceBind(@HwWifiMaintenanceDispatch)
