; RAM-only Pi 4 Vulkan pyramid proof with a positive viewport offset.
; The final frame uses a 400x640 viewport at (200,320) and matching scissor.

EnableFloatingPoint
#VTP_BLEND_PROOF = 0
#VTP_LIST_PROOF = 1
#VTP_INDEXED_PROOF = 0
#VTP_PYRAMID_DEMO = 3
XIncludeFile "RaspberryPi4/Examples/Diagnostics/vulkanTriangleProofBody.pbi"
