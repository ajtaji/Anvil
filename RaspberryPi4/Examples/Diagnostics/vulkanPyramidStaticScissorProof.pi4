; RAM-only Pi 4 proof of dynamic viewport with independent static scissor.
; The final viewport is (200,320) 400x640; the scissor clips it to 200x640.

EnableFloatingPoint
#VTP_BLEND_PROOF = 0
#VTP_LIST_PROOF = 1
#VTP_INDEXED_PROOF = 0
#VTP_PYRAMID_DEMO = 4
XIncludeFile "RaspberryPi4/Examples/Diagnostics/vulkanTriangleProofBody.pbi"
