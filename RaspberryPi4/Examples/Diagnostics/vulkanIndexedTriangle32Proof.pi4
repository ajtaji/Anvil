; Pi 4 UINT32 indexed triangle proof. Diagnostic only.
; Two public indexed draws use a byte-eight index bind and firstIndex one.
; The selected indices are 2,0,1; the byte-four draw offset and adjacent
; V3D index setup/draw packets are checked by the shared body.
; No display hold is used, so a returning RAM run fits the short deadman.

#VTP_BLEND_PROOF = 0
#VTP_LIST_PROOF = 0
#VTP_INDEXED_PROOF = 2
#VTP_PYRAMID_DEMO = 0
XIncludeFile "RaspberryPi4/Examples/Diagnostics/vulkanTriangleProofBody.pbi"
