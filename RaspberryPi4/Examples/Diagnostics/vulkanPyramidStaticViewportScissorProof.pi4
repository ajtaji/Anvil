; RAM-only Pi 4 proof of independent static viewport and scissor.
; The viewport is (200,320) 400x640; the scissor clips it to 200x640.

EnableFloatingPoint
#VTP_BLEND_PROOF = 0
#VTP_LIST_PROOF = 1
#VTP_INDEXED_PROOF = 0
#VTP_PYRAMID_DEMO = 5
XIncludeFile "RaspberryPi4/Examples/Diagnostics/vulkanTriangleProofBody.pbi"
