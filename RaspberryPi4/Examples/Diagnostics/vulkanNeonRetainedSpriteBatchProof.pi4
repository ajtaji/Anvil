; Returning Pi 4 proof for a retained ordered sprite batch.
; Run only under Anvil's armed deadman. No boot or storage writes.
; Build with --entry-returns. x0 returns global_nmsreport from the NEW .sym.
; Read exactly 256 report bytes; the payload checks draw order and frame pixels.

XIncludeFile "RaspberryPi4/Lib/uart.pi4"
XIncludeFile "RaspberryPi4/Lib/timer.pi4"
XIncludeFile "RaspberryPi4/Lib/safety.pi4"
XIncludeFile "RaspberryPi4/Lib/mailbox.pi4"
#DSP_DMA_LINKED = 1
XIncludeFile "RaspberryPi4/Lib/dma.pi4"
XIncludeFile "RaspberryPi4/Lib/display.pi4"
XIncludeFile "RaspberryPi4/Lib/v3dqpu.pi4"
XIncludeFile "RaspberryPi4/Lib/v3d.pi4"
XIncludeFile "RaspberryPi4/Lib/neon.pi4"
XIncludeFile "Anvil/Graphics/Vulkan/vk_api.pbi"
XIncludeFile "Anvil/Graphics/Vulkan/vk_spirv_fixtures.pbi"
XIncludeFile "Anvil/Graphics/Vulkan/vk_v3d_shader.pi4"
XIncludeFile "RaspberryPi4/Board/vulkan_dma.pi4"
XIncludeFile "Anvil/Graphics/Vulkan/vk_v3d_backend.pi4"
XIncludeFile "Anvil/Graphics/Vulkan/neon_vk_chrome.pi4"

#NMS_SIZE         = 64
#NMS_ARENA        = $0A000000
#NMS_ARENA_BYTES  = $01000000
#NMS_SURFACE      = $06000000
#NMS_WINDOW       = $063E8000
#NMS_WINDOW_BYTES = $00C00000
#NMS_MAGIC        = $4D42524E

Global Dim nmsReport.l[64]
Global Dim nrbCapture.l[4096]
Global Dim nmsImagePixels.a[64]
Global Dim nmsPixels.a[16]
Global Dim nmsPixelsA.a[16]
Global Dim nmsPixelsABgra.a[16]
Global Dim nmsPixelsB.a[16]
Global Dim nmsPixelsOddBgra.a[12]
Global Dim nmsWide.a[1912]
Global Dim nmsLarge.a[491520]
Global Dim nmsRejectPixels.a[4194303]
Global Dim nmsClear.l[4]
Global Dim nmsLiveImages.i[17]
Global Dim nmsLiveSets.i[17]
Global nmsInstance.i, nmsDevice.i, nmsPool.i, nmsImage.i, nmsMemory.i
Global nmsView.i, nmsPass.i, nmsFrame.i, nmsAdapter.i, nmsNeon.i

Procedure nmsCleanup()
  If nmsAdapter <> 0 : NeonVkChromeDestroy() : EndIf
  NeonVkChromeSpriteSource(0, 0, 0)
  NeonVkChromeSpriteRegister(1, 0, 0, 0)
  NeonVkChromeSpriteRegister(2, 0, 0, 0)
  NeonVkChromeSpriteRegister(11, 0, 0, 0)
  If nmsDevice <> 0 : vkDeviceWaitIdle(nmsDevice) : EndIf
  If nmsFrame <> 0 : vkDestroyFramebuffer(nmsDevice, nmsFrame, 0) : EndIf
  If nmsPass <> 0 : vkDestroyRenderPass(nmsDevice, nmsPass, 0) : EndIf
  If nmsView <> 0 : vkDestroyImageView(nmsDevice, nmsView, 0) : EndIf
  If nmsImage <> 0 : vkDestroyImage(nmsDevice, nmsImage, 0) : EndIf
  If nmsMemory <> 0 : vkFreeMemory(nmsDevice, nmsMemory, 0) : EndIf
  If nmsPool <> 0 : vkDestroyCommandPool(nmsDevice, nmsPool, 0) : EndIf
  If nmsDevice <> 0 : vkDestroyDevice(nmsDevice, 0) : EndIf
  If nmsInstance <> 0 : vkDestroyInstance(nmsInstance, 0) : EndIf
  If nmsNeon <> 0 : NeonShutdown() : EndIf
EndProcedure

Procedure.i nmsReturn(status.i)
  nmsReport[1] = status
  nmsReport[13] = AnvilVkFaultCount()
  nmsReport[14] = AnvilVkFaultText()
  nmsCleanup()
  ProcedureReturn @nmsReport[0]
EndProcedure

Procedure.i nmsPixel(base.i, pitch.i, x.i, y.i)
  ProcedureReturn PeekL(base + y * pitch + x * 4) & $FFFFFFFF
EndProcedure

Procedure.i nmsWord(slot.i)
  ProcedureReturn nmsReport[slot] & $FFFFFFFF
EndProcedure

Procedure.i Main()
  Define rc.i, count.i, phys.i, queue.i, base.i, pitch.i, green.i
  Define id.i, j.i, index.i, ox.i, oy.i, imageHandle.i, setHandle.i
  Define residentImage.i, residentMemory.i, residentView.i, residentSet.i
  Define resident2Image.i, resident2Memory.i, resident2View.i, resident2Set.i
  Define ici.VkInstanceCreateInfo
  Define qci.VkDeviceQueueCreateInfo
  Define dci.VkDeviceCreateInfo
  Define pci.VkCommandPoolCreateInfo
  Define imageInfo.VkImageCreateInfo
  Define req.VkMemoryRequirements
  Define alloc.VkMemoryAllocateInfo
  Define viewInfo.VkImageViewCreateInfo
  Define attachment.VkAttachmentDescription
  Define attachmentRef.VkAttachmentReference
  Define subpass.VkSubpassDescription
  Define passInfo.VkRenderPassCreateInfo
  Define frameInfo.VkFramebufferCreateInfo
  Define priority.l

  nmsReport[0] = #NMS_MAGIC
  nmsReport[15] = #NMS_MAGIC
  ; Top row: opaque red, half-alpha green. Bottom row: invisible blue,
  ; opaque white. Explicit bytes avoid image-decoder and host pixel layouts.
  nmsPixels[0] = 255 : nmsPixels[1] = 0 : nmsPixels[2] = 0 : nmsPixels[3] = 255
  nmsPixels[4] = 0 : nmsPixels[5] = 255 : nmsPixels[6] = 0 : nmsPixels[7] = 128
  nmsPixels[8] = 0 : nmsPixels[9] = 0 : nmsPixels[10] = 255 : nmsPixels[11] = 0
  nmsPixels[12] = 255 : nmsPixels[13] = 255 : nmsPixels[14] = 255 : nmsPixels[15] = 255
  nmsPixelsA[0] = 255 : nmsPixelsA[1] = 0 : nmsPixelsA[2] = 0 : nmsPixelsA[3] = 255
  nmsPixelsA[4] = 0 : nmsPixelsA[5] = 255 : nmsPixelsA[6] = 0 : nmsPixelsA[7] = 255
  nmsPixelsA[8] = 0 : nmsPixelsA[9] = 0 : nmsPixelsA[10] = 255 : nmsPixelsA[11] = 255
  nmsPixelsA[12] = 255 : nmsPixelsA[13] = 255 : nmsPixelsA[14] = 255 : nmsPixelsA[15] = 255
  ; The same 2x2 image in BGRA byte order exercises the direct staging copy.
  nmsPixelsABgra[0] = 0 : nmsPixelsABgra[1] = 0 : nmsPixelsABgra[2] = 255 : nmsPixelsABgra[3] = 255
  nmsPixelsABgra[4] = 0 : nmsPixelsABgra[5] = 255 : nmsPixelsABgra[6] = 0 : nmsPixelsABgra[7] = 255
  nmsPixelsABgra[8] = 255 : nmsPixelsABgra[9] = 0 : nmsPixelsABgra[10] = 0 : nmsPixelsABgra[11] = 255
  nmsPixelsABgra[12] = 255 : nmsPixelsABgra[13] = 255 : nmsPixelsABgra[14] = 255 : nmsPixelsABgra[15] = 255
  nmsPixelsB[0] = 255 : nmsPixelsB[1] = 255 : nmsPixelsB[2] = 0 : nmsPixelsB[3] = 255
  nmsPixelsB[4] = 255 : nmsPixelsB[5] = 255 : nmsPixelsB[6] = 255 : nmsPixelsB[7] = 255
  nmsPixelsB[8] = 255 : nmsPixelsB[9] = 255 : nmsPixelsB[10] = 255 : nmsPixelsB[11] = 255
  nmsPixelsB[12] = 255 : nmsPixelsB[13] = 255 : nmsPixelsB[14] = 255 : nmsPixelsB[15] = 255
  ; Odd width and half-alpha center detect BGRA channel, extent and blend errors.
  nmsPixelsOddBgra[0] = 255 : nmsPixelsOddBgra[1] = 0 : nmsPixelsOddBgra[2] = 255 : nmsPixelsOddBgra[3] = 255
  nmsPixelsOddBgra[4] = 0 : nmsPixelsOddBgra[5] = 255 : nmsPixelsOddBgra[6] = 255 : nmsPixelsOddBgra[7] = 128
  nmsPixelsOddBgra[8] = 255 : nmsPixelsOddBgra[9] = 0 : nmsPixelsOddBgra[10] = 0 : nmsPixelsOddBgra[11] = 255
  nmsClear[0] = 0 : nmsClear[1] = 0 : nmsClear[2] = 0 : nmsClear[3] = $3F800000

  TimerInit()
  nmsReport[2] = 1
  If NeonArena(#NMS_ARENA, #NMS_ARENA_BYTES) <> #NEON_OK : ProcedureReturn nmsReturn(1) : EndIf
  If NeonSurface(#NMS_SURFACE, #NMS_SIZE, #NMS_SIZE, #NMS_SIZE * 4) <> #NEON_OK : ProcedureReturn nmsReturn(1) : EndIf
  ; The sampled TrueType/sprite atlas is 512x1024 even though this proof's
  ; attachment is 64x64. Declare that capacity before NeonInit so Vulkan's
  ; truthful maxImageDimension2D covers the atlas.
  If NeonRenderCapacity(1024, 1024) <> #NEON_OK : ProcedureReturn nmsReturn(1) : EndIf
  NeonSurfaceMapSpan($00FE8000)
  If NeonInit() <> #NEON_OK : ProcedureReturn nmsReturn(1) : EndIf
  nmsNeon = 1
  NeonPalette() : NeonFontDefaults() : NeonFontUse(?dsp_font8x16, 8, 16, 32, 126)
  NeonAnimReset() : NeonStateReset()
  rc = AnvilVkV3dWindow(#NMS_WINDOW, #NMS_WINDOW_BYTES)
  If rc <> #VK_SUCCESS : ProcedureReturn nmsReturn(2) : EndIf

  nmsReport[2] = 2
  ici\sType = #VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO
  rc = vkCreateInstance(@ici, 0, @nmsInstance)
  If rc <> #VK_SUCCESS : ProcedureReturn nmsReturn(3) : EndIf
  count = 1
  rc = vkEnumeratePhysicalDevices(nmsInstance, @count, @phys)
  If rc <> #VK_SUCCESS Or count <> 1 Or phys = 0 : ProcedureReturn nmsReturn(4) : EndIf
  priority = 0
  qci\sType = #VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO
  qci\queueCount = 1 : qci\pQueuePriorities = @priority
  dci\sType = #VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO
  dci\queueCreateInfoCount = 1 : dci\pQueueCreateInfos = @qci
  rc = vkCreateDevice(phys, @dci, 0, @nmsDevice)
  If rc <> #VK_SUCCESS : ProcedureReturn nmsReturn(5) : EndIf
  vkGetDeviceQueue(nmsDevice, 0, 0, @queue)
  pci\sType = #VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO
  pci\flags = #VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT
  rc = vkCreateCommandPool(nmsDevice, @pci, 0, @nmsPool)
  If rc <> #VK_SUCCESS : ProcedureReturn nmsReturn(6) : EndIf

  nmsReport[2] = 3
  imageInfo\sType = #VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO
  imageInfo\imageType = #VK_IMAGE_TYPE_2D
  imageInfo\format = #VK_FORMAT_B8G8R8A8_UNORM
  imageInfo\extent\width = #NMS_SIZE : imageInfo\extent\height = #NMS_SIZE : imageInfo\extent\depth = 1
  imageInfo\mipLevels = 1 : imageInfo\arrayLayers = 1 : imageInfo\samples = #VK_SAMPLE_COUNT_1_BIT
  imageInfo\tiling = #VK_IMAGE_TILING_LINEAR
  imageInfo\usage = #VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | #VK_IMAGE_USAGE_TRANSFER_SRC_BIT
  imageInfo\sharingMode = #VK_SHARING_MODE_EXCLUSIVE
  imageInfo\initialLayout = #VK_IMAGE_LAYOUT_UNDEFINED
  rc = vkCreateImage(nmsDevice, @imageInfo, 0, @nmsImage)
  If rc <> #VK_SUCCESS : ProcedureReturn nmsReturn(7) : EndIf
  vkGetImageMemoryRequirements(nmsDevice, nmsImage, @req)
  alloc\sType = #VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO
  alloc\allocationSize = req\size : alloc\memoryTypeIndex = 0
  rc = vkAllocateMemory(nmsDevice, @alloc, 0, @nmsMemory)
  If rc = #VK_SUCCESS : rc = vkBindImageMemory(nmsDevice, nmsImage, nmsMemory, 0) : EndIf
  If rc <> #VK_SUCCESS : ProcedureReturn nmsReturn(8) : EndIf
  base = AnvilVkImageAddress(nmsImage) : pitch = AnvilVkImageRowPitch(nmsImage)
  If base = 0 Or pitch < #NMS_SIZE * 4 : ProcedureReturn nmsReturn(9) : EndIf
  viewInfo\sType = #VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO
  viewInfo\image = nmsImage : viewInfo\viewType = #VK_IMAGE_VIEW_TYPE_2D
  viewInfo\format = #VK_FORMAT_B8G8R8A8_UNORM
  viewInfo\subresourceRange\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT
  viewInfo\subresourceRange\levelCount = 1 : viewInfo\subresourceRange\layerCount = 1
  rc = vkCreateImageView(nmsDevice, @viewInfo, 0, @nmsView)
  If rc <> #VK_SUCCESS : ProcedureReturn nmsReturn(10) : EndIf

  attachment\format = #VK_FORMAT_B8G8R8A8_UNORM
  attachment\samples = #VK_SAMPLE_COUNT_1_BIT
  attachment\loadOp = #VK_ATTACHMENT_LOAD_OP_CLEAR : attachment\storeOp = #VK_ATTACHMENT_STORE_OP_STORE
  attachment\stencilLoadOp = #VK_ATTACHMENT_LOAD_OP_DONT_CARE
  attachment\stencilStoreOp = #VK_ATTACHMENT_STORE_OP_DONT_CARE
  attachment\initialLayout = #VK_IMAGE_LAYOUT_UNDEFINED
  attachment\finalLayout = #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL
  attachmentRef\attachment = 0 : attachmentRef\layout = #VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL
  subpass\pipelineBindPoint = #VK_PIPELINE_BIND_POINT_GRAPHICS
  subpass\colorAttachmentCount = 1 : subpass\pColorAttachments = @attachmentRef
  passInfo\sType = #VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO
  passInfo\attachmentCount = 1 : passInfo\pAttachments = @attachment
  passInfo\subpassCount = 1 : passInfo\pSubpasses = @subpass
  rc = vkCreateRenderPass(nmsDevice, @passInfo, 0, @nmsPass)
  If rc <> #VK_SUCCESS : ProcedureReturn nmsReturn(11) : EndIf
  frameInfo\sType = #VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO
  frameInfo\renderPass = nmsPass : frameInfo\attachmentCount = 1
  frameInfo\pAttachments = @nmsView : frameInfo\width = #NMS_SIZE
  frameInfo\height = #NMS_SIZE : frameInfo\layers = 1
  rc = vkCreateFramebuffer(nmsDevice, @frameInfo, 0, @nmsFrame)
  If rc <> #VK_SUCCESS : ProcedureReturn nmsReturn(12) : EndIf

  nmsReport[2] = 4
  rc = NeonVkChromeSpriteSource(@nmsPixelsA[0], 2, 2)
  If rc <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(20) : EndIf
  rc = NeonVkChromeCreateWithCapacities(phys, nmsDevice, queue, nmsPool, nmsPass, nmsFrame, #NMS_SIZE, #NMS_SIZE, 4, 4)
  nmsReport[3] = rc
  If rc <> #VK_SUCCESS : ProcedureReturn nmsReturn(21) : EndIf
  nmsAdapter = 1
  If NeonVkChromeImageSpriteReplaceId(1, @nmsPixelsA[0], 2, 2) <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(22) : EndIf
  If NeonVkChromeImageSpriteReplaceId(2, @nmsPixelsB[0], 2, 2) <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(23) : EndIf
  residentImage = nvcImageSpriteImage : residentSet = nvcImageSpriteSet
  resident2Image = nvcImageSpriteImages[2] : resident2Set = nvcImageSpriteSets[2]
  If residentImage = 0 Or residentSet = 0 Or resident2Image = 0 Or resident2Set = 0 : ProcedureReturn nmsReturn(24) : EndIf

  ; Add records no Vulkan draw. End appends after the blue box, with its clip.
  nmsReport[2] = 5
  If NeonVkChromeBegin(@nmsClear[0]) <> #VK_SUCCESS : ProcedureReturn nmsReturn(25) : EndIf
  If NeonVkChromeSpriteBatchBegin() <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(26) : EndIf
  If NeonVkChromeSpriteBatchAdd(1, 4, 4, 0, 0, 1, 1, 8, 8, Neon_RGB(255, 255, 255), 0, 0, 0, 65536, 1) <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(27) : EndIf
  If NeonVkChromeSpriteBatchAdd(2, 20, 4, 0, 0, 2, 2, 8, 8, Neon_RGBA(255, 255, 255, 128), #NVC_SPRITE_HALF_PI_Q16, 0, 0, 65536, 1) <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(28) : EndIf
  If NeonVkChromeSpriteBatchAdd(1, 38, 32, 1, 1, 1, 1, 8, 8, Neon_RGB(255, 255, 255), 0, 0, 0, 98304, 0) <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(29) : EndIf
  nmsReport[4] = nvcDrawCount : nmsReport[5] = nvcVertices
  If nmsReport[4] <> 0 Or nmsReport[5] <> 0 : ProcedureReturn nmsReturn(30) : EndIf
  If NeonVkChromeBox(0, 0, 64, 64, Neon_RGB(0, 0, 255)) <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(31) : EndIf
  nmsReport[6] = nvcDrawCount
  NeonVkChromeScissorSet(0, 0, 43, 64)
  rc = NeonVkChromeSpriteBatchEnd()
  If rc <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(32) : EndIf
  nmsReport[7] = nvcDrawCount : nmsReport[8] = nvcVertices
  NeonVkChromeScissorClear()
  If nmsReport[6] <> 1 Or nmsReport[7] <> 4 Or nmsReport[8] <> 24 : ProcedureReturn nmsReturn(33) : EndIf
  If NeonVkChromeEnd() <> #VK_SUCCESS : ProcedureReturn nmsReturn(34) : EndIf
  If NeonVkChromePresentConsume() <> 1 : ProcedureReturn nmsReturn(35) : EndIf
  For oy = 0 To 63
    For ox = 0 To 63
      nrbCapture[oy * 64 + ox] = nmsPixel(base, pitch, ox, oy)
    Next
  Next
  nmsReport[9] = nmsPixel(base, pitch, 5, 5)
  nmsReport[10] = nmsPixel(base, pitch, 50, 40)
  If nmsWord(9) <> $FFFF0000 Or nmsWord(10) <> $FF0000FF : ProcedureReturn nmsReturn(36) : EndIf

  ; The direct path is an independent ordering/geometry reference.
  nmsReport[2] = 6
  If NeonVkChromeBegin(@nmsClear[0]) <> #VK_SUCCESS : ProcedureReturn nmsReturn(37) : EndIf
  If NeonVkChromeBox(0, 0, 64, 64, Neon_RGB(0, 0, 255)) <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(38) : EndIf
  NeonVkChromeScissorSet(0, 0, 43, 64)
  If NeonVkChromeImageSpriteDrawTransformId(1, 4, 4, 0, 0, 1, 1, 8, 8, Neon_RGB(255, 255, 255), 0, 0, 0, 65536, 1) <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(39) : EndIf
  If NeonVkChromeImageSpriteDrawTransformId(2, 20, 4, 0, 0, 2, 2, 8, 8, Neon_RGBA(255, 255, 255, 128), #NVC_SPRITE_HALF_PI_Q16, 0, 0, 65536, 1) <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(40) : EndIf
  If NeonVkChromeImageSpriteDrawTransformId(1, 38, 32, 1, 1, 1, 1, 8, 8, Neon_RGB(255, 255, 255), 0, 0, 0, 98304, 0) <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(41) : EndIf
  NeonVkChromeScissorClear()
  If NeonVkChromeEnd() <> #VK_SUCCESS : ProcedureReturn nmsReturn(42) : EndIf
  If NeonVkChromePresentConsume() <> 1 : ProcedureReturn nmsReturn(43) : EndIf
  For oy = 0 To 63
    For ox = 0 To 63
      If nmsPixel(base, pitch, ox, oy) <> (nrbCapture[oy * 64 + ox] & $FFFFFFFF) : nmsReport[12] = nmsReport[12] + 1 : EndIf
    Next
  Next
  If nmsReport[12] <> 0 : ProcedureReturn nmsReturn(44) : EndIf

  ; Mutating the original CPU bytes does not change retained GPU images.
  nmsReport[2] = 7
  nmsPixelsA[0] = 0
  If NeonVkChromeBegin(@nmsClear[0]) <> #VK_SUCCESS : ProcedureReturn nmsReturn(45) : EndIf
  If NeonVkChromeBox(0, 0, 64, 64, Neon_RGB(0, 0, 255)) <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(46) : EndIf
  NeonVkChromeScissorSet(0, 0, 43, 64)
  If NeonVkChromeSpriteBatchEnd() <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(47) : EndIf
  NeonVkChromeScissorClear()
  If NeonVkChromeEnd() <> #VK_SUCCESS : ProcedureReturn nmsReturn(48) : EndIf
  If NeonVkChromePresentConsume() <> 1 : ProcedureReturn nmsReturn(49) : EndIf
  For oy = 0 To 63
    For ox = 0 To 63
      If nmsPixel(base, pitch, ox, oy) <> (nrbCapture[oy * 64 + ox] & $FFFFFFFF) : nmsReport[16] = nmsReport[16] + 1 : EndIf
    Next
  Next
  nmsReport[17] = NeonVkChromeImageSpriteGenerationId(1)
  nmsReport[18] = (nvcImageSpriteImage = residentImage And nvcImageSpriteSet = residentSet And nvcImageSpriteImages[2] = resident2Image And nvcImageSpriteSets[2] = resident2Set)
  If nmsReport[16] <> 0 Or nmsReport[17] <> 1 Or nmsReport[18] = 0 : ProcedureReturn nmsReturn(50) : EndIf

  ; A bad late item and a full draw budget must leave prior draws untouched.
  nmsReport[2] = 8
  If NeonVkChromeBegin(@nmsClear[0]) <> #VK_SUCCESS : ProcedureReturn nmsReturn(51) : EndIf
  If NeonVkChromeSpriteBatchBegin() <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(52) : EndIf
  If NeonVkChromeSpriteBatchAdd(1, 4, 4, 0, 0, 1, 1, 8, 8, Neon_RGB(255, 255, 255), 0, 0, 0, 65536, 1) <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(53) : EndIf
  nmsReport[19] = NeonVkChromeSpriteBatchAdd(17, 4, 4, 0, 0, 1, 1, 8, 8, Neon_RGB(255, 255, 255), 0, 0, 0, 65536, 1)
  If nmsReport[19] <> #NEON_VK_CHROME_ERR_ARGS Or nvcRetainedBatchCount <> 1 : ProcedureReturn nmsReturn(54) : EndIf
  If NeonVkChromeSpriteBatchAdd(2, 20000, 4, 0, 0, 1, 1, 8, 8, Neon_RGB(255, 255, 255), 0, 0, 0, 65536, 1) <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(55) : EndIf
  If NeonVkChromeBox(0, 0, 64, 64, Neon_RGB(0, 0, 255)) <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(56) : EndIf
  nmsReport[20] = NeonVkChromeSpriteBatchEnd()
  nmsReport[21] = nvcDrawCount : nmsReport[22] = nvcVertices
  If nmsReport[20] <> #NEON_VK_CHROME_ERR_ARGS Or nmsReport[21] <> 1 Or nmsReport[22] <> 6 : ProcedureReturn nmsReturn(57) : EndIf
  If NeonVkChromeSpriteBatchBegin() <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(58) : EndIf
  For id = 1 To 3
    If NeonVkChromeSpriteBatchAdd(1, 4 + id * 8, 4, 0, 0, 1, 1, 4, 4, Neon_RGB(255, 255, 255), 0, 0, 0, 65536, 1) <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(59) : EndIf
  Next
  If NeonVkChromeBox(0, 0, 2, 2, Neon_RGB(255, 0, 0)) <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(60) : EndIf
  nmsReport[23] = NeonVkChromeSpriteBatchEnd()
  nmsReport[24] = nvcDrawCount : nmsReport[25] = nvcVertices
  If nmsReport[23] <> #NEON_VK_CHROME_ERR_CAPACITY Or nmsReport[24] <> 2 Or nmsReport[25] <> 12 : ProcedureReturn nmsReturn(61) : EndIf
  If NeonVkChromeEnd() <> #VK_SUCCESS : ProcedureReturn nmsReturn(62) : EndIf
  If NeonVkChromePresentConsume() <> 1 : ProcedureReturn nmsReturn(63) : EndIf

  ; A replacement changes generation; retained old commands fail closed.
  nmsReport[2] = 9
  If NeonVkChromeImageSpriteReplaceId(1, @nmsPixelsA[0], 2, 2) <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(64) : EndIf
  If NeonVkChromeBegin(@nmsClear[0]) <> #VK_SUCCESS : ProcedureReturn nmsReturn(65) : EndIf
  If NeonVkChromeBox(0, 0, 64, 64, Neon_RGB(0, 0, 255)) <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(66) : EndIf
  nmsReport[26] = NeonVkChromeSpriteBatchEnd()
  nmsReport[27] = nvcDrawCount : nmsReport[28] = nvcVertices
  If nmsReport[26] <> #NEON_VK_CHROME_ERR_STATE Or nmsReport[27] <> 1 Or nmsReport[28] <> 6 : ProcedureReturn nmsReturn(67) : EndIf

  ; Bracket dimensions are element counts: prove the last of 128 records is
  ; addressable, then refuse the 129th before indexing the retained array.
  nmsReport[2] = 10
  If NeonVkChromeSpriteBatchBegin() <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(71) : EndIf
  For j = 1 To 128
    rc = NeonVkChromeSpriteBatchAdd(1, j, 2, 0, 0, 1, 1, 1, 1, Neon_RGB(255, 255, 255), 0, 0, 0, 65536, 1)
    If rc <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(72) : EndIf
  Next
  nmsReport[31] = nvcRetainedBatchCount
  nmsReport[32] = nvcRetainedItems[127]\x
  nmsReport[33] = nvcRetainedItems[127]\id
  nmsReport[34] = NeonVkChromeSpriteBatchAdd(1, 129, 2, 0, 0, 1, 1, 1, 1, Neon_RGB(255, 255, 255), 0, 0, 0, 65536, 1)
  nmsReport[35] = nvcRetainedBatchCount
  nmsReport[36] = nvcRetainedItems[127]\x
  If nmsReport[31] <> 128 Or nmsReport[32] <> 128 Or nmsReport[33] <> 1 Or nmsReport[34] <> #NEON_VK_CHROME_ERR_CAPACITY Or nmsReport[35] <> 128 Or nmsReport[36] <> 128
    ProcedureReturn nmsReturn(73)
  EndIf
  If NeonVkChromeSpriteBatchBegin() <> #NEON_VK_CHROME_OK : ProcedureReturn nmsReturn(74) : EndIf
  nmsReport[37] = NeonVkChromeSpriteBatchEnd()
  nmsReport[38] = nvcDrawCount
  If nmsReport[37] <> #NEON_VK_CHROME_OK Or nmsReport[38] <> 1 Or nvcRetainedBatchCount <> 0 : ProcedureReturn nmsReturn(75) : EndIf
  If NeonVkChromeEnd() <> #VK_SUCCESS : ProcedureReturn nmsReturn(68) : EndIf
  If NeonVkChromePresentConsume() <> 1 : ProcedureReturn nmsReturn(69) : EndIf
  NeonVkChromeDestroy() : nmsAdapter = 0
  nmsReport[29] = nvcRetainedBatchActive : nmsReport[30] = nvcRetainedBatchCount
  If nmsReport[29] <> 0 Or nmsReport[30] <> 0 : ProcedureReturn nmsReturn(70) : EndIf
  ProcedureReturn nmsReturn(0)
EndProcedure
