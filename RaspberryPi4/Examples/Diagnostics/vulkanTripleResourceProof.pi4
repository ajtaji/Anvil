#VVP_S_DISPLAY_ERR = 99
#VVP_S_ARENA_NEED = 100
#VVP_S_BACKEND_DRAW = 101
#VVP_S_BACKEND_NAME = 102
#VVP_S_LAYOUT_AFTER = 103
#VVP_S_US_A = 104
#VVP_S_US_B = 105
#VVP_S_US_C = 106
