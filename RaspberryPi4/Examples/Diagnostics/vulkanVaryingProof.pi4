#VVP_S_STEP = 125
#VVP_S_BYTES = 126
#VVP_S_TAIL = 127

; ======================================================================
;  THE REPORT IS 32 BITS WIDE AND THAT IS NOT A DETAIL
; ======================================================================
;  The monitor's dump has three widths - md.b, md.w and md.l - AND NO
;  64-BIT ONE, and its count is in BYTES whichever is chosen
;  (Anvil/Core/memcmd.pbi, the width table). A report of 64-bit slots
;  can therefore only ever be read as twice as many words, with the slot
;  number in this file landing at word 2N. That is exactly how the first
;  board run of the triangle proof was misread. So this block is 32-BIT
;  WORDS: one slot is one word, `md.l` shows them one per column, and
;  every value fits - the addresses are payload and window addresses
;  below 4 GiB, the pixels are 32-bit words by definition, and the area
;  and the guard sum are masked to 32 bits below.
; ======================================================================
Global Dim vvpReport.l[128]
Global Dim vvpClear.l[4]
Global Dim vvpProbeX.i[7]
Global Dim vvpProbeY.i[7]
Global Dim vvpOutX.i[3]
Global Dim vvpOutY.i[3]

Procedure vvpPut(slot.i, value.i)
  If slot < 0 Or slot > 127
    ProcedureReturn
  EndIf
  vvpReport[slot] = value & $FFFFFFFF
EndProcedure

; Read a slot back WITHOUT the sign of a 32-bit load leaking into a
; 64-bit comparison. A pixel of $FFFF0000 read from a .l is -65536, and
; comparing that against the constant would fail on every correct run.
Procedure.i vvpGet(slot.i)
  If slot < 0 Or slot > 127
    ProcedureReturn 0
  EndIf
  ProcedureReturn vvpReport[slot] & $FFFFFFFF
EndProcedure

Procedure vvpStep(n.i)
  vvpPut(#VVP_S_STEP, n)
EndProcedure

; Stop with a verdict in EVERY pass that has not answered yet, so a
; report never shows one pass failed and the others simply blank.
Procedure.i vvpStop(status.i)
  If vvpGet(#VVP_S_STATUS_A) = #VVP_NOT_TRIED : vvpPut(#VVP_S_STATUS_A, status) : EndIf
  If vvpGet(#VVP_S_STATUS_B) = #VVP_NOT_TRIED : vvpPut(#VVP_S_STATUS_B, status) : EndIf
  If vvpGet(#VVP_S_STATUS_C) = #VVP_NOT_TRIED : vvpPut(#VVP_S_STATUS_C, status) : EndIf
  vvpPut(#VVP_S_FAULT_TEXT, AnvilVkFaultText())
  vvpPut(#VVP_S_FAULT_COUNT, AnvilVkFaultCount())
  ProcedureReturn @vvpReport[0]
EndProcedure

Procedure.i vvpSum(base.i, bytes.i)
  Define i.i
  Define s.i
  s = 0
  i = 0
  While i < bytes
    s = (s + (PeekL(base + i) & $FFFFFFFF) + i) & $FFFFFFFF
    i = i + 4
  Wend
  ProcedureReturn s
EndProcedure

Procedure vvpFill(base.i, bytes.i, word.i)
  Define i.i
  i = 0
  While i < bytes
    PokeL(base + i, word)
    i = i + 4
  Wend
EndProcedure

Procedure.i vvpPixel(imgBase.i, pitch.i, x.i, y.i)
  ProcedureReturn PeekL(imgBase + (y * pitch) + (x * 4)) & $FFFFFFFF
EndProcedure

; The probe table, written once so passes B and C sample the same points
; and the expectation module is asked about the same points.
Procedure vvpProbes()
  vvpProbeX[0] = 400 : vvpProbeY[0] = 346
  vvpProbeX[1] = 213 : vvpProbeY[1] = 946
  vvpProbeX[2] = 587 : vvpProbeY[2] = 946
  vvpProbeX[3] = 400 : vvpProbeY[3] = 747
  vvpProbeX[4] = 400 : vvpProbeY[4] = 500
  vvpProbeX[5] = 300 : vvpProbeY[5] = 800
  vvpProbeX[6] = 500 : vvpProbeY[6] = 800
  vvpOutX[0] = 100 : vvpOutY[0] = 100
  vvpOutX[1] = 700 : vvpOutY[1] = 1200
  vvpOutX[2] = 400 : vvpOutY[2] = 200
EndProcedure

Procedure.i Main()
  Define rc.i
  Define inst.i
  Define phys.i
  Define dev.i
  Define queue.i
  Define pool.i
  Define cmd.i
  Define img.i
  Define mem.i
  Define view.i
  Define rp.i
  Define fb.i
  Define fence.i
  Define count.i
  Define imgBase.i
  Define pitch.i
  Define hz.i
  Define t0.i
  Define k.i
  Define bad.i
  Define worst.i
  Define over.i
  Define differs.i
  Define d.i
  Define got.i
  Define want.i
  Define bufAll.i
  Define bufPos.i
  Define bufCol.i
  Define bufUni.i
  Define memAll.i
  Define memPos.i
  Define memCol.i
  Define memUni.i
  Define addrAll.i
  Define addrPos.i
  Define addrCol.i
  Define addrUni.i
  Define vsA.i
  Define fsA.i
  Define vsB.i
  Define fsB.i
  Define fsC.i
  Define bytesA.i
  Define bytesB.i
  Define bytesC.i
  Define bytesD.i
  Define bytesE.i
  Define dsl.i
  Define dpool.i
  Define dset.i
  Define layU.i
  Define layP.i
  Define pipeA.i
  Define pipeB.i
  Define pipeC.i
  Define bad2.i

  Define ici.VkInstanceCreateInfo
  Define dci.VkDeviceCreateInfo
  Define qci.VkDeviceQueueCreateInfo
  Define prio.l
  Define pci.VkCommandPoolCreateInfo
  Define cbai.VkCommandBufferAllocateInfo
  Define bi.VkCommandBufferBeginInfo
  Define imgci.VkImageCreateInfo
  Define req.VkMemoryRequirements
  Define mai.VkMemoryAllocateInfo
  Define fci.VkFenceCreateInfo
  Define si.VkSubmitInfo
  Define ivci.VkImageViewCreateInfo
  Define att.VkAttachmentDescription
  Define aref.VkAttachmentReference
  Define sub.VkSubpassDescription
  Define rpci.VkRenderPassCreateInfo
  Define fbci.VkFramebufferCreateInfo
  Define bufci.VkBufferCreateInfo
  Define smci.VkShaderModuleCreateInfo
  Define plci.VkPipelineLayoutCreateInfo
  Define dslb.VkDescriptorSetLayoutBinding
  Define dslci.VkDescriptorSetLayoutCreateInfo
  Define dps.VkDescriptorPoolSize
  Define dpci.VkDescriptorPoolCreateInfo
  Define dsai.VkDescriptorSetAllocateInfo
  Define dbi.VkDescriptorBufferInfo
  Define wds.VkWriteDescriptorSet
  Define Dim stages.VkPipelineShaderStageCreateInfo[2]
  Define Dim binds.VkVertexInputBindingDescription[2]
  Define Dim attrs.VkVertexInputAttributeDescription[2]
  Define vi.VkPipelineVertexInputStateCreateInfo
  Define ia.VkPipelineInputAssemblyStateCreateInfo
  Define vpstate.VkPipelineViewportStateCreateInfo
  Define vp.VkViewport
  Define sc.VkRect2D
  Define rs.VkPipelineRasterizationStateCreateInfo
  Define ms.VkPipelineMultisampleStateCreateInfo
  Define cba.VkPipelineColorBlendAttachmentState
  Define cb.VkPipelineColorBlendStateCreateInfo
  Define gp.VkGraphicsPipelineCreateInfo
  Define rpbi.VkRenderPassBeginInfo
  Define cbHandle.i
  Define fenceArray.i
  Define dsetArray.i
  Define dslArray.i
  Define Dim twoBufs.i[2]
  Define Dim twoOffsets.q[2]

  vvpPut(#VVP_S_MAGIC, #VVP_MAGIC)
  vvpPut(#VVP_S_TAIL, #VVP_TAIL_MAGIC)
  vvpPut(#VVP_S_BYTES, 512)
  vvpStep(0)
  vvpPut(#VVP_S_STATUS_A, #VVP_NOT_TRIED)
  vvpPut(#VVP_S_STATUS_B, #VVP_NOT_TRIED)
  vvpPut(#VVP_S_STATUS_C, #VVP_NOT_TRIED)
  vvpPut(#VVP_S_PRESENT, #VVP_P_NOT_TRIED)
  vvpPut(#VVP_S_SURFACE, #VVP_SURFACE)
  vvpPut(#VVP_S_WIN_BASE, #VVP_WIN_BASE)
  vvpPut(#VVP_S_WIN_BYTES, #VVP_WIN_BYTES)
  vvpPut(#VVP_S_CLEAR_WORD, #VVP_CLEAR_WORD)
  vvpPut(#VVP_S_MAGENTA_WORD, #VVP_MAGENTA_WORD)
  vvpPut(#VVP_S_PROBES, 7)
  vvpProbes()
  TimerInit()
  hz = TickHz() / 1000000
  If hz < 1
    hz = 1
  EndIf
  pitch = #VVP_PANEL_PITCH

  ; ------------------------------------------------------------------
  ;  1. The expected gradient, before anything touches hardware.
  ;
  ;     The triangle is given to the expectation module as exact
  ;     rationals - 0/2, -1/2, 1/2 - and the colours as whole 8-bit
  ;     values, so nothing here is a floating-point comparison and the
  ;     answers are the same ones the desk gate already checked.
  ; ------------------------------------------------------------------
  vvpStep(1)
  If AnvilVkInterpBegin(#VVP_PANEL_W, #VVP_PANEL_H) = 0
    ProcedureReturn vvpStop(#VVP_ERR_EXPECT)
  EndIf
  AnvilVkInterpVertex(0, 0, -1, 2)
  AnvilVkInterpVertex(1, -1, 1, 2)
  AnvilVkInterpVertex(2, 1, 1, 2)
  AnvilVkInterpColour(0, 255, 0, 0, 255)
  AnvilVkInterpColour(1, 0, 255, 0, 255)
  AnvilVkInterpColour(2, 0, 0, 255, 255)
  vvpPut(#VVP_S_SX0, AnvilVkInterpScreenX(0))
  vvpPut(#VVP_S_SY0, AnvilVkInterpScreenY(0))
  vvpPut(#VVP_S_SX1, AnvilVkInterpScreenX(1))
  vvpPut(#VVP_S_SY1, AnvilVkInterpScreenY(1))
  vvpPut(#VVP_S_SX2, AnvilVkInterpScreenX(2))
  vvpPut(#VVP_S_SY2, AnvilVkInterpScreenY(2))
  vvpPut(#VVP_S_AREA, AnvilVkInterpArea())
  vvpPut(#VVP_S_TOL, AnvilVkInterpTolerance())
  k = 0
  While k < 7
    ; EVERY PROBE MUST BE STRICTLY INSIDE. A probe the arithmetic says
    ; is on an edge or outside would be graded against a colour the
    ; rasteriser's fill rule decides, and that is an argument with the
    ; bench rather than a measurement of it.
    If AnvilVkInterpInside(vvpProbeX[k], vvpProbeY[k]) = 0
      vvpPut(#VVP_S_DETAIL, k)
      ProcedureReturn vvpStop(#VVP_ERR_EXPECT)
    EndIf
    vvpPut(#VVP_S_EXPECT0 + k, AnvilVkInterpExpect(vvpProbeX[k], vvpProbeY[k]))
    k = k + 1
  Wend
  k = 0
  While k < 3
    If AnvilVkInterpInside(vvpOutX[k], vvpOutY[k]) <> 0
      vvpPut(#VVP_S_DETAIL, 100 + k)
      ProcedureReturn vvpStop(#VVP_ERR_EXPECT)
    EndIf
    k = k + 1
  Wend

  ; The guard half, filled before anything else touches the engine.
  vvpFill(#VVP_SURFACE, #VVP_SCREEN_BYTES, #VVP_GUARD)

  ; ------------------------------------------------------------------
  ;  2. The graphics engine, over memory this payload owns.
  ; ------------------------------------------------------------------
  vvpStep(2)
  If NeonArena(#VVP_ARENA, #VVP_ARENA_BYTES) <> #NEON_OK
    vvpPut(#VVP_S_DETAIL, Neon_Error())
    ProcedureReturn vvpStop(#VVP_ERR_NEON)
  EndIf
  If NeonSurface(#VVP_SURFACE, #VVP_PANEL_W, #VVP_PANEL_H, pitch) <> #NEON_OK
    vvpPut(#VVP_S_DETAIL, Neon_Error())
    ProcedureReturn vvpStop(#VVP_ERR_NEON)
  EndIf
  NeonSurfaceMapSpan(#VVP_MAP_SPAN)
  If NeonInit() <> #NEON_OK
    vvpPut(#VVP_S_DETAIL, Neon_Error())
    vvpPut(#VVP_S_DETAIL2, Neon_ArenaNeed())
    ProcedureReturn vvpStop(#VVP_ERR_NEON)
  EndIf
  vvpPut(#VVP_S_ARENA_NEED, Neon_ArenaNeed())

  ; ------------------------------------------------------------------
  ;  3. The Vulkan device, over the memory above the surface.
  ; ------------------------------------------------------------------
  vvpStep(3)
  rc = AnvilVkV3dWindow(#VVP_WIN_BASE, #VVP_WIN_BYTES)
  If rc <> #VK_SUCCESS
    vvpPut(#VVP_S_DETAIL, rc)
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_WINDOW)
  EndIf
  vvpPut(#VVP_S_BACKEND_DRAW, AnvilVkBackendCanDraw())
  vvpPut(#VVP_S_BACKEND_NAME, AnvilVkBackendName())

  ici\sType = #VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO
  If vkCreateInstance(@ici, 0, @inst) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_INSTANCE)
  EndIf
  count = 1
  If vkEnumeratePhysicalDevices(inst, @count, @phys) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_INSTANCE)
  EndIf
  prio = 0
  qci\sType = #VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO
  qci\queueCount = 1
  qci\pQueuePriorities = @prio
  dci\sType = #VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO
  dci\queueCreateInfoCount = 1
  dci\pQueueCreateInfos = @qci
  rc = vkCreateDevice(phys, @dci, 0, @dev)
  If rc <> #VK_SUCCESS
    vvpPut(#VVP_S_DETAIL, rc)
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_DEVICE)
  EndIf
  vkGetDeviceQueue(dev, 0, 0, @queue)
  pci\sType = #VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO
  pci\flags = #VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT
  If vkCreateCommandPool(dev, @pci, 0, @pool) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_DEVICE)
  EndIf
  cbai\sType = #VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO
  cbai\commandPool = pool
  cbai\level = #VK_COMMAND_BUFFER_LEVEL_PRIMARY
  cbai\commandBufferCount = 1
  If vkAllocateCommandBuffers(dev, @cbai, @cmd) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_DEVICE)
  EndIf

  ; ------------------------------------------------------------------
  ;  4. The colour attachment at the panel's native extent.
  ; ------------------------------------------------------------------
  vvpStep(4)
  imgci\sType = #VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO
  imgci\imageType = #VK_IMAGE_TYPE_2D
  imgci\format = #VK_FORMAT_B8G8R8A8_UNORM
  imgci\extent\width = #VVP_PANEL_W
  imgci\extent\height = #VVP_PANEL_H
  imgci\extent\depth = 1
  imgci\mipLevels = 1
  imgci\arrayLayers = 1
  imgci\samples = #VK_SAMPLE_COUNT_1_BIT
  imgci\tiling = #VK_IMAGE_TILING_LINEAR
  imgci\usage = #VK_IMAGE_USAGE_TRANSFER_DST_BIT
  imgci\sharingMode = #VK_SHARING_MODE_EXCLUSIVE
  imgci\initialLayout = #VK_IMAGE_LAYOUT_UNDEFINED
  rc = vkCreateImage(dev, @imgci, 0, @img)
  If rc <> #VK_SUCCESS
    vvpPut(#VVP_S_DETAIL, rc)
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_IMAGE)
  EndIf
  vkGetImageMemoryRequirements(dev, img, @req)
  mai\sType = #VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO
  mai\allocationSize = req\size
  mai\memoryTypeIndex = 0
  rc = vkAllocateMemory(dev, @mai, 0, @mem)
  If rc <> #VK_SUCCESS
    vvpPut(#VVP_S_DETAIL, rc)
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_MEMORY)
  EndIf
  If vkBindImageMemory(dev, img, mem, 0) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_BIND)
  EndIf
  imgBase = AnvilVkImageAddress(img)
  vvpPut(#VVP_S_IMG_ADDR, imgBase)
  vvpPut(#VVP_S_IMG_SIZE, req\size)
  vvpPut(#VVP_S_IMG_PITCH, AnvilVkImageRowPitch(img))
  ; POISON IT. An image that already held an answer would prove nothing.
  vvpFill(imgBase, req\size, ~#VVP_CLEAR_WORD)

  ivci\sType = #VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO
  ivci\image = img
  ivci\viewType = #VK_IMAGE_VIEW_TYPE_2D
  ivci\format = #VK_FORMAT_B8G8R8A8_UNORM
  ivci\subresourceRange\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT
  ivci\subresourceRange\levelCount = 1
  ivci\subresourceRange\layerCount = 1
  If vkCreateImageView(dev, @ivci, 0, @view) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_VIEW)
  EndIf

  att\format = #VK_FORMAT_B8G8R8A8_UNORM
  att\samples = #VK_SAMPLE_COUNT_1_BIT
  att\loadOp = #VK_ATTACHMENT_LOAD_OP_CLEAR
  att\storeOp = #VK_ATTACHMENT_STORE_OP_STORE
  att\stencilLoadOp = #VK_ATTACHMENT_LOAD_OP_DONT_CARE
  att\stencilStoreOp = #VK_ATTACHMENT_STORE_OP_DONT_CARE
  att\initialLayout = #VK_IMAGE_LAYOUT_UNDEFINED
  att\finalLayout = #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL
  aref\attachment = 0
  aref\layout = #VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL
  sub\pipelineBindPoint = #VK_PIPELINE_BIND_POINT_GRAPHICS
  sub\colorAttachmentCount = 1
  sub\pColorAttachments = @aref
  rpci\sType = #VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO
  rpci\attachmentCount = 1
  rpci\pAttachments = @att
  rpci\subpassCount = 1
  rpci\pSubpasses = @sub
  If vkCreateRenderPass(dev, @rpci, 0, @rp) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_RENDERPASS)
  EndIf

  fbci\sType = #VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO
  fbci\renderPass = rp
  fbci\attachmentCount = 1
  fbci\pAttachments = @view
  fbci\width = #VVP_PANEL_W
  fbci\height = #VVP_PANEL_H
  fbci\layers = 1
  If vkCreateFramebuffer(dev, @fbci, 0, @fb) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_FRAMEBUFFER)
  EndIf

  ; ------------------------------------------------------------------
  ;  5. Four buffers: the interleaved one, the split pair, and the
  ;     uniform buffer the descriptor points into.
  ; ------------------------------------------------------------------
  vvpStep(5)
  bufci\sType = #VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO
  bufci\sharingMode = #VK_SHARING_MODE_EXCLUSIVE
  bufci\usage = #VK_BUFFER_USAGE_VERTEX_BUFFER_BIT
  bufci\size = 3 * #VVP_STRIDE_ALL
  If vkCreateBuffer(dev, @bufci, 0, @bufAll) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_BUFFER)
  EndIf
  vkGetBufferMemoryRequirements(dev, bufAll, @req)
  mai\allocationSize = req\size
  If vkAllocateMemory(dev, @mai, 0, @memAll) <> #VK_SUCCESS Or vkBindBufferMemory(dev, bufAll, memAll, 0) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_BUFFER)
  EndIf
  bufci\size = 3 * #VVP_STRIDE_POS
  If vkCreateBuffer(dev, @bufci, 0, @bufPos) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_BUFFER)
  EndIf
  vkGetBufferMemoryRequirements(dev, bufPos, @req)
  mai\allocationSize = req\size
  If vkAllocateMemory(dev, @mai, 0, @memPos) <> #VK_SUCCESS Or vkBindBufferMemory(dev, bufPos, memPos, 0) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_BUFFER)
  EndIf
  bufci\size = 3 * #VVP_STRIDE_COL
  If vkCreateBuffer(dev, @bufci, 0, @bufCol) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_BUFFER)
  EndIf
  vkGetBufferMemoryRequirements(dev, bufCol, @req)
  mai\allocationSize = req\size
  If vkAllocateMemory(dev, @mai, 0, @memCol) <> #VK_SUCCESS Or vkBindBufferMemory(dev, bufCol, memCol, 0) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_BUFFER)
  EndIf
  bufci\usage = #VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT
  bufci\size = #VVP_UNIFORM_BYTES
  If vkCreateBuffer(dev, @bufci, 0, @bufUni) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_BUFFER)
  EndIf
  vkGetBufferMemoryRequirements(dev, bufUni, @req)
  mai\allocationSize = req\size
  If vkAllocateMemory(dev, @mai, 0, @memUni) <> #VK_SUCCESS Or vkBindBufferMemory(dev, bufUni, memUni, 0) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_BUFFER)
  EndIf

  addrAll = AnvilVkBufferAddress(bufAll)
  addrPos = AnvilVkBufferAddress(bufPos)
  addrCol = AnvilVkBufferAddress(bufCol)
  addrUni = AnvilVkBufferAddress(bufUni)
  vvpPut(#VVP_S_BUF_ALL, addrAll)
  vvpPut(#VVP_S_BUF_POS, addrPos)
  vvpPut(#VVP_S_BUF_COL, addrCol)
  vvpPut(#VVP_S_BUF_UNI, addrUni)

  ; The interleaved array: position then colour, three vertices, and the
  ; three colours are red, green and blue in that vertex order.
  PokeL(addrAll + 0, #VVP_X0)
  PokeL(addrAll + 4, #VVP_Y0)
  PokeL(addrAll + 8, #VVP_F_ONE)  : PokeL(addrAll + 12, #VVP_F_ZERO)
  PokeL(addrAll + 16, #VVP_F_ZERO) : PokeL(addrAll + 20, #VVP_F_ONE)
  PokeL(addrAll + 24, #VVP_X1)
  PokeL(addrAll + 28, #VVP_Y1)
  PokeL(addrAll + 32, #VVP_F_ZERO) : PokeL(addrAll + 36, #VVP_F_ONE)
  PokeL(addrAll + 40, #VVP_F_ZERO) : PokeL(addrAll + 44, #VVP_F_ONE)
  PokeL(addrAll + 48, #VVP_X2)
  PokeL(addrAll + 52, #VVP_Y2)
  PokeL(addrAll + 56, #VVP_F_ZERO) : PokeL(addrAll + 60, #VVP_F_ZERO)
  PokeL(addrAll + 64, #VVP_F_ONE)  : PokeL(addrAll + 68, #VVP_F_ONE)

  ; The same data split in two: positions at a stride of eight, colours
  ; at a stride of sixteen, in two separate allocations.
  PokeL(addrPos + 0, #VVP_X0)  : PokeL(addrPos + 4, #VVP_Y0)
  PokeL(addrPos + 8, #VVP_X1)  : PokeL(addrPos + 12, #VVP_Y1)
  PokeL(addrPos + 16, #VVP_X2) : PokeL(addrPos + 20, #VVP_Y2)
  PokeL(addrCol + 0, #VVP_F_ONE)  : PokeL(addrCol + 4, #VVP_F_ZERO)
  PokeL(addrCol + 8, #VVP_F_ZERO) : PokeL(addrCol + 12, #VVP_F_ONE)
  PokeL(addrCol + 16, #VVP_F_ZERO) : PokeL(addrCol + 20, #VVP_F_ONE)
  PokeL(addrCol + 24, #VVP_F_ZERO) : PokeL(addrCol + 28, #VVP_F_ONE)
  PokeL(addrCol + 32, #VVP_F_ZERO) : PokeL(addrCol + 36, #VVP_F_ZERO)
  PokeL(addrCol + 40, #VVP_F_ONE)  : PokeL(addrCol + 44, #VVP_F_ONE)

  ; The uniform block: magenta, in red, green, blue, alpha order.
  PokeL(addrUni + 0, #VVP_F_ONE)
  PokeL(addrUni + 4, #VVP_F_ZERO)
  PokeL(addrUni + 8, #VVP_F_ONE)
  PokeL(addrUni + 12, #VVP_F_ONE)

  ; ------------------------------------------------------------------
  ;  6. Five shader modules, a descriptor set layout, a pool, a set,
  ;     two pipeline layouts and three pipelines.
  ; ------------------------------------------------------------------
  vvpStep(6)
  bytesA = vtpBuildVsA()
  bytesB = vtpBuildFsA()
  bytesC = vtpBuildVsB()
  bytesD = vtpBuildFsB()
  bytesE = vtpBuildFsC()
  smci\sType = #VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO
  smci\pCode = @vtpVsA[0] : smci\codeSize = bytesA
  rc = vkCreateShaderModule(dev, @smci, 0, @vsA)
  If rc <> #VK_SUCCESS
    vvpPut(#VVP_S_DETAIL, rc)
    vvpPut(#VVP_S_DETAIL2, AnvilVkSpirvLastOpcode())
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_SHADER)
  EndIf
  smci\pCode = @vtpFsA[0] : smci\codeSize = bytesB
  If vkCreateShaderModule(dev, @smci, 0, @fsA) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_SHADER)
  EndIf
  smci\pCode = @vtpVsB[0] : smci\codeSize = bytesC
  If vkCreateShaderModule(dev, @smci, 0, @vsB) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_SHADER)
  EndIf
  smci\pCode = @vtpFsB[0] : smci\codeSize = bytesD
  If vkCreateShaderModule(dev, @smci, 0, @fsB) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_SHADER)
  EndIf
  smci\pCode = @vtpFsC[0] : smci\codeSize = bytesE
  rc = vkCreateShaderModule(dev, @smci, 0, @fsC)
  If rc <> #VK_SUCCESS
    vvpPut(#VVP_S_DETAIL, rc)
    vvpPut(#VVP_S_DETAIL2, AnvilVkSpirvLastOpcode())
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_SHADER)
  EndIf

  ; The descriptor set layout: one uniform buffer at binding 0, in the
  ; fragment stage - which is exactly what fsC's SPIR-V asked for.
  dslb\binding = 0
  dslb\descriptorType = #VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER
  dslb\descriptorCount = 1
  dslb\stageFlags = #VK_SHADER_STAGE_FRAGMENT_BIT
  dslci\sType = #VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO
  dslci\bindingCount = 1
  dslci\pBindings = @dslb
  rc = vkCreateDescriptorSetLayout(dev, @dslci, 0, @dsl)
  If rc <> #VK_SUCCESS
    vvpPut(#VVP_S_DETAIL, rc)
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_DESCRIPTOR)
  EndIf

  ; A combined image sampler must still be refused, by name.
  dslb\descriptorType = #VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER
  AnvilVkFaultClear()
  vvpPut(#VVP_S_REF_DESCTYPE, vkCreateDescriptorSetLayout(dev, @dslci, 0, @bad2))
  vvpPut(#VVP_S_REF_DESCTYPE_TEXT, AnvilVkFaultText())
  dslb\descriptorType = #VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER

  dps\type = #VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER
  dps\descriptorCount = 1
  dpci\sType = #VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO
  dpci\maxSets = 1
  dpci\poolSizeCount = 1
  dpci\pPoolSizes = @dps
  rc = vkCreateDescriptorPool(dev, @dpci, 0, @dpool)
  If rc <> #VK_SUCCESS
    vvpPut(#VVP_S_DETAIL, rc)
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_DESCRIPTOR)
  EndIf
  dslArray = dsl
  dsai\sType = #VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO
  dsai\descriptorPool = dpool
  dsai\descriptorSetCount = 1
  dsai\pSetLayouts = @dslArray
  rc = vkAllocateDescriptorSets(dev, @dsai, @dset)
  If rc <> #VK_SUCCESS
    vvpPut(#VVP_S_DETAIL, rc)
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_DESCRIPTOR)
  EndIf
  dbi\buffer = bufUni
  dbi\offset = 0
  dbi\range = #VVP_UNIFORM_BYTES
  wds\sType = #VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET
  wds\dstSet = dset
  wds\dstBinding = 0
  wds\dstArrayElement = 0
  wds\descriptorCount = 1
  wds\descriptorType = #VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER
  wds\pBufferInfo = @dbi
  vkUpdateDescriptorSets(dev, 1, @wds, 0, 0)
  If AnvilVkFaultCount() <> 0
    vvpPut(#VVP_S_DETAIL, AnvilVkFaultCode())
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_DESCRIPTOR)
  EndIf
  vvpPut(#VVP_S_DESC_ADDR, AnvilVkDescriptorSetAddress(dset, 0))
  vvpPut(#VVP_S_DESC_RANGE, AnvilVkDescriptorSetRange(dset, 0))

  ; Two pipeline layouts: one that declares the set, one that declares
  ; nothing at all.
  plci\sType = #VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO
  plci\setLayoutCount = 1
  plci\pSetLayouts = @dslArray
  If vkCreatePipelineLayout(dev, @plci, 0, @layU) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_LAYOUT)
  EndIf
  plci\setLayoutCount = 0
  plci\pSetLayouts = 0
  If vkCreatePipelineLayout(dev, @plci, 0, @layP) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_LAYOUT)
  EndIf

  ; The fixed-function state every pipeline here shares.
  ia\sType = #VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO
  ia\topology = #VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST
  ia\primitiveRestartEnable = #VK_FALSE
  PokeL(@vp\x, #VVP_F_ZERO)
  PokeL(@vp\y, #VVP_F_ZERO)
  PokeL(@vp\width, $44480000)            ; 800.0
  PokeL(@vp\height, $44A00000)           ; 1280.0
  PokeL(@vp\minDepth, #VVP_F_ZERO)
  PokeL(@vp\maxDepth, #VVP_F_ONE)
  sc\offset\x = 0
  sc\offset\y = 0
  sc\extent\width = #VVP_PANEL_W
  sc\extent\height = #VVP_PANEL_H
  vpstate\sType = #VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO
  vpstate\viewportCount = 1
  vpstate\pViewports = @vp
  vpstate\scissorCount = 1
  vpstate\pScissors = @sc
  rs\sType = #VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO
  rs\polygonMode = #VK_POLYGON_MODE_FILL
  rs\cullMode = #VK_CULL_MODE_NONE
  rs\frontFace = #VK_FRONT_FACE_COUNTER_CLOCKWISE
  PokeL(@rs\lineWidth, #VVP_F_ONE)
  ms\sType = #VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO
  ms\rasterizationSamples = #VK_SAMPLE_COUNT_1_BIT
  cba\blendEnable = #VK_FALSE
  cba\colorWriteMask = #VK_COLOR_COMPONENT_R_BIT | #VK_COLOR_COMPONENT_G_BIT | #VK_COLOR_COMPONENT_B_BIT | #VK_COLOR_COMPONENT_A_BIT
  cb\sType = #VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO
  cb\attachmentCount = 1
  cb\pAttachments = @cba
  vi\sType = #VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO
  vi\pVertexBindingDescriptions = @binds[0]
  vi\pVertexAttributeDescriptions = @attrs[0]
  stages[0]\sType = #VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO
  stages[0]\stage = #VK_SHADER_STAGE_VERTEX_BIT
  stages[1]\sType = #VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO
  stages[1]\stage = #VK_SHADER_STAGE_FRAGMENT_BIT
  gp\sType = #VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO
  gp\stageCount = 2
  gp\pStages = @stages[0]
  gp\pVertexInputState = @vi
  gp\pInputAssemblyState = @ia
  gp\pViewportState = @vpstate
  gp\pRasterizationState = @rs
  gp\pMultisampleState = @ms
  gp\pColorBlendState = @cb
  gp\renderPass = rp
  gp\subpass = 0
  gp\basePipelineIndex = -1

  ; PIPELINE A: position only, colour from the uniform buffer.
  binds[0]\binding = 0
  binds[0]\stride = #VVP_STRIDE_POS
  binds[0]\inputRate = #VK_VERTEX_INPUT_RATE_VERTEX
  attrs[0]\location = 0
  attrs[0]\binding = 0
  attrs[0]\format = #VK_FORMAT_R32G32_SFLOAT
  attrs[0]\offset = 0
  vi\vertexBindingDescriptionCount = 1
  vi\vertexAttributeDescriptionCount = 1
  stages[0]\module = vsA
  stages[1]\module = fsC
  gp\layout = layU
  rc = vkCreateGraphicsPipelines(dev, 0, 1, @gp, 0, @pipeA)
  If rc <> #VK_SUCCESS
    vvpPut(#VVP_S_DETAIL, rc)
    vvpPut(#VVP_S_EMIT_STAGE, AnvilVkV3dShaderStage())
    vvpPut(#VVP_S_QPU_ERR, AnvilVkV3dShaderError())
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_PIPELINE)
  EndIf
  vvpPut(#VVP_S_PIPE_A, AnvilVkPipelineCodeBase(pipeA))
  ; The same pipeline on a layout with no descriptor set layout is
  ; refused, by name.
  gp\layout = layP
  AnvilVkFaultClear()
  vvpPut(#VVP_S_REF_NOLAYOUT, vkCreateGraphicsPipelines(dev, 0, 1, @gp, 0, @bad2))
  vvpPut(#VVP_S_REF_NOLAYOUT_TEXT, AnvilVkFaultText())

  ; PIPELINE B: the gradient out of ONE interleaved buffer.
  binds[0]\stride = #VVP_STRIDE_ALL
  attrs[1]\location = 1
  attrs[1]\binding = 0
  attrs[1]\format = #VK_FORMAT_R32G32B32A32_SFLOAT
  attrs[1]\offset = 8
  vi\vertexAttributeDescriptionCount = 2
  stages[0]\module = vsB
  stages[1]\module = fsB
  gp\layout = layP
  rc = vkCreateGraphicsPipelines(dev, 0, 1, @gp, 0, @pipeB)
  If rc <> #VK_SUCCESS
    vvpPut(#VVP_S_DETAIL, rc)
    vvpPut(#VVP_S_EMIT_STAGE, AnvilVkV3dShaderStage())
    vvpPut(#VVP_S_QPU_ERR, AnvilVkV3dShaderError())
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_PIPELINE)
  EndIf
  vvpPut(#VVP_S_PIPE_B, AnvilVkPipelineCodeBase(pipeB))

  ; PIPELINE C: the same gradient out of TWO buffers.
  binds[0]\stride = #VVP_STRIDE_POS
  binds[1]\binding = 1
  binds[1]\stride = #VVP_STRIDE_COL
  binds[1]\inputRate = #VK_VERTEX_INPUT_RATE_VERTEX
  attrs[1]\binding = 1
  attrs[1]\offset = 0
  vi\vertexBindingDescriptionCount = 2
  ; An attribute that names a binding the pipeline does not describe is
  ; refused, by name, on the way past.
  attrs[1]\binding = 2
  AnvilVkFaultClear()
  vvpPut(#VVP_S_REF_BINDING, vkCreateGraphicsPipelines(dev, 0, 1, @gp, 0, @bad2))
  vvpPut(#VVP_S_REF_BINDING_TEXT, AnvilVkFaultText())
  attrs[1]\binding = 1
  rc = vkCreateGraphicsPipelines(dev, 0, 1, @gp, 0, @pipeC)
  If rc <> #VK_SUCCESS
    vvpPut(#VVP_S_DETAIL, rc)
    vvpPut(#VVP_S_EMIT_STAGE, AnvilVkV3dShaderStage())
    vvpPut(#VVP_S_QPU_ERR, AnvilVkV3dShaderError())
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_PIPELINE)
  EndIf
  vvpPut(#VVP_S_PIPE_C, AnvilVkPipelineCodeBase(pipeC))
  vvpPut(#VVP_S_C_BINDCOUNT, AnvilVkPipelineBindingCount(3))
  vvpPut(#VVP_S_C_STRIDE0, AnvilVkPipelineBindingStride(3, 0))
  vvpPut(#VVP_S_C_STRIDE1, AnvilVkPipelineBindingStride(3, 1))
  vvpPut(#VVP_S_C_ATTR0_BIND, AnvilVkPipelineAttrBinding(3, 0))
  vvpPut(#VVP_S_C_ATTR1_BIND, AnvilVkPipelineAttrBinding(3, 1))

  PokeL(@vvpClear[0] + 0, #VVP_CLEAR_R)
  PokeL(@vvpClear[0] + 4, #VVP_CLEAR_G)
  PokeL(@vvpClear[0] + 8, #VVP_CLEAR_B)
  PokeL(@vvpClear[0] + 12, #VVP_CLEAR_A)
  rpbi\sType = #VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO
  rpbi\renderPass = rp
  rpbi\framebuffer = fb
  rpbi\renderArea\extent\width = #VVP_PANEL_W
  rpbi\renderArea\extent\height = #VVP_PANEL_H
  rpbi\clearValueCount = 1
  rpbi\pClearValues = @vvpClear[0]
  bi\sType = #VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO
  bi\flags = #VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT
  fci\sType = #VK_STRUCTURE_TYPE_FENCE_CREATE_INFO
  If vkCreateFence(dev, @fci, 0, @fence) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_FENCE)
  EndIf
  fenceArray = fence
  cbHandle = cmd
  si\sType = #VK_STRUCTURE_TYPE_SUBMIT_INFO
  si\commandBufferCount = 1
  si\pCommandBuffers = @cbHandle

  vvpPut(#VVP_S_BIN_BEFORE, V3dBinJobs())
  vvpPut(#VVP_S_RENDER_BEFORE, V3dRenderJobs())
  vvpPut(#VVP_S_GUARD_BEFORE, vvpSum(#VVP_SURFACE, #VVP_SCREEN_BYTES))

  ; ------------------------------------------------------------------
  ;  7. PASS A: the uniform-buffer colour.
  ;
  ;     A draw with no descriptor set bound is recorded FIRST, on its
  ;     own command buffer, so the refusal is exercised live and not
  ;     merely believed.
  ; ------------------------------------------------------------------
  vvpStep(7)
  vkResetCommandBuffer(cmd, 0)
  vkBeginCommandBuffer(cmd, @bi)
  vkCmdBeginRenderPass(cmd, @rpbi, #VK_SUBPASS_CONTENTS_INLINE)
  vkCmdBindPipeline(cmd, #VK_PIPELINE_BIND_POINT_GRAPHICS, pipeA)
  twoBufs[0] = bufPos
  twoOffsets[0] = 0
  vkCmdBindVertexBuffers(cmd, 0, 1, @twoBufs[0], @twoOffsets[0])
  vkCmdDraw(cmd, 3, 1, 0, 0)
  vkCmdEndRenderPass(cmd)
  vvpPut(#VVP_S_REF_NOSET, vkEndCommandBuffer(cmd))
  vvpPut(#VVP_S_REF_NOSET_TEXT, AnvilVkCommandBufferFailureText(cmd))

  vkResetCommandBuffer(cmd, 0)
  If vkBeginCommandBuffer(cmd, @bi) <> #VK_SUCCESS
    NeonShutdown()
    ProcedureReturn vvpStop(#VVP_ERR_RECORD)
  EndIf
  dsetArray = dset
  vkCmdBeginRenderPass(cmd, @rpbi, #VK_SUBPASS_CONTENTS_INLINE)
  vkCmdBindPipeline(cmd, #VK_PIPELINE_BIND_POINT_GRAPHICS, pipeA)
  vkCmdBindVertexBuffers(cmd, 0, 1, @twoBufs[0], @twoOffsets[0])
  vkCmdBindDescriptorSets(cmd, #VK_PIPELINE_BIND_POINT_GRAPHICS, layU, 0, 1, @dsetArray, 0, 0)
  vkCmdDraw(cmd, 3, 1, 0, 0)
  vkCmdEndRenderPass(cmd)
  rc = vkEndCommandBuffer(cmd)
  If rc <> #VK_SUCCESS
    vvpPut(#VVP_S_DETAIL, rc)
    vvpPut(#VVP_S_CB_TEXT, AnvilVkCommandBufferFailureText(cmd))
    vvpPut(#VVP_S_STATUS_A, #VVP_ERR_RECORD)
  Else
    t0 = Ticks()
    rc = vkQueueSubmit(queue, 1, @si, fence)
    vvpPut(#VVP_S_SUBMIT_A, rc)
    vvpPut(#VVP_S_US_A, (Ticks() - t0) / hz)
    vvpPut(#VVP_S_NATIVE, AnvilVkBackendNativeError())
    If rc <> #VK_SUCCESS
      vvpPut(#VVP_S_STATUS_A, #VVP_ERR_SUBMIT)
    Else
      rc = vkWaitForFences(dev, 1, @fenceArray, 1, 2000000000)
      vvpPut(#VVP_S_WAIT_A, rc)
      If rc <> #VK_SUCCESS
        vvpPut(#VVP_S_STATUS_A, #VVP_ERR_FENCE)
      Else
        vvpPut(#VVP_S_LAYOUT_AFTER, AnvilVkImageLayout(img))
        vvpPut(#VVP_S_SHREC, AnvilVkV3dLastShaderRecord())
        vvpPut(#VVP_S_A_IN0 + 0, vvpPixel(imgBase, pitch, 400, 500))
        vvpPut(#VVP_S_A_IN0 + 1, vvpPixel(imgBase, pitch, 400, 700))
        vvpPut(#VVP_S_A_IN0 + 2, vvpPixel(imgBase, pitch, 400, 900))
        k = 0
        While k < 3
          vvpPut(#VVP_S_A_OUT0 + k, vvpPixel(imgBase, pitch, vvpOutX[k], vvpOutY[k]))
          k = k + 1
        Wend
        bad = 0
        k = 0
        While k < 3
          If vvpGet(#VVP_S_A_IN0 + k) <> #VVP_MAGENTA_WORD : bad = bad + 1 : EndIf
          k = k + 1
        Wend
        If bad <> 0
          vvpPut(#VVP_S_STATUS_A, #VVP_ERR_PIXELS_IN)
        Else
          bad = 0
          k = 0
          While k < 3
            If vvpGet(#VVP_S_A_OUT0 + k) <> #VVP_CLEAR_WORD : bad = bad + 1 : EndIf
            k = k + 1
          Wend
          If bad <> 0
            vvpPut(#VVP_S_STATUS_A, #VVP_ERR_PIXELS_OUT)
          Else
            vvpPut(#VVP_S_STATUS_A, #VVP_OK)
          EndIf
        EndIf
      EndIf
    EndIf
  EndIf

  ; ------------------------------------------------------------------
  ;  8. PASS B: the gradient out of one interleaved buffer.
  ; ------------------------------------------------------------------
  vvpStep(8)
  vkResetFences(dev, 1, @fenceArray)
  vkResetCommandBuffer(cmd, 0)
  If vkBeginCommandBuffer(cmd, @bi) = #VK_SUCCESS
    twoBufs[0] = bufAll
    twoOffsets[0] = 0
    vkCmdBeginRenderPass(cmd, @rpbi, #VK_SUBPASS_CONTENTS_INLINE)
    vkCmdBindPipeline(cmd, #VK_PIPELINE_BIND_POINT_GRAPHICS, pipeB)
    vkCmdBindVertexBuffers(cmd, 0, 1, @twoBufs[0], @twoOffsets[0])
    vkCmdDraw(cmd, 3, 1, 0, 0)
    vkCmdEndRenderPass(cmd)
    rc = vkEndCommandBuffer(cmd)
    If rc <> #VK_SUCCESS
      vvpPut(#VVP_S_CB_TEXT, AnvilVkCommandBufferFailureText(cmd))
      vvpPut(#VVP_S_STATUS_B, #VVP_ERR_RECORD)
    Else
      t0 = Ticks()
      rc = vkQueueSubmit(queue, 1, @si, fence)
      vvpPut(#VVP_S_SUBMIT_B, rc)
      vvpPut(#VVP_S_US_B, (Ticks() - t0) / hz)
      If rc <> #VK_SUCCESS
        vvpPut(#VVP_S_STATUS_B, #VVP_ERR_SUBMIT)
      Else
        rc = vkWaitForFences(dev, 1, @fenceArray, 1, 2000000000)
        vvpPut(#VVP_S_WAIT_B, rc)
        If rc <> #VK_SUCCESS
          vvpPut(#VVP_S_STATUS_B, #VVP_ERR_FENCE)
        Else
          worst = 0
          over = 0
          k = 0
          While k < 7
            got = vvpPixel(imgBase, pitch, vvpProbeX[k], vvpProbeY[k])
            vvpPut(#VVP_S_B_P0 + k, got)
            want = vvpGet(#VVP_S_EXPECT0 + k)
            d = AnvilVkInterpDistance(got, want)
            If d > worst : worst = d : EndIf
            If d > AnvilVkInterpTolerance() : over = over + 1 : EndIf
            k = k + 1
          Wend
          vvpPut(#VVP_S_B_WORST, worst)
          vvpPut(#VVP_S_B_OVER, over)
          bad = 0
          k = 0
          While k < 3
            vvpPut(#VVP_S_B_OUT0 + k, vvpPixel(imgBase, pitch, vvpOutX[k], vvpOutY[k]))
            If vvpGet(#VVP_S_B_OUT0 + k) <> #VVP_CLEAR_WORD : bad = bad + 1 : EndIf
            k = k + 1
          Wend
          If over <> 0
            vvpPut(#VVP_S_STATUS_B, #VVP_ERR_PIXELS_IN)
          ElseIf bad <> 0
            vvpPut(#VVP_S_STATUS_B, #VVP_ERR_PIXELS_OUT)
          Else
            vvpPut(#VVP_S_STATUS_B, #VVP_OK)
          EndIf
        EndIf
      EndIf
    EndIf
  Else
    vvpPut(#VVP_S_STATUS_B, #VVP_ERR_RECORD)
  EndIf

  ; ------------------------------------------------------------------
  ;  9. PASS C: the same gradient out of TWO buffers at two strides.
  ; ------------------------------------------------------------------
  vvpStep(9)
  vkResetFences(dev, 1, @fenceArray)
  vkResetCommandBuffer(cmd, 0)
  If vkBeginCommandBuffer(cmd, @bi) = #VK_SUCCESS
    twoBufs[0] = bufPos
    twoBufs[1] = bufCol
    twoOffsets[0] = 0
    twoOffsets[1] = 0
    vkCmdBeginRenderPass(cmd, @rpbi, #VK_SUBPASS_CONTENTS_INLINE)
    vkCmdBindPipeline(cmd, #VK_PIPELINE_BIND_POINT_GRAPHICS, pipeC)
    vkCmdBindVertexBuffers(cmd, 0, 2, @twoBufs[0], @twoOffsets[0])
    vkCmdDraw(cmd, 3, 1, 0, 0)
    vkCmdEndRenderPass(cmd)
    rc = vkEndCommandBuffer(cmd)
    If rc <> #VK_SUCCESS
      vvpPut(#VVP_S_CB_TEXT, AnvilVkCommandBufferFailureText(cmd))
      vvpPut(#VVP_S_STATUS_C, #VVP_ERR_RECORD)
    Else
      t0 = Ticks()
      rc = vkQueueSubmit(queue, 1, @si, fence)
      vvpPut(#VVP_S_SUBMIT_C, rc)
      vvpPut(#VVP_S_US_C, (Ticks() - t0) / hz)
      If rc <> #VK_SUCCESS
        vvpPut(#VVP_S_STATUS_C, #VVP_ERR_SUBMIT)
      Else
        rc = vkWaitForFences(dev, 1, @fenceArray, 1, 2000000000)
        vvpPut(#VVP_S_WAIT_C, rc)
        If rc <> #VK_SUCCESS
          vvpPut(#VVP_S_STATUS_C, #VVP_ERR_FENCE)
        Else
          worst = 0
          over = 0
          differs = 0
          k = 0
          While k < 7
            got = vvpPixel(imgBase, pitch, vvpProbeX[k], vvpProbeY[k])
            vvpPut(#VVP_S_C_P0 + k, got)
            want = vvpGet(#VVP_S_EXPECT0 + k)
            d = AnvilVkInterpDistance(got, want)
            If d > worst : worst = d : EndIf
            If d > AnvilVkInterpTolerance() : over = over + 1 : EndIf
            If got <> vvpGet(#VVP_S_B_P0 + k) : differs = differs + 1 : EndIf
            k = k + 1
          Wend
          vvpPut(#VVP_S_C_WORST, worst)
          vvpPut(#VVP_S_C_OVER, over)
          vvpPut(#VVP_S_C_DIFFERS, differs)
          bad = 0
          k = 0
          While k < 3
            vvpPut(#VVP_S_C_OUT0 + k, vvpPixel(imgBase, pitch, vvpOutX[k], vvpOutY[k]))
            If vvpGet(#VVP_S_C_OUT0 + k) <> #VVP_CLEAR_WORD : bad = bad + 1 : EndIf
            k = k + 1
          Wend
          If over <> 0
            vvpPut(#VVP_S_STATUS_C, #VVP_ERR_PIXELS_IN)
          ElseIf bad <> 0
            vvpPut(#VVP_S_STATUS_C, #VVP_ERR_PIXELS_OUT)
          ElseIf differs <> 0 And vvpGet(#VVP_S_STATUS_B) = #VVP_OK
            ; SPLITTING THE DATA MOVED THE PICTURE. Both passes may be
            ; inside tolerance and still not be the same word, and that
            ; is a finding: the two draws run byte-identical programs
            ; over the same numbers and the GPU is deterministic.
            vvpPut(#VVP_S_STATUS_C, #VVP_ERR_SPLIT_DIFFERS)
          Else
            vvpPut(#VVP_S_STATUS_C, #VVP_OK)
          EndIf
        EndIf
      EndIf
    EndIf
  Else
    vvpPut(#VVP_S_STATUS_C, #VVP_ERR_RECORD)
  EndIf

  vvpPut(#VVP_S_BIN_AFTER, V3dBinJobs())
  vvpPut(#VVP_S_RENDER_AFTER, V3dRenderJobs())
  vvpPut(#VVP_S_BIN_OOM, V3dBinOomCount())
  vvpPut(#VVP_S_BIN_ERRSTAT, V3dBinErrStat())
  vvpPut(#VVP_S_RENDER_ERRSTAT, V3dRenderErrStat())
  vvpPut(#VVP_S_MMU_FAULTS, V3dMmuFaultsNow())
  vvpPut(#VVP_S_MMU_VIOADDR, V3dMmuVioAddrNow())
  vvpPut(#VVP_S_GUARD_AFTER, vvpSum(#VVP_SURFACE, #VVP_SCREEN_BYTES))
  vvpPut(#VVP_S_DRAWS, avkBackendDraws())

  ; ------------------------------------------------------------------
  ;  10. Present what is on the image now - pass C's gradient.
  ; ------------------------------------------------------------------
  vvpStep(10)
  rc = DisplayAdopt(#VVP_DSI_SCAN, #VVP_PANEL_PITCH, #VVP_PANEL_W, #VVP_PANEL_H, 32)
  vvpPut(#VVP_S_DISPLAY_ERR, DisplayLastError())
  If rc = #DSP_OK
    DisplayBlit(imgBase, pitch, 0, 0, #VVP_PANEL_W, #VVP_PANEL_H)
    DisplayFlush()
    vvpPut(#VVP_S_PRESENT, #VVP_P_OK)
    delay(#VVP_SHOW_MS)
  Else
    vvpPut(#VVP_S_PRESENT, #VVP_P_ADOPT_REFUSED)
  EndIf

  ; ------------------------------------------------------------------
  ;  11. Ordered teardown, then hand the V3D MMU back.
  ; ------------------------------------------------------------------
  vvpStep(11)
  vkDeviceWaitIdle(dev)
  vkDestroyFence(dev, fence, 0)
  vkDestroyPipeline(dev, pipeA, 0)
  vkDestroyPipeline(dev, pipeB, 0)
  vkDestroyPipeline(dev, pipeC, 0)
  vkDestroyPipelineLayout(dev, layU, 0)
  vkDestroyPipelineLayout(dev, layP, 0)
  vkDestroyDescriptorPool(dev, dpool, 0)
  vkDestroyDescriptorSetLayout(dev, dsl, 0)
  vkDestroyShaderModule(dev, vsA, 0)
  vkDestroyShaderModule(dev, fsA, 0)
  vkDestroyShaderModule(dev, vsB, 0)
  vkDestroyShaderModule(dev, fsB, 0)
  vkDestroyShaderModule(dev, fsC, 0)
  vkDestroyFramebuffer(dev, fb, 0)
  vkDestroyRenderPass(dev, rp, 0)
  vkDestroyImageView(dev, view, 0)
  vkDestroyBuffer(dev, bufAll, 0)
  vkFreeMemory(dev, memAll, 0)
  vkDestroyBuffer(dev, bufPos, 0)
  vkFreeMemory(dev, memPos, 0)
  vkDestroyBuffer(dev, bufCol, 0)
  vkFreeMemory(dev, memCol, 0)
  vkDestroyBuffer(dev, bufUni, 0)
  vkFreeMemory(dev, memUni, 0)
  vkDestroyImage(dev, img, 0)
  vkFreeMemory(dev, mem, 0)
  vkDestroyCommandPool(dev, pool, 0)
  vkDestroyDevice(dev, 0)
  vkDestroyInstance(inst, 0)
  NeonShutdown()
  vvpPut(#VVP_S_SHUTDOWN, 1)

  ; ------------------------------------------------------------------
  ;  12. The verdicts that belong to the run as a whole. They are
  ;      checked in the order that makes the earliest real cause the one
  ;      reported, and they overwrite a pass verdict only when the whole
  ;      run is suspect.
  ; ------------------------------------------------------------------
  vvpStep(12)
  If vvpGet(#VVP_S_BIN_AFTER) <= vvpGet(#VVP_S_BIN_BEFORE) Or vvpGet(#VVP_S_RENDER_AFTER) <= vvpGet(#VVP_S_RENDER_BEFORE)
    ProcedureReturn vvpStop(#VVP_ERR_NO_JOBS)
  EndIf
  If vvpGet(#VVP_S_BIN_OOM) <> 0 Or vvpGet(#VVP_S_MMU_FAULTS) <> 0
    vvpPut(#VVP_S_STATUS_A, #VVP_ERR_V3D_FAULT)
    vvpPut(#VVP_S_STATUS_B, #VVP_ERR_V3D_FAULT)
    vvpPut(#VVP_S_STATUS_C, #VVP_ERR_V3D_FAULT)
    ProcedureReturn vvpStop(#VVP_ERR_V3D_FAULT)
  EndIf
  If vvpGet(#VVP_S_GUARD_AFTER) <> vvpGet(#VVP_S_GUARD_BEFORE)
    vvpPut(#VVP_S_STATUS_A, #VVP_ERR_GUARD_CHANGED)
    vvpPut(#VVP_S_STATUS_B, #VVP_ERR_GUARD_CHANGED)
    vvpPut(#VVP_S_STATUS_C, #VVP_ERR_GUARD_CHANGED)
    ProcedureReturn vvpStop(#VVP_ERR_GUARD_CHANGED)
  EndIf
  ; EVERY REFUSAL THAT WAS EXERCISED MUST HAVE REFUSED. A run where one
  ; of them quietly succeeded is a run where the guard it represents is
  ; gone, and that is worth a red verdict of its own even if all three
  ; pictures were right.
  If vvpGet(#VVP_S_REF_BINDING) = 0 Or vvpGet(#VVP_S_REF_DESCTYPE) = 0 Or vvpGet(#VVP_S_REF_NOSET) = 0 Or vvpGet(#VVP_S_REF_NOLAYOUT) = 0
    ProcedureReturn vvpStop(#VVP_ERR_REFUSAL_MISSING)
  EndIf
  If vvpGet(#VVP_S_LAYOUT_AFTER) <> #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL
    ProcedureReturn vvpStop(#VVP_ERR_FENCE)
  EndIf
  vvpPut(#VVP_S_FAULT_TEXT, AnvilVkFaultText())
  vvpPut(#VVP_S_FAULT_COUNT, AnvilVkFaultCount())
  ProcedureReturn @vvpReport[0]
EndProcedure
