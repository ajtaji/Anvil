; RAM-only Pi 4 Vulkan pyramid proof with alternating viewport sizes.
; The final frame uses a half-target viewport and matching scissor.

EnableFloatingPoint
#VTP_BLEND_PROOF = 0
#VTP_LIST_PROOF = 1
#VTP_INDEXED_PROOF = 0
#VTP_PYRAMID_DEMO = 2
XIncludeFile "RaspberryPi4/Examples/Diagnostics/vulkanTriangleProofBody.pbi"
