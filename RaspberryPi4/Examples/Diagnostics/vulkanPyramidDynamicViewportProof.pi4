; RAM-only Pi 4 Vulkan pyramid proof with a dynamic full-target viewport.
; Its alternating scissor ends half-size to expose the V3D clip result.

EnableFloatingPoint
#VTP_BLEND_PROOF = 0
#VTP_LIST_PROOF = 1
#VTP_INDEXED_PROOF = 0
#VTP_PYRAMID_DEMO = 2
XIncludeFile "RaspberryPi4/Examples/Diagnostics/vulkanTriangleProofBody.pbi"
