; Bounded, returning Pi 4 proof for Neon's sprite rotation and camera mapping.
; The monitor owns the deadman. This payload writes no boot or storage media.
; The returned 32-word report contains status, stage and observed BGRA pixels.
; Build with --entry-returns; x0 must equal `global_nspreport` in the newly
; generated .img.sym (that symbol is decimal). Read only 128 bytes at that
; address after the payload returns. Never reuse a previous build's address.
; Report: [0,15,31] magic, [1] status (0 pass), [2] stage, [3] create result,
; [4,5] draw/vertex counts, [6] present pending, [7..12] six BGRA probes,
; [13,14] Vulkan fault count/text, [16] extreme-input refusal, [17,18]
; transform draw/vertex counts, [19..29] transform BGRA probes. The payload
; checks its own pixel oracle before returning.

XIncludeFile "RaspberryPi4/Lib/uart.pi4"
XIncludeFile "RaspberryPi4/Lib/timer.pi4"
XIncludeFile "RaspberryPi4/Lib/safety.pi4"
XIncludeFile "RaspberryPi4/Lib/mailbox.pi4"
#DSP_DMA_LINKED = 1
XIncludeFile "RaspberryPi4/Lib/dma.pi4"
XIncludeFile "RaspberryPi4/Lib/display.pi4"
XIncludeFile "RaspberryPi4/Lib/v3dqpu.pi4"
XIncludeFile "RaspberryPi4/Lib/v3d.pi4"
XIncludeFile "RaspberryPi4/Lib/neon.pi4"
XIncludeFile "Anvil/Graphics/Vulkan/vk_api.pbi"
XIncludeFile "Anvil/Graphics/Vulkan/vk_spirv_fixtures.pbi"
XIncludeFile "Anvil/Graphics/Vulkan/vk_v3d_shader.pi4"
XIncludeFile "RaspberryPi4/Board/vulkan_dma.pi4"
XIncludeFile "Anvil/Graphics/Vulkan/vk_v3d_backend.pi4"
XIncludeFile "Anvil/Graphics/Vulkan/neon_vk_chrome.pi4"

#NSP_SIZE         = 64
#NSP_ARENA        = $0A000000
#NSP_ARENA_BYTES  = $01000000
#NSP_SURFACE      = $06000000
#NSP_WINDOW       = $063E8000
#NSP_WINDOW_BYTES = $00C00000
#NSP_MAGIC        = $54534E56

Global Dim nspReport.l[32]
Global Dim nspPixels.a[16]
Global Dim nspClear.l[4]
Global nspInstance.i, nspDevice.i, nspPool.i, nspImage.i, nspMemory.i
Global nspView.i, nspPass.i, nspFrame.i, nspAdapter.i, nspNeon.i

Procedure nspCleanup()
  If nspAdapter <> 0 : NeonVkChromeDestroy() : EndIf
  NeonVkChromeSpriteSource(0, 0, 0)
  If nspDevice <> 0 : vkDeviceWaitIdle(nspDevice) : EndIf
  If nspFrame <> 0 : vkDestroyFramebuffer(nspDevice, nspFrame, 0) : EndIf
  If nspPass <> 0 : vkDestroyRenderPass(nspDevice, nspPass, 0) : EndIf
  If nspView <> 0 : vkDestroyImageView(nspDevice, nspView, 0) : EndIf
  If nspImage <> 0 : vkDestroyImage(nspDevice, nspImage, 0) : EndIf
  If nspMemory <> 0 : vkFreeMemory(nspDevice, nspMemory, 0) : EndIf
  If nspPool <> 0 : vkDestroyCommandPool(nspDevice, nspPool, 0) : EndIf
  If nspDevice <> 0 : vkDestroyDevice(nspDevice, 0) : EndIf
  If nspInstance <> 0 : vkDestroyInstance(nspInstance, 0) : EndIf
  If nspNeon <> 0 : NeonShutdown() : EndIf
EndProcedure

Procedure.i nspReturn(status.i)
  nspReport[1] = status
  nspReport[13] = AnvilVkFaultCount()
  nspReport[14] = AnvilVkFaultText()
  nspCleanup()
  ProcedureReturn @nspReport[0]
EndProcedure

Procedure.i nspPixel(base.i, pitch.i, x.i, y.i)
  ProcedureReturn PeekL(base + y * pitch + x * 4) & $FFFFFFFF
EndProcedure

Procedure.i nspWord(slot.i)
  ProcedureReturn nspReport[slot] & $FFFFFFFF
EndProcedure

Procedure.i Main()
  Define rc.i, count.i, phys.i, queue.i, base.i, pitch.i, green.i
  Define ici.VkInstanceCreateInfo
  Define qci.VkDeviceQueueCreateInfo
  Define dci.VkDeviceCreateInfo
  Define pci.VkCommandPoolCreateInfo
  Define imageInfo.VkImageCreateInfo
  Define req.VkMemoryRequirements
  Define alloc.VkMemoryAllocateInfo
  Define viewInfo.VkImageViewCreateInfo
  Define attachment.VkAttachmentDescription
  Define attachmentRef.VkAttachmentReference
  Define subpass.VkSubpassDescription
  Define passInfo.VkRenderPassCreateInfo
  Define frameInfo.VkFramebufferCreateInfo
  Define priority.l

  nspReport[0] = #NSP_MAGIC
  nspReport[15] = #NSP_MAGIC
  nspReport[31] = #NSP_MAGIC
  ; Top row: opaque red, half-alpha green. Bottom row: invisible blue,
  ; opaque white. Explicit bytes avoid image-decoder and host pixel layouts.
  nspPixels[0] = 255 : nspPixels[1] = 0 : nspPixels[2] = 0 : nspPixels[3] = 255
  nspPixels[4] = 0 : nspPixels[5] = 255 : nspPixels[6] = 0 : nspPixels[7] = 128
  nspPixels[8] = 0 : nspPixels[9] = 0 : nspPixels[10] = 255 : nspPixels[11] = 0
  nspPixels[12] = 255 : nspPixels[13] = 255 : nspPixels[14] = 255 : nspPixels[15] = 255
  nspClear[0] = 0 : nspClear[1] = 0 : nspClear[2] = 0 : nspClear[3] = $3F800000

  TimerInit()
  nspReport[2] = 1
  If NeonArena(#NSP_ARENA, #NSP_ARENA_BYTES) <> #NEON_OK : ProcedureReturn nspReturn(1) : EndIf
  If NeonSurface(#NSP_SURFACE, #NSP_SIZE, #NSP_SIZE, #NSP_SIZE * 4) <> #NEON_OK : ProcedureReturn nspReturn(1) : EndIf
  ; The sampled TrueType/sprite atlas is 512x1024 even though this proof's
  ; attachment is 64x64. Declare that capacity before NeonInit so Vulkan's
  ; truthful maxImageDimension2D covers the atlas.
  If NeonRenderCapacity(1024, 1024) <> #NEON_OK : ProcedureReturn nspReturn(1) : EndIf
  NeonSurfaceMapSpan($00FE8000)
  If NeonInit() <> #NEON_OK : ProcedureReturn nspReturn(1) : EndIf
  nspNeon = 1
  NeonPalette() : NeonFontDefaults() : NeonFontUse(?dsp_font8x16, 8, 16, 32, 126)
  NeonAnimReset() : NeonStateReset()
  rc = AnvilVkV3dWindow(#NSP_WINDOW, #NSP_WINDOW_BYTES)
  If rc <> #VK_SUCCESS : ProcedureReturn nspReturn(2) : EndIf

  nspReport[2] = 2
  ici\sType = #VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO
  rc = vkCreateInstance(@ici, 0, @nspInstance)
  If rc <> #VK_SUCCESS : ProcedureReturn nspReturn(3) : EndIf
  count = 1
  rc = vkEnumeratePhysicalDevices(nspInstance, @count, @phys)
  If rc <> #VK_SUCCESS Or count <> 1 Or phys = 0 : ProcedureReturn nspReturn(4) : EndIf
  priority = 0
  qci\sType = #VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO
  qci\queueCount = 1 : qci\pQueuePriorities = @priority
  dci\sType = #VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO
  dci\queueCreateInfoCount = 1 : dci\pQueueCreateInfos = @qci
  rc = vkCreateDevice(phys, @dci, 0, @nspDevice)
  If rc <> #VK_SUCCESS : ProcedureReturn nspReturn(5) : EndIf
  vkGetDeviceQueue(nspDevice, 0, 0, @queue)
  pci\sType = #VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO
  pci\flags = #VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT
  rc = vkCreateCommandPool(nspDevice, @pci, 0, @nspPool)
  If rc <> #VK_SUCCESS : ProcedureReturn nspReturn(6) : EndIf

  nspReport[2] = 3
  imageInfo\sType = #VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO
  imageInfo\imageType = #VK_IMAGE_TYPE_2D
  imageInfo\format = #VK_FORMAT_B8G8R8A8_UNORM
  imageInfo\extent\width = #NSP_SIZE : imageInfo\extent\height = #NSP_SIZE : imageInfo\extent\depth = 1
  imageInfo\mipLevels = 1 : imageInfo\arrayLayers = 1 : imageInfo\samples = #VK_SAMPLE_COUNT_1_BIT
  imageInfo\tiling = #VK_IMAGE_TILING_LINEAR
  imageInfo\usage = #VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | #VK_IMAGE_USAGE_TRANSFER_SRC_BIT
  imageInfo\sharingMode = #VK_SHARING_MODE_EXCLUSIVE
  imageInfo\initialLayout = #VK_IMAGE_LAYOUT_UNDEFINED
  rc = vkCreateImage(nspDevice, @imageInfo, 0, @nspImage)
  If rc <> #VK_SUCCESS : ProcedureReturn nspReturn(7) : EndIf
  vkGetImageMemoryRequirements(nspDevice, nspImage, @req)
  alloc\sType = #VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO
  alloc\allocationSize = req\size : alloc\memoryTypeIndex = 0
  rc = vkAllocateMemory(nspDevice, @alloc, 0, @nspMemory)
  If rc = #VK_SUCCESS : rc = vkBindImageMemory(nspDevice, nspImage, nspMemory, 0) : EndIf
  If rc <> #VK_SUCCESS : ProcedureReturn nspReturn(8) : EndIf
  base = AnvilVkImageAddress(nspImage) : pitch = AnvilVkImageRowPitch(nspImage)
  If base = 0 Or pitch < #NSP_SIZE * 4 : ProcedureReturn nspReturn(9) : EndIf
  viewInfo\sType = #VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO
  viewInfo\image = nspImage : viewInfo\viewType = #VK_IMAGE_VIEW_TYPE_2D
  viewInfo\format = #VK_FORMAT_B8G8R8A8_UNORM
  viewInfo\subresourceRange\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT
  viewInfo\subresourceRange\levelCount = 1 : viewInfo\subresourceRange\layerCount = 1
  rc = vkCreateImageView(nspDevice, @viewInfo, 0, @nspView)
  If rc <> #VK_SUCCESS : ProcedureReturn nspReturn(10) : EndIf

  attachment\format = #VK_FORMAT_B8G8R8A8_UNORM
  attachment\samples = #VK_SAMPLE_COUNT_1_BIT
  attachment\loadOp = #VK_ATTACHMENT_LOAD_OP_CLEAR : attachment\storeOp = #VK_ATTACHMENT_STORE_OP_STORE
  attachment\stencilLoadOp = #VK_ATTACHMENT_LOAD_OP_DONT_CARE
  attachment\stencilStoreOp = #VK_ATTACHMENT_STORE_OP_DONT_CARE
  attachment\initialLayout = #VK_IMAGE_LAYOUT_UNDEFINED
  attachment\finalLayout = #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL
  attachmentRef\attachment = 0 : attachmentRef\layout = #VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL
  subpass\pipelineBindPoint = #VK_PIPELINE_BIND_POINT_GRAPHICS
  subpass\colorAttachmentCount = 1 : subpass\pColorAttachments = @attachmentRef
  passInfo\sType = #VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO
  passInfo\attachmentCount = 1 : passInfo\pAttachments = @attachment
  passInfo\subpassCount = 1 : passInfo\pSubpasses = @subpass
  rc = vkCreateRenderPass(nspDevice, @passInfo, 0, @nspPass)
  If rc <> #VK_SUCCESS : ProcedureReturn nspReturn(11) : EndIf
  frameInfo\sType = #VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO
  frameInfo\renderPass = nspPass : frameInfo\attachmentCount = 1
  frameInfo\pAttachments = @nspView : frameInfo\width = #NSP_SIZE
  frameInfo\height = #NSP_SIZE : frameInfo\layers = 1
  rc = vkCreateFramebuffer(nspDevice, @frameInfo, 0, @nspFrame)
  If rc <> #VK_SUCCESS : ProcedureReturn nspReturn(12) : EndIf

  nspReport[2] = 4
  rc = NeonVkChromeSpriteSource(@nspPixels[0], 2, 2)
  If rc <> #NEON_VK_CHROME_OK : ProcedureReturn nspReturn(13) : EndIf
  rc = NeonVkChromeCreateWithCapacities(phys, nspDevice, queue, nspPool, nspPass, nspFrame, #NSP_SIZE, #NSP_SIZE, 8, 8)
  nspReport[3] = rc
  If rc <> #VK_SUCCESS
    nspReport[4] = nvcCreateStage
    nspReport[5] = nvcCreateFaultCode
    nspReport[6] = nvcCreateFaultText
    NeonVkChromeDestroy()
    ProcedureReturn nspReturn(14)
  EndIf
  nspAdapter = 1
  rc = NeonVkChromeBegin(@nspClear[0])
  If rc <> #VK_SUCCESS : ProcedureReturn nspReturn(15) : EndIf
  rc = NeonVkChromeSprite(8, 8, 0, 0, 2, 2, 16, 16, Neon_RGB(255, 255, 255))
  If rc = #NEON_VK_CHROME_OK : rc = NeonVkChromeSprite(32, 8, 1, 0, 1, 1, 8, 8, Neon_RGB(255, 255, 255)) : EndIf
  If rc = #NEON_VK_CHROME_OK : rc = NeonVkChromeSprite(44, 8, 0, 1, 1, 1, 8, 8, Neon_RGB(255, 255, 255)) : EndIf
  If rc = #NEON_VK_CHROME_OK : rc = NeonVkChromeSprite(8, 32, 1, 1, 1, 1, 8, 8, Neon_RGB(255, 128, 255)) : EndIf
  If rc <> #NEON_VK_CHROME_OK : ProcedureReturn nspReturn(16) : EndIf
  rc = NeonVkChromeEnd()
  If rc <> #VK_SUCCESS : ProcedureReturn nspReturn(17) : EndIf
  nspReport[4] = NeonVkChromeDrawCount() : nspReport[5] = NeonVkChromeVertexCount()
  nspReport[6] = NeonVkChromePresentPending()
  If NeonVkChromePresentConsume() <> 1 : ProcedureReturn nspReturn(18) : EndIf

  nspReport[2] = 5
  nspReport[7] = nspPixel(base, pitch, 2, 2)
  nspReport[8] = nspPixel(base, pitch, 10, 10)
  nspReport[9] = nspPixel(base, pitch, 18, 10)
  nspReport[10] = nspPixel(base, pitch, 10, 18)
  nspReport[11] = nspPixel(base, pitch, 34, 10)
  nspReport[12] = nspPixel(base, pitch, 10, 34)
  green = (nspReport[9] >> 8) & $FF
  If nspReport[4] <> 4 Or nspReport[5] <> 24 Or nspReport[6] <> 1 : ProcedureReturn nspReturn(19) : EndIf
  If nspWord(7) <> $FF000000 Or nspWord(8) <> $FFFF0000 : ProcedureReturn nspReturn(20) : EndIf
  If nspWord(10) <> $FF000000 Or nspWord(12) <> $FFFF80FF : ProcedureReturn nspReturn(21) : EndIf
  If green < 126 Or green > 129 : ProcedureReturn nspReturn(22) : EndIf
  If nspReport[11] <> nspReport[9] : ProcedureReturn nspReturn(23) : EndIf

  ; A second clear separates the transform oracle from the existing sprite
  ; oracle. Source quadrants differ, so 90-degree rotation is observable.
  nspReport[2] = 6
  rc = NeonVkChromeBegin(@nspClear[0])
  If rc <> #VK_SUCCESS : ProcedureReturn nspReturn(24) : EndIf
  rc = NeonVkChromeSpriteTransform($7FFFFFFF, 0, 0, 0, 2, 2, 16, 16, Neon_RGB(255, 255, 255), 0, 0, 0, 65536, 1)
  nspReport[16] = rc
  If rc <> #NEON_VK_CHROME_ERR_ARGS : ProcedureReturn nspReturn(25) : EndIf
  ; Positive quarter-turn is clockwise in screen coordinates.
  rc = NeonVkChromeSpriteTransform(32, 8, 0, 0, 2, 2, 16, 16, Neon_RGB(255, 255, 255), #NVC_SPRITE_HALF_PI_Q16, 0, 0, 65536, 1)
  If rc = #NEON_VK_CHROME_OK
    ; Camera: centre 32,32; (26,26) minus (4,2), zoom 2 -> (12,16).
    rc = NeonVkChromeSpriteTransform(26, 26, 0, 0, 2, 2, 8, 8, Neon_RGB(255, 255, 255), 0, 4, 2, 131072, 0)
  EndIf
  If rc = #NEON_VK_CHROME_OK
    ; Ignoring the same camera leaves both position and dimensions unchanged.
    rc = NeonVkChromeSpriteTransform(44, 40, 0, 0, 2, 2, 8, 8, Neon_RGB(255, 255, 255), 0, 4, 2, 131072, 1)
  EndIf
  If rc <> #NEON_VK_CHROME_OK : ProcedureReturn nspReturn(26) : EndIf
  rc = NeonVkChromeEnd()
  If rc <> #VK_SUCCESS : ProcedureReturn nspReturn(27) : EndIf
  nspReport[17] = NeonVkChromeDrawCount() : nspReport[18] = NeonVkChromeVertexCount()
  nspReport[30] = NeonVkChromePresentPending()
  If NeonVkChromePresentConsume() <> 1 : ProcedureReturn nspReturn(28) : EndIf

  nspReport[2] = 7
  nspReport[19] = nspPixel(base, pitch, 2, 2)
  nspReport[20] = nspPixel(base, pitch, 34, 10)
  nspReport[21] = nspPixel(base, pitch, 42, 10)
  nspReport[22] = nspPixel(base, pitch, 34, 18)
  nspReport[23] = nspPixel(base, pitch, 42, 18)
  nspReport[24] = nspPixel(base, pitch, 14, 18)
  nspReport[25] = nspPixel(base, pitch, 22, 18)
  nspReport[26] = nspPixel(base, pitch, 14, 26)
  nspReport[27] = nspPixel(base, pitch, 22, 26)
  nspReport[28] = nspPixel(base, pitch, 45, 41)
  nspReport[29] = nspPixel(base, pitch, 55, 55)
  If nspReport[17] <> 3 Or nspReport[18] <> 18 Or nspReport[30] <> 1 : ProcedureReturn nspReturn(29) : EndIf
  If nspWord(19) <> $FF000000 Or nspWord(20) <> $FF000000 Or nspWord(21) <> $FFFF0000 : ProcedureReturn nspReturn(30) : EndIf
  If nspWord(22) <> $FFFFFFFF Or nspWord(24) <> $FFFF0000 Or nspWord(26) <> $FF000000 Or nspWord(27) <> $FFFFFFFF : ProcedureReturn nspReturn(31) : EndIf
  If nspWord(28) <> $FFFF0000 Or nspWord(29) <> $FF000000 : ProcedureReturn nspReturn(32) : EndIf
  green = (nspReport[23] >> 8) & $FF
  If green < 126 Or green > 129 Or nspReport[23] <> nspReport[25] : ProcedureReturn nspReturn(33) : EndIf
  ProcedureReturn nspReturn(0)
EndProcedure
