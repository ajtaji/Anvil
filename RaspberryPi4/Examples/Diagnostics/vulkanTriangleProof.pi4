; vulkanTriangleProof.pi4 - disabled-blend control for the Vulkan V3D draw.
;
; The complete diagnostic, report documentation and acceptance oracle live in
; vulkanTriangleProofBody.pbi so the source-over proof can share them without
; copying a safety-critical board payload.

#VTP_BLEND_PROOF = 0
#VTP_LIST_PROOF = 0
#VTP_INDEXED_PROOF = 0
XIncludeFile "RaspberryPi4/Examples/Diagnostics/vulkanTriangleProofBody.pbi"
