; Returning RAM payload: 12-frame rotating 3D pyramid rasterized by Vulkan/V3D.
; Projected vertices are updated by the CPU; all triangles run on the GPU.
; The completed attachment is presented through DMA once per frame.

EnableFloatingPoint
#VTP_BLEND_PROOF = 0
#VTP_LIST_PROOF = 1
#VTP_INDEXED_PROOF = 0
#VTP_PYRAMID_DEMO = 1
XIncludeFile "RaspberryPi4/Examples/Diagnostics/vulkanTriangleProofBody.pbi"
