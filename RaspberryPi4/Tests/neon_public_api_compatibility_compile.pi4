; Compile-only exact-call fixture for every public Neon procedure.
; The function is never executed; zero arguments only exercise signatures.
XIncludeFile "RaspberryPi4/Lib/uart.pi4"
XIncludeFile "RaspberryPi4/Lib/timer.pi4"
