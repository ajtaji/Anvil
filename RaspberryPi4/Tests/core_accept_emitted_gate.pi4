XIncludeFile "RaspberryPi4/Board/core_accept_cmd.pi4"
Procedure.i Main()
  If CoreRawId() = 99
    CoreAcceptRun()
    CoreAcceptStop()
    CmdCoreAcceptRun()
    CmdCoreAcceptStop()
    CmdCoreAcceptStatus()
  EndIf
  ProcedureReturn CoreAcceptRow(1)
EndProcedure
