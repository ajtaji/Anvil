; Focused public-entry check for one aligned optimal-image readback rectangle.
XIncludeFile "Anvil/Graphics/Vulkan/vk_api.pbi"
XIncludeFile "Anvil/Graphics/Vulkan/vk_backend_test.pbi"

#VPR_HEAP = $00200000
#VPR_HEAP_BYTES = $00020000

Global vprFailures.i = 0
Global vprChecks.i = 0

Procedure VprCheck(ok.i)
  vprChecks = vprChecks + 1
  If ok = 0 : vprFailures = vprFailures + 1 : EndIf
EndProcedure

Procedure.i Main()
  Define inst.i, phys.i, dev.i, queue.i, pool.i, cmd.i
  Define img.i, imgMem.i, buf.i, bufMem.i, count.i, prior.i, mapped.i, i.i
  Define ici.VkInstanceCreateInfo
  Define qci.VkDeviceQueueCreateInfo
  Define dci.VkDeviceCreateInfo
  Define pci.VkCommandPoolCreateInfo
  Define cai.VkCommandBufferAllocateInfo
  Define bi.VkCommandBufferBeginInfo
  Define imageInfo.VkImageCreateInfo
  Define bufferInfo.VkBufferCreateInfo
  Define req.VkMemoryRequirements
  Define mai.VkMemoryAllocateInfo
  Define bar.VkImageMemoryBarrier
  Define region.VkBufferImageCopy
  Define submit.VkSubmitInfo
  Define priority.l

  AnvilVkTestBackendHeap(#VPR_HEAP, #VPR_HEAP_BYTES)
  AnvilVkTestBackendLimits(4096, 64)
  ici\sType = #VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO
  VprCheck(vkCreateInstance(@ici, 0, @inst) = #VK_SUCCESS)
  count = 1
  VprCheck(vkEnumeratePhysicalDevices(inst, @count, @phys) = #VK_SUCCESS)
  qci\sType = #VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO
  qci\queueCount = 1 : qci\pQueuePriorities = @priority
  dci\sType = #VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO
  dci\queueCreateInfoCount = 1 : dci\pQueueCreateInfos = @qci
  VprCheck(vkCreateDevice(phys, @dci, 0, @dev) = #VK_SUCCESS)
  vkGetDeviceQueue(dev, 0, 0, @queue)
  VprCheck(queue <> #VK_NULL_HANDLE)
  pci\sType = #VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO
  pci\flags = #VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT
  VprCheck(vkCreateCommandPool(dev, @pci, 0, @pool) = #VK_SUCCESS)
  cai\sType = #VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO
  cai\commandPool = pool : cai\level = #VK_COMMAND_BUFFER_LEVEL_PRIMARY
  cai\commandBufferCount = 1
  VprCheck(vkAllocateCommandBuffers(dev, @cai, @cmd) = #VK_SUCCESS)

  imageInfo\sType = #VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO
  imageInfo\imageType = #VK_IMAGE_TYPE_2D
  imageInfo\format = #VK_FORMAT_B8G8R8A8_UNORM
  imageInfo\extent\width = 8 : imageInfo\extent\height = 8 : imageInfo\extent\depth = 1
  imageInfo\mipLevels = 1 : imageInfo\arrayLayers = 1
  imageInfo\samples = #VK_SAMPLE_COUNT_1_BIT
  imageInfo\tiling = #VK_IMAGE_TILING_OPTIMAL
  imageInfo\usage = #VK_IMAGE_USAGE_TRANSFER_SRC_BIT | #VK_IMAGE_USAGE_TRANSFER_DST_BIT
  imageInfo\sharingMode = #VK_SHARING_MODE_EXCLUSIVE
  imageInfo\initialLayout = #VK_IMAGE_LAYOUT_UNDEFINED
  VprCheck(vkCreateImage(dev, @imageInfo, 0, @img) = #VK_SUCCESS)
  vkGetImageMemoryRequirements(dev, img, @req)
  mai\sType = #VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO
  mai\allocationSize = req\size : mai\memoryTypeIndex = 1
  VprCheck(vkAllocateMemory(dev, @mai, 0, @imgMem) = #VK_SUCCESS)
  VprCheck(vkBindImageMemory(dev, img, imgMem, 0) = #VK_SUCCESS)

  bufferInfo\sType = #VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO
  bufferInfo\size = 256
  bufferInfo\usage = #VK_BUFFER_USAGE_TRANSFER_DST_BIT
  bufferInfo\sharingMode = #VK_SHARING_MODE_EXCLUSIVE
  VprCheck(vkCreateBuffer(dev, @bufferInfo, 0, @buf) = #VK_SUCCESS)
  vkGetBufferMemoryRequirements(dev, buf, @req)
  mai\allocationSize = req\size
  VprCheck(vkAllocateMemory(dev, @mai, 0, @bufMem) = #VK_SUCCESS)
  VprCheck(vkBindBufferMemory(dev, buf, bufMem, 0) = #VK_SUCCESS)
  VprCheck(vkMapMemory(dev, bufMem, 0, 256, 0, @mapped) = #VK_SUCCESS)
  For i = 0 To 255 : PokeA(mapped + i, $A5) : Next
  vkUnmapMemory(dev, bufMem)

  bi\sType = #VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO
  bar\sType = #VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER
  bar\image = img
  bar\oldLayout = #VK_IMAGE_LAYOUT_UNDEFINED
  bar\newLayout = #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL
  bar\srcQueueFamilyIndex = #VK_QUEUE_FAMILY_IGNORED
  bar\dstQueueFamilyIndex = #VK_QUEUE_FAMILY_IGNORED
  bar\dstAccessMask = #VK_ACCESS_TRANSFER_READ_BIT
  bar\subresourceRange\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT
  bar\subresourceRange\levelCount = 1 : bar\subresourceRange\layerCount = 1
  region\bufferOffset = 64 : region\bufferRowLength = 8
  region\imageSubresource\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT
  region\imageSubresource\layerCount = 1
  region\imageOffset\x = 4 : region\imageOffset\y = 0
  region\imageExtent\width = 4 : region\imageExtent\height = 4 : region\imageExtent\depth = 1

  VprCheck(vkBeginCommandBuffer(cmd, @bi) = #VK_SUCCESS)
  vkCmdPipelineBarrier(cmd, #VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, #VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, 0, 0, 0, 1, @bar)
  vkCmdCopyImageToBuffer(cmd, img, #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, buf, 1, @region)
  VprCheck(vkEndCommandBuffer(cmd) = #VK_SUCCESS)
  prior = AnvilVkTestBackendCalls()
  submit\sType = #VK_STRUCTURE_TYPE_SUBMIT_INFO
  submit\commandBufferCount = 1 : submit\pCommandBuffers = @cmd
  VprCheck(vkQueueSubmit(queue, 1, @submit, #VK_NULL_HANDLE) = #VK_SUCCESS)
  VprCheck(AnvilVkTestBackendCalls() = prior + 1)

  VprCheck(vkResetCommandBuffer(cmd, 0) = #VK_SUCCESS)
  VprCheck(vkBeginCommandBuffer(cmd, @bi) = #VK_SUCCESS)
  region\imageOffset\x = 2
  vkCmdCopyImageToBuffer(cmd, img, #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, buf, 1, @region)
  VprCheck(vkEndCommandBuffer(cmd) = #ANVIL_VK_ERR_UNSUPPORTED)
  VprCheck(AnvilVkTestBackendCalls() = prior + 1)

  VprCheck(vkResetCommandBuffer(cmd, 0) = #VK_SUCCESS)
  VprCheck(vkBeginCommandBuffer(cmd, @bi) = #VK_SUCCESS)
  region\imageOffset\x = 4 : region\bufferOffset = 240
  vkCmdCopyImageToBuffer(cmd, img, #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, buf, 1, @region)
  VprCheck(vkEndCommandBuffer(cmd) = #ANVIL_VK_ERR_STATE)
  VprCheck(AnvilVkTestBackendCalls() = prior + 1)
  region\bufferOffset = 64

  VprCheck(vkResetCommandBuffer(cmd, 0) = #VK_SUCCESS)
  VprCheck(vkBeginCommandBuffer(cmd, @bi) = #VK_SUCCESS)
  region\imageOffset\x = 4
  AnvilVkTestBackendCapabilities(#ANVIL_VK_CAP_DEVICE | #ANVIL_VK_CAP_BUFFER_TRANSFER)
  vkCmdCopyImageToBuffer(cmd, img, #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, buf, 1, @region)
  VprCheck(vkEndCommandBuffer(cmd) = #ANVIL_VK_ERR_UNSUPPORTED)
  VprCheck(AnvilVkTestBackendCalls() = prior + 1)
  VprCheck(vkMapMemory(dev, bufMem, 0, 256, 0, @mapped) = #VK_SUCCESS)
  For i = 0 To 255
    If PeekA(mapped + i) <> $A5 : vprFailures = vprFailures + 1 : Break : EndIf
  Next
  vprChecks = vprChecks + 1
  vkUnmapMemory(dev, bufMem)

  PokeI($06000000, vprChecks)
  PokeI($06000008, vprFailures)
  ProcedureReturn vprFailures
EndProcedure
