; Compile closure for the target-neutral exFAT driver. Runtime behavior is
; exercised by tools/exfat_fixture_check.py against a memory block device.
XIncludeFile "RaspberryPi4/Lib/fat.pi4"

Procedure.i Main()
  ExFatSetRangeReader(0)
  ExFatSetRangeWriter(0)
  ExFatSetBlockFlusher(0)
  ProcedureReturn ExFatMount(1)
EndProcedure
