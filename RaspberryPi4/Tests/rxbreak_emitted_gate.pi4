; Emitted-code gate for the production long-command cancellation mux.
; The UART and admitted network byte are scripted; rxbreak.pbi itself is
; compiled unchanged. Main returns the first failing assertion.

Global gate_ticks.i
Global gToTicks.i = 1000
Global gate_uartReady.i
Global gate_uartByte.i
Global gate_localClaims.i
Global gate_netPending.i       ; 1 admitted owner byte, 2 rejected peer
Global gate_netByte.i
Global gate_netHave.i
Global gate_busy.i
Global gate_pumpCalls.i
Global gate_pumpDepth.i
Global gate_pumpMax.i
Global gate_msgDepth.i         ; the message bracket, counted
Global gate_pumpInMsg.i        ; pumps that ran inside one
Global gate_keyboardByte.i
Global gate_queuedInput.i

; Print/PrintN compiler hooks. The gate cares only about cancellation
; state, not the prose sent after an abort.
Procedure str_print_at(p.i)
EndProcedure
Procedure PrintDec(v.i)
EndProcedure
Procedure PrintNl()
EndProcedure

Procedure.i Ticks()
  gate_ticks = gate_ticks + 1
  ProcedureReturn gate_ticks
EndProcedure
Procedure.i TickHz()
  ProcedureReturn 1000
EndProcedure
Procedure.i UartReadReady()
  ProcedureReturn gate_uartReady
EndProcedure
Procedure.i UartRead()
  gate_uartReady = 0
  ProcedureReturn gate_uartByte
EndProcedure
Procedure NetConsoleClaimLocal()
  gate_localClaims = gate_localClaims + 1
EndProcedure
Procedure.i NetConsoleGetc()
  Define c.i
  If gate_netHave = 0 : ProcedureReturn -1 : EndIf
  c = gate_netByte
  gate_netHave = 0
  ProcedureReturn c
EndProcedure
; The message context (RaspberryPi4/Lib/uart.pi4). The pump a long command
; runs to notice Ctrl-C is background work, so it must run inside one.
Procedure UartMessageBegin()
  gate_msgDepth = gate_msgDepth + 1
EndProcedure
Procedure UartMessageEnd()
  gate_msgDepth = gate_msgDepth - 1
EndProcedure

Procedure NetConsolePump()
  gate_pumpCalls = gate_pumpCalls + 1
  If gate_msgDepth > 0 : gate_pumpInMsg = gate_pumpInMsg + 1 : EndIf
  gate_pumpDepth = gate_pumpDepth + 1
  If gate_pumpDepth > gate_pumpMax : gate_pumpMax = gate_pumpDepth : EndIf
  If gate_netPending = 1
    gate_netHave = 1
  ElseIf gate_netPending = 2
    ; The production netconsole gate proves this path emits BUSY and does
    ; not enqueue. This fixture records the same dispatcher verdict.
    gate_busy = gate_busy + 1
  EndIf
  gate_netPending = 0
  gate_pumpDepth = gate_pumpDepth - 1
EndProcedure

XIncludeFile "Anvil/Core/rxbreak.pbi"

Procedure.i GatePromptInputs(operation.i)
 Protected c.i
 If operation=#APS_CLAIM_LOCAL : NetConsoleClaimLocal() : EndIf
 If operation=#APS_NET_INPUT : ProcedureReturn NetConsoleGetc() : EndIf
 If operation=#APS_KEYBOARD
  If gate_queuedInput<>0
   gate_queuedInput=0 : GateEvent(#AIE_TEXT,122) : ProcedureReturn #APS_INPUT_QUEUED
  EndIf
  c=gate_keyboardByte : gate_keyboardByte=0 : ProcedureReturn c
 EndIf
 ProcedureReturn 0
EndProcedure
Procedure.i GatePromptPump(operation.i)
 NetConsolePump() : ProcedureReturn 0
EndProcedure
Procedure.i GateEvent(kind.i,code.i)
 Dim ev.q[4]
 InputEventInit(@ev[0],kind,#AIS_PHYSICAL,code,0)
 ProcedureReturn InputEventsPush(@ev[0])
EndProcedure

Procedure GateResetSources()
  gate_uartReady = 0
  gate_netPending = 0
  gate_netHave = 0
  gate_busy = 0
  gate_pumpCalls = 0
  gate_pumpDepth = 0
  gate_pumpMax = 0
  gate_pumpInMsg = 0
EndProcedure

Procedure.i Main()
  Dim ev.q[4]
  Define n.i
  If AnvilPromptInputsBind(@GatePromptInputs)<>1 Or AnvilPromptPumpBind(@GatePromptPump)<>1 : ProcedureReturn 32 : EndIf
  InputFocusSet(#AIF_COMMAND_LINE)
  GateResetSources()
  gToTicks = 0
  If RxTimeoutTicks() <> 2000 : ProcedureReturn 20 : EndIf
  If RxTimeoutTicks() <> 2000 : ProcedureReturn 21 : EndIf
  gToTicks = 1250
  If RxTimeoutTicks() <> 1250 : ProcedureReturn 22 : EndIf
  gToTicks = 0
  If RxTimeoutTicks() <> 2000 : ProcedureReturn 23 : EndIf
  OutBreakArm()
  If OutBreak() <> 0 : ProcedureReturn 1 : EndIf

  ; Ordinary UART characters retain the original any-byte cancellation
  ; rule and explicitly acquire local ownership.
  gate_uartByte = 120
  gate_uartReady = 1
  If OutBreak() <> 1 : ProcedureReturn 2 : EndIf
  If gate_localClaims <> 1 Or gate_uartReady <> 0 : ProcedureReturn 3 : EndIf
  If OutBreak() <> 1 Or gate_localClaims <> 1 : ProcedureReturn 4 : EndIf

  ; Ctrl-C-only mode still consumes an ordinary local character without
  ; aborting, then aborts on byte 3.
  OutBreakArm()
  gate_uartByte = 65
  gate_uartReady = 1
  If OutBreakCtrlC() <> 0 Or OutBroke() <> 0 : ProcedureReturn 5 : EndIf
  If gate_localClaims <> 2 : ProcedureReturn 6 : EndIf
  gate_uartByte = 3
  gate_uartReady = 1
  If OutBreakCtrlC() <> 1 Or OutBroke() = 0 : ProcedureReturn 7 : EndIf

  ; An admitted same-session network byte follows the ordinary any-byte
  ; rule; Ctrl-C follows the restricted rule. Neither claims local.
  OutBreakArm()
  GateResetSources()
  gate_netByte = 113
  gate_netPending = 1
  If OutBreak() <> 1 : ProcedureReturn 8 : EndIf
  If gate_localClaims <> 3 Or gate_pumpCalls <> 1 : ProcedureReturn 9 : EndIf
  ; The pump ran inside a message bracket, and the bracket was closed.
  If gate_pumpInMsg <> 1 : ProcedureReturn 18 : EndIf
  If gate_msgDepth <> 0 : ProcedureReturn 19 : EndIf
  OutBreakArm()
  GateResetSources()
  gate_netByte = 3
  gate_netPending = 1
  If OutBreakCtrlC() <> 1 : ProcedureReturn 10 : EndIf
  OutBreakArm()
  GateResetSources()
  gate_netByte = 90
  gate_netPending = 1
  If OutBreakCtrlC() <> 0 Or OutBroke() <> 0 : ProcedureReturn 11 : EndIf

  ; Another peer is rejected by the session dispatcher, receives BUSY,
  ; and leaves no cancellation byte for rxbreak.
  OutBreakArm()
  GateResetSources()
  gate_netPending = 2
  If OutBreak() <> 0 : ProcedureReturn 12 : EndIf
  If gate_busy <> 1 Or gate_netHave <> 0 : ProcedureReturn 13 : EndIf

  ; A callback that asks OutBreak while the network pump is active cannot
  ; recursively drive that pump. With no admitted byte it returns normally.
  OutBreakArm()
  GateResetSources()
  gBreakNetPump = 1
  If OutBreak() <> 0 : ProcedureReturn 14 : EndIf
  If gate_pumpCalls <> 0 Or gate_pumpDepth <> 0 : ProcedureReturn 15 : EndIf

  ; Re-entry may consume an owner byte already admitted before the callback,
  ; but still must not recurse into transport polling.
  OutBreakArm()
  gate_netByte = 3
  gate_netHave = 1
  If OutBreakCtrlC() <> 1 : ProcedureReturn 16 : EndIf
  If gate_pumpCalls <> 0 Or gate_netHave <> 0 : ProcedureReturn 17 : EndIf
  gBreakNetPump = 0
  GateResetSources()
  If GateEvent(#AIE_TEXT,100)<>0 Or InputEventsQueued()<>1 : ProcedureReturn 24 : EndIf
  If OutBreakByte()<>100 Or gate_localClaims<>4 : ProcedureReturn 24 : EndIf
  GateEvent(#AIE_KEY_DOWN,#AIK_ENTER)
  If OutBreakByte()<>0 Or gate_localClaims<>5 : ProcedureReturn 25 : EndIf
  GateEvent(#AIE_KEY_DOWN,#AIK_CANCEL_COMMAND)
  If OutBreakByte()<>3 Or gate_localClaims<>6 : ProcedureReturn 26 : EndIf
  GateEvent(#AIE_KEY_UP,#AIK_ENTER)
  If OutBreakByte()<>-1 Or gate_localClaims<>6 : ProcedureReturn 27 : EndIf
  InputFocusSet(#AIF_PAYLOAD) : GateEvent(#AIE_TEXT,97)
  gate_keyboardByte=3
  If OutBreakByte()<>-1 Or InputEventsQueued()<>2 Or gate_keyboardByte<>3 : ProcedureReturn 28 : EndIf
  InputEventsPop(@ev[0])
  If InputEventsPop(@ev[0])<>1 Or PeekL(@ev[0]+#AIE_EV_CODE)<>97 : ProcedureReturn 29 : EndIf
  InputFocusSet(#AIF_COMMAND_LINE)
  If OutBreakByte()<>3 Or gate_localClaims<>7 : ProcedureReturn 30 : EndIf
  ; A full release-only queue is bounded and cannot abort a command.
  For n=1 To #AIE_QMAX : InputEventsPop(@ev[0]) : Next
  For n=1 To #AIE_QMAX : GateEvent(#AIE_KEY_UP,#AIK_ENTER) : Next
  If OutBreakByte()<>-1 Or InputEventsQueued()<>0 : ProcedureReturn 31 : EndIf
  gate_queuedInput=1
  If OutBreakByte()<>122 Or InputEventsQueued()<>0 Or gate_localClaims<>8 : ProcedureReturn 33 : EndIf
  InputEventInit(@ev[0],#AIE_TEXT,#AIS_NETWORK,121,0) : InputEventsPush(@ev[0])
  If OutBreakByte()<>121 Or gate_localClaims<>8 : ProcedureReturn 34 : EndIf
  ProcedureReturn 0
EndProcedure
