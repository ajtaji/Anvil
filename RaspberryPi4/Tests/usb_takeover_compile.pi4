; Compile-only linkage fixture. Never execute on the board.
; Handover order checked against xHCI 1.2b sections 4.2 and 4.21.2:
; https://cdrdv2-public.intel.com/625472/625472_xHCI_Rev1_2b.pdf
XIncludeFile "RaspberryPi4/Lib/timer.pi4"
XIncludeFile "RaspberryPi4/Lib/mailbox.pi4"
XIncludeFile "RaspberryPi4/Lib/pcie.pi4"
XIncludeFile "RaspberryPi4/Lib/xhci.pi4"
Procedure.i Main()
  If PcieInit() = 0
    ProcedureReturn 1
  EndIf
  If XhciQuiesceAdopted() = 0
    ProcedureReturn 2
  EndIf
  If PcieEnumerate() = 0
    ProcedureReturn 3
  EndIf
  ProcedureReturn XhciInit()
EndProcedure
