; Returning CPU-side coordinate-cache and transactional descriptor probe.
; No GPU initialization, MMU change, command submission, or framebuffer write.
; The fixture seeds descriptor state in payload-owned RAM, then exercises
; public rebind/reset APIs. This is not a rendering qualification.
EnableFloatingPoint
XIncludeFile "RaspberryPi4/Lib/uart.pi4"
XIncludeFile "RaspberryPi4/Lib/timer.pi4"
XIncludeFile "RaspberryPi4/Lib/safety.pi4"
XIncludeFile "RaspberryPi4/Lib/mailbox.pi4"
#DSP_DMA_LINKED = 0
XIncludeFile "RaspberryPi4/Lib/display.pi4"
XIncludeFile "RaspberryPi4/Lib/v3dqpu.pi4"
XIncludeFile "RaspberryPi4/Lib/v3d.pi4"
XIncludeFile "RaspberryPi4/Lib/neon.pi4"

#CR_X = $06100000
#CR_Y = $06200000
#CR_OUT = $E1C00000
#CR_FB = $03000000
#CR_TARGET = $03800000
#CR_RECORD_BYTES = 65536
#CR_RECORD_COUNT = 10

Procedure CrRecord(slot.i, rc.i)
  Define out.i, n.i, hx.i, hy.i, at.i
  out = #CR_OUT + slot * #CR_RECORD_BYTES
  hx = 2166136261 : hy = 2166136261
  at = out + 128
  For n = 0 To neon_coordActiveW * 3 - 1
    PokeN(at, PeekN(neon_xcTab + n * 4)) : at = at + 4
    hx = (hx * 33 + (PeekN(neon_xcTab + n * 4) & $FFFFFFFF)) & $FFFFFFFF
  Next
  For n = 0 To neon_coordActiveH * 3 - 1
    PokeN(at, PeekN(neon_ycTab + n * 4)) : at = at + 4
    hy = (hy * 33 + (PeekN(neon_ycTab + n * 4) & $FFFFFFFF)) & $FFFFFFFF
  Next
  PokeN(out + 0, rc)
  PokeN(out + 4, neon_coordActiveW) : PokeN(out + 8, neon_coordActiveH)
  PokeN(out + 12, neon_coordSpareW) : PokeN(out + 16, neon_coordSpareH)
  PokeN(out + 20, neon_coordBuildCount) : PokeN(out + 24, neon_coordReuseCount)
  PokeN(out + 28, hx) : PokeN(out + 32, hy)
  PokeN(out + 36, neon_physW) : PokeN(out + 40, neon_physH)
  PokeN(out + 44, neon_w) : PokeN(out + 48, neon_h)
  PokeN(out + 52, neon_rot) : PokeN(out + 56, gNeonReady)
  PokeN(out + 60, v3d_jobH) : PokeN(out + 64, v3d_jobW)
  PokeN(out + 68, neon_fb) : PokeN(out + 72, neon_pitch)
  PokeN(out + 76, neon_fbBytes) : PokeN(out + 80, v3d_rtAddr)
  PokeN(out + 84, v3d_rtStride) : PokeN(out + 88, v3d_rtBytes)
  PokeN(out + 92, v3d_haveGeom) : PokeN(out + 96, v3d_haveRt)
  PokeN(out + 100, v3d_havePool)
  PokeN(out + 104, PeekN(#CR_X - 4))
  PokeN(out + 108, PeekN(#CR_X + 4097 * 12))
  PokeN(out + 112, PeekN(#CR_Y - 4))
  PokeN(out + 116, PeekN(#CR_Y + 4097 * 12))
  PokeN(out + 120, $43525247) : PokeN(out + 124, slot)
EndProcedure

Procedure.i Main(services.i)
  Define rc.i, n.i
  For n = 0 To #CR_RECORD_BYTES * #CR_RECORD_COUNT - 4 Step 4
    PokeN(#CR_OUT + n, 0)
  Next
  PokeN(#CR_X - 4, $13579BDF) : PokeN(#CR_X + 4097 * 12, $2468ACE0)
  PokeN(#CR_Y - 4, $89ABCDEF) : PokeN(#CR_Y + 4097 * 12, $10203040)
  NeonHardwareCoordinateReset()
  neon_coordBuildCount = 0 : neon_coordReuseCount = 0
  neon_xcTab = #CR_X : neon_ycTab = #CR_Y
  neon_capPhysW = 4097 : neon_capPhysH = 4097
  neon_fb = #CR_FB : neon_w = 800 : neon_h = 1280
  neon_physW = 800 : neon_physH = 1280
  neon_pitch = 3200 : neon_fbBytes = 4096000
  neon_outFmt = #V3D_OFMT_RGBA8 : neon_rot = 0
  neon_cx = 400 : neon_cy = 640
  neon_mapBase = #CR_FB : neon_mapBytes = $01000000
  neon_talloc = $05000000 : neon_tallocBytes = $00200000
  neon_tstate = $05200000 : neon_tstateBytes = $00200000
  neon_overflow = 0 : neon_overflowBytes = 0
  rc = V3dRenderBegin(800, 1280, #V3D_OFMT_RGBA8)
  If rc <> #V3D_OK : ProcedureReturn 1 : EndIf
  rc = V3dRenderTarget(#CR_FB, 4096000, #V3D_MEMFMT_RASTER, 3200, 0)
  If rc <> #V3D_OK : ProcedureReturn 2 : EndIf
  rc = V3dRenderPool(neon_talloc, neon_tallocBytes, neon_tstate, neon_tstateBytes)
  If rc <> #V3D_OK : ProcedureReturn 3 : EndIf
  gNeonReady = 1
  rc = NeonRebindSurface(#CR_FB, 800, 1280, 3200, 4096000, #V3D_OFMT_RGBA8, 0)
  CrRecord(0, rc)

  rc = NeonRebindSurface(#CR_TARGET, 800, 800, 3200, 2560000, #V3D_OFMT_RGBA8, 0)
  CrRecord(1, rc)
  rc = NeonRebindSurface(#CR_FB, 800, 1280, 3200, 4096000, #V3D_OFMT_RGBA8, 0)
  CrRecord(2, rc)
  rc = NeonRebindSurface(#CR_TARGET, 800, 800, 3200, 2560000, #V3D_OFMT_RGBA8, 0)
  CrRecord(3, rc)

  ; Preflight rejects an unmapped surface before touching V3D or tables.
  rc = NeonRebindSurface($70000000, 800, 1280, 3200, 4096000, #V3D_OFMT_RGBA8, 0)
  CrRecord(4, rc)
  ; The stride exceeds V3dRenderTarget's 20-bit limit. Preflight passes,
  ; then the setter refuses and the original geometry must be restored.
  ; Eight rows keep this rejected 1 MiB stride within a real 8 MiB
  ; payload span; no fictitious 1.25 GiB mapping crosses kernel memory.
  rc = NeonRebindSurface(#CR_TARGET, 800, 8, $100000, $800000, #V3D_OFMT_RGBA8, 0)
  CrRecord(5, rc)

  ; Logical rotation changes; the physical table key is still 800x1280.
  rc = NeonRebindSurface(#CR_FB, 1280, 800, 3200, 4096000, #V3D_OFMT_RGBA8, 90)
  CrRecord(6, rc)
  ; Above the bounded spare size, build exact bits without caching the
  ; oversized active pair. The previous 800x1280 pair can still be restored.
  rc = NeonRebindSurface(#CR_TARGET, 4097, 8, 16388, 131104, #V3D_OFMT_RGBA8, 0)
  CrRecord(7, rc)
  rc = NeonRebindSurface(#CR_FB, 800, 1280, 3200, 4096000, #V3D_OFMT_RGBA8, 0)
  CrRecord(8, rc)
  rc = NeonArena($05000000, $00400000)
  CrRecord(9, rc)
  ProcedureReturn 0
EndProcedure
