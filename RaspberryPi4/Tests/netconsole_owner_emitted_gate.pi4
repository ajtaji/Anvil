; Executable emitted-code gate for network-console session ownership.
; Real net/netif/netconsole code receives byte-valid UDP frames from two
; synthetic interfaces. Main returns the first failing assertion.

#HW_LINK_NONE  = 0
#HW_LINK_WIRED = 1
#HW_LINK_WIFI  = 2
#HW_LINK_UART  = 3
#HW_LINK_USB   = 4
#HW_LINK_FILE  = 5
#NETCON_PORT = 5555
#LINK_RX_BUDGET = 64

Global gate_ms.i
Global Dim gate_ready.a[6]
Global Dim gate_mac.a[36]
Global Dim gate_tx.a[1600]
Global gate_txLen.i
Global gate_txKind.i
Global gate_pin.i
Global gate_wifiConsoleOwns.i
Global gate_wifiConsoleEdges.i

Procedure.i millis()
  ProcedureReturn gate_ms
EndProcedure
Procedure.i Micros()
  ProcedureReturn gate_ms * 1000
EndProcedure
Procedure delay(ms.i)
  gate_ms = gate_ms + ms
EndProcedure
Procedure delayMicroseconds(us.i)
EndProcedure

Procedure.i LinkPin()
  ProcedureReturn gate_pin
EndProcedure

Procedure.i HwLinkHas(kind.i)
  If kind = #HW_LINK_WIRED Or kind = #HW_LINK_WIFI
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure
Procedure.i HwLinkReady(kind.i)
  ProcedureReturn gate_ready[kind] & $FF
EndProcedure
Procedure.i HwLinkMacPtr(kind.i)
  ProcedureReturn @gate_mac[kind * 6]
EndProcedure
Procedure.i HwLinkTxMax(kind.i)
  If HwLinkHas(kind) <> 0 : ProcedureReturn 1514 : EndIf
  ProcedureReturn 0
EndProcedure
Procedure.i HwLinkName(kind.i)
  If kind = #HW_LINK_WIRED : ProcedureReturn "wired" : EndIf
  If kind = #HW_LINK_WIFI : ProcedureReturn "wifi" : EndIf
  ProcedureReturn "none"
EndProcedure
Procedure.i HwLinkSend(kind.i, *buf, n.i, ms.i)
  Define i.i
  If *buf = 0 Or n < 1 Or n > 1600 Or gate_ready[kind] = 0
    ProcedureReturn 0
  EndIf
  gate_txKind = kind
  gate_txLen = n
  For i = 0 To n - 1
    gate_tx[i] = PeekA(*buf + i) & $FF
  Next
  ProcedureReturn 1
EndProcedure
Procedure.i HwLinkRecv(kind.i, *buf, max.i, ms.i)
  ProcedureReturn 0
EndProcedure
Procedure.i HwLinkRxPtr(kind.i)
  ProcedureReturn 0
EndProcedure
Procedure.i HwLinkOfferRaw(kind.i, *frame, n.i)
  ProcedureReturn 0
EndProcedure
Procedure HwLinkNoteRx(kind.i, rc.i)
EndProcedure
Procedure HwLinkConsoleArmed(kind.i, on.i)
  If kind = #HW_LINK_WIFI
    gate_wifiConsoleEdges = gate_wifiConsoleEdges + 1
    If on <> 0
      gate_wifiConsoleOwns = 1
    Else
      gate_wifiConsoleOwns = 0
    EndIf
  EndIf
EndProcedure

; netfmt diagnostics name drivers not present in this gate.
Procedure.i GenetErrorText() : ProcedureReturn "" : EndProcedure
Procedure.i TftpErrorText() : ProcedureReturn "" : EndProcedure

XIncludeFile "RaspberryPi4/Lib/uart.pi4"
XIncludeFile "Anvil/Core/format.pbi"
XIncludeFile "Anvil/Network/net.pbi"
XIncludeFile "Anvil/Core/netfmt.pbi"
XIncludeFile "Anvil/Core/netif.pbi"
XIncludeFile "Anvil/Network/dhcp.pbi"
XIncludeFile "Anvil/Core/dhcpd.pbi"

Procedure NetAddressBound(kind.i, ip.i, mask.i, gw.i, src.i)
  NetIfSet(kind, ip, mask, gw, src)
EndProcedure
Procedure NetAddressLost(kind.i)
  NetIfClear(kind)
EndProcedure

; The ownership gate injects UDP only; TCP remains a distinct dispatcher
; owner and is represented by its two no-op service seams here.
Procedure TcpInput()
EndProcedure
Procedure TcpTick()
EndProcedure
Procedure.i NtpServiceInput(kind.i)
  ProcedureReturn 0
EndProcedure

; The line editor, as the two facts the console asks of it (forum 888): how
; much is typed on the line, and throw it away. Scripted here; the real
; editor's discard echo is graded by the console messages gate's editor.
Global gate_lineLen.i
Global gate_discards.i
Procedure.i TextEditLength()
  ProcedureReturn gate_lineLen
EndProcedure
Procedure TextEditDiscard()
  gate_discards = gate_discards + 1
  gate_lineLen = 0
EndProcedure

XIncludeFile "Anvil/Core/netconsole.pbi"

Global Dim gate_frame.a[256]

Procedure GatePut16(*p, v.i)
  PokeA(*p, (v >> 8) & $FF)
  PokeA(*p + 1, v & $FF)
EndProcedure
Procedure GatePut32(*p, v.i)
  PokeA(*p, (v >> 24) & $FF)
  PokeA(*p + 1, (v >> 16) & $FF)
  PokeA(*p + 2, (v >> 8) & $FF)
  PokeA(*p + 3, v & $FF)
EndProcedure
Procedure.i GateGet16(*p)
  ProcedureReturn ((PeekA(*p) & $FF) << 8) | (PeekA(*p + 1) & $FF)
EndProcedure
Procedure.i GateGet32(*p)
  ProcedureReturn ((PeekA(*p) & $FF) << 24) | ((PeekA(*p + 1) & $FF) << 16) | ((PeekA(*p + 2) & $FF) << 8) | (PeekA(*p + 3) & $FF)
EndProcedure
Procedure.i GateSum(*p, n.i)
  Define i.i
  Define sum.i
  sum = 0
  i = 0
  While i < n
    sum = sum + ((PeekA(*p + i) & $FF) << 8) + (PeekA(*p + i + 1) & $FF)
    i = i + 2
  Wend
  While (sum >> 16) <> 0
    sum = (sum & $FFFF) + (sum >> 16)
  Wend
  ProcedureReturn ($FFFF - sum) & $FFFF
EndProcedure

; Build and parse one UDP datagram. IPv4 permits checksum zero for UDP;
; the independently computed IPv4 header checksum is still mandatory.
Procedure.i GateFeed(kind.i, srcIp.i, dstIp.i, srcPort.i, macSeed.i, *payload, plen.i)
  Define i.i
  Define n.i
  Define rc.i
  For i = 0 To 255 : gate_frame[i] = 0 : Next
  For i = 0 To 5
    gate_frame[i] = gate_mac[kind * 6 + i]
    gate_frame[6 + i] = (macSeed + i) & $FF
  Next
  GatePut16(@gate_frame[12], $0800)
  gate_frame[14] = $45
  GatePut16(@gate_frame[16], 20 + 8 + plen)
  GatePut16(@gate_frame[18], $2200 + kind)
  gate_frame[22] = 64
  gate_frame[23] = 17
  GatePut32(@gate_frame[26], srcIp)
  GatePut32(@gate_frame[30], dstIp)
  GatePut16(@gate_frame[24], GateSum(@gate_frame[14], 20))
  GatePut16(@gate_frame[34], srcPort)
  GatePut16(@gate_frame[36], #NETCON_PORT)
  GatePut16(@gate_frame[38], 8 + plen)
  GatePut16(@gate_frame[40], 0)
  For i = 0 To plen - 1
    gate_frame[42 + i] = PeekA(*payload + i) & $FF
  Next
  n = 42 + plen
  If n < 60 : n = 60 : EndIf
  rc = NetInput(kind, @gate_frame[0], n)
  If rc <> #NET_IN_UDP
    ProcedureReturn -1
  EndIf
  ProcedureReturn NetConsoleTakeUdp(@gate_frame[0], kind)
EndProcedure

Procedure GateNoTx()
  gate_txLen = 0
  gate_txKind = #HW_LINK_NONE
EndProcedure

Procedure.i GateBusyTo(kind.i, ip.i, port.i)
  If gate_txKind <> kind Or gate_txLen < 48
    ProcedureReturn 0
  EndIf
  If GateGet32(@gate_tx[30]) <> ip Or GateGet16(@gate_tx[36]) <> port
    ProcedureReturn 0
  EndIf
  If gate_tx[42] <> 66 Or gate_tx[43] <> 85 Or gate_tx[44] <> 83 Or gate_tx[45] <> 89
    ProcedureReturn 0
  EndIf
  ProcedureReturn 1
EndProcedure

; Byte-valid server reply for the common client's current transaction.
; This uses the production DHCP server serializer only as a packet oracle;
; the production client parser, event handoff and worker consume the bytes.
Procedure.i GateDhcpReply(kind.i, msg.i, ip.i, xid.i)
  Define i.i
  dhcpd_rqXid = xid
  dhcpd_rqFlags = #DHCP_FLAG_BCAST
  dhcpd_rqCiaddr = 0
  For i = 0 To 5
    dhcpd_rqMac[i] = gate_mac[kind * 6 + i]
  Next
  ProcedureReturn dhcpd_Build(msg, ip)
EndProcedure

Procedure GateOfflineLease(kind.i, ip.i, at.i)
  Define i.i
  dhcpc_state[kind] = #DHCPC_OFFLINE
  For i = 0 To 5
    dhcpc_mac[kind * 6 + i] = gate_mac[kind * 6 + i]
  Next
  dhcpc_ip[kind] = ip
  dhcpc_mask[kind] = $FFFFFF00
  dhcpc_gw[kind] = $C0A80102
  dhcpc_server[kind] = $C0A80102
  dhcpc_lease[kind] = 3600
  dhcpc_t1[kind] = 1800
  dhcpc_t2[kind] = 3150
  dhcpc_leaseLeft[kind] = 3600
  dhcpc_t1Left[kind] = 1800
  dhcpc_t2Left[kind] = 3150
  dhcpc_lastTick[kind] = at
  dhcpc_linkUp[kind] = 0
  netdhcp_auto[kind] = 1
EndProcedure

Procedure.i Main()
  Define i.i
  Define wiredIp.i
  Define wiredAlias.i
  Define wifiIp.i
  Define peer1.i
  Define peer2.i
  Define peer3.i
  Define oldXid.i
  Define delayMs.i
  Define rebootAt.i
  Define wiredBefore.i
  Define wiredAltBefore.i
  Dim p1.a[4]
  Dim p2.a[4]
  Dim ackish.a[4]

  wiredIp = $A9FEAAFA
  wiredAlias = $C0A88901
  wifiIp = $C0A80110
  peer1 = $C0A88902
  peer2 = $C0A88903
  peer3 = $C0A8010F
  p1[0] = 111 : p1[1] = 110 : p1[2] = 101 : p1[3] = 13
  p2[0] = 116 : p2[1] = 119 : p2[2] = 111 : p2[3] = 13
  ackish[0] = $41 : ackish[1] = $43 : ackish[2] = $4B : ackish[3] = 13

  For i = 0 To 5
    gate_mac[#HW_LINK_WIRED * 6 + i] = $20 + i
    gate_mac[#HW_LINK_WIFI * 6 + i] = $40 + i
  Next
  gate_ready[#HW_LINK_WIRED] = 1
  gate_ready[#HW_LINK_WIFI] = 1
  gate_ms = 1000
  NetInit()
  NetIfReset()
  If NetSetMac(#HW_LINK_WIRED, @gate_mac[#HW_LINK_WIRED * 6]) = 0 : ProcedureReturn 1 : EndIf
  If NetSetMac(#HW_LINK_WIFI, @gate_mac[#HW_LINK_WIFI * 6]) = 0 : ProcedureReturn 2 : EndIf
  NetAddressBound(#HW_LINK_WIRED, wiredIp, $FFFF0000, 0, #NET_ADDR_LINKLOCAL)
  NetSetIPv4Alt(#HW_LINK_WIRED, wiredAlias, $FFFFFF00)
  NetAddressBound(#HW_LINK_WIFI, wifiIp, $FFFFFF00, $C0A80102, #NET_ADDR_LEASE)
  NetIfSetLease(#HW_LINK_WIFI, 3600, gate_ms)
  NetUdpListen(#HW_LINK_WIRED, #NETCON_PORT, 1)
  NetUdpListen(#HW_LINK_WIFI, #NETCON_PORT, 1)
  gConOn = 1
  gConKind = #HW_LINK_WIRED
  gConIp = wiredIp

  ; An EMPTY datagram carries no command: it neither takes the idle console
  ; nor is answered BUSY (forum 888 - a keepalive that took it locked out
  ; every other host until a restart).
  GateNoTx()
  GateFeed(#HW_LINK_WIRED, peer2, wiredAlias, 40002, $B0, @p2[0], 0)
  If gConOwner <> #NETCON_OWNER_NONE Or gConPeerOk <> 0 Or gate_txLen <> 0 : ProcedureReturn 52 : EndIf

  ; First datagram acquires the exact five-part network endpoint.
  If GateFeed(#HW_LINK_WIRED, peer1, wiredAlias, 40001, $A0, @p1[0], 4) <> 1 : ProcedureReturn 3 : EndIf
  If gConOwner <> #NETCON_OWNER_NET Or gConPeerKind <> #HW_LINK_WIRED : ProcedureReturn 4 : EndIf
  If gConPeerIp <> peer1 Or gConPeerPort <> 40001 Or gConPeerDstIp <> wiredAlias : ProcedureReturn 5 : EndIf
  If NetConsoleGetc() <> 111 : ProcedureReturn 6 : EndIf
  NetConsoleGetc() : NetConsoleGetc() : NetConsoleGetc()

  ; Same interface, different port: explicit BUSY to the rejected tuple,
  ; no steal and no delayed input.
  GateNoTx()
  If GateFeed(#HW_LINK_WIRED, peer2, wiredAlias, 40002, $B0, @p2[0], 4) <> 1 : ProcedureReturn 7 : EndIf
  If GateBusyTo(#HW_LINK_WIRED, peer2, 40002) = 0 : ProcedureReturn 8 : EndIf
  If gConPeerIp <> peer1 Or gConPeerPort <> 40001 : ProcedureReturn 9 : EndIf
  If NetConsoleGetc() <> -1 : ProcedureReturn 10 : EndIf

  ; A payload that resembles a binary ACK has no special privilege.
  GateNoTx()
  GateFeed(#HW_LINK_WIRED, peer2, wiredAlias, 40002, $B0, @ackish[0], 4)
  If GateBusyTo(#HW_LINK_WIRED, peer2, 40002) = 0 Or NetConsoleGetc() <> -1 : ProcedureReturn 11 : EndIf

  ; Same IP/port but a different MAC is a different endpoint too.
  GateNoTx()
  GateFeed(#HW_LINK_WIRED, peer1, wiredAlias, 40001, $C0, @p2[0], 4)
  If GateBusyTo(#HW_LINK_WIRED, peer1, 40001) = 0 : ProcedureReturn 12 : EndIf
  If gConPeerMac[0] <> $A0 : ProcedureReturn 13 : EndIf

  ; A second interface cannot redirect the session, even with familiar
  ; port values; BUSY leaves through that second interface explicitly.
  GateNoTx()
  GateFeed(#HW_LINK_WIFI, peer3, wifiIp, 40001, $D0, @p2[0], 4)
  If GateBusyTo(#HW_LINK_WIFI, peer3, 40001) = 0 : ProcedureReturn 14 : EndIf
  If gConPeerKind <> #HW_LINK_WIRED Or gConPeerDstIp <> wiredAlias : ProcedureReturn 15 : EndIf

  ; An empty prompt-probe CR from another peer neither steals nor queues.
  GateNoTx()
  GateFeed(#HW_LINK_WIRED, peer2, wiredAlias, 40002, $B0, @p2[3], 1)
  If GateBusyTo(#HW_LINK_WIRED, peer2, 40002) = 0 : ProcedureReturn 16 : EndIf
  If gConPeerIp <> peer1 Or NetConsoleGetc() <> -1 : ProcedureReturn 17 : EndIf

  ; Exact owner traffic continues to reach the interpreter.
  GateNoTx()
  GateFeed(#HW_LINK_WIRED, peer1, wiredAlias, 40001, $A0, @p1[0], 4)
  If gate_txLen <> 0 Or NetConsoleGetc() <> 111 : ProcedureReturn 18 : EndIf

  ; Local input cancels the partial network line safely, warns its former
  ; owner, and becomes explicit owner. Network traffic stays BUSY.
  GateNoTx()
  NetConsoleClaimLocal()
  If gConOwner <> #NETCON_OWNER_LOCAL Or gConPeerOk <> 0 : ProcedureReturn 19 : EndIf
  If GateBusyTo(#HW_LINK_WIRED, peer1, 40001) = 0 : ProcedureReturn 20 : EndIf
  If NetConsoleGetc() <> -1 : ProcedureReturn 21 : EndIf
  GateNoTx()
  GateFeed(#HW_LINK_WIFI, peer3, wifiIp, 40003, $D0, @p2[0], 4)
  If gConOwner <> #NETCON_OWNER_LOCAL Or GateBusyTo(#HW_LINK_WIFI, peer3, 40003) = 0 : ProcedureReturn 22 : EndIf

  ; Prompt completion releases ownership; a different peer can acquire
  ; immediately, without any queued command from its earlier attempts.
  NetConsoleCommandDone()
  If gConOwner <> #NETCON_OWNER_NONE Or gConPeerOk <> 0 : ProcedureReturn 23 : EndIf
  GateNoTx()
  GateFeed(#HW_LINK_WIRED, peer2, wiredAlias, 40002, $B0, @p2[0], 4)
  If gConPeerIp <> peer2 Or gConPeerPort <> 40002 Or gate_txLen <> 0 : ProcedureReturn 24 : EndIf

  ; Losing the exact local address releases that session even while the
  ; interface keeps its primary address and Wi-Fi keeps the console up.
  NetSetIPv4Alt(#HW_LINK_WIRED, 0, 0)
  NetConsoleRearm()
  If gConOwner <> #NETCON_OWNER_NONE Or gConPeerOk <> 0 : ProcedureReturn 25 : EndIf
  GateNoTx()
  GateFeed(#HW_LINK_WIFI, peer3, wifiIp, 40003, $D0, @p2[0], 4)
  If gConOwner <> #NETCON_OWNER_NET Or gConPeerKind <> #HW_LINK_WIFI Or gConPeerIp <> peer3 : ProcedureReturn 26 : EndIf
  NetConsoleCommandDone()
  If gConOwner <> #NETCON_OWNER_NONE : ProcedureReturn 27 : EndIf

  ; ---- AN OWNER THAT STOPS BEING ONE (forum 888) ----------------------
  ; A RUNNING COMMAND KEEPS ITS CONSOLE, however long its host is silent.
  NetConsoleCommandBegin()
  GateNoTx()
  GateFeed(#HW_LINK_WIRED, peer1, wiredIp, 40001, $A0, @p1[0], 4)
  If gConOwner <> #NETCON_OWNER_NET Or gConPeerIp <> peer1 : ProcedureReturn 70 : EndIf
  For i = 1 To 4 : NetConsoleGetc() : Next
  gate_lineLen = 3
  GateNoTx()
  GateFeed(#HW_LINK_WIRED, peer2, wiredIp, 40002, $B0, @p2[0], 4)
  If GateBusyTo(#HW_LINK_WIRED, peer2, 40002) = 0 Or gConPeerIp <> peer1 : ProcedureReturn 53 : EndIf
  gate_ms = gate_ms + 120000
  GateNoTx()
  GateFeed(#HW_LINK_WIRED, peer2, wiredIp, 40002, $B0, @p2[0], 4)
  If GateBusyTo(#HW_LINK_WIRED, peer2, 40002) = 0 Or gConPeerIp <> peer1 : ProcedureReturn 54 : EndIf

  ; AT THE PROMPT, AN OWNER WITH NOTHING IN PROGRESS IS NOT ONE. One byte
  ; takes the idle console and leaves nothing typed; the next host that
  ; sends a line gets the console, unrefused, and nothing is discarded.
  NetConsoleCommandDone()
  gate_lineLen = 0
  gate_discards = 0
  GateFeed(#HW_LINK_WIRED, peer1, wiredIp, 40001, $A0, @p1[3], 1)
  If gConOwner <> #NETCON_OWNER_NET Or gConPeerIp <> peer1 : ProcedureReturn 71 : EndIf
  NetConsoleGetc()
  GateNoTx()
  GateFeed(#HW_LINK_WIRED, peer2, wiredIp, 40002, $B0, @p2[0], 4)
  If gConPeerIp <> peer2 Or gConPeerPort <> 40002 Or gate_txLen <> 0 : ProcedureReturn 55 : EndIf
  If NetConsoleGetc() <> 116 : ProcedureReturn 56 : EndIf
  If gate_discards <> 0 : ProcedureReturn 57 : EndIf
  NetConsoleGetc() : NetConsoleGetc() : NetConsoleGetc()

  ; A HALF-TYPED LINE IS KEPT WHILE ITS HOST IS RECENT, AND DISCARDED WHEN
  ; IT HAS GONE SILENT - never joined to the next host's typing.
  gate_lineLen = 2
  gate_ms = gate_ms + 1000
  GateNoTx()
  GateFeed(#HW_LINK_WIRED, peer1, wiredIp, 40001, $A0, @p1[0], 4)
  If GateBusyTo(#HW_LINK_WIRED, peer1, 40001) = 0 Or gConPeerIp <> peer2 : ProcedureReturn 58 : EndIf
  gate_ms = gate_ms + #NETCON_OWNER_IDLE_MS
  GateNoTx()
  GateFeed(#HW_LINK_WIRED, peer1, wiredIp, 40001, $A0, @p1[0], 4)
  If gConPeerIp <> peer1 Or gate_txLen <> 0 : ProcedureReturn 59 : EndIf
  If gate_discards <> 1 Or gate_lineLen <> 0 : ProcedureReturn 60 : EndIf

  ; BYTES STILL WAITING ARE IN PROGRESS, even with nothing on the line yet.
  GateNoTx()
  GateFeed(#HW_LINK_WIRED, peer2, wiredIp, 40002, $B0, @p2[0], 4)
  If GateBusyTo(#HW_LINK_WIRED, peer2, 40002) = 0 Or gConPeerIp <> peer1 : ProcedureReturn 61 : EndIf
  For i = 1 To 4 : NetConsoleGetc() : Next

  ; AN OWNER'S EMPTY KEEPALIVE COUNTS AS BEING THERE.
  gate_lineLen = 1
  gate_ms = gate_ms + #NETCON_OWNER_IDLE_MS - 10
  GateFeed(#HW_LINK_WIRED, peer1, wiredIp, 40001, $A0, @p1[0], 0)
  gate_ms = gate_ms + 20
  GateNoTx()
  GateFeed(#HW_LINK_WIRED, peer2, wiredIp, 40002, $B0, @p2[0], 4)
  If GateBusyTo(#HW_LINK_WIRED, peer2, 40002) = 0 Or gConPeerIp <> peer1 : ProcedureReturn 62 : EndIf
  gate_lineLen = 0
  NetConsoleCommandDone()
  If gConOwner <> #NETCON_OWNER_NONE : ProcedureReturn 63 : EndIf

  ; Receive ownership follows wildcard-console membership, not the
  ; preferred announcement. With both rows usable, wired is preferred but
  ; the console still consumes Wi-Fi and its independent pump must stand
  ; down. Address loss and reacquisition hand that one queue back and forth.
  NetConsoleRearm()
  NetConsolePump()
  If gConKind <> #HW_LINK_WIRED Or gate_wifiConsoleOwns <> 1 : ProcedureReturn 38 : EndIf
  NetAddressLost(#HW_LINK_WIFI)
  NetConsoleRearm()
  gate_ms = gate_ms + 5
  NetConsolePump()
  If gConOn = 0 Or gate_wifiConsoleOwns <> 0 : ProcedureReturn 39 : EndIf
  NetAddressBound(#HW_LINK_WIFI, wifiIp, $FFFFFF00, $C0A80102, #NET_ADDR_LEASE)
  NetConsoleRearm()
  gate_ms = gate_ms + 5
  NetConsolePump()
  If gate_wifiConsoleOwns <> 1 : ProcedureReturn 40 : EndIf

  ; The common DHCP worker owns one independent transport schedule per
  ; interface. Both initial DISCOVERs are really serialized and handed to
  ; their own synthetic wire in one worker tick.
  NetDhcpCancel(#HW_LINK_WIRED)
  NetDhcpCancel(#HW_LINK_WIFI)
  GateNoTx()
  If NetDhcpStart(#HW_LINK_WIRED, 1) <> 1 : ProcedureReturn 28 : EndIf
  If NetDhcpStart(#HW_LINK_WIFI, 1) <> 1 : ProcedureReturn 29 : EndIf
  If DhcpClientXid(#HW_LINK_WIRED) = DhcpClientXid(#HW_LINK_WIFI) : ProcedureReturn 30 : EndIf
  NetDhcpTick()
  If netdhcp_tx[#HW_LINK_WIRED] <> 1 Or netdhcp_tx[#HW_LINK_WIFI] <> 1 : ProcedureReturn 31 : EndIf
  If netdhcp_attempts[#HW_LINK_WIRED] <> 1 Or netdhcp_attempts[#HW_LINK_WIFI] <> 1 : ProcedureReturn 32 : EndIf
  If gate_txKind <> #HW_LINK_WIFI Or gate_txLen < #DHCP_MIN_LEN : ProcedureReturn 33 : EndIf

  ; A prolonged outage never turns the exponential shift into an
  ; overflow/wrap retry storm; it stays inside the documented 1..64 s
  ; cadence after any number of attempts.
  netdhcp_attempts[#HW_LINK_WIRED] = 100
  delayMs = netdhcp_RetryDelay(#HW_LINK_WIRED, #DHCPC_ACT_DISCOVER)
  If delayMs < 1000 Or delayMs > #NETDHCP_RETRY_MAX_MS : ProcedureReturn 34 : EndIf

  ; Carrier loss while SELECTING abandons the transaction. Automatic mode
  ; waits while down, then begins one fresh transaction on link return;
  ; it does not replay the stale XID/offer state or add an outer retry loop.
  oldXid = DhcpClientXid(#HW_LINK_WIRED)
  gate_ready[#HW_LINK_WIRED] = 0
  NetDhcpLinkDown(#HW_LINK_WIRED)
  If DhcpClientState(#HW_LINK_WIRED) <> #DHCPC_INIT Or netdhcp_pending[#HW_LINK_WIRED] <> #DHCPC_ACT_NONE : ProcedureReturn 35 : EndIf
  NetDhcpTick()
  If DhcpClientState(#HW_LINK_WIRED) <> #DHCPC_INIT : ProcedureReturn 36 : EndIf
  gate_ready[#HW_LINK_WIRED] = 1
  gate_ms = gate_ms + 1
  NetDhcpTick()
  If DhcpClientState(#HW_LINK_WIRED) <> #DHCPC_SELECTING Or DhcpClientXid(#HW_LINK_WIRED) = oldXid : ProcedureReturn 37 : EndIf
  NetDhcpCancel(#HW_LINK_WIRED)
  NetDhcpCancel(#HW_LINK_WIFI)

  ; A server with no record of an INIT-REBOOT client may remain silent.
  ; Verify through a low-32-bit tick wrap: the remembered request remains
  ; active just before the one-minute bound, then is atomically replaced by
  ; a fresh DISCOVER/new XID at the bound. The other interface is untouched.
  NetAddressLost(#HW_LINK_WIFI)
  wiredBefore = NetIPv4(#HW_LINK_WIRED)
  wiredAltBefore = NetIPv4Alt(#HW_LINK_WIRED)
  rebootAt = $FFFFFF00
  GateOfflineLease(#HW_LINK_WIFI, wifiIp, rebootAt)
  gate_ms = rebootAt
  GateNoTx()
  NetDhcpTick()
  oldXid = DhcpClientXid(#HW_LINK_WIFI)
  If DhcpClientState(#HW_LINK_WIFI) <> #DHCPC_REBOOTING Or netdhcp_pending[#HW_LINK_WIFI] <> #DHCPC_ACT_REBOOT : ProcedureReturn 41 : EndIf
  If gate_txKind <> #HW_LINK_WIFI Or netdhcp_attempts[#HW_LINK_WIFI] <> 1 : ProcedureReturn 42 : EndIf
  gate_ms = (rebootAt + #NETDHCP_REBOOT_WINDOW_MS - 1) & $FFFFFFFF
  NetDhcpTick()
  If DhcpClientState(#HW_LINK_WIFI) <> #DHCPC_REBOOTING Or DhcpClientXid(#HW_LINK_WIFI) <> oldXid : ProcedureReturn 43 : EndIf
  gate_ms = (rebootAt + #NETDHCP_REBOOT_WINDOW_MS) & $FFFFFFFF
  GateNoTx()
  NetDhcpTick()
  If DhcpClientState(#HW_LINK_WIFI) <> #DHCPC_SELECTING Or netdhcp_pending[#HW_LINK_WIFI] <> #DHCPC_ACT_DISCOVER : ProcedureReturn 44 : EndIf
  If DhcpClientXid(#HW_LINK_WIFI) = oldXid Or netdhcp_attempts[#HW_LINK_WIFI] <> 1 : ProcedureReturn 45 : EndIf
  If gate_txKind <> #HW_LINK_WIFI Or gate_txLen < 42 + #DHCP_MIN_LEN : ProcedureReturn 46 : EndIf
  If NetIPv4(#HW_LINK_WIRED) <> wiredBefore Or NetIPv4Alt(#HW_LINK_WIRED) <> wiredAltBefore : ProcedureReturn 47 : EndIf

  ; A byte-valid ACK received just before the conservative deadline wins.
  ; The parser records BOUND, and the common worker applies that event rather
  ; than replacing it with DISCOVER merely because the next tick is due.
  NetDhcpCancel(#HW_LINK_WIFI)
  NetAddressLost(#HW_LINK_WIFI)
  rebootAt = 100000
  gate_ms = rebootAt
  GateOfflineLease(#HW_LINK_WIFI, wifiIp, rebootAt)
  NetDhcpTick()
  oldXid = DhcpClientXid(#HW_LINK_WIFI)
  gate_ms = rebootAt + #NETDHCP_REBOOT_WINDOW_MS - 1
  gate_txLen = GateDhcpReply(#HW_LINK_WIFI, #DHCP_ACK, wifiIp, oldXid)
  If DhcpClientInput(#HW_LINK_WIFI, @dhcpd_out[0], gate_txLen, gate_ms) <> #DHCPC_ACT_BOUND : ProcedureReturn 48 : EndIf
  NetDhcpTick()
  If DhcpClientState(#HW_LINK_WIFI) <> #DHCPC_BOUND Or NetIPv4(#HW_LINK_WIFI) <> wifiIp Or netdhcp_pending[#HW_LINK_WIFI] <> #DHCPC_ACT_NONE : ProcedureReturn 49 : EndIf

  ; A valid NAK takes the other protocol-defined path immediately: discard
  ; the remembered address and begin fresh discovery without waiting for the
  ; silence deadline.
  gate_ms = gate_ms + 1
  NetDhcpLinkDown(#HW_LINK_WIFI)
  NetDhcpTick()
  oldXid = DhcpClientXid(#HW_LINK_WIFI)
  gate_txLen = GateDhcpReply(#HW_LINK_WIFI, #DHCP_NAK, 0, oldXid)
  If DhcpClientInput(#HW_LINK_WIFI, @dhcpd_out[0], gate_txLen, gate_ms) <> #DHCPC_ACT_DROP : ProcedureReturn 50 : EndIf
  NetDhcpTick()
  If DhcpClientState(#HW_LINK_WIFI) <> #DHCPC_SELECTING Or DhcpClientXid(#HW_LINK_WIFI) = oldXid Or NetIPv4(#HW_LINK_WIFI) <> 0 : ProcedureReturn 51 : EndIf

  ProcedureReturn 0
EndProcedure
