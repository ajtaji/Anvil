Global gate_reconciles.i : Global gate_joinFails.i : Global gate_heal.i
Global gate_rxArm.i : Global gate_rxDisable.i

Procedure SkipSpace() : EndProcedure : Procedure SkipWord() : gPos = gWordAt + 1 : EndProcedure
Procedure.i ArgWord() : ProcedureReturn gate_word : EndProcedure
Procedure.i ArgRest() : ProcedureReturn gate_rest : EndProcedure
Procedure.i StrLenZ(*s) : ProcedureReturn 8 : EndProcedure
Procedure GatePrint(*s) : EndProcedure : Procedure GatePrintN(*s) : EndProcedure
Procedure PrintDec(n.i) : EndProcedure : Procedure PrintNl() : EndProcedure
Procedure UartWriteStr(*s) : EndProcedure : Procedure UartWrite(c.i) : EndProcedure
Procedure PutHexN(n.i,w.i) : EndProcedure : Procedure.i OutBreak() : ProcedureReturn 0 : EndProcedure
Procedure.i millis() : ProcedureReturn 1 : EndProcedure
Procedure SettingsSayPlainText() : EndProcedure : Procedure SettingsSayWhyNot() : EndProcedure
Procedure.i SettingsWifiSlots() : ProcedureReturn 4 : EndProcedure
Procedure.i SettingsWifiLegacySlot() : ProcedureReturn 5 : EndProcedure
Procedure.i SettingsWifiSlotCount() : ProcedureReturn 1 : EndProcedure
Procedure.i SettingsWifiNetwork() : ProcedureReturn 0 : EndProcedure
Procedure.i SettingsWifiPassword() : ProcedureReturn 0 : EndProcedure
Procedure.i SettingsWifiNetworkKey() : ProcedureReturn "wifi.network" : EndProcedure
Procedure.i SettingsWifiPasswordKey() : ProcedureReturn "wifi.password.plaintext" : EndProcedure
Procedure.i SettingsWifiSlotSsidKey(s.i) : ProcedureReturn "wifi.1.ssid" : EndProcedure
Procedure.i SettingsWifiSlotPasswordKey(s.i) : ProcedureReturn "wifi.1.password.plaintext" : EndProcedure
Procedure.i SettingsWifiSlotSsid(s.i) : ProcedureReturn 0 : EndProcedure
Procedure.i SettingsWifiSlotPassword(s.i) : ProcedureReturn 0 : EndProcedure
Procedure.i SettingsWifiFindSsid(*s) : ProcedureReturn 0 : EndProcedure
Procedure.i SettingsDirty() : ProcedureReturn 0 : EndProcedure
Procedure.i SettingsSetWifiSlotSsid(s.i,*v) : gate_mutations=gate_mutations+1 : ProcedureReturn gate_settingRc : EndProcedure
Procedure.i SettingsSetWifiSlotPassword(s.i,*v) : gate_mutations=gate_mutations+1 : ProcedureReturn gate_settingRc : EndProcedure
Procedure.i SettingsSetWifiNetwork(*v) : gate_mutations=gate_mutations+1 : ProcedureReturn gate_settingRc : EndProcedure
Procedure.i SettingsSetWifiPassword(*v) : gate_mutations=gate_mutations+1 : ProcedureReturn gate_settingRc : EndProcedure
Procedure.i SettingsRemoveWifiSlot(s.i) : gate_mutations=gate_mutations+1 : ProcedureReturn gate_settingRc : EndProcedure
Procedure.i SettingsHas(*k) : gate_hasCalls=gate_hasCalls+1 : If gate_hasCalls=1 : ProcedureReturn gate_hasNet : EndIf : ProcedureReturn gate_hasPw : EndProcedure
Procedure.i SettingsRemove(*k) : gate_mutations=gate_mutations+1 : ProcedureReturn 1 : EndProcedure
Procedure WifiConfigChanged() : gate_hooks=gate_hooks+1 : EndProcedure
Procedure WifiRecoveryCancel() : gate_cancels=gate_cancels+1 : EndProcedure
Procedure WifiRecoveryReconcile(a.i) : gate_reconciles=gate_reconciles+1 : EndProcedure
Procedure WifiRecoveryInitialJoinFailed() : gate_joinFails=gate_joinFails+1 : EndProcedure
Procedure WifiHealSet(on.i) : gate_heal=on+1 : EndProcedure
Procedure.i WifiScanMatch() : ProcedureReturn 0 : EndProcedure
Procedure.i WifiJoinKnown() : ProcedureReturn 0 : EndProcedure
Procedure.i WifiDhcp() : ProcedureReturn 0 : EndProcedure
Procedure NetConsoleRearm() : EndProcedure : Procedure WifiShowSlot(s.i) : EndProcedure
Procedure WifiSayNoSuchSlot(s.i) : EndProcedure : Procedure.i WifiSlotWord(*s) : ProcedureReturn 1 : EndProcedure
Procedure.i WifiLooksSlotted(*s) : ProcedureReturn 0 : EndProcedure
