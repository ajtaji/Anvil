Procedure.i WifiRxReadyArm() : gate_rxArm=gate_rxArm+1 : ProcedureReturn gate_settingRc : EndProcedure
Procedure.i WifiRxReadyDisable() : gate_rxDisable=gate_rxDisable+1 : ProcedureReturn gate_settingRc : EndProcedure
Procedure.i WifiRxReadyActive() : ProcedureReturn 0 : EndProcedure
Procedure.i Cyw43RxIrqRestorePending() : ProcedureReturn 0 : EndProcedure
Procedure WifiRxReadyStatus() : EndProcedure
Procedure.i WifiRejoin(a.i) : ProcedureReturn 0 : EndProcedure : Procedure.i WifiLinkActive() : ProcedureReturn 1 : EndProcedure
Procedure.i WifiRejoinCount() : ProcedureReturn 0 : EndProcedure : Procedure WifiLinkSet(on.i) : EndProcedure
Procedure WifiLinkDrop() : EndProcedure : Procedure.i wifi_EapolFailureName(s.i) : ProcedureReturn "none" : EndProcedure
Procedure.i Cyw43EventName(t.i) : ProcedureReturn "none" : EndProcedure

; @@PRODUCTION_CMD_WIFI@@

Procedure GateReset(cmd.i,word.i,rest.i,rc.i)
  gate_cmd=cmd : gate_word=word : gate_rest=rest : gate_settingRc=rc
  gate_hasNet=0 : gate_hasPw=0 : gate_hasCalls=0 : gate_mutations=0 : gate_hooks=0
  gate_cancels=0 : gate_reconciles=0 : gate_joinFails=0 : gate_heal=0
  gate_rxArm=0 : gate_rxDisable=0
  gWordLen=1 : gWifiKeyed=0 : gWifiHaveIp=0 : gWifiHealPend=0
EndProcedure
Procedure.i GateConfig(cmd.i,word.i,rest.i,rc.i)
  GateReset(cmd,word,rest,rc)
  CmdWifi()
  If gate_mutations <> 1 : ProcedureReturn 20 + gate_mutations : EndIf
  If rc <> 0 And gate_hooks <> 1 : ProcedureReturn 2 : EndIf
  If rc = 0 And gate_hooks <> 0 : ProcedureReturn 3 : EndIf
  ProcedureReturn 0
EndProcedure
Procedure.i Main()
  Define r.i
  r = GateConfig(4,"1","name",1) : If r : ProcedureReturn r : EndIf
  If GateConfig(5,"1","12345678",1) : ProcedureReturn 2 : EndIf
  If GateConfig(6,0,"name",1) : ProcedureReturn 3 : EndIf
  If GateConfig(7,0,"12345678",1) : ProcedureReturn 4 : EndIf
  If GateConfig(8,"1",0,1) : ProcedureReturn 5 : EndIf
  GateReset(8,0,0,1) : gate_hasNet=1 : CmdWifi()
  If gate_mutations <> 1 Or gate_hooks <> 1 : ProcedureReturn 6 : EndIf
  If GateConfig(4,"1","name",0) : ProcedureReturn 7 : EndIf
  If GateConfig(5,"1","12345678",0) : ProcedureReturn 8 : EndIf
  If GateConfig(6,0,"name",0) : ProcedureReturn 9 : EndIf
  If GateConfig(7,0,"12345678",0) : ProcedureReturn 10 : EndIf
  If GateConfig(8,"1",0,0) : ProcedureReturn 11 : EndIf
  GateReset(8,0,0,1) : CmdWifi()
  If gate_mutations <> 0 Or gate_hooks <> 0 : ProcedureReturn 12 : EndIf
  GateReset(1,0,0,1) : CmdWifi()
  If gate_cancels <> 1 Or gate_reconciles <> 1 : ProcedureReturn 13 : EndIf
  GateReset(2,0,0,1) : CmdWifi()
  If gate_cancels <> 1 Or gate_joinFails <> 1 : ProcedureReturn 14 : EndIf
  GateReset(3,"on",0,1) : CmdWifi()
  If gate_heal <> 2 : ProcedureReturn 15 : EndIf
  GateReset(3,"off",0,1) : CmdWifi()
  If gate_heal <> 1 : ProcedureReturn 16 : EndIf
  GateReset(10,0,0,1) : CmdWifi()
  If gate_rxArm <> 1 Or gate_rxDisable <> 0 : ProcedureReturn 17 : EndIf
  GateReset(11,0,0,1) : CmdWifi()
  If gate_rxArm <> 0 Or gate_rxDisable <> 1 : ProcedureReturn 18 : EndIf
  GateReset(9,0,0,1) : CmdWifi()
  If gate_rxArm <> 0 Or gate_rxDisable <> 0 : ProcedureReturn 19 : EndIf
  ProcedureReturn 0
EndProcedure
