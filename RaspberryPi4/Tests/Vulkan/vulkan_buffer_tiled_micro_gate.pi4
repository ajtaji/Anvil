; SPDX-License-Identifier: MIT
; Public one-utile buffer upload through the state-only backend.
XIncludeFile "Anvil/Graphics/Vulkan/vk_api.pbi"
XIncludeFile "Anvil/Graphics/Vulkan/vk_backend_test.pbi"

Procedure.i Main()
  Define ici.VkInstanceCreateInfo, qci.VkDeviceQueueCreateInfo, dci.VkDeviceCreateInfo
  Define pci.VkCommandPoolCreateInfo, cbai.VkCommandBufferAllocateInfo, bi.VkCommandBufferBeginInfo
  Define imgci.VkImageCreateInfo, bufci.VkBufferCreateInfo, req.VkMemoryRequirements
  Define mai.VkMemoryAllocateInfo, bar.VkImageMemoryBarrier, r.VkBufferImageCopy, si.VkSubmitInfo
  Define inst.i, phys.i, dev.i, queue.i, pool.i, cmd.i, img.i, imem.i, buf.i, bmem.i, aliasBuf.i
  Define count.i, priority.l, caps.i, calls.i, op.i

  AnvilVkTestBackendHeap($06200000, $00100000)
  ici\sType = #VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO
  If vkCreateInstance(@ici, 0, @inst) <> #VK_SUCCESS : ProcedureReturn 1 : EndIf
  count = 1
  If vkEnumeratePhysicalDevices(inst, @count, @phys) <> #VK_SUCCESS : ProcedureReturn 2 : EndIf
  qci\sType = #VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO : qci\queueCount = 1 : qci\pQueuePriorities = @priority
  dci\sType = #VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO : dci\queueCreateInfoCount = 1 : dci\pQueueCreateInfos = @qci
  If vkCreateDevice(phys, @dci, 0, @dev) <> #VK_SUCCESS : ProcedureReturn 3 : EndIf
  vkGetDeviceQueue(dev, 0, 0, @queue)
  pci\sType = #VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO : pci\flags = #VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT
  If vkCreateCommandPool(dev, @pci, 0, @pool) <> #VK_SUCCESS : ProcedureReturn 4 : EndIf
  cbai\sType = #VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO
  cbai\commandPool = pool : cbai\level = #VK_COMMAND_BUFFER_LEVEL_PRIMARY : cbai\commandBufferCount = 1
  If vkAllocateCommandBuffers(dev, @cbai, @cmd) <> #VK_SUCCESS : ProcedureReturn 5 : EndIf
  bi\sType = #VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO

  imgci\sType = #VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO : imgci\imageType = #VK_IMAGE_TYPE_2D
  imgci\format = #VK_FORMAT_B8G8R8A8_UNORM
  imgci\extent\width = 16 : imgci\extent\height = 16 : imgci\extent\depth = 1
  imgci\mipLevels = 1 : imgci\arrayLayers = 1 : imgci\samples = #VK_SAMPLE_COUNT_1_BIT
  imgci\tiling = #VK_IMAGE_TILING_OPTIMAL : imgci\usage = #VK_IMAGE_USAGE_TRANSFER_DST_BIT
  imgci\sharingMode = #VK_SHARING_MODE_EXCLUSIVE : imgci\initialLayout = #VK_IMAGE_LAYOUT_UNDEFINED
  If vkCreateImage(dev, @imgci, 0, @img) <> #VK_SUCCESS : ProcedureReturn 6 : EndIf
  vkGetImageMemoryRequirements(dev, img, @req)
  mai\sType = #VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO : mai\allocationSize = req\size : mai\memoryTypeIndex = 0
  If vkAllocateMemory(dev, @mai, 0, @imem) <> #VK_SUCCESS : ProcedureReturn 7 : EndIf
  If vkBindImageMemory(dev, img, imem, 0) <> #VK_SUCCESS : ProcedureReturn 8 : EndIf
  bufci\sType = #VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO : bufci\size = 4096
  bufci\usage = #VK_BUFFER_USAGE_TRANSFER_SRC_BIT : bufci\sharingMode = #VK_SHARING_MODE_EXCLUSIVE
  If vkCreateBuffer(dev, @bufci, 0, @buf) <> #VK_SUCCESS : ProcedureReturn 9 : EndIf
  vkGetBufferMemoryRequirements(dev, buf, @req)
  mai\allocationSize = req\size
  If vkAllocateMemory(dev, @mai, 0, @bmem) <> #VK_SUCCESS : ProcedureReturn 10 : EndIf
  If vkBindBufferMemory(dev, buf, bmem, 0) <> #VK_SUCCESS : ProcedureReturn 11 : EndIf

  bar\sType = #VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER
  bar\oldLayout = #VK_IMAGE_LAYOUT_UNDEFINED : bar\newLayout = #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL
  bar\dstAccessMask = #VK_ACCESS_TRANSFER_WRITE_BIT
  bar\srcQueueFamilyIndex = #VK_QUEUE_FAMILY_IGNORED : bar\dstQueueFamilyIndex = #VK_QUEUE_FAMILY_IGNORED
  bar\image = img : bar\subresourceRange\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT
  bar\subresourceRange\levelCount = 1 : bar\subresourceRange\layerCount = 1
  If vkBeginCommandBuffer(cmd, @bi) <> #VK_SUCCESS : ProcedureReturn 12 : EndIf
  vkCmdPipelineBarrier(cmd, #VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, #VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, 0, 0, 0, 1, @bar)
  If vkEndCommandBuffer(cmd) <> #VK_SUCCESS : ProcedureReturn 13 : EndIf
  si\sType = #VK_STRUCTURE_TYPE_SUBMIT_INFO : si\commandBufferCount = 1 : si\pCommandBuffers = @cmd
  If vkQueueSubmit(queue, 1, @si, 0) <> #VK_SUCCESS Or vkQueueWaitIdle(queue) <> #VK_SUCCESS : ProcedureReturn 14 : EndIf

  r\bufferOffset = 1152 : r\bufferRowLength = 8 : r\bufferImageHeight = 4
  r\imageSubresource\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT : r\imageSubresource\layerCount = 1
  r\imageOffset\x = 5 : r\imageOffset\y = 6
  r\imageExtent\width = 3 : r\imageExtent\height = 2 : r\imageExtent\depth = 1
  caps = avkTbCaps : calls = AnvilVkTestBackendCalls()
  AnvilVkTestBackendCapabilities(caps | #ANVIL_VK_CAP_BUFFER_TO_TILED_RECT_COPY)
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_UNSUPPORTED Or AnvilVkTestBackendCalls() <> calls : ProcedureReturn 15 : EndIf
  AnvilVkTestBackendCapabilities(caps | #ANVIL_VK_CAP_BUFFER_TO_TILED_MICRO_COPY)
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_UNSUPPORTED : ProcedureReturn 16 : EndIf

  AnvilVkTestBackendCapabilities(caps | #ANVIL_VK_CAP_BUFFER_TO_TILED_RECT_COPY | #ANVIL_VK_CAP_BUFFER_TO_TILED_MICRO_COPY)
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #VK_SUCCESS : ProcedureReturn 17 : EndIf
  op = avkCbOpHead[avkCmdSlot(cmd)]
  If avkOpDstOffset[op] <> #ANVIL_VK_BUFFER_TILED_MICRO_TAG Or avkOpImageX[op] <> 5 Or avkOpImageY[op] <> 6 Or avkOpSourcePitch[op] <> 12 Or avkOpBufferPitch[op] <> 32 Or avkOpSourceBytes[op] <> 44 : ProcedureReturn 18 : EndIf
  AnvilVkTestBackendCapabilities(caps | #ANVIL_VK_CAP_BUFFER_TO_TILED_RECT_COPY)
  If vkQueueSubmit(queue, 1, @si, 0) <> #ANVIL_VK_ERR_UNSUPPORTED Or AnvilVkTestBackendCalls() <> calls : ProcedureReturn 19 : EndIf
  AnvilVkTestBackendCapabilities(caps | #ANVIL_VK_CAP_BUFFER_TO_TILED_RECT_COPY | #ANVIL_VK_CAP_BUFFER_TO_TILED_MICRO_COPY)
  If vkQueueSubmit(queue, 1, @si, 0) <> #VK_SUCCESS Or vkQueueWaitIdle(queue) <> #VK_SUCCESS : ProcedureReturn 20 : EndIf
  If AnvilVkTestBackendCalls() <> calls + 1 Or avkTbLinearTiledMicroCopies <> 1 Or avkTbLastLinearRectDestinationX <> 5 Or avkTbLastLinearRectDestinationY <> 6 Or avkTbLastLinearRectWidth <> 3 Or avkTbLastLinearRectHeight <> 2 Or avkTbLastLinearRectSourceBytes <> 44 : ProcedureReturn 21 : EndIf

  calls = AnvilVkTestBackendCalls()
  avkOpImageX[op] = 7
  If vkQueueSubmit(queue, 1, @si, 0) <> #ANVIL_VK_ERR_STATE Or AnvilVkTestBackendCalls() <> calls : ProcedureReturn 22 : EndIf
  r\imageOffset\x = 7 : r\imageExtent\width = 2
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_UNSUPPORTED : ProcedureReturn 23 : EndIf
  r\imageOffset\x = 5 : r\imageOffset\y = 7 : r\imageExtent\width = 3
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_UNSUPPORTED : ProcedureReturn 24 : EndIf

  r\imageOffset\y = 6
  r\bufferOffset = 4096
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_STATE : ProcedureReturn 25 : EndIf
  r\bufferOffset = 1152
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  r\imageOffset\x = 8 : r\imageOffset\y = 8 : r\imageExtent\width = 4 : r\imageExtent\height = 4 : r\bufferOffset = 1280
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_UNSUPPORTED Or AnvilVkTestBackendCalls() <> calls : ProcedureReturn 26 : EndIf

  bufci\size = 256
  If vkCreateBuffer(dev, @bufci, 0, @aliasBuf) <> #VK_SUCCESS : ProcedureReturn 27 : EndIf
  If vkBindBufferMemory(dev, aliasBuf, imem, 0) <> #VK_SUCCESS : ProcedureReturn 28 : EndIf
  r\imageOffset\x = 5 : r\imageOffset\y = 6 : r\imageExtent\width = 3 : r\imageExtent\height = 2 : r\bufferOffset = 64
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, aliasBuf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_ARGS : ProcedureReturn 29 : EndIf
  ProcedureReturn 0
EndProcedure
