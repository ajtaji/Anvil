  Data.b $51, $03, $29, $71, $2C, $5D, $1F   ;  849 MHz
  Data.b $83, $03, $39, $76, $2F, $62, $20   ;  899 MHz
  Data.b $B5, $03, $0A, $7C, $2F, $66, $22   ;  949 MHz
  Data.b $E7, $03, $1A, $82, $31, $6B, $23   ;  999 MHz
  Data.b $19, $04, $2A, $87, $33, $6F, $25   ; 1049 MHz
  Data.b $4B, $04, $3A, $8B, $33, $72, $26   ; 1099 MHz
