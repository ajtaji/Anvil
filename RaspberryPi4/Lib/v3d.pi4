; Live reads, for a diagnostic that wants the state now rather than as
; it was at V3dInit(). Named "Now" so nobody mistakes them for the
; snapshots.
Procedure.i V3dHubIntStsNow()
  ProcedureReturn V3dHubRead(#V3D_HUB_INT_STS)
EndProcedure

Procedure.i V3dCoreIntStsNow()
  ProcedureReturn V3dCoreRead(#V3D_CTL_INT_STS)
EndProcedure

; ERR_STAT names sixteen error conditions in one word (v3d_regs.h:495
; and the bits below it). Zero is the healthy value and anything else
; names its own fault, which is why it is worth a row in a self-test
; from day one: it turns a hang into a sentence.
Procedure.i V3dErrStatNow()
  ProcedureReturn V3dCoreRead(#V3D_ERR_STAT)
EndProcedure


; ======================================================================
; ======================================================================
;  STAGE 1 - MAKING THE BLOCK EXECUTE SOMETHING
;
;  Everything below this line writes V3D registers. Stage 0 above is
;  read-only apart from PM and the two ASB bridges, and it stays that
;  way; the split is kept visible so that a reader chasing a stray
;  write knows which half to look in.
; ======================================================================
; ======================================================================


; ----------------------------------------------------------------------
;  V3dHubWrite / V3dCoreWrite - the 32-bit register writes.
;
;  PokeL, four bytes, for V3dHubRead's reason inverted: a bare Poke is
;  EIGHT bytes on this target and would take the neighbouring register
;  with it. In the TFU block that would be worse than usual - the
;  registers are contiguous four-byte words and ICFG at $408 sits
;  between SU and IIA, so an eight-byte write at $404 would launch a
;  job with half an address in the wrong register.
;
;  NO OFFSET VALIDATION, and dma.pi4:860-864's reason again: no offset
;  reaching these comes from a caller. Every one is a named constant
;  from the tables above.
; ----------------------------------------------------------------------
Procedure V3dHubWrite(off.i, value.i)
  PokeL(#V3D_HUB_BASE + off, value)
EndProcedure

Procedure V3dCoreWrite(off.i, value.i)
  PokeL(#V3D_CORE0_BASE + off, value)
EndProcedure

; ----------------------------------------------------------------------
;  v3d_WaitHubClear - spin until every bit of `mask` is clear in one
;  hub register, or give up.
;
;  Two deadlines, for the reason under TIMEOUTS: the tick deadline is
;  the real one and the spin count is the backstop for a board where
;  CNTFRQ_EL0 reads zero. Returns 1 if the bits cleared, 0 on either
;  deadline. Shaped exactly like v3d_AsbEnable's loop above rather
;  than more cleverly, so a reader who has understood one has
;  understood both.
; ----------------------------------------------------------------------
Procedure.i v3d_WaitHubClear(off.i, mask.i, us.i)
  Protected v.i
  Protected hz.i
  Protected deadline.i
  Protected spins.i

  hz = V3dCounterHz()
  deadline = 0
  If hz > 0
    deadline = V3dTicks() + ((hz / 1000000) * us)
  EndIf
  spins = 0
  Repeat
    v = V3dHubRead(off)
    If (v & mask) = 0
      ProcedureReturn 1
    EndIf
    spins = spins + 1
    If spins > #V3D_SPIN_LIMIT
      ProcedureReturn 0
    EndIf
    ; Two separate Ifs and not one Or, because this dialect wants a
    ; full comparison on both sides of an Or and two Ifs read better
    ; than the correct long form.
    If hz > 0
      If V3dTicks() > deadline
        ProcedureReturn 0
      EndIf
    EndIf
  ForEver
EndProcedure


; ======================================================================
;  V3D-SIDE CACHE MAINTENANCE
;
;  This is the GPU's caches. V3dCacheRange() above is the A72's. Two
;  completely different mechanisms with nothing in common but the word
;  "cache", and confusing them is how a bug gets fixed on the wrong
;  side of the bus.
; ======================================================================

; ----------------------------------------------------------------------
;  V3dInvalidateCaches - v3d_gem.c:229-240, with the two steps that are
;  no-ops on a 4.2 part left out and the reason recorded.
;
;  THE KERNEL DOES NOT CALL THIS FOR A TFU JOB. v3d_bin_job_run
;  (v3d_sched.c:199), v3d_render_job_run (:251) and v3d_csd_job_run
;  (:330) all do; v3d_tfu_job_run (:279-315) does not, and that is the
;  strongest available statement that the TFU sits in the hub and does
;  not read through a per-core cache.
;
;  IT IS STILL WORTH CALLING ONCE, BEFORE THE FIRST JOB, and the
;  caller is expected to. An invalidate can only lose data the GPU has
;  written and not yet flushed, and before the first job the GPU has
;  written nothing - so the cost is four register writes and the
;  benefit is that "the reading above is wrong" stops being a possible
;  explanation for an empty output buffer. That is a good trade
;  exactly once and a bad habit if repeated between jobs, which is why
;  this is public and is not called from V3dTfuSubmit().
;
;  L2TFLSTA AND L2TFLEND ARE SET EVERY TIME rather than once at init.
;  v3d_init_core sets them once (:34-35) because the kernel owns the
;  block for its lifetime. This file does not: something else may have
;  used V3D before us and left a narrow flush range behind, and a
;  flush of the wrong range reports success and flushes nothing.
; ----------------------------------------------------------------------
Procedure V3dInvalidateCaches()
  Protected flm.i
  V3dCoreWrite(#V3D_CTL_L2TFLSTA, 0)
  V3dCoreWrite(#V3D_CTL_L2TFLEND, #V3D_L2TFL_END_ALL)
  ; FLM_FLUSH is zero, so the shift contributes nothing to the word.
  ; It is written out anyway: the field EXISTS, the other two values
  ; it can take are both wrong here - CLEAR discards dirty lines and
  ; CLEAN writes them back without invalidating - and a naked 1 would
  ; leave the next reader to discover that from v3d_regs.h:256-262.
  flm = #V3D_L2TCACTL_FLM_FLUSH << #V3D_L2TCACTL_FLM_SHIFT
  V3dCoreWrite(#V3D_CTL_L2TCACTL, #V3D_L2TCACTL_L2TFLS | flm)
  V3dCoreWrite(#V3D_CTL_SLCACTL, #V3D_SLCACTL_ALL)
  V3dBarrier()
EndProcedure

; ----------------------------------------------------------------------
;  V3dCleanCaches - THE OTHER DIRECTION, and its absence cost a whole
;  bench run.
;
;  MEASURED ON SILICON, 2026-08-27. The first CSD dispatch completed -
;  NUM_COMPLETED went 1 to 2, CTL_INT_STS.CSDDONE was set, MMU_CTL was
;  clean, no fault anywhere - and the output page still held every one
;  of its 1024 poison words. The QPU had run and its TMU writes were
;  sitting in the core's write combiner and L2T cache, which is
;  exactly where a write goes and exactly where the CPU cannot see it.
;
;  V3dInvalidateCaches() does not help and cannot: it uses FLM_FLUSH,
;  which INVALIDATES. Invalidating a cache holding the only copy of
;  the GPU's output would have been worse than doing nothing.
;
;  THIS IS v3d_clean_caches, v3d_gem.c:188-215, in two steps and in
;  this order:
;
;    1. L2TCACTL = TMUWCF (bit 8), then wait for that bit to clear.
;       The TMU has a WRITE COMBINER in front of the L2T and a
;       partially-filled line sits in it indefinitely. The kernel
;       calls the failure "Timeout waiting for TMU write combiner
;       flush" (:200).
;    2. L2TCACTL = L2TFLS | (FLM_CLEAN << 1), then wait for L2TFLS to
;       clear. CLEAN writes dirty lines out and leaves them valid.
;
;  BOTH WAITS ARE REAL WAITS. v3d_gem.c uses wait_for(..., 100), a
;  100 ms bound, on both. V3dInvalidateCaches() does not wait at all
;  and that is defensible there - it runs before a job and the job's
;  own submission is the ordering point - but here the CPU is about to
;  read the result on the very next instruction, so a clean that has
;  not finished is a clean that did not happen.
;
;  THE SIMULATOR AGREES AND IS THE SECOND WITNESS.
;  v3dx_simulator.c:242 calls v3d_flush_caches() immediately after the
;  CSD completion spin, and :165-169 defines that as flush_l1td
;  (the TMUWCF write) followed by flush_l2t (the CLEAN). Two sources,
;  same two steps, same order.
;
;  IT IS CALLED FROM V3dCsdWait() rather than left to the caller, on
;  the rule V3dTfuSubmit() established: maintenance that is structural
;  cannot be forgotten and maintenance that is remembered will be.
;
;  Returns #V3D_OK or #V3D_ERR_CACHE_TIMEOUT.
; ----------------------------------------------------------------------
Global v3d_cleanSpins.i = 0

Procedure.i V3dCleanCaches()
  Protected flm.i
  Protected hz.i
  Protected deadline.i
  Protected spins.i
  Protected ok.i

  hz = V3dCounterHz()
  spins = 0

  ; ---- 1. the TMU write combiner ----------------------------------
  V3dCoreWrite(#V3D_CTL_L2TCACTL, #V3D_L2TCACTL_TMUWCF)
  V3dBarrier()
  deadline = 0
  If hz > 0
    deadline = V3dTicks() + ((hz / 1000) * 100)   ; 100 ms, v3d_gem.c:197
  EndIf
  ok = 0
  Repeat
    If (V3dCoreRead(#V3D_CTL_L2TCACTL) & #V3D_L2TCACTL_TMUWCF) = 0
      ok = 1
      Break
    EndIf
    spins = spins + 1
    If spins > #V3D_SPIN_LIMIT
      Break
    EndIf
    If hz > 0
      If V3dTicks() > deadline
        Break
      EndIf
    EndIf
  ForEver
  If ok = 0
    v3d_cleanSpins = spins
    v3d_err = #V3D_ERR_CACHE_TIMEOUT
    ProcedureReturn #V3D_ERR_CACHE_TIMEOUT
  EndIf

  ; ---- 2. the L2T clean -------------------------------------------
  ; THE RANGE REGISTERS ARE SET AGAIN, for V3dInvalidateCaches()'s
  ; reason: something else may have left a narrow range behind, and a
  ; clean of the wrong range reports success and writes nothing back.
  V3dCoreWrite(#V3D_CTL_L2TFLSTA, 0)
  V3dCoreWrite(#V3D_CTL_L2TFLEND, #V3D_L2TFL_END_ALL)
  flm = #V3D_L2TCACTL_FLM_CLEAN << #V3D_L2TCACTL_FLM_SHIFT
  V3dCoreWrite(#V3D_CTL_L2TCACTL, #V3D_L2TCACTL_L2TFLS | flm)
  V3dBarrier()
  deadline = 0
  If hz > 0
    deadline = V3dTicks() + ((hz / 1000) * 100)   ; 100 ms, v3d_gem.c:207
  EndIf
  ok = 0
  Repeat
    If (V3dCoreRead(#V3D_CTL_L2TCACTL) & #V3D_L2TCACTL_L2TFLS) = 0
      ok = 1
      Break
    EndIf
    spins = spins + 1
    If spins > #V3D_SPIN_LIMIT
      Break
    EndIf
    If hz > 0
      If V3dTicks() > deadline
        Break
      EndIf
    EndIf
  ForEver

  V3dBarrier()
  v3d_cleanSpins = spins
  If ok = 0
    v3d_err = #V3D_ERR_CACHE_TIMEOUT
    ProcedureReturn #V3D_ERR_CACHE_TIMEOUT
  EndIf
  ProcedureReturn #V3D_OK
EndProcedure

Procedure.i V3dCleanSpins()
  ProcedureReturn v3d_cleanSpins
EndProcedure


; ======================================================================
;  STAGE 1a - THE V3D MMU
; ======================================================================

Global v3d_ptBase.i    = 0   ; PHYSICAL address of the page table
Global v3d_ptEntries.i = 0   ; how many 32-bit entries it has
Global v3d_ptBytes.i   = 0
Global v3d_mmuOn.i     = 0   ; 1 once V3dMmuInit() has succeeded
Global v3d_mmuPages.i  = 0   ; pages V3dMmuMap() has made valid
Global v3d_mmuCtlAtInit.i = 0 ; MMU_CTL read back after programming
Global v3d_mmuFlushes.i = 0

; ----------------------------------------------------------------------
;  V3dMmuFlush - v3d_mmu_flush_all (v3d_mmu.c:31-64), transcribed.
;
;  FOUR STEPS AND THE FIRST ONE IS A WAIT. The kernel waits for
;  TLB_CLEARING to be clear BEFORE starting its own clear, and its
;  comment says why: "Make sure that another flush isn't already
;  running when we start this one." Starting a second clear on top of
;  a running one is the failure that wait exists to stop, and dropping
;  it is the obvious-looking simplification.
;
;  THE TLB AND THE MMUC ARE TWO DIFFERENT CACHES and both have to be
;  cleared. MMU_CTL.TLB_CLEAR empties the translation lookaside
;  buffer; MMUC_CONTROL.FLUSH empties the cache of PAGE TABLE ENTRIES
;  the MMU keeps in front of DRAM. A PTE the CPU has just written is
;  invisible to the engine until both have been done.
;
;  READ-MODIFY-WRITE ON MMU_CTL, following the kernel exactly (:44-45).
;  MMU_CTL holds the enable and the whole fault policy as well as the
;  clear bit, so a bare store of TLB_CLEAR would disable the MMU in
;  the act of flushing it.
;
;  Returns #V3D_OK or #V3D_ERR_MMU_FLUSH.
; ----------------------------------------------------------------------
Procedure.i V3dMmuFlush()
  Protected v.i

  If v3d_WaitHubClear(#V3D_MMU_CTL, #V3D_MMU_CTL_TLB_CLEARING, #V3D_MMU_FLUSH_TIMEOUT_US) = 0
    v3d_err = #V3D_ERR_MMU_FLUSH
    ProcedureReturn #V3D_ERR_MMU_FLUSH
  EndIf

  v = V3dHubRead(#V3D_MMU_CTL)
  V3dHubWrite(#V3D_MMU_CTL, v | #V3D_MMU_CTL_TLB_CLEAR)
  V3dHubWrite(#V3D_MMUC_CONTROL, #V3D_MMUC_CONTROL_FLUSH | #V3D_MMUC_CONTROL_ENABLE)
  V3dBarrier()

  If v3d_WaitHubClear(#V3D_MMU_CTL, #V3D_MMU_CTL_TLB_CLEARING, #V3D_MMU_FLUSH_TIMEOUT_US) = 0
    v3d_err = #V3D_ERR_MMU_FLUSH
    ProcedureReturn #V3D_ERR_MMU_FLUSH
  EndIf
  If v3d_WaitHubClear(#V3D_MMUC_CONTROL, #V3D_MMUC_CONTROL_FLUSHING, #V3D_MMU_FLUSH_TIMEOUT_US) = 0
    v3d_err = #V3D_ERR_MMU_FLUSH
    ProcedureReturn #V3D_ERR_MMU_FLUSH
  EndIf

  v3d_mmuFlushes = v3d_mmuFlushes + 1
  ProcedureReturn #V3D_OK
EndProcedure

; ----------------------------------------------------------------------
;  V3dMmuInit - zero a page table, point the MMU at it, turn it on.
;
;  ptBase    physical address of the table. 4 KiB aligned, because
;            MMU_PT_PA_BASE holds the address ALREADY SHIFTED DOWN BY
;            TWELVE (v3d_mmu.c:67) and there is nowhere for the low
;            bits to go.
;  ptBytes   its size. Four bytes per 4 KiB of VIRTUAL address space,
;            so a table of N bytes covers VAs below N * 1024.
;  illegalPa physical page the MMU is told to send accesses to when a
;            PTE is invalid (MMU_ILLEGAL_ADDR, v3d_mmu.c:76-78). A
;            real, otherwise-unused, 4 KiB-aligned page. It is a
;            backstop and not a policy - PT_INVALID_ABORT is set too,
;            so the access is aborted as well as redirected.
;
;  THE TABLE IS ZEROED AND STAYS MOSTLY ZERO. A zero entry has VALID
;  clear, so every page the caller has not explicitly mapped faults.
;  That is deliberate: the alternative, an identity map of everything,
;  turns a wrong address into a silent write into somebody else's
;  DRAM, and the whole reason this file is worth having is that its
;  failures name themselves.
;
;  IT DOES NOT ASK THE HARDWARE HOW WIDE THE VA SPACE IS, and could -
;  MMU_DEBUG_INFO's VA_WIDTH is read in V3dReadIdent() and printed. It
;  is not used as a bound because the table SIZE is the bound that
;  matters: a VA past the end of the table indexes DRAM that is not a
;  page table at all, and that is a much nearer cliff than the
;  architectural VA width.
;
;  Returns #V3D_OK or the error that stopped it.
; ----------------------------------------------------------------------
Procedure.i V3dMmuInit(ptBase.i, ptBytes.i, illegalPa.i)
  Protected i.i
  Protected n.i
  Protected r.i
  Protected ctl.i

  If v3d_ready = 0
    v3d_err = #V3D_ERR_NOINIT
    ProcedureReturn #V3D_ERR_NOINIT
  EndIf
  ; The part's own answer beats our arithmetic. If HUB_IDENT2 says
  ; there is no MMU there is nothing here to program and every write
  ; below lands in a hole.
  If (v3d_ident2 & #V3D_IDENT2_WITH_MMU) = 0
    v3d_err = #V3D_ERR_MMU_ABSENT
    ProcedureReturn #V3D_ERR_MMU_ABSENT
  EndIf

  If ptBase <= 0
    v3d_err = #V3D_ERR_MMU_ALIGN
    ProcedureReturn #V3D_ERR_MMU_ALIGN
  EndIf
  ; MODULO AND NOT A MASK. A mask written as "ptBase & $FFF" is a
  ; 32-bit literal and these addresses are 64-bit; the same trap
  ; V3dCacheRange() records above. They are physical and therefore
  ; positive, so the remainder is exact.
  If (ptBase % #V3D_MMU_PAGE_BYTES) <> 0
    v3d_err = #V3D_ERR_MMU_ALIGN
    ProcedureReturn #V3D_ERR_MMU_ALIGN
  EndIf
  If (illegalPa % #V3D_MMU_PAGE_BYTES) <> 0
    v3d_err = #V3D_ERR_MMU_ALIGN
    ProcedureReturn #V3D_ERR_MMU_ALIGN
  EndIf
  If ptBytes < 4
    v3d_err = #V3D_ERR_MMU_RANGE
    ProcedureReturn #V3D_ERR_MMU_RANGE
  EndIf
  If (ptBytes % 4) <> 0
    v3d_err = #V3D_ERR_MMU_ALIGN
    ProcedureReturn #V3D_ERR_MMU_ALIGN
  EndIf

  n = ptBytes / 4
  i = 0
  While i < n
    PokeL(ptBase + (i * 4), 0)
    i = i + 1
  Wend

  v3d_ptBase    = ptBase
  v3d_ptBytes   = ptBytes
  v3d_ptEntries = n
  v3d_mmuPages  = 0

  ; The engine reads this table out of DRAM as a bus master, so the
  ; A72's view of it has to have reached DRAM first. With the ARM MMU
  ; off this is a handful of cycles on lines that were never cached;
  ; with DRAM cacheable it is the difference between a table and a
  ; hole. See CACHE COHERENCY, case 3.
  V3dCacheRange(ptBase, ptBytes)
  V3dBarrier()

  ; The order is v3d_mmu_set_page_table's (v3d_mmu.c:65-83): base,
  ; control, illegal address, MMUC, flush. Programming the base after
  ; the enable would leave the MMU briefly enabled over whatever
  ; PT_PA_BASE happened to hold.
  V3dHubWrite(#V3D_MMU_PT_PA_BASE, ptBase >> #V3D_MMU_PAGE_SHIFT)

  ; Every bit here is one the kernel sets, and the ABORTs are the
  ; important ones: without them a bad address is silently redirected
  ; and the job completes with wrong data, which is exactly the shape
  ; of failure this project keeps finding. With them the access is
  ; aborted, the sticky status bit is set in this same register, and
  ; MMU_VIO_ADDR names the address.
  ctl = #V3D_MMU_CTL_ENABLE
  ctl = ctl | #V3D_MMU_CTL_PT_INVALID_ENABLE
  ctl = ctl | #V3D_MMU_CTL_PT_INVALID_ABORT
  ctl = ctl | #V3D_MMU_CTL_PT_INVALID_INT
  ctl = ctl | #V3D_MMU_CTL_WRITE_VIOLATION_ABORT
  ctl = ctl | #V3D_MMU_CTL_WRITE_VIOLATION_INT
  ctl = ctl | #V3D_MMU_CTL_CAP_EXCEEDED_ABORT
  ctl = ctl | #V3D_MMU_CTL_CAP_EXCEEDED_INT
  V3dHubWrite(#V3D_MMU_CTL, ctl)

  V3dHubWrite(#V3D_MMU_ILLEGAL_ADDR, (illegalPa >> #V3D_MMU_PAGE_SHIFT) | #V3D_MMU_ILLEGAL_ADDR_ENABLE)
  V3dHubWrite(#V3D_MMUC_CONTROL, #V3D_MMUC_CONTROL_ENABLE)
  V3dBarrier()

  r = V3dMmuFlush()
  If r <> #V3D_OK
    ProcedureReturn r
  EndIf

  ; READ IT BACK, for V3dBringUp()'s reason: a write that did not land
  ; reports nothing at all, and the consequence surfaces later as a
  ; TFU that produces nothing.
  v3d_mmuCtlAtInit = V3dHubRead(#V3D_MMU_CTL)
  If (v3d_mmuCtlAtInit & #V3D_MMU_CTL_ENABLE) = 0
    v3d_err = #V3D_ERR_MMU_OFF
    ProcedureReturn #V3D_ERR_MMU_OFF
  EndIf

  v3d_mmuOn = 1
  ProcedureReturn #V3D_OK
EndProcedure

; ----------------------------------------------------------------------
;  V3dMmuMap - make `bytes` of virtual address space at `va` point at
;  physical `pa`, writeable.
;
;  Whole pages only, both ends. A partial page cannot be expressed:
;  the table has one entry per 4 KiB and there is no offset field in
;  it. Rounding up silently would map memory the caller did not offer,
;  which on a bus master means letting the GPU write it.
;
;  VA PAGE 0 IS REFUSED. v3d_gem.c:276 starts the kernel's allocator
;  at page 1 and never hands out page 0. The reason to copy that is
;  not superstition: a TFU address register that was never written
;  reads as zero, and if page 0 were mapped that would be a valid
;  address pointing at a real buffer instead of a fault.
;
;  IT FLUSHES. A PTE the CPU has written is not visible to the engine
;  until the TLB and the MMUC have been cleared, so mapping without
;  flushing produces a fault at job time that looks like a wrong
;  address. Flushing per call rather than leaving it to the caller
;  costs two writes and two polls and removes a step that can be
;  forgotten; a caller mapping many ranges can still batch by mapping
;  one large range.
;
;  Returns #V3D_OK or the error that stopped it.
; ----------------------------------------------------------------------
Procedure.i V3dMmuMap(va.i, pa.i, bytes.i)
  Protected page.i
  Protected pfn.i
  Protected npages.i
  Protected i.i

  ; THE ARGUMENTS ARE CHECKED BEFORE THE STATE IS, deliberately. A
  ; misaligned VA is the caller's bug whether or not a page table
  ; exists yet, and answering MMU_OFF to it would name the wrong
  ; problem. It also means these five refusals can be tested by
  ; entering this procedure directly, which a64_v3d_check.py does -
  ; a guard that has never been seen to refuse anything is a guard
  ; nobody knows is broken.
  If bytes <= 0
    v3d_err = #V3D_ERR_TFU_ARGS
    ProcedureReturn #V3D_ERR_TFU_ARGS
  EndIf
  If (va % #V3D_MMU_PAGE_BYTES) <> 0
    v3d_err = #V3D_ERR_MMU_ALIGN
    ProcedureReturn #V3D_ERR_MMU_ALIGN
  EndIf
  If (pa % #V3D_MMU_PAGE_BYTES) <> 0
    v3d_err = #V3D_ERR_MMU_ALIGN
    ProcedureReturn #V3D_ERR_MMU_ALIGN
  EndIf
  If (bytes % #V3D_MMU_PAGE_BYTES) <> 0
    v3d_err = #V3D_ERR_MMU_ALIGN
    ProcedureReturn #V3D_ERR_MMU_ALIGN
  EndIf
  If va < #V3D_MMU_PAGE_BYTES
    v3d_err = #V3D_ERR_MMU_RANGE
    ProcedureReturn #V3D_ERR_MMU_RANGE
  EndIf

  ; Only now the state, because only now does it matter.
  If v3d_ptBase = 0
    v3d_err = #V3D_ERR_MMU_OFF
    ProcedureReturn #V3D_ERR_MMU_OFF
  EndIf

  page   = va / #V3D_MMU_PAGE_BYTES
  pfn    = pa / #V3D_MMU_PAGE_BYTES
  npages = bytes / #V3D_MMU_PAGE_BYTES

  If (page + npages) > v3d_ptEntries
    v3d_err = #V3D_ERR_MMU_RANGE
    ProcedureReturn #V3D_ERR_MMU_RANGE
  EndIf
  ; v3d_mmu.c:99's BUG_ON, as a refusal. The physical page number
  ; occupies the low twenty-four bits of the entry and the three flag
  ; bits sit above it; a PFN that overflowed would come back VALID by
  ; accident and point somewhere else entirely.
  If (pfn + npages) > #V3D_PTE_PFN_LIMIT
    v3d_err = #V3D_ERR_MMU_RANGE
    ProcedureReturn #V3D_ERR_MMU_RANGE
  EndIf

  i = 0
  While i < npages
    ; v3d_mmu.c:90 and :96 - page_prot | page_address, one entry per
    ; page, the physical page number advancing with the virtual.
    PokeL(v3d_ptBase + ((page + i) * 4), #V3D_PTE_WRITEABLE | #V3D_PTE_VALID | (pfn + i))
    i = i + 1
  Wend
  v3d_mmuPages = v3d_mmuPages + npages

  V3dCacheRange(v3d_ptBase + (page * 4), npages * 4)
  V3dBarrier()
  ProcedureReturn V3dMmuFlush()
EndProcedure

; ----------------------------------------------------------------------
;  V3dMmuOff - PUT THE V3D MMU BACK THE WAY IT WAS FOUND.
;
;  ADDED 2026-08-28. A payload that turns the MMU on OWNS TURNING IT
;  OFF: the VPU is not asleep while a bare-metal payload runs - it
;  drives the display and answers the property mailbox - and it
;  reaches memory through this same MMU. Leaving a page table it never
;  agreed to, with PT_INVALID_ABORT set, is leaving a loaded gun on
;  shared hardware.
;
;  IT WAS WRITTEN FOR A REASON THAT TURNED OUT TO BE WRONG, and that
;  is recorded rather than quietly dropped. There is a measured
;  failure where the firmware's mailbox dies and stays dead until a
;  reset, and I blamed this. pi4NeonMbx.pi4 then walked the bring-up
;  one rung at a time: on a freshly reset board DisplayInit works
;  before V3dInit and fails after it, with the MMU still untouched two
;  rungs later. V3DINIT DOES IT, NOT THE MMU. This procedure is not
;  that fix and must not be described as one.
;
;  It clears the enable and the three abort bits, disables the illegal
;  address redirect, and drops the table base, in the reverse of the
;  order V3dMmuInit programmed them. It does NOT power the domain down
;  or put the clock back - those the firmware set up before we arrived
;  and it is happy with them.
;
;  Safe to call when the MMU was never enabled: it writes zeroes over
;  zeroes.
; ----------------------------------------------------------------------
Procedure.i V3dMmuOff()
  If v3d_ready = 0
    v3d_err = #V3D_ERR_NOINIT
    ProcedureReturn #V3D_ERR_NOINIT
  EndIf
  If (v3d_ident2 & #V3D_IDENT2_WITH_MMU) = 0
    ProcedureReturn #V3D_OK
  EndIf
  ; The illegal-address redirect first, so that nothing is left
  ; pointing at a page this payload is about to stop owning.
  V3dHubWrite(#V3D_MMU_ILLEGAL_ADDR, 0)
  V3dHubWrite(#V3D_MMU_CTL, 0)
  V3dHubWrite(#V3D_MMU_PT_PA_BASE, 0)
  V3dHubWrite(#V3D_MMUC_CONTROL, 0)
  v3d_ptBase    = 0
  v3d_ptBytes   = 0
  v3d_ptEntries = 0
  v3d_mmuPages  = 0
  V3dBarrier()
  ProcedureReturn #V3D_OK
EndProcedure

; ----------------------------------------------------------------------
;  The MMU's evidence, live. All reads, all safe at any time; a
;  diagnostic prints them after a job that produced nothing and the
;  answer is usually in the first one.
; ----------------------------------------------------------------------
Procedure.i V3dMmuCtlNow()
  ProcedureReturn V3dHubRead(#V3D_MMU_CTL)
EndProcedure

Procedure.i V3dMmuFaultsNow()
  ProcedureReturn V3dHubRead(#V3D_MMU_CTL) & #V3D_MMU_CTL_FAULTS
EndProcedure

Procedure.i V3dMmuVioAddrNow()
  ProcedureReturn V3dHubRead(#V3D_MMU_VIO_ADDR)
EndProcedure

Procedure.i V3dMmuVioIdNow()
  ProcedureReturn V3dHubRead(#V3D_MMU_VIO_ID)
EndProcedure

Procedure.i V3dMmuHitsNow()
  ProcedureReturn V3dHubRead(#V3D_MMU_HIT)
EndProcedure

Procedure.i V3dMmuMissesNow()
  ProcedureReturn V3dHubRead(#V3D_MMU_MISSES)
EndProcedure

Procedure.i V3dMmuOn()
  ProcedureReturn v3d_mmuOn
EndProcedure

Procedure.i V3dMmuPagesMapped()
  ProcedureReturn v3d_mmuPages
EndProcedure

Procedure.i V3dMmuPtBase()
  ProcedureReturn v3d_ptBase
EndProcedure

; The table as the CPU wrote it, for a diagnostic that wants to prove
; the entry it thinks it made is the entry that is there. Reads DRAM,
; not a register.
Procedure.i V3dMmuEntry(va.i)
  If v3d_ptBase = 0
    ProcedureReturn 0
  EndIf
  ProcedureReturn PeekN(v3d_ptBase + ((va / #V3D_MMU_PAGE_BYTES) * 4))
EndProcedure


; ======================================================================
;  HUB INTERRUPT STATUS - MASKED, CLEARED, NEVER ENABLED BY THIS FILE
;
;  Completion is polled on TFU_CS.CVTCT and needs none of this. These
;  four exist because HUB_INT_STS.TFUF - the unit reporting that a
;  conversion FAILED - is worth seeing, and because whether STS shows
;  a masked event on this part is not documented anywhere on this
;  disk. A caller that wants TFUF visible unmasks before the job and
;  re-masks after; a caller that does not still gets a correct answer
;  from the counter.
;
;  THE POLARITY: MSK_SET masks, MSK_CLR unmasks (v3d_irq.c:264-276).
; ======================================================================

Procedure V3dHubIntClear(bits.i)
  V3dHubWrite(#V3D_HUB_INT_CLR, bits)
  V3dBarrier()
EndProcedure

Procedure V3dHubIntUnmask(bits.i)
  V3dHubWrite(#V3D_HUB_INT_MSK_CLR, bits)
  V3dBarrier()
EndProcedure

Procedure V3dHubIntMask(bits.i)
  V3dHubWrite(#V3D_HUB_INT_MSK_SET, bits)
  V3dBarrier()
EndProcedure

Procedure.i V3dHubIntMaskNow()
  ProcedureReturn V3dHubRead(#V3D_HUB_INT_MSK_STS)
EndProcedure


; ======================================================================
;  STAGE 1b - THE TEXTURE FORMATTING UNIT
;
;  THE JOB IS BUILT IN PIECES AND THEN SUBMITTED, which is
;  mailbox.pi4's shape (MailboxBegin / MailboxSetWord / MailboxSend,
;  mailbox.pi4:273-291) and is used here for the same two reasons:
;  every argument is validated by the call that supplies it, so an
;  error names the thing that was wrong; and the composed registers
;  sit in globals where a diagnostic can print exactly what was
;  written without the library having to hand them back.
;
;    V3dTfuBegin(width, height, texType)
;    V3dTfuSourceRaster(addr, strideTexels, bytes)
;    V3dTfuDest(addr, outputFormat, bytes)
;    V3dTfuSubmit()
;    V3dTfuWait(timeoutUs)
;
;  WHAT THIS DOES NOT COVER, DELIBERATELY: YUV input (ICA, IUA and the
;  four COEF registers, all written as zero here), mipmap chains
;  (ICFG.NUMMM and IOA.DIMTW, both zero), UIF output padding
;  (ICFG.OPAD, zero, and only ever non-zero for a UIF destination),
;  and tiled INPUT (ICFG.FORMAT is always RASTER). Every one of those
;  is a field whose position this file knows and whose behaviour it
;  has no way to test, and an untested encoder is worse than an absent
;  one because it reads as available.
; ======================================================================

Global v3d_tfuIcfg.i = 0
Global v3d_tfuIia.i  = 0
Global v3d_tfuIis.i  = 0
Global v3d_tfuIoa.i  = 0
Global v3d_tfuIos.i  = 0
Global v3d_tfuSrcAddr.i  = 0
Global v3d_tfuSrcBytes.i = 0
Global v3d_tfuDstAddr.i  = 0
Global v3d_tfuDstBytes.i = 0
Global v3d_tfuHaveSrc.i  = 0
Global v3d_tfuHaveDst.i  = 0
Global v3d_tfuHaveJob.i  = 0

; The evidence a completed - or a failed - job leaves behind.
Global v3d_tfuCsBefore.i  = 0
Global v3d_tfuCsAfter.i   = 0
Global v3d_tfuCvtBefore.i = -1
Global v3d_tfuCvtAfter.i  = -1
Global v3d_tfuIntSts.i    = 0
Global v3d_tfuMmuCtl.i    = 0
Global v3d_tfuVioAddr.i   = 0
Global v3d_tfuVioId.i     = 0
Global v3d_tfuSpins.i     = 0
Global v3d_tfuJobs.i      = 0

; ----------------------------------------------------------------------
;  The three pure encoders. No side effects, no validation, no
;  hardware: given the fields, return the register word. Kept separate
;  from the setters so a gate, or a reader, can check the arithmetic
;  against Reference/mesa-24.3.4_v3d_tfu.h without running anything.
; ----------------------------------------------------------------------

; ICFG, everything except the IOC bit that V3dTfuSubmit() adds last.
; mesa-24.3.4_v3dx_tfu.c:122-152 and
; mesa-24.3.4_v3dvx_meta_common.c:953-1031 compose the same four
; fields in the same positions.
Procedure.i V3dTfuIcfgWord(inputFormat.i, texType.i, mipmaps.i, outputPad.i)
  Protected v.i
  v = inputFormat << #V3D_TFU_ICFG_FORMAT_SHIFT
  v = v | (texType << #V3D_TFU_ICFG_TTYPE_SHIFT)
  v = v | (mipmaps << #V3D_TFU_ICFG_NUMMM_SHIFT)
  v = v | (outputPad << #V3D_TFU_ICFG_OPAD_SHIFT)
  ProcedureReturn v
EndProcedure

; IOA. THE ADDRESS AND THE OUTPUT TILING SHARE ONE REGISTER, so this
; is a plain OR with no masking: an address with any of bits 5:0 set
; would corrupt the format field, and masking it here would hide that
; instead of stopping it. V3dTfuDest() refuses a misaligned address
; before this is ever reached, which is the right place for the
; refusal because it is the call that has the address.
Procedure.i V3dTfuIoaWord(dstAddr.i, outputFormat.i, skipLevel0.i)
  Protected v.i
  v = dstAddr | (outputFormat << #V3D_TFU_IOA_FORMAT_SHIFT)
  If skipLevel0 <> 0
    v = v | #V3D_TFU_IOA_DIMTW
  EndIf
  ProcedureReturn v
EndProcedure

; IOS. (height << 16) | width, in TEXELS, both witnesses agreeing.
Procedure.i V3dTfuIosWord(width.i, height.i)
  ProcedureReturn (height << #V3D_TFU_IOS_HEIGHT_SHIFT) | width
EndProcedure

; ----------------------------------------------------------------------
;  V3dTfuBegin - start a job description.
;
;  texType is a Texture Data Format code from v3d_packet.xml:1637-1678
;  (#V3D_TEXFMT_RGBA8, #V3D_TEXFMT_R32F). It is what tells the unit
;  the TEXEL SIZE, and the texel size is what fixes the microtile
;  geometry, so it is not cosmetic: a four-byte format lays the output
;  out in 4x4 microtiles and a one-byte format in 8x8 ones.
; ----------------------------------------------------------------------
Procedure.i V3dTfuBegin(width.i, height.i, texType.i)
  v3d_tfuHaveSrc = 0
  v3d_tfuHaveDst = 0
  v3d_tfuHaveJob = 0

  If width < 1
    v3d_err = #V3D_ERR_TFU_ARGS
    ProcedureReturn #V3D_ERR_TFU_ARGS
  EndIf
  If height < 1
    v3d_err = #V3D_ERR_TFU_ARGS
    ProcedureReturn #V3D_ERR_TFU_ARGS
  EndIf
  ; IOS gives each dimension sixteen bits and neither witness masks
  ; before shifting, so a width of 65536 would land silently in the
  ; height field.
  If width > #V3D_TFU_IOS_DIM_MAX
    v3d_err = #V3D_ERR_TFU_ARGS
    ProcedureReturn #V3D_ERR_TFU_ARGS
  EndIf
  If height > #V3D_TFU_IOS_DIM_MAX
    v3d_err = #V3D_ERR_TFU_ARGS
    ProcedureReturn #V3D_ERR_TFU_ARGS
  EndIf
  ; TTYPE sits at bit 9 and the input format field starts at bit 18,
  ; so nine bits at most, and the largest code the packet enum defines
  ; is well under 256. Refusing here keeps a wrong format code out of
  ; the input-format field, where it would change the MEANING of the
  ; job rather than merely being wrong.
  If texType < 0
    v3d_err = #V3D_ERR_TFU_ARGS
    ProcedureReturn #V3D_ERR_TFU_ARGS
  EndIf
  If texType > 255
    v3d_err = #V3D_ERR_TFU_ARGS
    ProcedureReturn #V3D_ERR_TFU_ARGS
  EndIf

  v3d_tfuIos  = V3dTfuIosWord(width, height)
  ; RASTER in, no mipmaps, no UIF output padding. All three are fields
  ; this file deliberately leaves at zero; see the section header.
  v3d_tfuIcfg = V3dTfuIcfgWord(#V3D_TFU_IFMT_RASTER, texType, 0, 0)
  v3d_tfuIia  = 0
  v3d_tfuIis  = 0
  v3d_tfuIoa  = 0
  v3d_tfuSrcAddr  = 0
  v3d_tfuSrcBytes = 0
  v3d_tfuDstAddr  = 0
  v3d_tfuDstBytes = 0
  ProcedureReturn #V3D_OK
EndProcedure

; ----------------------------------------------------------------------
;  V3dTfuSourceRaster - the input image, laid out linearly.
;
;  strideTexels is the row stride IN TEXELS, not bytes.
;  mesa-24.3.4_v3dx_tfu.c:114 and
;  mesa-24.3.4_v3dvx_meta_common.c:1009 both write `iis = stride /
;  cpp` for a raster source. The same field means something completely
;  different for a TILED source - padded_height divided by twice the
;  microtile height (:110-112 and :1006) - which is why this procedure
;  is named for the layout it accepts rather than being V3dTfuSource.
;
;  bytes is the extent of the buffer, for cache maintenance. It is a
;  separate argument rather than computed from width x height x texel
;  size because the library does not know the texel size in bytes - it
;  was handed a FORMAT CODE - and computing it would mean a second
;  table that could disagree with the hardware's.
; ----------------------------------------------------------------------
Procedure.i V3dTfuSourceRaster(addr.i, strideTexels.i, bytes.i)
  If addr <= 0
    v3d_err = #V3D_ERR_TFU_ARGS
    ProcedureReturn #V3D_ERR_TFU_ARGS
  EndIf
  ; A HOUSE REQUIREMENT AND NOT A CITATION. Nothing consulted states
  ; an alignment for TFU_IIA. Sixty-four bytes is what the OUTPUT
  ; register layout forces, it is one microtile, and it is what every
  ; buffer the kernel hands the unit has anyway because a BO is page
  ; aligned. Refusing less is a choice; it is recorded as a choice so
  ; a caller with a reason to relax it knows there is no source to
  ; argue with.
  If (addr % #V3D_TFU_IOA_ADDR_ALIGN) <> 0
    v3d_err = #V3D_ERR_MMU_ALIGN
    ProcedureReturn #V3D_ERR_MMU_ALIGN
  EndIf
  If strideTexels < 1
    v3d_err = #V3D_ERR_TFU_ARGS
    ProcedureReturn #V3D_ERR_TFU_ARGS
  EndIf
  If bytes < 1
    v3d_err = #V3D_ERR_TFU_ARGS
    ProcedureReturn #V3D_ERR_TFU_ARGS
  EndIf

  v3d_tfuIia      = addr
  v3d_tfuIis      = strideTexels
  v3d_tfuSrcAddr  = addr
  v3d_tfuSrcBytes = bytes
  v3d_tfuHaveSrc  = 1
  ProcedureReturn #V3D_OK
EndProcedure

; ----------------------------------------------------------------------
;  V3dTfuDest - the output image and its tiling.
;
;  outputFormat is one of #V3D_TFU_OFMT_*. THERE IS NO RASTER OPTION
;  AND THAT IS THE HARDWARE, not an omission here:
;  mesa-24.3.4_v3dx_tfu.c:59-60 abandons the job when the destination
;  is raster, with the comment "Can't write to raster", and
;  mesa-24.3.4_v3dvx_meta_common.c:1016 asserts the same. The TFU
;  converts INTO the GPU's layouts and never back out.
;
;  The address must be 64-byte aligned because IOA's low six bits are
;  the tiling format and the level-0 skip.
; ----------------------------------------------------------------------
Procedure.i V3dTfuDest(addr.i, outputFormat.i, bytes.i)
  If addr <= 0
    v3d_err = #V3D_ERR_TFU_ARGS
    ProcedureReturn #V3D_ERR_TFU_ARGS
  EndIf
  If (addr % #V3D_TFU_IOA_ADDR_ALIGN) <> 0
    v3d_err = #V3D_ERR_MMU_ALIGN
    ProcedureReturn #V3D_ERR_MMU_ALIGN
  EndIf
  If outputFormat < #V3D_TFU_OFMT_LINEARTILE
    v3d_err = #V3D_ERR_TFU_ARGS
    ProcedureReturn #V3D_ERR_TFU_ARGS
  EndIf
  If outputFormat > #V3D_TFU_OFMT_UIF_XOR
    v3d_err = #V3D_ERR_TFU_ARGS
    ProcedureReturn #V3D_ERR_TFU_ARGS
  EndIf
  If bytes < 1
    v3d_err = #V3D_ERR_TFU_ARGS
    ProcedureReturn #V3D_ERR_TFU_ARGS
  EndIf

  v3d_tfuIoa      = V3dTfuIoaWord(addr, outputFormat, 0)
  v3d_tfuDstAddr  = addr
  v3d_tfuDstBytes = bytes
  v3d_tfuHaveDst  = 1
  ProcedureReturn #V3D_OK
EndProcedure

; ----------------------------------------------------------------------
;  V3dTfuSubmit - eleven register writes, the last of which starts it.
;
;  THE ORDER IS v3d_tfu_job_run's (v3d_sched.c:299-315) AND THE LAST
;  WRITE IS NOT INTERCHANGEABLE. Its own comment, :313: "ICFG kicks
;  off the job." Everything else must already be in place when that
;  store retires. mesa/v3dx_simulator.c:184-198 writes the same
;  registers in the same order, independently, which is the second
;  witness.
;
;  ICA, IUA AND COEF0 ARE WRITTEN AS ZERO RATHER THAN LEFT ALONE. They
;  are the chroma plane, the U plane and the YUV coefficient control,
;  meaningless for an RGBA copy - but they are also STATE, and this
;  block may have been used by the firmware or by an earlier job. A
;  left-over chroma address is a pointer the engine may follow. The
;  kernel writes all of them every time for the same reason. COEF1..3
;  are NOT written, exactly as the kernel does not write them unless
;  COEF0.USECOEF is set (:308-312); with USECOEF clear they are not
;  read.
;
;  THE CACHE MAINTENANCE IS HERE AND NOT AT THE CALL SITE. Both
;  buffers are cleaned-and-invalidated before the job: the input
;  because the engine is about to read what the CPU wrote, and the
;  OUTPUT as well, because a dirty line over the output buffer can be
;  evicted AFTER the engine's writes land and overwrite them - the
;  trap dma.pi4 records, and the one that produces corruption later
;  than the operation that caused it. With the ARM MMU off both are
;  free; see CACHE COHERENCY in the header, which states plainly which
;  regime this runs in and why a gate cannot check it.
;
;  Returns #V3D_OK once the job has been STARTED - not once it has
;  finished, and not once it has produced anything. V3dTfuWait() is
;  the second half and the output bytes are the third.
; ----------------------------------------------------------------------
Procedure.i V3dTfuSubmit()
  Protected cs.i

  If v3d_ready = 0
    v3d_err = #V3D_ERR_NOINIT
    ProcedureReturn #V3D_ERR_NOINIT
  EndIf
  If (v3d_ident1 & #V3D_IDENT1_WITH_TFU) = 0
    v3d_err = #V3D_ERR_TFU_ABSENT
    ProcedureReturn #V3D_ERR_TFU_ABSENT
  EndIf
  ; The TFU's addresses are VIRTUAL - v3d_submit.c:1054-1055, "the TFU
  ; is behind the MMU". Submitting with no page table is handing the
  ; engine addresses that mean nothing.
  If v3d_mmuOn = 0
    v3d_err = #V3D_ERR_MMU_OFF
    ProcedureReturn #V3D_ERR_MMU_OFF
  EndIf
  If v3d_tfuHaveSrc = 0
    v3d_err = #V3D_ERR_TFU_ARGS
    ProcedureReturn #V3D_ERR_TFU_ARGS
  EndIf
  If v3d_tfuHaveDst = 0
    v3d_err = #V3D_ERR_TFU_ARGS
    ProcedureReturn #V3D_ERR_TFU_ARGS
  EndIf

  cs = V3dHubRead(#V3D_TFU_CS)
  If (cs & #V3D_TFU_CS_BUSY) <> 0
    v3d_tfuCsBefore = cs
    v3d_err = #V3D_ERR_TFU_BUSY
    ProcedureReturn #V3D_ERR_TFU_BUSY
  EndIf

  V3dCacheRange(v3d_tfuSrcAddr, v3d_tfuSrcBytes)
  V3dCacheRange(v3d_tfuDstAddr, v3d_tfuDstBytes)

  ; Clear the two TFU status bits so that whatever is read after the
  ; job belongs to THIS job. They are sticky and the block may have
  ; been used before this program ran.
  V3dHubWrite(#V3D_HUB_INT_CLR, #V3D_HUB_INT_TFUC | #V3D_HUB_INT_TFUF)

  v3d_tfuCsBefore  = V3dHubRead(#V3D_TFU_CS)
  v3d_tfuCvtBefore = (v3d_tfuCsBefore >> #V3D_TFU_CS_CVTCT_SHIFT) & #V3D_TFU_CS_CVTCT_BYTE

  V3dHubWrite(#V3D_TFU_IIA, v3d_tfuIia)
  V3dHubWrite(#V3D_TFU_IIS, v3d_tfuIis)
  V3dHubWrite(#V3D_TFU_ICA, 0)
  V3dHubWrite(#V3D_TFU_IUA, 0)
  V3dHubWrite(#V3D_TFU_IOA, v3d_tfuIoa)
  V3dHubWrite(#V3D_TFU_IOS, v3d_tfuIos)
  V3dHubWrite(#V3D_TFU_COEF0, 0)

  ; THE BARRIER IS LOAD BEARING. The register writes above are Device
  ; memory and are ordered against each other by the memory type, but
  ; NOT against the DRAM stores that filled the input buffer. Without
  ; this the engine can start before the pixels have landed, and the
  ; result is a partly-stale output that reads as a tiling bug.
  V3dBarrier()

  V3dHubWrite(#V3D_TFU_ICFG, v3d_tfuIcfg | #V3D_TFU_ICFG_IOC)
  V3dBarrier()

  v3d_tfuHaveJob = 1
  v3d_tfuJobs    = v3d_tfuJobs + 1
  ProcedureReturn #V3D_OK
EndProcedure

; ----------------------------------------------------------------------
;  V3dTfuWait - wait for the conversion counter to move.
;
;  TFU_CS.CVTCT, NOT HUB_INT_STS.TFUC, IS THE ARBITER.
;  mesa/v3dx_simulator.c:182 samples CVTCT before submission and :200
;  spins until it CHANGES, and that is the whole of its completion
;  test. The counter needs no interrupt and no unmasking; TFUC sits
;  behind HUB_INT_MSK, which this file does not touch, and whether a
;  masked event still shows in HUB_INT_STS on this part is written
;  down nowhere on this disk. Polling the counter means the answer
;  does not depend on knowing.
;
;  IT IS AN EIGHT-BIT COUNTER AND IT WRAPS. The test is "different
;  from before", not "greater than before", which is also what the
;  simulator does. A run of 256 jobs would alias; that is recorded
;  rather than guarded, because guarding it needs a wider counter that
;  does not exist.
;
;  EVERY EXIT RECORDS EVERY PIECE OF EVIDENCE. A timeout with the MMU
;  reporting PT_INVALID and a timeout with the MMU clean are
;  completely different findings and the difference costs four reads.
;
;  AND IT STILL DOES NOT MEAN THE OUTPUT IS RIGHT. #V3D_OK here means
;  a counter moved. Read the bytes.
; ----------------------------------------------------------------------
Procedure.i V3dTfuWait(us.i)
  Protected cs.i
  Protected cvt.i
  Protected hz.i
  Protected deadline.i
  Protected spins.i
  Protected done.i
  Protected rc.i

  If v3d_tfuHaveJob = 0
    v3d_err = #V3D_ERR_TFU_ARGS
    ProcedureReturn #V3D_ERR_TFU_ARGS
  EndIf

  hz = V3dCounterHz()
  deadline = 0
  If hz > 0
    deadline = V3dTicks() + ((hz / 1000000) * us)
  EndIf
  spins = 0
  done  = 0
  rc    = #V3D_ERR_TFU_TIMEOUT

  Repeat
    cs  = V3dHubRead(#V3D_TFU_CS)
    cvt = (cs >> #V3D_TFU_CS_CVTCT_SHIFT) & #V3D_TFU_CS_CVTCT_BYTE
    If cvt <> v3d_tfuCvtBefore
      done = 1
      rc   = #V3D_OK
      Break
    EndIf

    ; A fault ends the wait early rather than at the deadline: with
    ; PT_INVALID_ABORT set the access was aborted and the conversion
    ; is never going to complete. Reporting it after 100 ms of
    ; spinning would be the same answer, later.
    If (V3dHubRead(#V3D_MMU_CTL) & #V3D_MMU_CTL_FAULTS) <> 0
      rc = #V3D_ERR_MMU_FAULT
      Break
    EndIf
    If (V3dHubRead(#V3D_HUB_INT_STS) & #V3D_HUB_INT_TFUF) <> 0
      rc = #V3D_ERR_TFU_FAIL
      Break
    EndIf

    spins = spins + 1
    If spins > #V3D_SPIN_LIMIT
      Break
    EndIf
    If hz > 0
      If V3dTicks() > deadline
        Break
      EndIf
    EndIf
  ForEver

  ; The barrier goes here and not after the compare: the DRAM the
  ; engine wrote has to be ordered against the CPU's next load, and
  ; Device ordering on the register reads above does not give that.
  V3dBarrier()

  v3d_tfuSpins    = spins
  v3d_tfuCsAfter  = V3dHubRead(#V3D_TFU_CS)
  v3d_tfuCvtAfter = (v3d_tfuCsAfter >> #V3D_TFU_CS_CVTCT_SHIFT) & #V3D_TFU_CS_CVTCT_BYTE
  v3d_tfuIntSts   = V3dHubRead(#V3D_HUB_INT_STS)
  v3d_tfuMmuCtl   = V3dHubRead(#V3D_MMU_CTL)
  v3d_tfuVioAddr  = V3dHubRead(#V3D_MMU_VIO_ADDR)
  v3d_tfuVioId    = V3dHubRead(#V3D_MMU_VIO_ID)

  ; A job that completed AND faulted has produced garbage, and the
  ; counter moving does not undo that. The fault wins.
  If done = 1
    If (v3d_tfuMmuCtl & #V3D_MMU_CTL_FAULTS) <> 0
      rc = #V3D_ERR_MMU_FAULT
    ElseIf (v3d_tfuIntSts & #V3D_HUB_INT_TFUF) <> 0
      rc = #V3D_ERR_TFU_FAIL
    EndIf
  EndIf

  ; Invalidate the CPU's view of what the engine just wrote. With the
  ; ARM MMU off this does nothing and costs a few cycles; with DRAM
  ; cacheable it is the difference between reading the result and
  ; reading the poison the CPU put there before the job.
  V3dCacheRange(v3d_tfuDstAddr, v3d_tfuDstBytes)

  v3d_tfuHaveJob = 0
  If rc <> #V3D_OK
    v3d_err = rc
  EndIf
  ProcedureReturn rc
EndProcedure


; ======================================================================
;  STAGE 1 ACCESSORS
;
;  Raw words again, for a diagnostic to print. The composed registers
;  are exposed as well as the results, because "what did we actually
;  write" is the first question after an output that is wrong, and
;  reconstructing it from the log by hand is how a transcription error
;  survives being looked at.
; ======================================================================

Procedure.i V3dTfuIcfgSent()
  ProcedureReturn v3d_tfuIcfg
EndProcedure

Procedure.i V3dTfuIiaSent()
  ProcedureReturn v3d_tfuIia
EndProcedure

Procedure.i V3dTfuIisSent()
  ProcedureReturn v3d_tfuIis
EndProcedure

Procedure.i V3dTfuIoaSent()
  ProcedureReturn v3d_tfuIoa
EndProcedure

Procedure.i V3dTfuIosSent()
  ProcedureReturn v3d_tfuIos
EndProcedure

Procedure.i V3dTfuCsBefore()
  ProcedureReturn v3d_tfuCsBefore
EndProcedure

Procedure.i V3dTfuCsAfter()
  ProcedureReturn v3d_tfuCsAfter
EndProcedure

Procedure.i V3dTfuConversionsBefore()
  ProcedureReturn v3d_tfuCvtBefore
EndProcedure

Procedure.i V3dTfuConversionsAfter()
  ProcedureReturn v3d_tfuCvtAfter
EndProcedure

Procedure.i V3dTfuIntStsAtWait()
  ProcedureReturn v3d_tfuIntSts
EndProcedure

Procedure.i V3dTfuMmuCtlAtWait()
  ProcedureReturn v3d_tfuMmuCtl
EndProcedure

Procedure.i V3dTfuVioAddrAtWait()
  ProcedureReturn v3d_tfuVioAddr
EndProcedure

Procedure.i V3dTfuVioIdAtWait()
  ProcedureReturn v3d_tfuVioId
EndProcedure

Procedure.i V3dTfuSpins()
  ProcedureReturn v3d_tfuSpins
EndProcedure

Procedure.i V3dTfuJobs()
  ProcedureReturn v3d_tfuJobs
EndProcedure

; TFU_CS live, and its three decoded fields. NFREE is the number of
; free input slots in the unit's queue (v3d_regs.h:97-98); it is
; printed rather than acted on, because a queue this file only ever
; puts one job in at a time cannot fill up - and an NFREE that read
; zero on an idle unit would say something is wrong that no other
; register would.
Procedure.i V3dTfuCsNow()
  ProcedureReturn V3dHubRead(#V3D_TFU_CS)
EndProcedure

Procedure.i V3dTfuConversionsOf(cs.i)
  ProcedureReturn (cs >> #V3D_TFU_CS_CVTCT_SHIFT) & #V3D_TFU_CS_CVTCT_BYTE
EndProcedure

Procedure.i V3dTfuFreeSlotsOf(cs.i)
  ProcedureReturn (cs >> #V3D_TFU_CS_NFREE_SHIFT) & #V3D_TFU_CS_NFREE_6BIT
EndProcedure

Procedure.i V3dTfuBusyOf(cs.i)
  If (cs & #V3D_TFU_CS_BUSY) <> 0
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure


; ======================================================================
; ======================================================================
;  STAGE 2 - THE COMPUTE SHADER DISPATCHER
; ======================================================================
; ======================================================================
;
;  WHAT THIS IS FOR, AND WHY IT IS NOT A DRAW.
;
;    The TFU proved the GPU moves bytes. It did not prove a QPU
;    executes an instruction, because the TFU has no QPUs in it - it
;    is a fixed-function tiler in the hub.
;
;    The CSD is the smallest thing on this part that runs a PROGRAM.
;    Seven register writes, no control list, no binner, no tile state,
;    no shader state record, no rasteriser, no framebuffer. A compute
;    shader that writes a known pattern to memory and is then checked
;    BYTE FOR BYTE ON THE CPU is the same shape of proof the TFU job
;    used, and it is far smaller than the smallest draw - which needs
;    two control lists whose minimum contents are not written down
;    anywhere on this disk.
;
;  A STATUS BIT IS NOT A RESULT, and this section is built around that
;  exactly as the TFU section is. V3dCsdWait() returning #V3D_OK means
;  an eight-bit counter inside core 0 changed. It does not mean the
;  program ran, it does not mean the program ran on more than one
;  lane, and it does not mean the output is right. READ THE BYTES.
;
;  THE CALLS, IN ORDER:
;
;    V3dCsdBegin(wgX, wgY, wgZ, wgSize, wgsPerSg)
;    V3dCsdCode(codeVa, codeBytes, flags)
;    V3dCsdUniforms(unifVa, unifBytes)      -- optional
;    V3dCsdOutput(outVa, outBytes)          -- optional, see below
;    V3dCsdSubmit()
;    V3dCsdWait(us)
;
;  WHY V3dCsdOutput() EXISTS WHEN THE HARDWARE HAS NO SUCH REGISTER.
;
;    It carries no configuration at all. It exists so that the CACHE
;    MAINTENANCE IS STRUCTURAL RATHER THAN REMEMBERED, which is the
;    rule V3dTfuSubmit() was built on: the submit call takes the byte
;    EXTENT of every buffer the job touches and maintains all of them,
;    so a caller cannot forget the one that mattered. A caller who
;    genuinely has no output buffer omits it and gets a job whose
;    output nobody can read, which is a different mistake and a
;    visible one.
;
;    WITH THE ARM MMU OFF THOSE CALLS ARE FREE, and the first CSD run
;    is deliberately done that way - see the discipline note in
;    pi4V3dCsd.pi4. They are here for the run that is owed with the
;    MMU on and DRAM cacheable, which has still never happened.
; ----------------------------------------------------------------------

Global v3d_csdCfg0.i = 0
Global v3d_csdCfg1.i = 0
Global v3d_csdCfg2.i = 0
Global v3d_csdCfg3.i = 0
Global v3d_csdCfg4.i = 0
Global v3d_csdCfg5.i = 0
Global v3d_csdCfg6.i = 0

Global v3d_csdHaveGrid.i = 0
Global v3d_csdHaveCode.i = 0
Global v3d_csdHaveJob.i  = 0

Global v3d_csdCodeAddr.i  = 0
Global v3d_csdCodeBytes.i = 0
Global v3d_csdUnifAddr.i  = 0
Global v3d_csdUnifBytes.i = 0
Global v3d_csdOutAddr.i   = 0
Global v3d_csdOutBytes.i  = 0

Global v3d_csdJobs.i          = 0
Global v3d_csdStatusBefore.i  = 0
Global v3d_csdStatusAfter.i   = 0
Global v3d_csdDoneBefore.i    = 0
Global v3d_csdDoneAfter.i     = 0
Global v3d_csdSpins.i         = 0
Global v3d_csdIntSts.i        = 0
Global v3d_csdErrStat.i       = 0
Global v3d_csdMmuCtl.i        = 0
Global v3d_csdVioAddr.i       = 0
Global v3d_csdVioId.i         = 0
Global v3d_csdCleanRc.i       = 0

; ----------------------------------------------------------------------
;  V3dCsdBegin - the grid, which is CFG0 through CFG4.
;
;  `wgSize` is the number of invocations in ONE workgroup - Mesa's
;  block[0] * block[1] * block[2] (v3dx_draw.c:1506). The QPU is
;  sixteen lanes wide and a BATCH is sixteen invocations, so a
;  workgroup of sixteen is exactly one batch and one QPU instruction
;  covers the whole of it.
;
;  `wgsPerSg` is workgroups per supergroup. FOUR BITS, AND ZERO MEANS
;  SIXTEEN (v3d_csd.h:33), so this procedure takes the real number and
;  masks it, which is Mesa's rule at v3dx_draw.c:1524.
;
;  THE BATCH ARITHMETIC IS MESA'S, LINE FOR LINE, v3dx_draw.c:1518-1538,
;  and it is not obvious enough to paraphrase:
;
;      batches_per_sg = ceil(wgs_per_sg * wg_size / 16)
;      whole_sgs      = num_wgs / wgs_per_sg
;      rem_wgs        = num_wgs - whole_sgs * wgs_per_sg
;      num_batches    = batches_per_sg * whole_sgs
;                     + ceil(rem_wgs * wg_size / 16)
;      cfg4           = num_batches - 1        (on 4.2)
;
;  CFG3's BATCHES_PER_SG_M1 is batches_per_sg - 1, which is a
;  DIFFERENT quantity from cfg4 and the two are easily confused: the
;  first is how many batches one supergroup holds, the second is how
;  many batches the whole dispatch will run. For a single workgroup of
;  sixteen with wgsPerSg sixteen they are 15 and 0 respectively, and
;  py-videocore6 arrives at the same two numbers by a different route
;  (driver.py:164 and :167, where cfg4 is `thread - 1`) - two
;  independent implementations agreeing on a pair of numbers that look
;  like each other's typo.
;
;  Returns #V3D_OK or #V3D_ERR_CSD_ARGS.
; ----------------------------------------------------------------------
Procedure.i V3dCsdBegin(wgX.i, wgY.i, wgZ.i, wgSize.i, wgsPerSg.i)
  Protected numWgs.i
  Protected batchesPerSg.i
  Protected wholeSgs.i
  Protected remWgs.i
  Protected numBatches.i

  v3d_csdHaveGrid = 0
  v3d_csdHaveJob  = 0

  ; THE ARGUMENTS ARE CHECKED BEFORE THE STATE IS, as V3dMmuMap() does
  ; and for the same reason: a zero workgroup count is the caller's
  ; bug whether or not the block has been brought up, and answering
  ; NOINIT to it would name the wrong problem.
  ;
  ; ZERO WORKGROUPS IS REFUSED BECAUSE THE HARDWARE CANNOT DO IT.
  ; Mesa returns early rather than dispatching, with the comment
  ; "Nothing to dispatch, so skip the draw (CSD can't handle 0
  ; workgroups)" - v3dx_draw.c:1484-1490. A refusal here is that
  ; comment made enforceable.
  If wgX <= 0 Or wgX > $FFFF
    v3d_err = #V3D_ERR_CSD_ARGS
    ProcedureReturn #V3D_ERR_CSD_ARGS
  EndIf
  If wgY <= 0 Or wgY > $FFFF
    v3d_err = #V3D_ERR_CSD_ARGS
    ProcedureReturn #V3D_ERR_CSD_ARGS
  EndIf
  If wgZ <= 0 Or wgZ > $FFFF
    v3d_err = #V3D_ERR_CSD_ARGS
    ProcedureReturn #V3D_ERR_CSD_ARGS
  EndIf
  ; WG_SIZE is eight bits. A workgroup of 256 would encode as zero.
  If wgSize <= 0 Or wgSize > 255
    v3d_err = #V3D_ERR_CSD_ARGS
    ProcedureReturn #V3D_ERR_CSD_ARGS
  EndIf
  If wgsPerSg <= 0 Or wgsPerSg > 16
    v3d_err = #V3D_ERR_CSD_ARGS
    ProcedureReturn #V3D_ERR_CSD_ARGS
  EndIf

  numWgs = wgX * wgY * wgZ

  ; ceil(a / b) written out. DIV_ROUND_UP in the source; the values
  ; here are small and positive so the two are exactly equivalent.
  batchesPerSg = ((wgsPerSg * wgSize) + 15) / 16
  wholeSgs     = numWgs / wgsPerSg
  remWgs       = numWgs - (wholeSgs * wgsPerSg)
  numBatches   = (batchesPerSg * wholeSgs) + (((remWgs * wgSize) + 15) / 16)

  If numBatches <= 0
    v3d_err = #V3D_ERR_CSD_ARGS
    ProcedureReturn #V3D_ERR_CSD_ARGS
  EndIf

  v3d_csdCfg0 = (wgX & $FFFF) << #V3D_CSD_CFG012_WG_COUNT_SHIFT
  v3d_csdCfg1 = (wgY & $FFFF) << #V3D_CSD_CFG012_WG_COUNT_SHIFT
  v3d_csdCfg2 = (wgZ & $FFFF) << #V3D_CSD_CFG012_WG_COUNT_SHIFT

  v3d_csdCfg3 = (wgsPerSg & #V3D_CSD_CFG3_WGS_PER_SG_NIBBLE) << #V3D_CSD_CFG3_WGS_PER_SG_SHIFT
  v3d_csdCfg3 = v3d_csdCfg3 | ((batchesPerSg - 1) << #V3D_CSD_CFG3_BATCHES_PER_SG_M1_SHIFT)
  v3d_csdCfg3 = v3d_csdCfg3 | ((wgSize & #V3D_CSD_CFG3_WG_SIZE_BYTE) << #V3D_CSD_CFG3_WG_SIZE_SHIFT)

  ; :1531-1538. On 4.2 it is num_batches MINUS ONE; 7.1.6 and later
  ; stopped subtracting. The version gate matters and this part is on
  ; the subtracting side of it.
  v3d_csdCfg4 = numBatches - 1

  v3d_csdHaveGrid = 1
  ProcedureReturn #V3D_OK
EndProcedure

; ----------------------------------------------------------------------
;  V3dCsdCode - CFG5, the shader address and its three flags.
;
;  `flags` is an OR of #V3D_CSD_CFG5_PROPAGATE_NANS, _SINGLE_SEG and
;  _THREADING. It is the caller's because the three describe the
;  PROGRAM and this file cannot see one:
;
;    THREADING is set when the program was compiled for four threads
;    (v3dx_draw.c:1552, `threads == 4`). A program built by
;    v3dqpu.pi4's V3dQpuThreadEnd() is a one-thread program and must
;    leave it clear.
;    SINGLE_SEG comes from the program data (:1550).
;    PROPAGATE_NANS Mesa sets unconditionally on 4.2 (:1548-1549) and
;    py-videocore6 leaves clear by default (driver.py:148). The two
;    disagree; it changes NaN behaviour in float arithmetic and
;    nothing else, so for an integer program it cannot matter, and
;    the caller is told rather than the choice being made for them.
;
;  `codeBytes` is the extent for the cache maintenance and nothing
;  else. There is no length register - the program ends when it ends,
;  at its last thread switch.
;
;  Returns #V3D_OK or #V3D_ERR_CSD_ARGS.
; ----------------------------------------------------------------------
Procedure.i V3dCsdCode(codeVa.i, codeBytes.i, flags.i)
  v3d_csdHaveCode = 0
  v3d_csdHaveJob  = 0

  If codeVa <= 0
    v3d_err = #V3D_ERR_CSD_ARGS
    ProcedureReturn #V3D_ERR_CSD_ARGS
  EndIf
  ; The low three bits are flags, so an address using them is not an
  ; address. Checked here as well as in V3dQpuProgramBegin() because
  ; a caller can reach this without going through that.
  If (codeVa % #V3D_CSD_CFG5_ADDR_ALIGN) <> 0
    v3d_err = #V3D_ERR_CSD_ARGS
    ProcedureReturn #V3D_ERR_CSD_ARGS
  EndIf
  If codeBytes < 8
    v3d_err = #V3D_ERR_CSD_ARGS
    ProcedureReturn #V3D_ERR_CSD_ARGS
  EndIf
  If (flags & #V3D_CSD_CFG5_FLAG_MASK) <> flags
    v3d_err = #V3D_ERR_CSD_ARGS
    ProcedureReturn #V3D_ERR_CSD_ARGS
  EndIf

  v3d_csdCodeAddr  = codeVa
  v3d_csdCodeBytes = codeBytes
  v3d_csdCfg5      = (codeVa & $FFFFFFFF) | flags
  v3d_csdHaveCode  = 1
  ProcedureReturn #V3D_OK
EndProcedure

; ----------------------------------------------------------------------
;  V3dCsdUniforms - CFG6, the uniform stream.
;
;  The QPU reads it one word at a time with the LDUNIF and LDUNIFRF
;  signals; there is no length and no bound. A program that reads more
;  uniforms than the caller placed reads whatever is next in memory,
;  which behind the V3D MMU means either the next mapped page or a
;  fault - and a fault is the better of the two, which is why
;  V3dMmuInit() leaves the table sparse.
;
;  A dispatch with no uniforms passes zero, and CFG6 is then zero.
;  That is safe here for the same reason VA page 0 is never mapped:
;  the address does not resolve, so a program that reads a uniform it
;  was not given faults and names itself instead of reading rubbish.
; ----------------------------------------------------------------------
Procedure.i V3dCsdUniforms(unifVa.i, unifBytes.i)
  If unifVa < 0
    v3d_err = #V3D_ERR_CSD_ARGS
    ProcedureReturn #V3D_ERR_CSD_ARGS
  EndIf
  If unifVa > 0
    ; The uniform stream is fetched a 32-bit word at a time.
    If (unifVa % 4) <> 0
      v3d_err = #V3D_ERR_CSD_ARGS
      ProcedureReturn #V3D_ERR_CSD_ARGS
    EndIf
  EndIf
  v3d_csdUnifAddr  = unifVa
  v3d_csdUnifBytes = unifBytes
  v3d_csdCfg6      = unifVa & $FFFFFFFF
  ProcedureReturn #V3D_OK
EndProcedure

; ----------------------------------------------------------------------
;  V3dCsdOutput - no register, only an extent. See the section header
;  for why this exists.
; ----------------------------------------------------------------------
Procedure V3dCsdOutput(outVa.i, outBytes.i)
  v3d_csdOutAddr  = outVa
  v3d_csdOutBytes = outBytes
EndProcedure

; ----------------------------------------------------------------------
;  V3dCsdSubmit - seven writes, CFG0 last.
;
;  Returns #V3D_OK or the refusal that stopped it. #V3D_OK means the
;  writes were made, and nothing else.
; ----------------------------------------------------------------------
Procedure.i V3dCsdSubmit()
  Protected st.i

  If v3d_ready = 0
    v3d_err = #V3D_ERR_NOINIT
    ProcedureReturn #V3D_ERR_NOINIT
  EndIf
  ; The CSD's addresses go through the V3D MMU - see the section
  ; header, and note that unlike the TFU this is an inference rather
  ; than a quotation. Submitting with no page table would hand the
  ; engine numbers that mean nothing.
  If v3d_mmuOn = 0
    v3d_err = #V3D_ERR_MMU_OFF
    ProcedureReturn #V3D_ERR_MMU_OFF
  EndIf
  If v3d_csdHaveGrid = 0
    v3d_err = #V3D_ERR_CSD_ARGS
    ProcedureReturn #V3D_ERR_CSD_ARGS
  EndIf
  If v3d_csdHaveCode = 0
    v3d_err = #V3D_ERR_CSD_ARGS
    ProcedureReturn #V3D_ERR_CSD_ARGS
  EndIf

  ; A dispatch already current or queued means somebody else owns the
  ; unit. Submitting on top of it would make the completion counter
  ; ambiguous, and the counter is the only completion evidence there
  ; is.
  st = V3dCoreRead(#V3D_CSD_STATUS)
  If (st & #V3D_CSD_STATUS_HAVE_CURRENT) <> 0
    v3d_csdStatusBefore = st
    v3d_err = #V3D_ERR_CSD_BUSY
    ProcedureReturn #V3D_ERR_CSD_BUSY
  EndIf
  If (st & #V3D_CSD_STATUS_HAVE_QUEUED) <> 0
    v3d_csdStatusBefore = st
    v3d_err = #V3D_ERR_CSD_BUSY
    ProcedureReturn #V3D_ERR_CSD_BUSY
  EndIf

  ; STRUCTURAL MAINTENANCE. Every buffer the job touches, by extent,
  ; every time - the rule V3dTfuSubmit() established. With the ARM MMU
  ; off these are free; with it on and DRAM cacheable they are the
  ; whole difference between a job that works and a job that reads the
  ; program the CPU wrote two cache lines ago.
  V3dCacheRange(v3d_csdCodeAddr, v3d_csdCodeBytes)
  If v3d_csdUnifAddr > 0
    V3dCacheRange(v3d_csdUnifAddr, v3d_csdUnifBytes)
  EndIf
  If v3d_csdOutAddr > 0
    V3dCacheRange(v3d_csdOutAddr, v3d_csdOutBytes)
  EndIf

  ; THE GPU'S OWN CACHES, and unlike the TFU path this one is not
  ; optional. v3d_csd_job_run calls v3d_invalidate_caches(v3d) at
  ; v3d_sched.c:330, exactly as the bin (:199) and render (:251) paths
  ; do and exactly as the TFU path (:279-315) does NOT. The CSD runs
  ; on a core, behind the core's L2T and slice caches, and the program
  ; the CPU just wrote is not in them.
  V3dInvalidateCaches()

  ; Clear CSDDONE so that whatever is read afterwards belongs to THIS
  ; job. It is sticky and the block may have been used before.
  V3dCoreWrite(#V3D_CTL_INT_CLR, #V3D_CTL_INT_CSDDONE)

  v3d_csdStatusBefore = V3dCoreRead(#V3D_CSD_STATUS)
  v3d_csdDoneBefore   = (v3d_csdStatusBefore >> #V3D_CSD_STATUS_NUM_COMPLETED_SHIFT) & #V3D_CSD_STATUS_NUM_COMPLETED_BYTE

  ; :356. CFG1 through CFG6, then CFG0.
  V3dCoreWrite(#V3D_CSD_QUEUED_CFG1, v3d_csdCfg1)
  V3dCoreWrite(#V3D_CSD_QUEUED_CFG2, v3d_csdCfg2)
  V3dCoreWrite(#V3D_CSD_QUEUED_CFG3, v3d_csdCfg3)
  V3dCoreWrite(#V3D_CSD_QUEUED_CFG4, v3d_csdCfg4)
  V3dCoreWrite(#V3D_CSD_QUEUED_CFG5, v3d_csdCfg5)
  V3dCoreWrite(#V3D_CSD_QUEUED_CFG6, v3d_csdCfg6)

  ; THE BARRIER IS LOAD BEARING, for V3dTfuSubmit()'s reason. The six
  ; writes above are Device memory and are ordered against each other
  ; by the memory type, but NOT against the DRAM stores that wrote the
  ; QPU program and the uniforms. Without this the dispatcher can
  ; start before the instructions have landed, and a QPU executing
  ; half a program is not a failure mode with a status bit.
  V3dBarrier()

  ; :357-358. "CFG0 write kicks off the job."
  V3dCoreWrite(#V3D_CSD_QUEUED_CFG0, v3d_csdCfg0)
  V3dBarrier()

  v3d_csdHaveJob = 1
  v3d_csdJobs    = v3d_csdJobs + 1
  ProcedureReturn #V3D_OK
EndProcedure

; ----------------------------------------------------------------------
;  V3dCsdWait - wait for CSD_STATUS.NUM_COMPLETED to move.
;
;  v3dx_simulator.c:207-245: sample the field before submission, spin
;  until it CHANGES. Not "greater than" - it is an eight-bit field and
;  it wraps, and the simulator's own test is inequality. A run of 256
;  dispatches would alias; recorded rather than guarded, because
;  guarding it needs a wider counter that does not exist.
;
;  EVERY EXIT RECORDS EVERY PIECE OF EVIDENCE, as V3dTfuWait() does. A
;  timeout with MMU_CTL clean and a timeout with PT_INVALID set are
;  completely different findings and the difference costs four reads.
;
;  AND IT STILL DOES NOT MEAN THE OUTPUT IS RIGHT.
; ----------------------------------------------------------------------
Procedure.i V3dCsdWait(us.i)
  Protected st.i
  Protected done.i
  Protected hz.i
  Protected deadline.i
  Protected spins.i
  Protected moved.i
  Protected rc.i

  If v3d_csdHaveJob = 0
    v3d_err = #V3D_ERR_CSD_ARGS
    ProcedureReturn #V3D_ERR_CSD_ARGS
  EndIf

  hz = V3dCounterHz()
  deadline = 0
  If hz > 0
    deadline = V3dTicks() + ((hz / 1000000) * us)
  EndIf
  spins = 0
  moved = 0
  rc    = #V3D_ERR_CSD_TIMEOUT

  Repeat
    st   = V3dCoreRead(#V3D_CSD_STATUS)
    done = (st >> #V3D_CSD_STATUS_NUM_COMPLETED_SHIFT) & #V3D_CSD_STATUS_NUM_COMPLETED_BYTE
    If done <> v3d_csdDoneBefore
      moved = 1
      rc    = #V3D_OK
      Break
    EndIf

    ; A page fault ends the wait early rather than at the deadline:
    ; with PT_INVALID_ABORT set the access was aborted and the
    ; dispatch is not going to complete. Reporting it after 100 ms of
    ; spinning would be the same answer, later.
    If (V3dHubRead(#V3D_MMU_CTL) & #V3D_MMU_CTL_FAULTS) <> 0
      rc = #V3D_ERR_MMU_FAULT
      Break
    EndIf

    spins = spins + 1
    If spins > #V3D_SPIN_LIMIT
      Break
    EndIf
    If hz > 0
      If V3dTicks() > deadline
        Break
      EndIf
    EndIf
  ForEver

  ; ------------------------------------------------------------------
  ;  GET THE GPU'S WRITES OUT OF THE GPU, and this is not optional.
  ;
  ;  A TMU write lands in the core's write combiner and its L2T cache,
  ;  not in DRAM. On 2026-08-27 the first CSD run on this silicon
  ;  completed cleanly - counter moved, CSDDONE set, MMU clean - and
  ;  left the output page holding every one of its poison words,
  ;  because nothing had told the core to write back. See
  ;  V3dCleanCaches() for the two steps and both citations.
  ;
  ;  IT RUNS EVEN WHEN THE WAIT FAILED. A dispatch that timed out may
  ;  still have written some of its output, and those bytes are the
  ;  most informative thing a failed run can produce - "it completed
  ;  nothing" and "it completed half" are different findings. Cleaning
  ;  cannot make a timeout worse.
  ;
  ;  A CLEAN THAT ITSELF TIMES OUT DOES NOT OVERWRITE A REAL RESULT.
  ;  It is recorded in v3d_cleanSpins and reported through
  ;  V3dCsdCleanResult(); it only becomes the returned error if the
  ;  dispatch itself was otherwise fine, because a caller told
  ;  "CACHE_TIMEOUT" when the real fault was a page fault would go and
  ;  look at the wrong register.
  ; ------------------------------------------------------------------
  v3d_csdCleanRc = V3dCleanCaches()

  ; The barrier goes here and not after the compare: the DRAM the QPU
  ; wrote has to be ordered against the CPU's next load, and Device
  ; ordering on the register reads above does not give that.
  V3dBarrier()

  v3d_csdSpins       = spins
  v3d_csdStatusAfter = V3dCoreRead(#V3D_CSD_STATUS)
  v3d_csdDoneAfter   = (v3d_csdStatusAfter >> #V3D_CSD_STATUS_NUM_COMPLETED_SHIFT) & #V3D_CSD_STATUS_NUM_COMPLETED_BYTE
  v3d_csdIntSts      = V3dCoreRead(#V3D_CTL_INT_STS)
  v3d_csdErrStat     = V3dCoreRead(#V3D_ERR_STAT)
  v3d_csdMmuCtl      = V3dHubRead(#V3D_MMU_CTL)
  v3d_csdVioAddr     = V3dHubRead(#V3D_MMU_VIO_ADDR)
  v3d_csdVioId       = V3dHubRead(#V3D_MMU_VIO_ID)

  ; A dispatch that completed AND faulted has produced garbage, and
  ; the counter moving does not undo that. The fault wins.
  If moved = 1
    If (v3d_csdMmuCtl & #V3D_MMU_CTL_FAULTS) <> 0
      v3d_err = #V3D_ERR_MMU_FAULT
      ProcedureReturn #V3D_ERR_MMU_FAULT
    EndIf
  EndIf

  ; The clean's own failure is reported LAST and only if nothing
  ; better is available - see the note above.
  If rc = #V3D_OK
    If v3d_csdCleanRc <> #V3D_OK
      v3d_err = v3d_csdCleanRc
      ProcedureReturn v3d_csdCleanRc
    EndIf
  EndIf

  v3d_err = rc
  ProcedureReturn rc
EndProcedure

; ----------------------------------------------------------------------
;  The CSD's evidence, live and remembered. All reads.
; ----------------------------------------------------------------------
Procedure.i V3dCsdCleanResult()
  ProcedureReturn v3d_csdCleanRc
EndProcedure

Procedure.i V3dCsdStatusNow()
  ProcedureReturn V3dCoreRead(#V3D_CSD_STATUS)
EndProcedure

Procedure.i V3dCsdCompletedOf(st.i)
  ProcedureReturn (st >> #V3D_CSD_STATUS_NUM_COMPLETED_SHIFT) & #V3D_CSD_STATUS_NUM_COMPLETED_BYTE
EndProcedure

Procedure.i V3dCsdActiveOf(st.i)
  ProcedureReturn (st >> #V3D_CSD_STATUS_NUM_ACTIVE_SHIFT) & #V3D_CSD_STATUS_NUM_ACTIVE_2BIT
EndProcedure

Procedure.i V3dCsdStatusBefore()
  ProcedureReturn v3d_csdStatusBefore
EndProcedure

Procedure.i V3dCsdStatusAfter()
  ProcedureReturn v3d_csdStatusAfter
EndProcedure

Procedure.i V3dCsdDoneBefore()
  ProcedureReturn v3d_csdDoneBefore
EndProcedure

Procedure.i V3dCsdDoneAfter()
  ProcedureReturn v3d_csdDoneAfter
EndProcedure

Procedure.i V3dCsdSpins()
  ProcedureReturn v3d_csdSpins
EndProcedure

Procedure.i V3dCsdJobs()
  ProcedureReturn v3d_csdJobs
EndProcedure

Procedure.i V3dCsdIntStsAfter()
  ProcedureReturn v3d_csdIntSts
EndProcedure

Procedure.i V3dCsdErrStatAfter()
  ProcedureReturn v3d_csdErrStat
EndProcedure

Procedure.i V3dCsdMmuCtlAfter()
  ProcedureReturn v3d_csdMmuCtl
EndProcedure

Procedure.i V3dCsdVioAddrAfter()
  ProcedureReturn v3d_csdVioAddr
EndProcedure

Procedure.i V3dCsdVioIdAfter()
  ProcedureReturn v3d_csdVioId
EndProcedure

; The seven configuration words, as they were built. Printed by the
; diagnostic BEFORE submission, because a dispatch that does nothing
; is nearly always a wrong CFG3, and reading the register back
; afterwards reads what the hardware kept rather than what was asked
; for.
Procedure.i V3dCsdCfg(i.i)
  Select i
    Case 0
      ProcedureReturn v3d_csdCfg0
    Case 1
      ProcedureReturn v3d_csdCfg1
    Case 2
      ProcedureReturn v3d_csdCfg2
    Case 3
      ProcedureReturn v3d_csdCfg3
    Case 4
      ProcedureReturn v3d_csdCfg4
    Case 5
      ProcedureReturn v3d_csdCfg5
    Case 6
      ProcedureReturn v3d_csdCfg6
  EndSelect
  ProcedureReturn 0
EndProcedure


; ======================================================================
; ======================================================================
;  STAGE 3 - THE CONTROL LIST ENGINE, THE BINNER AND THE RENDERER
; ======================================================================
; ======================================================================
;
;  WHAT CHANGED, AND WHY THE SECTION ABOVE CALLED "WHY THERE IS STILL
;  NO CONTROL LIST IN THIS FILE" IS NOW WRONG IN ITS CONCLUSION AND
;  RIGHT IN EVERY ONE OF ITS REASONS.
;
;    That section says the minimum viable control list is not written
;    down anywhere, that v3d_packet.xml declares 99 packets and names
;    no mandatory subset, and that a Python model of the CLE written
;    from the same XML would agree with this file by construction. All
;    three are still true and none of them has been solved. What has
;    changed is that ONE subset is no longer a guess:
;
;      MESA'S glClear() PATH, WITH NO DRAW CALLS AFTER IT, IS EXACTLY
;      A BIN LIST THAT BINS NOTHING PLUS A RENDER LIST THAT CLEARS AND
;      STORES.
;
;    That is not an extraction from a big general routine, it is a
;    path Mesa takes on its own for a program that clears a fresh
;    framebuffer and swaps. v3d_clear (v3dx_draw.c:1793-1806) calls
;    v3d_tlb_clear, which sets job->clear_tlb and job->store and calls
;    v3d_start_draw (v3dx_draw.c:1784-1788); v3d_start_draw emits the
;    bin prologue (v3dX(start_binning), :43-140) and NOTHING ELSE; and
;    v3d_job_submit (v3d_job.c:531-535) then emits the render list and
;    caps the bin list with bcl_epilogue. No primitive is ever added.
;
;    So the packet sequence below is not "the smallest subset we could
;    make work". It is a sequence Mesa itself submits, in that order,
;    for a real workload, and every packet in it is here because Mesa
;    emits it there. THE PACKETS THIS FILE DOES NOT EMIT ARE LISTED
;    UNDER "WHAT IS DELIBERATELY ABSENT" BELOW, each with the line of
;    Mesa that decides not to emit it either.
;
;  AND THE GATE PROBLEM IS UNSOLVED. Read this before believing a
;  green a64_v3d_rcl_check.py:
;
;    A Python encoder for these packets, written from v3d_packet.xml,
;    would agree with the encoders below because both are one person's
;    reading of one file. That is the failure this project has hit
;    repeatedly. What the gate CAN do, and what it therefore does, is
;    a different and weaker thing: it re-derives every field's START
;    and SIZE by PARSING v3d_packet.xml, and it re-derives every
;    packet's LENGTH by the rule v3d_decoder.c:728-738 states
;    (`last_bit / 8 + 1` over the shifted field ends), and it checks
;    the bytes this file produces against that. So it can fail on a
;    transposed shift, a wrong width, a missing minus_one, a wrong
;    packet length and a wrong packet ORDER. It cannot fail on a
;    packet that should not be there, on one that is missing, or on
;    the hardware disagreeing with the XML. THE PIXELS ARE THE ONLY
;    THING THAT CAN FAIL ON THOSE.
;
;  THE ORDER OF WORK IS DELIBERATE AND IT IS NOT NEGOTIABLE.
;  A wrong control list aimed at a live 1920x1080 HDMI surface gives a
;  corrupted screen and no information at all. A 64x64 buffer in plain
;  DRAM gives 4096 words the CPU can read one at a time. The library
;  is therefore written so that the framebuffer is just another
;  address, and the diagnostics do the small buffer first.
;
; ----------------------------------------------------------------------
;  THE FIVE BUFFERS A DRAW NEEDS, AND WHAT EACH IS FOR
; ----------------------------------------------------------------------
;
;   1. THE BIN CONTROL LIST. Read by the CLE's thread 0. Configures
;      the binner and, for a draw, carries the geometry state and the
;      primitives. For a clear it carries no primitives at all.
;
;   2. THE TILE ALLOCATION POOL (CT0QMA/CT0QMS). The binner writes a
;      per-tile command list into it, one chained list per tile, and
;      it allocates out of this pool as it goes. Its size is COMPUTED,
;      not chosen: v3dx_draw.c:60-76.
;
;   3. THE TILE STATE BUFFER (CT0QTS). 256 bytes per tile
;      (v3dx_draw.c:80). Nothing on this disk says what is in it; the
;      hardware owns it. The only thing a driver does is allocate it
;      and hand over its address.
;
;   4. THE GENERIC TILE LIST. A sub-list the render list branches to
;      once per tile. It is a SEPARATE buffer from the render list
;      because the render list holds a pointer to its start AND its
;      end (START_ADDRESS_OF_GENERIC_TILE_LIST, packet 20) and then
;      goes on emitting supertile coordinates after it.
;
;   5. THE RENDER CONTROL LIST. Read by the CLE's thread 1.
;
;   Plus, for a draw and not for a clear: the shader state record, the
;   attribute records, the vertex data, the uniform streams and the
;   QPU programs themselves.
;
; ----------------------------------------------------------------------
;  THE THING THAT WILL BITE, AND IT IS NOT THE PACKETS
; ----------------------------------------------------------------------
;
;  THE CLE READS AHEAD PAST THE END OF A CONTROL LIST. v3d_cl.c:69-75
;  says it in as many words - "The last V3D_CLE_READAHEAD bytes of the
;  buffer are unusable" - and v3d_device_info.c:76 gives the number
;  for V3D 4.2: 256 BYTES. Mesa subtracts it from every control-list
;  buffer's usable size and never lets a list start within it.
;
;  BEHIND THE V3D MMU WITH PT_INVALID_ABORT SET - which is how
;  V3dMmuInit() programs it, on purpose, so that a stray address
;  faults and names itself - a readahead that runs off the end of the
;  last mapped page IS A PAGE FAULT. The list would be complete and
;  correct and the job would abort anyway, and MMU_VIO_ADDR would name
;  an address 256 bytes past the end of a list that looks perfect.
;
;  So V3dClFinish() REFUSES a list that does not leave 256 bytes of
;  its own buffer unused after its last byte, and the caller is
;  expected to have mapped the whole buffer. That is a refusal and not
;  a silent truncation because the alternative failure is invisible.
;
;  THE SECOND ONE IS ALIGNMENT AND IT IS ALREADY WRITTEN DOWN.
;  Control-list packets are a one-byte opcode followed by a payload,
;  so almost every multi-byte field in a control list is UNALIGNED.
;  With the ARM MMU off every access is Device-nGnRnE and an unaligned
;  32-bit store is an Alignment fault regardless of SCTLR.A - a
;  runaway with no exception vector, no message and no partial line.
;  That cost a session on 2026-08-27 in cyw43.pi4 and the fix there
;  was a byte-wise writer. THE CONTROL LIST WRITER BELOW IS BYTE-WISE
;  FOR EXACTLY THAT REASON. Every emitter goes through v3d_ClU8().
;  Writing a packet with PokeN would work on three quarters of the
;  packets and kill the board on the rest, which is the worst possible
;  distribution.
;
; ----------------------------------------------------------------------
;  WHAT IS DELIBERATELY ABSENT, each with the reason Mesa gives
; ----------------------------------------------------------------------
;
;   * LOAD_TILE_BUFFER_GENERAL (packet 30). v3d_rcl_emit_loads
;     (v3dx_rcl.c:166-215) emits one per buffer in job->load, and for
;     a job that clears rather than preserving, job->load is zero and
;     the function emits only END_OF_LOADS. A render that must read
;     the existing contents of its target needs this packet; nothing
;     at stage 3 does, and an encoder nothing calls is an encoder
;     nothing checks.
;   * The whole depth/stencil path. No zsbuf means
;     TILE_RENDERING_MODE_CFG_COMMON must set early_z_disable - Mesa
;     asserts exactly that at v3dx_rcl.c:661 - and no Z store, no Z
;     load, no Z clear beyond the value word the packet carries
;     anyway.
;   * MULTISAMPLE. job->msaa false everywhere here. It changes the
;     tile size (v3d_util.c:185-186), the decimate mode and the
;     internal layout of the tile buffer.
;   * DOUBLE BUFFER. V3D_DBG(DOUBLE_BUFFER) is a Mesa debug option
;     (v3d_job.c:379) and is off by default. It is what makes
;     do_double_initial_tile_clear() (v3dx_rcl.c:484-497) emit the
;     second clear, so with it off the two-iteration GFXH-1742 loop
;     clears on the first iteration only.
;   * More than one render target. Everything is written for RT0.
;   * LAYERS beyond one, and therefore the tile_alloc layer offset
;     (v3dx_rcl.c:507-508) is always zero here.
;   * The GMP. v3d-feasibility.md:186-193 and the kernel agree: the
;     kernel uses the MMU and never programs the GMP, and only the
;     simulator reloads it (v3dx_simulator.c:517).
;   * OCCLUSION QUERIES, transform feedback, primitive counters.
;
; ----------------------------------------------------------------------
;  CACHE MAINTENANCE FOR THE TILE-BUFFER STORE PATH - AND THIS IS THE
;  ANSWER TO THE QUESTION THE CSD RUN RAISED, QUOTED RATHER THAN
;  REASONED
; ----------------------------------------------------------------------
;
;  Stage 2 learned the hard way that a TMU write sits in the core's
;  write combiner and L2T and does not reach DRAM until something
;  cleans it. The obvious worry is that the TILE BUFFER STORE - which
;  is a completely different write path - has the same problem, and
;  that a render could complete with the target buffer still full of
;  poison for the same reason with a different cause.
;
;  IT DOES NOT, AND THE KERNEL'S OWN UAPI HEADER SAYS SO.
;  v3d_drm.h:143-149, describing struct drm_v3d_submit_cl:
;
;     "The L1T, slice, L2C, L2T, and GCA caches will be flushed before
;      each CL executes. The VCD cache should be flushed (if
;      necessary) by the submitted CLs. THE TLB WRITES ARE GUARANTEED
;      TO HAVE BEEN FLUSHED BY THE TIME THE RENDER DONE IRQ HAPPENS,
;      which is the trigger for out_sync. Any dirtying of cachelines
;      by the job (ONLY POSSIBLE USING TMU WRITES) must be flushed by
;      the caller using the DRM_V3D_SUBMIT_CL_FLUSH_CACHE_FLAG flag."
;
;  Two claims in one paragraph, and both matter here:
;    - the tile-buffer (TLB) store needs no clean at all, and the
;      render-done event is the point at which that is true;
;    - the ONLY way a CL job can leave dirty cachelines is a TMU
;      write, which is what a fragment shader doing an image store
;      would do and what nothing at stage 3 does.
;
;  The kernel acts on it: v3d_job_submit sets
;  DRM_V3D_SUBMIT_CL_FLUSH_CACHE only when job->tmu_dirty_rcl
;  (v3d_job.c:576-577), and that flag is what makes the kernel append
;  a whole extra CACHE_CLEAN job (v3d_submit.c:957-971,
;  v3d_sched.c:633-646) running the same v3d_clean_caches this file
;  already has.
;
;  SO WHY DOES V3dRenderWait() CLEAN ANYWAY? Because the cost of being
;  wrong is asymmetric and the cost of the clean is not. FLM_CLEAN
;  writes dirty lines out and leaves them valid - v3d_regs.h:259-261,
;  "Writes out dirty cachelines and marks them clean" - so it CANNOT
;  lose data the way FLM_FLUSH could. It costs two register writes and
;  two bounded spins. Against that: if the guarantee is tied to the
;  IRQ and this file polls RFC instead, and those two are not the same
;  instant, the symptom is a buffer of poison after a job that says it
;  succeeded, which is precisely the shape of failure that cost a
;  bench run at stage 2. The clean is recorded separately and reported
;  through V3dRenderCleanResult() so that a reader can see that it ran
;  and can see whether it changed anything.
;
;  NOT CLEANING WOULD ALSO HAVE BEEN DEFENSIBLE. It is written here
;  rather than argued in a commit message so the next person can
;  reverse it knowingly.
;
; ----------------------------------------------------------------------
;  THE OUT-OF-MEMORY PROTOCOL IS LIVE AND IT IS NOT OPTIONAL
; ----------------------------------------------------------------------
;
;  The binner allocates tile lists out of the pool as it bins, and
;  when the pool runs out it raises CTL_INT_STS.OUTOMEM and STOPS.
;  v3d_irq.c:92-98 carries the sentence that makes this mandatory
;  rather than an optimisation:
;
;     "as of V3D 4.1, FLDONE won't be reported until any OOM state has
;      been cleared."
;
;  So a bin job that goes OOM never reports done. A wait loop that
;  only polls BFC would spin to its deadline and report a timeout, and
;  the register that says why is one the loop never read. V3dBinWait()
;  therefore polls OUTOMEM as well and, if it fires, hands the binner
;  the overflow pool the caller registered with V3dBinOverflow() by
;  writing PTB_BPOA then PTB_BPOS (v3d_irq.c:73-74), clears the
;  interrupt and carries on.
;
;  AND V3dBinSubmit() WRITES PTB_BPOS = 0 FIRST, every time, which is
;  the kernel's own first act in v3d_bin_job_run (v3d_sched.c:196)
;  with the comment "Clear out the overflow allocation, so we don't
;  reuse the overflow attached to a previous job."
;
;  HONESTY ABOUT THIS PATH: with a pool sized the way v3dx_draw.c:60-76
;  sizes it, OOM does not happen for the frames stage 3 draws, so the
;  service path is written and UNEXERCISED unless a diagnostic
;  deliberately starves it. V3dBinOomCount() exists so that a run can
;  say which of those two it was, and a claim that the protocol works
;  is only worth making after a run where that counter is non-zero.
; ======================================================================


; ======================================================================
;  THE CLE REGISTERS - core 0 offsets, from linux/v3d_regs.h:283-321
;
;  THERE ARE TWO CONTROL LIST THREADS AND THEY ARE NOT INTERCHANGEABLE.
;  Thread 0 is the BINNER and thread 1 is the RENDERER; the register
;  names carry the number and the kernel writes CT0* for the bin job
;  (v3d_sched.c:216-227) and CT1* for the render job (:275-276).
; ======================================================================

#V3D_CLE_CT0CS = $00100        ; v3d_regs.h:284 - thread 0 status
#V3D_CLE_CT1CS = $00104        ; v3d_regs.h:285
#V3D_CLE_CT0EA = $00108        ; v3d_regs.h:287 - end address, live
#V3D_CLE_CT1EA = $0010C        ; v3d_regs.h:288
#V3D_CLE_CT0CA = $00110        ; v3d_regs.h:290 - current address
#V3D_CLE_CT1CA = $00114        ; v3d_regs.h:291
#V3D_CLE_CT0RA = $00118        ; v3d_regs.h:293 - return address
#V3D_CLE_CT1RA = $0011C        ; v3d_regs.h:294
#V3D_CLE_CT0LC = $00120        ; v3d_regs.h:296 - list counter
#V3D_CLE_CT1LC = $00124        ; v3d_regs.h:297
#V3D_CLE_CT0PC = $00128        ; v3d_regs.h:298 - primitive list counter
#V3D_CLE_CT1PC = $0012C        ; v3d_regs.h:299
#V3D_CLE_PCS   = $00130        ; v3d_regs.h:300 - pipeline control status

; THE TWO COMPLETION COUNTERS. v3dx_simulator.c:507-512 samples both
; BEFORE submission and :535-547 spins until each CHANGES - not until
; it is greater, which matters because these are narrow counters that
; wrap.
;
; THEIR FIELD WIDTHS ARE NOT ON THIS DISK. The simulator masks with
; V3D_CLE_0_BFC_BMFCT_SET, which comes from the closed Broadcom
; v3d_hw.h that Reference/README.md records as not fetchable, and
; v3d_regs.h defines no field for either register. So this file
; compares the WHOLE register for inequality, which is a superset of
; the simulator's test: it can only ever be MORE eager to declare
; completion, never less. A second, independent witness is recorded
; on every wait - CT0CA reaching CT0EA, and CTL_INT_STS - so that a
; disagreement between them is visible in the log rather than hidden
; behind a verdict.
#V3D_CLE_BFC = $00134          ; v3d_regs.h:301 - bin frames complete
#V3D_CLE_RFC = $00138          ; v3d_regs.h:302 - render frames complete

#V3D_CLE_TFBC = $0013C         ; v3d_regs.h:303
#V3D_CLE_TFIT = $00140         ; v3d_regs.h:304

; THE QUEUE REGISTERS. Writing the END address is what starts a job -
; v3d_sched.c:214-215, "Set the current and end address of the control
; list. Writing the end register is what starts the job."
#V3D_CLE_CT0QTS = $0015C       ; v3d_regs.h:311 - tile state buffer
#V3D_CLE_CT0QTS_ENABLE = 2     ; BIT(1), v3d_regs.h:312
#V3D_CLE_CT0QBA = $00160       ; v3d_regs.h:313 - bin list base
#V3D_CLE_CT1QBA = $00164       ; v3d_regs.h:314 - render list base
#V3D_CLE_CT0QEA = $00168       ; v3d_regs.h:316 - bin list end
#V3D_CLE_CT1QEA = $0016C       ; v3d_regs.h:317 - render list end
#V3D_CLE_CT0QMA = $00170       ; v3d_regs.h:319 - tile alloc address
#V3D_CLE_CT0QMS = $00174       ; v3d_regs.h:320 - tile alloc size

; THE PRIMITIVE TILE BINNER's pool registers. BPOA and BPOS are the
; overflow hand-over the OOM protocol uses; BPCA and BPCS are the
; current allocation and are read-only evidence here.
#V3D_PTB_BPCA = $00300         ; v3d_regs.h:331
#V3D_PTB_BPCS = $00304         ; v3d_regs.h:332
#V3D_PTB_BPOA = $00308         ; v3d_regs.h:333
#V3D_PTB_BPOS = $0030C         ; v3d_regs.h:334

; CORE 0 INTERRUPT STATUS BITS. Only OUTOMEM is acted on; the rest are
; decoded here so that a printed CTL_INT_STS can be read without
; opening v3d_regs.h.
#V3D_CTL_INT_SET     = $00054  ; v3d_regs.h:268
#V3D_CTL_INT_MSK_STS = $0005C  ; v3d_regs.h:270
#V3D_CTL_INT_MSK_SET = $00060  ; v3d_regs.h:271 - SET a bit to MASK it
#V3D_CTL_INT_MSK_CLR = $00064  ; v3d_regs.h:272 - CLEAR a bit to UNMASK
#V3D_CTL_INT_GMPV     = 32     ; BIT(5), v3d_regs.h:277
#V3D_CTL_INT_TRFB     = 16     ; BIT(4), v3d_regs.h:278
#V3D_CTL_INT_SPILLUSE = 8      ; BIT(3), v3d_regs.h:279
#V3D_CTL_INT_OUTOMEM  = 4      ; BIT(2), v3d_regs.h:280
#V3D_CTL_INT_FLDONE   = 2      ; BIT(1), v3d_regs.h:281 - bin done
#V3D_CTL_INT_FRDONE   = 1      ; BIT(0), v3d_regs.h:282 - render done


; ======================================================================
;  THE PACKET OPCODES - mesa/v3d_packet.xml, the `code` attribute
;
;  Only the packets this file can emit are listed. The XML declares 99
;  and naming the other 78 here would suggest they were considered.
; ======================================================================

#V3D_PKT_HALT                  = 0    ; v3d_packet.xml:328
#V3D_PKT_NOP                   = 1    ; :329
#V3D_PKT_FLUSH                 = 4    ; :330
#V3D_PKT_FLUSH_ALL_STATE       = 5    ; :331
#V3D_PKT_START_TILE_BINNING    = 6    ; :332
#V3D_PKT_END_OF_RENDERING      = 13   ; :339
#V3D_PKT_BRANCH                = 16   ; :349
#V3D_PKT_RETURN_FROM_SUB_LIST  = 18   ; :357
#V3D_PKT_FLUSH_VCD_CACHE       = 19   ; :358
#V3D_PKT_GENERIC_TILE_LIST     = 20   ; :360
#V3D_PKT_BRANCH_IMPLICIT_TILE  = 21   ; :365
#V3D_PKT_SUPERTILE_COORDS      = 23   ; :376
#V3D_PKT_CLEAR_TILE_BUFFERS    = 25   ; :381
#V3D_PKT_END_OF_LOADS          = 26   ; :388
#V3D_PKT_END_OF_TILE_MARKER    = 27   ; :390
#V3D_PKT_STORE_TILE_BUFFER_GEN = 29   ; :392
#V3D_PKT_VERTEX_ARRAY_PRIMS    = 36   ; :508
#V3D_PKT_SET_INSTANCEID        = 54   ; :550
#V3D_PKT_PRIM_LIST_FORMAT      = 56   ; :558
#V3D_PKT_GL_SHADER_STATE       = 64   ; :576
#V3D_PKT_VCM_CACHE_SIZE        = 71   ; :596
#V3D_PKT_BLEND_ENABLES         = 83   ; :674
#V3D_PKT_BLEND_CFG             = 84   ; :678, the max_ver="42" arm
#V3D_PKT_COLOR_WRITE_MASKS     = 87   ; :705
#V3D_PKT_ZERO_ALL_CENTROID     = 88   ; :709
#V3D_PKT_SAMPLE_STATE          = 91   ; :718
#V3D_PKT_OCCLUSION_QUERY_CTR   = 92   ; :723
#V3D_PKT_CFG_BITS              = 96   ; :732
#V3D_PKT_ZERO_ALL_FLATSHADE    = 97   ; :769
#V3D_PKT_ZERO_ALL_NONPERSP     = 99   ; :778
#V3D_PKT_NONPERSP_FLAGS        = 100  ; :781, the set-a-mask form of 99
#V3D_PKT_POINT_SIZE            = 104  ; :787
#V3D_PKT_LINE_WIDTH            = 105  ; :791
#V3D_PKT_CLIP_WINDOW           = 107  ; :801
#V3D_PKT_VIEWPORT_OFFSET       = 108  ; :808
#V3D_PKT_CLIPPER_Z_MINMAX      = 109  ; :815
#V3D_PKT_CLIPPER_XY_SCALING    = 110  ; :820
#V3D_PKT_CLIPPER_Z_SCALE_OFF   = 111  ; :830
#V3D_PKT_NUMBER_OF_LAYERS      = 119  ; :840
#V3D_PKT_TILE_BINNING_MODE_CFG = 120  ; :844
#V3D_PKT_TILE_RENDER_MODE_CFG  = 121  ; :897 and the five sub-ids
#V3D_PKT_MULTICORE_SUPERTILE   = 122  ; :1065
#V3D_PKT_MULTICORE_TILE_LIST   = 123  ; :1080
#V3D_PKT_TILE_COORDINATES      = 124  ; :1060
#V3D_PKT_TILE_COORDS_IMPLICIT  = 125  ; :1086
#V3D_PKT_TILE_LIST_INIT_BLOCK  = 126  ; :1088

; THE FIVE SUB-IDS OF PACKET 121. One opcode, five different payloads,
; distinguished by a four-bit field at bit 0 whose value the XML gives
; as the field's `default` (v3d_packet.xml:923, :983, :992, :1010,
; :1050). Getting one wrong writes a plausible word into the wrong
; configuration and is not detectable from any status register, which
; is why they are named rather than written inline.
;
; AND THEIR ORDER IN THE LIST IS PART OF THE INTERFACE. v3dx_rcl.c's
; comment at :630-632: "Common config must be the first
; TILE_RENDERING_MODE_CFG and Z_STENCIL_CLEAR_VALUES must be last. The
; ones in between are optional updates to the previous HW state."
#V3D_TRMC_COMMON       = 0    ; v3d_packet.xml:923
#V3D_TRMC_COLOR        = 1    ; :983
#V3D_TRMC_ZS_CLEAR     = 2    ; :992
#V3D_TRMC_CLEAR_COL1   = 3    ; :1010
#V3D_TRMC_CLEAR_COL2   = 4    ; :1032
#V3D_TRMC_CLEAR_COL3   = 5    ; :1050

; Buffer selectors for STORE/LOAD_TILE_BUFFER_GENERAL, v3d_packet.xml
; :413-426. NONE is the one the GFXH-1742 dummy stores use.
#V3D_BUF_RT0     = 0
#V3D_BUF_RT1     = 1
#V3D_BUF_RT2     = 2
#V3D_BUF_RT3     = 3
#V3D_BUF_NONE    = 8
#V3D_BUF_Z       = 9
#V3D_BUF_STENCIL = 10
#V3D_BUF_ZS      = 11

; Memory Format, v3d_packet.xml:108-115. Numerically identical to
; enum v3d_tiling_mode - Reference/mesa-24.3.4_v3d_tiling.h:44-63 -
; because v3dx_rcl.c:59 and :123 assign one straight into the other
; with no translation.
#V3D_MEMFMT_RASTER      = 0
#V3D_MEMFMT_LINEARTILE  = 1
#V3D_MEMFMT_UBLINEAR_1  = 2
#V3D_MEMFMT_UBLINEAR_2  = 3
#V3D_MEMFMT_UIF_NO_XOR  = 4
#V3D_MEMFMT_UIF_XOR     = 5

; Output Image Format, v3d_packet.xml:222-285. Only the ones a 32-bit
; colour target can use are named; the enum has 45 values on 4.2.
#V3D_OFMT_SRGB8_ALPHA8 = 0    ; :227
#V3D_OFMT_BGR565       = 7    ; :234
#V3D_OFMT_RGBA8        = 27   ; :254
#V3D_OFMT_RGB8         = 28   ; :255
#V3D_OFMT_S8           = 44   ; :269

; Internal Type, v3d_packet.xml:123-133, and Internal BPP, :135-139.
#V3D_ITYPE_8I  = 0
#V3D_ITYPE_8UI = 1
#V3D_ITYPE_8   = 2
#V3D_ITYPE_16F = 6
#V3D_ITYPE_32F = 10
#V3D_IBPP_32   = 0
#V3D_IBPP_64   = 1
#V3D_IBPP_128  = 2

; Render Target Clamp, v3d_packet.xml:147-152. 4.2 only; 7.1 merges
; clamp and type into one field.
#V3D_RTCLAMP_NONE = 0
#V3D_RTCLAMP_NORM = 1
#V3D_RTCLAMP_POS  = 2
#V3D_RTCLAMP_INT  = 3

; Decimate Mode, v3d_packet.xml:117-121. SAMPLE_0 is the non-MSAA
; value and the only one used here.
#V3D_DECIMATE_SAMPLE0 = 0
#V3D_DECIMATE_4X      = 1
#V3D_DECIMATE_ALL     = 3

; Primitive types for PRIM_LIST_FORMAT, v3d_packet.xml:561-563. The
; binner "starts out writing tiles assuming that the initial mode is
; triangles" (v3dx_rcl.c:335-337), which is why the generic tile list
; sets it explicitly rather than relying on that.
#V3D_PLF_POINTS    = 0
#V3D_PLF_LINES     = 1
#V3D_PLF_TRIANGLES = 2

; The Primitive enum for VERTEX_ARRAY_PRIMS's `mode`,
; v3d_packet.xml:55-70.
#V3D_PRIM_POINTS         = 0
#V3D_PRIM_LINES          = 1
#V3D_PRIM_LINE_LOOP      = 2
#V3D_PRIM_LINE_STRIP     = 3
#V3D_PRIM_TRIANGLES      = 4
#V3D_PRIM_TRIANGLE_STRIP = 5
#V3D_PRIM_TRIANGLE_FAN   = 6

; Tile allocation block sizes, v3d_packet.xml:856-865 and :1091-1095.
; 64 bytes is the value Mesa uses everywhere -
; TILE_ALLOCATION_BLOCK_SIZE_64B at v3dx_rcl.c:839 - and the 64 in
; v3dx_draw.c:61's `draw_tiles_x * draw_tiles_y * 64` is the same
; number: one initial block per tile.
#V3D_TILE_BLOCK_64B  = 0
#V3D_TILE_BLOCK_128B = 1
#V3D_TILE_BLOCK_256B = 2

; v3d_cl.c:69-75 and v3d_device_info.c:76. See the header.
#V3D_CLE_READAHEAD = 256

; v3dx_draw.c:80 - `uint32_t tsda_per_tile_size = 256;`
#V3D_TILE_STATE_PER_TILE = 256

; v3dx_rcl.c:515 - `const uint32_t max_supertiles = 256;`
#V3D_MAX_SUPERTILES = 256

; New error codes. They continue the numbering rather than reusing a
; general one because a caller that prints the number should not have
; to guess which stage produced it.
#V3D_ERR_CL_ARGS     = 27  ; a packet field will not fit its width, a
                           ; buffer is unusable, a geometry is not
                           ; expressible
#V3D_ERR_CL_FULL     = 28  ; the list ran out of buffer, INCLUDING the
                           ; 256 bytes of CLE readahead slack
#V3D_ERR_CL_NOBUF    = 29  ; a packet emitted with no V3dClBegin()
#V3D_ERR_BIN_TIMEOUT = 30  ; CLE_BFC never changed
#V3D_ERR_BIN_OOM     = 31  ; the binner went OOM and no overflow pool
                           ; had been registered - see V3dBinOverflow()
#V3D_ERR_RENDER_TIMEOUT = 32 ; CLE_RFC never changed
#V3D_ERR_JOB_BUSY    = 33  ; a CLE thread was already running


; ======================================================================
;  THE CONTROL LIST WRITER
;
;  A cursor over caller-supplied memory. One list is open at a time,
;  which is enough because the three lists a job needs are built in
;  dependency order - the generic tile list before the render list
;  that points at it, and either before submission.
;
;  IT IS BYTE-WISE AND THAT IS NOT A STYLE CHOICE. See the section
;  header: an unaligned 32-bit store with the ARM MMU off is a fatal
;  Alignment fault with no message, and a control list is a stream of
;  unaligned fields by construction. cyw43.pi4's cyw43_PutLE32 is the
;  established pattern in this tree and this is the same pattern.
;
;  ERRORS ACCUMULATE RATHER THAN BEING RETURNED PER PACKET, and this
;  is the one place this file departs from the house habit of checking
;  every call. A render list is thirty packets; thirty four-line
;  `If r <> #V3D_OK` blocks would be four times the length of the
;  thing they guard and the reader would stop seeing the list. So an
;  emitter that cannot encode its arguments sets v3d_clErr and STOPS
;  WRITING - it does not write a wrong packet and carry on - and
;  V3dClFinish() returns the first error that happened. The list is
;  never submitted without a V3dClFinish(), because V3dBinSubmit() and
;  V3dRclBuild() both refuse a list that did not finish clean.
; ======================================================================

Global v3d_clBase.i  = 0    ; where the open list starts
Global v3d_clCap.i   = 0    ; how many bytes it may use in total
Global v3d_clPos.i   = 0    ; bytes written so far
Global v3d_clErr.i   = #V3D_OK
Global v3d_clOpen.i  = 0

; The finished lists, remembered so submission needs no arguments and
; cannot be handed the wrong pair.
Global v3d_bclStart.i = 0
Global v3d_bclEnd.i   = 0
Global v3d_rclStart.i = 0
Global v3d_rclEnd.i   = 0
Global v3d_tlStart.i  = 0
Global v3d_tlEnd.i    = 0

; ----------------------------------------------------------------------
;  V3dClBegin - open a list at `addr` with `bytes` of room.
;
;  `bytes` is the WHOLE buffer including the CLE readahead slack, not
;  the usable part. That is deliberate: the caller knows how much
;  memory it mapped, and asking it to subtract 256 itself is asking it
;  to remember a number whose absence is invisible.
; ----------------------------------------------------------------------
Procedure.i V3dClBegin(addr.i, bytes.i)
  v3d_clOpen = 0
  v3d_clBase = 0
  v3d_clCap  = 0
  v3d_clPos  = 0
  v3d_clErr  = #V3D_OK

  If addr <= 0
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf
  ; A list must be able to hold at least one packet AND the readahead.
  If bytes <= #V3D_CLE_READAHEAD
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf

  v3d_clBase = addr
  v3d_clCap  = bytes
  v3d_clOpen = 1
  ProcedureReturn #V3D_OK
EndProcedure

; ----------------------------------------------------------------------
;  The three primitives every emitter goes through. All little-endian
;  and all byte-wise.
;
;  A WRITE PAST THE END DOES NOT HAPPEN. v3d_ClU8 checks against the
;  USABLE size - capacity minus the readahead - so a list can never be
;  built into the slack and then discovered at Finish time. Detecting
;  it at the byte that would have crossed is what names the packet
;  that overflowed rather than the list that did.
; ----------------------------------------------------------------------
Procedure v3d_ClU8(v.i)
  If v3d_clOpen = 0
    If v3d_clErr = #V3D_OK
      v3d_clErr = #V3D_ERR_CL_NOBUF
    EndIf
    ProcedureReturn
  EndIf
  If v3d_clErr <> #V3D_OK
    ProcedureReturn
  EndIf
  If (v3d_clPos + 1) > (v3d_clCap - #V3D_CLE_READAHEAD)
    v3d_clErr = #V3D_ERR_CL_FULL
    ProcedureReturn
  EndIf
  PokeA(v3d_clBase + v3d_clPos, v & $FF)
  v3d_clPos = v3d_clPos + 1
EndProcedure

Procedure v3d_ClU16(v.i)
  v3d_ClU8(v)
  v3d_ClU8(v >> 8)
EndProcedure

Procedure v3d_ClU32(v.i)
  v3d_ClU8(v)
  v3d_ClU8(v >> 8)
  v3d_ClU8(v >> 16)
  v3d_ClU8(v >> 24)
EndProcedure

; ----------------------------------------------------------------------
;  V3dClFinish - close the list and check it.
;
;  Returns #V3D_OK or the FIRST error any emitter hit.
;
;  THE READAHEAD CHECK BELOW IS A BACKSTOP AND IT CANNOT FIRE TODAY,
;  and saying so is better than leaving a reader to work it out.
;  v3d_ClU8() already refuses any byte that would take the cursor past
;  `cap - #V3D_CLE_READAHEAD`, so by the time execution reaches here
;  `v3d_clPos + #V3D_CLE_READAHEAD <= v3d_clCap` is guaranteed. The
;  gate's mutation run proved it: deleting this condition kills no
;  test, because the refusal that actually happens is v3d_ClU8's.
;
;  IT STAYS, for one reason: it is the only check that would still
;  catch a future emitter that wrote bytes some other way - a bulk
;  copy, a memmove, an emitter that advanced v3d_clPos itself. Every
;  emitter goes through v3d_ClU8 today and none of them has to
;  forever. A backstop that is labelled as unreachable is honest; one
;  that is described as doing work it does not do is the beginning of
;  a wrong belief about where the guard lives.
; ----------------------------------------------------------------------
Procedure.i V3dClFinish()
  If v3d_clOpen = 0
    v3d_err = #V3D_ERR_CL_NOBUF
    ProcedureReturn #V3D_ERR_CL_NOBUF
  EndIf
  If v3d_clErr <> #V3D_OK
    v3d_err = v3d_clErr
    ProcedureReturn v3d_clErr
  EndIf
  If (v3d_clPos + #V3D_CLE_READAHEAD) > v3d_clCap
    v3d_clErr = #V3D_ERR_CL_FULL
    v3d_err   = #V3D_ERR_CL_FULL
    ProcedureReturn #V3D_ERR_CL_FULL
  EndIf
  ProcedureReturn #V3D_OK
EndProcedure

Procedure.i V3dClAddr()
  ProcedureReturn v3d_clBase
EndProcedure

Procedure.i V3dClLen()
  ProcedureReturn v3d_clPos
EndProcedure

; THE END ADDRESS IS THE FIRST BYTE AFTER THE LIST, not the last byte
; of it. v3d_drm.h:165 - "End address of the BCL (first byte after the
; BCL)". An off-by-one here runs the CLE one packet short or one
; packet long, and one packet long means executing whatever was in
; memory next.
Procedure.i V3dClEndAddr()
  ProcedureReturn v3d_clBase + v3d_clPos
EndProcedure

Procedure.i V3dClError()
  ProcedureReturn v3d_clErr
EndProcedure


; ======================================================================
;  THE PACKET ENCODERS
;
;  ONE PROCEDURE PER PACKET, NAMED FOR THE PACKET, AND NOTHING CLEVER.
;  Each one writes its opcode byte and then its payload, little-endian,
;  in the bit layout v3d_packet.xml gives. The bit numbers in the
;  comments are the XML's OWN `start` values, which are counted from
;  the first bit AFTER the opcode - v3d_decoder.c:512-518 shifts them
;  up by eight when it parses, and this file writes the opcode
;  separately, so the XML numbers can be used unchanged.
;
;  THE LENGTH OF EVERY PACKET IS DERIVED, NOT LOOKED UP.
;  v3d_group_get_length (v3d_decoder.c:728-738) is `last_bit / 8 + 1`
;  over the SHIFTED field ends, i.e. one opcode byte plus enough bytes
;  to cover the highest bit any field touches. Each encoder below
;  writes exactly that many bytes and the comment states the number so
;  a reader can check it against the XML without running anything.
;
;  A FIELD THAT WILL NOT FIT IS A REFUSAL, NOT A TRUNCATION. Masking a
;  too-large value produces a plausible packet that draws the wrong
;  thing, and nothing downstream can tell. Every encoder that has a
;  narrow field checks it.
; ======================================================================

; --- 1 byte each, no payload -----------------------------------------
Procedure V3dClNop()
  v3d_ClU8(#V3D_PKT_NOP)
EndProcedure

Procedure V3dClHalt()
  v3d_ClU8(#V3D_PKT_HALT)
EndProcedure

; v3dx_job.c:69 - the entire bin-list epilogue for a job with no
; transform feedback is this one packet. Its comment (:64-67): "We
; just FLUSH here to tell the HW to cap the bin CLs with a return."
Procedure V3dClFlush()
  v3d_ClU8(#V3D_PKT_FLUSH)
EndProcedure

Procedure V3dClStartTileBinning()
  v3d_ClU8(#V3D_PKT_START_TILE_BINNING)
EndProcedure

Procedure V3dClEndOfRendering()
  v3d_ClU8(#V3D_PKT_END_OF_RENDERING)
EndProcedure

Procedure V3dClReturnFromSubList()
  v3d_ClU8(#V3D_PKT_RETURN_FROM_SUB_LIST)
EndProcedure

Procedure V3dClFlushVcdCache()
  v3d_ClU8(#V3D_PKT_FLUSH_VCD_CACHE)
EndProcedure

Procedure V3dClEndOfLoads()
  v3d_ClU8(#V3D_PKT_END_OF_LOADS)
EndProcedure

Procedure V3dClEndOfTileMarker()
  v3d_ClU8(#V3D_PKT_END_OF_TILE_MARKER)
EndProcedure

Procedure V3dClTileCoordsImplicit()
  v3d_ClU8(#V3D_PKT_TILE_COORDS_IMPLICIT)
EndProcedure

Procedure V3dClZeroAllFlatShadeFlags()
  v3d_ClU8(#V3D_PKT_ZERO_ALL_FLATSHADE)
EndProcedure

Procedure V3dClZeroAllNonperspFlags()
  v3d_ClU8(#V3D_PKT_ZERO_ALL_NONPERSP)
EndProcedure

Procedure V3dClZeroAllCentroidFlags()
  v3d_ClU8(#V3D_PKT_ZERO_ALL_CENTROID)
EndProcedure

; ----------------------------------------------------------------------
;  V3dClNonperspFlags - declare which varyings are NOT interpolated
;  perspective correct. Packet 100, five bytes.
;
;  The zeroing packet above says "none of them"; this one names a set,
;  and a shader that reads a varying with a plain FADD against r5 - no
;  multiply by W - needs its varying in that set.
;
;  THE CONTROL BYTE IS $50 AND IT IS NOT A MAGIC NUMBER. The payload is
;  one control byte and a 24-bit flag field for one group of twenty-four
;  varyings. In the control byte the two high bit pairs are the actions
;  for the flags of the varyings ABOVE and BELOW this group, and the low
;  nibble is the group's own offset; $50 is therefore "zero everything
;  outside this group, group zero", which is what a shader with a
;  handful of varyings wants. That exact byte, with a flag field of $03,
;  is what this tree's own engine already emits for its two textured
;  varyings and has run on this board - RaspberryPi4/Lib/neon.pi4,
;  neon_TexNonpersp - so the byte is carried over verbatim and only the
;  flag field is generalised here.
; ----------------------------------------------------------------------
Procedure V3dClNonperspFlags(mask.i)
  If mask < 0 Or mask > $FFFFFF
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  v3d_ClU8(#V3D_PKT_NONPERSP_FLAGS)
  v3d_ClU8($50)
  v3d_ClU8(mask & $FF)
  v3d_ClU8((mask >> 8) & $FF)
  v3d_ClU8((mask >> 16) & $FF)
EndProcedure

; --- 2 bytes ----------------------------------------------------------

; v3d_packet.xml:365-367. One 8-bit field. The binner writes one tile
; list per SET and this selects which set the renderer branches into;
; with one core and one bin tile list it is always 0.
Procedure V3dClBranchToImplicitTileList(setNo.i)
  If setNo < 0 Or setNo > 255
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  v3d_ClU8(#V3D_PKT_BRANCH_IMPLICIT_TILE)
  v3d_ClU8(setNo)
EndProcedure

; v3d_packet.xml:381-384. Two bits.
;
; GFXH-1461/GFXH-1689 IS WHY BOTH BITS ARE HERE AND WHY THE Z ONE IS
; NOT WHAT IT SOUNDS LIKE. v3dx_rcl.c:299-303: "The per-buffer store
; command's clear buffer bit is broken for depth/stencil. In addition,
; the clear packet's Z/S bit is broken, but the RTs bit ends up
; clearing Z/S." So `clear_all_render_targets` is the bit that does
; the work and the Z/S bit is passed through as Mesa passes it -
; `!job->early_zs_clear` (:307) - rather than reasoned about.
Procedure V3dClClearTileBuffers(clearZs.i, clearAllRts.i)
  Protected b.i
  b = 0
  If clearZs <> 0
    b = b | 2
  EndIf
  If clearAllRts <> 0
    b = b | 1
  EndIf
  v3d_ClU8(#V3D_PKT_CLEAR_TILE_BUFFERS)
  v3d_ClU8(b)
EndProcedure

; v3d_packet.xml:558-565. `tri strip or fan` at bit 7, type at bit 0.
Procedure V3dClPrimListFormat(primType.i, stripOrFan.i)
  Protected b.i
  If primType < 0 Or primType > 63
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  b = primType & $3F
  If stripOrFan <> 0
    b = b | $80
  EndIf
  v3d_ClU8(#V3D_PKT_PRIM_LIST_FORMAT)
  v3d_ClU8(b)
EndProcedure

; v3d_packet.xml:840-842. minus_one: the field holds n-1.
;
; MESA EMITS THIS EVEN FOR A PLAIN NON-LAYERED FRAMEBUFFER, where
; num_layers is 1 and the field is therefore 0 - v3dx_draw.c:91-95,
; whose comment is "This must go before the binning mode
; configuration. It is required for layered framebuffers to work."
; Writing it unconditionally is what Mesa does and there is no
; evidence on this disk about what a 4.2 binner does without it, so
; this file does not experiment.
Procedure V3dClNumberOfLayers(n.i)
  If n < 1 Or n > 256
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  v3d_ClU8(#V3D_PKT_NUMBER_OF_LAYERS)
  v3d_ClU8(n - 1)
EndProcedure

; v3d_packet.xml:1088-1096.
;
; "Always set initial block size before the first branch, which needs
; to match the value from binning mode config" - v3dx_rcl.c:833-834.
; That is a CONSISTENCY REQUIREMENT between two packets in two
; different lists, and nothing checks it but the reader. V3dRclBuild()
; passes the same #V3D_TILE_BLOCK_64B that V3dBclBegin() wrote.
Procedure V3dClTileListInitialBlockSize(useAutoChained.i, sizeCode.i)
  Protected b.i
  If sizeCode < 0 Or sizeCode > 2
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  b = sizeCode & 3
  If useAutoChained <> 0
    b = b | 4
  EndIf
  v3d_ClU8(#V3D_PKT_TILE_LIST_INIT_BLOCK)
  v3d_ClU8(b)
EndProcedure

; v3d_packet.xml:596-599. Two nibbles.
Procedure V3dClVcmCacheSize(binBatches.i, renderBatches.i)
  If binBatches < 0 Or binBatches > 15
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If renderBatches < 0 Or renderBatches > 15
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  v3d_ClU8(#V3D_PKT_VCM_CACHE_SIZE)
  v3d_ClU8((binBatches & $F) | ((renderBatches & $F) << 4))
EndProcedure

; --- 3 bytes ----------------------------------------------------------

; v3d_packet.xml:376-379. Two 8-bit fields: column at 0, row at 8.
Procedure V3dClSupertileCoordinates(col.i, row.i)
  If col < 0 Or col > 255
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If row < 0 Or row > 255
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  v3d_ClU8(#V3D_PKT_SUPERTILE_COORDS)
  v3d_ClU8(col)
  v3d_ClU8(row)
EndProcedure

; --- 4 bytes ----------------------------------------------------------

; v3d_packet.xml:1060-1063. Two TWELVE-bit fields, column at 0 and row
; at 12, so the packet is three payload bytes and the row straddles a
; byte boundary. Written as a 24-bit value and split, which is why the
; writer is byte-wise.
Procedure V3dClTileCoordinates(col.i, row.i)
  Protected v.i
  If col < 0 Or col > 4095
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If row < 0 Or row > 4095
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  v = (col & $FFF) | ((row & $FFF) << 12)
  v3d_ClU8(#V3D_PKT_TILE_COORDINATES)
  v3d_ClU8(v)
  v3d_ClU8(v >> 8)
  v3d_ClU8(v >> 16)
EndProcedure

; v3d_packet.xml:732-748, the max_ver="42" form. Three payload bytes.
;
; EVERY BIT IS A BOOLEAN EXCEPT TWO, and the two that are not are
; named. This is the packet that decides whether a triangle is drawn
; at all: with both facing bits clear, every primitive is culled and
; the render is a clear with extra steps - which looks exactly like a
; shader that wrote nothing.
Procedure.i V3dCfgBitsWord(fwdFacing.i, revFacing.i, clockwise.i, depthFunc.i)
  Protected v.i
  v = 0
  If fwdFacing <> 0
    v = v | 1
  EndIf
  If revFacing <> 0
    v = v | 2
  EndIf
  If clockwise <> 0
    v = v | 4
  EndIf
  v = v | ((depthFunc & 7) << 12)
  ProcedureReturn v
EndProcedure

Procedure V3dClCfgBits(word.i)
  If (word & $FFFFFF) <> word
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  v3d_ClU8(#V3D_PKT_CFG_BITS)
  v3d_ClU8(word)
  v3d_ClU8(word >> 8)
  v3d_ClU8(word >> 16)
EndProcedure

; --- 5 bytes ----------------------------------------------------------

; v3d_packet.xml:723-725. One 32-bit address. Mesa emits it with the
; address left at zero to "Disable any leftover OQ state from another
; job" (v3dx_draw.c:133-134). A bare-metal caller has no leftover
; state, and it is emitted anyway because the block might.
Procedure V3dClOcclusionQueryCounter(addr.i)
  v3d_ClU8(#V3D_PKT_OCCLUSION_QUERY_CTR)
  v3d_ClU32(addr)
EndProcedure

; v3d_packet.xml:705-707. One 32-bit mask, four bits per render
; target.
;
; IT IS A DISABLE MASK AND ZERO MEANS WRITE EVERYTHING.
; translate_colormask (v3dx_emit.c:82-91) ends `return (~colormask) &
; 0xf`, so Gallium's "write R, G, B and A" becomes 0 here. That is
; also the packet's default, which is exactly why it is emitted
; anyway: the CLE's state persists between jobs on the same core, and
; a leftover mask from something else is a draw that runs perfectly
; and stores nothing. One packet against a failure that looks
; identical to a dead shader.
Procedure V3dClColorWriteMasks(mask.i)
  v3d_ClU8(#V3D_PKT_COLOR_WRITE_MASKS)
  v3d_ClU32(mask)
EndProcedure

; ----------------------------------------------------------------------
;  THE TWO BLEND PACKETS. Added 2026-08-28 for neon.pi4.
;
;  THIS IS THE ONE PIECE OF FIXED FUNCTION THAT JUSTIFIES PUTTING A UI
;  ON THE GPU AT ALL. Measured on this board, a full-surface alpha
;  blend costs the A72 2172.0 ms against a 25 ms budget - about 1815
;  cycles per blended pixel (pi4NeonLiar.pi4:256-262). Here it is free:
;  the blend happens in the tile buffer, and the overdraw of four
;  nested Neon_Glow rings never reaches DRAM at all.
;
;  MESA EMITS BOTH, INTO THE BIN LIST, AND ONLY WHEN A BLEND IS ON.
;  BLEND_ENABLES first, carrying the per-render-target mask
;  (v3dx_emit.c:484-487), then one BLEND_CFG per enabled target
;  (emit_rt_blend, v3dx_emit.c:104-124). CFG_BITS carries the master
;  switch at bit 19 - `config.blend_enable`, v3dx_emit.c:328 - and
;  this file deliberately does NOT fold that bit into these two
;  procedures, because V3dCfgBitsWord() belongs to the caller who also
;  chooses the cull and depth bits and a hidden side effect there
;  would be worse than a second line at the call site.
; ----------------------------------------------------------------------

; The blend factor enum, v3d_packet.xml:14-30. All of it, because a
; caller who can only name two of the sixteen will eventually want a
; third and will guess at its number.
#V3D_BF_ZERO            = 0
#V3D_BF_ONE             = 1
#V3D_BF_SRC_COLOR       = 2
#V3D_BF_INV_SRC_COLOR   = 3
#V3D_BF_DST_COLOR       = 4
#V3D_BF_INV_DST_COLOR   = 5
#V3D_BF_SRC_ALPHA       = 6
#V3D_BF_INV_SRC_ALPHA   = 7
#V3D_BF_DST_ALPHA       = 8
#V3D_BF_INV_DST_ALPHA   = 9
#V3D_BF_CONST_COLOR     = 10
#V3D_BF_INV_CONST_COLOR = 11
#V3D_BF_CONST_ALPHA     = 12
#V3D_BF_INV_CONST_ALPHA = 13
#V3D_BF_SRC_ALPHA_SAT   = 14

; The blend mode enum, v3d_packet.xml:32-42.
#V3D_BM_ADD     = 0
#V3D_BM_SUB     = 1
#V3D_BM_RSUB    = 2
#V3D_BM_MIN     = 3
#V3D_BM_MAX     = 4
#V3D_BM_MUL     = 5
#V3D_BM_SCREEN  = 6
#V3D_BM_DARKEN  = 7
#V3D_BM_LIGHTEN = 8

; v3d_packet.xml:674-676. Opcode 83, one payload byte, one bit per
; render target. Two bytes on the wire.
Procedure V3dClBlendEnables(mask.i)
  If mask < 0 Or mask > 255
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  v3d_ClU8(#V3D_PKT_BLEND_ENABLES)
  v3d_ClU8(mask)
EndProcedure

; v3d_packet.xml:678-686, the max_ver="42" arm - which is the arm this
; part reads. The min_ver="71" arm at :688-696 widens Render Target
; Mask from four bits to eight and is a DIFFERENT packet with the same
; opcode; encoding that one here would put the colour factors four
; bits away from where a 4.2 CLE looks for them.
;
;   Render Target Mask       4 @24
;   Color blend dst factor   4 @20
;   Color blend src factor   4 @16
;   Color blend mode         4 @12
;   Alpha blend dst factor   4 @8
;   Alpha blend src factor   4 @4
;   Alpha blend mode         4 @0
;
; Four payload bytes, five on the wire. Every field is REFUSED out of
; range rather than masked: a masked 16 would silently become ZERO,
; which is a legal factor, so the picture would come back black
; instead of the call coming back with an error.
Procedure V3dClBlendCfg(rtMask.i, colDst.i, colSrc.i, colMode.i, alphaDst.i, alphaSrc.i, alphaMode.i)
  Protected w.i
  If rtMask < 0 Or rtMask > 15
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If colDst < 0 Or colDst > 14 Or colSrc < 0 Or colSrc > 14
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If alphaDst < 0 Or alphaDst > 14 Or alphaSrc < 0 Or alphaSrc > 14
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If colMode < 0 Or colMode > 8 Or alphaMode < 0 Or alphaMode > 8
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  w = (rtMask << 24) | (colDst << 20) | (colSrc << 16) | (colMode << 12)
  w = w | (alphaDst << 8) | (alphaSrc << 4) | alphaMode
  v3d_ClU8(#V3D_PKT_BLEND_CFG)
  v3d_ClU32(w)
EndProcedure

; v3d_packet.xml:550-552. 32-bit.
; "PTB assumes that value to be 0, but hw will not set it" -
; v3dx_rcl.c:342-345. So it is not optional even when it is zero.
Procedure V3dClSetInstanceId(id.i)
  v3d_ClU8(#V3D_PKT_SET_INSTANCEID)
  v3d_ClU32(id)
EndProcedure

; v3d_packet.xml:787-789 and :791-793. A raw 32-bit float PATTERN, not
; a float: this library has no floating-point dependency and taking
; the bits lets the caller decide how it computed them.
Procedure V3dClPointSize(bits.i)
  v3d_ClU8(#V3D_PKT_POINT_SIZE)
  v3d_ClU32(bits)
EndProcedure

Procedure V3dClLineWidth(bits.i)
  v3d_ClU8(#V3D_PKT_LINE_WIDTH)
  v3d_ClU32(bits)
EndProcedure

; v3d_packet.xml:718-721. Coverage is an f187 and mask is four bits.
; Mesa emits mask 0xf for the default sample state.
Procedure V3dClSampleState(coverageF187.i, mask.i)
  Protected v.i
  If mask < 0 Or mask > 15
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  v = (mask & $F) | ((coverageF187 & $FFFF) << 16)
  v3d_ClU8(#V3D_PKT_SAMPLE_STATE)
  v3d_ClU32(v)
EndProcedure

; v3d_packet.xml:576-579. An address field of TWENTY-SEVEN bits at bit
; 5, so the low five bits of the address are not stored and the record
; must be 32-BYTE ALIGNED. v3d_decoder.c:880-882 is where that reading
; comes from: it reconstructs an address as
; `unpack_uint(p,s,e) << (31 - (e - s))`, which for a 27-bit field is
; a shift of five - i.e. the field holds address >> 5 and the packed
; word is simply the address with its low five bits cleared.
;
; A MISALIGNED RECORD IS REFUSED. Masking it would point the hardware
; at a plausible wrong address and produce a draw with somebody else's
; shader in it.
Procedure V3dClGlShaderState(recordAddr.i, numAttrArrays.i)
  If (recordAddr % 32) <> 0
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If numAttrArrays < 0 Or numAttrArrays > 31
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  v3d_ClU8(#V3D_PKT_GL_SHADER_STATE)
  v3d_ClU32((recordAddr & $FFFFFFE0) | (numAttrArrays & $1F))
EndProcedure

; v3d_packet.xml:1080-1083. Address is 26 bits at bit 6, so the tile
; list base must be 64-BYTE ALIGNED by the same reasoning as above.
Procedure V3dClMulticoreTileListSetBase(addr.i, setNo.i)
  If (addr % 64) <> 0
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If setNo < 0 Or setNo > 15
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  v3d_ClU8(#V3D_PKT_MULTICORE_TILE_LIST)
  v3d_ClU32((addr & $FFFFFFC0) | (setNo & $F))
EndProcedure

; v3d_packet.xml:349-351.
Procedure V3dClBranch(addr.i)
  v3d_ClU8(#V3D_PKT_BRANCH)
  v3d_ClU32(addr)
EndProcedure

; --- 9 bytes ----------------------------------------------------------

; v3d_packet.xml:360-363. start at bit 0, end at bit 32, both 32-bit
; addresses. `end` is the first byte AFTER the sub-list, exactly as
; Mesa passes `cl_get_address(cl)` after emitting the whole thing
; (v3dx_rcl.c:355-358).
Procedure V3dClStartAddressOfGenericTileList(startAddr.i, endAddr.i)
  If endAddr <= startAddr
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  v3d_ClU8(#V3D_PKT_GENERIC_TILE_LIST)
  v3d_ClU32(startAddr)
  v3d_ClU32(endAddr)
EndProcedure

; v3d_packet.xml:801-806. Four 16-bit fields.
Procedure V3dClClipWindow(left.i, bottom.i, width.i, height.i)
  v3d_ClU8(#V3D_PKT_CLIP_WINDOW)
  v3d_ClU16(left)
  v3d_ClU16(bottom)
  v3d_ClU16(width)
  v3d_ClU16(height)
EndProcedure

; v3d_packet.xml:815-818 and :820-823 and :830-833. Three packets with
; the same shape: two 32-bit floats, low one first. Taken as raw bit
; patterns for V3dClPointSize()'s reason.
Procedure V3dClClipperZMinMax(minZwBits.i, maxZwBits.i)
  v3d_ClU8(#V3D_PKT_CLIPPER_Z_MINMAX)
  v3d_ClU32(minZwBits)
  v3d_ClU32(maxZwBits)
EndProcedure

Procedure V3dClClipperXyScaling(halfWidthBits.i, halfHeightBits.i)
  v3d_ClU8(#V3D_PKT_CLIPPER_XY_SCALING)
  v3d_ClU32(halfWidthBits)
  v3d_ClU32(halfHeightBits)
EndProcedure

Procedure V3dClClipperZScaleOffset(scaleBits.i, offsetBits.i)
  v3d_ClU8(#V3D_PKT_CLIPPER_Z_SCALE_OFF)
  v3d_ClU32(scaleBits)
  v3d_ClU32(offsetBits)
EndProcedure

; v3d_packet.xml:808-813. Coarse/fine X and Y, the fine parts u14.8.
; Mesa emits it with everything zero for an unshifted viewport.
Procedure V3dClViewportOffset(fineX.i, coarseX.i, fineY.i, coarseY.i)
  v3d_ClU8(#V3D_PKT_VIEWPORT_OFFSET)
  v3d_ClU32((fineX & $3FFFFF) | ((coarseX & $3FF) << 22))
  v3d_ClU32((fineY & $3FFFFF) | ((coarseY & $3FF) << 22))
EndProcedure

; --- 10 bytes ---------------------------------------------------------

; v3d_packet.xml:508-513. mode 8 bits at 0, Length 32 bits at 8, Index
; of First Vertex 32 bits at 40. Nine payload bytes, and the two
; 32-bit fields are BYTE ALIGNED within the payload because the mode
; field is exactly one byte - which is a piece of luck and not a rule.
Procedure V3dClVertexArrayPrims(mode.i, length.i, firstVertex.i)
  If mode < 0 Or mode > 255
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If length <= 0
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  v3d_ClU8(#V3D_PKT_VERTEX_ARRAY_PRIMS)
  v3d_ClU8(mode)
  v3d_ClU32(length)
  v3d_ClU32(firstVertex)
EndProcedure

; --- the wide configuration packets, 9 and 13 bytes ------------------

; TILE BINNING MODE CFG, v3d_packet.xml:844-866, the max_ver="42" form.
; Eight payload bytes.
;
;   Height (pixels) 16 @48 minus_one     Width (pixels) 16 @32 minus_one
;   Double-buffer @15   Multisample @14  Max BPP 2 @12
;   Number of Render Targets 4 @8 minus_one
;   tile allocation block size 2 @4      initial block size 2 @2
;
; MESA NEVER WRITES THE TWO BLOCK-SIZE FIELDS (v3dx_draw.c:117-127),
; so they take the packet's default of zero, which the XML names
; "tile allocation block size 64b". This procedure takes them as
; arguments anyway because V3dRclBuild() has to write the SAME value
; into TILE_LIST_INITIAL_BLOCK_SIZE in the other list - v3dx_rcl.c:833
; - and a constant that has to match in two places should be passed,
; not repeated.
Procedure V3dClTileBinningModeCfg(width.i, height.i, nrRts.i, maxBpp.i, blockSize.i, initBlockSize.i)
  Protected lo.i
  Protected hi.i
  If width < 1 Or width > 65536
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If height < 1 Or height > 65536
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If nrRts < 1 Or nrRts > 16
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If maxBpp < 0 Or maxBpp > 2
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If blockSize < 0 Or blockSize > 2
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If initBlockSize < 0 Or initBlockSize > 2
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf

  lo = ((initBlockSize & 3) << 2) | ((blockSize & 3) << 4)
  lo = lo | (((nrRts - 1) & $F) << 8)
  lo = lo | ((maxBpp & 3) << 12)
  ; Multisample bit 14 and double-buffer bit 15 are both left clear -
  ; see WHAT IS DELIBERATELY ABSENT. They are not parameters because a
  ; caller that set either would also have to change the tile size,
  ; the decimate mode and the render-mode config, and a single
  ; argument that silently needs three others changed with it is a
  ; trap rather than a feature.
  hi = ((width - 1) & $FFFF) | (((height - 1) & $FFFF) << 16)

  v3d_ClU8(#V3D_PKT_TILE_BINNING_MODE_CFG)
  v3d_ClU32(lo)
  v3d_ClU32(hi)
EndProcedure

; TILE RENDERING MODE CFG (COMMON), v3d_packet.xml:897-924, sub-id 0.
; Eight payload bytes. MUST BE THE FIRST 121 IN THE RENDER LIST -
; v3dx_rcl.c:630-632.
;
;   sub-id 4 @0 = 0                      Number of RTs 4 @4 minus_one
;   Image Width 16 @8                    Image Height 16 @24
;   Maximum BPP 2 @40                    Multisample @42
;   Double-buffer @43                    Early-Z direction @45
;   Early-Z disable @46                  Internal Depth Type 4 @47
;   Early Depth/Stencil Clear @51        Pad 12 @52
;
; EARLY-Z DISABLE IS NOT OPTIONAL WITHOUT A DEPTH BUFFER. Mesa asserts
; it: `assert(job->zsbuf || config.early_z_disable)` (v3dx_rcl.c:661),
; and reaches the same state through the else branch at :656-659 when
; no draw has been queued.
Procedure V3dClTrmcCommon(imgW.i, imgH.i, nrRts.i, maxBpp.i, earlyZDisable.i, depthType.i)
  Protected lo.i
  Protected hi.i
  If imgW < 1 Or imgW > 65535
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If imgH < 1 Or imgH > 65535
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If nrRts < 1 Or nrRts > 16
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If maxBpp < 0 Or maxBpp > 2
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If depthType < 0 Or depthType > 15
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf

  lo = #V3D_TRMC_COMMON
  lo = lo | (((nrRts - 1) & $F) << 4)
  lo = lo | ((imgW & $FFFF) << 8)
  lo = lo | ((imgH & $FF) << 24)

  hi = (imgH >> 8) & $FF
  hi = hi | ((maxBpp & 3) << 8)
  If earlyZDisable <> 0
    hi = hi | (1 << 14)
  EndIf
  hi = hi | ((depthType & $F) << 15)

  v3d_ClU8(#V3D_PKT_TILE_RENDER_MODE_CFG)
  v3d_ClU32(lo)
  v3d_ClU32(hi)
EndProcedure

; TILE RENDERING MODE CFG (COLOR), v3d_packet.xml:963-984, sub-id 1.
; Eight payload bytes. Four render targets in one packet, each three
; fields, and RT3's Internal Type STRADDLES THE 32-BIT BOUNDARY at
; bits 30..33 - which is why this is composed as two words with an
; explicit split rather than as a shifted literal.
;
; Only RT0 is a parameter. RT1..3 go out as zero, which is what Mesa
; produces too: v3d_setup_render_target returns immediately for a
; cbuf that is not there (v3dx_rcl.c:440-441), leaving the packet's
; defaults.
Procedure V3dClTrmcColor(bpp0.i, type0.i, clamp0.i)
  Protected lo.i
  If bpp0 < 0 Or bpp0 > 3
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If type0 < 0 Or type0 > 15
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If clamp0 < 0 Or clamp0 > 3
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  lo = #V3D_TRMC_COLOR
  lo = lo | ((bpp0 & 3) << 4)
  lo = lo | ((type0 & $F) << 6)
  lo = lo | ((clamp0 & 3) << 10)
  v3d_ClU8(#V3D_PKT_TILE_RENDER_MODE_CFG)
  v3d_ClU32(lo)
  v3d_ClU32(0)
EndProcedure

; TILE RENDERING MODE CFG (ZS CLEAR VALUES), :986-993, sub-id 2.
; MUST BE THE LAST 121 IN THE RENDER LIST - v3dx_rcl.c:630-632 again.
;   sub-id 4 @0 = 2   Stencil Clear 8 @8   Z Clear Value 32 @16 (float)
Procedure V3dClTrmcZsClear(zClearBits.i, stencilClear.i)
  Protected lo.i
  Protected hi.i
  lo = #V3D_TRMC_ZS_CLEAR
  lo = lo | ((stencilClear & $FF) << 8)
  lo = lo | ((zClearBits & $FFFF) << 16)
  hi = (zClearBits >> 16) & $FFFF
  v3d_ClU8(#V3D_PKT_TILE_RENDER_MODE_CFG)
  v3d_ClU32(lo)
  v3d_ClU32(hi)
EndProcedure

; TILE RENDERING MODE CFG (CLEAR COLORS PART1), :1004-1011, sub-id 3.
;   sub-id 4 @0 = 3   RT number 4 @4
;   Clear Color low 32 bits @8    Clear Color next 24 bits @40
;
; THE COLOUR IS IN THE TILE BUFFER'S INTERNAL FORMAT, NOT THE
; TARGET'S. For internal type 8 - which is what every 8-bit-per-
; channel output format maps to - Mesa packs it as R8G8B8A8_UNORM
; (v3dx_draw.c:1733-1736), i.e. red in the low byte. That happens to
; be identical to the stored RGBA8 pixel on a little-endian machine,
; which makes the clear colour and the pixels comparable word for word
; and is the whole reason a clear is a good first test.
;
; PARTS 2 AND 3 ARE NOT WRITTEN. Mesa emits part 2 only for internal
; bpp >= 64 (v3dx_rcl.c:749) and part 3 only for bpp >= 128 or a UIF
; clear pad (:762), and it explicitly does NOT set part 3's raster row
; stride - "XXX: Set the pad for raster" (:725) is an open TODO in
; Mesa, not something it does. Following Mesa's silence here is a
; choice and it is the one that keeps this list identical to a list
; Mesa is known to submit.
Procedure V3dClTrmcClearColor1(rt.i, low32.i, next24.i)
  Protected lo.i
  Protected hi.i
  If rt < 0 Or rt > 15
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  lo = #V3D_TRMC_CLEAR_COL1
  lo = lo | ((rt & $F) << 4)
  lo = lo | ((low32 & $FFFFFF) << 8)
  hi = (low32 >> 24) & $FF
  hi = hi | ((next24 & $FFFFFF) << 8)
  v3d_ClU8(#V3D_PKT_TILE_RENDER_MODE_CFG)
  v3d_ClU32(lo)
  v3d_ClU32(hi)
EndProcedure

; MULTICORE RENDERING SUPERTILE CFG, v3d_packet.xml:1065-1078.
; Eight payload bytes.
;   Supertile Width in Tiles 8 @0 minus_one
;   Supertile Height in Tiles 8 @8 minus_one
;   Total Frame Width in Supertiles 8 @16
;   Total Frame Height in Supertiles 8 @24
;   Total Frame Width in Tiles 12 @32
;   Total Frame Height in Tiles 12 @44
;   Multicore Enable @56   Supertile Raster Order @60
;   Number of Bin Tile Lists 3 @61 minus_one
Procedure V3dClMulticoreSupertileCfg(stW.i, stH.i, fwSt.i, fhSt.i, fwTiles.i, fhTiles.i, nBinTileLists.i)
  Protected lo.i
  Protected hi.i
  If stW < 1 Or stW > 256
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If stH < 1 Or stH > 256
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If fwSt < 0 Or fwSt > 255
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If fhSt < 0 Or fhSt > 255
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If fwTiles < 0 Or fwTiles > 4095
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If fhTiles < 0 Or fhTiles > 4095
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If nBinTileLists < 1 Or nBinTileLists > 8
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf

  lo = ((stW - 1) & $FF)
  lo = lo | (((stH - 1) & $FF) << 8)
  lo = lo | ((fwSt & $FF) << 16)
  lo = lo | ((fhSt & $FF) << 24)

  hi = (fwTiles & $FFF)
  hi = hi | ((fhTiles & $FFF) << 12)
  ; Multicore Enable stays clear: HUB_IDENT1.NCORES is 1 on this part
  ; and V3dCheckIdent() refuses anything else, so there is no second
  ; core to enable. Supertile Raster Order stays clear because Mesa
  ; leaves it clear and its comment at :588-591 says Morton order is
  ; what the hardware does otherwise and is better for cache locality.
  hi = hi | (((nBinTileLists - 1) & 7) << 29)

  v3d_ClU8(#V3D_PKT_MULTICORE_SUPERTILE)
  v3d_ClU32(lo)
  v3d_ClU32(hi)
EndProcedure

; STORE TILE BUFFER GENERAL, v3d_packet.xml:392-427. TWELVE payload
; bytes, thirteen with the opcode.
;   Buffer to Store 4 @0       Memory Format 3 @4     Flip Y @7
;   Dither Mode 2 @8           Decimate mode 2 @10
;   Output Image Format 6 @12  Clear buffer being stored @18
;   Channel Reverse @19        R/B swap @20
;   Height in UB or Stride 20 @28   Height 16 @48   Address 32 @64
;
; `strideOrUbHeight` IS TWO DIFFERENT QUANTITIES AND THE PACKET DOES
; NOT SAY WHICH. v3dx_rcl.c:125-133: for UIF it is the padded height
; in UIF blocks, for RASTER it is the BYTE stride, and for LINEARTILE
; and the UB-linear forms Mesa writes nothing at all. The caller
; supplies it because only the caller knows the surface.
;
;   AND IT IS A BYTE STRIDE HERE WHILE THE TFU'S TFU_IIS IS A STRIDE
;   IN TEXELS (Reference/README.md's row for v3dx_tfu.c, from
;   v3dx_tfu.c:116). Two registers in the same block, same word,
;   opposite convention. Getting them the same way round is a
;   four-times-too-small stride and a rendered image that repeats.
;
; THE FIELD IS TWENTY BITS, so the largest raster stride this packet
; can express is 1048575 bytes. A 1920-wide RGBA8 surface is 7680 and
; is nowhere near it; a refusal is here anyway because the alternative
; is a silently wrapped stride.
Procedure V3dClStoreTileBufferGeneral(buffer.i, addr.i, outFmt.i, memFmt.i, strideOrUbHeight.i, rbSwap.i, clearAfterStore.i)
  Protected lo.i
  Protected mid.i
  If buffer < 0 Or buffer > 15
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If memFmt < 0 Or memFmt > 7
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If outFmt < 0 Or outFmt > 63
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If strideOrUbHeight < 0 Or strideOrUbHeight > $FFFFF
    v3d_clErr = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf

  lo = (buffer & $F)
  lo = lo | ((memFmt & 7) << 4)
  ; Dither Mode stays NONE and Decimate mode stays SAMPLE_0. Mesa sets
  ; decimate to SAMPLE_0 for a non-MSAA surface (v3dx_rcl.c:145) and
  ; never sets dither at all on this path.
  lo = lo | ((#V3D_DECIMATE_SAMPLE0 & 3) << 10)
  lo = lo | ((outFmt & $3F) << 12)
  If clearAfterStore <> 0
    lo = lo | (1 << 18)
  EndIf
  If rbSwap <> 0
    lo = lo | (1 << 20)
  EndIf
  lo = lo | ((strideOrUbHeight & $F) << 28)

  ; Height at bit 48 is the Y-flip height and Mesa never writes it on
  ; this path, so the top half of `mid` is zero.
  mid = (strideOrUbHeight >> 4) & $FFFF

  v3d_ClU8(#V3D_PKT_STORE_TILE_BUFFER_GEN)
  v3d_ClU32(lo)
  v3d_ClU32(mid)
  v3d_ClU32(addr)
EndProcedure

; The GFXH-1742 dummy store. Buffer NONE, everything else zero, and
; the address is meaningless because nothing is written.
; v3dx_rcl.c:568-570.
Procedure V3dClStoreNone()
  v3d_ClU8(#V3D_PKT_STORE_TILE_BUFFER_GEN)
  v3d_ClU32(#V3D_BUF_NONE)
  v3d_ClU32(0)
  v3d_ClU32(0)
EndProcedure


; ======================================================================
;  STAGE 4 - THE TWO RECORDS A DRAW NEEDS THAT ARE NOT PACKETS
; ======================================================================
;
;  THE SHADER STATE RECORD AND THE ATTRIBUTE RECORDS ARE STRUCTS IN
;  MEMORY, NOT CONTROL-LIST PACKETS, and the difference matters twice.
;  They carry no opcode byte, so every field's bit number is its bit
;  number in the struct; and they are pointed at by GL_SHADER_STATE
;  rather than executed, so a wrong one produces a draw with somebody
;  else's shader in it rather than a CLE that stops.
;
;  v3d_packet.xml:1098-1155 is the max_ver="42" record and
;  :1374-1397 is the attribute record. Their LENGTHS are derived the
;  same way every packet length in this file is - the highest bit any
;  field touches, divided by eight, plus one - which gives 36 bytes
;  and 16 bytes. Mesa lays the attribute records out IMMEDIATELY
;  AFTER the shader record in one buffer (v3dx_draw.c:773-778 reserves
;  `record + n * attr` in one allocation and :835 emits them in
;  order), so V3dShaderRecordAttrAddr() below is that arithmetic and
;  not a convention this file invented.
;
;  THE RECORD MUST BE 32-BYTE ALIGNED. GL_SHADER_STATE's address field
;  is 27 bits at bit 5 (v3d_packet.xml:576-579), so the low five bits
;  are the attribute-array count and not address. V3dClGlShaderState()
;  already refuses a misaligned record; V3dShaderRecordBegin() refuses
;  it earlier, where the mistake is.
;
;  THE THREE CODE ADDRESSES ARE 29-BIT FIELDS AT BIT 99, 163 AND 227,
;  which by v3d_decoder.c:880-882's rule means the low THREE bits are
;  not address - they are 4-way-threadable, start-in-final-thread-
;  section and propagate-NaNs. A QPU program is eight-byte aligned
;  anyway (V3dQpuProgramBegin refuses otherwise), so those three bits
;  are always free; the refusal here is for a caller who computed an
;  address some other way.
;
;  WHAT THIS FILE DOES NOT OFFER, and each is absent because nothing
;  here sets it: the geometry and tessellation records (packets 65-67
;  and their extra structs), the 7.1 layout, per-vertex point size,
;  primitive ID, sample-rate shading, and separate input/output VPM
;  segments. `separate_segments` is FORCED FALSE by Mesa itself -
;  Reference/mesa-24.3.4_vir.c:849-859, "apparently necessary for our
;  VCM setup to avoid varying corruption" - so the two bits that would
;  select it are written as zero and the input segment size is written
;  as 1, which is what v3dx_draw.c:639-644 does in that case.
; ======================================================================

; The two lengths, derived above rather than looked up.
#V3D_SHREC_BYTES = 36
#V3D_ATTR_BYTES  = 16

; Attribute Type, v3d_packet.xml:1378-1386.
#V3D_ATTR_HALF_FLOAT = 1
#V3D_ATTR_FLOAT      = 2
#V3D_ATTR_FIXED      = 3
#V3D_ATTR_BYTE       = 4
#V3D_ATTR_SHORT      = 5
#V3D_ATTR_INT        = 6
#V3D_ATTR_INT2_10_10_10 = 7

Global v3d_shrecAddr.i  = 0
Global v3d_shrecAttrs.i = 0
Global v3d_shrecOk.i    = 0

; ----------------------------------------------------------------------
;  v3d_ShrecPut32 - one 32-bit word into the record, BYTE-WISE.
;
;  Same reason the control-list writer is byte-wise: with the ARM MMU
;  off an unaligned 32-bit store is a fatal Alignment fault with no
;  message. Every word of this record IS 4-aligned, because the record
;  is 32-aligned and every offset below is a multiple of four - so
;  this could have been PokeN. It is not, because the next field
;  somebody adds may not be, and a writer that is safe only by
;  coincidence is a trap.
; ----------------------------------------------------------------------
Procedure v3d_ShrecPut32(off.i, v.i)
  PokeA(v3d_shrecAddr + off,     v & $FF)
  PokeA(v3d_shrecAddr + off + 1, (v >> 8) & $FF)
  PokeA(v3d_shrecAddr + off + 2, (v >> 16) & $FF)
  PokeA(v3d_shrecAddr + off + 3, (v >> 24) & $FF)
EndProcedure

; ----------------------------------------------------------------------
;  V3dShaderRecordBegin - zero the record and remember where it is.
;
;  THE ZEROING IS A BACKSTOP AND IT CANNOT FIRE TODAY. Saying so is
;  better than leaving a reader to work it out, and a64_v3d_tri_check
;  --mutate proved it: deleting this loop kills no test.
;
;  The reason is that the five setters below between them write ALL
;  thirty-six bytes as whole 32-bit words - flags 0-3, VPM 4-7,
;  defaults 8-11, and two words each for the three shader stages -
;  and V3dAttrRecord() writes all sixteen of an attribute record's.
;  So every bit is overwritten whether or not it was zeroed, and the
;  twenty booleans this file never names are zeroed by being part of
;  the word V3dShaderRecordFlags() composes.
;
;  IT STAYS, for two reasons. It is the only thing that would still
;  hold if a future setter wrote a BYTE or a nibble rather than a word
;  - the record has twelve boolean fields with no setter at all, and
;  the first one that gets a narrow setter makes this loop load
;  bearing without anybody noticing. And a caller can legitimately
;  build a record and set only some of the stages. A backstop that is
;  labelled as unreachable is honest; one described as doing work it
;  does not do is the beginning of a wrong belief about where the
;  guard lives.
; ----------------------------------------------------------------------
Procedure.i V3dShaderRecordBegin(addr.i, numAttrs.i)
  Protected i.i
  v3d_shrecOk = 0
  If addr <= 0 Or (addr % 32) <> 0
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf
  ; GFXH-930 - v3dx_draw.c:847-866 and :872-889: at least one
  ; attribute must be enabled and read by BOTH the coordinate and the
  ; vertex shader, and Mesa manufactures a dummy one when a shader
  ; needs none. Zero attribute arrays is therefore not a thing to
  ; allow silently.
  If numAttrs < 1 Or numAttrs > 31
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf
  v3d_shrecAddr  = addr
  v3d_shrecAttrs = numAttrs
  i = 0
  While i < #V3D_SHREC_BYTES
    PokeA(addr + i, 0)
    i = i + 1
  Wend
  i = 0
  While i < (numAttrs * #V3D_ATTR_BYTES)
    PokeA(addr + #V3D_SHREC_BYTES + i, 0)
    i = i + 1
  Wend
  v3d_shrecOk = 1
  ProcedureReturn #V3D_OK
EndProcedure

; Where attribute record `n` lives. v3dx_draw.c:773-778 and :835.
Procedure.i V3dShaderRecordAttrAddr(n.i)
  ProcedureReturn v3d_shrecAddr + #V3D_SHREC_BYTES + (n * #V3D_ATTR_BYTES)
EndProcedure

Procedure.i V3dShaderRecordBytes()
  ProcedureReturn #V3D_SHREC_BYTES + (v3d_shrecAttrs * #V3D_ATTR_BYTES)
EndProcedure

Procedure.i V3dShaderRecordAddr()
  ProcedureReturn v3d_shrecAddr
EndProcedure

; ----------------------------------------------------------------------
;  V3dShaderRecordFlags - bytes 0 through 2, the twenty booleans.
;
;  Only the ones a fixed-function-free triangle can need are
;  parameters; the rest are the zeros V3dShaderRecordBegin() wrote.
;  Named individually rather than as a bit mask because a mask is
;  where a transposed pair of booleans hides.
;
;    enableClipping           :1  v3dx_draw.c:580, ALWAYS true in Mesa
;    fsZWrites                :8  the FS writes gl_FragDepth or discards
;    turnOffEarlyZ            :9  prog_data.fs->disable_ez
;    scoreboardWaitFirstThrsw :17 only when a TLB LOAD precedes a
;                                 thread switch - nir_to_vir.c:167-172
;    disableImplicitPointLine :18 !uses_implicit_point_line_varyings
; ----------------------------------------------------------------------
Procedure V3dShaderRecordFlags(enableClipping.i, fsZWrites.i, turnOffEarlyZ.i, scoreboardWaitFirstThrsw.i, disableImplicitPointLine.i, numVaryingsFs.i)
  Protected v.i
  If numVaryingsFs < 0 Or numVaryingsFs > 255
    v3d_err = #V3D_ERR_CL_ARGS
    v3d_shrecOk = 0
    ProcedureReturn
  EndIf
  v = 0
  If enableClipping <> 0
    v = v | 2                      ; bit 1
  EndIf
  If fsZWrites <> 0
    v = v | $100                   ; bit 8
  EndIf
  If turnOffEarlyZ <> 0
    v = v | $200                   ; bit 9
  EndIf
  If scoreboardWaitFirstThrsw <> 0
    v = v | $20000                 ; bit 17
  EndIf
  If disableImplicitPointLine <> 0
    v = v | $40000                 ; bit 18
  EndIf
  v = v | ((numVaryingsFs & $FF) << 24)   ; "3b", bits 31:24
  v3d_ShrecPut32(0, v)
EndProcedure

; ----------------------------------------------------------------------
;  V3dShaderRecordVpm - bytes 4 through 7.
;
;  FOUR NIBBLE PAIRS AND ONE OF THE EIGHT IS minus_one. The XML says
;  so at :1128 and :1134 for the two INPUT segment counts and NOT for
;  the two output ones, which is the kind of asymmetry that is
;  invisible in a hex dump.
;
;  `csOutSeg` / `vsOutSeg` are vpm_output_size in SECTORS OF EIGHT
;  ROWS - Reference/mesa-24.3.4_vir.c:843-847, align(n, 8) / 8.
;  `csInSeg` / `vsInSeg` are 1 with shared segments, which is what
;  v3dx_draw.c:639-644 writes when separate_segments is false.
;  `csAs` / `vsAs` are vpm_config.As and `csVe` / `vsVe` are .Ve, and
;  with no geometry shader those are 1 and 0 flat -
;  Reference/mesa-24.3.4_vir.c:2508-2515.
; ----------------------------------------------------------------------
Procedure V3dShaderRecordVpm(csOutSeg.i, csVe.i, csInSeg.i, csAs.i, vsOutSeg.i, vsVe.i, vsInSeg.i, vsAs.i)
  Protected v.i
  If csOutSeg < 0 Or csOutSeg > 15 Or vsOutSeg < 0 Or vsOutSeg > 15
    v3d_err = #V3D_ERR_CL_ARGS
    v3d_shrecOk = 0
    ProcedureReturn
  EndIf
  If csInSeg < 0 Or csInSeg > 15 Or vsInSeg < 0 Or vsInSeg > 15
    v3d_err = #V3D_ERR_CL_ARGS
    v3d_shrecOk = 0
    ProcedureReturn
  EndIf
  If csVe < 0 Or csVe > 15 Or vsVe < 0 Or vsVe > 15
    v3d_err = #V3D_ERR_CL_ARGS
    v3d_shrecOk = 0
    ProcedureReturn
  EndIf
  ; minus_one, so 1 encodes as 0 and 0 is not expressible.
  If csAs < 1 Or csAs > 16 Or vsAs < 1 Or vsAs > 16
    v3d_err = #V3D_ERR_CL_ARGS
    v3d_shrecOk = 0
    ProcedureReturn
  EndIf
  v = (csOutSeg & $F)
  v = v | ((csVe & $F) << 4)
  v = v | ((csInSeg & $F) << 8)
  v = v | (((csAs - 1) & $F) << 12)
  v = v | ((vsOutSeg & $F) << 16)
  v = v | ((vsVe & $F) << 20)
  v = v | ((vsInSeg & $F) << 24)
  v = v | (((vsAs - 1) & $F) << 28)
  v3d_ShrecPut32(4, v)
EndProcedure

; The address of the default attribute values, bytes 8-11. Mesa always
; supplies one (v3dx_draw.c:701-703); it is read for any component a
; shader asks for that the attribute record does not supply.
Procedure V3dShaderRecordDefaults(addr.i)
  v3d_ShrecPut32(8, addr)
EndProcedure

; ----------------------------------------------------------------------
;  v3d_ShrecCode - one code address plus its three low-bit flags.
;
;  The three stages differ only in the offset, so they are one
;  procedure with the offset passed. A misaligned address is refused
;  rather than masked: masking would point the QPU at a plausible
;  wrong instruction and the draw would run something.
; ----------------------------------------------------------------------
Procedure v3d_ShrecCode(off.i, addr.i, fourWay.i, finalSeg.i, propagateNans.i)
  Protected v.i
  If (addr % 8) <> 0
    v3d_err = #V3D_ERR_CL_ARGS
    v3d_shrecOk = 0
    ProcedureReturn
  EndIf
  v = addr & $FFFFFFF8
  If fourWay <> 0
    v = v | 1
  EndIf
  If finalSeg <> 0
    v = v | 2
  EndIf
  If propagateNans <> 0
    v = v | 4
  EndIf
  v3d_ShrecPut32(off, v)
EndProcedure

; Bytes 12-15 and 16-19.
Procedure V3dShaderRecordFragment(codeAddr.i, uniformsAddr.i, fourWay.i, finalSeg.i, propagateNans.i)
  v3d_ShrecCode(12, codeAddr, fourWay, finalSeg, propagateNans)
  v3d_ShrecPut32(16, uniformsAddr)
EndProcedure

; Bytes 20-23 and 24-27.
Procedure V3dShaderRecordVertex(codeAddr.i, uniformsAddr.i, fourWay.i, finalSeg.i, propagateNans.i)
  v3d_ShrecCode(20, codeAddr, fourWay, finalSeg, propagateNans)
  v3d_ShrecPut32(24, uniformsAddr)
EndProcedure

; Bytes 28-31 and 32-35.
Procedure V3dShaderRecordCoord(codeAddr.i, uniformsAddr.i, fourWay.i, finalSeg.i, propagateNans.i)
  v3d_ShrecCode(28, codeAddr, fourWay, finalSeg, propagateNans)
  v3d_ShrecPut32(32, uniformsAddr)
EndProcedure

; ----------------------------------------------------------------------
;  V3dAttrRecord - one GL Shader State Attribute Record.
;
;  v3d_packet.xml:1374-1397. Sixteen bytes.
;
;  `csValues` AND `vsValues` ARE HOW MANY 32-BIT VALUES THE VCD LOADS
;  INTO THAT PHASE'S VPM INPUT BLOCK, and they are what the LDVPM
;  offsets in the shader are counted against - the offset for
;  attribute k is the SUM of the previous attributes' counts
;  (nir_to_vir.c:2810-2824). Four bits each, so at most fifteen.
;
;  GFXH-930 AGAIN: a record read by the vertex shader and not by the
;  coordinate shader is legal, and a draw where NO record is read by
;  the coordinate shader is not. Mesa forces one to 1 rather than
;  fixing the shader (v3dx_draw.c:858-866). This file cannot check it
;  from here - it sees one record at a time - so it is the caller's,
;  and it is stated here rather than left to be discovered.
; ----------------------------------------------------------------------
;  IT IS TWO PROCEDURES AND THE REASON IS THE BACKEND'S, NOT THE
;  PACKET'S. The Pi 4 backend passes at most eight arguments - a0
;  through a7 - and the record has twelve fields worth setting. So
;  V3dAttrRecord() writes the whole record in its commonest shape
;  (one 32-bit float, no instancing) and V3dAttrRecordType() rewrites
;  the two bytes that describe the element. Splitting it that way
;  rather than passing a structure address keeps the call site
;  readable and keeps the range checks where the values arrive.
Procedure V3dAttrRecord(n.i, addr.i, stride.i, maxIndex.i, csValues.i, vsValues.i)
  Protected base.i
  If v3d_shrecOk = 0
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If n < 0 Or n >= v3d_shrecAttrs
    v3d_err = #V3D_ERR_CL_ARGS
    v3d_shrecOk = 0
    ProcedureReturn
  EndIf
  If csValues < 0 Or csValues > 15 Or vsValues < 0 Or vsValues > 15
    v3d_err = #V3D_ERR_CL_ARGS
    v3d_shrecOk = 0
    ProcedureReturn
  EndIf

  base = V3dShaderRecordAttrAddr(n)
  PokeA(base + 0, addr & $FF)
  PokeA(base + 1, (addr >> 8) & $FF)
  PokeA(base + 2, (addr >> 16) & $FF)
  PokeA(base + 3, (addr >> 24) & $FF)

  ; Byte 4: vec size 1 and type FLOAT, which is Mesa's own shape for
  ; a single 32-bit component (v3dx_draw.c:881-883).
  PokeA(base + 4, 1 | (#V3D_ATTR_FLOAT << 2))

  ; Byte 5: values read by the coordinate shader 4 @40, by the vertex
  ; shader 4 @44.
  PokeA(base + 5, (csValues & $F) | ((vsValues & $F) << 4))

  ; Instance divisor zero - nothing here is instanced.
  PokeA(base + 6, 0)
  PokeA(base + 7, 0)

  PokeA(base + 8,  stride & $FF)
  PokeA(base + 9,  (stride >> 8) & $FF)
  PokeA(base + 10, (stride >> 16) & $FF)
  PokeA(base + 11, (stride >> 24) & $FF)

  PokeA(base + 12, maxIndex & $FF)
  PokeA(base + 13, (maxIndex >> 8) & $FF)
  PokeA(base + 14, (maxIndex >> 16) & $FF)
  PokeA(base + 15, (maxIndex >> 24) & $FF)
EndProcedure

; Byte 4 and the instance divisor, for an attribute that is not a
; single float. Call it AFTER V3dAttrRecord(), which wrote the
; default.
;
; `readAsInt` IS NOT COSMETIC FOR A SHADED-VERTEX COORDINATE. Xs and
; Ys in the VPM are INTEGERS in 1/256ths of a pixel - the shaded
; vertex layout at Reference/mesa-24.3.4_v3d_nir_lower_io.c:539-542
; ends in f2i32(ffloor(...)) - and a small screen coordinate reads as
; a DENORMAL float. An attribute declared float that the VCD flushed
; to zero would put the whole triangle at the viewport centre, which
; looks like a wrong transform rather than a wrong declaration.
Procedure V3dAttrRecordType(n.i, vecSize.i, type.i, signedInt.i, normalized.i, readAsInt.i, instanceDivisor.i)
  Protected base.i
  Protected v.i
  If v3d_shrecOk = 0
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn
  EndIf
  If n < 0 Or n >= v3d_shrecAttrs
    v3d_err = #V3D_ERR_CL_ARGS
    v3d_shrecOk = 0
    ProcedureReturn
  EndIf
  If vecSize < 0 Or vecSize > 3
    v3d_err = #V3D_ERR_CL_ARGS
    v3d_shrecOk = 0
    ProcedureReturn
  EndIf
  If type < 0 Or type > 7
    v3d_err = #V3D_ERR_CL_ARGS
    v3d_shrecOk = 0
    ProcedureReturn
  EndIf
  If instanceDivisor < 0 Or instanceDivisor > 65535
    v3d_err = #V3D_ERR_CL_ARGS
    v3d_shrecOk = 0
    ProcedureReturn
  EndIf

  base = V3dShaderRecordAttrAddr(n)
  v = (vecSize & 3)
  v = v | ((type & 7) << 2)
  If signedInt <> 0
    v = v | 32
  EndIf
  If normalized <> 0
    v = v | 64
  EndIf
  If readAsInt <> 0
    v = v | 128
  EndIf
  PokeA(base + 4, v & $FF)
  PokeA(base + 6, instanceDivisor & $FF)
  PokeA(base + 7, (instanceDivisor >> 8) & $FF)
EndProcedure

Procedure.i V3dShaderRecordOk()
  ProcedureReturn v3d_shrecOk
EndProcedure


; ======================================================================
;  TILE GEOMETRY - COMPUTED, NEVER CHOSEN
;
;  The hardware decides the tile size from the number of render
;  targets, the maximum internal bpp across them, and whether 4x MSAA
;  or double-buffer is on. A driver does not program it on 4.2 - there
;  is no tile-size field in either the binning or the rendering config
;  packet, unlike 7.1 which added log2_tile_width/height - so a driver
;  that got the tile count wrong would emit the wrong number of
;  supertile coordinates and render part of the frame.
;
;  Reference/mesa-24.3.4_v3d_util.c:111-197 is the whole rule and
;  :122-130 is the table. The 4.x branch (:172-191) is an index into
;  it: +1 for more than one render target, +2 for more than two, +3
;  for more than four, then +2 for MSAA or +1 for double-buffer, then
;  += max_internal_bpp.
;
;  ONE 32-BPP RENDER TARGET, NO MSAA, NO DOUBLE BUFFER GIVES INDEX 0
;  AND A 64 x 64 TILE. That is why the first diagnostic renders into a
;  64x64 buffer: it is exactly one tile, one supertile, one entry in
;  the supertile loop, and every quantity below collapses to 1. If
;  something is wrong in the tile arithmetic it cannot be wrong there,
;  which makes a failure at 64x64 unambiguously NOT the tile
;  arithmetic.
; ======================================================================

; The table, flattened. :122-130.
Procedure.i V3dTileSizeIndex(nrRts.i, maxBpp.i, msaa.i, doubleBuffer.i)
  Protected idx.i
  idx = 0
  If nrRts > 4
    idx = idx + 3
  ElseIf nrRts > 2
    idx = idx + 2
  ElseIf nrRts > 1
    idx = idx + 1
  EndIf
  If msaa <> 0
    idx = idx + 2
  ElseIf doubleBuffer <> 0
    idx = idx + 1
  EndIf
  idx = idx + maxBpp
  ProcedureReturn idx
EndProcedure

Procedure.i V3dTileWidthOf(idx.i)
  Select idx
    Case 0
      ProcedureReturn 64
    Case 1
      ProcedureReturn 64
    Case 2
      ProcedureReturn 32
    Case 3
      ProcedureReturn 32
    Case 4
      ProcedureReturn 16
    Case 5
      ProcedureReturn 16
    Case 6
      ProcedureReturn 8
  EndSelect
  ProcedureReturn 0
EndProcedure

Procedure.i V3dTileHeightOf(idx.i)
  Select idx
    Case 0
      ProcedureReturn 64
    Case 1
      ProcedureReturn 32
    Case 2
      ProcedureReturn 32
    Case 3
      ProcedureReturn 16
    Case 4
      ProcedureReturn 16
    Case 5
      ProcedureReturn 8
    Case 6
      ProcedureReturn 8
  EndSelect
  ProcedureReturn 0
EndProcedure

; ----------------------------------------------------------------------
;  Output format -> internal type, internal bpp, clamp.
;
;  DERIVED IN THE LIBRARY RATHER THAN PASSED IN, and that is a
;  deliberate reversal of this file's usual habit of making the caller
;  state everything. The three quantities are not independent: the
;  tile buffer's internal representation is a FUNCTION of the output
;  format, given by v3dX(get_internal_type_bpp_for_output_format) in
;  Reference/mesa-24.3.4_v3dx_format_table.c:220-300. A caller that
;  passed rgba8 with internal type 32F would get a packet the hardware
;  accepts and pixels nobody can explain, and there is no register
;  that would say so.
;
;  ONLY THE FORMATS THIS FILE HAS A USE FOR ARE HERE. Anything else is
;  refused by returning -1, which every caller checks. Adding a row
;  means reading the switch again, not guessing from the name.
; ----------------------------------------------------------------------
Procedure.i V3dInternalTypeFor(outFmt.i)
  Select outFmt
    Case #V3D_OFMT_RGBA8
      ProcedureReturn #V3D_ITYPE_8     ; format_table.c:226-234
    Case #V3D_OFMT_RGB8
      ProcedureReturn #V3D_ITYPE_8     ; :227
    Case #V3D_OFMT_BGR565
      ProcedureReturn #V3D_ITYPE_8     ; :231
    Case #V3D_OFMT_SRGB8_ALPHA8
      ProcedureReturn #V3D_ITYPE_16F   ; :251-261, and see the comment
                                       ; there: sRGB is held at 16F in
                                       ; the tile buffer and converted
                                       ; on store.
  EndSelect
  ProcedureReturn -1
EndProcedure

Procedure.i V3dInternalBppFor(outFmt.i)
  Select outFmt
    Case #V3D_OFMT_RGBA8
      ProcedureReturn #V3D_IBPP_32     ; format_table.c:234
    Case #V3D_OFMT_RGB8
      ProcedureReturn #V3D_IBPP_32
    Case #V3D_OFMT_BGR565
      ProcedureReturn #V3D_IBPP_32
    Case #V3D_OFMT_SRGB8_ALPHA8
      ProcedureReturn #V3D_IBPP_64     ; :261
  EndSelect
  ProcedureReturn -1
EndProcedure

; v3dX(clamp_for_format_and_type), v3dx_rcl.c:368-380, the
; V3D_VERSION == 42 arm: sRGB clamps to NORM, a pure-integer format
; clamps to INT, everything else does not clamp.
Procedure.i V3dRtClampFor(outFmt.i)
  Select outFmt
    Case #V3D_OFMT_SRGB8_ALPHA8
      ProcedureReturn #V3D_RTCLAMP_NORM
    Case #V3D_OFMT_RGBA8
      ProcedureReturn #V3D_RTCLAMP_NONE
    Case #V3D_OFMT_RGB8
      ProcedureReturn #V3D_RTCLAMP_NONE
    Case #V3D_OFMT_BGR565
      ProcedureReturn #V3D_RTCLAMP_NONE
  EndSelect
  ProcedureReturn -1
EndProcedure

; ----------------------------------------------------------------------
;  The two buffer sizes the caller has to allocate, computed by the
;  same arithmetic Mesa uses so that a caller cannot guess low.
;
;  v3dx_draw.c:60-76 for the tile allocation pool:
;      size  = layers * tilesX * tilesY * 64
;      size  = align(size, 4096)
;      size += 8192               the PTB's own first two chunks
;      size += 512 * 1024         headroom so OOM is not hit
;
;  The 512 KB is Mesa's PERFORMANCE margin - its comment says "so that
;  we hopefully don't have to block the GPU on the kernel handling an
;  OOM signal" - and is the one term here that is a choice rather than
;  a requirement. It is kept because dropping it would make the OOM
;  path load-bearing on the very first run, and a first run should
;  fail in one way at a time.
;
;  v3dx_draw.c:80-86 for the tile state buffer: 256 bytes per tile,
;  per layer, and nothing else.
; ----------------------------------------------------------------------
Procedure.i V3dTileAllocBytesFor(tilesX.i, tilesY.i, layers.i)
  Protected n.i
  If tilesX < 1 Or tilesY < 1
    ProcedureReturn 0
  EndIf
  If layers < 1
    layers = 1
  EndIf
  n = layers * tilesX * tilesY * 64
  ; align(n, 4096), written as a divide and a multiply rather than a
  ; mask against a complement. bits.pi4:337-341 records why unary `~`
  ; is avoided in this tree: not every backend lowers it, and the
  ; equivalent form works everywhere.
  n = ((n + 4095) / 4096) * 4096
  n = n + 8192
  n = n + (512 * 1024)
  ProcedureReturn n
EndProcedure

Procedure.i V3dTileStateBytesFor(tilesX.i, tilesY.i, layers.i)
  If tilesX < 1 Or tilesY < 1
    ProcedureReturn 0
  EndIf
  If layers < 1
    layers = 1
  EndIf
  ProcedureReturn layers * tilesY * tilesX * #V3D_TILE_STATE_PER_TILE
EndProcedure


; ======================================================================
;  THE JOB - geometry, one render target, the pools, and the two lists
;
;  Built with setters and a builder rather than one call with twenty
;  arguments, on the pattern V3dTfuBegin/V3dTfuSourceRaster/
;  V3dTfuDest/V3dTfuSubmit established. The reason is the same: a
;  twenty-argument call is impossible to read at the call site and a
;  transposed pair of integers in it is invisible.
;
;  THE ORDER MATTERS AND IS ENFORCED. The output format decides the
;  internal bpp, the internal bpp decides the tile size, and the tile
;  size decides everything else - so the format is an argument to
;  V3dRenderBegin() and not to V3dRenderTarget(). A caller who calls
;  them out of order gets #V3D_ERR_CL_ARGS rather than a job built on
;  a tile count computed before the format was known.
; ======================================================================

Global v3d_jobW.i       = 0
Global v3d_jobH.i       = 0
Global v3d_jobTileW.i   = 0
Global v3d_jobTileH.i   = 0
Global v3d_jobTilesX.i  = 0
Global v3d_jobTilesY.i  = 0
Global v3d_jobStW.i     = 0   ; supertile width in tiles
Global v3d_jobStH.i     = 0   ; supertile height in tiles
Global v3d_jobFwSt.i    = 0   ; frame width in supertiles
Global v3d_jobFhSt.i    = 0   ; frame height in supertiles
Global v3d_jobMaxBpp.i  = 0
Global v3d_jobLayers.i  = 1

Global v3d_rtAddr.i   = 0
Global v3d_rtBytes.i  = 0
Global v3d_rtOutFmt.i = 0
Global v3d_rtMemFmt.i = 0
Global v3d_rtStride.i = 0
Global v3d_rtRbSwap.i = 0
Global v3d_rtType.i   = 0
Global v3d_rtBpp.i    = 0
Global v3d_rtClamp.i  = 0

Global v3d_clearColor.i = 0
Global v3d_clearZ.i     = 0
Global v3d_clearS.i     = 0

Global v3d_taAddr.i  = 0
Global v3d_taBytes.i = 0
Global v3d_tsAddr.i  = 0
Global v3d_tsBytes.i = 0
Global v3d_ovAddr.i  = 0
Global v3d_ovBytes.i = 0

Global v3d_haveGeom.i = 0
Global v3d_haveRt.i   = 0
Global v3d_havePool.i = 0
Global v3d_haveBcl.i  = 0
Global v3d_haveRcl.i  = 0

; A complete render-geometry answer.  This is deliberately a value record:
; V3dRenderPlanBuild changes no live V3D state, so Neon can prove that its
; already-carved pools can hold a new surface before the current surface is
; disturbed.
Structure V3dRenderPlan
  width.i
  height.i
  outFmt.i
  nrRts.i
  msaa.i
  doubleBuffer.i
  internalType.i
  internalBpp.i
  clamp.i
  tileW.i
  tileH.i
  tilesX.i
  tilesY.i
  supertileW.i
  supertileH.i
  frameSupertilesW.i
  frameSupertilesH.i
  layers.i
  tileAllocBytes.i
  tileStateBytes.i
EndStructure

; Evidence, all of it, remembered across the two waits so that a
; failed run prints one table instead of the caller having to know
; which register to ask for.
Global v3d_binJobs.i     = 0
Global v3d_binSpins.i    = 0
Global v3d_binBfcBefore.i = 0
Global v3d_binBfcAfter.i  = 0
Global v3d_binIntSts.i   = 0
Global v3d_binCt0cs.i    = 0
Global v3d_binCt0ca.i    = 0
Global v3d_binCt0ea.i    = 0
Global v3d_binPcs.i      = 0
Global v3d_binBpca.i     = 0
Global v3d_binBpcs.i     = 0
Global v3d_binMmuCtl.i   = 0
Global v3d_binVioAddr.i  = 0
Global v3d_binVioId.i    = 0
Global v3d_binErrStat.i  = 0
Global v3d_binOomCount.i = 0

Global v3d_renJobs.i     = 0
Global v3d_renSpins.i    = 0
Global v3d_renRfcBefore.i = 0
Global v3d_renRfcAfter.i  = 0
Global v3d_renIntSts.i   = 0
Global v3d_renCt1cs.i    = 0
Global v3d_renCt1ca.i    = 0
Global v3d_renCt1ea.i    = 0
Global v3d_renPcs.i      = 0
Global v3d_renMmuCtl.i   = 0
Global v3d_renVioAddr.i  = 0
Global v3d_renVioId.i    = 0
Global v3d_renErrStat.i  = 0
Global v3d_renCleanRc.i  = 0

; ----------------------------------------------------------------------
;  V3dRenderBegin - the frame, and everything the hardware derives
;  from it.
;
;  Returns #V3D_OK or #V3D_ERR_CL_ARGS.
; ----------------------------------------------------------------------
Procedure.i V3dRenderPlanBuild(width.i, height.i, outFmt.i, nrRts.i, msaa.i, doubleBuffer.i, *plan.V3dRenderPlan)
  Protected idx.i
  Protected bpp.i
  Protected ty.i
  Protected cl.i
  Protected tileW.i
  Protected tileH.i
  Protected tilesX.i
  Protected tilesY.i
  Protected stW.i
  Protected stH.i
  Protected fw.i
  Protected fh.i

  If *plan = 0
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf
  If width < 1 Or width > 65535 Or height < 1 Or height > 65535
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf
  If nrRts < 1 Or nrRts > 16
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf
  If msaa <> 0 And msaa <> 1
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf
  If doubleBuffer <> 0 And doubleBuffer <> 1
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf
  ; The current packet builders deliberately implement one render target,
  ; no MSAA and no hardware double-buffer mode.  The planner accepts the
  ; vocabulary only when the rest of the submission path can encode it.
  If nrRts <> 1 Or msaa <> 0 Or doubleBuffer <> 0
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf

  ty  = V3dInternalTypeFor(outFmt)
  bpp = V3dInternalBppFor(outFmt)
  cl  = V3dRtClampFor(outFmt)
  If ty < 0 Or bpp < 0
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf
  If cl < 0
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf

  idx = V3dTileSizeIndex(nrRts, bpp, msaa, doubleBuffer)
  tileW = V3dTileWidthOf(idx)
  tileH = V3dTileHeightOf(idx)
  If tileW < 1 Or tileH < 1
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf

  ; v3d_job.c:439-442 - DIV_ROUND_UP of the framebuffer size by the
  ; tile size. A frame that is not a whole number of tiles renders
  ; partial tiles at its right and bottom edges, which is normal and
  ; is why the store carries a stride rather than a size.
  tilesX = (width  + tileW - 1) / tileW
  tilesY = (height + tileH - 1) / tileH
  ; MULTICORE_RENDERING_SUPERTILE_CFG has twelve bits per tile count.
  If tilesX > 4095 Or tilesY > 4095
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf

  ; The supertile sizing loop, v3dx_rcl.c:516-532. Grow the supertile
  ; until the frame needs fewer than 256 of them, always growing the
  ; smaller dimension so they stay as square as they can.
  stW = 1
  stH = 1
  Repeat
    fw = (tilesX + stW - 1) / stW
    fh = (tilesY + stH - 1) / stH
    If (fw * fh) < #V3D_MAX_SUPERTILES
      Break
    EndIf
    If stW < stH
      stW = stW + 1
    Else
      stH = stH + 1
    EndIf
    ; A bound that Mesa does not have. Mesa's loop is unbounded
    ; because its inputs come from a validated framebuffer; here the
    ; width and height are whatever a caller passed and an unbounded
    ; loop on a bad one is a hang with no message, which this file
    ; refuses to have anywhere.  The supertile dimensions themselves are
    ; eight-bit fields, so a value above 256 cannot be encoded as value-1.
    If stW > 256 Or stH > 256
      ProcedureReturn #V3D_ERR_CL_ARGS
    EndIf
  ForEver

  ; Those two fields are eight-bit counts, not minus-one fields.
  If fw > 255 Or fh > 255
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf

  *plan\width = width
  *plan\height = height
  *plan\outFmt = outFmt
  *plan\nrRts = nrRts
  *plan\msaa = msaa
  *plan\doubleBuffer = doubleBuffer
  *plan\internalType = ty
  *plan\internalBpp = bpp
  *plan\clamp = cl
  *plan\tileW = tileW
  *plan\tileH = tileH
  *plan\tilesX = tilesX
  *plan\tilesY = tilesY
  *plan\supertileW = stW
  *plan\supertileH = stH
  *plan\frameSupertilesW = fw
  *plan\frameSupertilesH = fh
  *plan\layers = 1
  *plan\tileAllocBytes = V3dTileAllocBytesFor(tilesX, tilesY, 1)
  *plan\tileStateBytes = V3dTileStateBytesFor(tilesX, tilesY, 1)
  ProcedureReturn #V3D_OK
EndProcedure

Procedure.i V3dRenderBegin(width.i, height.i, outFmt.i)
  Protected plan.V3dRenderPlan
  Protected r.i

  v3d_haveGeom = 0
  v3d_haveRt   = 0
  v3d_haveBcl  = 0
  v3d_haveRcl  = 0

  r = V3dRenderPlanBuild(width, height, outFmt, 1, 0, 0, @plan)
  If r <> #V3D_OK
    v3d_err = r
    ProcedureReturn r
  EndIf

  v3d_rtOutFmt = plan\outFmt
  v3d_rtType = plan\internalType
  v3d_rtBpp = plan\internalBpp
  v3d_rtClamp = plan\clamp
  v3d_jobW = plan\width
  v3d_jobH = plan\height
  v3d_jobTileW = plan\tileW
  v3d_jobTileH = plan\tileH
  v3d_jobTilesX = plan\tilesX
  v3d_jobTilesY = plan\tilesY
  v3d_jobStW = plan\supertileW
  v3d_jobStH = plan\supertileH
  v3d_jobFwSt = plan\frameSupertilesW
  v3d_jobFhSt = plan\frameSupertilesH
  v3d_jobMaxBpp = plan\internalBpp
  v3d_jobLayers = plan\layers

  v3d_haveGeom = 1
  ProcedureReturn #V3D_OK
EndProcedure

; ----------------------------------------------------------------------
;  V3dRenderTarget - where the pixels go.
;
;  `bytes` is the extent for cache maintenance and for nothing else,
;  and it is not optional, for V3dTfuSubmit()'s reason: maintenance
;  that is structural cannot be forgotten and maintenance that is
;  remembered will be.
;
;  `strideOrUbHeight` is the byte stride for RASTER and the padded
;  height in UIF blocks for the UIF layouts - see
;  V3dClStoreTileBufferGeneral(). For RASTER this procedure CHECKS it
;  against the width and the format, because a stride that is not at
;  least width*bytes-per-pixel is not a stride, it is a typo, and the
;  resulting image is a diagonal smear that looks like a rasteriser
;  bug.
; ----------------------------------------------------------------------
Procedure.i V3dRenderTarget(addr.i, bytes.i, memFmt.i, strideOrUbHeight.i, rbSwap.i)
  Protected minStride.i

  v3d_haveRt  = 0
  v3d_haveRcl = 0

  If v3d_haveGeom = 0
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf
  If addr <= 0
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf
  If bytes <= 0
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf
  If memFmt < 0 Or memFmt > 5
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf
  If strideOrUbHeight < 0 Or strideOrUbHeight > $FFFFF
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf

  If memFmt = #V3D_MEMFMT_RASTER
    ; Four bytes per pixel for every 32-bit-internal format this file
    ; names except BGR565, which is two. The check is a floor and not
    ; an equality: a caller with padding at the end of each row is
    ; doing something legitimate.
    minStride = v3d_jobW * 4
    If v3d_rtOutFmt = #V3D_OFMT_BGR565
      minStride = v3d_jobW * 2
    EndIf
    If strideOrUbHeight < minStride
      v3d_err = #V3D_ERR_CL_ARGS
      ProcedureReturn #V3D_ERR_CL_ARGS
    EndIf
    If bytes < (strideOrUbHeight * v3d_jobH)
      v3d_err = #V3D_ERR_CL_ARGS
      ProcedureReturn #V3D_ERR_CL_ARGS
    EndIf
  EndIf

  v3d_rtAddr   = addr
  v3d_rtBytes  = bytes
  v3d_rtMemFmt = memFmt
  v3d_rtStride = strideOrUbHeight
  v3d_rtRbSwap = rbSwap
  v3d_haveRt   = 1
  ProcedureReturn #V3D_OK
EndProcedure

; ----------------------------------------------------------------------
;  V3dRenderClear - the clear values, as raw bit patterns.
;
;  See V3dClTrmcClearColor1() for the colour's format. `zClearBits` is
;  a 32-bit float pattern and `stencil` is a byte; both are written
;  whether or not there is a depth buffer, because ZS_CLEAR_VALUES is
;  the packet that TERMINATES the rendering-mode configuration
;  (v3dx_rcl.c:630-632) and is therefore always emitted.
; ----------------------------------------------------------------------
Procedure V3dRenderClear(colorLow32.i, zClearBits.i, stencil.i)
  v3d_clearColor = colorLow32
  v3d_clearZ     = zClearBits
  v3d_clearS     = stencil & $FF
  v3d_haveRcl    = 0
EndProcedure

; ----------------------------------------------------------------------
;  V3dRenderPool - the binner's tile allocation pool and the tile
;  state buffer.
;
;  BOTH ARE HANDED OVER AS REGISTERS AND NOT AS PACKETS ON THIS PART.
;  v3d_job.c:574-588: "On V3D 4.1, the tile alloc/state setup moved to
;  register writes instead of binner packets", and the three values
;  become submit.qma, submit.qms and submit.qts, which
;  v3d_bin_job_run writes to CT0QMA, CT0QMS and CT0QTS
;  (v3d_sched.c:216-227).
;
;  THE SIZES ARE CHECKED AGAINST THE COMPUTED MINIMA, not trusted. A
;  pool one page short does not fail visibly; it makes the binner go
;  OOM, and if the OOM is not serviced FLDONE never arrives
;  (v3d_irq.c:93-96) and the symptom is a bin timeout with every
;  register looking healthy.
;
;  BOTH MUST BE 4096-ALIGNED. That is not stated as a hardware rule
;  anywhere on this disk - the kernel simply passes BO offsets, which
;  are page-aligned by construction (v3d_bo.c) - so this is a
;  conservative requirement rather than a transcription, and it is
;  cheap: CT0QTS's low bit is the ENABLE flag, so the tile state
;  address must be at least 4-aligned for certain, and every buffer
;  behind the V3D MMU is a page anyway.
; ----------------------------------------------------------------------
Procedure.i V3dRenderPool(tileAllocAddr.i, tileAllocBytes.i, tileStateAddr.i, tileStateBytes.i)
  v3d_havePool = 0

  If v3d_haveGeom = 0
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf
  If tileAllocAddr <= 0 Or (tileAllocAddr % 4096) <> 0
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf
  If tileStateAddr <= 0 Or (tileStateAddr % 4096) <> 0
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf
  If tileAllocBytes < V3dTileAllocBytesFor(v3d_jobTilesX, v3d_jobTilesY, v3d_jobLayers)
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf
  If tileStateBytes < V3dTileStateBytesFor(v3d_jobTilesX, v3d_jobTilesY, v3d_jobLayers)
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf

  v3d_taAddr  = tileAllocAddr
  v3d_taBytes = tileAllocBytes
  v3d_tsAddr  = tileStateAddr
  v3d_tsBytes = tileStateBytes
  v3d_havePool = 1
  ProcedureReturn #V3D_OK
EndProcedure

; ----------------------------------------------------------------------
;  V3dBinOverflow - register a spare pool for the OOM protocol.
;
;  Optional. Without it a binner that goes OOM is reported as
;  #V3D_ERR_BIN_OOM instead of being rescued, which is the honest
;  answer: handing the hardware an address that was never allocated
;  would be worse than stopping.
;
;  The kernel's own overflow chunk is 256 KB (v3d_irq.c:43).
; ----------------------------------------------------------------------
Procedure.i V3dBinOverflow(addr.i, bytes.i)
  If addr < 0
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf
  If addr > 0
    If (addr % 4096) <> 0
      v3d_err = #V3D_ERR_CL_ARGS
      ProcedureReturn #V3D_ERR_CL_ARGS
    EndIf
    If bytes < 4096
      v3d_err = #V3D_ERR_CL_ARGS
      ProcedureReturn #V3D_ERR_CL_ARGS
    EndIf
  EndIf
  v3d_ovAddr  = addr
  v3d_ovBytes = bytes
  ProcedureReturn #V3D_OK
EndProcedure

; ----------------------------------------------------------------------
;  Geometry accessors. All reads, all derived, all printed by the
;  diagnostics because a wrong tile count is the failure that looks
;  most like a wrong control list.
; ----------------------------------------------------------------------
Procedure.i V3dTileW()
  ProcedureReturn v3d_jobTileW
EndProcedure
Procedure.i V3dTileH()
  ProcedureReturn v3d_jobTileH
EndProcedure
Procedure.i V3dTilesX()
  ProcedureReturn v3d_jobTilesX
EndProcedure
Procedure.i V3dTilesY()
  ProcedureReturn v3d_jobTilesY
EndProcedure
Procedure.i V3dSupertileW()
  ProcedureReturn v3d_jobStW
EndProcedure
Procedure.i V3dSupertileH()
  ProcedureReturn v3d_jobStH
EndProcedure
Procedure.i V3dFrameStW()
  ProcedureReturn v3d_jobFwSt
EndProcedure
Procedure.i V3dFrameStH()
  ProcedureReturn v3d_jobFhSt
EndProcedure
Procedure.i V3dRtInternalType()
  ProcedureReturn v3d_rtType
EndProcedure
Procedure.i V3dRtInternalBpp()
  ProcedureReturn v3d_rtBpp
EndProcedure
Procedure.i V3dRtClamp()
  ProcedureReturn v3d_rtClamp
EndProcedure
Procedure.i V3dTileAllocNeeded()
  ProcedureReturn V3dTileAllocBytesFor(v3d_jobTilesX, v3d_jobTilesY, v3d_jobLayers)
EndProcedure
Procedure.i V3dTileStateNeeded()
  ProcedureReturn V3dTileStateBytesFor(v3d_jobTilesX, v3d_jobTilesY, v3d_jobLayers)
EndProcedure


; ======================================================================
;  THE BIN CONTROL LIST
;
;  V3dBclBegin() emits the prologue, the caller emits whatever state
;  and primitives it wants with the V3dCl* encoders, and V3dBclFinish()
;  caps it.
;
;  THE PROLOGUE IS v3dX(start_binning), v3dx_draw.c:43-140, MINUS
;  NOTHING that applies to a single-layer non-MSAA job. Five packets,
;  in this order, and the order is Mesa's:
;
;    NUMBER_OF_LAYERS         :91-95, and its comment says it must
;                             come BEFORE the binning mode config
;    TILE_BINNING_MODE_CFG    :116-128, the max_ver=42 arm
;    FLUSH_VCD_CACHE          :130-131, "There's definitely nothing in
;                             the VCD cache we want"
;    OCCLUSION_QUERY_COUNTER  :133-134, address 0, "Disable any
;                             leftover OQ state from another job"
;    START_TILE_BINNING       :136-139, whose comment quotes the
;                             hardware documentation directly:
;                             "Binning mode lists must have a Start
;                             Tile Binning item (6) after any prefix
;                             state data before the binning list
;                             proper starts."
;
;  A BIN LIST WITH NO PRIMITIVES IS A REAL AND SUPPORTED THING AND
;  THAT IS THE WHOLE BASIS OF THE CLEAR TEST. v3d_tlb_clear
;  (v3dx_draw.c:1671-1791) calls v3d_start_draw at :1788 and adds no
;  geometry at all; if the application then flushes, Mesa submits
;  exactly this prologue plus the FLUSH epilogue. The binner still
;  produces a per-tile list for every tile - empty - which is what the
;  render list's BRANCH_TO_IMPLICIT_TILE_LIST needs to exist.
; ======================================================================

Procedure.i V3dBclBegin(addr.i, bytes.i)
  Protected r.i

  v3d_haveBcl = 0
  If v3d_haveGeom = 0
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf

  r = V3dClBegin(addr, bytes)
  If r <> #V3D_OK
    ProcedureReturn r
  EndIf

  V3dClNumberOfLayers(v3d_jobLayers)
  V3dClTileBinningModeCfg(v3d_jobW, v3d_jobH, 1, v3d_jobMaxBpp, #V3D_TILE_BLOCK_64B, #V3D_TILE_BLOCK_64B)
  V3dClFlushVcdCache()
  V3dClOcclusionQueryCounter(0)
  V3dClStartTileBinning()

  If v3d_clErr <> #V3D_OK
    v3d_err = v3d_clErr
    ProcedureReturn v3d_clErr
  EndIf
  ProcedureReturn #V3D_OK
EndProcedure

; v3dX(bcl_epilogue), Reference/mesa-24.3.4_v3dx_job.c:33-69. For a
; job with no transform feedback the whole epilogue is one FLUSH, and
; the comment at :64-67 says why it is FLUSH and not FLUSH_ALL_STATE:
; "We just FLUSH here to tell the HW to cap the bin CLs with a return.
; Any remaining state changes won't be flushed to the bins first --
; you would need FLUSH_ALL for that, but the HW for hasn't been
; validated".
Procedure.i V3dBclFinish()
  Protected r.i
  V3dClFlush()
  r = V3dClFinish()
  If r <> #V3D_OK
    ProcedureReturn r
  EndIf
  v3d_bclStart = V3dClAddr()
  v3d_bclEnd   = V3dClEndAddr()
  v3d_haveBcl  = 1
  ProcedureReturn #V3D_OK
EndProcedure

Procedure.i V3dBclStartAddr()
  ProcedureReturn v3d_bclStart
EndProcedure
Procedure.i V3dBclEndAddr()
  ProcedureReturn v3d_bclEnd
EndProcedure
Procedure.i V3dBclBytes()
  ProcedureReturn v3d_bclEnd - v3d_bclStart
EndProcedure


; ======================================================================
;  THE RENDER CONTROL LIST AND ITS GENERIC TILE LIST
;
;  ONE CALL, BECAUSE THERE IS NOTHING FOR A CALLER TO DECIDE IN IT.
;  Everything in a single-render-target, no-depth, no-MSAA render list
;  is a function of the geometry and the target, both of which are
;  already registered. Exposing the thirty packets individually would
;  offer a choice about their ORDER, and the order is the one thing in
;  here that is load-bearing and undocumented.
;
;  THE TWO LISTS AND WHY THEY ARE SEPARATE BUFFERS. The render list
;  carries START_ADDRESS_OF_GENERIC_TILE_LIST, which holds the start
;  AND the end of the sub-list, and then goes on emitting supertile
;  coordinates afterwards - so the sub-list cannot be inline. Mesa
;  builds it in job->indirect (v3dx_rcl.c:324) for the same reason.
;
;  THE SEQUENCE, FROM v3dX(emit_rcl) (v3dx_rcl.c:618-853) AND
;  emit_render_layer (:499-616). Every line has its citation:
;
;    TILE_RENDERING_MODE_CFG_COMMON       :634-693
;    TILE_RENDERING_MODE_CFG_CLEAR_COLORS_PART1  :742-747
;    TILE_RENDERING_MODE_CFG_COLOR        :806-823
;    TILE_RENDERING_MODE_CFG_ZS_CLEAR_VALUES     :827-831
;    TILE_LIST_INITIAL_BLOCK_SIZE         :836-840
;    -- per layer, and there is one layer --
;    MULTICORE_RENDERING_TILE_LIST_SET_BASE      :509-511
;    MULTICORE_RENDERING_SUPERTILE_CFG    :513-543
;    TILE_COORDINATES (0,0)               :546-549
;    -- the GFXH-1742 loop, TWICE --      :564-583
;       [second pass only] TILE_COORDINATES
;       END_OF_LOADS
;       STORE_TILE_BUFFER_GENERAL buffer=NONE
;       [first pass only] CLEAR_TILE_BUFFERS
;       END_OF_TILE_MARKER
;    FLUSH_VCD_CACHE                      :584
;    START_ADDRESS_OF_GENERIC_TILE_LIST   :355-358
;    SUPERTILE_COORDINATES, one per supertile    :604-615
;    END_OF_RENDERING                     :852
;
;  and the generic tile list itself, :318-359:
;
;    TILE_COORDINATES_IMPLICIT            :331
;    END_OF_LOADS                         :214, from v3d_rcl_emit_loads
;                                         with nothing to load
;    PRIM_LIST_FORMAT triangles           :338-340
;    SET_INSTANCEID 0                     :343-345
;    BRANCH_TO_IMPLICIT_TILE_LIST         :347
;    STORE_TILE_BUFFER_GENERAL RT0        :111-147, from
;                                         v3d_rcl_emit_stores
;    CLEAR_TILE_BUFFERS                   :304-310
;    END_OF_TILE_MARKER                   :351
;    RETURN_FROM_SUB_LIST                 :353
;
;  THE TWO-ITERATION LOOP IS THE STRANGEST THING IN HERE AND IT IS
;  NOT AN OPTIMISATION. Mesa's comment, v3dx_rcl.c:556-562, is the
;  entire justification that exists anywhere:
;
;     "Also, implement the GFXH-1742 workaround. There's a race in the
;      HW between the RCL updating the TLB's internal type/size and
;      the spawning of the QPU instances using the TLB's current
;      internal type/size. To make sure the QPUs get the right state,
;      we need 1 dummy store in between internal type/size changes on
;      V3D 3.x, and 2 dummy stores on 4.x."
;
;  Two dummy stores on 4.x. This part is 4.2. The loop is transcribed
;  and not reasoned about, and it is NOT reduced to one iteration
;  "because the second looks redundant" - a race that a workaround
;  hides is a race that reappears as an intermittent wrong colour
;  months later.
;
;  THE CLEAR HAPPENS AT THE END OF THE TILE, WHICH READS BACKWARDS.
;  v3dx_rcl.c:551-555: "Emit an initial clear of the tile buffers.
;  This is necessary for any buffers that should be cleared (since
;  clearing normally happens at the *end* of the generic tile list)".
;  So the prologue's clear prepares tile 0, and the clear at the end
;  of the generic tile list prepares tile N+1 after tile N has been
;  stored. With one tile only the first of the two does anything,
;  which is another reason the 64x64 case is the right first test:
;  fewer moving parts, and the ones that are moving are visible.
; ======================================================================

Procedure.i V3dRclBuild(tileListAddr.i, tileListBytes.i, rclAddr.i, rclBytes.i)
  Protected r.i
  Protected i.i
  Protected x.i
  Protected y.i
  Protected stWpx.i
  Protected stHpx.i
  Protected minXst.i
  Protected minYst.i
  Protected maxXst.i
  Protected maxYst.i

  v3d_haveRcl = 0

  If v3d_haveGeom = 0 Or v3d_haveRt = 0
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf
  If v3d_havePool = 0
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf

  ; ------------------------------------------------------------------
  ;  1. THE GENERIC TILE LIST, first, because the render list needs
  ;     its start and end addresses.
  ; ------------------------------------------------------------------
  r = V3dClBegin(tileListAddr, tileListBytes)
  If r <> #V3D_OK
    ProcedureReturn r
  EndIf

  V3dClTileCoordsImplicit()

  ; No loads. v3d_rcl_emit_loads emits one LOAD_TILE_BUFFER_GENERAL
  ; per buffer in job->load and then END_OF_LOADS; with nothing to
  ; load it emits only the terminator. END_OF_LOADS is what switches
  ; the tile from loading to rendering on 4.x - v3dx_rcl.c:328-329,
  ; "V3D 4.x/7.x only requires a single tile coordinates, and
  ; END_OF_LOADS switches us between loading and rendering."
  V3dClEndOfLoads()

  V3dClPrimListFormat(#V3D_PLF_TRIANGLES, 0)
  V3dClSetInstanceId(0)
  V3dClBranchToImplicitTileList(0)

  ; The real store. clearAfterStore stays false: v3dx_rcl.c:115 sets
  ; `store.clear_buffer_being_stored = false` and GFXH-1461/GFXH-1689
  ; (:299-303) says that bit is broken for depth/stencil anyway. The
  ; clear is done by the separate CLEAR_TILE_BUFFERS below.
  V3dClStoreTileBufferGeneral(#V3D_BUF_RT0, v3d_rtAddr, v3d_rtOutFmt, v3d_rtMemFmt, v3d_rtStride, v3d_rtRbSwap, 0)

  ; job->clear_tlb is set for a target nothing has written yet
  ; (v3d_job.c:419-425), so v3d_rcl_emit_stores emits this.
  V3dClClearTileBuffers(1, 1)

  V3dClEndOfTileMarker()
  V3dClReturnFromSubList()

  r = V3dClFinish()
  If r <> #V3D_OK
    ProcedureReturn r
  EndIf
  v3d_tlStart = V3dClAddr()
  v3d_tlEnd   = V3dClEndAddr()

  ; ------------------------------------------------------------------
  ;  2. THE RENDER LIST.
  ; ------------------------------------------------------------------
  r = V3dClBegin(rclAddr, rclBytes)
  If r <> #V3D_OK
    ProcedureReturn r
  EndIf

  ; Early-Z is DISABLED because there is no depth buffer. Internal
  ; depth type is left at 0 for the same reason - it is only read when
  ; there is a zsbuf, and Mesa leaves it at the packet default in that
  ; case (v3dx_rcl.c:635-638 only sets it inside `if (job->zsbuf)`).
  V3dClTrmcCommon(v3d_jobW, v3d_jobH, 1, v3d_jobMaxBpp, 1, 0)
  V3dClTrmcClearColor1(0, v3d_clearColor, 0)
  V3dClTrmcColor(v3d_rtBpp, v3d_rtType, v3d_rtClamp)
  V3dClTrmcZsClear(v3d_clearZ, v3d_clearS)
  V3dClTileListInitialBlockSize(1, #V3D_TILE_BLOCK_64B)

  ; One layer, so the tile-alloc offset (v3dx_rcl.c:507-508) is zero.
  V3dClMulticoreTileListSetBase(v3d_taAddr, 0)
  V3dClMulticoreSupertileCfg(v3d_jobStW, v3d_jobStH, v3d_jobFwSt, v3d_jobFhSt, v3d_jobTilesX, v3d_jobTilesY, 1)

  V3dClTileCoordinates(0, 0)

  ; The GFXH-1742 loop. Transcribed, not reasoned about.
  i = 0
  While i < 2
    If i > 0
      ; v3dx_rcl.c:565-566 emits TILE_COORDINATES with no arguments on
      ; the second pass, i.e. every field at its default of zero,
      ; which is the same (0,0) as the explicit one above.
      V3dClTileCoordinates(0, 0)
    EndIf
    V3dClEndOfLoads()
    V3dClStoreNone()
    If i = 0
      ; do_double_initial_tile_clear() (v3dx_rcl.c:484-497) is false
      ; without double-buffering, so the clear happens on the first
      ; pass only.
      V3dClClearTileBuffers(1, 1)
    EndIf
    V3dClEndOfTileMarker()
    i = i + 1
  Wend

  V3dClFlushVcdCache()
  V3dClStartAddressOfGenericTileList(v3d_tlStart, v3d_tlEnd)

  ; The supertile sweep, v3dx_rcl.c:592-615. draw_min_x and
  ; draw_min_y are zero and draw_max_x/y are the frame size, which is
  ; what v3d_tlb_clear sets (v3dx_draw.c:1780-1783) for a full-surface
  ; clear and what a full-surface draw sets too.
  stWpx = v3d_jobTileW * v3d_jobStW
  stHpx = v3d_jobTileH * v3d_jobStH
  minXst = 0
  minYst = 0
  maxXst = (v3d_jobW - 1) / stWpx
  maxYst = (v3d_jobH - 1) / stHpx

  y = minYst
  While y <= maxYst
    x = minXst
    While x <= maxXst
      V3dClSupertileCoordinates(x, y)
      x = x + 1
    Wend
    y = y + 1
  Wend

  V3dClEndOfRendering()

  r = V3dClFinish()
  If r <> #V3D_OK
    ProcedureReturn r
  EndIf
  v3d_rclStart = V3dClAddr()
  v3d_rclEnd   = V3dClEndAddr()
  v3d_haveRcl  = 1
  ProcedureReturn #V3D_OK
EndProcedure

Procedure.i V3dRclStartAddr()
  ProcedureReturn v3d_rclStart
EndProcedure
Procedure.i V3dRclEndAddr()
  ProcedureReturn v3d_rclEnd
EndProcedure
Procedure.i V3dRclBytes()
  ProcedureReturn v3d_rclEnd - v3d_rclStart
EndProcedure
Procedure.i V3dTileListStartAddr()
  ProcedureReturn v3d_tlStart
EndProcedure
Procedure.i V3dTileListEndAddr()
  ProcedureReturn v3d_tlEnd
EndProcedure
Procedure.i V3dTileListBytes()
  ProcedureReturn v3d_tlEnd - v3d_tlStart
EndProcedure


; ======================================================================
;  SUBMISSION - ten register writes and two counter polls
;
;  This is the part stage 0's header said was fully specified and
;  could be written that day, and it was right. The sequence is
;  v3d_bin_job_run and v3d_render_job_run (v3d_sched.c:196-273) cross
;  checked against v3dX(simulator_submit_cl_ioctl)
;  (v3dx_simulator.c:504-548), and the two agree write for write.
;
;  WRITING THE END ADDRESS IS WHAT STARTS THE JOB. v3d_sched.c:214-215
;  says so: "Set the current and end address of the control list.
;  Writing the end register is what starts the job." So CT0QBA before
;  CT0QEA, always, and the barrier goes between the DRAM stores that
;  built the list and the register write that launches it.
;
;  THE BINNER MUST FINISH BEFORE THE RENDERER STARTS, and this file
;  enforces it rather than trusting the caller. v3dx_simulator.c:532
;  spells out why the simulator does it by hand: "Wait for bin to
;  complete before firing render. The kernel's scheduler implements
;  this using the GPU scheduler blocking on the bin fence completing.
;  (We don't use HW semaphores)." The render list's
;  BRANCH_TO_IMPLICIT_TILE_LIST reads a per-tile list the binner
;  writes; firing the renderer first reads whatever was in the tile
;  allocation pool from last time.
; ======================================================================

; ----------------------------------------------------------------------
;  V3dBinSubmit - CT0QMA, CT0QMS, CT0QTS, CT0QBA, CT0QEA.
; ----------------------------------------------------------------------
Procedure.i V3dBinSubmit()
  If v3d_ready = 0
    v3d_err = #V3D_ERR_NOINIT
    ProcedureReturn #V3D_ERR_NOINIT
  EndIf
  ; Every address in every one of these buffers is a VIRTUAL address
  ; to the CLE, the PTB and the TLB, exactly as it is to the TFU and
  ; the CSD. Submitting with no page table hands the engine numbers
  ; that mean nothing.
  If v3d_mmuOn = 0
    v3d_err = #V3D_ERR_MMU_OFF
    ProcedureReturn #V3D_ERR_MMU_OFF
  EndIf
  If v3d_haveBcl = 0 Or v3d_havePool = 0
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf

  ; STRUCTURAL MAINTENANCE, every buffer the job touches, by extent.
  ; With the ARM MMU off these are `dc civac` on lines that were never
  ; allocated and cost a handful of cycles; with DRAM cacheable they
  ; are the difference between the binner reading the control list the
  ; CPU wrote and the binner reading what was in DRAM before it.
  V3dCacheRange(v3d_bclStart, v3d_bclEnd - v3d_bclStart)
  V3dCacheRange(v3d_taAddr, v3d_taBytes)
  V3dCacheRange(v3d_tsAddr, v3d_tsBytes)

  ; v3d_bin_job_run's own first act, v3d_sched.c:196, with its
  ; comment: "Clear out the overflow allocation, so we don't reuse the
  ; overflow attached to a previous job." Under the job_lock in the
  ; kernel because an interrupt could be servicing an OOM from the
  ; last job; here there is no interrupt and no second thread.
  V3dCoreWrite(#V3D_PTB_BPOS, 0)

  ; v3d_sched.c:199. The bin path invalidates the core's caches, and
  ; unlike the TFU path this is not optional: the CLE, the PTB and the
  ; VCD all read through them.
  V3dInvalidateCaches()

  ; Clear the sticky status this job's evidence will be read from.
  V3dCoreWrite(#V3D_CTL_INT_CLR, #V3D_CTL_INT_FLDONE | #V3D_CTL_INT_OUTOMEM)

  V3dCoreWrite(#V3D_CLE_CT0QMA, v3d_taAddr)
  V3dCoreWrite(#V3D_CLE_CT0QMS, v3d_taBytes)
  V3dCoreWrite(#V3D_CLE_CT0QTS, #V3D_CLE_CT0QTS_ENABLE | v3d_tsAddr)

  v3d_binBfcBefore = V3dCoreRead(#V3D_CLE_BFC)

  ; THE BARRIER IS LOAD BEARING. The register writes above are Device
  ; memory and are ordered against each other by the memory type, but
  ; NOT against the DRAM stores that wrote the control list. Without
  ; it the CLE can start fetching before the packets have landed, and
  ; a binner executing half a list is not a failure mode with a status
  ; bit - it is a hang or a wrong tile list.
  V3dBarrier()

  V3dCoreWrite(#V3D_CLE_CT0QBA, v3d_bclStart)
  V3dCoreWrite(#V3D_CLE_CT0QEA, v3d_bclEnd)
  V3dBarrier()

  v3d_binJobs = v3d_binJobs + 1
  ProcedureReturn #V3D_OK
EndProcedure

; ----------------------------------------------------------------------
;  V3dBinWait - spin on CLE_BFC, and SERVICE THE OUT-OF-MEMORY
;  CONDITION, which is not optional.
;
;  v3d_irq.c:92-98, and this is the sentence that makes the OOM branch
;  mandatory rather than a nicety: "Note that the OOM status is edge
;  signaled, so the interrupt won't happen again until the we actually
;  add more memory. Also, as of V3D 4.1, FLDONE won't be reported
;  until any OOM state has been cleared."
;
;  So a bin job that runs out of pool NEVER reports done. A loop that
;  only watched BFC would spin to its deadline and report a timeout,
;  and the register that explains it is one the loop never read.
;
;  THE HAND-OVER IS TWO WRITES IN THIS ORDER: PTB_BPOA then PTB_BPOS
;  (v3d_irq.c:73-74). The size register is written second, which is
;  consistent with everything else in this block where the second
;  write is the one that commits - and it is transcribed in that order
;  rather than reasoned about.
;
;  ONE OVERFLOW CHUNK, NOT A CHAIN. The kernel allocates a fresh
;  256 KB every time its work item runs. Here there is one registered
;  pool and it is handed over once; a second OOM after that is
;  reported as #V3D_ERR_BIN_OOM rather than handing the same memory
;  over twice, which would corrupt the tile lists already in it.
; ----------------------------------------------------------------------
Procedure.i V3dBinWait(us.i)
  Protected bfc.i
  Protected hz.i
  Protected deadline.i
  Protected spins.i
  Protected rc.i
  Protected sts.i
  Protected served.i

  If v3d_binJobs = 0
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf

  hz = V3dCounterHz()
  deadline = 0
  If hz > 0
    deadline = V3dTicks() + ((hz / 1000000) * us)
  EndIf
  spins  = 0
  served = 0
  rc     = #V3D_ERR_BIN_TIMEOUT

  Repeat
    bfc = V3dCoreRead(#V3D_CLE_BFC)
    If bfc <> v3d_binBfcBefore
      rc = #V3D_OK
      Break
    EndIf

    sts = V3dCoreRead(#V3D_CTL_INT_STS)
    If (sts & #V3D_CTL_INT_OUTOMEM) <> 0
      v3d_binOomCount = v3d_binOomCount + 1
      If v3d_ovAddr > 0 And served = 0
        V3dCacheRange(v3d_ovAddr, v3d_ovBytes)
        V3dBarrier()
        V3dCoreWrite(#V3D_PTB_BPOA, v3d_ovAddr)
        V3dCoreWrite(#V3D_PTB_BPOS, v3d_ovBytes)
        V3dBarrier()
        served = 1
        ; Clearing the status is what re-arms the edge, per the
        ; comment quoted above. Clear it AFTER the memory is handed
        ; over, never before, or the binner sees the clear with no new
        ; pool behind it.
        V3dCoreWrite(#V3D_CTL_INT_CLR, #V3D_CTL_INT_OUTOMEM)
      Else
        rc = #V3D_ERR_BIN_OOM
        Break
      EndIf
    EndIf

    ; A page fault ends the wait early rather than at the deadline:
    ; with PT_INVALID_ABORT set the access was aborted and the bin is
    ; not going to complete. Reporting it after 100 ms of spinning
    ; would be the same answer, later.
    If (V3dHubRead(#V3D_MMU_CTL) & #V3D_MMU_CTL_FAULTS) <> 0
      rc = #V3D_ERR_MMU_FAULT
      Break
    EndIf

    spins = spins + 1
    If spins > #V3D_SPIN_LIMIT
      Break
    EndIf
    If hz > 0
      If V3dTicks() > deadline
        Break
      EndIf
    EndIf
  ForEver

  V3dBarrier()
  v3d_binSpins    = spins
  v3d_binBfcAfter = V3dCoreRead(#V3D_CLE_BFC)
  v3d_binIntSts   = V3dCoreRead(#V3D_CTL_INT_STS)
  v3d_binCt0cs    = V3dCoreRead(#V3D_CLE_CT0CS)
  v3d_binCt0ca    = V3dCoreRead(#V3D_CLE_CT0CA)
  v3d_binCt0ea    = V3dCoreRead(#V3D_CLE_CT0EA)
  v3d_binPcs      = V3dCoreRead(#V3D_CLE_PCS)
  v3d_binBpca     = V3dCoreRead(#V3D_PTB_BPCA)
  v3d_binBpcs     = V3dCoreRead(#V3D_PTB_BPCS)
  v3d_binErrStat  = V3dCoreRead(#V3D_ERR_STAT)
  v3d_binMmuCtl   = V3dHubRead(#V3D_MMU_CTL)
  v3d_binVioAddr  = V3dHubRead(#V3D_MMU_VIO_ADDR)
  v3d_binVioId    = V3dHubRead(#V3D_MMU_VIO_ID)

  ; A bin that completed AND faulted has produced a tile list built
  ; partly from an aborted access, and the counter moving does not
  ; undo that. The fault wins, exactly as it does in V3dCsdWait().
  If rc = #V3D_OK
    If (v3d_binMmuCtl & #V3D_MMU_CTL_FAULTS) <> 0
      v3d_err = #V3D_ERR_MMU_FAULT
      ProcedureReturn #V3D_ERR_MMU_FAULT
    EndIf
  EndIf

  v3d_err = rc
  ProcedureReturn rc
EndProcedure

; ----------------------------------------------------------------------
;  V3dRenderSubmit - CT1QBA, CT1QEA. Two writes, and no pool
;  registers: the renderer reads the tile lists the binner already
;  wrote and allocates nothing.
; ----------------------------------------------------------------------
Procedure.i V3dRenderSubmit()
  If v3d_ready = 0
    v3d_err = #V3D_ERR_NOINIT
    ProcedureReturn #V3D_ERR_NOINIT
  EndIf
  If v3d_mmuOn = 0
    v3d_err = #V3D_ERR_MMU_OFF
    ProcedureReturn #V3D_ERR_MMU_OFF
  EndIf
  If v3d_haveRcl = 0
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf

  ; THE BIN MUST HAVE COMPLETED. See the section header - the render
  ; list branches into a per-tile list that only the binner produces.
  ; Enforced rather than documented, because the failure without it is
  ; a renderer executing whatever bytes were in the tile allocation
  ; pool, which on a fresh boot is uninitialised DRAM interpreted as
  ; control-list packets.
  If v3d_binJobs = 0
    v3d_err = #V3D_ERR_JOB_BUSY
    ProcedureReturn #V3D_ERR_JOB_BUSY
  EndIf
  If v3d_binBfcAfter = v3d_binBfcBefore
    v3d_err = #V3D_ERR_JOB_BUSY
    ProcedureReturn #V3D_ERR_JOB_BUSY
  EndIf

  V3dCacheRange(v3d_rclStart, v3d_rclEnd - v3d_rclStart)
  V3dCacheRange(v3d_tlStart, v3d_tlEnd - v3d_tlStart)
  V3dCacheRange(v3d_rtAddr, v3d_rtBytes)

  ; v3d_sched.c:251, and its comment is worth keeping because it says
  ; why the flush is repeated when the bin already did one: "Can we
  ; avoid this flush? We need to be careful of scheduling, though --
  ; imagine job0 rendering to texture and job1 reading, and them being
  ; executed as bin0, bin1, render0, render1, so that render1's flush
  ; at bin time wasn't enough."
  V3dInvalidateCaches()

  V3dCoreWrite(#V3D_CTL_INT_CLR, #V3D_CTL_INT_FRDONE)
  v3d_renRfcBefore = V3dCoreRead(#V3D_CLE_RFC)

  V3dBarrier()
  V3dCoreWrite(#V3D_CLE_CT1QBA, v3d_rclStart)
  V3dCoreWrite(#V3D_CLE_CT1QEA, v3d_rclEnd)
  V3dBarrier()

  v3d_renJobs = v3d_renJobs + 1
  ProcedureReturn #V3D_OK
EndProcedure

; ----------------------------------------------------------------------
;  V3dRenderWait - spin on CTL_INT_STS.FRDONE, then clean.
;
;  FRDONE IS THE COMPLETION CONTRACT, NOT CLE_RFC. Linux v3d_irq.c
;  signals the render job's fence from V3D_INT_FRDONE, and
;  v3d_sched.c starts the render job after the cache invalidation that
;  belongs to that submission. A Pi 4 proof showed why the distinction
;  matters: CLE_RFC advanced while one immediate CPU sample still saw
;  the pre-render clear value; after a later cache transition the same
;  location contained the rendered pixel. RFC remains useful telemetry,
;  but it is not allowed to publish completion.
;
;  ON THE CLEAN:
;  v3d_drm.h:143-149 states that TLB writes are already flushed by the
;  time the render-done event happens, and that only TMU writes can
;  leave dirty cachelines. Nothing in this stage does a TMU write. So
;  by the documentation the clean is unnecessary.
;
;  It runs anyway because FLM_CLEAN cannot lose data - v3d_regs.h:259
;  to :261, "Writes out dirty cachelines and marks them clean, without
;  invalidating". It also preserves the explicit stage-2 defence where
;  every job register said success while the output page was still
;  poison. V3dRenderCleanResult() reports it separately so a reader can
;  see it ran.
;
;  NOTE WHICH OPERATION THIS IS AND DO NOT "SIMPLIFY" IT TO
;  V3dInvalidateCaches(). That one uses FLM_FLUSH, which INVALIDATES.
;  If the cache did hold the only copy of a pixel, an invalidate would
;  destroy it - which is exactly the mistake stage 2 nearly made.
; ----------------------------------------------------------------------
Procedure.i V3dRenderWait(us.i)
  Protected sts.i
  Protected hz.i
  Protected deadline.i
  Protected spins.i
  Protected rc.i

  If v3d_renJobs = 0
    v3d_err = #V3D_ERR_CL_ARGS
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf

  hz = V3dCounterHz()
  deadline = 0
  If hz > 0
    deadline = V3dTicks() + ((hz / 1000000) * us)
  EndIf
  spins = 0
  rc    = #V3D_ERR_RENDER_TIMEOUT

  Repeat
    sts = V3dCoreRead(#V3D_CTL_INT_STS)
    If (sts & #V3D_CTL_INT_FRDONE) <> 0
      rc = #V3D_OK
      Break
    EndIf

    If (V3dHubRead(#V3D_MMU_CTL) & #V3D_MMU_CTL_FAULTS) <> 0
      rc = #V3D_ERR_MMU_FAULT
      Break
    EndIf

    spins = spins + 1
    If spins > #V3D_SPIN_LIMIT
      Break
    EndIf
    If hz > 0
      If V3dTicks() > deadline
        Break
      EndIf
    EndIf
  ForEver

  ; The clean runs even when the wait failed, for V3dCsdWait()'s
  ; reason: a render that timed out may still have stored some tiles,
  ; and those pixels are the most informative thing a failed run can
  ; produce.
  v3d_renCleanRc = V3dCleanCaches()
  V3dBarrier()

  ; And the ARM side of the same edge. With the ARM MMU off this is
  ; free; with DRAM cacheable it is what stops the CPU reading the
  ; poison it wrote a moment earlier over the top of the GPU's pixels.
  ; Note that V3dCacheRange() is `dc civac`, clean AND invalidate, so
  ; it is correct in both directions - see the coherency section at
  ; the top of this file.
  V3dCacheRange(v3d_rtAddr, v3d_rtBytes)
  V3dBarrier()

  v3d_renSpins    = spins
  v3d_renRfcAfter = V3dCoreRead(#V3D_CLE_RFC)
  v3d_renIntSts   = V3dCoreRead(#V3D_CTL_INT_STS)
  v3d_renCt1cs    = V3dCoreRead(#V3D_CLE_CT1CS)
  v3d_renCt1ca    = V3dCoreRead(#V3D_CLE_CT1CA)
  v3d_renCt1ea    = V3dCoreRead(#V3D_CLE_CT1EA)
  v3d_renPcs      = V3dCoreRead(#V3D_CLE_PCS)
  v3d_renErrStat  = V3dCoreRead(#V3D_ERR_STAT)
  v3d_renMmuCtl   = V3dHubRead(#V3D_MMU_CTL)
  v3d_renVioAddr  = V3dHubRead(#V3D_MMU_VIO_ADDR)
  v3d_renVioId    = V3dHubRead(#V3D_MMU_VIO_ID)

  If rc = #V3D_OK
    If (v3d_renMmuCtl & #V3D_MMU_CTL_FAULTS) <> 0
      v3d_err = #V3D_ERR_MMU_FAULT
      ProcedureReturn #V3D_ERR_MMU_FAULT
    EndIf
  EndIf

  ; The clean's own failure is reported last and only if nothing
  ; better is available, so that a caller told CACHE_TIMEOUT when the
  ; real fault was a page fault does not go and look at the wrong
  ; register.
  If rc = #V3D_OK
    If v3d_renCleanRc <> #V3D_OK
      v3d_err = v3d_renCleanRc
      ProcedureReturn v3d_renCleanRc
    EndIf
  EndIf

  v3d_err = rc
  ProcedureReturn rc
EndProcedure

; ----------------------------------------------------------------------
;  The evidence. All reads.
; ----------------------------------------------------------------------
Procedure.i V3dBinBfcBefore()
  ProcedureReturn v3d_binBfcBefore
EndProcedure
Procedure.i V3dBinBfcAfter()
  ProcedureReturn v3d_binBfcAfter
EndProcedure
Procedure.i V3dBinSpins()
  ProcedureReturn v3d_binSpins
EndProcedure
Procedure.i V3dBinIntSts()
  ProcedureReturn v3d_binIntSts
EndProcedure
Procedure.i V3dBinCt0cs()
  ProcedureReturn v3d_binCt0cs
EndProcedure
Procedure.i V3dBinCt0ca()
  ProcedureReturn v3d_binCt0ca
EndProcedure
Procedure.i V3dBinCt0ea()
  ProcedureReturn v3d_binCt0ea
EndProcedure
Procedure.i V3dBinPcs()
  ProcedureReturn v3d_binPcs
EndProcedure
Procedure.i V3dBinBpca()
  ProcedureReturn v3d_binBpca
EndProcedure
Procedure.i V3dBinBpcs()
  ProcedureReturn v3d_binBpcs
EndProcedure
Procedure.i V3dBinErrStat()
  ProcedureReturn v3d_binErrStat
EndProcedure
Procedure.i V3dBinMmuCtl()
  ProcedureReturn v3d_binMmuCtl
EndProcedure
Procedure.i V3dBinVioAddr()
  ProcedureReturn v3d_binVioAddr
EndProcedure
Procedure.i V3dBinVioId()
  ProcedureReturn v3d_binVioId
EndProcedure
Procedure.i V3dBinOomCount()
  ProcedureReturn v3d_binOomCount
EndProcedure
Procedure.i V3dBinJobs()
  ProcedureReturn v3d_binJobs
EndProcedure

Procedure.i V3dRenderRfcBefore()
  ProcedureReturn v3d_renRfcBefore
EndProcedure
Procedure.i V3dRenderRfcAfter()
  ProcedureReturn v3d_renRfcAfter
EndProcedure
Procedure.i V3dRenderSpins()
  ProcedureReturn v3d_renSpins
EndProcedure
Procedure.i V3dRenderIntSts()
  ProcedureReturn v3d_renIntSts
EndProcedure
Procedure.i V3dRenderCt1cs()
  ProcedureReturn v3d_renCt1cs
EndProcedure
Procedure.i V3dRenderCt1ca()
  ProcedureReturn v3d_renCt1ca
EndProcedure
Procedure.i V3dRenderCt1ea()
  ProcedureReturn v3d_renCt1ea
EndProcedure
Procedure.i V3dRenderPcs()
  ProcedureReturn v3d_renPcs
EndProcedure
Procedure.i V3dRenderErrStat()
  ProcedureReturn v3d_renErrStat
EndProcedure
Procedure.i V3dRenderMmuCtl()
  ProcedureReturn v3d_renMmuCtl
EndProcedure
Procedure.i V3dRenderVioAddr()
  ProcedureReturn v3d_renVioAddr
EndProcedure
Procedure.i V3dRenderVioId()
  ProcedureReturn v3d_renVioId
EndProcedure
Procedure.i V3dRenderCleanResult()
  ProcedureReturn v3d_renCleanRc
EndProcedure
Procedure.i V3dRenderJobs()
  ProcedureReturn v3d_renJobs
EndProcedure
