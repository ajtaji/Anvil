; 4 or 1. See sdio_SetBusWidth4 - one bit is a degraded success, not a
; failure, and this is how a caller finds out which it got.
Procedure.i SdioBusWidth()
  If sdio_width4 <> 0
    ProcedureReturn 4
  EndIf
  ProcedureReturn 1
EndProcedure

; Present State bit 16, Card Inserted. See sdio_ControllerPlausible:
; this is REPORTED, not acted on. The device on this controller is
; soldered down and the node is marked non-removable.
Procedure.i SdioCardDetectBit()
  ProcedureReturn (sdio_Rd(#SDIO_STATUS) >> 16) & 1
EndProcedure

; Present State bit 18, Card Detect Pin Level. Likewise.
Procedure.i SdioCardPinLevel()
  ProcedureReturn (sdio_Rd(#SDIO_STATUS) >> 18) & 1
EndProcedure

; ======================================================================
;  SdioIntBitName(bit) - the SDHCI Interrupt Status bits, by name.
;
;  EVERY NAME AND EVERY POSITION IS FROM
;  Datasheets/pi4/rpi-linux/rpi-6.12.y_sdhci.h lines 138-161, and the
;  line number is on each case. Nothing here is recalled.
;
;  WHY A DECODER AND NOT A HEXADECIMAL WORD IN THE LOG. The bench read
;  $00048000 by hand and had to be told what it meant, and the person
;  who decoded it had to be careful about a real trap: Linux names the
;  COMMAND error bits SDHCI_INT_TIMEOUT, _CRC, _END_BIT and _INDEX with
;  no "CMD" anywhere in them (lines 151-154), while the DATA ones are
;  spelled out as _DATA_TIMEOUT, _DATA_CRC and _DATA_END_BIT (lines
;  155-157). Two adjacent groups of four, one of them named as though it
;  were the general case. Every name below therefore says CMD or DATA
;  out loud, whatever the header calls it.
;
;  Returns a name for a bit index 0..31, or a marker for the ones the
;  specification reserves.
; ======================================================================
Procedure.i SdioIntBitName(bit.i)
  Select bit
    Case 0
      ProcedureReturn "COMMAND COMPLETE"              ; h:138
    Case 1
      ProcedureReturn "TRANSFER COMPLETE"             ; h:139
    Case 2
      ProcedureReturn "BLOCK GAP EVENT"               ; h:140
    Case 3
      ProcedureReturn "DMA INTERRUPT"                 ; h:141
    Case 4
      ProcedureReturn "BUFFER WRITE READY"            ; h:142
    Case 5
      ProcedureReturn "BUFFER READ READY"             ; h:143
    Case 6
      ProcedureReturn "CARD INSERTION"                ; h:144
    Case 7
      ProcedureReturn "CARD REMOVAL"                  ; h:145
    Case 8
      ProcedureReturn "CARD INTERRUPT"                ; h:146
    Case 12
      ProcedureReturn "RE-TUNING EVENT"               ; h:147
    Case 14
      ProcedureReturn "COMMAND QUEUING EVENT"         ; h:148
    Case 15
      ProcedureReturn "ERROR INTERRUPT (summary - the reason is one of the bits above 15)"
                                                      ; h:150
    Case 16
      ProcedureReturn "CMD TIMEOUT ERROR - nothing answered the command at all"
                                                      ; h:151
    Case 17
      ProcedureReturn "CMD CRC ERROR - a response arrived and its checksum was wrong"
                                                      ; h:152
    Case 18
      ProcedureReturn "CMD END BIT ERROR - a response arrived and its last bit was not 1. Something IS on the bus; the framing is wrong. Look at the clock, the pin pulls and the bus width, not at whether the device is present."
                                                      ; h:153
    Case 19
      ProcedureReturn "CMD INDEX ERROR - the response echoed a different command index"
                                                      ; h:154
    Case 20
      ProcedureReturn "DATA TIMEOUT ERROR"            ; h:155
    Case 21
      ProcedureReturn "DATA CRC ERROR"                ; h:156
    Case 22
      ProcedureReturn "DATA END BIT ERROR"            ; h:157
    Case 23
      ProcedureReturn "CURRENT LIMIT ERROR (bus power)"
                                                      ; h:158
    Case 24
      ProcedureReturn "AUTO CMD ERROR"                ; h:159
    Case 25
      ProcedureReturn "ADMA ERROR"                    ; h:160
    Case 26
      ProcedureReturn "TUNING ERROR"                  ; h:161
  EndSelect
  ProcedureReturn "reserved"
EndProcedure

; ----------------------------------------------------------------------
;  Whether a bit index is one the header names at all, so a caller can
;  print only the meaningful ones and not twenty rows of "reserved".
; ----------------------------------------------------------------------
Procedure.i SdioIntBitIsNamed(bit.i)
  If bit >= 0 And bit <= 8
    ProcedureReturn 1
  EndIf
  If bit = 12 Or bit = 14
    ProcedureReturn 1
  EndIf
  If bit >= 15 And bit <= 26
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

; ======================================================================
;  SdioR5BitName(bit) - the R5 response's STATUS byte, by name.
;
;  ADDED 2026-08-26, THE DAY IT WAS NEEDED. A bench run printed "the
;  card REFUSED the command - see SdioLastR5" and that is the point at
;  which the diagnostic stopped being one: it named a variable and made
;  a person go and look it up. The five bits mean five completely
;  different faults with five different fixes, so which one is set is
;  the entire content of the message.
;
;  EVERY NAME AND POSITION IS FROM
;  Datasheets/pi4/brcmfmac/v6.12_linux_mmc_sdio.h lines 55-60. R5's
;  layout is: bits 7:0 are the data byte, bits 15:8 are these flags.
;  R5_STATUS(x) is (x & 0xCB00) at line 60 - the five bits below - and
;  every one of them means the card declined.
; ======================================================================
Procedure.i SdioR5BitName(bit.i)
  Select bit
    Case 8
      ProcedureReturn "OUT OF RANGE - the byte or block count runs past what this function accepts. On a CYW43 function 1 the byte-mode ceiling is the FUNCTION's block size, 64, not the protocol's 512."
                                                      ; s:59
    Case 9
      ProcedureReturn "INVALID FUNCTION NUMBER - the command addressed a function this card does not have, or one that is not enabled"
                                                      ; s:58
    Case 11
      ProcedureReturn "GENERAL ERROR - an unspecified error occurred during the transfer"
                                                      ; s:57
    Case 14
      ProcedureReturn "ILLEGAL COMMAND - not legal for the card's current state"
                                                      ; s:56
    Case 15
      ProcedureReturn "COM CRC ERROR - the CRC of the previous command failed"
                                                      ; s:55
  EndSelect
  ProcedureReturn "reserved, or part of the response's data byte"
EndProcedure

; The five bits above are the whole of R5_STATUS, sdio.h line 60's mask
; $CB00. Bits 0 to 7 are the DATA byte and are not a fault at all, which
; is why they are excluded here rather than reported as unnamed.
Procedure.i SdioR5BitIsNamed(bit.i)
  If bit = 8 Or bit = 9
    ProcedureReturn 1
  EndIf
  If bit = 11 Or bit = 14
    ProcedureReturn 1
  EndIf
  If bit = 15
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

; ----------------------------------------------------------------------
;  What the controller's clock and bus registers were actually set to,
;  read live rather than remembered.
;
;  The bench asked for the divider that was really programmed, and it
;  was right to ask for the register rather than the variable: this file
;  computing 313 and the register holding 313 are two different claims,
;  and only one of them is about the hardware.
; ----------------------------------------------------------------------

; The whole word at $2C: Clock Control in bits 15:0, Timeout Control in
; 23:16, Software Reset in 31:24.
Procedure.i SdioControl1Raw()
  ProcedureReturn sdio_Rd(#SDIO_CONTROL1)
EndProcedure

; The whole word at $28: Host Control in byte 0, Power Control in byte 1.
Procedure.i SdioControl0Raw()
  ProcedureReturn sdio_Rd(#SDIO_CONTROL0)
EndProcedure

; The divisor read back OUT of Clock Control, reassembled from its two
; halves. sdhci.h lines 119-123: N[7:0] at SDHCI_DIVIDER_SHIFT 8 and
; N[9:8] at SDHCI_DIVIDER_HI_SHIFT 6, so the high two bits sit BELOW the
; low eight in the word. SDCLK = base / (2 * N), and N = 0 means the
; base clock undivided.
Procedure.i SdioDivisorProgrammed()
  Define v.i
  Define n.i
  v = sdio_Rd(#SDIO_CONTROL1)
  n = (v >> 8) & $FF
  n = n | (((v >> 6) & $3) << 8)
  ProcedureReturn n
EndProcedure

; GPFSEL3 and GPIO_PUP_PDN_CNTRL_REG2 as sdio_MuxPins left them. The
; pull register is worth printing on every run now: it held a pull-DOWN
; on CMD and DAT0..3 for the whole of this bring-up because two
; documents number up and down in opposite orders. See THE PULL ENCODING
; IS INVERTED in the header.
Procedure.i SdioGpfsel3()
  ProcedureReturn sdio_gpfsel3
EndProcedure

Procedure.i SdioGppup2()
  ProcedureReturn sdio_gppup2
EndProcedure


; ----------------------------------------------------------------------
;  SdioErrorText - a NUL-terminated English sentence for
;  SdioLastError(). Print it with whatever the MAIN file's UART library
;  provides.
;
;  The text names the STAGE, not the fix. The fix usually needs
;  SdioLastIntr() as well, and a driver that guessed at causes in a
;  string would be wrong out loud.
; ----------------------------------------------------------------------
Procedure.i SdioErrorText()
  Select sdio_err
    Case #SDIO_ERR_NONE
      ProcedureReturn "sdio: ok"
    Case #SDIO_ERR_NO_CNTFRQ
      ProcedureReturn "sdio: CNTFRQ_EL0 is not a usable frequency - cannot bound any wait, nothing attempted"
    Case #SDIO_ERR_NO_CONTROLLER
      ProcedureReturn "sdio: the word at $FE3000FC is all-zero or all-ones, so nothing decodes here - THIS one really is the address or the peripheral window; compare EMMC2 at $FE3400FC, which reads $10020000"
    Case #SDIO_ERR_BAD_VERSION
      ProcedureReturn "sdio: the Host Controller Version register answered but its spec-version field is above 4, which is not a version any SDHCI specification defines - see SdioHostVersionRaw"
    Case #SDIO_ERR_NO_CAPS
      ProcedureReturn "sdio: RETIRED CODE - an all-zero Capabilities register is normal on this block and is no longer a refusal; if you are reading this, something set sdio_err by hand"
    Case #SDIO_ERR_BASECLK
      ProcedureReturn "sdio: base clock unknown - Capabilities says 0, call SdioSetBaseClockKhz with mailbox clock id 1 (EMMC, NOT EMMC2)"
    Case #SDIO_ERR_RESET
      ProcedureReturn "sdio: Software Reset For All never self-cleared"
    Case #SDIO_ERR_CLOCK
      ProcedureReturn "sdio: Internal Clock Stable never came up"
    Case #SDIO_ERR_INHIBIT
      ProcedureReturn "sdio: Command Inhibit never cleared - controller or card still busy"
    Case #SDIO_ERR_CMD_TIMEOUT
      ProcedureReturn "sdio: command timed out - no response"
    Case #SDIO_ERR_CMD_ERROR
      ProcedureReturn "sdio: command error - see SdioLastIntr for CRC / end bit / index"
    Case #SDIO_ERR_CMD_STUCK
      ProcedureReturn "sdio: no Command Complete and no error bit - the controller is wedged"
    Case #SDIO_ERR_NO_CARD
      ProcedureReturn "sdio: nothing answered CMD5 - check SdioWlOnStep (want 9) and SdioWlOnLevel (want 1); firmware GPIO 129 is the radio's enable pin"
    Case #SDIO_ERR_NO_IO_FUNCS
      ProcedureReturn "sdio: the card answered CMD5 but reports zero I/O functions - not an SDIO device"
    Case #SDIO_ERR_OPCOND_TMO
      ProcedureReturn "sdio: CMD5 never reported ready - see SdioOcr"
    Case #SDIO_ERR_CMD3
      ProcedureReturn "sdio: CMD3 SEND_RELATIVE_ADDR failed"
    Case #SDIO_ERR_BAD_RCA
      ProcedureReturn "sdio: card published RCA 0, which cannot be selected"
    Case #SDIO_ERR_CMD7
      ProcedureReturn "sdio: CMD7 SELECT_CARD failed"
    Case #SDIO_ERR_R5
      ProcedureReturn "sdio: the card REFUSED the command - see SdioLastR5 for CRC / illegal / function / range"
    Case #SDIO_ERR_BAD_FUNC
      ProcedureReturn "sdio: function number out of range"
    Case #SDIO_ERR_BAD_ADDR
      ProcedureReturn "sdio: register address above 17 bits - SDIO addresses are 17 bits"
    Case #SDIO_ERR_BAD_LEN
      ProcedureReturn "sdio: length or block size must be 4 to 512 bytes and a multiple of 4 - the buffer data port is 32 bits wide, see the CMD53 section"
    Case #SDIO_ERR_BAD_COUNT
      ProcedureReturn "sdio: block count must be 1 to 511, and exactly 1 in byte mode - a count of 0 means an infinite transfer, which this file does not implement"
    Case #SDIO_ERR_ALIGN
      ProcedureReturn "sdio: buffer is not 4-byte aligned"
    Case #SDIO_ERR_NULL_BUF
      ProcedureReturn "sdio: null buffer"
    Case #SDIO_ERR_DATA_TMO
      ProcedureReturn "sdio: buffer ready never arrived"
    Case #SDIO_ERR_DATA_ERROR
      ProcedureReturn "sdio: data error - see SdioLastIntr for CRC / end bit / data timeout"
    Case #SDIO_ERR_XFER_TMO
      ProcedureReturn "sdio: Transfer Complete never arrived"
    Case #SDIO_ERR_BUSY_TMO
      ProcedureReturn "sdio: the card's busy signal never ended"
    Case #SDIO_ERR_NOT_READY
      ProcedureReturn "sdio: not initialised - SdioInit did not succeed"
    Case #SDIO_ERR_ENABLE_TMO
      ProcedureReturn "sdio: the function never reported ready in CCCR IORx"
    Case #SDIO_ERR_BUS_WIDTH
      ProcedureReturn "sdio: the card would not switch to a four-bit bus"
  EndSelect
  ProcedureReturn "sdio: unknown error code"
EndProcedure
