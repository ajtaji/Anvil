; 1 if the card advertised 1.8V support. REPORTED AND NEVER ACTED ON -
; see "NO HIGH SPEED, NO UHS, NO 1.8V SWITCH".
Procedure.i Sdio18vCapable()
  ProcedureReturn sdio_18v
EndProcedure

Procedure.i SdioRca()
  ProcedureReturn sdio_rca
