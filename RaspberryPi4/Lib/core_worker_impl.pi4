; ======================================================================
;  core_worker.pi4 - cache-coherent raw-secondary bootstrap, milestone 1
;
;  Requires the board memmap accessors, mmu.pi4 and mmu_secondary.pi4 before
;  this file. The Pi 4 board includes its job-capable composition for the
;  explicit `coretest` acceptance command. It releases no core unless that
;  primary-only owner explicitly prepares and releases one; boot never does.
;
;  This is deliberately NOT CoreStart(callback).  Ordinary generated A64
;  parameters and locals live in fixed BSS slots and are not reentrant.  The
;  only secondary entry here is one no-parameter naked ASM state witness. Its
;  one allowlisted call is MmuSecondaryJoinRaw, also naked/no-parameter ASM.
;  No secondary prints, pets a watchdog, touches a device, or calls ordinary
;  generated code.  The primary owns configuration, cache cleaning and bounded
;  observation.
;
;  Firmware interface: BCM2711 AArch64 spin-table slots $D8/$E0/$E8/$F0.
;  armstub8.asm leaves cores 1..3 at EL3 in WFE and sets CPUECTLR_EL1.SMPEN.
;  This milestone deliberately accepts only that pinned EL3 contract. An EL2
;  arrival is parked before the implementation-defined CPUECTLR read.
; ======================================================================

#CORE_RAW_CORES          = 4
#CORE_RAW_ALIGN          = 256
#CORE_RAW_STRIDE         = 256
#CORE_RAW_SHIFT          = 8
#CORE_RAW_SLOTS          = 16
#CORE_RAW_ALLOC_Q        = (#CORE_RAW_CORES * #CORE_RAW_STRIDE + #CORE_RAW_ALIGN) / 8

#CORE_RAW_RELEASE0       = $D8
#CORE_RAW_RELEASE1       = $E0
#CORE_RAW_RELEASE2       = $E8
#CORE_RAW_RELEASE3       = $F0

#CORE_RAW_BOOT_MAGIC     = $43525742  ; "CRWB", immutable cold record
#CORE_RAW_STATE_OFFLINE  = 0
#CORE_RAW_STATE_PREPARED = 1
#CORE_RAW_STATE_READY    = 2

; Immutable cold-record slots, read once while the secondary is uncached.
#CORE_RAW_B_MAGIC        = 0
#CORE_RAW_B_EL           = 1
#CORE_RAW_B_STACK        = 2
#CORE_RAW_B_CONTEXT      = 3
#CORE_RAW_B_ROW          = 4
#CORE_RAW_B_TTBR         = 5
#CORE_RAW_B_TCR          = 6
#CORE_RAW_B_MAIR         = 7
#CORE_RAW_B_SCTLR        = 8

; Coherent result row. READY is published last with STLR and consumed by LDAR.
#CORE_RAW_R_STATE        = 0
#CORE_RAW_R_CORE         = 1
#CORE_RAW_R_CONTEXT      = 2
#CORE_RAW_R_ROW          = 3
#CORE_RAW_R_EL           = 4
#CORE_RAW_R_SCTLR        = 5
#CORE_RAW_R_TTBR         = 6
#CORE_RAW_R_TCR          = 7
#CORE_RAW_R_MAIR         = 8
#CORE_RAW_R_SP           = 9

#CORE_RAW_STACK_MIN      = 4096
#CORE_RAW_LOW_RESERVED   = $1000
#CORE_RAW_HOLE_LO        = $3B300000
#CORE_RAW_HOLE_HI        = $3FFFFFFF
#CORE_RAW_PERIPH_LO      = $FC000000

#CORE_RAW_ERR_NONE       = 0
#CORE_RAW_ERR_CORE       = -1
#CORE_RAW_ERR_SELF       = -2
#CORE_RAW_ERR_EL         = -3
#CORE_RAW_ERR_MMU        = -4
#CORE_RAW_ERR_STACK      = -5
#CORE_RAW_ERR_BUSY       = -6
#CORE_RAW_ERR_TWICE      = -7
#CORE_RAW_ERR_ALIGN      = -8
#CORE_RAW_ERR_RANGE      = -9
#CORE_RAW_ERR_TIMEOUT    = -10
#CORE_RAW_ERR_STATE      = -11
#CORE_RAW_ERR_OWNERSHIP  = -12

; Over-allocation plus runtime round-up gives every record and row a 256-byte
; base even though the emitter guarantees only aggregate BSS alignment.  The
; two arrays are separate, and each core owns a distinct stride in each.
Global Dim core_raw_boot.i[#CORE_RAW_ALLOC_Q]
Global Dim core_raw_row.i[#CORE_RAW_ALLOC_Q]

; Primary-owned metadata. A released record is immutable until reset.
Global Dim core_raw_prepared.i[#CORE_RAW_CORES]
Global Dim core_raw_released.i[#CORE_RAW_CORES]
Global Dim core_raw_stackbase.i[#CORE_RAW_CORES]
Global Dim core_raw_stacktop.i[#CORE_RAW_CORES]
Global core_raw_err.i
Global core_raw_scratch.i
Global core_raw_acqaddr.i

Procedure.i CoreRawBootBase()
  ProcedureReturn (@core_raw_boot[0] + #CORE_RAW_ALIGN - 1) & -#CORE_RAW_ALIGN
EndProcedure

Procedure.i CoreRawRowBase()
  ProcedureReturn (@core_raw_row[0] + #CORE_RAW_ALIGN - 1) & -#CORE_RAW_ALIGN
EndProcedure

Procedure.i CoreRawBootAddr(core.i)
  If core < 0 Or core >= #CORE_RAW_CORES
    ProcedureReturn 0
  EndIf
  ProcedureReturn CoreRawBootBase() + core * #CORE_RAW_STRIDE
EndProcedure

Procedure.i CoreRawRowAddr(core.i)
  If core < 0 Or core >= #CORE_RAW_CORES
    ProcedureReturn 0
  EndIf
  ProcedureReturn CoreRawRowBase() + core * #CORE_RAW_STRIDE
EndProcedure

Procedure.i CoreRawReleaseAddr(core.i)
  Select core
    Case 0 : ProcedureReturn #CORE_RAW_RELEASE0
    Case 1 : ProcedureReturn #CORE_RAW_RELEASE1
    Case 2 : ProcedureReturn #CORE_RAW_RELEASE2
    Case 3 : ProcedureReturn #CORE_RAW_RELEASE3
  EndSelect
  ProcedureReturn 0
EndProcedure

Procedure.i CoreRawId()
  ASM
    mrs  x0, mpidr_el1
    movz x9, #3
    and  x0, x0, x9
  EndASM
EndProcedure

Procedure.i coreRaw_Sp()
  ASM
    mov x0, sp
  EndASM
EndProcedure

; Address of the label inside the naked procedure, never the wrapper's skip.
Procedure.i CoreRawEntryAddr()
  ASM
    adrp x9, coreRawSecondaryEntry
    add  x9, x9, #:lo12:coreRawSecondaryEntry
    adrp x10, global_core_raw_scratch
    add  x10, x10, #:lo12:global_core_raw_scratch
    str  x9, [x10]
  EndASM
  ProcedureReturn core_raw_scratch
EndProcedure

Procedure.i CoreRawErr()
  ProcedureReturn core_raw_err
EndProcedure

Procedure.i coreRaw_LoadAcquire()
  ASM
    adrp x0, global_core_raw_acqaddr
    add  x0, x0, #:lo12:global_core_raw_acqaddr
    ldr  x0, [x0]
    ldar x0, [x0]
  EndASM
EndProcedure

Procedure.i CoreRawState(core.i)
  Define row.i
  row = CoreRawRowAddr(core)
  If row = 0
    ProcedureReturn #CORE_RAW_STATE_OFFLINE
  EndIf
  core_raw_acqaddr = row + #CORE_RAW_R_STATE * 8
  ProcedureReturn coreRaw_LoadAcquire()
EndProcedure

Procedure.i CoreRawResult(core.i, slot.i)
  Define row.i
  If slot < 0 Or slot >= #CORE_RAW_SLOTS
    ProcedureReturn 0
  EndIf
  row = CoreRawRowAddr(core)
  If row = 0
    ProcedureReturn 0
  EndIf
  ; The acquire that observes READY orders every witness load below it.
  If CoreRawState(core) <> #CORE_RAW_STATE_READY
    ProcedureReturn 0
  EndIf
  ProcedureReturn PeekI(row + slot * 8)
EndProcedure

; A raw secondary may use only the exact page assigned by the board map.
; Keeping this predicate separate makes wrong-core, partial, shared and
; unrelated ranges testable without touching a cold record, control row,
; cache line or firmware spin slot.
Procedure.i CoreRawStackOwned(core.i, stackBase.i, stackBytes.i)
  Define owned.i
  Define bytes.i
  owned = HwCoreRawStackBase(core)
  bytes = HwCoreRawStackBytes(core)
  If owned = 0 Or bytes <> #CORE_RAW_STACK_MIN
    ProcedureReturn 0
  EndIf
  If stackBase <> owned Or stackBytes <> bytes
    ProcedureReturn 0
  EndIf
  ProcedureReturn 1
EndProcedure

; Primary-only validation and immutable-record construction. The board's exact
; core/page pair is required; later alignment/range checks do not round a
; caller-supplied substitute into ownership. It must not overlap another
; prepared secondary stack.
Procedure.i CoreRawPrepare(core.i, stackBase.i, stackBytes.i, context.i)
  Define top.i
  Define other.i
  Define boot.i
  Define row.i
  Define box.i
  Define el.i
  Define sctlr.i
  Define slot.i

  core_raw_err = #CORE_RAW_ERR_NONE
  If core < 1 Or core >= #CORE_RAW_CORES
    core_raw_err = #CORE_RAW_ERR_CORE
    ProcedureReturn 0
  EndIf
  If CoreRawId() <> 0 Or core = CoreRawId()
    core_raw_err = #CORE_RAW_ERR_SELF
    ProcedureReturn 0
  EndIf
  If core_raw_prepared[core] <> 0 Or core_raw_released[core] <> 0
    core_raw_err = #CORE_RAW_ERR_TWICE
    ProcedureReturn 0
  EndIf

  el = MmuEl()
  If el <> 3
    core_raw_err = #CORE_RAW_ERR_EL
    ProcedureReturn 0
  EndIf
  sctlr = MmuSctlr()
  If (sctlr & #MMU_SCTLR_MCI) <> #MMU_SCTLR_MCI
    core_raw_err = #CORE_RAW_ERR_MMU
    ProcedureReturn 0
  EndIf

  ; The board owns exactly one page per secondary. Refuse an offset, short,
  ; oversized, shared, other-core or otherwise unrelated range before the
  ; first record/row write, cache operation or spin-slot access.
  If CoreRawStackOwned(core, stackBase, stackBytes) = 0
    core_raw_err = #CORE_RAW_ERR_OWNERSHIP
    ProcedureReturn 0
  EndIf

  If stackBase = 0 Or stackBytes < #CORE_RAW_STACK_MIN Or (stackBase & 7) <> 0
    core_raw_err = #CORE_RAW_ERR_STACK
    ProcedureReturn 0
  EndIf
  top = (stackBase + stackBytes) & -16
  stackBase = (stackBase + 15) & -16
  If top <= stackBase Or top - stackBase < #CORE_RAW_STACK_MIN
    core_raw_err = #CORE_RAW_ERR_STACK
    ProcedureReturn 0
  EndIf
  If stackBase < #CORE_RAW_LOW_RESERVED Or top > #CORE_RAW_PERIPH_LO
    core_raw_err = #CORE_RAW_ERR_RANGE
    ProcedureReturn 0
  EndIf
  ; Fixed board ownership is not enough when the monitor is deliberately
  ; linked somewhere other than its canonical base. Refuse an exact raw stack
  ; page that overlaps the actual running image before touching cold state.
  If stackBase <= HwMonHi() And HwMonLo() < top
    core_raw_err = #CORE_RAW_ERR_RANGE
    ProcedureReturn 0
  EndIf
  If stackBase <= #CORE_RAW_HOLE_HI And top > #CORE_RAW_HOLE_LO
    core_raw_err = #CORE_RAW_ERR_RANGE
    ProcedureReturn 0
  EndIf
  ; Never share the caller's live stack or either raw-core allocation.
  If coreRaw_Sp() >= stackBase And coreRaw_Sp() < top
    core_raw_err = #CORE_RAW_ERR_STACK
    ProcedureReturn 0
  EndIf
  If stackBase < CoreRawBootBase() + #CORE_RAW_CORES * #CORE_RAW_STRIDE And CoreRawBootBase() < top
    core_raw_err = #CORE_RAW_ERR_STACK
    ProcedureReturn 0
  EndIf
  If stackBase < CoreRawRowBase() + #CORE_RAW_CORES * #CORE_RAW_STRIDE And CoreRawRowBase() < top
    core_raw_err = #CORE_RAW_ERR_STACK
    ProcedureReturn 0
  EndIf
  For other = 1 To #CORE_RAW_CORES - 1
    If other <> core And core_raw_stacktop[other] <> 0
      If stackBase < core_raw_stacktop[other] And core_raw_stackbase[other] < top
        core_raw_err = #CORE_RAW_ERR_STACK
        ProcedureReturn 0
      EndIf
    EndIf
  Next

  boot = CoreRawBootAddr(core)
  row = CoreRawRowAddr(core)
  box = CoreRawReleaseAddr(core)
  If boot = 0 Or row = 0 Or boot = row
    core_raw_err = #CORE_RAW_ERR_ALIGN
    ProcedureReturn 0
  EndIf
  If (boot & (#CORE_RAW_ALIGN - 1)) <> 0 Or (row & (#CORE_RAW_ALIGN - 1)) <> 0
    core_raw_err = #CORE_RAW_ERR_ALIGN
    ProcedureReturn 0
  EndIf
  If PeekI(box) <> 0
    core_raw_err = #CORE_RAW_ERR_BUSY
    ProcedureReturn 0
  EndIf

  For slot = 0 To #CORE_RAW_SLOTS - 1
    PokeI(row + slot * 8, 0)
  Next
  PokeI(row + #CORE_RAW_R_STATE * 8, #CORE_RAW_STATE_PREPARED)

  PokeI(boot + #CORE_RAW_B_MAGIC * 8, #CORE_RAW_BOOT_MAGIC)
  PokeI(boot + #CORE_RAW_B_EL * 8, el)
  PokeI(boot + #CORE_RAW_B_STACK * 8, top)
  PokeI(boot + #CORE_RAW_B_CONTEXT * 8, context)
  PokeI(boot + #CORE_RAW_B_ROW * 8, row)
  PokeI(boot + #CORE_RAW_B_TTBR * 8, MmuSecondaryTtbr0())
  PokeI(boot + #CORE_RAW_B_TCR * 8, MmuSecondaryTcr())
  PokeI(boot + #CORE_RAW_B_MAIR * 8, MmuSecondaryMair())
  PokeI(boot + #CORE_RAW_B_SCTLR * 8, sctlr)

  core_raw_stackbase[core] = stackBase
  core_raw_stacktop[core] = top
  core_raw_prepared[core] = 1

  ; Both cold regions reach PoC before the firmware slot is even considered.
  MmuCleanRange(boot, #CORE_RAW_STRIDE)
  MmuCleanRange(row, #CORE_RAW_STRIDE)
  ProcedureReturn 1
EndProcedure

Procedure.i CoreRawRelease(core.i)
  Define box.i
  Define entry.i
  core_raw_err = #CORE_RAW_ERR_NONE
  If core < 1 Or core >= #CORE_RAW_CORES
    core_raw_err = #CORE_RAW_ERR_CORE
    ProcedureReturn 0
  EndIf
  If core_raw_prepared[core] = 0 Or CoreRawState(core) <> #CORE_RAW_STATE_PREPARED
    core_raw_err = #CORE_RAW_ERR_STATE
    ProcedureReturn 0
  EndIf
  If core_raw_released[core] <> 0
    core_raw_err = #CORE_RAW_ERR_TWICE
    ProcedureReturn 0
  EndIf
  box = CoreRawReleaseAddr(core)
  If PeekI(box) <> 0
    core_raw_err = #CORE_RAW_ERR_BUSY
    ProcedureReturn 0
  EndIf
  entry = CoreRawEntryAddr()
  If entry = 0 Or (entry & 3) <> 0
    core_raw_err = #CORE_RAW_ERR_ALIGN
    ProcedureReturn 0
  EndIf

  ; Irreversible order: slot store, slot clean to PoC, completion barrier, SEV.
  PokeI(box, entry)
  MmuCleanRange(box, 8)
  a64_barrier()
  a64_send_event()
  core_raw_released[core] = 1
  ProcedureReturn 1
EndProcedure

Procedure.i CoreRawWaitReady(core.i, spins.i)
  Define i.i
  core_raw_err = #CORE_RAW_ERR_NONE
  If core < 1 Or core >= #CORE_RAW_CORES Or core_raw_released[core] = 0
    core_raw_err = #CORE_RAW_ERR_STATE
    ProcedureReturn 0
  EndIf
  If spins < 1
    core_raw_err = #CORE_RAW_ERR_TIMEOUT
    ProcedureReturn 0
  EndIf
  For i = 1 To spins
    If CoreRawState(core) = #CORE_RAW_STATE_READY
      ProcedureReturn 1
    EndIf
  Next
  core_raw_err = #CORE_RAW_ERR_TIMEOUT
  ProcedureReturn 0
EndProcedure

; Permanent raw state-witness worker. Firmware branches directly to the label;
; the wrapper branch prevents primary fallthrough. Before READY, the control
; row is not written at all. After READY, x0=context, x1=core, x2=row remain the
; explicit raw-worker ABI and the core parks with DAIF still masked.
ProcedureNaked CoreRawSecondary()
  ASM
    b coreRawSecondaryEnd
    .align 16
coreRawSecondaryEntry:
    ; Refuse an unexpected live translation regime using registers alone,
    ; before deriving or reading any DRAM address. The MMU-owned join repeats
    ; this check immediately before its destructive cold-cache walk.
    mrs  x9, currentel
    lsr  x9, x9, #2
    cmp  x9, #3
    b.ne coreRawSecondaryFail
    mrs  x10, sctlr_el3
    movz x11, #4101
    and  x10, x10, x11
    cbnz x10, coreRawSecondaryFail
    ; CPUECTLR_EL1 is implementation-defined and may trap below EL3.  Read it
    ; only after the EL3 proof and require the pinned armstub's SMPEN bit.
    mrs  x10, cpuectlr_el1
    movz x11, #64
    and  x10, x10, x11
    cbz  x10, coreRawSecondaryFail

    mrs  x9, mpidr_el1
    movz x10, #3
    and  x27, x9, x10
    cbz  x27, coreRawSecondaryFail

    adrp x9, global_core_raw_boot
    add  x9, x9, #:lo12:global_core_raw_boot
    add  x9, x9, #255
    lsr  x9, x9, #8
    lsl  x9, x9, #8
    lsl  x10, x27, #8
    add  x9, x9, x10

    ldr  x10, [x9, #0]
    movz x11, #$5742
    movk x11, #$4352, lsl #16
    cmp  x10, x11
    b.ne coreRawSecondaryFail

    ldr  x19, [x9, #8]
    ldr  x24, [x9, #16]
    ldr  x25, [x9, #24]
    ldr  x26, [x9, #32]
    ldr  x20, [x9, #40]
    ldr  x21, [x9, #48]
    ldr  x22, [x9, #56]
    ldr  x23, [x9, #64]
    cbz  x24, coreRawSecondaryFail
    cbz  x26, coreRawSecondaryFail
    mov  sp, x24

    ; The only secondary call: a naked, register-only MMU-owned primitive.
    bl   MmuSecondaryJoinRaw
    cbz  x0, coreRawSecondaryFail

    ; The raw worker ABI is live before any coherent result is published.
    mov  x0, x25
    mov  x1, x27
    mov  x2, x26
    str  x1, [x2, #8]
    str  x0, [x2, #16]
    str  x2, [x2, #24]
    mrs  x9, currentel
    str  x9, [x2, #32]
    mrs  x9, sctlr_el3
    str  x9, [x2, #40]
    mrs  x9, ttbr0_el3
    str  x9, [x2, #48]
    mrs  x9, tcr_el3
    str  x9, [x2, #56]
    mrs  x9, mair_el3
    str  x9, [x2, #64]
    mov  x9, sp
    str  x9, [x2, #72]

    movz x9, #2
    stlr x9, [x2]
    dsb  sy
    sev
  EndASM
  CompilerIf #CORE_RAW_RESIDENT_JOBS = 1
    ASM
      b coreAcceptSecondaryEntry
    EndASM
  CompilerEndIf
  ASM
coreRawSecondaryPark:
    wfe
    b coreRawSecondaryPark

coreRawSecondaryFail:
    wfe
    b coreRawSecondaryFail
coreRawSecondaryEnd:
    ret
  EndASM
EndProcedure
