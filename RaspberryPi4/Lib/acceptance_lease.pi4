; All acceptance operations are serialized on primary core with DAIF masked.
; These are ownership leases, not a multi-core lock or a generic scheduler.
#ACCEPT_LEASE_GIC = 1
#ACCEPT_LEASE_WATCHDOG = 2
Global accept_gic_owner.i
Global accept_watchdog_owner.i
Global accept_secondary_owner.i
#ACCEPT_OWNER_CORE = 1
#ACCEPT_OWNER_EL3 = 2

Procedure.i acceptLeaseCore()
  ASM
    mrs x0, mpidr_el1
    movz x9, #$FFFF
    movk x9, #$FF, lsl #16
    and x10, x0, x9
    lsr x0, x0, #32
    movz x9, #$FF
    and x0, x0, x9
    orr x0, x0, x10
  EndASM
EndProcedure

Procedure.i acceptLeaseDaif()
  ASM
    mrs x0, daif
  EndASM
EndProcedure

Procedure.i AcceptLeaseAcquire(owner.i, mask.i)
  If acceptLeaseCore() <> 0 : ProcedureReturn 0 : EndIf
  If (acceptLeaseDaif() & $3C0) <> $3C0 : ProcedureReturn 0 : EndIf
  If owner < 1 Or owner > 2 Or mask < 1 Or mask > 3 : ProcedureReturn 0 : EndIf
  If owner = #ACCEPT_OWNER_EL3 And accept_secondary_owner <> 0 : ProcedureReturn 0 : EndIf
  If (mask & #ACCEPT_LEASE_GIC) <> 0 And accept_gic_owner <> 0 : ProcedureReturn 0 : EndIf
  If (mask & #ACCEPT_LEASE_WATCHDOG) <> 0 And accept_watchdog_owner <> 0 : ProcedureReturn 0 : EndIf
  ; Validate the complete requested set before the first mutation.
  If (mask & #ACCEPT_LEASE_GIC) <> 0 : accept_gic_owner = owner : EndIf
  If (mask & #ACCEPT_LEASE_WATCHDOG) <> 0 : accept_watchdog_owner = owner : EndIf
  ProcedureReturn 1
EndProcedure

Procedure.i AcceptLeaseRelease(owner.i, mask.i)
  If acceptLeaseCore() <> 0 : ProcedureReturn 0 : EndIf
  If (acceptLeaseDaif() & $3C0) <> $3C0 : ProcedureReturn 0 : EndIf
  If owner < 1 Or owner > 2 Or mask < 1 Or mask > 3 : ProcedureReturn 0 : EndIf
  If owner = #ACCEPT_OWNER_CORE And accept_secondary_owner <> 0 : ProcedureReturn 0 : EndIf
  If (mask & #ACCEPT_LEASE_GIC) <> 0 And accept_gic_owner <> owner : ProcedureReturn 0 : EndIf
  If (mask & #ACCEPT_LEASE_WATCHDOG) <> 0 And accept_watchdog_owner <> owner : ProcedureReturn 0 : EndIf
  If (mask & #ACCEPT_LEASE_GIC) <> 0 : accept_gic_owner = 0 : EndIf
  If (mask & #ACCEPT_LEASE_WATCHDOG) <> 0 : accept_watchdog_owner = 0 : EndIf
  ProcedureReturn 1
EndProcedure
