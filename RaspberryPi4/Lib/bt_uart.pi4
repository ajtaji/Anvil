; ======================================================================
;  bt_uart.pi4 - the Pi 4's Bluetooth byte pipe: the BCM2711 PL011 UART0
;  on GPIO 30-33 to the CYW43455, and BT_ON. The host side of the HwBt* seam that
;  Anvil/Net/hci.pbi runs HCI over. Pi 4 (BCM2711) only: the Pi 5's
;  Bluetooth UART is a different IP (a brcm,bcm7271-uart, 16550-class)
;  and has its own thin file, RaspberryPi4/Lib/bt_uart_7271.pi4 (rule 30).
;
;  ---- WHERE THE NUMBERS COME FROM (pinned Linux 7e030b60792d) ----------
;  bcm2711-rpi-4-b.dts 257-262: "uart0 communicates with the BT module",
;    pinctrl-0 = <&uart0_ctsrts_gpio30 &uart0_gpio32>, uart-has-rtscts.
;  bcm283x.dtsi 259-268: uart0_ctsrts_gpio30 = GPIO 30 (CTS) / 31 (RTS) on
;    ALT3, pulls UP / OFF; uart0_gpio32 = GPIO 32 (TXD) / 33 (RXD) on ALT3,
;    pulls OFF / UP. (BCM2835_PUD_UP is the device tree's number; on the
;    BCM2711 gpio.pi4's #PULL_UP carries the inverted register encoding.)
;  bcm271x-rpi-bt.dtsi 3-11: max-speed = <3000000>, shutdown-gpios =
;    <&expgpio 0 GPIO_ACTIVE_HIGH>; bcm2711-rpi-4-b.dts 72: expgpio line 0
;    is "BT_ON". gpio-raspberrypi-exp.c 20, 32-51, 82-93, 189: the firmware
;    GPIO expander, line + RPI_EXP_GPIO_BASE (128), SET_GPIO_CONFIG with
;    six words (gpio, direction 1 = out, polarity, term_en, term_pull_up,
;    state) and SET_GPIO_STATE (gpio, state); a nonzero gpio word in the
;    answer is a failure. Tags $00038043 / $00038041
;    (raspberrypi-firmware.h).
;  The PL011: RaspberryPi4/Lib/uart.pi4's header (BCM2711 peripherals ch.11)
;    - base $FE201000, DR $00, FR $18 (BUSY 3, RXFE 4, TXFF 5), IBRD $24,
;    FBRD $28, LCRH $2C (FEN 4, WLEN 6:5), CR $30 (UARTEN 0, TXE 8, RXE 9,
;    RTSEN 14, CTSEN 15), IMSC $38, ICR $44; UARTCLK 48 MHz
;    (init_uart_clock=48000000, the same boot-medium line uart.pi4 relies
;    on); divisor = UARTCLK / (16 x baud), fraction in 64ths, rounded.
;
;  ---- THE PL011 IS ALSO THE CONSOLE: THE SWAP ---------------------------
;  The BCM2711 has one PL011 that can reach GPIO 30-33, and Anvil's serial
;  console is that same PL011 on GPIO 14/15 (uart.pi4). Driving Bluetooth
;  through it moves the transmitter off the console's pins - the console
;  would go silent mid-command. So BtuOpen() READS GPFSEL1 first and, if
;  GPIO 14 or 15 is on ALT0 (the PL011), REFUSES and writes nothing at all.
;  Bluetooth on this board needs the swap the stock firmware makes: the
;  console on the mini UART (UART1, GPIO 14/15 ALT5) and the PL011 given
;  to Bluetooth - the owner's decision, made where the console is chosen,
;  not here. (The other direction, Bluetooth on the mini UART,
;  bcm2711-rpi-4-b.dts uart1_bt_pins ALT5 at 230400, ties Bluetooth to the
;  VPU clock; not done.)
;
;  THE BORROW (2026-10-16, from the NES payload, which ran Bluetooth audio
;  through this file on the board): with BtuMayBorrowConsole(1) BtuOpen no
;  longer refuses. It waits for the console's last byte to leave, saves the
;  PL011's rate, format, control, interrupt mask and FIFO levels and the
;  GPIO function and pull registers it changes, takes GPIO 14/15 off the
;  PL011 and opens it for Bluetooth. BtuClose gives every one of those
;  back - after clearing FEN, which empties both FIFOs, so no Bluetooth
;  byte becomes a console keystroke. The CALLER must also stop the console
;  from touching the PL011 meanwhile (hw_bt.pi4: UartLend).
;
;  BT_ON KEEPS ITS POLARITY (the NES payload's finding; the Linux
;  firmware-expander driver does the same): BtuPower reads the line's
;  configuration first and writes it back with only the state changed; if
;  the line still reads wrong it drives the state alone. BtuClose turns
;  the controller off again only if it was off before the first BtuOpen.
;
;  ON SILICON: the NES payload's H4 adapter ran over these Btu* procedures
;  (2026-10-15/16). The `bt` command path: see Anvil/Net/hci.pbi.
;
;  DEPENDENCIES: gpio.pi4 (PinAlt, PinPull, PinModeGet), mailbox.pi4
;  (MailboxBegin/SetWord/Send/Word), listed before this file.
; ======================================================================

EnableExplicit

#BTU_BASE  = $FE201000            ; PL011 UART0
#BTU_DR    = $00
#BTU_FR    = $18
#BTU_IBRD  = $24
#BTU_FBRD  = $28
#BTU_LCRH  = $2C
#BTU_CR    = $30
#BTU_IMSC  = $38
#BTU_ICR   = $44

#BTU_FR_BUSY = $08
#BTU_FR_RXFE = $10
#BTU_FR_TXFF = $20
#BTU_LCRH_8N1_FIFO = $70          ; WLEN = 11 (8 bits), FEN
#BTU_CR_RUN  = $C301              ; CTSEN | RTSEN | RXE | TXE | UARTEN

#BTU_CLOCK_HZ = 48000000

#BTU_PIN_CTS = 30
#BTU_PIN_RTS = 31
#BTU_PIN_TXD = 32
#BTU_PIN_RXD = 33
#BTU_ALT     = 3

#BTU_TAG_GET_GPIO_CONFIG = $00030043
#BTU_TAG_GET_GPIO_STATE  = $00030041
#BTU_TAG_SET_GPIO_CONFIG = $00038043
#BTU_TAG_SET_GPIO_STATE  = $00038041
#BTU_IFLS  = $34

#BTU_GPFSEL1 = $FE200004           ; GPIO 10-19 (the console's 14/15)
#BTU_GPFSEL3 = $FE20000C           ; GPIO 30-39 (Bluetooth's 30-33)
#BTU_GPPULL0 = $FE2000E4           ; GPIO_PUP_PDN_CNTRL_REG0..2, GPIO 0-47
#BTU_EXP_BT_ON = 128              ; expgpio 0 + RPI_EXP_GPIO_BASE

#BTU_TX_SPIN = 2000000

Global btu_why.i
Global btu_open.i
Global btu_mayBorrow.i
Global btu_borrowed.i
Global btu_powerBefore.i = -1      ; BT_ON before the first BtuOpen: -1 unknown
Global btu_powerErr.i
Global Dim btu_savedUart.l[6]      ; IBRD FBRD LCRH CR IMSC IFLS
Global Dim btu_savedGpio.l[5]      ; GPFSEL1 GPFSEL3 PULL0 PULL1 PULL2

; Optional primary-core TX queue. Startup remains synchronous by default.
; BtuBufferedTx(1) copies bytes into a bounded 4095-byte FIFO. HCI polling
; through BtuGet drains free hardware FIFO slots without waiting. The caller
; must keep polling, and all queue access must remain on one primary core.
; Disable, baud changes and close flush pending bytes with a 250ms bound;
; close always restores the console, even after a reported flush failure.
; Enabling does not reconfigure the controller or change the default seam.
#BTU_TX_QUEUE_BYTES=4096
Global Dim btu_txQueue.a[#BTU_TX_QUEUE_BYTES]
Global btu_txHead.i,btu_txTail.i,btu_txBuffered.i,btu_txPeak.i,btu_txTimeout.i
Procedure BtuQueueReset()
 btu_txHead=0 : btu_txTail=0 : btu_txBuffered=0
EndProcedure
Procedure.i BtuQueueUsed()
 ProcedureReturn (btu_txHead-btu_txTail) & (#BTU_TX_QUEUE_BYTES-1)
EndProcedure
Procedure.i BtuQueuePush(value.i)
 Protected nextHead.i=(btu_txHead+1) & (#BTU_TX_QUEUE_BYTES-1),used.i
 If nextHead=btu_txTail : ProcedureReturn 0 : EndIf
 btu_txQueue[btu_txHead]=value & $FF : btu_txHead=nextHead
 used=BtuQueueUsed() : If used>btu_txPeak : btu_txPeak=used : EndIf
 ProcedureReturn 1
EndProcedure
Procedure.i BtuQueuePop()
 Protected value.i
 If btu_txHead=btu_txTail : ProcedureReturn -1 : EndIf
 value=btu_txQueue[btu_txTail] & $FF
 btu_txTail=(btu_txTail+1) & (#BTU_TX_QUEUE_BYTES-1)
 ProcedureReturn value
EndProcedure

Procedure.i BtuRd(off.i)
  ProcedureReturn PeekN(#BTU_BASE + off) & $FFFFFFFF
EndProcedure

Procedure BtuWr(off.i, v.i)
  PokeL(#BTU_BASE + off, v)
EndProcedure

 ; Service only free FIFO slots; never wait for the UART here.
Procedure BtuDrainTx()
 If btu_open=0 : ProcedureReturn : EndIf
 While btu_txHead<>btu_txTail
  If (BtuRd(#BTU_FR) & #BTU_FR_TXFF)<>0 : Break : EndIf
  BtuWr(#BTU_DR,BtuQueuePop())
 Wend
EndProcedure
Procedure.i BtuFlushPending()
 Protected deadline.i=Ticks()+TickHz()/4
 While BtuQueueUsed()>0
  BtuDrainTx()
  If Ticks()>deadline
   btu_txTimeout+1 : btu_why="Bluetooth software transmit queue did not drain"
   ProcedureReturn 0
  EndIf
 Wend
 ProcedureReturn 1
EndProcedure
Procedure.i BtuBufferedTx(enable.i)
 If btu_open=0 : ProcedureReturn 0 : EndIf
 If BtuFlushPending()=0 : ProcedureReturn 0 : EndIf
 btu_txBuffered=Bool(enable<>0)
 ProcedureReturn 1
EndProcedure

Procedure BtuBarrier()
  ASM
    dsb sy
    isb
  EndASM
EndProcedure

; BT_ON as the firmware expander reports it: 1, 0, or -1 unreadable.
Procedure.i BtuPowerState()
  If MailboxBegin(#BTU_TAG_GET_GPIO_STATE, 4, 8) = 0 : ProcedureReturn -1 : EndIf
  MailboxSetWord(0, #BTU_EXP_BT_ON)
  If MailboxSend() = 0 : ProcedureReturn -1 : EndIf
  If MailboxWord(0) <> 0 : ProcedureReturn -1 : EndIf
  ProcedureReturn MailboxWord(1) & 1
EndProcedure

; BT_ON through the firmware expander. The line's polarity is read and
; written back unchanged (gpio-raspberrypi-exp.c keeps it); then the state
; alone if the configuration did not take. 1 when the line reads `on`.
Procedure.i BtuPower(on.i)
  Define state.i, polarity.i
  state = BtuPowerState()
  If btu_powerBefore < 0 : btu_powerBefore = state : EndIf
  If state = on : ProcedureReturn 1 : EndIf
  If state < 0 : ProcedureReturn 0 : EndIf
  If MailboxBegin(#BTU_TAG_GET_GPIO_CONFIG, 4, 20) = 0 : ProcedureReturn 0 : EndIf
  MailboxSetWord(0, #BTU_EXP_BT_ON)
  If MailboxSend() = 0 Or MailboxWord(0) <> 0 : ProcedureReturn 0 : EndIf
  polarity = MailboxWord(2)
  If MailboxBegin(#BTU_TAG_SET_GPIO_CONFIG, 24, 24) = 0 : ProcedureReturn 0 : EndIf
  MailboxSetWord(0, #BTU_EXP_BT_ON)
  MailboxSetWord(1, 1)
  MailboxSetWord(2, polarity)
  MailboxSetWord(3, 0)
  MailboxSetWord(4, 0)
  MailboxSetWord(5, on)
  If MailboxSend() = 0 : btu_powerErr = btu_powerErr + 1 : EndIf
  If BtuPowerState() = on : ProcedureReturn 1 : EndIf
  If MailboxBegin(#BTU_TAG_SET_GPIO_STATE, 8, 8) = 0 : ProcedureReturn 0 : EndIf
  MailboxSetWord(0, #BTU_EXP_BT_ON)
  MailboxSetWord(1, on)
  If MailboxSend() = 0 : btu_powerErr = btu_powerErr + 1 : EndIf
  If BtuPowerState() = on : ProcedureReturn 1 : EndIf
  ProcedureReturn 0
EndProcedure

; The 64ths-of-a-divisor value, rounded; 0 if out of the PL011's range.
Procedure.i BtuDiv64(baud.i)
  Define d.i
  If baud <= 0 : ProcedureReturn 0 : EndIf
  d = (#BTU_CLOCK_HZ * 4 + baud / 2) / baud
  If d < 64 Or (d >> 6) > $FFFF : ProcedureReturn 0 : EndIf
  ProcedureReturn d
EndProcedure

; Program the rate with the UART disabled and drained (the PL011 TRM's
; order, uart.pi4's order): CR = 0, wait not BUSY, flush the FIFOs, then
; IBRD/FBRD and LCRH together, then CR.
Procedure.i BtuProgram(baud.i)
  Define d.i = BtuDiv64(baud)
  Define n.i
  If d = 0 : ProcedureReturn 0 : EndIf
  BtuWr(#BTU_CR, 0)
  n = 0
  While (BtuRd(#BTU_FR) & #BTU_FR_BUSY) <> 0 And n < #BTU_TX_SPIN : n + 1 : Wend
  BtuWr(#BTU_LCRH, 0)
  BtuWr(#BTU_IMSC, 0)
  BtuWr(#BTU_ICR, $7FF)
  BtuWr(#BTU_IBRD, d >> 6)
  BtuWr(#BTU_FBRD, d & 63)
  BtuWr(#BTU_LCRH, #BTU_LCRH_8N1_FIFO)
  BtuWr(#BTU_CR, #BTU_CR_RUN)
  BtuBarrier()
  ProcedureReturn 1
EndProcedure

Procedure.i BtuWhy()
  If btu_why = 0 : ProcedureReturn "the Bluetooth UART is open" : EndIf
  ProcedureReturn btu_why
EndProcedure

Procedure BtuDelayMs(ms.i)
  Define hz.i = TickHz()
  Define t.i
  If hz <= 0 : ProcedureReturn : EndIf
  t = Ticks() + (hz / 1000) * ms
  While Ticks() < t
  Wend
EndProcedure

; 1 if the serial console is on this PL011 (GPIO 14 or 15 on ALT0).
Procedure.i BtuConsoleOnPl011()
  If PinModeGet(14) = #PIN_ALT0 Or PinModeGet(15) = #PIN_ALT0 : ProcedureReturn 1 : EndIf
  ProcedureReturn 0
EndProcedure

; 1 = BtuOpen may borrow the console's PL011 (see THE BORROW above).
Procedure BtuMayBorrowConsole(on.i)
  btu_mayBorrow = on
EndProcedure

Procedure.i BtuBorrowed()
  ProcedureReturn btu_borrowed
EndProcedure

; Save what the open will change, then take GPIO 14/15 off the PL011.
; 0 if the console's transmitter never went idle (nothing was changed).
Procedure.i BtuBorrowConsole()
  Define n.i, i.i
  n = 0
  While (BtuRd(#BTU_FR) & #BTU_FR_BUSY) <> 0
    n + 1
    If n > #BTU_TX_SPIN : ProcedureReturn 0 : EndIf
  Wend
  btu_savedUart[0] = BtuRd(#BTU_IBRD)
  btu_savedUart[1] = BtuRd(#BTU_FBRD)
  btu_savedUart[2] = BtuRd(#BTU_LCRH)
  btu_savedUart[3] = BtuRd(#BTU_CR)
  btu_savedUart[4] = BtuRd(#BTU_IMSC)
  btu_savedUart[5] = BtuRd(#BTU_IFLS)
  btu_savedGpio[0] = PeekL(#BTU_GPFSEL1)
  btu_savedGpio[1] = PeekL(#BTU_GPFSEL3)
  For i = 0 To 2 : btu_savedGpio[2 + i] = PeekL(#BTU_GPPULL0 + i * 4) : Next
  btu_borrowed = 1
  ; GPIO 14 and 15 to inputs (FSEL bits 12-14 and 15-17 of GPFSEL1).
  PokeL(#BTU_GPFSEL1, btu_savedGpio[0] & ~((7 << 12) | (7 << 15)))
  ProcedureReturn 1
EndProcedure

; Give the console its PL011 back exactly as it was. FEN goes to zero
; first: that empties both FIFOs, so nothing Bluetooth said is left in
; them to be read as a keystroke.
Procedure BtuReturnConsole()
  Define i.i
  If btu_borrowed = 0 : ProcedureReturn : EndIf
  BtuWr(#BTU_CR, 0)
  BtuWr(#BTU_LCRH, 0)
  BtuWr(#BTU_ICR, $7FF)
  BtuWr(#BTU_IBRD, btu_savedUart[0])
  BtuWr(#BTU_FBRD, btu_savedUart[1])
  BtuWr(#BTU_LCRH, btu_savedUart[2])
  BtuWr(#BTU_IMSC, btu_savedUart[4])
  BtuWr(#BTU_IFLS, btu_savedUart[5])
  PokeL(#BTU_GPFSEL1, btu_savedGpio[0])
  PokeL(#BTU_GPFSEL3, btu_savedGpio[1])
  For i = 0 To 2 : PokeL(#BTU_GPPULL0 + i * 4, btu_savedGpio[2 + i]) : Next
  BtuWr(#BTU_CR, btu_savedUart[3])
  BtuBarrier()
  btu_borrowed = 0
EndProcedure

Procedure.i BtuOpen()
  BtuQueueReset() : btu_txPeak=0 : btu_txTimeout=0
  btu_open = 0
  btu_why = 0
  ; THE SWAP. Read only - a refusal writes nothing.
  If BtuConsoleOnPl011() <> 0
    If btu_mayBorrow = 0
      btu_why = "the PL011 is this board's serial console on GPIO 14 and 15; Bluetooth needs the same PL011 on GPIO 30 to 33, so the console must move to the mini UART first"
      ProcedureReturn 0
    EndIf
    If BtuBorrowConsole() = 0
      btu_why = "the serial console's transmitter never went idle, so its PL011 could not be lent to Bluetooth"
      ProcedureReturn 0
    EndIf
  EndIf
  ; ALWAYS FROM OFF (2026-10-16, found on the board): a controller left
  ; powered by an earlier user - the NES payload leaves it on if it found
  ; it on - is still at that user's 3,000,000 baud, and a reset sent at
  ; 115200 is never heard. Linux's hci_bcm powers the part off at close
  ; and on at open; here: off, 50 ms, on (hci.pbi then waits 120 ms).
  BtuPower(0)
  BtuDelayMs(50)
  If BtuPower(1) = 0
    BtuReturnConsole()
    btu_why = "the firmware would not drive BT_ON (expander line 0) through the mailbox"
    ProcedureReturn 0
  EndIf
  ; Pulls first, then the function, as uart.pi4 muxes its own pins.
  PinPull(#BTU_PIN_CTS, #PULL_UP)
  PinPull(#BTU_PIN_RTS, #PULL_NONE)
  PinPull(#BTU_PIN_TXD, #PULL_NONE)
  PinPull(#BTU_PIN_RXD, #PULL_UP)
  PinAlt(#BTU_PIN_CTS, #BTU_ALT)
  PinAlt(#BTU_PIN_RTS, #BTU_ALT)
  PinAlt(#BTU_PIN_TXD, #BTU_ALT)
  PinAlt(#BTU_PIN_RXD, #BTU_ALT)
  BtuProgram(115200)
  btu_open = 1
  ProcedureReturn 1
EndProcedure

Procedure BtuClose()
  If btu_open
    BtuFlushPending()
    BtuWr(#BTU_CR, 0)
  EndIf
  btu_open = 0
  BtuQueueReset()
  If btu_powerBefore = 0 : BtuPower(0) : EndIf
  BtuReturnConsole()
EndProcedure

Procedure.i BtuPut(b.i)
  Define n.i = 0
  If btu_txBuffered
    BtuDrainTx()
    While BtuQueuePush(b)=0
      BtuDrainTx() : n+1
      If n>#BTU_TX_SPIN
        btu_txTimeout+1
        btu_why="Bluetooth software transmit queue remained full"
        ProcedureReturn 0
      EndIf
    Wend
    ProcedureReturn 1
  EndIf
  While (BtuRd(#BTU_FR) & #BTU_FR_TXFF) <> 0
    n + 1
    If n > #BTU_TX_SPIN : ProcedureReturn 0 : EndIf
  Wend
  BtuWr(#BTU_DR, b & $FF)
  ProcedureReturn 1
EndProcedure

Procedure.i BtuGet()
  If btu_txBuffered : BtuDrainTx() : EndIf
  If (BtuRd(#BTU_FR) & #BTU_FR_RXFE) <> 0 : ProcedureReturn -1 : EndIf
  ProcedureReturn BtuRd(#BTU_DR) & $FF
EndProcedure

; The controller has already switched (hci.pbi waits for its Command
; Complete first); drain what is in flight, then re-program.
Procedure.i BtuSetBaud(baud.i)
  If BtuDiv64(baud) = 0 : ProcedureReturn 0 : EndIf
  If BtuFlushPending()=0 : ProcedureReturn 0 : EndIf
  ProcedureReturn BtuProgram(baud)
EndProcedure
