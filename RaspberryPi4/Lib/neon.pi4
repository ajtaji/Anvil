; ======================================================================
;  COLOUR
;
;  Packed 0xAARRGGBB, each channel 0..255. This is a LOGICAL colour and
;  not the surface's word: the fragment shader is handed four separate
;  f32 components and the tile buffer packs them, so nothing here
;  depends on the framebuffer's channel order.
; ======================================================================
Procedure.i Neon_RGBA(r.i, g.i, b.i, a.i)
  If r < 0 : r = 0 : EndIf
  If r > 255 : r = 255 : EndIf
  If g < 0 : g = 0 : EndIf
  If g > 255 : g = 255 : EndIf
  If b < 0 : b = 0 : EndIf
  If b > 255 : b = 255 : EndIf
  If a < 0 : a = 0 : EndIf
  If a > 255 : a = 255 : EndIf
  ProcedureReturn ((a & $FF) << 24) | ((r & $FF) << 16) | ((g & $FF) << 8) | (b & $FF)
EndProcedure

Procedure.i Neon_RGB(r.i, g.i, b.i)
  ProcedureReturn Neon_RGBA(r, g, b, 255)
EndProcedure

Procedure.i Neon_R(c.i)
  ProcedureReturn (c >> 16) & $FF
EndProcedure

Procedure.i Neon_G(c.i)
  ProcedureReturn (c >> 8) & $FF
EndProcedure

Procedure.i Neon_B(c.i)
  ProcedureReturn c & $FF
EndProcedure

Procedure.i Neon_A(c.i)
  ProcedureReturn (c >> 24) & $FF
EndProcedure

; Replace the alpha, keeping the colour. `a` is 0..255.
Procedure.i Neon_WithAlpha(c.i, a.i)
  ProcedureReturn Neon_RGBA(Neon_R(c), Neon_G(c), Neon_B(c), a)
EndProcedure

; ----------------------------------------------------------------------
;  Neon_Mul - the palette's derived products, as an integer ratio.
;
;  The widgets multiply the palette rather than naming new entries: an
;  open menu tab is accent * 0.30/0.30/0.34 (GlUIChrome.pbi:725), a
;  drop-down frame accent * 0.55 (:774), a hot scrollbar thumb
;  accent * 0.8 (:485). Neon_Mul(cAcc, 55, 100) is that, and the
;  rounding is round-to-nearest so 0.353 * 0.55 * 255 comes out the
;  same integer the engine's float path would produce.
;
;  THE ALPHA IS NOT SCALED. Every one of those products in the engine
;  multiplies the colour and leaves the alpha at 1.0.
; ----------------------------------------------------------------------
Procedure.i Neon_Mul(c.i, num.i, den.i)
  Protected r.i
  Protected g.i
  Protected b.i
  If den <= 0
    ProcedureReturn c
  EndIf
  r = ((Neon_R(c) * num) + (den / 2)) / den
  g = ((Neon_G(c) * num) + (den / 2)) / den
  b = ((Neon_B(c) * num) + (den / 2)) / den
  ProcedureReturn Neon_RGBA(r, g, b, Neon_A(c))
EndProcedure

; The three-channel form, for accent * 0.30/0.30/0.34 and
; red * 0.5/0.35/0.35 which are not uniform.
Procedure.i Neon_Mul3(c.i, numR.i, numG.i, numB.i)
  Protected r.i
  Protected g.i
  Protected b.i
  r = ((Neon_R(c) * numR) + 50) / 100
  g = ((Neon_G(c) * numG) + 50) / 100
  b = ((Neon_B(c) * numB) + 50) / 100
  ProcedureReturn Neon_RGBA(r, g, b, Neon_A(c))
EndProcedure

; Add a constant to each channel, which is the button's hover lift:
; br + 0.06*hover, bg + 0.07*hover, bb + 0.08*hover (GlUIChrome.pbi:365).
; `hover` is 0..1000 here and the offsets are in 1/1000 of full scale.
Procedure.i Neon_Lift(c.i, hover1000.i)
  Protected r.i
  Protected g.i
  Protected b.i
  r = Neon_R(c) + ((255 * 60 * hover1000) / 1000000)
  g = Neon_G(c) + ((255 * 70 * hover1000) / 1000000)
  b = Neon_B(c) + ((255 * 80 * hover1000) / 1000000)
  ProcedureReturn Neon_RGBA(r, g, b, Neon_A(c))
EndProcedure


; ======================================================================
;  IEEE 754 BINARY32 FROM INTEGERS
;
;  The GPU wants f32 bit patterns for the clip coordinates and for the
;  four colour components. Nothing on this backend can produce one with
;  a float, so they are built here by integer long division.
;
;  neon_F32Ratio(num, den) is num/den as a binary32, correctly rounded
;  to nearest with ties away from zero. It handles the sign, it is
;  EXACT whenever the quotient is a dyadic rational with 24 or fewer
;  significant bits - which covers every clip coordinate on a
;  power-of-two-ish surface and 0, 1 and 1/2 exactly - and it is within
;  half an ulp otherwise.
;
;  HOW: shift the numerator left by 31 before dividing, so the quotient
;  has at least 24 significant bits for any den <= 2^31. Then find the
;  top set bit, which gives the exponent, and round the mantissa.
;  .i is 64 bits on this part, so num << 31 for a num of a few million
;  cannot overflow.
;
;  THE TRI PROBE DODGED THIS by using (n + 0.25)/255 so that the f16
;  round trip could not land on a tie (V3D stage 4, "THE COLOURS").
;  That dodge is not available to a general engine, so the rounding is
;  done properly instead and the pixel tests below choose colours whose
;  round trip is unambiguous for the same reason the tri probe did.
; ======================================================================
Procedure.i neon_F32Ratio(num.i, den.i)
  Protected neg.i
  Protected bias.i
  Protected m.i
  Protected p.i
  Protected e.i
  Protected sh.i
  Protected mant.i
  Protected half.i

  If den = 0
    ProcedureReturn 0
  EndIf
  neg = 0
  If num < 0
    neg = 1
    num = 0 - num
  EndIf
  If den < 0
    If neg = 1
      neg = 0
    Else
      neg = 1
    EndIf
    den = 0 - den
  EndIf
  If num = 0
    ProcedureReturn 0
  EndIf

  ; m = num * 2^bias / den.
  ;
  ; THE BIAS IS 40 AND NOT 31, AND THE DIFFERENCE IS ONE ULP. With 31
  ; the quotient can land with EXACTLY twenty-four significant bits -
  ; that happens whenever num/den is in [2^-8, 2^-7) - and then there
  ; is nothing left below the mantissa to round with, so the answer
  ; comes out truncated. The clip coordinate 2/320 is in that band, and
  ; a rectangle two pixels from the viewport centre got $BBCCCCCC where
  ; IEEE 754 says $BBCCCCCD. FOUND BY tools/a64/a64_neon_check.py, not
  ; by the board: the 2,073,600-pixel run in pi4NeonBox.pi4 has no
  ; geometry and no colour in that band.
  ;
  ; With 40 the quotient carries at least seven bits below the mantissa
  ; for every denominator this engine uses - 255 for a colour channel,
  ; half the surface width or height for a coordinate - so the rounding
  ; below always has something to round.
  ;
  ; THE SHIFT CANNOT OVERFLOW. .i is 64 bits and signed; 40 bits of
  ; headroom leaves 23 for the numerator, so anything below 4194304 is
  ; safe. A caller with a bigger one drops back to 31, which is the
  ; behaviour that was correct to within one ulp anyway.
  bias = 40
  If num >= 4194304
    bias = 31
  EndIf
  m = (num << bias) / den
  If m = 0
    ProcedureReturn 0
  EndIf

  ; p = index of the highest set bit of m, by halving rather than by
  ; counting. THE LOOP THIS REPLACED WAS UP TO 62 ITERATIONS AND IT IS
  ; ON THE PER-VERTEX PATH: with the ARM MMU off every instruction
  ; fetch is Device memory, so sixty iterations is tens of
  ; microseconds, and a text-heavy frame has a hundred thousand
  ; vertices in it. Six shifts instead.
  p = 0
  If (m >> 32) <> 0
    p = p + 32
  EndIf
  If (m >> (p + 16)) <> 0
    p = p + 16
  EndIf
  If (m >> (p + 8)) <> 0
    p = p + 8
  EndIf
  If (m >> (p + 4)) <> 0
    p = p + 4
  EndIf
  If (m >> (p + 2)) <> 0
    p = p + 2
  EndIf
  If (m >> (p + 1)) <> 0
    p = p + 1
  EndIf

  ; The value is m * 2^-bias, so its exponent is p - bias.
  e = p - bias

  If p > 23
    sh = p - 23
    half = 1 << (sh - 1)
    mant = (m + half) >> sh
    ; A carry out of the mantissa's top bit means the value rounded up
    ; to the next binade.
    If (mant >> 24) <> 0
      mant = mant >> 1
      e = e + 1
    EndIf
  ElseIf p = 23
    ; EXACTLY TWENTY-FOUR SIGNIFICANT BITS: nothing to round off and
    ; nothing to shift.
    ;
    ; UNREACHABLE WITH A BIAS OF 40 and every denominator this engine
    ; uses, and it is here anyway because the arm above CANNOT HANDLE
    ; IT: at p = 23 the shift is zero and `1 << (sh - 1)` is a shift by
    ; MINUS ONE. On AArch64 a variable shift is taken modulo the
    ; register width, so that is a shift by 63 - the rounding constant
    ; becomes $8000000000000000, the carry test fires, and the exponent
    ; comes out one too big. A silently wrong float, from a shift the
    ; compiler cannot warn about.
    ;
    ; A backstop that is labelled as unreachable is honest; one
    ; described as doing work it does not do is the beginning of a
    ; wrong belief about where the guard lives.
    mant = m
  Else
    mant = m << (23 - p)
  EndIf
  mant = mant & $7FFFFF

  e = e + 127
  If e <= 0
    ; Underflow to zero. Nothing this file computes can reach it - the
    ; smallest ratio is 1/255 - and a denormal would be worse than a
    ; zero because the vertex fetcher may flush it.
    ProcedureReturn 0
  EndIf
  If e > 254
    ; Overflow. Saturate to the largest finite value rather than
    ; produce an infinity that would propagate silently.
    e = 254
    mant = $7FFFFF
  EndIf

  If neg = 1
    ProcedureReturn ($80000000 | (e << 23) | mant) & $FFFFFFFF
  EndIf
  ProcedureReturn ((e << 23) | mant) & $FFFFFFFF
EndProcedure

; A whole number as a binary32.
Procedure.i neon_F32Int(n.i)
  ProcedureReturn neon_F32Ratio(n, 1)
EndProcedure

; A 0..255 channel as a binary32 in 0..1. This is the conversion the
; engine's .f palette already is: GlUIChrome.pbi holds 0.129, and
; 0.129 * 255 = 32.9, so 33/255 is the same number back again.
Procedure.i neon_F32Byte(n.i)
  ProcedureReturn neon_F32Ratio(n, 255)
EndProcedure


; ======================================================================
;  THE ARENA
;
;  One contiguous block of DRAM that this engine owns outright. The
;  caller says where it is and how big; NeonInit() carves it, because
;  the sizes depend on the surface the firmware actually handed back
;  and cannot be constants.
;
;  IT MUST BE PAGE ALIGNED AND IT MUST NOT OVERLAP THE FRAMEBUFFER.
;  Both are checked.
; ======================================================================
Procedure.i NeonArena(base.i, bytes.i)
  If base <= 0 Or (base % 4096) <> 0 Or bytes < 4096
    neon_err = #NEON_ERR_ARENA
    ProcedureReturn #NEON_ERR_ARENA
  EndIf
  neon_arena    = base
  neon_arenaEnd = base + bytes
  gNeonReady    = 0
  ProcedureReturn #NEON_OK
EndProcedure

; ----------------------------------------------------------------------
;  NeonSurfaceOriented - bind a logical canvas to a physical framebuffer.
;
;  The public API remains in logical coordinates. Rotation is applied once,
;  at the vertex/scissor boundary, while the V3D render geometry and pitch
;  describe the physical target. This is what lets a landscape canvas draw
;  directly into the Pi panel's portrait scan buffer without a CPU transpose.
; ----------------------------------------------------------------------
Procedure.i NeonSurfaceOriented(base.i, w.i, h.i, pitch.i, rot.i)
  Protected pw.i
  Protected ph.i
  Protected maxDim.i

  If rot <> 0 And rot <> 90 And rot <> 180 And rot <> 270
    neon_err = #NEON_ERR_ARGS
    ProcedureReturn #NEON_ERR_ARGS
  EndIf
  pw = w
  ph = h
  If rot = 90 Or rot = 270
    pw = h
    ph = w
  EndIf
  If base <= 0 Or w < 8 Or h < 8 Or pitch < (pw * 4)
    neon_err = #NEON_ERR_SURFACE
    ProcedureReturn #NEON_ERR_SURFACE
  EndIf
  neon_fb        = base
  neon_w         = w
  neon_h         = h
  neon_physW     = pw
  neon_physH     = ph
  neon_rot       = rot
  neon_pitch     = pitch
  neon_fbBytes   = pitch * ph
  neon_fbMapBytes = neon_fbBytes    ; default: map exactly one screen
  neon_mapBase    = 0
  neon_mapBytes   = 0
  neon_outFmt     = #V3D_OFMT_RGBA8
  ; Vulkan's core maxImageDimension2D is one scalar, so the default render
  ; capacity is the square of the surface's larger dimension.  That keeps the
  ; advertised number true in both axes while preserving every existing
  ; caller that never declares a larger capacity explicitly.
  maxDim = pw
  If ph > maxDim : maxDim = ph : EndIf
  If neon_capPhysW < maxDim : neon_capPhysW = maxDim : EndIf
  If neon_capPhysH < maxDim : neon_capPhysH = maxDim : EndIf
  neon_cx        = pw / 2
  neon_cy        = ph / 2
  gNeonReady     = 0
  ProcedureReturn #NEON_OK
EndProcedure

; Declare the largest physical render geometry this arena must support.
; It may be raised before NeonInit, never while the engine is live.  The
; startup surface remains active; this only sizes tile pools and coordinate
; tables so a later transactional rebind never moves an arena object.
Procedure.i NeonRenderCapacity(width.i, height.i)
  If gNeonReady <> 0 Or neon_inFrame <> 0
    neon_err = #NEON_ERR_INFRAME
    ProcedureReturn #NEON_ERR_INFRAME
  EndIf
  If width < 8 Or height < 8 Or width > 65535 Or height > 65535
    neon_err = #NEON_ERR_GEOMETRY
    ProcedureReturn #NEON_ERR_GEOMETRY
  EndIf
  neon_capPhysW = width
  neon_capPhysH = height
  If neon_physW > neon_capPhysW : neon_capPhysW = neon_physW : EndIf
  If neon_physH > neon_capPhysH : neon_capPhysH = neon_physH : EndIf
  ProcedureReturn #NEON_OK
EndProcedure

; Compatibility entry point: an ordinary surface has identical logical and
; physical coordinates. Existing HDMI and diagnostic callers stay unchanged.
Procedure.i NeonSurface(base.i, w.i, h.i, pitch.i)
  ProcedureReturn NeonSurfaceOriented(base, w, h, pitch, 0)
EndProcedure

; ----------------------------------------------------------------------
;  NeonSurfaceMapSpan - ask NeonInit to map MORE framebuffer than the one
;  screen NeonSurface bound, so a second (off-screen) buffer that lives
;  above the first is inside the V3D page table too. `bytes` is the total
;  framebuffer span to map, from the surface base; it is floored at one
;  screen. Call after NeonSurface and before NeonInit. This is the double-
;  buffering hook: bind the top half as the surface, map 2x here, then flip
;  the render target between the halves with NeonRetarget.
; ----------------------------------------------------------------------
Procedure NeonSurfaceMapSpan(bytes.i)
  If bytes < neon_fbBytes
    bytes = neon_fbBytes
  EndIf
  neon_fbMapBytes = bytes
EndProcedure

; Configure one additional, disjoint identity-mapped region before NeonInit.
; This is separate from the framebuffer span and is intended for a reserved
; offscreen Vulkan heap. NeonInit sizes the page table through its endpoint
; and explicitly maps the region before enabling the V3D MMU.
Procedure.i NeonGpuExtraMap(base.i, bytes.i)
  If gNeonReady <> 0 Or neon_inFrame <> 0 Or v3d_owner <> 0
    ProcedureReturn #NEON_ERR_GEOMETRY
  EndIf
  If base = 0 And bytes = 0
    neon_extraMapBase = 0
    neon_extraMapBytes = 0
    ProcedureReturn #NEON_OK
  EndIf
  If base <= 0 Or bytes < 4096 Or (base % 4096) <> 0 Or (bytes % 4096) <> 0
    ProcedureReturn #NEON_ERR_GEOMETRY
  EndIf
  If base + bytes <= base
    ProcedureReturn #NEON_ERR_GEOMETRY
  EndIf
  neon_extraMapBase = base
  neon_extraMapBytes = bytes
  ProcedureReturn #NEON_OK
EndProcedure

; True only when a complete byte range lies in one contiguous identity-map
; region. Gaps between the framebuffer, Neon arena, and optional extra heap
; are never treated as mapped just because the page table spans them.
Procedure.i NeonGpuRangeMapped(base.i, bytes.i)
  If gNeonReady = 0
    ProcedureReturn 0
  EndIf
  If base <= 0 Or bytes < 1 Or base + bytes <= base
    ProcedureReturn 0
  EndIf
  If neon_mapBase > 0 And bytes <= neon_mapBytes
    If base >= neon_mapBase And (base - neon_mapBase) <= (neon_mapBytes - bytes)
      ProcedureReturn 1
    EndIf
  EndIf
  If neon_extraMapBase > 0 And bytes <= neon_extraMapBytes
    If base >= neon_extraMapBase And (base - neon_extraMapBase) <= (neon_extraMapBytes - bytes)
      ProcedureReturn 1
    EndIf
  EndIf
  ProcedureReturn 0
EndProcedure

; Build the two CPU-side clip-coordinate tables for one physical geometry.
; The destinations were carved for neon_capPhysW/H, so this routine has no
; allocation and no failure half-way through a rebind.
Procedure neon_BuildCoordinateTables(physW.i, physH.i, cx.i, cy.i)
  Protected n.i
  n = 0
  While n < (physW * 3)
    PokeN(neon_xcTab + (n * 4), neon_F32Ratio(n - physW - cx, cx))
    n = n + 1
  Wend
  n = 0
  While n < (physH * 3)
    PokeN(neon_ycTab + (n * 4), neon_F32Ratio(n - physH - cy, cy))
    n = n + 1
  Wend
EndProcedure

; Rebind the complete render surface transactionally.  Every range, capacity
; and pool check happens before the current V3D state is changed.  If one of
; the V3D setters nevertheless refuses, the old complete geometry is restored
; before the error is returned.  Surface globals are published last.
Procedure.i NeonRebindSurface(base.i, w.i, h.i, pitch.i, bytes.i, outFmt.i, rot.i)
  Protected pw.i
  Protected ph.i
  Protected cx.i
  Protected cy.i
  Protected r.i
  Protected rollbackRc.i
  Protected oldBase.i
  Protected oldW.i
  Protected oldH.i
  Protected oldPw.i
  Protected oldPh.i
  Protected oldPitch.i
  Protected mappedOk.i
  Protected oldBytes.i
  Protected oldFmt.i
  Protected oldRot.i
  Protected plan.V3dRenderPlan

  If gNeonReady = 0
    neon_err = #NEON_ERR_ARENA
    ProcedureReturn #NEON_ERR_ARENA
  EndIf
  If neon_inFrame <> 0
    neon_err = #NEON_ERR_INFRAME
    ProcedureReturn #NEON_ERR_INFRAME
  EndIf
  If rot <> 0 And rot <> 90 And rot <> 180 And rot <> 270
    neon_err = #NEON_ERR_ARGS
    ProcedureReturn #NEON_ERR_ARGS
  EndIf
  ; The present shader and tile-store path are RGBA8.  Other V3D formats have
  ; planner rows, but are not a promise this renderer can make yet.
  If outFmt <> #V3D_OFMT_RGBA8
    neon_err = #NEON_ERR_GEOMETRY
    ProcedureReturn #NEON_ERR_GEOMETRY
  EndIf
  pw = w
  ph = h
  If rot = 90 Or rot = 270
    pw = h
    ph = w
  EndIf
  If base <= 0 Or w < 8 Or h < 8 Or pitch < (pw * 4)
    neon_err = #NEON_ERR_SURFACE
    ProcedureReturn #NEON_ERR_SURFACE
  EndIf
  If bytes < (pitch * ph)
    neon_err = #NEON_ERR_SURFACE
    ProcedureReturn #NEON_ERR_SURFACE
  EndIf
  If pw > neon_capPhysW Or ph > neon_capPhysH
    neon_err = #NEON_ERR_GEOMETRY
    ProcedureReturn #NEON_ERR_GEOMETRY
  EndIf
  mappedOk = NeonGpuRangeMapped(base, bytes)
  If mappedOk = 0
    neon_err = #NEON_ERR_SURFACE
    ProcedureReturn #NEON_ERR_SURFACE
  EndIf
  r = V3dRenderPlanBuild(pw, ph, outFmt, 1, 0, 0, @plan)
  If r <> #V3D_OK
    neon_err = #NEON_ERR_GEOMETRY
    ProcedureReturn #NEON_ERR_GEOMETRY
  EndIf
  If plan\tileAllocBytes > neon_tallocBytes Or plan\tileStateBytes > neon_tstateBytes
    neon_err = #NEON_ERR_GEOMETRY
    ProcedureReturn #NEON_ERR_GEOMETRY
  EndIf

  oldBase = neon_fb
  oldW = neon_w
  oldH = neon_h
  oldPw = neon_physW
  oldPh = neon_physH
  oldPitch = neon_pitch
  oldBytes = neon_fbBytes
  oldFmt = neon_outFmt
  oldRot = neon_rot

  r = V3dRenderBegin(pw, ph, outFmt)
  If r = #V3D_OK
    r = V3dRenderTarget(base, bytes, #V3D_MEMFMT_RASTER, pitch, 0)
  EndIf
  If r = #V3D_OK
    r = V3dRenderPool(neon_talloc, neon_tallocBytes, neon_tstate, neon_tstateBytes)
  EndIf
  If r = #V3D_OK
    r = V3dBinOverflow(neon_overflow, neon_overflowBytes)
  EndIf
  If r <> #V3D_OK
    rollbackRc = V3dRenderBegin(oldPw, oldPh, oldFmt)
    If rollbackRc = #V3D_OK
      rollbackRc = V3dRenderTarget(oldBase, oldBytes, #V3D_MEMFMT_RASTER, oldPitch, 0)
    EndIf
    If rollbackRc = #V3D_OK
      rollbackRc = V3dRenderPool(neon_talloc, neon_tallocBytes, neon_tstate, neon_tstateBytes)
    EndIf
    If rollbackRc = #V3D_OK
      rollbackRc = V3dBinOverflow(neon_overflow, neon_overflowBytes)
    EndIf
    If rollbackRc <> #V3D_OK
      gNeonReady = 0
      neon_err = #NEON_ERR_V3D
      ProcedureReturn #NEON_ERR_V3D
    EndIf
    neon_err = #NEON_ERR_GEOMETRY
    ProcedureReturn #NEON_ERR_GEOMETRY
  EndIf

  cx = pw / 2
  cy = ph / 2
  neon_BuildCoordinateTables(pw, ph, cx, cy)
  neon_fb = base
  neon_w = w
  neon_h = h
  neon_physW = pw
  neon_physH = ph
  neon_pitch = pitch
  neon_fbBytes = bytes
  neon_outFmt = outFmt
  neon_rot = rot
  neon_cx = cx
  neon_cy = cy
  neon_err = #NEON_OK
  ProcedureReturn #NEON_OK
EndProcedure

; ----------------------------------------------------------------------
;  NeonRetarget - point the engine at a different framebuffer base WITHOUT
;  rebuilding the page table or recompiling the shaders. Cheap: it rebinds
;  the render target only, which is exactly what NeonFrameBegin reads when
;  it builds the next frame's render list.
;
;  The new base's pages MUST already be mapped - either by NeonSurface's
;  own screen (unchanged base) or by a NeonSurfaceMapSpan wide enough to
;  cover them. `bytes` and the surface pitch must match the render
;  geometry (one screen), so pass pitch * physicalHeight. Returns #NEON_OK.
; ----------------------------------------------------------------------
Procedure.i NeonRetarget(base.i, bytes.i)
  ProcedureReturn NeonRebindSurface(base, neon_w, neon_h, neon_pitch, bytes, neon_outFmt, neon_rot)
EndProcedure


; ======================================================================
;  THE THREE QPU PROGRAMS
;
;  Every one of them is uniform loads, VPM traffic and a thread end.
;  NO ARITHMETIC. The vertices are pre-transformed on the A72, which is
;  the route v3d-feasibility.md:264-267 proposes, and it is the right
;  one for a 2D UI: a shader that multiplies is a shader whose failure
;  has two explanations. Every one of these copies, so a wrong picture
;  is a wrong number in DRAM and nothing else.
;
;  THE UNIFORM STREAM IS READ IN PROGRAM ORDER. Each LDUNIFRF consumes
;  the next word, and the fragment shader's write to TLBU consumes one
;  more with no LDUNIFRF at all - v3d_qpu_magic_waddr_loads_unif()
;  names VPMU, TLBU, TMUAU and SYNCU (qpu_instr.c:646-658). So the
;  streams built below are laid out in the order the shaders touch
;  them and nowhere else.
;
;  THE SHADED VERTEX LAYOUT is Reference/mesa-24.3.4_v3d_nir_lower_io.c
;  :399-433: the coordinate shader writes VPM 0-3 as clip-space
;  Xc Yc Zc Wc and 4-5 as viewport Xs Ys; the vertex shader writes 0-1
;  Xs Ys, 2 Zs, 3 1/Wc.
;
;  Zc IS ZERO AND Wc IS ONE for every vertex this engine draws, so
;  neither comes from the vertex stream - both come from the uniform
;  stream as constants. That takes the attribute record count from
;  eight to FOUR and the vertex from 32 bytes to 16, which on a
;  3505-rectangle frame is 337 KB of A72 stores not made.
; ======================================================================

; ----------------------------------------------------------------------
;  THE COORDINATE SHADER.
;
;  rf0..rf5 are the constants 0..5, used both as LDVPM offsets and as
;  STVPM slot indices. rf6 is 0.0 and rf7 is 1.0. rf8..rf11 take the
;  four attributes.
;
;  Mesa loads an LDVPM offset from the uniform stream too -
;  vir_LDVPMV_IN(c, vir_uniform_ui(c, index)), nir_to_vir.c:2826-2828 -
;  rather than using a small immediate, and following it removes a
;  guess about whether that operand may come from the small-immediate
;  slot at all.
;
;  IT IS A SINGLE-SEGMENT PROGRAM. It never switches threads, so it is
;  spawned already in the final thread section and its whole thread end
;  is one THRSW and three NOPs - nir_to_vir.c:4886-4890 and
;  qpu_validate.c:430. The shader state record has a bit that says the
;  same thing and the two MUST agree: V3dQpuProgramBeginSeg() cannot
;  see the record and the record cannot see the program.
;
;  VPMWT BEFORE THE THREAD END is GFXH-1684, "VPM writes need to be
;  complete by the end of the shader", nir_to_vir.c:2070-2077.
; ----------------------------------------------------------------------
Procedure.i neon_BuildCoordShader()
  Protected r.i
  Protected k.i

  r = V3dQpuProgramBeginSeg(neon_code, #NEON_CODE_SLOT, 1)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf

  ; rf0..rf7 = 0, 1, 2, 3, 4, 5, 0.0, 1.0
  k = 0
  While k < 8
    r = V3dQpuNopSig(#V3DQ_SIG_LDUNIFRF, k, 0)
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf
    k = k + 1
  Wend

  ; rf8..rf11 = VPM input 0..3, which is Xc Yc Xs Ys.
  k = 0
  While k < 4
    r = V3dQpuLdvpm(#V3DQ_A_LDVPMV_IN, 8 + k, #V3DQ_MUX_A, k)
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf
    k = k + 1
  Wend

  ; STVPMV takes the SLOT INDEX first and the VALUE second -
  ; vir_STVPMV(c, vpm_index, val), nir_to_vir.c:2058 - and it has no
  ; destination at all: its waddr field carries the operation
  ; (qpu_pack.c:1578-1589).
  r = V3dQpuStvpm(#V3DQ_A_STVPMV, #V3DQ_MUX_A, #V3DQ_MUX_B, 0, 8)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuStvpm(#V3DQ_A_STVPMV, #V3DQ_MUX_A, #V3DQ_MUX_B, 1, 9)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  ; slot 2 is Zc and takes the constant 0.0 out of rf6
  r = V3dQpuStvpm(#V3DQ_A_STVPMV, #V3DQ_MUX_A, #V3DQ_MUX_B, 2, 6)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  ; slot 3 is Wc and takes the constant 1.0 out of rf7
  r = V3dQpuStvpm(#V3DQ_A_STVPMV, #V3DQ_MUX_A, #V3DQ_MUX_B, 3, 7)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuStvpm(#V3DQ_A_STVPMV, #V3DQ_MUX_A, #V3DQ_MUX_B, 4, 10)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuStvpm(#V3DQ_A_STVPMV, #V3DQ_MUX_A, #V3DQ_MUX_B, 5, 11)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf

  r = V3dQpuAdd0(#V3DQ_A_VPMWT, #V3DQ_WADDR_NOP, 1)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuProgramEndThrsw()
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  ProcedureReturn V3dQpuProgramEnd()
EndProcedure

; ----------------------------------------------------------------------
;  THE VERTEX SHADER. Four values out of four in.
;
;  Reads VPM input slots 2 and 3 - Xs and Ys - and writes VPM output
;  0 Xs, 1 Ys, 2 Zs, 3 1/Wc, which is the non-coord shaded vertex
;  layout (v3d_nir_lower_io.c:418-424). Zs is 0.0 because Zc is 0 and
;  Wc is 1, and 1/Wc is 1.0 for the same reason.
;
;  ALL FOUR ATTRIBUTE RECORDS ARE READ BY BOTH PHASES, so the vertex
;  shader's VPM input offsets are the same 0..3 the coordinate
;  shader uses and slots 2 and 3 are Xs and Ys in both. Reading only
;  two of them in the vertex phase would be cheaper and would move
;  every offset; GFXH-930 wants at least one record read by both
;  (v3dx_draw.c:847-866), and matching the shape pi4V3dTri.pi4 already
;  proved on silicon is worth more here than two saved VPM rows.
; ----------------------------------------------------------------------
Procedure.i neon_BuildVertexShader()
  Protected r.i
  Protected k.i

  r = V3dQpuProgramBeginSeg(neon_code + #NEON_CODE_SLOT, #NEON_CODE_SLOT, 1)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf

  ; rf0..rf5 = 0, 1, 2, 3, 0.0, 1.0. Four indices are enough: this
  ; shader writes four output slots and reads two input ones, and both
  ; sets fit inside 0..3.
  k = 0
  While k < 6
    r = V3dQpuNopSig(#V3DQ_SIG_LDUNIFRF, k, 0)
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf
    k = k + 1
  Wend

  r = V3dQpuLdvpm(#V3DQ_A_LDVPMV_IN, 8, #V3DQ_MUX_A, 2)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuLdvpm(#V3DQ_A_LDVPMV_IN, 9, #V3DQ_MUX_A, 3)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf

  r = V3dQpuStvpm(#V3DQ_A_STVPMV, #V3DQ_MUX_A, #V3DQ_MUX_B, 0, 8)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuStvpm(#V3DQ_A_STVPMV, #V3DQ_MUX_A, #V3DQ_MUX_B, 1, 9)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  ; slot 2 is Zs, the constant 0.0 from rf4
  r = V3dQpuStvpm(#V3DQ_A_STVPMV, #V3DQ_MUX_A, #V3DQ_MUX_B, 2, 4)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  ; slot 3 is 1/Wc, the constant 1.0 from rf5
  r = V3dQpuStvpm(#V3DQ_A_STVPMV, #V3DQ_MUX_A, #V3DQ_MUX_B, 3, 5)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf

  r = V3dQpuAdd0(#V3DQ_A_VPMWT, #V3DQ_WADDR_NOP, 1)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuProgramEndThrsw()
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  ProcedureReturn V3dQpuProgramEnd()
EndProcedure

; ----------------------------------------------------------------------
;  THE FRAGMENT SHADER. Four uniforms in, one pixel out.
;
;  TWO VFPACKs, exactly as Mesa emits them for an 8-bit render target
;  (nir_to_vir.c:1930-1942): the first writes TLBU and carries the
;  configuration word out of the uniform stream, the second writes
;  TLB. Each VFPACK packs two f32 lanes into one 2 x f16 result, so
;  (r,g) then (b,a) is four components in two instructions.
;
;  THE TLB WRITES COME AFTER THE LAST THREAD SWITCH and that is the
;  one structural thing in this shader. nir_to_vir.c:4959 says so in
;  as many words - "Emit the last THRSW before STVPM and TLB writes" -
;  because the tile buffer is shared and the final thread section is
;  where the scoreboard lock lives. So unlike the other two this one
;  is NOT single segment, and the record bit is clear to match.
;
;  THE ALPHA IT WRITES IS THE SOURCE ALPHA THE BLENDER USES. Nothing
;  in this shader multiplies by it: SRC_ALPHA / INV_SRC_ALPHA in the
;  tile buffer is non-premultiplied and does that itself, which is
;  exactly the equation GlUtilities.pbi:718-719 sets once and never
;  changes again.
; ----------------------------------------------------------------------
Procedure.i neon_BuildFragmentShader()
  Protected r.i
  Protected k.i

  r = V3dQpuProgramBeginSeg(neon_code + (2 * #NEON_CODE_SLOT), #NEON_CODE_SLOT, 0)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf

  ; rf0..rf3 = R, G, B, A.
  k = 0
  While k < 4
    r = V3dQpuNopSig(#V3DQ_SIG_LDUNIFRF, k, 0)
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf
    k = k + 1
  Wend

  r = V3dQpuLastThrsw()
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf

  ; TLBU first: that write pulls the configuration word out of the
  ; uniform stream by itself, which is why the stream is R G B A CONF
  ; and the CONF is fifth.
  r = V3dQpuVfpack(#V3DQ_WADDR_TLBU, 1, #V3DQ_MUX_A, #V3DQ_MUX_B, 0, 1)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuVfpack(#V3DQ_WADDR_TLB, 1, #V3DQ_MUX_A, #V3DQ_MUX_B, 2, 3)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf

  r = V3dQpuProgramEndThrsw()
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  ProcedureReturn V3dQpuProgramEnd()
EndProcedure

; ======================================================================
;  THE THREE TEXTURED SHADERS (M3)
;
;  Byte for byte pi4V3dTex's / pi4V3dAtlas's proven textured build, with
;  ONE addition in the fragment shader: it modulates the sampled glyph
;  coverage by a per-draw colour so text draws in the colour the caller
;  asked for, the way neon_GlyphRects produces solid `colour` where the
;  glyph has ink.
;
;  They live in the SAME code page as the flat three, in the slots after
;  them: textured coordinate at slot 3, vertex at 4, fragment at 5. The
;  page is 4096 bytes = eight 512-byte slots, so six programs fit with
;  two slots to spare, and the one V3dCacheRange(neon_code, 4096) in
;  NeonFrameEnd already covers them.
; ======================================================================

; The textured COORDINATE shader. Ten attributes in, six position words
; plus two varyings out. Reads VPM input 0..7 (the coord phase sees
; attributes 0-5 and 8-9, so in[6]=U, in[7]=V), writes output 0..5 =
; position and output 6,7 = the two varyings from rf14 (U) and rf15 (V).
Procedure.i neon_BuildTexCoordShader()
  Protected r.i
  Protected k.i

  r = V3dQpuProgramBeginSeg(neon_code + (3 * #NEON_CODE_SLOT), #NEON_CODE_SLOT, 1)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf

  k = 0
  While k < 8
    r = V3dQpuNopSig(#V3DQ_SIG_LDUNIFRF, k, 0)
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf
    k = k + 1
  Wend

  k = 0
  While k < 8
    r = V3dQpuLdvpm(#V3DQ_A_LDVPMV_IN, 8 + k, #V3DQ_MUX_A, k)
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf
    k = k + 1
  Wend

  k = 0
  While k < 6
    r = V3dQpuStvpm(#V3DQ_A_STVPMV, #V3DQ_MUX_A, #V3DQ_MUX_B, k, 8 + k)
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf
    k = k + 1
  Wend
  ; varying0 = U (in[6] -> rf14), varying1 = V (in[7] -> rf15).
  r = V3dQpuStvpm(#V3DQ_A_STVPMV, #V3DQ_MUX_A, #V3DQ_MUX_B, 6, 14)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuStvpm(#V3DQ_A_STVPMV, #V3DQ_MUX_A, #V3DQ_MUX_B, 7, 15)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf

  r = V3dQpuAdd0(#V3DQ_A_VPMWT, #V3DQ_WADDR_NOP, 1)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuProgramEndThrsw()
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  ProcedureReturn V3dQpuProgramEnd()
EndProcedure

; The textured VERTEX shader. Reads VPM input 4..9 (Xs Ys Zs 1/Wc U V),
; writes output 0..5 = position (0..3) and the two varyings (4,5).
Procedure.i neon_BuildTexVertexShader()
  Protected r.i
  Protected k.i

  r = V3dQpuProgramBeginSeg(neon_code + (4 * #NEON_CODE_SLOT), #NEON_CODE_SLOT, 1)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf

  k = 0
  While k < 10
    r = V3dQpuNopSig(#V3DQ_SIG_LDUNIFRF, k, 0)
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf
    k = k + 1
  Wend

  k = 0
  While k < 4
    r = V3dQpuLdvpm(#V3DQ_A_LDVPMV_IN, 10 + k, #V3DQ_MUX_A, 4 + k)
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf
    k = k + 1
  Wend
  ; varying0 = U (in[8] -> rf14), varying1 = V (in[9] -> rf15).
  r = V3dQpuLdvpm(#V3DQ_A_LDVPMV_IN, 14, #V3DQ_MUX_A, 8)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuLdvpm(#V3DQ_A_LDVPMV_IN, 15, #V3DQ_MUX_A, 9)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf

  k = 0
  While k < 6
    r = V3dQpuStvpm(#V3DQ_A_STVPMV, #V3DQ_MUX_A, #V3DQ_MUX_B, k, 10 + k)
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf
    k = k + 1
  Wend

  r = V3dQpuAdd0(#V3DQ_A_VPMWT, #V3DQ_WADDR_NOP, 1)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuProgramEndThrsw()
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  ProcedureReturn V3dQpuProgramEnd()
EndProcedure

; ----------------------------------------------------------------------
;  The textured FRAGMENT shader - coverage from the atlas, colour from a
;  uniform.
;
;  pi4V3dTex's textured shader sampled the atlas and wrote the raw texel
;  to the TLB. Here the atlas is WHITE-ON-TRANSPARENT (an ink texel is
;  $FFFFFFFF, a blank one $00000000), so the raw texel would draw white
;  text. Instead this shader:
;
;    - samples the four texel channels R G B A into rf0..rf3 (rf3 is the
;      coverage: 1.0 on ink, 0.0 on blank),
;    - loads the caller's colour A R G B from the uniform stream into
;      rf7 rf4 rf5 rf6 (A first, so the multiply's rf7 has four cycles
;      of margin before it is read),
;    - multiplies coverage by the colour's alpha: rf8 = rf3 * rf7, and
;    - writes (comp0, comp1, comp2, rf8) to the TLB.
;
;  The result is src = (colour.rgb, texel.a * colour.a). Over the
;  engine's SRC_ALPHA / INV_SRC_ALPHA blend that is exactly what
;  neon_GlyphRects produces: solid `colour` where the glyph has ink,
;  the background untouched where it does not - and it honours the
;  caller's alpha the same way the flat path does.
;
;  Uniform stream, in program order: P0 (WRTMUC), P1 (WRTMUC),
;  colour.A, comp0, comp1, comp2 (four LDUNIFRF), then the TLB config
;  word (pulled by the TLBU write). neon_TexUniforms() writes exactly
;  that, with the same red/blue swap the flat neon_Uniforms() uses so
;  byte 0 of the surface is the blue the display wants.
;
;  THE ONE NEW OP IS THE FMUL and it is the M3 silicon risk. Its reads
;  mirror shapes M1 proved: rf3 is eight instructions old (LDTMU), rf7
;  four (LDUNIFRF), and the flat shader already reads a value the very
;  next instruction after LDUNIFRF. If the multiply were ever wrong the
;  fallback is to drop it and write rf3 straight as the alpha, which
;  gives colour.rgb at the glyph's own coverage and ignores colour.a.
; ----------------------------------------------------------------------
Procedure.i neon_BuildTexFragmentShader()
  Protected r.i

  r = V3dQpuProgramBeginSeg(neon_code + (5 * #NEON_CODE_SLOT), #NEON_CODE_SLOT, 0)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf

  ; TMU config P0, P1 via WRTMUC, one uniform each.
  r = V3dQpuNopSig(#V3DQ_SIG_WRTMUC, 0, 0)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuNopSig(#V3DQ_SIG_WRTMUC, 0, 0)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf

  ; varying 0 (U -> S): LDVARY rf10, delay nop, FADD rf12 = rf10 + r5.
  r = V3dQpuNopSig(#V3DQ_SIG_LDVARY, 10, 0)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuNop()
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuAdd2(#V3DQ_A_FADD, 12, 0, #V3DQ_MUX_A, #V3DQ_MUX_R5, 10, 0)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf

  ; varying 1 (V -> T).
  r = V3dQpuNopSig(#V3DQ_SIG_LDVARY, 11, 0)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuNop()
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuAdd2(#V3DQ_A_FADD, 13, 0, #V3DQ_MUX_A, #V3DQ_MUX_R5, 11, 0)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf

  ; coordinate writes: T then S (writing TMUS fires the lookup).
  r = V3dQpuAdd2(#V3DQ_A_OR, #V3DQ_WADDR_TMUT, 1, #V3DQ_MUX_A, #V3DQ_MUX_A, 13, 0)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuAdd2(#V3DQ_A_OR, #V3DQ_WADDR_TMUS, 1, #V3DQ_MUX_A, #V3DQ_MUX_A, 12, 0)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf

  ; the thread switch that delivers the TMU result, plus two delay nops.
  r = V3dQpuNopSig(#V3DQ_SIG_THRSW, 0, 0)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuNop()
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuNop()
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf

  ; read the four texel channels R,G,B,A into rf0..rf3 (rf3 = coverage).
  r = V3dQpuNopSig(#V3DQ_SIG_LDTMU, 0, 0)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuNopSig(#V3DQ_SIG_LDTMU, 1, 0)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuNopSig(#V3DQ_SIG_LDTMU, 2, 0)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  r = V3dQpuNopSig(#V3DQ_SIG_LDTMU, 3, 0)
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf

  If #NEON_TEXTEX_MODULATE <> 0
    ; MODULATE. Load colour: A into rf7 first (so it is four cycles old
    ; before the FMUL reads it), then comp0/comp1/comp2 into rf4/rf5/rf6.
    r = V3dQpuNopSig(#V3DQ_SIG_LDUNIFRF, 7, 0)
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf
    r = V3dQpuNopSig(#V3DQ_SIG_LDUNIFRF, 4, 0)
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf
    r = V3dQpuNopSig(#V3DQ_SIG_LDUNIFRF, 5, 0)
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf
    r = V3dQpuNopSig(#V3DQ_SIG_LDUNIFRF, 6, 0)
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf

    ; the alpha: coverage * colour.alpha, on the mul pipe.
    V3dQpuReset()
    V3dQpuMul(#V3DQ_M_FMUL, 8, 0, #V3DQ_MUX_A, #V3DQ_MUX_B)
    V3dQpuRaddr(3, 7)
    r = V3dQpuEmit()
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf

    ; the last-THRSW pair and its two delay slots.
    r = V3dQpuLastThrsw()
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf

    ; pack (comp0, comp1) -> TLBU, (comp2, texel.a * colour.a) -> TLB.
    r = V3dQpuVfpack(#V3DQ_WADDR_TLBU, 1, #V3DQ_MUX_A, #V3DQ_MUX_B, 4, 5)
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf
    r = V3dQpuVfpack(#V3DQ_WADDR_TLB, 1, #V3DQ_MUX_A, #V3DQ_MUX_B, 6, 8)
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf
  Else
    ; COVERAGE ONLY. No FMUL and no colour alpha in the stream: load
    ; comp0/comp1/comp2 into rf4/rf5/rf6 and use the sampled coverage
    ; rf3 straight as the output alpha.
    r = V3dQpuNopSig(#V3DQ_SIG_LDUNIFRF, 4, 0)
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf
    r = V3dQpuNopSig(#V3DQ_SIG_LDUNIFRF, 5, 0)
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf
    r = V3dQpuNopSig(#V3DQ_SIG_LDUNIFRF, 6, 0)
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf

    r = V3dQpuLastThrsw()
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf

    ; pack (comp0, comp1) -> TLBU, (comp2, coverage) -> TLB.
    r = V3dQpuVfpack(#V3DQ_WADDR_TLBU, 1, #V3DQ_MUX_A, #V3DQ_MUX_B, 4, 5)
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf
    r = V3dQpuVfpack(#V3DQ_WADDR_TLB, 1, #V3DQ_MUX_A, #V3DQ_MUX_B, 6, 3)
    If r <> #V3DQ_OK
      ProcedureReturn r
    EndIf
  EndIf

  r = V3dQpuProgramEndThrsw()
  If r <> #V3DQ_OK
    ProcedureReturn r
  EndIf
  ProcedureReturn V3dQpuProgramEnd()
EndProcedure


; ======================================================================
;  CHANNEL ORDER, AND WHY THERE IS A SWITCH FOR IT
;
;  Two facts on this board point opposite ways and both are measured.
;
;  1. THE CLEAR COLOUR LANDS IN MEMORY VERBATIM. pi4V3dClear.pi4 asked
;     for $44332211 and read $44332211 back out of all 4096 pixels.
;     TILE_RENDERING_MODE_CFG's clear colour is a packed word, not four
;     components, so nothing reorders it.
;
;  2. THE FRAGMENT SHADER'S OUTPUT IS FOUR COMPONENTS AND THE FIRST ONE
;     LANDS IN BYTE 0. That is what "RGBA8" means as an output format.
;
;  And the display wants byte 0 to be BLUE: display.pi4 boots with
;  dsp_order = #MBX_FB_ORDER_BGR, "the firmware's own default on this
;  part", and pi4V3dFbClear.pi4 records that DisplayRGB(12, 20, 92)
;  is $FF0C145C - byte 0 = $5C = 92 = the blue it was given.
;
;  So a clear colour written as this file's packed AARRGGBB is already
;  right, and a SHADER colour has to hand blue to the first component.
;  neon_Uniforms() does exactly that and neon_rbSwap says so out loud,
;  because it is the one thing in this file that a counted-pixel run
;  can disprove in a single number. If a run comes back with red and
;  blue exchanged, this is the line, and NeonRbSwap(0) is the whole fix.
; ======================================================================
Global neon_rbSwap.i = 1

Procedure NeonRbSwap(on.i)
  If on <> 0
    neon_rbSwap = 1
  Else
    neon_rbSwap = 0
  EndIf
EndProcedure

Procedure.i Neon_RbSwapGet()
  ProcedureReturn neon_rbSwap
EndProcedure


; ======================================================================
;  NeonInit - carve the arena, build the page table, compile the three
;  shaders, and hand V3D everything that does not change per frame.
;
;  IT MUST BE CALLED AFTER NeonArena() AND NeonSurface(), because every
;  size below depends on the surface the firmware actually gave back and
;  none of them can be a constant. A 1920 x 1080 surface is 30 x 17 =
;  510 tiles; a 64 x 64 one is a single tile and every piece of the tile
;  arithmetic collapses to the identity.
;
;  THE PAGE TABLE IS ABOUT A MEGABYTE AND THAT IS NOT A MISTAKE. Every
;  address the CLE, the PTB and the TLB touch is VIRTUAL
;  (v3d_submit.c:1054-1055) and the table is indexed by virtual page
;  number, so covering a framebuffer at $3Exxxxxx costs four bytes for
;  every 4 KiB below it whether or not anything is mapped there. Sparse
;  in content, dense in extent.
;
;  A NON-IDENTITY WINDOW WOULD COST SIXTEEN KILOBYTES AND IS REFUSED.
;  Mapping the framebuffer at a low virtual address works and is far
;  cheaper, and it introduces a second address for one buffer - one the
;  CPU must never use and the GPU must always use. Every other address
;  in this engine and in the five probes before it is the same number on
;  both sides. A megabyte of DRAM on a four-gigabyte board is not worth
;  the class of bug where the two get transposed.
;
;  THE GUARD PAGE IS DELIBERATELY NOT MAPPED. It sits at the top of the
;  arena, it is DRAM this engine owns, and no PTE points at it - so a
;  word in it that ever changes means an engine wrote through an address
;  this file never authorised. That is a different question from "did
;  the picture come out right" and it needs its own answer.
; ======================================================================

Procedure.i neon_RoundPage(v.i)
  ProcedureReturn ((v + 4095) / 4096) * 4096
EndProcedure

Procedure.i neon_InitFail(code.i)
  Protected r.i
  If v3d_owner <> 0
    If v3d_mmuOn <> 0
      r = V3dMmuOff()
    Else
      r = #V3D_OK
    EndIf
    If r = #V3D_OK
      r = V3dOwnershipRelease()
    EndIf
    If r <> #V3D_OK
      neon_err = #NEON_ERR_V3D
      ProcedureReturn #NEON_ERR_V3D
    EndIf
  EndIf
  gNeonReady = 0
  neon_err = code
  neon_mapBase = 0 : neon_mapBytes = 0
  neon_extraMapBase = 0 : neon_extraMapBytes = 0
  ProcedureReturn code
EndProcedure

Procedure.i NeonInit()
  Protected r.i
  Protected p.i
  Protected n.i
  Protected maxVa.i
  Protected fbPage0.i
  Protected fbMapEnd.i
  Protected extraMapEnd.i
  Protected capPlan.V3dRenderPlan

  gNeonReady = 0
  neon_err   = #NEON_OK

  If gNeonLifecycleMode = #NEON_BACKEND_EXTERNAL
    If gNeonLifecycleInit = 0
      neon_err = #NEON_ERR_BACKEND
      ProcedureReturn #NEON_ERR_BACKEND
    EndIf
    r = gNeonLifecycleInit()
    gNeonLifecycleError = r
    If r <> #NEON_OK
      neon_err = #NEON_ERR_BACKEND
      ProcedureReturn #NEON_ERR_BACKEND
    EndIf
    If NeonDrawBackendActive() = 0
      gNeonLifecycleError = #NEON_ERR_BACKEND
      If gNeonLifecycleShutdown <> 0
        gNeonLifecycleShutdown()
      EndIf
      neon_err = #NEON_ERR_BACKEND
      ProcedureReturn #NEON_ERR_BACKEND
    EndIf
    gNeonReady = 1
    ProcedureReturn #NEON_OK
  EndIf

  If neon_arena = 0
    neon_err = #NEON_ERR_ARENA
    ProcedureReturn #NEON_ERR_ARENA
  EndIf
  If neon_fb = 0
    neon_err = #NEON_ERR_SURFACE
    ProcedureReturn #NEON_ERR_SURFACE
  EndIf

  ; ------------------------------------------------------------------
  ;  1. V3D itself. The bridge, the power domain, the clock and IDENT.
  ; ------------------------------------------------------------------
  r = V3dInit()
  If r <> #V3D_OK
    neon_err = #NEON_ERR_V3D
    ProcedureReturn #NEON_ERR_V3D
  EndIf
  r = V3dOwnershipClaim()
  If r <> #V3D_OK
    ProcedureReturn neon_InitFail(#NEON_ERR_V3D)
  EndIf

  ; ------------------------------------------------------------------
  ;  2. The frame geometry, so the pool sizes below are the hardware's
  ;     numbers and not this file's guesses.
  ; ------------------------------------------------------------------
  r = V3dRenderBegin(neon_physW, neon_physH, #V3D_OFMT_RGBA8)
  If r <> #V3D_OK
    ProcedureReturn neon_InitFail(#NEON_ERR_GEOMETRY)
  EndIf
  If neon_capPhysW < neon_physW : neon_capPhysW = neon_physW : EndIf
  If neon_capPhysH < neon_physH : neon_capPhysH = neon_physH : EndIf
  r = V3dRenderPlanBuild(neon_capPhysW, neon_capPhysH, #V3D_OFMT_RGBA8, 1, 0, 0, @capPlan)
  If r <> #V3D_OK
    ProcedureReturn neon_InitFail(#NEON_ERR_GEOMETRY)
  EndIf

  ; ------------------------------------------------------------------
  ;  3. The page table's extent, derived rather than reserved. The
  ;     highest virtual address this engine uses is whichever is
  ;     higher of the end of the framebuffer and the top of the arena.
  ; ------------------------------------------------------------------
  ; The framebuffer span to map may be larger than one screen when a
  ; double-height surface is in use (NeonSurfaceMapSpan), so both halves
  ; are reachable and the render target can be flipped between them.
  If neon_fbMapBytes < neon_fbBytes
    neon_fbMapBytes = neon_fbBytes
  EndIf
  fbPage0  = (neon_fb / 4096) * 4096
  fbMapEnd = neon_RoundPage(neon_fb + neon_fbMapBytes)
  extraMapEnd = neon_extraMapBase + neon_extraMapBytes
  If neon_extraMapBytes > 0
    If neon_extraMapBase < fbMapEnd And extraMapEnd > fbPage0
      ProcedureReturn neon_InitFail(#NEON_ERR_GEOMETRY)
    EndIf
    If neon_extraMapBase < neon_arenaEnd And extraMapEnd > neon_arena
      ProcedureReturn neon_InitFail(#NEON_ERR_ARENA)
    EndIf
  EndIf
  neon_mapBase = neon_fb
  neon_mapBytes = neon_fbMapBytes
  maxVa    = fbMapEnd
  If neon_arenaEnd > maxVa
    maxVa = neon_arenaEnd
  EndIf
  If extraMapEnd > maxVa
    maxVa = extraMapEnd
  EndIf
  gNeonPtBytes = neon_RoundPage((maxVa / 4096) * 4)

  ; ------------------------------------------------------------------
  ;  4. CARVE. Everything is page aligned, because the V3D MMU maps
  ;     pages and a buffer that shares a page with another buffer
  ;     cannot be unmapped without unmapping its neighbour.
  ; ------------------------------------------------------------------
  p = neon_arena

  neon_pt = p
  p = p + gNeonPtBytes

  neon_illegal = p
  p = p + 4096

  ; The three QPU programs and, in the page after them, the two static
  ; uniform streams and the default attribute values.
  neon_code      = p
  neon_codeBytes = 4096
  p = p + 4096

  neon_unifCs = p            ; 8 words
  neon_unifVs = p + 64       ; 6 words
  ; The default attribute values live in the same page, at +128.
  ; Mesa always supplies an address (v3dx_draw.c:701-703) and the
  ; hardware reads from it for any component a shader asks for that
  ; the record does not supply. Nothing here asks for one; it is
  ; (0,0,0,1) because that is what a missing vec4 should be.
  p = p + 4096

  neon_tstateBytes = neon_RoundPage(capPlan\tileStateBytes)
  neon_tstate = p
  p = p + neon_tstateBytes

  neon_tallocBytes = neon_RoundPage(capPlan\tileAllocBytes)
  neon_talloc = p
  p = p + neon_tallocBytes

  ; The binner's overflow pool. Mesa sizes the primary pool so this is
  ; never reached; it is here because "never" is a property of a
  ; workload and this engine's workload is a caller's.
  neon_overflowBytes = 262144
  neon_overflow = p
  p = p + neon_overflowBytes

  ; The bin list. Prologue and epilogue are about sixty bytes; each
  ; draw costs a GL_SHADER_STATE (5) plus a VERTEX_ARRAY_PRIMS (10),
  ; and each clip change a CLIP_WINDOW (9). Thirty-two bytes per draw
  ; is twice the worst case and the readahead slack is inside it. The
  ; textured draws share this list, so their maximum is budgeted too.
  gNeonBclBytes = neon_RoundPage(((#NEON_MAX_DRAWS + #NEON_MAX_TDRAWS) * 32) + 8192)
  neon_bcl = p
  p = p + gNeonBclBytes

  neon_tilelistBytes = 4096
  neon_tilelist = p
  p = p + neon_tilelistBytes

  ; The render list carries one SUPERTILE_COORDINATES per supertile.
  ; 1920 x 1080 is 510 tiles; the supertile sweep is at most that many
  ; three-byte packets plus a fixed prologue, so 64 KiB is generous by
  ; a factor of thirty and costs nothing.
  neon_rclBytes = 65536
  neon_rcl = p
  p = p + neon_rclBytes

  neon_shrecBytes = #NEON_MAX_DRAWS * #NEON_SHREC_STRIDE
  neon_shrec = p
  p = p + neon_shrecBytes

  neon_unifBytes = #NEON_MAX_DRAWS * #NEON_UNIF_STRIDE
  neon_unif = p
  p = p + neon_unifBytes

  neon_vertsBytes = #NEON_MAX_VERTS * #NEON_VERT_BYTES
  gNeonVerts = p
  p = p + neon_vertsBytes

  ; ------------------------------------------------------------------
  ;  The textured path's buffers (M3). All page-aligned and all mapped
  ;  through the V3D MMU below - the atlas, the ten-attribute vertex
  ;  array, and the textured records and FS uniform blocks. The atlas
  ;  is carved at its MAXIMUM size; the TFU tiles only the height the
  ;  font needs.
  ; ------------------------------------------------------------------
  neon_texSrc = p
  p = p + #NEON_ATLAS_MAXBYTES
  neon_tex = p
  p = p + #NEON_ATLAS_MAXBYTES
  neon_texState = p
  p = p + 4096

  neon_tshrecBytes = #NEON_MAX_TDRAWS * #NEON_TSHREC_STRIDE
  neon_tshrec = p
  p = p + neon_tshrecBytes

  neon_tunifBytes = #NEON_MAX_TDRAWS * #NEON_UNIF_STRIDE
  neon_tunif = p
  p = p + neon_tunifBytes

  neon_tvertsBytes = #NEON_MAX_TVERTS * #NEON_TVERT_BYTES
  neon_tverts = p
  p = p + neon_tvertsBytes

  ; The two clip-coordinate tables. They are NOT mapped through the
  ; V3D MMU: the CPU reads them while it builds vertices and no engine
  ; ever sees them.
  neon_xcTab = p
  p = p + neon_RoundPage(neon_capPhysW * 3 * 4)
  neon_ycTab = p
  p = p + neon_RoundPage(neon_capPhysH * 3 * 4)

  ; The per-glyph cell-edge UV table, also CPU-only and unmapped: one
  ; page holds four floats for each of up to 256 glyphs. Built once when
  ; the atlas is, read by Neon_TextTex when it lays out a quad.
  neon_glyphUV = p
  p = p + 4096

  neon_guard = p
  p = p + 4096

  neon_top  = p
  neon_need = p - neon_arena

  If p > neon_arenaEnd
    ProcedureReturn neon_InitFail(#NEON_ERR_ARENA)
  EndIf

  ; The arena must not sit inside the framebuffer, in either direction.
  If neon_arena < fbMapEnd
    If neon_top > fbPage0
      neon_err = #NEON_ERR_ARENA
      ProcedureReturn #NEON_ERR_ARENA
    EndIf
  EndIf

  ; ------------------------------------------------------------------
  ;  5. THE PAGE TABLE. Identity, VA = PA, everything except the guard.
  ; ------------------------------------------------------------------
  r = V3dMmuInit(neon_pt, gNeonPtBytes, neon_illegal)
  If r <> #V3D_OK
    ProcedureReturn neon_InitFail(#NEON_ERR_V3D)
  EndIf

  ; The page table itself is NOT mapped: nothing in the pipeline reads
  ; it through a virtual address, the MMU walks it physically.
  r = V3dMmuMap(neon_code, neon_code, 8192)
  If r = #V3D_OK
    r = V3dMmuMap(neon_tstate, neon_tstate, neon_tstateBytes)
  EndIf
  If r = #V3D_OK
    r = V3dMmuMap(neon_talloc, neon_talloc, neon_tallocBytes)
  EndIf
  If r = #V3D_OK
    r = V3dMmuMap(neon_overflow, neon_overflow, neon_overflowBytes)
  EndIf
  If r = #V3D_OK
    r = V3dMmuMap(neon_bcl, neon_bcl, gNeonBclBytes)
  EndIf
  If r = #V3D_OK
    r = V3dMmuMap(neon_tilelist, neon_tilelist, neon_tilelistBytes)
  EndIf
  If r = #V3D_OK
    r = V3dMmuMap(neon_rcl, neon_rcl, neon_rclBytes)
  EndIf
  If r = #V3D_OK
    r = V3dMmuMap(neon_shrec, neon_shrec, neon_shrecBytes)
  EndIf
  If r = #V3D_OK
    r = V3dMmuMap(neon_unif, neon_unif, neon_unifBytes)
  EndIf
  If r = #V3D_OK
    r = V3dMmuMap(gNeonVerts, gNeonVerts, neon_vertsBytes)
  EndIf
  ; The textured path's buffers (M3): the raster atlas the TFU reads,
  ; the tiled atlas the TMU reads, the texture/sampler state, and the
  ; textured vertex array, records and uniform blocks.
  If r = #V3D_OK
    r = V3dMmuMap(neon_texSrc, neon_texSrc, #NEON_ATLAS_MAXBYTES)
  EndIf
  If r = #V3D_OK
    r = V3dMmuMap(neon_tex, neon_tex, #NEON_ATLAS_MAXBYTES)
  EndIf
  If r = #V3D_OK
    r = V3dMmuMap(neon_texState, neon_texState, 4096)
  EndIf
  If r = #V3D_OK
    r = V3dMmuMap(neon_tshrec, neon_tshrec, neon_tshrecBytes)
  EndIf
  If r = #V3D_OK
    r = V3dMmuMap(neon_tunif, neon_tunif, neon_tunifBytes)
  EndIf
  If r = #V3D_OK
    r = V3dMmuMap(neon_tverts, neon_tverts, neon_tvertsBytes)
  EndIf
  ; The framebuffer, widened to whole pages. Its base is the
  ; firmware's and is only promised $100 alignment (display.pi4's
  ; allocate tag asks for #MBX_FB_ALLOC_ALIGN), so the MAPPING is
  ; widened while the RENDER TARGET keeps the exact address.
  If r = #V3D_OK
    r = V3dMmuMap(fbPage0, fbPage0, fbMapEnd - fbPage0)
  EndIf
  If r = #V3D_OK And neon_extraMapBytes > 0
    r = V3dMmuMap(neon_extraMapBase, neon_extraMapBase, neon_extraMapBytes)
  EndIf
  If r <> #V3D_OK
    ProcedureReturn neon_InitFail(#NEON_ERR_V3D)
  EndIf

  ; ------------------------------------------------------------------
  ;  6. The render target and the two pools. None of these change
  ;     between frames.
  ; ------------------------------------------------------------------
  r = V3dRenderTarget(neon_fb, neon_fbBytes, #V3D_MEMFMT_RASTER, neon_pitch, 0)
  If r <> #V3D_OK
    ProcedureReturn neon_InitFail(#NEON_ERR_GEOMETRY)
  EndIf
  r = V3dRenderPool(neon_talloc, neon_tallocBytes, neon_tstate, neon_tstateBytes)
  If r <> #V3D_OK
    ProcedureReturn neon_InitFail(#NEON_ERR_GEOMETRY)
  EndIf
  r = V3dBinOverflow(neon_overflow, neon_overflowBytes)
  If r <> #V3D_OK
    ProcedureReturn neon_InitFail(#NEON_ERR_GEOMETRY)
  EndIf

  ; ------------------------------------------------------------------
  ;  7. The three shaders.
  ; ------------------------------------------------------------------
  r = neon_BuildCoordShader()
  If r <> #V3DQ_OK
    ProcedureReturn neon_InitFail(#NEON_ERR_SHADER)
  EndIf
  r = neon_BuildVertexShader()
  If r <> #V3DQ_OK
    ProcedureReturn neon_InitFail(#NEON_ERR_SHADER)
  EndIf
  r = neon_BuildFragmentShader()
  If r <> #V3DQ_OK
    ProcedureReturn neon_InitFail(#NEON_ERR_SHADER)
  EndIf

  ; The textured path's three shaders (M3), in the code slots after the
  ; flat three. They do not depend on the font, so they are built once
  ; here; only the atlas the fragment shader samples is built lazily.
  r = neon_BuildTexCoordShader()
  If r <> #V3DQ_OK
    ProcedureReturn neon_InitFail(#NEON_ERR_SHADER)
  EndIf
  r = neon_BuildTexVertexShader()
  If r <> #V3DQ_OK
    ProcedureReturn neon_InitFail(#NEON_ERR_SHADER)
  EndIf
  r = neon_BuildTexFragmentShader()
  If r <> #V3DQ_OK
    ProcedureReturn neon_InitFail(#NEON_ERR_SHADER)
  EndIf

  ; ------------------------------------------------------------------
  ;  8. The two static uniform streams and the default attribute
  ;     values. In the order the shaders touch the stream, which is
  ;     the only order that means anything.
  ; ------------------------------------------------------------------
  PokeN(neon_unifCs +  0, 0)
  PokeN(neon_unifCs +  4, 1)
  PokeN(neon_unifCs +  8, 2)
  PokeN(neon_unifCs + 12, 3)
  PokeN(neon_unifCs + 16, 4)
  PokeN(neon_unifCs + 20, 5)
  PokeN(neon_unifCs + 24, #NEON_F_ZERO)
  PokeN(neon_unifCs + 28, #NEON_F_ONE)

  PokeN(neon_unifVs +  0, 0)
  PokeN(neon_unifVs +  4, 1)
  PokeN(neon_unifVs +  8, 2)
  PokeN(neon_unifVs + 12, 3)
  PokeN(neon_unifVs + 16, #NEON_F_ZERO)
  PokeN(neon_unifVs + 20, #NEON_F_ONE)

  PokeN(neon_unifCs + 128, #NEON_F_ZERO)
  PokeN(neon_unifCs + 132, #NEON_F_ZERO)
  PokeN(neon_unifCs + 136, #NEON_F_ZERO)
  PokeN(neon_unifCs + 140, #NEON_F_ONE)

  ; The textured coordinate and vertex shaders' constant uniform
  ; streams - the LDVPM offsets 0..7 and 0..9 - live in the same page,
  ; clear of the flat streams above. The textured fragment shader's
  ; uniforms are per-draw and live in neon_tunif.
  neon_unifTcs = neon_unifCs + 256
  neon_unifTvs = neon_unifCs + 320
  n = 0
  While n < 8
    PokeN(neon_unifTcs + (n * 4), n)
    n = n + 1
  Wend
  n = 0
  While n < 10
    PokeN(neon_unifTvs + (n * 4), n)
    n = n + 1
  Wend

  ; ------------------------------------------------------------------
  ;  9. The lookup tables. Built once, here, because every value in
  ;     them depends on the surface size.
  ; ------------------------------------------------------------------
  n = 0
  While n < 256
    neon_byteF32[n] = neon_F32Ratio(n, 255)
    n = n + 1
  Wend
  neon_BuildCoordinateTables(neon_physW, neon_physH, neon_cx, neon_cy)

  gNeonReady = 1
  ProcedureReturn #NEON_OK
EndProcedure

; The address of the default attribute block, for the shader record.
Procedure.i neon_DefaultsAddr()
  ProcedureReturn neon_unifCs + 128
EndProcedure

; ======================================================================
;  NeonShutdown - HAND THE V3D MMU BACK.
;
;  CALL THIS BEFORE RETURNING TO THE MONITOR. A payload that enables
;  the V3D MMU with its own page table and PT_INVALID_ABORT set, and
;  then hands control back, has left a piece of shared hardware
;  pointing at memory it no longer owns. The VPU is not asleep while a
;  bare-metal payload runs - it drives the display and it answers the
;  property mailbox - and it reaches memory through this MMU.
;
;  ======================================================================
;  WHAT THIS IS *NOT* THE FIX FOR, BECAUSE IT WAS WRITTEN AS ONE
;  ======================================================================
;  There IS a measured failure on this board where the firmware's
;  property mailbox dies and stays dead until a reset - MAIL1_STA
;  $80000008, full of requests nobody is consuming, every transaction
;  ending in #MBX_ERR_TXTIMEOUT, DisplayInit returning -19 for every
;  payload afterwards.
;
;  I BLAMED THE MMU FOR IT AND I WAS WRONG. pi4NeonMbx.pi4 walks the
;  bring-up one rung at a time and the answer is that V3dInit ALONE
;  does it: on a freshly reset board, DisplayInit works before it and
;  returns -19 with #MBX_ERR_RXTIMEOUT after it, with five requests
;  already queued - and the MMU is not touched until two rungs later.
;  The firmware stops answering part way through V3dAskFirmware's own
;  twelve transactions.
;
;  This procedure STAYS, because handing the MMU back is right on its
;  own merits and costs four register writes. It is documented as not
;  being the fix so that nobody reads a green run as evidence that the
;  mailbox problem is solved. The workaround that works is to get the
;  surface BEFORE V3dInit and reset the board between runs; the
;  experiment that would name the exact tag is pi4NeonMbxTag.pi4.
;
;  WHAT IT DOES NOT DO is power the domain down or put the clock back.
;  The firmware had V3D powered and clocked before this engine
;  arrived, and undoing that would be undoing something that was not
;  broken.
; ======================================================================
Procedure.i NeonShutdown()
  Protected r.i
  If gNeonReady = 0 And v3d_owner = 0
    ProcedureReturn #NEON_OK
  EndIf
  If gNeonLifecycleMode = #NEON_BACKEND_EXTERNAL
    If gNeonLifecycleShutdown = 0
      neon_err = #NEON_ERR_BACKEND
      ProcedureReturn #NEON_ERR_BACKEND
    EndIf
    r = gNeonLifecycleShutdown()
    gNeonLifecycleError = r
    If r <> #NEON_OK
      neon_err = #NEON_ERR_BACKEND
      ProcedureReturn #NEON_ERR_BACKEND
    EndIf
    NeonDrawBackendClear()
    neon_inFrame = 0
    gNeonReady = 0
    neon_err = #NEON_OK
    ProcedureReturn #NEON_OK
  EndIf
  If v3d_owner = 0
    neon_err = #NEON_ERR_V3D
    ProcedureReturn #NEON_ERR_V3D
  EndIf
  r = V3dOwnershipRelease()
  If r <> #V3D_OK
    neon_err = #NEON_ERR_V3D
    ProcedureReturn #NEON_ERR_V3D
  EndIf
  neon_inFrame = 0
  gNeonReady   = 0
  neon_mapBase = 0 : neon_mapBytes = 0
  neon_extraMapBase = 0
  neon_extraMapBytes = 0
  ProcedureReturn #NEON_OK
EndProcedure


; ======================================================================
;  THE FRAME
;
;  Neon_ChromeBeginFrame / Neon_ChromeEndFrame are the engine's names
;  (GlUIChrome.pbi:237-249 and :279-294) and they do the INPUT half of
;  the frame - snapshot the mouse, work out the click edge, clear the
;  hot list. On the desktop the GL half is the host's job, because the
;  host owns the window and the swap.
;
;  Here there is no host, so this file owns both, and they are two
;  calls rather than one:
;
;      NeonFrameBegin(clearColour)   the GPU half - start the lists
;      Neon_ChromeBeginFrame(...)    the input half - unchanged
;        ... widgets ...
;      Neon_ChromeEndFrame()         the input half
;      NeonFrameEnd()                submit, wait, and the picture is up
;
;  KEEPING THEM SEPARATE IS DELIBERATE. A caller that wants to draw
;  without the chrome kit's input model - a game, a test, a probe
;  counting pixels - uses the two Neon Frame calls and never touches
;  the other two, and the chrome kit does not become a dependency of
;  the rasteriser.
; ======================================================================

; What the bin list currently says the clip window is. Tracked so a
; run of primitives under one clip costs one CLIP_WINDOW packet and
; not one per primitive.
Global neon_emitClipX.i = -1
Global neon_emitClipY.i = -1
Global neon_emitClipW.i = -1
Global neon_emitClipH.i = -1

; ----------------------------------------------------------------------
;  neon_Prologue - the state every draw in this frame inherits.
;
;  Everything here is emitted once per frame and never again, because
;  the CLE keeps its state between packets and the whole point of a
;  bin list is to say a thing once.
;
;  THE ONE PACKET THAT IS NOT MESA'S DEFAULT IS THE BLEND. CFG_BITS
;  bit 19 turns the blender on (v3dx_emit.c:328), BLEND_ENABLES names
;  render target 0 (:484-487) and BLEND_CFG sets the equation
;  (:104-124). SRC_ALPHA / INV_SRC_ALPHA, mode ADD, on both the colour
;  and the alpha channel, which is exactly and only what
;  GlUtilities.pbi:718-719 asks for:
;
;      dst = src.rgb * src.a + dst.rgb * (1 - src.a)
;
;  CULLING IS OFF - both facing bits are set - so the winding of a
;  rectangle cannot silently discard it. A 2D UI has no notion of
;  facing and a back-face cull here would be a trap with no upside.
; ----------------------------------------------------------------------
Procedure neon_Prologue()
  Protected cfg.i

  ; The clip window starts at the whole surface. CLIP_WINDOW's own
  ; fields are 16 bits each (v3d_packet.xml:801-806).
  V3dClClipWindow(0, 0, neon_physW, neon_physH)
  neon_emitClipX = 0
  neon_emitClipY = 0
  neon_emitClipW = neon_physW
  neon_emitClipH = neon_physH

  ; Forward and reverse facing both enabled, not clockwise, depth
  ; function 7 - ALWAYS - because there is no depth buffer. Bit 19 is
  ; the blend enable and it is ORed in here rather than hidden inside
  ; V3dCfgBitsWord(), which belongs to callers who also choose the
  ; cull and depth bits.
  cfg = V3dCfgBitsWord(1, 1, 0, 7) | (1 << 19)
  V3dClCfgBits(cfg)

  V3dClBlendEnables(1)
  V3dClBlendCfg(1, #V3D_BF_INV_SRC_ALPHA, #V3D_BF_SRC_ALPHA, #V3D_BM_ADD, #V3D_BF_INV_SRC_ALPHA, #V3D_BF_SRC_ALPHA, #V3D_BM_ADD)

  V3dClPointSize(#NEON_F_ONE)
  V3dClLineWidth(#NEON_F_ONE)

  ; The clipper. Half width and half height in 1/256ths of a pixel,
  ; v3d_packet.xml:820-823, and VIEWPORT_OFFSET carries the centre in
  ; the same units, :808-813. The two are computed from the same
  ; neon_cx / neon_cy so they cannot drift apart.
  V3dClClipperXyScaling(neon_F32Int(neon_cx * 256), neon_F32Int(neon_cy * 256))
  V3dClClipperZScaleOffset(#NEON_F_ONE, #NEON_F_ZERO)
  V3dClClipperZMinMax(#NEON_F_MONE, #NEON_F_ONE)
  V3dClViewportOffset(neon_cx * 256, 0, neon_cy * 256, 0)

  ; Zero means WRITE EVERY CHANNEL. It is a disable mask
  ; (v3dx_emit.c:82-91, `return (~colormask) & 0xf`).
  V3dClColorWriteMasks(0)

  ; No varyings anywhere in this engine, so all three flag arrays are
  ; zeroed rather than left to whatever the last job on this core set.
  V3dClZeroAllFlatShadeFlags()
  V3dClZeroAllNonperspFlags()
  V3dClZeroAllCentroidFlags()

  V3dClOcclusionQueryCounter(0)

  ; Coverage 1.0 in the packet's own 1.7 fixed point, and all four
  ; sample bits. No MSAA.
  V3dClSampleState($3F80, $F)

  V3dClVcmCacheSize(4, 4)
EndProcedure

; ----------------------------------------------------------------------
;  NeonFrameBegin - start a frame, and clear the surface to `colour`.
;
;  THE CLEAR IS THE GPU'S AND IT IS FREE. The tile buffer starts at the
;  clear colour, so the engine's own full-surface background box
;  (GlUIChrome.pbi has no glClear anywhere - the chrome paints a
;  ground rectangle instead) can simply be the clear and cost nothing.
;  A caller that wants the engine's literal behaviour can pass a
;  transparent clear and draw the ground box; both work.
;
;  `colour` here is the SURFACE WORD, not a shaded colour: the clear
;  is a packed 32-bit value that the tile store writes verbatim
;  (pi4V3dClear.pi4 proved that on 4096 pixels), so it goes in as this
;  file's packed AARRGGBB with no channel swap. See the channel-order
;  section above for why the shader path is the other way round.
; ----------------------------------------------------------------------
Procedure.i NeonFrameBegin(colour.i)
  Protected r.i
  Protected t0.i
  Protected hz.i

  If gNeonLifecycleMode = #NEON_BACKEND_EXTERNAL
    If gNeonReady = 0
      neon_err = #NEON_ERR_ARENA
      ProcedureReturn #NEON_ERR_ARENA
    EndIf
    If neon_inFrame <> 0
      neon_err = #NEON_ERR_INFRAME
      ProcedureReturn #NEON_ERR_INFRAME
    EndIf
    If gNeonLifecycleBegin = 0
      neon_err = #NEON_ERR_BACKEND
      ProcedureReturn #NEON_ERR_BACKEND
    EndIf
    r = gNeonLifecycleBegin(colour)
    gNeonLifecycleError = r
    If r <> #NEON_OK
      neon_err = #NEON_ERR_BACKEND
      ProcedureReturn #NEON_ERR_BACKEND
    EndIf
    neon_inFrame = 1
    ProcedureReturn #NEON_OK
  EndIf

  ; THE GUARD IS NOT DECORATION. V3dCounterHz() reads CNTFRQ_EL0, which
  ; is 54,000,000 on this part and ZERO on a part where nothing set it.
  ; Dividing by (0 / 1000000) is a divide by zero, and a divide by zero
  ; in the middle of a frame is a board that stops answering - which is
  ; the most expensive failure this bench has, because it looks exactly
  ; like a V3D job that never completed.
  hz = V3dCounterHz() / 1000000
  If hz < 1
    hz = 1
  EndIf
  t0 = V3dTicks()
  If gNeonReady = 0
    neon_err = #NEON_ERR_ARENA
    ProcedureReturn #NEON_ERR_ARENA
  EndIf
  If neon_inFrame <> 0
    neon_err = #NEON_ERR_INFRAME
    ProcedureReturn #NEON_ERR_INFRAME
  EndIf

  neon_nDraws   = 0
  neon_nVerts   = 0
  neon_nBoxes   = 0
  neon_nGlyphs  = 0
  neon_nRuns    = 0
  neon_nClipped = 0
  neon_clipOn   = 0

  ; The textured path's cursors, and the tracked non-perspective flag
  ; state. The prologue below zeros the flags, so the tracker resets to
  ; 0 and the first textured draw re-emits $3.
  neon_nTDraws  = 0
  neon_nTVerts  = 0
  neon_nTGlyphs = 0
  neon_emitNP   = 0

  ; The depth clear value is 1.0 and the stencil zero. Neither buffer
  ; exists in this configuration; the packet is still written because
  ; TILE_RENDERING_MODE_CFG carries the field whether or not anything
  ; reads it.
  V3dRenderClear(colour, #NEON_F_ONE, 0)

  r = V3dRclBuild(neon_tilelist, neon_tilelistBytes, neon_rcl, neon_rclBytes)
  If r <> #V3D_OK
    neon_err = #NEON_ERR_LIST
    ProcedureReturn #NEON_ERR_LIST
  EndIf

  r = V3dBclBegin(neon_bcl, gNeonBclBytes)
  If r <> #V3D_OK
    neon_err = #NEON_ERR_LIST
    ProcedureReturn #NEON_ERR_LIST
  EndIf

  neon_Prologue()
  If V3dClError() <> #V3D_OK
    neon_err = #NEON_ERR_LIST
    ProcedureReturn #NEON_ERR_LIST
  EndIf

  neon_inFrame = 1
  gNeonUsBegin = (V3dTicks() - t0) / hz
  ProcedureReturn #NEON_OK
EndProcedure

; ----------------------------------------------------------------------
;  NeonFrameEnd - cap the list, submit both jobs, wait for both.
;
;  THE BINNER HAS TO RUN EVEN WHEN NOTHING WAS DRAWN, because the
;  render list branches into a per-tile list only the PTB produces
;  (V3dBclBegin's own comment, and v3dx_draw.c:1671-1791).
;  V3dRenderSubmit() refuses if CLE_BFC has not moved.
;
;  CACHE MAINTENANCE FOR WHAT V3dBinSubmit() CANNOT SEE. It cleans the
;  bin list, the tile allocation pool and the tile state, because
;  those are the three it is handed. The shader records, the vertex
;  array, the uniform blocks and the QPU programs are reached THROUGH
;  the records and the library never sees their extents. With the ARM
;  MMU off this costs nothing and does nothing - every access is
;  Device-nGnRnE - and it is here so that the first cacheable-DRAM run
;  does not have to discover it.
;
;  ONLY THE PART USED IS CLEANED. Cleaning the whole two-megabyte
;  vertex arena on a frame that drew four rectangles would be most of
;  the frame time on a cacheable run.
; ----------------------------------------------------------------------
Procedure.i NeonFrameEnd()
  Protected r.i
  Protected t0.i
  Protected hz.i

  If gNeonLifecycleMode = #NEON_BACKEND_EXTERNAL
    If neon_inFrame = 0
      neon_err = #NEON_ERR_NOFRAME
      ProcedureReturn #NEON_ERR_NOFRAME
    EndIf
    If gNeonLifecycleEnd = 0
      neon_inFrame = 0
      neon_err = #NEON_ERR_BACKEND
      ProcedureReturn #NEON_ERR_BACKEND
    EndIf
    r = gNeonLifecycleEnd()
    gNeonLifecycleError = r
    neon_inFrame = 0
    If r <> #NEON_OK
      neon_err = #NEON_ERR_BACKEND
      ProcedureReturn #NEON_ERR_BACKEND
    EndIf
    neon_err = #NEON_OK
    ProcedureReturn #NEON_OK
  EndIf

  hz = V3dCounterHz() / 1000000
  If hz < 1
    hz = 1
  EndIf
  t0 = V3dTicks()
  If neon_inFrame = 0
    neon_err = #NEON_ERR_NOFRAME
    ProcedureReturn #NEON_ERR_NOFRAME
  EndIf
  neon_inFrame = 0

  r = V3dBclFinish()
  If r <> #V3D_OK
    neon_err = #NEON_ERR_LIST
    ProcedureReturn #NEON_ERR_LIST
  EndIf

  V3dCacheRange(neon_code, neon_codeBytes)
  V3dCacheRange(neon_unifCs, 4096)
  If neon_nDraws > 0
    V3dCacheRange(neon_shrec, neon_nDraws * #NEON_SHREC_STRIDE)
    V3dCacheRange(neon_unif, neon_nDraws * #NEON_UNIF_STRIDE)
  EndIf
  If neon_nVerts > 0
    V3dCacheRange(gNeonVerts, neon_nVerts * #NEON_VERT_BYTES)
  EndIf
  ; The textured path's per-frame writes. The atlas and the texture
  ; state were cleaned when the atlas was built; only the records,
  ; uniforms and vertices this frame produced need cleaning here.
  If neon_nTDraws > 0
    V3dCacheRange(neon_tshrec, neon_nTDraws * #NEON_TSHREC_STRIDE)
    V3dCacheRange(neon_tunif, neon_nTDraws * #NEON_UNIF_STRIDE)
  EndIf
  If neon_nTVerts > 0
    V3dCacheRange(neon_tverts, neon_nTVerts * #NEON_TVERT_BYTES)
  EndIf
  V3dBarrier()
  gNeonUsClean = (V3dTicks() - t0) / hz
  t0 = V3dTicks()

  r = V3dBinSubmit()
  If r <> #V3D_OK
    neon_err = #NEON_ERR_BIN
    ProcedureReturn #NEON_ERR_BIN
  EndIf
  r = V3dBinWait(1000000)
  If r <> #V3D_OK
    neon_err = #NEON_ERR_BIN
    ProcedureReturn #NEON_ERR_BIN
  EndIf
  gNeonUsBin = (V3dTicks() - t0) / hz
  t0 = V3dTicks()

  r = V3dRenderSubmit()
  If r <> #V3D_OK
    neon_err = #NEON_ERR_RENDER
    ProcedureReturn #NEON_ERR_RENDER
  EndIf
  r = V3dRenderWait(2000000)
  If r <> #V3D_OK
    neon_err = #NEON_ERR_RENDER
    ProcedureReturn #NEON_ERR_RENDER
  EndIf
  gNeonUsRender = (V3dTicks() - t0) / hz

  ProcedureReturn #NEON_OK
EndProcedure


; ======================================================================
;  THE VERTEX ARRAY AND THE DRAW
; ======================================================================

; ----------------------------------------------------------------------
;  neon_Vertex - append one vertex, in pixels.
;
;  Xc and Yc are the CLIP coordinates the clipper works in, and Xs and
;  Ys the VIEWPORT coordinates the rasteriser works in. Both are
;  derived from the same pixel position and from the same neon_cx /
;  neon_cy, so a mismatch between them is not expressible:
;
;      Xs = (x - cx) * 256          an INTEGER, 1/256 pixel
;      Xc = (x - cx) / cx           a float, -1 at the left edge
;
;  and CLIPPER_XY_SCALING's half width is cx * 256, so
;  Xc * halfWidth = Xs identically.
; ----------------------------------------------------------------------
Procedure neon_Vertex(x.i, y.i)
  Protected b.i
  Protected xc.i
  Protected yc.i
  Protected k.i
  Protected px.i
  Protected py.i

  If neon_nVerts >= #NEON_MAX_VERTS
    neon_err = #NEON_ERR_VERTS
    ProcedureReturn
  EndIf

  ; Coordinates reaching this boundary are logical. Convert the half-open
  ; geometry boundary to the physical render target once; layout and hit
  ; testing above this procedure remain in the caller's orientation.
  px = x
  py = y
  If neon_rot = 90
    px = neon_h - y
    py = x
  ElseIf neon_rot = 180
    px = neon_w - x
    py = neon_h - y
  ElseIf neon_rot = 270
    px = y
    py = neon_w - x
  EndIf

  ; The table covers -w..2w-1 and -h..2h-1. Anything outside it is
  ; geometry a whole screen off an edge, and it takes the slow exact
  ; path rather than being clamped: a clamped clip coordinate and an
  ; unclamped screen coordinate would put the clipper and the
  ; rasteriser on different geometry, which is a wrong picture rather
  ; than a slow one.
  k = px + neon_physW
  If k >= 0 And k < (neon_physW * 3)
    xc = PeekN(neon_xcTab + (k * 4))
  Else
    xc = neon_F32Ratio(px - neon_cx, neon_cx)
  EndIf
  k = py + neon_physH
  If k >= 0 And k < (neon_physH * 3)
    yc = PeekN(neon_ycTab + (k * 4))
  Else
    yc = neon_F32Ratio(py - neon_cy, neon_cy)
  EndIf

  b = gNeonVerts + (neon_nVerts * #NEON_VERT_BYTES)
  PokeN(b +  0, xc)
  PokeN(b +  4, yc)
  PokeN(b +  8, ((px - neon_cx) * 256) & $FFFFFFFF)
  PokeN(b + 12, ((py - neon_cy) * 256) & $FFFFFFFF)
  neon_nVerts = neon_nVerts + 1
EndProcedure

; ----------------------------------------------------------------------
;  neon_SyncClip - put the wanted clip rectangle into the list, if the
;  list does not already say it.
;
;  THE CLIP IS HARDWARE AND IT IS PIXEL EXACT. That is the difference
;  between this and the stage-0 mock-up in pi4NeonLiar.pi4, which
;  clipped text a whole GLYPH CELL at a time because it had no
;  rectangle clip at all and had to drop cells that were not wholly
;  inside. A row of list text half over the bottom edge of its box is
;  cut in half here, which is what the engine does.
; ----------------------------------------------------------------------
Procedure neon_SyncClip()
  Protected x.i
  Protected y.i
  Protected w.i
  Protected h.i
  Protected p.i

  If neon_clipOn = 0
    x = 0
    y = 0
    w = neon_w
    h = neon_h
  Else
    x = neon_clipX
    y = neon_clipY
    w = neon_clipW
    h = neon_clipH
    ; CLIP_WINDOW's four fields are unsigned 16-bit. A negative left
    ; edge is a caller's rectangle running off the top left of the
    ; surface, which is legal in the engine and is not expressible
    ; here, so it is moved in and the width taken off it.
    If x < 0
      w = w + x
      x = 0
    EndIf
    If y < 0
      h = h + y
      y = 0
    EndIf
    If w < 0
      w = 0
    EndIf
    If h < 0
      h = 0
    EndIf
    If x > neon_w
      x = neon_w
    EndIf
    If y > neon_h
      y = neon_h
    EndIf
    If (x + w) > neon_w
      w = neon_w - x
    EndIf
    If (y + h) > neon_h
      h = neon_h - y
    EndIf
  EndIf

  ; CLIP_WINDOW is in physical raster coordinates. Transform the already
  ; clamped logical half-open rectangle as a rectangle, not four pixels:
  ; geometry boundaries use logicalH-y (no -1 pixel-centre adjustment).
  If neon_rot = 90
    p = x
    x = neon_h - (y + h)
    y = p
    p = w
    w = h
    h = p
  ElseIf neon_rot = 180
    x = neon_w - (x + w)
    y = neon_h - (y + h)
  ElseIf neon_rot = 270
    p = x
    x = y
    y = neon_w - (p + w)
    p = w
    w = h
    h = p
  EndIf

  If x = neon_emitClipX
    If y = neon_emitClipY
      If w = neon_emitClipW
        If h = neon_emitClipH
          ProcedureReturn
        EndIf
      EndIf
    EndIf
  EndIf

  V3dClClipWindow(x, y, w, h)
  neon_emitClipX = x
  neon_emitClipY = y
  neon_emitClipW = w
  neon_emitClipH = h
EndProcedure

; ----------------------------------------------------------------------
;  neon_Uniforms - the fragment shader's five words for one draw.
;
;  R, G, B, A as binary32 in 0..1, then the TLB configuration word,
;  which is fifth because the TLBU write is the fifth thing to touch
;  the stream (qpu_instr.c:646-658).
;
;  THE FIRST COMPONENT IS BLUE WHEN neon_rbSwap IS SET. See the
;  channel-order section: the display wants byte 0 to be blue and the
;  RGBA8 output format puts component 0 there.
; ----------------------------------------------------------------------
Procedure neon_Uniforms(slot.i, colour.i)
  Protected b.i
  b = neon_unif + (slot * #NEON_UNIF_STRIDE)
  If neon_rbSwap <> 0
    PokeN(b +  0, neon_byteF32[Neon_B(colour)])
    PokeN(b +  8, neon_byteF32[Neon_R(colour)])
  Else
    PokeN(b +  0, neon_byteF32[Neon_R(colour)])
    PokeN(b +  8, neon_byteF32[Neon_B(colour)])
  EndIf
  PokeN(b +  4, neon_byteF32[Neon_G(colour)])
  PokeN(b + 12, neon_byteF32[Neon_A(colour)])
  PokeN(b + 16, #NEON_TLB_CONF)
EndProcedure

; ----------------------------------------------------------------------
;  neon_Record - one GL Shader State Record and its four attribute
;  records, for one draw.
;
;  ALL FOUR ATTRIBUTES POINT AT THE SAME VERTEX ARRAY and differ only
;  in their four-byte offset within a 16-byte vertex. The draw picks
;  its own vertices with VERTEX_ARRAY_PRIMS's Index Of First Vertex,
;  so the base address never moves and the whole frame's geometry is
;  one contiguous array.
;
;  SLOTS 2 AND 3 ARE SIGNED INTEGERS READ AS INTEGERS. Xs and Ys are
;  1/256ths of a pixel; a vertex 24 pixels right of centre is
;  $00001800, which read as a float is a DENORMAL. An attribute
;  declared float that the vertex fetcher flushed to zero would
;  collapse every primitive onto the viewport centre, which looks
;  exactly like a wrong transform rather than a wrong declaration.
; ----------------------------------------------------------------------
Procedure.i neon_Record(slot.i)
  Protected r.i
  Protected k.i
  Protected addr.i

  addr = neon_shrec + (slot * #NEON_SHREC_STRIDE)
  r = V3dShaderRecordBegin(addr, #NEON_ATTRS)
  If r <> #V3D_OK
    ProcedureReturn r
  EndIf

  ; enable clipping, no fs Z writes, do not turn off early Z, no
  ; scoreboard wait on the first thread switch, disable implicit
  ; point/line varyings, zero varyings.
  V3dShaderRecordFlags(1, 0, 0, 0, 1, 0)

  ; Shared VPM segments, one sector each way, As = 1 and Ve = 0.
  ; Reference/mesa-24.3.4_vir.c:2508-2515 for As and Ve, :843-859 for
  ; the segment sizes and for separate_segments being forced false.
  V3dShaderRecordVpm(1, 0, 1, 1, 1, 0, 1, 1)

  V3dShaderRecordDefaults(neon_DefaultsAddr())
  V3dShaderRecordFragment(neon_code + (2 * #NEON_CODE_SLOT), neon_unif + (slot * #NEON_UNIF_STRIDE), 1, 0, 1)
  V3dShaderRecordVertex(neon_code + #NEON_CODE_SLOT, neon_unifVs, 1, 1, 1)
  V3dShaderRecordCoord(neon_code, neon_unifCs, 1, 1, 1)

  k = 0
  While k < #NEON_ATTRS
    V3dAttrRecord(k, gNeonVerts + (k * 4), #NEON_VERT_BYTES, #NEON_MAX_VERTS - 1, 1, 1)
    k = k + 1
  Wend
  V3dAttrRecordType(2, 1, #V3D_ATTR_INT, 1, 0, 1, 0)
  V3dAttrRecordType(3, 1, #V3D_ATTR_INT, 1, 0, 1, 0)

  If V3dShaderRecordOk() = 0
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf
  ProcedureReturn #V3D_OK
EndProcedure

; ----------------------------------------------------------------------
;  neon_Draw - issue one draw call over vertices already appended.
;
;  `first` is the index of the first vertex and `count` how many. The
;  colour is this draw's and this draw's only, which is what makes one
;  record per draw necessary: the colour reaches the fragment shader
;  through the uniform stream and the stream's address lives in the
;  record.
; ----------------------------------------------------------------------
Procedure.i neon_Draw(prim.i, first.i, count.i, colour.i)
  Protected r.i

  If neon_inFrame = 0
    neon_err = #NEON_ERR_NOFRAME
    ProcedureReturn #NEON_ERR_NOFRAME
  EndIf
  If neon_nDraws >= #NEON_MAX_DRAWS
    neon_err = #NEON_ERR_RECORDS
    ProcedureReturn #NEON_ERR_RECORDS
  EndIf
  If count <= 0
    ProcedureReturn #NEON_OK
  EndIf

  neon_SyncClip()
  neon_Uniforms(neon_nDraws, colour)
  r = neon_Record(neon_nDraws)
  If r <> #V3D_OK
    neon_err = #NEON_ERR_RECORDS
    ProcedureReturn #NEON_ERR_RECORDS
  EndIf

  V3dClGlShaderState(neon_shrec + (neon_nDraws * #NEON_SHREC_STRIDE), #NEON_ATTRS)
  V3dClVertexArrayPrims(prim, count, first)
  If V3dClError() <> #V3D_OK
    neon_err = #NEON_ERR_LIST
    ProcedureReturn #NEON_ERR_LIST
  EndIf

  neon_nDraws = neon_nDraws + 1
  ProcedureReturn #NEON_OK
EndProcedure


; ======================================================================
;  PRIMITIVE 1 - THE ALPHA-BLENDED FILLED RECTANGLE
;
;  GlUIChrome.pbi:302-304 -> GlUtilities.pbi:1998-2027. Six vertices,
;  two triangles, one draw call, and the same winding DrawGLBox emits:
;
;      (x1,y1) (x1,y2) (x2,y1)      (x1,y2) (x2,y2) (x2,y1)
;
;  Culling is off, so the winding cannot discard anything; it is
;  matched anyway because a difference that does not matter today is a
;  difference somebody has to think about tomorrow.
;
;  A FULLY TRANSPARENT BOX IS SKIPPED. Neon_Glow at hover 0 asks for
;  four boxes at alpha 0, and the engine draws them because a GL draw
;  call with a zero alpha is cheap and skipping it in the chrome kit
;  would have been a special case. Here it is not cheap - it is a
;  shader record, a uniform block, six vertices and two packets - and
;  it is provably invisible, so it is dropped and counted.
; ======================================================================
Procedure.i Neon_Box(x.i, y.i, w.i, h.i, colour.i)
  Protected first.i

  If gNeonBackendActive <> 0
    ProcedureReturn gNeonBackendBox(x, y, w, h, colour)
  EndIf

  If neon_inFrame = 0
    neon_err = #NEON_ERR_NOFRAME
    ProcedureReturn #NEON_ERR_NOFRAME
  EndIf
  If w <= 0 Or h <= 0
    ProcedureReturn #NEON_OK
  EndIf
  If Neon_A(colour) = 0
    neon_nClipped = neon_nClipped + 1
    ProcedureReturn #NEON_OK
  EndIf

  ; Reject what the clip cannot show, before it costs a record. The
  ; hardware would reject it too; this is about the A72's time, not
  ; about correctness, and it is counted so that a screen that came
  ; out empty can be told from a screen that was never asked for.
  If neon_clipOn <> 0
    If (x + w) <= neon_clipX Or x >= (neon_clipX + neon_clipW)
      neon_nClipped = neon_nClipped + 1
      ProcedureReturn #NEON_OK
    EndIf
    If (y + h) <= neon_clipY Or y >= (neon_clipY + neon_clipH)
      neon_nClipped = neon_nClipped + 1
      ProcedureReturn #NEON_OK
    EndIf
  EndIf
  If (x + w) <= 0 Or x >= neon_w Or (y + h) <= 0 Or y >= neon_h
    neon_nClipped = neon_nClipped + 1
    ProcedureReturn #NEON_OK
  EndIf

  If (neon_nVerts + 6) > #NEON_MAX_VERTS
    neon_err = #NEON_ERR_VERTS
    ProcedureReturn #NEON_ERR_VERTS
  EndIf

  first = neon_nVerts
  neon_Rect(x, y, w, h)

  neon_nBoxes = neon_nBoxes + 1
  ProcedureReturn neon_Draw(#NEON_PRIM_TRIS, first, 6, colour)
EndProcedure

; ----------------------------------------------------------------------
;  neon_Rect - a rectangle that has already been decided on.
;
;  Neon_Box's cheap rejections and its box counter are the chrome
;  kit's business; a glyph run has already been clipped by the caller
;  and must not be counted as a box. This is the geometry alone, and
;  it appends to the CURRENT batch rather than issuing a draw.
; ----------------------------------------------------------------------
Procedure neon_Rect(x.i, y.i, w.i, h.i)
  Protected b.i
  Protected x1.i
  Protected y1.i
  Protected xc0.i
  Protected xc1.i
  Protected yc0.i
  Protected yc1.i
  Protected xs0.i
  Protected xs1.i
  Protected ys0.i
  Protected ys1.i
  Protected k.i
  Protected p.i

  If (neon_nVerts + 6) > #NEON_MAX_VERTS
    neon_err = #NEON_ERR_VERTS
    ProcedureReturn
  EndIf
  x1 = x + w
  y1 = y + h

  ; Rotate the rectangle's half-open boundaries into physical space. A
  ; quarter turn preserves axis alignment but swaps width and height.
  If neon_rot = 90
    p = x
    x = neon_h - y1
    y = p
    p = x1
    x1 = neon_h - (y1 - h)
    y1 = p
  ElseIf neon_rot = 180
    p = x
    x = neon_w - x1
    x1 = neon_w - p
    p = y
    y = neon_h - y1
    y1 = neon_h - p
  ElseIf neon_rot = 270
    p = x
    x = y
    y = neon_w - x1
    x1 = y1
    y1 = neon_w - p
  EndIf

  ; ------------------------------------------------------------------
  ;  SIX CALLS TO neon_Vertex BECOME NONE, AND THE FOUR CORNER VALUES
  ;  ARE COMPUTED ONCE EACH INSTEAD OF TWICE.
  ;
  ;  THIS IS THE HOT LOOP OF THE WHOLE ENGINE. A chrome frame measured
  ;  on the board decomposes into 8854 glyph rectangles - 53,710
  ;  vertices - and the A72 spends about 407 ms of a 661 ms frame
  ;  building them, which is roughly 7.6 microseconds a vertex. That is
  ;  not arithmetic; with the ARM MMU off every INSTRUCTION FETCH is
  ;  Device memory, so a procedure call is expensive in a way it is
  ;  nowhere else on this project. Six of them per rectangle, plus
  ;  eight table lookups where four would do, is most of the cost.
  ;
  ;  The values written are IDENTICAL to what neon_Vertex writes, and
  ;  tools/a64/a64_neon_check.py compares every vertex of every
  ;  rectangle against Python's own IEEE 754, so a divergence between
  ;  this and neon_Vertex is caught rather than trusted.
  ; ------------------------------------------------------------------
  k = x + neon_physW
  If k >= 0 And k < (neon_physW * 3)
    xc0 = PeekN(neon_xcTab + (k * 4))
  Else
    xc0 = neon_F32Ratio(x - neon_cx, neon_cx)
  EndIf
  k = x1 + neon_physW
  If k >= 0 And k < (neon_physW * 3)
    xc1 = PeekN(neon_xcTab + (k * 4))
  Else
    xc1 = neon_F32Ratio(x1 - neon_cx, neon_cx)
  EndIf
  k = y + neon_physH
  If k >= 0 And k < (neon_physH * 3)
    yc0 = PeekN(neon_ycTab + (k * 4))
  Else
    yc0 = neon_F32Ratio(y - neon_cy, neon_cy)
  EndIf
  k = y1 + neon_physH
  If k >= 0 And k < (neon_physH * 3)
    yc1 = PeekN(neon_ycTab + (k * 4))
  Else
    yc1 = neon_F32Ratio(y1 - neon_cy, neon_cy)
  EndIf

  xs0 = ((x  - neon_cx) * 256) & $FFFFFFFF
  xs1 = ((x1 - neon_cx) * 256) & $FFFFFFFF
  ys0 = ((y  - neon_cy) * 256) & $FFFFFFFF
  ys1 = ((y1 - neon_cy) * 256) & $FFFFFFFF

  b = gNeonVerts + (neon_nVerts * #NEON_VERT_BYTES)

  ; (x, y)
  PokeN(b +  0, xc0) : PokeN(b +  4, yc0) : PokeN(b +  8, xs0) : PokeN(b + 12, ys0)
  ; (x, y + h)
  PokeN(b + 16, xc0) : PokeN(b + 20, yc1) : PokeN(b + 24, xs0) : PokeN(b + 28, ys1)
  ; (x + w, y)
  PokeN(b + 32, xc1) : PokeN(b + 36, yc0) : PokeN(b + 40, xs1) : PokeN(b + 44, ys0)
  ; (x, y + h)
  PokeN(b + 48, xc0) : PokeN(b + 52, yc1) : PokeN(b + 56, xs0) : PokeN(b + 60, ys1)
  ; (x + w, y + h)
  PokeN(b + 64, xc1) : PokeN(b + 68, yc1) : PokeN(b + 72, xs1) : PokeN(b + 76, ys1)
  ; (x + w, y)
  PokeN(b + 80, xc1) : PokeN(b + 84, yc0) : PokeN(b + 88, xs1) : PokeN(b + 92, ys0)

  neon_nVerts = neon_nVerts + 6
EndProcedure


; ======================================================================
;  PRIMITIVE 3 - THE CONVEX FAN, AND PRIMITIVE 4 - THE LINE LIST
;
;  GlUtilities.pbi:1955-1989 draws a filled convex shape as a
;  GL_TRIANGLE_FAN and its outline as a GL_LINE_LOOP; :2030-2052 draws
;  a static mesh as GL_LINES. Neither is used by the IDE - GlUI.pbi's
;  DIP LEDs and cursor are the only callers - and both are here
;  because the brief is the whole engine and because on this path they
;  are the same vertex array with a different primitive mode.
;
;  A FAN IS BUILT POINT BY POINT: NeonFanBegin, then NeonFanPoint for
;  each vertex in order, then NeonFanEnd with the colour. The engine's
;  version takes an array; this one cannot, because a .pi4 procedure
;  takes at most eight arguments and an array parameter is not a thing
;  this dialect has.
; ======================================================================
Global neon_fanFirst.i = -1

Procedure.i NeonFanBegin()
  If gNeonBackendActive <> 0
    ProcedureReturn gNeonBackendFanBegin()
  EndIf
  If neon_inFrame = 0
    neon_err = #NEON_ERR_NOFRAME
    ProcedureReturn #NEON_ERR_NOFRAME
  EndIf
  neon_fanFirst = neon_nVerts
  ProcedureReturn #NEON_OK
EndProcedure

Procedure NeonFanPoint(x.i, y.i)
  If gNeonBackendActive <> 0
    gNeonBackendFanPoint(x, y)
    ProcedureReturn
  EndIf
  neon_Vertex(x, y)
EndProcedure

Procedure.i NeonFanEnd(colour.i)
  Protected n.i
  If gNeonBackendActive <> 0
    ProcedureReturn gNeonBackendFanEnd(colour)
  EndIf
  If neon_fanFirst < 0
    neon_err = #NEON_ERR_ARGS
    ProcedureReturn #NEON_ERR_ARGS
  EndIf
  n = neon_nVerts - neon_fanFirst
  neon_fanFirst = -1
  If n < 3
    ProcedureReturn #NEON_OK
  EndIf
  ProcedureReturn neon_Draw(#NEON_PRIM_FAN, neon_nVerts - n, n, colour)
EndProcedure

; ----------------------------------------------------------------------
;  NeonFanOutline - the same points, as an OUTLINE instead of a fill.
;
;  GlUtilities.pbi:1986 draws the identical vertex array as either
;  GL_TRIANGLE_FAN or GL_LINE_LOOP depending on a `filled` flag, which
;  is how GlUI.pbi's DIP LEDs get a ring around a disc without a second
;  point list. This is that flag, as a second End: build the fan once
;  with NeonFanBegin and NeonFanPoint, call NeonFanEnd for the fill,
;  and NeonFanOutline for the ring.
;
;  IT RE-USES THE VERTICES RATHER THAN APPENDING THEM AGAIN, which is
;  the whole point of the shared vertex array: the outline draw names
;  the same slice with a different primitive mode and costs six bytes
;  of bin list and one shader record.
;
;  CALL IT BEFORE NeonFanEnd, or keep the first vertex index yourself -
;  NeonFanEnd clears the cursor, because a fan that has been issued is
;  finished. NeonFanOutline does not clear it, so the natural order is
;  outline then fill, or fill then nothing.
; ----------------------------------------------------------------------
Procedure.i NeonFanOutline(colour.i)
  Protected n.i
  If gNeonBackendActive <> 0
    ProcedureReturn gNeonBackendFanOutline(colour)
  EndIf
  If neon_fanFirst < 0
    neon_err = #NEON_ERR_ARGS
    ProcedureReturn #NEON_ERR_ARGS
  EndIf
  n = neon_nVerts - neon_fanFirst
  If n < 2
    ProcedureReturn #NEON_OK
  EndIf
  ProcedureReturn neon_Draw(#NEON_PRIM_LINELOOP, neon_fanFirst, n, colour)
EndProcedure

; A line list. Same shape: begin, two points per segment, end.
Global neon_lineFirst.i = -1

Procedure.i NeonLinesBegin()
  If gNeonBackendActive <> 0
    ProcedureReturn gNeonBackendLinesBegin()
  EndIf
  If neon_inFrame = 0
    neon_err = #NEON_ERR_NOFRAME
    ProcedureReturn #NEON_ERR_NOFRAME
  EndIf
  neon_lineFirst = neon_nVerts
  ProcedureReturn #NEON_OK
EndProcedure

Procedure NeonLine(x0.i, y0.i, x1.i, y1.i)
  If gNeonBackendActive <> 0
    gNeonBackendLine(x0, y0, x1, y1)
    ProcedureReturn
  EndIf
  neon_Vertex(x0, y0)
  neon_Vertex(x1, y1)
EndProcedure

Procedure.i NeonLinesEnd(colour.i)
  Protected n.i
  If gNeonBackendActive <> 0
    ProcedureReturn gNeonBackendLinesEnd(colour)
  EndIf
  If neon_lineFirst < 0
    neon_err = #NEON_ERR_ARGS
    ProcedureReturn #NEON_ERR_ARGS
  EndIf
  n = neon_nVerts - neon_lineFirst
  neon_lineFirst = -1
  If n < 2
    ProcedureReturn #NEON_OK
  EndIf
  ProcedureReturn neon_Draw(#NEON_PRIM_LINE, neon_nVerts - n, n, colour)
EndProcedure


; ======================================================================
;  THE SCISSOR
;
;  GlUIChrome.pbi:404-422 lowers to glScissor plus an enable. Here it
;  lowers to V3D's CLIP_WINDOW packet, which is the same thing done by
;  the same silicon that rasterises: the clip is applied per fragment,
;  not per glyph cell and not per rectangle.
;
;  THE ENGINE'S TWO COORDINATE FLIPS DO NOT EXIST HERE. Neon_ScissorSet
;  on the desktop converts canvas units to physical pixels and then
;  flips Y, because GL's scissor is measured from the BOTTOM of the
;  drawable (:412-413). This surface is addressed from the top in both
;  systems - pi4V3dTri.pi4 measured "Y increases with the stored row"
;  on silicon - and one canvas unit is one pixel, so the rectangle
;  goes straight through.
; ======================================================================
Procedure Neon_ScissorSet(x.i, y.i, w.i, h.i)
  neon_clipOn = 1
  neon_clipX  = x
  neon_clipY  = y
  neon_clipW  = w
  neon_clipH  = h
  If gNeonBackendActive <> 0
    gNeonBackendScissorSet(x, y, w, h)
  EndIf
EndProcedure

Procedure Neon_ScissorClear()
  neon_clipOn = 0
  If gNeonBackendActive <> 0
    gNeonBackendScissorClear()
  EndIf
EndProcedure

Procedure.i Neon_ScissorOn()
  ProcedureReturn neon_clipOn
EndProcedure


; ======================================================================
;  PRIMITIVE 2 - TEXT
;
;  GlUIChrome.pbi:306-308 -> DrawGLText, GlUtilities.pbi:1803-1930: one
;  tinted quad per glyph out of a 1024 x 1024 RGBA atlas, batched 256
;  quads to a draw call, the colour MULTIPLYING the atlas sample.
;
;  ======================================================================
;  WHAT IS DIFFERENT HERE, SAID PLAINLY SO NOBODY REPORTS IT AS A BUG
;  ======================================================================
;  The engine's atlas is produced by rasterising a TrueType face on the
;  host - GlUtilities.pbi:1124-1125 draws each glyph with the operating
;  system's own text engine into an image of exactly TextWidth x
;  TextHeight - so it is PROPORTIONAL and ANTIALIASED. Neither of those
;  exists on a bare-metal Pi 4: there is no TrueType rasteriser in this
;  tree and no operating system to borrow one from.
;
;  What there is, is display.pi4's 8 x 16 one-bit-per-pixel cell font
;  (display.pi4:4528-4533, ASCII 32..126, MSB of each byte the leftmost
;  pixel). So this engine's text is FIXED WIDTH and has NO
;  ANTIALIASING. Every string is exactly cellW pixels per character,
;  "I" is as wide as "W", and a right-aligned shortcut column does not
;  line up with a proportional design's expectations. That is the same
;  limitation pi4NeonLiar.pi4 named as "LIE 2" and it is a property of
;  the FONT, not of the rasteriser: the moment a real atlas exists,
;  Neon_TextWidth and this decomposition are the only two things that
;  have to change.
;
;  ======================================================================
;  WHY RECTANGLES AND NOT A TEXTURED QUAD
;  ======================================================================
;  A textured quad would need the TMU, and the TMU on 4.2 cannot sample
;  a linear buffer: TEXTURE_SHADER_STATE (v3d_packet.xml:1493-1532) has
;  no memory-format field at all - only UIF modifiers - so a glyph
;  atlas has to be converted into a tiled layout by the TFU first. That
;  is a real route and the TFU is already up (V3D stage 1), but it buys
;  NOTHING for a one-bit font: a NEAREST-sampled 1bpp atlas produces
;  exactly the same pixels as the rectangles below, and a LINEAR-sampled
;  one produces a blurred version of them.
;
;  So each glyph is decomposed into filled rectangles and drawn by the
;  same alpha-blended path as everything else. It is the identical
;  picture, it goes through the identical blender, and it costs no new
;  unproven hardware. WHEN A REAL ANTIALIASED ATLAS EXISTS the TMU path
;  becomes worth its risk, and that is the point at which to build it -
;  not before.
;
;  THE DECOMPOSITION MERGES VERTICALLY. A naive version emits one
;  rectangle per run per row: sixteen rows times two to four runs is
;  thirty to sixty rectangles a glyph. Consecutive rows with the SAME
;  bit pattern are merged into one taller band first, which takes a
;  typical glyph to six or eight rectangles - a "|" to one, an "H" to
;  three - and the whole string is ONE DRAW CALL because every glyph in
;  it is the same colour.
; ======================================================================

; ----------------------------------------------------------------------
;  NeonFontUse - the glyph blob, by ADDRESS.
;
;  By address and not by name, exactly as display.pi4:3657 does it, so
;  replacing the font never touches the renderer. The one this engine
;  is built against is display.pi4's:
;
;      NeonFontUse(?dsp_font8x16, 8, 16, 32, 126)
;
;  and neon.pi4 does not name that label itself, because a library that
;  includes no library must not depend on one either.
; ----------------------------------------------------------------------
Procedure.i NeonFontUse(bitsAddr.i, cellW.i, cellH.i, first.i, last.i)
  If bitsAddr <= 0 Or cellW < 1 Or cellH < 1 Or last < first
    neon_err = #NEON_ERR_FONT
    ProcedureReturn #NEON_ERR_FONT
  EndIf
  neon_fbits  = bitsAddr
  neon_fw     = cellW
  neon_fh     = cellH
  neon_frb    = (cellW + 7) / 8
  neon_ffirst = first
  neon_flast  = last
  ProcedureReturn #NEON_OK
EndProcedure

; ----------------------------------------------------------------------
;  THE FOUR FACES.
;
;  GlUIChrome.pbi:73-76 declares *Neon_FontUI, *Neon_FontSmall,
;  *Neon_FontMono and *Neon_FontBold, and the IDE host builds them at
;  18, 15, the user's size and 21 LOGICAL PIXELS respectively
;  (GlIdeShell.pbi:3003-3008).
;
;  A one-bit cell font cannot be re-rasterised at an arbitrary pixel
;  height, so the four faces here are the same cell at INTEGER scales,
;  which is the only magnification a one-bit glyph can take without
;  filtering - and a filtered one-bit glyph is a blurred glyph
;  (display.pi4:3677-3680 makes the same call for the same reason).
;
;  At scale 1 the cell is 8 x 16, so the UI face is 16 pixels tall
;  against the engine's 18 and the small face is the same cell. That is
;  as close as this font gets; the row heights the chrome kit uses -
;  Neon_S(24) for a menu row - still leave the same proportion of
;  space above and below.
;
;  BOLD IS AN OR WITH ITSELF SHIFTED ONE PIXEL RIGHT, which is what
;  emboldening a bitmap face has always been. It is not a separate
;  face because there is not one.
; ----------------------------------------------------------------------
#NEON_FONT_UI    = 0
#NEON_FONT_SMALL = 1
#NEON_FONT_MONO  = 2
#NEON_FONT_BOLD  = 3

Procedure NeonFontSetup(idx.i, scale.i, bold.i)
  If idx < 0 Or idx > 3
    ProcedureReturn
  EndIf
  If scale < 1
    scale = 1
  EndIf
  neon_fontScale[idx] = scale
  If bold <> 0
    neon_fontEmbolden[idx] = 1
  Else
    neon_fontEmbolden[idx] = 0
  EndIf
EndProcedure

; ----------------------------------------------------------------------
;  THE FOUR FACES BY NAME, and the two font constructors.
;
;  The engine's are *Neon_FontUI and friends - POINTERS to a GLFont
;  built by CreateGLFont. Here a face is an index into the four slots
;  above, because there is one cell font and four scales of it, so
;  these return the index and the call sites read the same.
; ----------------------------------------------------------------------
Procedure.i Neon_FontUI()
  ProcedureReturn #NEON_FONT_UI
EndProcedure

Procedure.i Neon_FontSmall()
  ProcedureReturn #NEON_FONT_SMALL
EndProcedure

Procedure.i Neon_FontMono()
  ProcedureReturn #NEON_FONT_MONO
EndProcedure

Procedure.i Neon_FontBold()
  ProcedureReturn #NEON_FONT_BOLD
EndProcedure

; ----------------------------------------------------------------------
;  Neon_PointsForPixelHeight - GlUIChrome.pbi:93-116.
;
;  On the desktop this is an ASK-MEASURE-CORRECT loop: load the face at
;  a guessed point size, rasterise "A" into an 8x8 scratch image, read
;  TextHeight back, and iterate up to six times until the pixel height
;  is within one of what was wanted. It exists because CreateGLFont
;  takes POINTS and the points-to-pixels ratio depends on desktop
;  scaling and on whether the process was DPI aware when the font
;  loaded (:78-92).
;
;  NONE OF THAT EXISTS HERE. There is no desktop, no DPI, no
;  rasteriser and no scratch image; a cell font has exactly one
;  height and its whole-number multiples. So this returns the point
;  size the engine's own formula starts from - round(pixels * 0.75) -
;  and it is here so that a caller ported from the desktop side
;  compiles and gets a sane number rather than finding the procedure
;  missing. Neon_CreateFontPx is the one to use.
; ----------------------------------------------------------------------
Procedure.i Neon_PointsForPixelHeight(pixels.i)
  Protected pt.i
  pt = ((pixels * 75) + 50) / 100
  If pt < 5
    pt = 5
  EndIf
  ProcedureReturn pt
EndProcedure

; ----------------------------------------------------------------------
;  Neon_CreateFontPx - GlUIChrome.pbi:120-122.
;
;  Configure face `slot` to be as close to `wantPixels` tall as an
;  integer multiple of the cell can get, and return the height it
;  actually got. THE CALLER IS TOLD WHAT IT GOT rather than being
;  allowed to assume it got what it asked for: the IDE host asks for
;  18, 15 and 21 logical pixels (GlIdeShell.pbi:3003-3008) and a 16
;  pixel cell can give it 16 or 32 and nothing between.
;
;  Rounding is to NEAREST multiple, with a floor of one, so a request
;  for 18 against a 16-tall cell answers 16 and a request for 15
;  answers 16 as well. That is the honest answer and it is why this
;  returns a number instead of nothing.
; ----------------------------------------------------------------------
Procedure.i Neon_CreateFontPx(slot.i, wantPixels.i, bold.i)
  Protected sc.i
  If neon_fh < 1
    neon_err = #NEON_ERR_FONT
    ProcedureReturn 0
  EndIf
  sc = ((wantPixels * 2) + neon_fh) / (neon_fh * 2)
  If sc < 1
    sc = 1
  EndIf
  NeonFontSetup(slot, sc, bold)
  ProcedureReturn neon_fh * sc
EndProcedure

Procedure NeonFontDefaults()
  NeonFontSetup(#NEON_FONT_UI,    1, 0)
  NeonFontSetup(#NEON_FONT_SMALL, 1, 0)
  NeonFontSetup(#NEON_FONT_MONO,  1, 0)
  NeonFontSetup(#NEON_FONT_BOLD,  1, 1)
EndProcedure

Procedure.i neon_FontScaleOf(font.i)
  If font < 0 Or font > 3
    ProcedureReturn 1
  EndIf
  If neon_fontScale[font] < 1
    ProcedureReturn 1
  EndIf
  ProcedureReturn neon_fontScale[font]
EndProcedure

; The advance in pixels for one character. Fixed width, so it does not
; depend on the character - but it takes one anyway, because the moment
; a proportional atlas exists this is where the per-glyph advance goes
; and every caller is already passing what it needs.
Procedure.i Neon_CharWidth(font.i)
  ProcedureReturn neon_fw * neon_FontScaleOf(font)
EndProcedure

; The cell height. This is the engine's GLFont\LineHeight and it is the
; number every vertical centring in the chrome kit divides by
; (GlUIChrome.pbi:372, :727, :862, :948, :1130, :1249, :1347).
Procedure.i Neon_LineHeight(font.i)
  Protected measured.i
  If gNeonMeasureActive <> 0
    measured = gNeonMeasureLineHeight(font)
    If measured > 0 : ProcedureReturn measured : EndIf
  EndIf
  ProcedureReturn neon_fh * neon_FontScaleOf(font)
EndProcedure

; Raw fixed-bitmap line height for renderer adapters whose own callbacks
; need Neon's scale without recursively consulting the measurement backend.
Procedure.i NeonBitmapLineHeight(font.i)
  ProcedureReturn neon_fh * neon_FontScaleOf(font)
EndProcedure

; ----------------------------------------------------------------------
;  Neon_TextWidth - GetGLTextWidth, GlUtilities.pbi:1672-1707.
;
;  The engine walks the string, skips control codes, and adds each
;  glyph's advance. So does this; the advance is just constant.
; ----------------------------------------------------------------------
Procedure.i Neon_TextWidth(font.i, *s)
  Protected i.i
  Protected ch.i
  Protected n.i
  Protected measured.i
  If *s = 0
    ProcedureReturn 0
  EndIf
  If gNeonMeasureActive <> 0
    measured = gNeonMeasureWidth(font, *s)
    If measured >= 0 : ProcedureReturn measured : EndIf
  EndIf
  i = 0
  n = 0
  Repeat
    ch = PeekA(*s + i)
    If ch = 0
      Break
    EndIf
    ; Control codes are skipped, exactly as GlUtilities.pbi:1690-1692
    ; skips anything below 32 and DEL.
    If ch >= 32 And ch <> 127
      n = n + 1
    EndIf
    i = i + 1
    If i > 4096
      Break
    EndIf
  ForEver
  ProcedureReturn n * Neon_CharWidth(font)
EndProcedure

; ----------------------------------------------------------------------
;  neon_GlyphRow - the bits of one row of one glyph, MSB leftmost,
;  emboldened if the face asks for it.
;
;  The blob's layout is display.pi4:3640-3648: one bit per pixel, MSB of
;  the first byte is the leftmost pixel, rows padded to a whole number
;  of bytes, glyph n at n * cellH * rowBytes with no per-glyph offset
;  table because the renderer is fixed width.
;
;  ONLY THE FIRST BYTE OF A ROW IS READ. That is correct for a cell up
;  to eight pixels wide and it is wrong for a wider one; the guard is
;  in NeonFontUse's caller rather than here because a wider font would
;  need a wider run walk as well, and half a change would be worse than
;  none. An 8 x 16 cell is what this tree has.
; ----------------------------------------------------------------------
Procedure.i neon_GlyphRow(ch.i, row.i, bold.i)
  Protected b.i
  b = PeekA(neon_fbits + (((ch - neon_ffirst) * neon_fh) + row) * neon_frb)
  If bold <> 0
    b = (b | (b >> 1)) & $FF
  EndIf
  ProcedureReturn b
EndProcedure

; ----------------------------------------------------------------------
;  neon_GlyphRects - append one glyph's rectangles to the vertex array.
;
;  Rows with an identical bit pattern are merged into one band first,
;  and each band is walked for horizontal runs of set bits. A blank row
;  contributes nothing at all.
;
;  Returns the number of rectangles appended, which the caller adds up
;  so a run can report how much geometry a string actually cost.
; ----------------------------------------------------------------------
Procedure.i neon_GlyphRects(ch.i, gx.i, gy.i, font.i)
  Protected sc.i
  Protected bold.i
  Protected row.i
  Protected bits.i
  Protected span.i
  Protected nextBits.i
  Protected col.i
  Protected runStart.i
  Protected nRect.i

  If ch < neon_ffirst Or ch > neon_flast
    ProcedureReturn 0
  EndIf
  sc   = neon_FontScaleOf(font)
  bold = neon_fontEmbolden[font]
  nRect = 0

  row = 0
  While row < neon_fh
    bits = neon_GlyphRow(ch, row, bold)
    ; How many following rows repeat this pattern?
    span = 1
    While (row + span) < neon_fh
      nextBits = neon_GlyphRow(ch, row + span, bold)
      If nextBits <> bits
        Break
      EndIf
      span = span + 1
    Wend

    If bits <> 0
      ; Walk the eight columns for runs of set bits. The bit test is
      ; b & (128 >> col) - MSB first, the order the format stores.
      col = 0
      runStart = -1
      While col <= neon_fw
        If col < neon_fw And (bits & (128 >> col)) <> 0
          If runStart < 0
            runStart = col
          EndIf
        Else
          If runStart >= 0
            neon_Rect(gx + (runStart * sc), gy + (row * sc), (col - runStart) * sc, span * sc)
            nRect = nRect + 1
            runStart = -1
          EndIf
        EndIf
        col = col + 1
      Wend
    EndIf

    row = row + span
  Wend
  ProcedureReturn nRect
EndProcedure

; ----------------------------------------------------------------------
;  Neon_Text - one string, one colour, ONE DRAW CALL.
;
;  `y` IS THE TOP OF THE CELL. GlUtilities.pbi:1886 and :1898-1899 set
;  RenderY = CursorY and emit the quad spanning RenderY to
;  RenderY + RenderH with no ascent subtracted, and GLFont\Ascent is
;  declared at :218 and never assigned or read. There is no baseline in
;  this engine, which is why every vertical centring in the chrome kit
;  is y + (rowHeight - LineHeight) / 2.
; ----------------------------------------------------------------------
Procedure.i Neon_Text(font.i, x.i, y.i, *s, colour.i)
  Protected i.i
  Protected ch.i
  Protected cx.i
  Protected adv.i
  Protected first.i
  Protected count.i
  Protected cellH.i

  If gNeonBackendActive <> 0
    ProcedureReturn gNeonBackendText(font, x, y, *s, colour)
  EndIf

  If neon_inFrame = 0
    neon_err = #NEON_ERR_NOFRAME
    ProcedureReturn #NEON_ERR_NOFRAME
  EndIf
  If neon_fbits = 0
    neon_err = #NEON_ERR_FONT
    ProcedureReturn #NEON_ERR_FONT
  EndIf
  If *s = 0
    ProcedureReturn #NEON_OK
  EndIf
  If Neon_A(colour) = 0
    ProcedureReturn #NEON_OK
  EndIf

  adv   = Neon_CharWidth(font)
  cellH = Neon_LineHeight(font)

  ; Whole-string rejection. A list of a thousand rows scrolled off the
  ; top costs nothing this way, and the hardware clip would have done
  ; it a glyph at a time after the A72 had already built the geometry.
  If (y + cellH) <= 0 Or y >= neon_h
    neon_nClipped = neon_nClipped + 1
    ProcedureReturn #NEON_OK
  EndIf
  If neon_clipOn <> 0
    If (y + cellH) <= neon_clipY Or y >= (neon_clipY + neon_clipH)
      neon_nClipped = neon_nClipped + 1
      ProcedureReturn #NEON_OK
    EndIf
  EndIf

  first = neon_nVerts
  cx = x
  i = 0
  Repeat
    ch = PeekA(*s + i)
    If ch = 0
      Break
    EndIf
    If ch >= 32 And ch <> 127
      ; Per-glyph rejection, so a long line clipped to a narrow panel
      ; only builds the glyphs that can show.
      If (cx + adv) > 0 And cx < neon_w
        If neon_clipOn = 0
          neon_nRuns = neon_nRuns + neon_GlyphRects(ch, cx, y, font)
          neon_nGlyphs = neon_nGlyphs + 1
        ElseIf (cx + adv) > neon_clipX And cx < (neon_clipX + neon_clipW)
          neon_nRuns = neon_nRuns + neon_GlyphRects(ch, cx, y, font)
          neon_nGlyphs = neon_nGlyphs + 1
        EndIf
      EndIf
      cx = cx + adv
    EndIf
    i = i + 1
    If i > 4096
      Break
    EndIf
  ForEver

  count = neon_nVerts - first
  If count = 0
    ProcedureReturn #NEON_OK
  EndIf
  ProcedureReturn neon_Draw(#NEON_PRIM_TRIS, first, count, colour)
EndProcedure

; GlUIChrome.pbi:310-311. The string's RIGHT EDGE lands on xRight.
Procedure.i Neon_TextRight(font.i, xRight.i, y.i, *s, colour.i)
  ProcedureReturn Neon_Text(font, xRight - Neon_TextWidth(font, *s), y, *s, colour)
EndProcedure

; GlUIChrome.pbi:314-315. NOTE THE PARAMETER ORDER - x, then w, then y -
; which is the engine's and is easy to get wrong. Nothing is clamped: a
; string wider than w gets a negative offset and overhangs to the left,
; exactly as the engine does.
Procedure.i Neon_TextCentre(font.i, x.i, w.i, y.i, *s, colour.i)
  ProcedureReturn Neon_Text(font, x + ((w - Neon_TextWidth(font, *s)) / 2), y, *s, colour)
EndProcedure


; ======================================================================
;  THE TEXTURED TEXT PATH (M3) - ONE QUAD PER GLYPH, SAMPLED
;
;  Neon_Text above decomposes each glyph into up to seven blended
;  rectangles. Neon_TextTex below draws each glyph as ONE textured quad
;  (two triangles) that samples a glyph atlas through the TMU, so the
;  A72 builds six vertices a glyph instead of dozens, and the glyph's
;  shape is the texture's problem rather than the vertex builder's.
;
;  Everything the quad needs that is not per-call - the atlas, its
;  tiling, the texture and sampler state, the per-glyph UVs - is built
;  once by neon_TexEnsure() from whatever font NeonFontUse() last set.
; ======================================================================

; The smallest power of two that is >= v (>= 1). Used to pad the atlas
; height so V = vTexel / height is exactly representable.
Procedure.i neon_NextPow2(v.i)
  Protected p.i
  p = 1
  While p < v
    p = p << 1
  Wend
  ProcedureReturn p
EndProcedure

; ----------------------------------------------------------------------
;  neon_RasterEnsure - build only the CPU-readable RGBA atlas and its
;  copied-out glyph metadata.
;
;  This is the common owner for both texture paths. The direct V3D path
;  still tiles this raster below; another renderer may copy these bytes
;  into its own staging resource. Publication is last, so no query can
;  observe a partly-filled raster or UV table.
; ----------------------------------------------------------------------
Procedure.i neon_RasterEnsure()
  Protected cols.i
  Protected nGlyph.i
  Protected rows.i
  Protected paddedH.i
  Protected g.i
  Protected ch.i
  Protected cellX0.i
  Protected cellY0.i
  Protected tx.i
  Protected ty.i
  Protected bits.i
  Protected off.i
  Protected i.i
  Protected n.i
  Protected bytes.i

  If neon_fbits = 0
    neon_err = #NEON_ERR_FONT
    ProcedureReturn #NEON_ERR_FONT
  EndIf
  If neon_rasterBuilt <> 0 And neon_rasterFontBits = neon_fbits
    ProcedureReturn #NEON_OK
  EndIf
  If neon_texSrc <= 0 Or neon_glyphUV <= 0
    neon_err = #NEON_ERR_ARENA
    ProcedureReturn #NEON_ERR_ARENA
  EndIf
  If neon_fw < 1 Or neon_fw > #NEON_ATLAS_W Or (#NEON_ATLAS_W % neon_fw) <> 0 Or neon_fh < 1
    neon_err = #NEON_ERR_ARGS
    ProcedureReturn #NEON_ERR_ARGS
  EndIf

  cols = #NEON_ATLAS_W / neon_fw
  nGlyph = neon_flast - neon_ffirst + 1
  If nGlyph < 1 Or nGlyph > 256
    neon_err = #NEON_ERR_ARGS
    ProcedureReturn #NEON_ERR_ARGS
  EndIf
  rows = (nGlyph + cols - 1) / cols
  ; Keep one row outside every glyph cell.  Its first texel is an opaque
  ; white sample used by renderers which put boxes and glyphs through one
  ; sampled+tinted pipeline.  Adding the row before power-of-two padding is
  ; important: a completely full atlas must not corrupt its final glyph.
  paddedH = neon_NextPow2((rows * neon_fh) + 1)
  If paddedH > #NEON_ATLAS_MAXH
    neon_err = #NEON_ERR_ARGS
    ProcedureReturn #NEON_ERR_ARGS
  EndIf
  bytes = #NEON_ATLAS_W * paddedH * 4
  If bytes < 1 Or bytes > #NEON_ATLAS_MAXBYTES
    neon_err = #NEON_ERR_ARGS
    ProcedureReturn #NEON_ERR_ARGS
  EndIf

  n = #NEON_ATLAS_W * paddedH
  i = 0
  While i < n
    PokeN(neon_texSrc + (i * 4), $00000000)
    i = i + 1
  Wend

  g = 0
  While g < nGlyph
    ch = neon_ffirst + g
    cellX0 = (g % cols) * neon_fw
    cellY0 = (g / cols) * neon_fh
    ty = 0
    While ty < neon_fh
      bits = neon_GlyphRow(ch, ty, 0)
      tx = 0
      While tx < neon_fw
        If (bits & (128 >> tx)) <> 0
          off = (((cellY0 + ty) * #NEON_ATLAS_W) + (cellX0 + tx)) * 4
          PokeN(neon_texSrc + off, $FFFFFFFF)
        EndIf
        tx = tx + 1
      Wend
      ty = ty + 1
    Wend
    g = g + 1
  Wend

  ; The final row is reserved, so this can never overlap a glyph cell.
  PokeN(neon_texSrc + (((paddedH - 1) * #NEON_ATLAS_W) * 4), $FFFFFFFF)

  g = 0
  While g < nGlyph
    cellX0 = (g % cols) * neon_fw
    cellY0 = (g / cols) * neon_fh
    PokeN(neon_glyphUV + (g * 16) +  0, neon_F32Ratio(cellX0,            #NEON_ATLAS_W))
    PokeN(neon_glyphUV + (g * 16) +  4, neon_F32Ratio(cellX0 + neon_fw,  #NEON_ATLAS_W))
    PokeN(neon_glyphUV + (g * 16) +  8, neon_F32Ratio(cellY0,            paddedH))
    PokeN(neon_glyphUV + (g * 16) + 12, neon_F32Ratio(cellY0 + neon_fh,  paddedH))
    g = g + 1
  Wend

  neon_rasterW = #NEON_ATLAS_W
  neon_rasterH = paddedH
  neon_atlasCols = cols
  neon_atlasGlyphs = nGlyph
  neon_rasterBytes = bytes
  neon_rasterFontBits = neon_fbits
  neon_rasterBuilt = 1
  ProcedureReturn #NEON_OK
EndProcedure

; ----------------------------------------------------------------------
;  neon_TexEnsure - build the atlas, if it is not already built for the
;  current font.
;
;  Ports pi4V3dAtlas's build: a 16-wide raster RGBA8 atlas, transparent
;  everywhere with each glyph's ink texels set to opaque white, packed
;  in 16/cellW columns; then the TFU tiles it to UBLINEAR_2, which the
;  TMU derives from the width of 16. The per-glyph cell-edge UVs and the
;  texture/sampler state are built here too. Idempotent: a second call
;  for the same font returns immediately.
;
;  SAFE TO CALL OUTSIDE A FRAME (the diagnostic does, so the TFU runs
;  clear of the render) OR lazily on the first Neon_TextTex.
; ----------------------------------------------------------------------
Procedure.i neon_TexEnsure()
  Protected i.i
  Protected texState.i
  Protected sampState.i
  Protected bytes.i
  Protected r.i

  If neon_texBuilt <> 0 And neon_texFontBits = neon_fbits
    ProcedureReturn #NEON_OK
  EndIf
  r = neon_RasterEnsure()
  If r <> #NEON_OK
    ProcedureReturn r
  EndIf
  gNeonAtlasW = neon_rasterW
  gNeonAtlasH = neon_rasterH

  ; ------------------------------------------------------------------
  ;  The texture and sampler state. pi4V3dAtlas's packing, with the two
  ;  dimensions taken from this atlas: RGBA8, RGBA swizzle, every UIF
  ;  field clear so the TMU derives UBLINEAR_2 from the width of 16;
  ;  nearest filter, clamp wrap.
  ; ------------------------------------------------------------------
  texState  = neon_texState
  sampState = neon_texState + 256
  i = 0
  While i < 8
    PokeN(texState  + (i * 4), 0)
    PokeN(sampState + (i * 4), 0)
    i = i + 1
  Wend
  PokeN(texState +  0, neon_tex)
  PokeN(texState +  4, (gNeonAtlasW << 26))
  PokeN(texState +  8, (gNeonAtlasH << 8) | (1 << 22))
  PokeN(texState + 12, (4 << 4) | (2 << 12) | (3 << 15) | (4 << 18) | (5 << 21))
  PokeN(sampState +  0, 1 | 2 | $80)
  PokeN(sampState +  4, (1 << 16) | (1 << 19))

  ; ------------------------------------------------------------------
  ;  Tile the raster atlas to UBLINEAR_2 with the TFU, and clean the
  ;  three static buffers the TMU will read.
  ; ------------------------------------------------------------------
  bytes = gNeonAtlasW * gNeonAtlasH * 4
  V3dBarrier()
  r = V3dTfuBegin(gNeonAtlasW, gNeonAtlasH, #V3D_TEXFMT_RGBA8)
  If r = #V3D_OK
    r = V3dTfuSourceRaster(neon_texSrc, gNeonAtlasW, bytes)
  EndIf
  If r = #V3D_OK
    r = V3dTfuDest(neon_tex, #V3D_TFU_OFMT_UBLINEAR_2, bytes)
  EndIf
  If r = #V3D_OK
    r = V3dTfuSubmit()
  EndIf
  If r <> #V3D_OK
    neon_err = #NEON_ERR_V3D
    ProcedureReturn #NEON_ERR_V3D
  EndIf
  r = V3dTfuWait(#V3D_TFU_TIMEOUT_US)
  If r <> #V3D_OK
    neon_err = #NEON_ERR_V3D
    ProcedureReturn #NEON_ERR_V3D
  EndIf

  V3dCacheRange(neon_tex, bytes)
  V3dCacheRange(neon_texState, 4096)
  V3dBarrier()

  neon_texBuilt    = 1
  neon_texFontBits = neon_fbits
  ProcedureReturn #NEON_OK
EndProcedure

; Public: pre-build the atlas, so a caller can pay the TFU cost once,
; outside any frame. Neon_TextTex builds it lazily if this was skipped.
Procedure.i Neon_TexAtlasBuild()
  ProcedureReturn neon_TexEnsure()
EndProcedure

; ----------------------------------------------------------------------
;  READ-ONLY CPU ATLAS CONTRACT
;
;  Neon_AtlasRasterEnsure builds the linear RGBA8 source and UV metadata
;  without submitting a TFU job. The returned base is a BORROWED view:
;  Neon retains allocation and lifetime ownership, and the caller may only
;  read/copy `Neon_AtlasRasterBytes()` bytes from it. There is deliberately
;  no setter, detach or free operation. Glyph UVs are copied into caller-
;  owned storage instead of exposing the renderer's metadata table.
;
;  A font change makes every query unavailable until Ensure succeeds for
;  that font. This is independent from the private UBLINEAR image: the
;  existing V3D path still owns and builds that image in neon_TexEnsure.
; ----------------------------------------------------------------------
Procedure.i Neon_AtlasRasterEnsure()
  ProcedureReturn neon_RasterEnsure()
EndProcedure

Procedure.i Neon_AtlasRasterReady()
  If neon_rasterBuilt = 0 Or neon_rasterFontBits <> neon_fbits
    ProcedureReturn 0
  EndIf
  If neon_texSrc <= 0 Or neon_rasterW < 1 Or neon_rasterH < 1 Or neon_rasterBytes < 1
    ProcedureReturn 0
  EndIf
  ProcedureReturn 1
EndProcedure

Procedure.i Neon_AtlasRasterBase()
  If Neon_AtlasRasterReady() = 0 : ProcedureReturn 0 : EndIf
  ProcedureReturn neon_texSrc
EndProcedure

Procedure.i Neon_AtlasRasterWidth()
  If Neon_AtlasRasterReady() = 0 : ProcedureReturn 0 : EndIf
  ProcedureReturn neon_rasterW
EndProcedure

Procedure.i Neon_AtlasRasterHeight()
  If Neon_AtlasRasterReady() = 0 : ProcedureReturn 0 : EndIf
  ProcedureReturn neon_rasterH
EndProcedure

Procedure.i Neon_AtlasRasterBytes()
  If Neon_AtlasRasterReady() = 0 : ProcedureReturn 0 : EndIf
  ProcedureReturn neon_rasterBytes
EndProcedure

Procedure.i Neon_AtlasRasterFirstGlyph()
  If Neon_AtlasRasterReady() = 0 : ProcedureReturn 0 : EndIf
  ProcedureReturn neon_ffirst
EndProcedure

Procedure.i Neon_AtlasRasterLastGlyph()
  If Neon_AtlasRasterReady() = 0 : ProcedureReturn 0 : EndIf
  ProcedureReturn neon_flast
EndProcedure

Procedure.i Neon_AtlasRasterGlyphUV(ch.i, *uv.NeonAtlasGlyphUV)
  Protected g.i
  Protected src.i
  If Neon_AtlasRasterReady() = 0 Or *uv = 0
    ProcedureReturn 0
  EndIf
  If ch < neon_ffirst Or ch > neon_flast
    ProcedureReturn 0
  EndIf
  g = ch - neon_ffirst
  If g < 0 Or g >= neon_atlasGlyphs
    ProcedureReturn 0
  EndIf
  src = neon_glyphUV + (g * 16)
  *uv\left   = PeekN(src + 0)
  *uv\right  = PeekN(src + 4)
  *uv\top    = PeekN(src + 8)
  *uv\bottom = PeekN(src + 12)
  ProcedureReturn 1
EndProcedure

; Copy the exact one-texel rectangle reserved for solid-colour geometry.
; Keeping this beside the glyph query means another renderer never has to
; know where the atlas builder placed the texel or assume that (0,0) is free.
Procedure.i Neon_AtlasRasterWhiteUV(*uv.NeonAtlasGlyphUV)
  Protected y.i
  If Neon_AtlasRasterReady() = 0 Or *uv = 0
    ProcedureReturn 0
  EndIf
  y = neon_rasterH - 1
  *uv\left   = #NEON_F_ZERO
  *uv\right  = neon_F32Ratio(1, neon_rasterW)
  *uv\top    = neon_F32Ratio(y, neon_rasterH)
  *uv\bottom = #NEON_F_ONE
  ProcedureReturn 1
EndProcedure

; The dimensions of the built atlas, for a diagnostic's report.
Procedure.i Neon_AtlasW()
  ProcedureReturn gNeonAtlasW
EndProcedure

Procedure.i Neon_AtlasH()
  ProcedureReturn gNeonAtlasH
EndProcedure

Procedure.i Neon_AtlasBase()
  ProcedureReturn neon_tex
EndProcedure

; ----------------------------------------------------------------------
;  neon_TexVertex - append one ten-attribute textured vertex at index n.
;
;  Xc/Yc come from the same clip tables neon_Vertex uses, so the
;  textured clipper sees the same geometry the flat one does. Zc Wc Zs
;  1/Wc are the constants pi4V3dTex proved; U,V are the pre-computed
;  cell-edge floats the caller passes. Does NOT touch the vertex cursor
;  - the glyph loop writes six and advances it once.
; ----------------------------------------------------------------------
Procedure neon_TexVertex(n.i, px.i, py.i, uF32.i, vF32.i)
  Protected b.i
  Protected xc.i
  Protected yc.i
  Protected k.i
  Protected p.i

  If neon_rot = 90
    p = px
    px = neon_h - py
    py = p
  ElseIf neon_rot = 180
    px = neon_w - px
    py = neon_h - py
  ElseIf neon_rot = 270
    p = px
    px = py
    py = neon_w - p
  EndIf

  k = px + neon_physW
  If k >= 0 And k < (neon_physW * 3)
    xc = PeekN(neon_xcTab + (k * 4))
  Else
    xc = neon_F32Ratio(px - neon_cx, neon_cx)
  EndIf
  k = py + neon_physH
  If k >= 0 And k < (neon_physH * 3)
    yc = PeekN(neon_ycTab + (k * 4))
  Else
    yc = neon_F32Ratio(py - neon_cy, neon_cy)
  EndIf

  b = neon_tverts + (n * #NEON_TVERT_BYTES)
  PokeN(b +  0, xc)
  PokeN(b +  4, yc)
  PokeN(b +  8, #NEON_F_ZERO)                        ; Zc
  PokeN(b + 12, #NEON_F_ONE)                         ; Wc
  PokeN(b + 16, ((px - neon_cx) * 256) & $FFFFFFFF)  ; Xs, 1/256 px, int
  PokeN(b + 20, ((py - neon_cy) * 256) & $FFFFFFFF)  ; Ys
  PokeN(b + 24, #NEON_F_ZERO)                        ; Zs
  PokeN(b + 28, #NEON_F_ONE)                         ; 1/Wc
  PokeN(b + 32, uF32)                                ; U, varying 0
  PokeN(b + 36, vF32)                                ; V, varying 1
EndProcedure

; ----------------------------------------------------------------------
;  neon_TexUniforms - the textured fragment shader's stream for one draw.
;
;  P0, P1, then colour.A, comp0, comp1, comp2, in the order the shader
;  touches the stream (see neon_BuildTexFragmentShader). comp0..comp2
;  carry the same red/blue swap the flat neon_Uniforms uses, so byte 0
;  of the surface is blue. The fifth word the TLBU write pulls is the
;  TLB config, so it is last.
; ----------------------------------------------------------------------
Procedure neon_TexUniforms(slot.i, colour.i)
  Protected b.i
  Protected c0.i
  Protected c2.i

  b = neon_tunif + (slot * #NEON_UNIF_STRIDE)
  ; comp0 is byte 0 of the surface, which the display wants to be blue.
  If neon_rbSwap <> 0
    c0 = neon_byteF32[Neon_B(colour)]
    c2 = neon_byteF32[Neon_R(colour)]
  Else
    c0 = neon_byteF32[Neon_R(colour)]
    c2 = neon_byteF32[Neon_B(colour)]
  EndIf

  PokeN(b +  0, neon_texState | $F)         ; P0 = texture state | 4 return words
  PokeN(b +  4, (neon_texState + 256) | 1)  ; P1 = sampler state | 32-bit output
  If #NEON_TEXTEX_MODULATE <> 0
    ; Stream: P0 P1 colour.A comp0 comp1 comp2 CONF - the order
    ; neon_BuildTexFragmentShader touches it in the modulate build.
    PokeN(b +  8, neon_byteF32[Neon_A(colour)]) ; -> rf7, the multiplier
    PokeN(b + 12, c0)                            ; -> rf4
    PokeN(b + 16, neon_byteF32[Neon_G(colour)]) ; -> rf5
    PokeN(b + 20, c2)                            ; -> rf6
    PokeN(b + 24, #NEON_TLB_CONF)
  Else
    ; Coverage-only build: no colour alpha in the stream.
    PokeN(b +  8, c0)                            ; -> rf4
    PokeN(b + 12, neon_byteF32[Neon_G(colour)]) ; -> rf5
    PokeN(b + 16, c2)                            ; -> rf6
    PokeN(b + 20, #NEON_TLB_CONF)
  EndIf
EndProcedure

; ----------------------------------------------------------------------
;  neon_TexRecord - one ten-attribute textured shader record.
;
;  pi4V3dTex's / pi4V3dAtlas's record: numVaryingsFs = 2, vsOutSeg = 2
;  (ten attribute VALUES = two 8-value sectors), attributes 6,7 not read
;  by the coordinate phase, attributes 4,5 signed ints.
; ----------------------------------------------------------------------
Procedure.i neon_TexRecord(slot.i)
  Protected r.i
  Protected k.i
  Protected cs.i
  Protected addr.i

  addr = neon_tshrec + (slot * #NEON_TSHREC_STRIDE)
  r = V3dShaderRecordBegin(addr, #NEON_TATTRS)
  If r <> #V3D_OK
    ProcedureReturn r
  EndIf

  V3dShaderRecordFlags(1, 0, 0, 0, 1, 2)
  V3dShaderRecordVpm(1, 0, 1, 1, 2, 0, 1, 1)
  V3dShaderRecordDefaults(neon_DefaultsAddr())
  V3dShaderRecordFragment(neon_code + (5 * #NEON_CODE_SLOT), neon_tunif + (slot * #NEON_UNIF_STRIDE), 1, 0, 1)
  V3dShaderRecordVertex(neon_code + (4 * #NEON_CODE_SLOT), neon_unifTvs, 1, 1, 1)
  V3dShaderRecordCoord(neon_code + (3 * #NEON_CODE_SLOT), neon_unifTcs, 1, 1, 1)

  k = 0
  While k < #NEON_TATTRS
    cs = 1
    If k = 6 Or k = 7
      cs = 0
    EndIf
    V3dAttrRecord(k, neon_tverts + (k * 4), #NEON_TVERT_BYTES, #NEON_MAX_TVERTS - 1, cs, 1)
    k = k + 1
  Wend
  V3dAttrRecordType(4, 1, #V3D_ATTR_INT, 1, 0, 1, 0)
  V3dAttrRecordType(5, 1, #V3D_ATTR_INT, 1, 0, 1, 0)

  If V3dShaderRecordOk() = 0
    ProcedureReturn #V3D_ERR_CL_ARGS
  EndIf
  ProcedureReturn #V3D_OK
EndProcedure

; The NON_PERSPECTIVE_FLAGS packet, set to $3 (varyings 0 and 1), if the
; list does not already say it. Tracked like the clip window so a run of
; textured draws costs one packet, not one per glyph string. The flat
; draws inherit $3 but declare zero varyings, so it is inert for them.
Procedure neon_TexNonpersp()
  If neon_emitNP <> 3
    v3d_ClU8(100)
    v3d_ClU8($50)
    v3d_ClU8($03)
    v3d_ClU8(0)
    v3d_ClU8(0)
    neon_emitNP = 3
  EndIf
EndProcedure

; ----------------------------------------------------------------------
;  neon_TexDraw - one textured draw over textured vertices already built.
; ----------------------------------------------------------------------
Procedure.i neon_TexDraw(first.i, count.i, colour.i)
  Protected r.i

  If neon_inFrame = 0
    neon_err = #NEON_ERR_NOFRAME
    ProcedureReturn #NEON_ERR_NOFRAME
  EndIf
  If neon_nTDraws >= #NEON_MAX_TDRAWS
    neon_err = #NEON_ERR_RECORDS
    ProcedureReturn #NEON_ERR_RECORDS
  EndIf
  If count <= 0
    ProcedureReturn #NEON_OK
  EndIf

  neon_SyncClip()
  neon_TexNonpersp()
  neon_TexUniforms(neon_nTDraws, colour)
  r = neon_TexRecord(neon_nTDraws)
  If r <> #V3D_OK
    neon_err = #NEON_ERR_RECORDS
    ProcedureReturn #NEON_ERR_RECORDS
  EndIf

  V3dClGlShaderState(neon_tshrec + (neon_nTDraws * #NEON_TSHREC_STRIDE), #NEON_TATTRS)
  V3dClVertexArrayPrims(#NEON_PRIM_TRIS, count, first)
  If V3dClError() <> #V3D_OK
    neon_err = #NEON_ERR_LIST
    ProcedureReturn #NEON_ERR_LIST
  EndIf

  neon_nTDraws = neon_nTDraws + 1
  ProcedureReturn #NEON_OK
EndProcedure

; ----------------------------------------------------------------------
;  Neon_TextTex - one string, one colour, ONE TEXTURED DRAW.
;
;  The same signature and the same layout rules as Neon_Text: `y` is the
;  top of the cell, control codes are skipped, the advance and cell
;  height carry the face's integer scale, and the same whole-string and
;  per-glyph clip rejections run before any geometry is built. The
;  difference is entirely in what each glyph becomes: six vertices of
;  one atlas-sampled quad instead of up to seven blended rectangles.
; ----------------------------------------------------------------------
Procedure.i Neon_TextTex(font.i, x.i, y.i, *s, colour.i)
  Protected i.i
  Protected ch.i
  Protected cx.i
  Protected adv.i
  Protected cellH.i
  Protected first.i
  Protected count.i
  Protected g.i
  Protected r.i
  Protected drawIt.i
  Protected base.i
  Protected gx1.i
  Protected gy1.i
  Protected uL.i
  Protected uR.i
  Protected vT.i
  Protected vB.i

  If neon_inFrame = 0
    neon_err = #NEON_ERR_NOFRAME
    ProcedureReturn #NEON_ERR_NOFRAME
  EndIf
  If neon_fbits = 0
    neon_err = #NEON_ERR_FONT
    ProcedureReturn #NEON_ERR_FONT
  EndIf
  If *s = 0
    ProcedureReturn #NEON_OK
  EndIf
  If Neon_A(colour) = 0
    ProcedureReturn #NEON_OK
  EndIf

  ; The atlas, built lazily if a caller skipped Neon_TexAtlasBuild.
  r = neon_TexEnsure()
  If r <> #NEON_OK
    ProcedureReturn r
  EndIf

  adv   = Neon_CharWidth(font)
  cellH = Neon_LineHeight(font)

  ; Whole-string rejection, exactly as Neon_Text.
  If (y + cellH) <= 0 Or y >= neon_h
    neon_nClipped = neon_nClipped + 1
    ProcedureReturn #NEON_OK
  EndIf
  If neon_clipOn <> 0
    If (y + cellH) <= neon_clipY Or y >= (neon_clipY + neon_clipH)
      neon_nClipped = neon_nClipped + 1
      ProcedureReturn #NEON_OK
    EndIf
  EndIf

  first = neon_nTVerts
  cx = x
  i = 0
  Repeat
    ch = PeekA(*s + i)
    If ch = 0
      Break
    EndIf
    If ch >= 32 And ch <> 127
      ; Only glyphs the atlas actually holds.
      If ch >= neon_ffirst And ch <= neon_flast
        If (cx + adv) > 0 And cx < neon_w
          drawIt = 0
          If neon_clipOn = 0
            drawIt = 1
          ElseIf (cx + adv) > neon_clipX And cx < (neon_clipX + neon_clipW)
            drawIt = 1
          EndIf
          If drawIt <> 0
            If (neon_nTVerts + 6) > #NEON_MAX_TVERTS
              neon_err = #NEON_ERR_VERTS
              Break
            EndIf
            g  = ch - neon_ffirst
            uL = PeekN(neon_glyphUV + (g * 16) +  0)
            uR = PeekN(neon_glyphUV + (g * 16) +  4)
            vT = PeekN(neon_glyphUV + (g * 16) +  8)
            vB = PeekN(neon_glyphUV + (g * 16) + 12)
            gx1  = cx + adv
            gy1  = y + cellH
            base = neon_nTVerts
            ; TL TR BL   TR BR BL, pi4V3dAtlas's winding (culling is off).
            neon_TexVertex(base + 0, cx,  y,   uL, vT)
            neon_TexVertex(base + 1, gx1, y,   uR, vT)
            neon_TexVertex(base + 2, cx,  gy1, uL, vB)
            neon_TexVertex(base + 3, gx1, y,   uR, vT)
            neon_TexVertex(base + 4, gx1, gy1, uR, vB)
            neon_TexVertex(base + 5, cx,  gy1, uL, vB)
            neon_nTVerts  = base + 6
            neon_nTGlyphs = neon_nTGlyphs + 1
          EndIf
        EndIf
      EndIf
      cx = cx + adv
    EndIf
    i = i + 1
    If i > 4096
      Break
    EndIf
  ForEver

  count = neon_nTVerts - first
  If count = 0
    ProcedureReturn #NEON_OK
  EndIf
  ProcedureReturn neon_TexDraw(first, count, colour)
EndProcedure

; Same positioning wrappers as the flat path, for the textured one.
Procedure.i Neon_TextTexRight(font.i, xRight.i, y.i, *s, colour.i)
  ProcedureReturn Neon_TextTex(font, xRight - Neon_TextWidth(font, *s), y, *s, colour)
EndProcedure

Procedure.i Neon_TextTexCentre(font.i, x.i, w.i, y.i, *s, colour.i)
  ProcedureReturn Neon_TextTex(font, x + ((w - Neon_TextWidth(font, *s)) / 2), y, *s, colour)
EndProcedure


; ======================================================================
;  THE PALETTE
;
;  GlUIChrome.pbi:57-68 holds twelve colours as .f triples in 0..1.
;  Each one below is that triple times 255, ROUNDED TO NEAREST, and the
;  rounding is checked against the one place the engine states an
;  answer itself: its palette header says the ground is "(33,34,37)"
;  (GlUIChrome.pbi:48), and 0.129 / 0.133 / 0.145 times 255 is
;  32.9 / 33.9 / 37.0. They agree, so the conversion below is the same
;  conversion the engine's author did.
;
;  NONE OF THEM CARRY AN ALPHA. GlUIChrome.pbi has no alpha in any
;  palette constant; alpha is always supplied at the call site and
;  defaults to 1.0. So these are all opaque and the three places that
;  are not - Neon_Glow, the tab strip's hover and the list row's hover
;  - build their own with Neon_WithAlpha.
;
;  THEY ARE COMPUTED AT RUN TIME rather than being constants, for one
;  reason: Neon_RGBA clamps, and a clamp is a check. Twelve packed
;  hex literals would be twelve places for a transcription error that
;  nothing could catch.
; ======================================================================
Global Neon_C_Bg.i
Global Neon_C_Panel.i
Global Neon_C_Head.i
Global Neon_C_Line.i
Global Neon_C_Text.i
Global Neon_C_Dim.i
Global Neon_C_Faint.i
Global Neon_C_Acc.i
Global Neon_C_Amb.i
Global Neon_C_Grn.i
Global Neon_C_Red.i
Global Neon_C_Vio.i

; The hard-coded literals the widgets use instead of the palette.
; GlUIChrome.pbi:358, :359, :369, :484, :1239, :1307.
Global Neon_C_BtnLit.i        ; 0.157 0.365 0.408  a lit button's face
Global Neon_C_BtnLitText.i    ; 0.588 0.816 0.867  a lit button's label
Global Neon_C_BtnTop.i        ; 0.216 0.259 0.325  the top highlight line
Global Neon_C_Thumb.i         ; 0.31  0.33  0.36   an idle scrollbar thumb
Global Neon_C_Field.i         ; 0.09  0.093 0.102  a text field's well
Global Neon_C_ListBg.i        ; 0.118 0.122 0.133  a list's well
Global Neon_C_Black.i         ; the drop-down shadow

Procedure NeonPalette()
  Neon_C_Bg    = Neon_RGB( 33,  34,  37)     ; 0.129 0.133 0.145
  Neon_C_Panel = Neon_RGB( 37,  38,  41)     ; 0.145 0.149 0.161
  Neon_C_Head  = Neon_RGB( 43,  44,  47)     ; 0.169 0.173 0.184
  Neon_C_Line  = Neon_RGB( 50,  51,  54)     ; 0.196 0.200 0.212
  Neon_C_Text  = Neon_RGB(220, 220, 220)     ; 0.863 0.863 0.863
  Neon_C_Dim   = Neon_RGB(147, 152, 162)     ; 0.576 0.596 0.635
  Neon_C_Faint = Neon_RGB(111, 117, 127)     ; 0.435 0.459 0.498
  Neon_C_Acc   = Neon_RGB( 90, 189, 208)     ; 0.353 0.741 0.816
  Neon_C_Amb   = Neon_RGB(225, 165,  66)     ; 0.882 0.647 0.259
  Neon_C_Grn   = Neon_RGB( 92, 191, 152)     ; 0.361 0.749 0.596
  Neon_C_Red   = Neon_RGB(221, 126, 126)     ; 0.867 0.494 0.494
  Neon_C_Vio   = Neon_RGB(169, 152, 224)     ; 0.663 0.596 0.878

  Neon_C_BtnLit     = Neon_RGB( 40,  93, 104)
  Neon_C_BtnLitText = Neon_RGB(150, 208, 221)
  Neon_C_BtnTop     = Neon_RGB( 55,  66,  83)
  Neon_C_Thumb      = Neon_RGB( 79,  84,  92)
  Neon_C_Field      = Neon_RGB( 23,  24,  26)
  Neon_C_ListBg     = Neon_RGB( 30,  31,  34)
  Neon_C_Black      = Neon_RGB(  0,   0,   0)
EndProcedure


; ======================================================================
;  Neon_UIScale AND Neon_S
;
;  GlUIChrome.pbi:161-165. Neon_UIScale is DISPLAY DENSITY and never
;  window size (:146-160), and Neon_S(v) is v * Neon_UIScale.
;
;  It is thousandths here because there is no .f. Neon_S(24) at scale
;  1000 is 24 and at scale 1500 is 36.
;
;  THE CHROME KIT APPLIES IT INCONSISTENTLY AND THAT IS DELIBERATE IN
;  THE ORIGINAL. Every 1-unit rule, Neon_Frame's thickness, the panel's
;  3-unit accent tab, the button's highlight rows, the drop-down's
;  4.0/8.0 paddings, the menu item's +4 label nudge, the separator's
;  +10/-20 insets, the scrollbar thumb's +2/-4, the tab strip's 17/14
;  and its 18x18 close box, the arrow hover step of 6 and the tab
;  underline's 2 are all RAW canvas units in GlUIChrome.pbi. Only the
;  values literally inside Neon_S(...) scale. That is transcribed
;  exactly, because "fixing" it here would make this file disagree with
;  the engine on a hundred pixel positions.
; ======================================================================
Global Neon_UIScale.i = 1000

Procedure.i Neon_S(v.i)
  ProcedureReturn (v * Neon_UIScale) / 1000
EndProcedure

Procedure NeonSetUIScale(thousandths.i)
  If thousandths < 250
    thousandths = 250
  EndIf
  Neon_UIScale = thousandths
EndProcedure


; ======================================================================
;  THE COMPOSITES
; ======================================================================

; ----------------------------------------------------------------------
;  Neon_Frame - GlUIChrome.pbi:330-335. Four ONE-UNIT boxes, UNSCALED,
;  top, bottom, left, right, in that order. The corners are covered
;  twice, which is invisible at alpha 1.0 and is what the engine does.
; ----------------------------------------------------------------------
Procedure Neon_Frame(x.i, y.i, w.i, h.i, colour.i)
  Neon_Box(x,         y,         w, 1, colour)
  Neon_Box(x,         y + h - 1, w, 1, colour)
  Neon_Box(x,         y,         1, h, colour)
  Neon_Box(x + w - 1, y,         1, h, colour)
EndProcedure

; ----------------------------------------------------------------------
;  Neon_Glow - GlUIChrome.pbi:323-328.
;
;      For i = 1 To 4
;        Neon_Box(x-i, y-i, w+i*2, h+i*2, r, g, b, strength / (i * 1.5))
;      Next
;
;  THESE ARE FOUR FILLED BOXES, NOT FOUR RINGS, AND THEY ARE DRAWN
;  INNERMOST FIRST. Each is larger and dimmer than the last and paints
;  OVER it. The interior is therefore painted four times and then
;  normally covered by the widget's own opaque body, so only the
;  four-unit outset halo shows - but the draw order is load bearing
;  and reversing it would change every visible band.
;
;  strength is in THOUSANDTHS. The engine's call sites are 0.45 for
;  the drop-down and submenu shadows (:772, :992) and 0.16 * hover for
;  the button halo (:366), so 450 and (160 * hover) / 1000 here.
;
;  The alphas at strength 450 are 300, 150, 100 and 75 out of 1000,
;  which is 76, 38, 26 and 19 out of 255.
;
;  THE INSET IS ONE CANVAS UNIT PER RING, UNSCALED. Neon_S() is not
;  applied at :326 and is not applied here.
; ----------------------------------------------------------------------
Procedure Neon_Glow(x.i, y.i, w.i, h.i, colour.i, strength1000.i)
  Protected i.i
  Protected a1000.i
  Protected a255.i
  If strength1000 <= 0
    ProcedureReturn
  EndIf
  For i = 1 To 4
    ; strength / (i * 1.5) - the 1.5 is done as *2/3 to stay integer.
    a1000 = (strength1000 * 2) / (i * 3)
    a255  = ((a1000 * 255) + 500) / 1000
    If a255 > 0
      Neon_Box(x - i, y - i, w + (i * 2), h + (i * 2), Neon_WithAlpha(colour, a255))
    EndIf
  Next
EndProcedure

; ----------------------------------------------------------------------
;  Neon_Panel - GlUIChrome.pbi:339-348. Body, header, accent tab,
;  header rule, title, border - in that order.
;
;  THE TITLE IS UPPER-CASED (:345, UCase) and the +12 / +5 offsets are
;  unscaled literals. headerH's default in the engine is the raw
;  literal 26.0, not Neon_S(26).
; ----------------------------------------------------------------------
Procedure Neon_Panel(x.i, y.i, w.i, h.i, *title, accent.i, headerH.i)
  Neon_Box(x, y, w, h, Neon_C_Panel)
  If *title <> 0
    If PeekA(*title) <> 0
      Neon_Box(x, y, w, headerH, Neon_C_Head)
      Neon_Box(x, y, 3, headerH, accent)
      Neon_Box(x, y + headerH, w, 1, Neon_C_Line)
      Neon_Text(#NEON_FONT_UI, x + 12, y + 5, *title, accent)
    EndIf
  EndIf
  Neon_Frame(x, y, w, h, Neon_C_Line)
EndProcedure


; ======================================================================
;  INPUT, HOT ZONES, FOCUS AND ANIMATION
;
;  GlUIChrome.pbi:124-141, :191-249, :256-294. The whole model is that
;  input is SNAPSHOTTED ONCE at the top of the frame so that every
;  widget in that frame agrees about where the pointer is and whether
;  it was clicked - a widget that sampled the mouse itself could
;  disagree with the widget drawn before it.
; ======================================================================
#NEON_MAXHOT = 512

Global Neon_MX.i = 0
Global Neon_MY.i = 0
Global Neon_MouseDown.i = 0
Global Neon_MousePrev.i = 0
Global Neon_MouseClicked.i = 0
Global Neon_MouseReleased.i = 0
Global Neon_Wheel.i = 0
Global Neon_KeyCode.i = 0
Global Neon_KeyChar.i = 0
Global Neon_DeltaMs.i = 0
Global Neon_AnimationActive.i = 0
Global Neon_FocusID.i = 0
Global Neon_CaretPhase.i = 0        ; milliradians, so the blink is integer

Global Neon_HotCount.i = 0
Global Neon_HotPrevCount.i = 0
Global Dim neon_hotX.i[#NEON_MAXHOT]
Global Dim neon_hotY.i[#NEON_MAXHOT]
Global Dim neon_hotW.i[#NEON_MAXHOT]
Global Dim neon_hotH.i[#NEON_MAXHOT]
Global Dim neon_hotId.i[#NEON_MAXHOT]
Global Dim neon_zprevX.i[#NEON_MAXHOT]
Global Dim neon_zprevY.i[#NEON_MAXHOT]
Global Dim neon_zprevW.i[#NEON_MAXHOT]
Global Dim neon_zprevH.i[#NEON_MAXHOT]
Global Dim neon_zprevId.i[#NEON_MAXHOT]

; ----------------------------------------------------------------------
;  Neon_Hit - GlUIChrome.pbi:318-320. HALF OPEN: inclusive left and
;  top, exclusive right and bottom. Two adjacent widgets therefore
;  cannot both claim the pixel on their shared edge.
; ----------------------------------------------------------------------
Procedure.i Neon_Hit(x.i, y.i, w.i, h.i)
  If Neon_MX < x
    ProcedureReturn 0
  EndIf
  If Neon_MX >= (x + w)
    ProcedureReturn 0
  EndIf
  If Neon_MY < y
    ProcedureReturn 0
  EndIf
  If Neon_MY >= (y + h)
    ProcedureReturn 0
  EndIf
  ProcedureReturn 1
EndProcedure

; GlUIChrome.pbi:215-217.
;   (Tag << 42) | ((Int(a) & $1FFFFF) << 21) | (Int(b) & $1FFFFF)
; .i is 64 bits on this part, so this is the engine's expression
; unchanged rather than a narrowed version of it.
Procedure.i Neon_HotKey(tag.i, a.i, b.i)
  ProcedureReturn (tag << 42) | ((a & $1FFFFF) << 21) | (b & $1FFFFF)
EndProcedure

; GlUIChrome.pbi:202-210. Appends, and SILENTLY DROPS past the limit -
; which is the engine's behaviour and is right: a hot zone that does
; not fit is a hover that does not register, not a frame that fails.
Procedure Neon_HotZone(x.i, y.i, w.i, h.i, id.i)
  If Neon_HotCount >= #NEON_MAXHOT
    ProcedureReturn
  EndIf
  neon_hotX[Neon_HotCount]  = x
  neon_hotY[Neon_HotCount]  = y
  neon_hotW[Neon_HotCount]  = w
  neon_hotH[Neon_HotCount]  = h
  neon_hotId[Neon_HotCount] = id
  Neon_HotCount = Neon_HotCount + 1
EndProcedure

; GlUIChrome.pbi:220-229. Walks LAST FRAME'S list BACKWARDS, so the
; last widget to register - the topmost - wins. It exists so an
; event-driven host can answer "did this mouse move change any pixel?"
; without drawing a frame to find out.
Procedure.i Neon_HoverIdAt(mx.i, my.i)
  Protected i.i
  i = Neon_HotPrevCount - 1
  While i >= 0
    If mx >= neon_zprevX[i]
      If mx < (neon_zprevX[i] + neon_zprevW[i])
        If my >= neon_zprevY[i]
          If my < (neon_zprevY[i] + neon_zprevH[i])
            ProcedureReturn neon_zprevId[i]
          EndIf
        EndIf
      EndIf
    EndIf
    i = i - 1
  Wend
  ProcedureReturn 0
EndProcedure

Procedure.i Neon_HotPrevCountGet()
  ProcedureReturn Neon_HotPrevCount
EndProcedure

; ----------------------------------------------------------------------
;  LAST FRAME'S HOT LIST, ONE FIELD AT A TIME.
;
;  GlUIChrome.pbi keeps Neon_HotPrev() as an array of a five-field
;  structure and lets callers index it. There is no structure array
;  here worth exposing across a library boundary, so it is five
;  accessors. They exist because an event-driven host reads that list
;  to answer "would a redraw change anything" without redrawing, which
;  is the whole reason the list is kept at all (:167-190).
; ----------------------------------------------------------------------
Procedure.i Neon_HotPrevX(i.i)
  If i < 0 Or i >= Neon_HotPrevCount
    ProcedureReturn 0
  EndIf
  ProcedureReturn neon_zprevX[i]
EndProcedure

Procedure.i Neon_HotPrevY(i.i)
  If i < 0 Or i >= Neon_HotPrevCount
    ProcedureReturn 0
  EndIf
  ProcedureReturn neon_zprevY[i]
EndProcedure

Procedure.i Neon_HotPrevW(i.i)
  If i < 0 Or i >= Neon_HotPrevCount
    ProcedureReturn 0
  EndIf
  ProcedureReturn neon_zprevW[i]
EndProcedure

Procedure.i Neon_HotPrevH(i.i)
  If i < 0 Or i >= Neon_HotPrevCount
    ProcedureReturn 0
  EndIf
  ProcedureReturn neon_zprevH[i]
EndProcedure

Procedure.i Neon_HotPrev(i.i)
  If i < 0 Or i >= Neon_HotPrevCount
    ProcedureReturn 0
  EndIf
  ProcedureReturn neon_zprevId[i]
EndProcedure


; ======================================================================
;  ANIMATION
;
;  GlUIChrome.pbi:256-277:
;
;      blend = 1.0 - Exp(-Speed * dt)
;      current + (Target - current) * blend
;      If Abs(Target - current) < 0.002 : current = Target
;      Else : Neon_AnimationActive = #True
;
;  Frame-rate independent exponential easing, dt clamped to 50 ms, and
;  Neon_AnimationActive is the "please render one more frame" flag.
;
;  TWO THINGS ARE DIFFERENT AND BOTH ARE FORCED BY THE BACKEND.
;
;  1. THE KEY IS AN INTEGER, NOT A STRING. The engine keys a map with
;     "button:" + Str(hotKey) and four other prefixes. There is no map
;     here and no string arithmetic worth having, so the key is
;     (kind << 56) | hotKey. Neon_HotKey occupies bits 0..45, so the
;     kind cannot collide with it.
;
;  2. Exp() DOES NOT EXIST ON THIS BACKEND and a software one would
;     cost more than the animation. 1 - exp(-x) is computed as its
;     Taylor series to four terms, x - x^2/2 + x^3/6 - x^4/24, in
;     thousandths, clamped to [0, 1000]. Over the range this is ever
;     called with - x = speed * dt, speed 16..22, dt clamped to 0.05 s,
;     so x <= 1.1 - the worst error is at x = 1.1, where the series
;     gives 0.656 against the true 0.667. That is under two percent of
;     an easing curve, it is in the direction of a slightly slower
;     ease, and it is invisible. Said out loud rather than left for
;     someone to find.
; ======================================================================
#NEON_ANIM_SLOTS = 256

Global Dim neon_animKey.i[#NEON_ANIM_SLOTS]
Global Dim neon_animVal.i[#NEON_ANIM_SLOTS]
Global neon_animUsed.i = 0

Procedure NeonAnimReset()
  Protected i.i
  i = 0
  While i < #NEON_ANIM_SLOTS
    neon_animKey[i] = 0
    neon_animVal[i] = 0
    i = i + 1
  Wend
  neon_animUsed = 0
EndProcedure

; Find the slot for `key`, or -1. Linear probe from a cheap hash; the
; table is small and a frame touches at most a few dozen keys.
Procedure.i neon_AnimSlot(key.i, create.i, initial1000.i)
  Protected h.i
  Protected i.i
  Protected n.i
  h = ((key >> 21) ! key ! (key >> 42)) & (#NEON_ANIM_SLOTS - 1)
  n = 0
  While n < #NEON_ANIM_SLOTS
    i = (h + n) & (#NEON_ANIM_SLOTS - 1)
    If neon_animKey[i] = key
      ProcedureReturn i
    EndIf
    If neon_animKey[i] = 0
      If create = 0
        ProcedureReturn -1
      EndIf
      neon_animKey[i] = key
      neon_animVal[i] = initial1000
      neon_animUsed = neon_animUsed + 1
      ProcedureReturn i
    EndIf
    n = n + 1
  Wend
  ProcedureReturn -1
EndProcedure

; 1 - exp(-x) in thousandths, x also in thousandths.
Procedure.i neon_OneMinusExp(x1000.i)
  Protected t.i
  Protected s.i
  If x1000 <= 0
    ProcedureReturn 0
  EndIf
  If x1000 > 4000
    ProcedureReturn 1000
  EndIf
  ; t is the running term, in thousandths. t1 = x.
  t = x1000
  s = t
  t = (t * x1000) / 2000          ; x^2/2
  s = s - t
  t = (t * x1000) / 3000          ; x^3/6
  s = s + t
  t = (t * x1000) / 4000          ; x^4/24
  s = s - t
  If s < 0
    s = 0
  EndIf
  If s > 1000
    s = 1000
  EndIf
  ProcedureReturn s
EndProcedure

; ----------------------------------------------------------------------
;  Neon_Animate - the engine's, with an integer key.
;
;  `kind` distinguishes the five call sites the engine distinguishes
;  with a string prefix: 1 button hover (:354), 2 tab hover (:1123),
;  3 tab underline x (:1156), 4 tab underline w (:1157), 5 list row
;  hover (:1326).
;
;  target and initial are in thousandths; speed is in hundredths, so
;  the engine's 18.0 is 1800 and its 22.0 is 2200.
; ----------------------------------------------------------------------
Procedure.i Neon_Animate(kind.i, hotKey.i, target1000.i, speed100.i, initial1000.i)
  Protected key.i
  Protected slot.i
  Protected cur.i
  Protected dt.i
  Protected blend.i
  Protected diff.i

  key = (kind << 56) | (hotKey & $00FFFFFFFFFFFFFF)
  slot = neon_AnimSlot(key, 1, initial1000)
  If slot < 0
    ProcedureReturn target1000
  EndIf
  cur = neon_animVal[slot]

  dt = Neon_DeltaMs
  If dt < 0
    dt = 0
  EndIf
  If dt > 50
    dt = 50
  EndIf

  ; x = speed * dt, with speed in hundredths and dt in milliseconds:
  ; (speed100 / 100) * (dt / 1000) seconds, in thousandths, is
  ; speed100 * dt / 100.
  blend = neon_OneMinusExp((speed100 * dt) / 100)
  cur = cur + (((target1000 - cur) * blend) / 1000)

  diff = target1000 - cur
  If diff < 0
    diff = 0 - diff
  EndIf
  If diff < 2
    cur = target1000
  Else
    Neon_AnimationActive = 1
  EndIf

  neon_animVal[slot] = cur
  ProcedureReturn cur
EndProcedure

; The engine's map is called Neon_Animation() and is read directly.
; Here it is a function of the same two things that key it.
Procedure.i Neon_Animation(kind.i, hotKey.i)
  ProcedureReturn Neon_AnimationValue(kind, hotKey)
EndProcedure

Procedure.i Neon_AnimationValue(kind.i, hotKey.i)
  Protected slot.i
  slot = neon_AnimSlot((kind << 56) | (hotKey & $00FFFFFFFFFFFFFF), 0, 0)
  If slot < 0
    ProcedureReturn 0
  EndIf
  ProcedureReturn neon_animVal[slot]
EndProcedure

Procedure.i Neon_AnimationActiveGet()
  ProcedureReturn Neon_AnimationActive
EndProcedure


; ======================================================================
;  PERSISTENT PER-WIDGET STATE
;
;  The engine hands scroll positions and caret positions back through
;  pointers - `*Top.Integer`, `*CaretPos.Integer` - and keeps submenu
;  measurements in string-keyed maps. Neither shape is available here:
;  a .pi4 procedure takes at most eight arguments, there is no map, and
;  a pointer-to-integer parameter would need a width this dialect does
;  not settle for `.i` on every backend.
;
;  So the state lives HERE, keyed by an integer, and the caller reads
;  it back with Neon_StateGet. That is a real difference from the
;  engine's API and it is the only one in the widget layer.
;
;  IT SHARES THE ANIMATION TABLE'S MACHINERY AND NOT ITS TABLE. Sharing
;  the table would mean a busy list of sixty animated rows could evict
;  a scroll position, and a scroll position that silently returns to
;  zero is exactly the kind of "nearly right" this project refuses.
; ======================================================================
#NEON_STATE_SLOTS = 512

Global Dim neon_stKey.i[#NEON_STATE_SLOTS]
Global Dim neon_stVal.i[#NEON_STATE_SLOTS]
Global neon_stUsed.i = 0
Global neon_stFull.i = 0        ; 1 once anything has been refused a slot

Procedure NeonStateReset()
  Protected i.i
  i = 0
  While i < #NEON_STATE_SLOTS
    neon_stKey[i] = 0
    neon_stVal[i] = 0
    i = i + 1
  Wend
  neon_stUsed = 0
  neon_stFull = 0
EndProcedure

Procedure.i neon_StSlot(key.i, create.i)
  Protected h.i
  Protected i.i
  Protected n.i
  h = ((key >> 19) ! key ! (key >> 37)) & (#NEON_STATE_SLOTS - 1)
  n = 0
  While n < #NEON_STATE_SLOTS
    i = (h + n) & (#NEON_STATE_SLOTS - 1)
    If neon_stKey[i] = key
      ProcedureReturn i
    EndIf
    If neon_stKey[i] = 0
      If create = 0
        ProcedureReturn -1
      EndIf
      neon_stKey[i] = key
      neon_stVal[i] = 0
      neon_stUsed = neon_stUsed + 1
      ProcedureReturn i
    EndIf
    n = n + 1
  Wend
  neon_stFull = 1
  ProcedureReturn -1
EndProcedure

Procedure.i Neon_StateGet(kind.i, id.i)
  Protected s.i
  s = neon_StSlot((kind << 48) | (id & $0000FFFFFFFFFFFF), 0)
  If s < 0
    ProcedureReturn 0
  EndIf
  ProcedureReturn neon_stVal[s]
EndProcedure

Procedure Neon_StateSet(kind.i, id.i, v.i)
  Protected s.i
  s = neon_StSlot((kind << 48) | (id & $0000FFFFFFFFFFFF), 1)
  If s >= 0
    neon_stVal[s] = v
  EndIf
EndProcedure

Procedure.i Neon_StateFull()
  ProcedureReturn neon_stFull
EndProcedure

; The kinds. Named rather than numbered at the call sites so that a
; scroll position and a row count cannot be confused.
#NEON_ST_SCROLL   = 1    ; a list's or a scrollbar's top row
#NEON_ST_ROWS     = 2    ; a list's row count, measured last frame
#NEON_ST_CARET    = 3    ; a text field's caret index
#NEON_ST_SUBW     = 4    ; a submenu's measured width
#NEON_ST_SUBH     = 5    ; a submenu's measured height
#NEON_ST_SUBSCROLL = 6   ; a submenu's scroll offset

; A cheap string hash, for the one place the engine uses a string as
; an identity: the submenu key, Str(Neon_MenuOpenRoot) + ":" + Label
; (GlUIChrome.pbi:930). FNV-1a, 64-bit, folded so the top sixteen bits
; stay clear for the kind field above.
Procedure.i Neon_HashStr(*s)
  Protected h.i
  Protected i.i
  Protected c.i
  h = $CBF29CE484222325
  i = 0
  If *s = 0
    ProcedureReturn 0
  EndIf
  Repeat
    c = PeekA(*s + i)
    If c = 0
      Break
    EndIf
    h = (h ! c) * $100000001B3
    i = i + 1
    If i > 256
      Break
    EndIf
  ForEver
  ProcedureReturn (h ! (h >> 32)) & $00000000FFFFFFFF
EndProcedure


; ======================================================================
;  THE CHROME FRAME - GlUIChrome.pbi:237-249 and :279-294
; ======================================================================

; ----------------------------------------------------------------------
;  Neon_ChromeBeginFrame - snapshot the input.
;
;  The engine takes PHYSICAL mouse coordinates and maps them through
;  MapPhysicalToVirtual (GlUI.pbi:40-69). In #GL_VIEWPORT_NATIVE one
;  canvas unit is one physical pixel and that map is the identity
;  (GlUtilities.pbi:2240-2242), and this surface is native by
;  construction, so the coordinates go straight through.
;
;  THE BARREL-WARP INVERSE IS NOT PORTED. GlUI.pbi:29 sets
;  UI_UseCRT = #True but the chrome host pins it false
;  (GlIdeShell.pbi:3237), the chrome kit's own header says it does no
;  post-processing (GlUIChrome.pbi:38-41), and rule 13 says do not
;  build what was not asked for. A CRT filter over a debugging
;  instrument has already been removed from this project once.
;
;  dt IS IN MILLISECONDS. The engine's is a float in seconds.
; ----------------------------------------------------------------------
Procedure Neon_ChromeBeginFrame(mx.i, my.i, mouseDown.i, wheel.i, keyCode.i, keyChar.i, dtMs.i)
  Neon_MX = mx
  Neon_MY = my
  If mouseDown <> 0
    mouseDown = 1
  EndIf
  Neon_MouseDown = mouseDown
  If mouseDown <> 0 And Neon_MousePrev = 0
    Neon_MouseClicked = 1
  Else
    Neon_MouseClicked = 0
  EndIf
  If mouseDown = 0 And Neon_MousePrev <> 0
    Neon_MouseReleased = 1
  Else
    Neon_MouseReleased = 0
  EndIf
  Neon_MousePrev = mouseDown
  Neon_Wheel     = wheel
  Neon_KeyCode   = keyCode
  Neon_KeyChar   = keyChar
  Neon_DeltaMs   = dtMs
  Neon_AnimationActive = 0
  Neon_HotCount  = 0
EndProcedure

; ----------------------------------------------------------------------
;  Neon_ChromeEndFrame - drop what nobody consumed, and roll the hot
;  list over. GlUIChrome.pbi:279-294.
;
;  Dropping the wheel and the key is not tidying: an unconsumed event
;  that survived into the next frame would be delivered twice, to a
;  different widget, one frame late.
; ----------------------------------------------------------------------
Procedure Neon_ChromeEndFrame()
  Protected i.i
  Neon_Wheel   = 0
  Neon_KeyCode = 0
  Neon_KeyChar = 0
  i = 0
  While i < Neon_HotCount
    neon_zprevX[i]  = neon_hotX[i]
    neon_zprevY[i]  = neon_hotY[i]
    neon_zprevW[i]  = neon_hotW[i]
    neon_zprevH[i]  = neon_hotH[i]
    neon_zprevId[i] = neon_hotId[i]
    i = i + 1
  Wend
  Neon_HotPrevCount = Neon_HotCount
EndProcedure


; ======================================================================
;  Neon_Button - GlUIChrome.pbi:350-374
;
;  Returns 1 if it was clicked this frame.
;
;  Draw order: the GLOW FIRST - so only its outset halo survives the
;  face painted over it - then the face, the one-unit top highlight,
;  the one-unit bottom shade, and the centred label.
; ======================================================================
Procedure.i Neon_Button(x.i, y.i, w.i, h.i, *label, lit.i, enabled.i)
  Protected over.i
  Protected hotKey.i
  Protected hover.i
  Protected face.i
  Protected txt.i
  Protected th.i

  over = 0
  If enabled <> 0
    over = Neon_Hit(x, y, w, h)
  EndIf
  hotKey = Neon_HotKey(1, x, y)
  If enabled <> 0
    Neon_HotZone(x, y, w, h, hotKey)
  EndIf
  ; speed 18.0, initial 0.0 - the explicit initial is what makes a
  ; hover animate IN rather than snap (GlUIChrome.pbi:354, :266-269).
  hover = Neon_Animate(1, hotKey, over * 1000, 1800, 0)

  face = Neon_C_Line
  txt  = Neon_C_Text
  If lit <> 0
    face = Neon_C_BtnLit
    txt  = Neon_C_BtnLitText
  EndIf
  If enabled = 0
    txt = Neon_C_Faint
  EndIf
  If hover > 0
    face = Neon_Lift(face, hover)
    ; 0.16 * hover, and Neon_Glow takes thousandths.
    Neon_Glow(x, y, w, h, Neon_C_Acc, (160 * hover) / 1000)
  EndIf

  Neon_Box(x, y, w, h, face)
  Neon_Box(x, y, w, 1, Neon_C_BtnTop)
  Neon_Box(x, y + h - 1, w, 1, Neon_C_Bg)

  th = Neon_LineHeight(#NEON_FONT_UI)
  Neon_TextCentre(#NEON_FONT_UI, x, w, y + ((h - th) / 2), *label, txt)

  If over <> 0 And Neon_MouseClicked <> 0
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure


; ======================================================================
;  THE SCROLLBARS - GlUIChrome.pbi:435-531
;
;  The track is ALWAYS drawn, before the fits-everything early-out, so
;  the bar never vanishes when a list happens to fit.
;
;  ONLY THE THUMB IS HOVER SENSITIVE (:460, :507) and a click on the
;  track pages by one visible-count.
;
;  THE ENGINE HAS AN INTEGER-DIVISION BUG HERE and it is transcribed
;  as the FIX, not as the bug. `Visible / Total` and `*Top\i / maxTop`
;  are int/int in a float expression at :452, :455, :482, :502, :505
;  and :525; in the host language that truncates to 0 or 1, so the thumb
;  collapses to its 18-unit minimum and never moves. Here the same
;  arithmetic is done as a scaled integer - h * visible / total - which
;  is what the author meant and what the widget needs to work at all.
;  Said out loud because it is the one place this port deliberately
;  does not match the original's behaviour.
;
;  `id` identifies the bar. Its top row is kept in this file's state
;  table under #NEON_ST_SCROLL and the caller reads it with
;  Neon_StateGet(#NEON_ST_SCROLL, id).
; ======================================================================
Global Neon_DragScrollID.i = 0
Global Neon_DragScrollGrab.i = 0

Procedure.i Neon_ScrollBarV(id.i, x.i, y.i, w.i, h.i, total.i, visible.i)
  Protected top.i
  Protected maxTop.i
  Protected thumbH.i
  Protected travel.i
  Protected thumbY.i
  Protected over.i
  Protected onThumb.i
  Protected changed.i
  Protected want.i
  Protected newTop.i
  Protected col.i

  Neon_Box(x, y, w, h, Neon_C_Bg)

  If total <= visible Or total <= 0
    Neon_StateSet(#NEON_ST_SCROLL, id, 0)
    If Neon_DragScrollID = id
      Neon_DragScrollID = 0
    EndIf
    ProcedureReturn 0
  EndIf

  top = Neon_StateGet(#NEON_ST_SCROLL, id)
  maxTop = total - visible
  changed = 0
  If top < 0
    top = 0
    changed = 1
  EndIf
  If top > maxTop
    top = maxTop
    changed = 1
  EndIf

  thumbH = (h * visible) / total
  If thumbH < Neon_S(18)
    thumbH = Neon_S(18)
  EndIf
  If thumbH > h
    thumbH = h
  EndIf
  travel = h - thumbH
  thumbY = y
  If maxTop > 0
    thumbY = y + ((travel * top) / maxTop)
  EndIf

  over    = Neon_Hit(x, y, w, h)
  onThumb = Neon_Hit(x, thumbY, w, thumbH)
  Neon_HotZone(x, thumbY, w, thumbH, Neon_HotKey(7, id, 0))

  If Neon_MouseClicked <> 0 And over <> 0
    If onThumb <> 0
      Neon_DragScrollID   = id
      Neon_DragScrollGrab = Neon_MY - thumbY
    Else
      If Neon_MY < thumbY
        top = top - visible
      Else
        top = top + visible
      EndIf
      changed = 1
    EndIf
  EndIf
  ; An inert bar releases only its OWN drag. GlUIChrome.pbi:440-443
  ; records the bug this guard fixes: a later console scrollbar was
  ; cancelling the editor's drag.
  If Neon_MouseDown = 0 And Neon_DragScrollID = id
    Neon_DragScrollID = 0
  EndIf

  If Neon_DragScrollID = id And travel > 0
    want = Neon_MY - Neon_DragScrollGrab - y
    newTop = ((want * maxTop) + (travel / 2)) / travel
    If newTop <> top
      top = newTop
      changed = 1
    EndIf
  EndIf

  If top < 0
    top = 0
  EndIf
  If top > maxTop
    top = maxTop
  EndIf
  Neon_StateSet(#NEON_ST_SCROLL, id, top)

  thumbY = y
  If maxTop > 0
    thumbY = y + ((travel * top) / maxTop)
  EndIf

  col = Neon_C_Thumb
  If onThumb <> 0 Or Neon_DragScrollID = id
    col = Neon_Mul(Neon_C_Acc, 80, 100)
  EndIf
  Neon_Box(x + 2, thumbY, w - 4, thumbH, col)

  ProcedureReturn changed
EndProcedure

Procedure.i Neon_ScrollBarH(id.i, x.i, y.i, w.i, h.i, total.i, visible.i)
  Protected left.i
  Protected maxLeft.i
  Protected thumbW.i
  Protected travel.i
  Protected thumbX.i
  Protected over.i
  Protected onThumb.i
  Protected changed.i
  Protected want.i
  Protected newLeft.i
  Protected col.i

  Neon_Box(x, y, w, h, Neon_C_Bg)

  If total <= visible Or total <= 0
    Neon_StateSet(#NEON_ST_SCROLL, id, 0)
    If Neon_DragScrollID = id
      Neon_DragScrollID = 0
    EndIf
    ProcedureReturn 0
  EndIf

  left = Neon_StateGet(#NEON_ST_SCROLL, id)
  maxLeft = total - visible
  changed = 0
  If left < 0
    left = 0
    changed = 1
  EndIf
  If left > maxLeft
    left = maxLeft
    changed = 1
  EndIf

  thumbW = (w * visible) / total
  If thumbW < Neon_S(18)
    thumbW = Neon_S(18)
  EndIf
  If thumbW > w
    thumbW = w
  EndIf
  travel = w - thumbW
  thumbX = x
  If maxLeft > 0
    thumbX = x + ((travel * left) / maxLeft)
  EndIf

  over    = Neon_Hit(x, y, w, h)
  onThumb = Neon_Hit(thumbX, y, thumbW, h)
  Neon_HotZone(thumbX, y, thumbW, h, Neon_HotKey(8, id, 0))

  If Neon_MouseClicked <> 0 And over <> 0
    If onThumb <> 0
      Neon_DragScrollID   = id
      Neon_DragScrollGrab = Neon_MX - thumbX
    Else
      If Neon_MX < thumbX
        left = left - visible
      Else
        left = left + visible
      EndIf
      changed = 1
    EndIf
  EndIf
  If Neon_MouseDown = 0 And Neon_DragScrollID = id
    Neon_DragScrollID = 0
  EndIf

  If Neon_DragScrollID = id And travel > 0
    want = Neon_MX - Neon_DragScrollGrab - x
    newLeft = ((want * maxLeft) + (travel / 2)) / travel
    If newLeft <> left
      left = newLeft
      changed = 1
    EndIf
  EndIf

  If left < 0
    left = 0
  EndIf
  If left > maxLeft
    left = maxLeft
  EndIf
  Neon_StateSet(#NEON_ST_SCROLL, id, left)

  thumbX = x
  If maxLeft > 0
    thumbX = x + ((travel * left) / maxLeft)
  EndIf

  col = Neon_C_Thumb
  If onThumb <> 0 Or Neon_DragScrollID = id
    col = Neon_Mul(Neon_C_Acc, 80, 100)
  EndIf
  Neon_Box(thumbX, y + 2, thumbW, h - 4, col)

  ProcedureReturn changed
EndProcedure
; The key codes the field consumes. The engine uses the host
; #PB_Shortcut_* values; these are the ASCII/keypad numbers a bare
; metal HID layer produces, named here so the mapping is in one place.
#NEON_KEY_BACK   = 8
#NEON_KEY_TAB    = 9
#NEON_KEY_RETURN = 13
#NEON_KEY_ESCAPE = 27
#NEON_KEY_DELETE = 127
#NEON_KEY_LEFT   = 256
#NEON_KEY_RIGHT  = 257
#NEON_KEY_UP     = 258
#NEON_KEY_DOWN   = 259
#NEON_KEY_HOME   = 260
#NEON_KEY_END    = 261


; ======================================================================
;  THE MENU SYSTEM - GlUIChrome.pbi:570-1082
;
;  A menu bar of root tabs, one drop-down at a time, and one level of
;  submenu. The whole thing is IMMEDIATE MODE with one frame of memory:
;  a drop-down's width and height are MEASURED by the items that draw
;  inside it and used to lay it out on the NEXT frame. That is why
;  Neon_MenuEnd must be called whether or not Neon_MenuBegin returned
;  true, and why the first frame a menu opens is laid out at a default
;  size.
;
;  THE PREFLIGHT IN Neon_MenuBarBegin IS NOT AN OPTIMISATION. Sliding
;  the pointer along the bar with a menu open has to transfer ownership
;  BEFORE any root paints, or a frame exists in which the old
;  drop-down and the new tab are both drawn. GlUIChrome.pbi:640-642
;  says so in as many words.
;
;  THE SUBMENU KEY IS A HASH, not a string. The engine's key is
;  Str(Neon_MenuOpenRoot) + ":" + Label (:930). Here it is
;  (root << 32) | FNV1a(Label), which is the same identity with the
;  same lifetime. A collision would open the wrong submenu; with a
;  32-bit hash over the handful of labels one menu carries that is not
;  a risk worth a string table.
; ======================================================================
#NEON_MENU_MAXROOTS = 32

Global Neon_MenuBarX.i = 0
Global Neon_MenuBarY.i = 0
Global Neon_MenuBarW.i = 0
Global Neon_MenuBarH.i = 0
Global Neon_MenuRootIdx.i = -1
Global Neon_MenuOpenRoot.i = -1
Global Neon_MenuCursorX.i = 0
Global Neon_MenuAnyOpenLastFrame.i = 0
Global Neon_MenuRootCountLastFrame.i = 0
Global Neon_MenuPreflightRoot.i = -1
Global Neon_MenuLayoutChanged.i = 0

Global Dim neon_menuMeasW.i[#NEON_MENU_MAXROOTS]
Global Dim neon_menuMeasH.i[#NEON_MENU_MAXROOTS]
Global Dim neon_menuTabX.i[#NEON_MENU_MAXROOTS]
Global Dim neon_menuTabW.i[#NEON_MENU_MAXROOTS]

Global Neon_MenuBlockX.i = 0
Global Neon_MenuBlockY.i = 0
Global Neon_MenuBlockW.i = 0
Global Neon_MenuBlockH.i = 0
Global Neon_MenuBlockActive.i = 0

Global Neon_DropOpen.i = 0
Global Neon_DropX.i = 0
Global Neon_DropY.i = 0
Global Neon_DropW.i = 0
Global Neon_DropCursorY.i = 0
Global Neon_DropMaxW.i = 0
Global Neon_DropRows.i = 0
Global Neon_DropScroll.i = 0
Global Neon_DropViewY.i = 0
Global Neon_DropViewH.i = 0
Global Neon_DropScrolls.i = 0
Global neon_dropWantH.i = 0

Global Neon_SubActive.i = 0
Global Neon_SubOpen.i = 0
Global Neon_SubOpenKey.i = 0
Global Neon_SubKey.i = 0
Global Neon_SubX.i = 0
Global Neon_SubY.i = 0
Global Neon_SubW.i = 0
Global Neon_SubCursorY.i = 0
Global Neon_SubMaxW.i = 0
Global Neon_SubRows.i = 0
Global Neon_SubScroll.i = 0
Global Neon_SubViewY.i = 0
Global Neon_SubViewH.i = 0
Global Neon_SubScrolls.i = 0
Global neon_subWantH.i = 0

; GlUIChrome.pbi:630-632
Procedure.i Neon_MenuIsOpen()
  If Neon_MenuOpenRoot >= 0
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

; ----------------------------------------------------------------------
;  Neon_MenuBlocksMouse - GlUIChrome.pbi:621-628.
;
;  ASK THIS BEFORE HIT-TESTING YOUR OWN PANELS. A click outside an open
;  menu belongs to the menu: it dismisses it, and it must not also
;  activate whatever was underneath. Three ways to be true - a menu is
;  open at all, the pointer is over the bar, or the pointer is inside
;  the open drop-down's block rectangle.
; ----------------------------------------------------------------------
Procedure.i Neon_MenuBlocksMouse()
  If Neon_MenuOpenRoot >= 0
    ProcedureReturn 1
  EndIf
  If Neon_MenuBarW > 0
    If Neon_Hit(Neon_MenuBarX, Neon_MenuBarY, Neon_MenuBarW, Neon_MenuBarH) <> 0
      ProcedureReturn 1
    EndIf
  EndIf
  If Neon_MenuBlockActive <> 0
    If Neon_Hit(Neon_MenuBlockX, Neon_MenuBlockY, Neon_MenuBlockW, Neon_MenuBlockH) <> 0
      ProcedureReturn 1
    EndIf
  EndIf
  ProcedureReturn 0
EndProcedure

; GlUIChrome.pbi:634-637
Procedure Neon_MenuCloseAll()
  Neon_MenuOpenRoot = -1
  Neon_SubOpenKey   = 0
EndProcedure

; GlUIChrome.pbi:643-648. Ownership changes BEFORE any root emits.
Procedure Neon_MenuSelectRoot(idx.i)
  If idx < 0 Or idx >= #NEON_MENU_MAXROOTS
    ProcedureReturn
  EndIf
  Neon_MenuOpenRoot = idx
  Neon_SubOpenKey   = 0
  Neon_DropScroll   = 0
EndProcedure

Procedure.i Neon_MenuCursorXGet()
  ProcedureReturn Neon_MenuCursorX
EndProcedure

; ----------------------------------------------------------------------
;  Neon_MenuBarBegin - GlUIChrome.pbi:650-683
; ----------------------------------------------------------------------
Procedure Neon_MenuBarBegin(x.i, y.i, w.i, h.i)
  Protected pf.i

  Neon_MenuBarX = x
  Neon_MenuBarY = y
  Neon_MenuBarW = w
  Neon_MenuBarH = h
  Neon_MenuRootIdx = -1
  Neon_MenuCursorX = x + Neon_S(8)
  Neon_MenuBlockActive = 0
  Neon_MenuPreflightRoot = -1
  Neon_MenuLayoutChanged = 0

  ; The preflight. Only when a menu is already open, only when last
  ; frame measured some roots, and only when the pointer is on the bar.
  If Neon_MenuOpenRoot >= 0
    If Neon_MenuRootCountLastFrame > 0
      If Neon_MY >= y
        If Neon_MY < (y + h)
          pf = 0
          While pf < Neon_MenuRootCountLastFrame
            If Neon_Hit(neon_menuTabX[pf], y, neon_menuTabW[pf], h) <> 0
              If pf <> Neon_MenuOpenRoot
                Neon_MenuSelectRoot(pf)
                Neon_MenuPreflightRoot = pf
              EndIf
              Break
            EndIf
            pf = pf + 1
          Wend
        EndIf
      EndIf
    EndIf
  EndIf

  Neon_Box(x, y, w, h, Neon_C_Head)
  Neon_Box(x, y + h - 1, w, 1, Neon_C_Line)

  If Neon_KeyCode = #NEON_KEY_ESCAPE
    If Neon_MenuOpenRoot >= 0
      Neon_MenuCloseAll()
      Neon_KeyCode = 0
    EndIf
  EndIf
EndProcedure

; ----------------------------------------------------------------------
;  Neon_MenuBegin - GlUIChrome.pbi:687-812. Returns 1 if the drop-down
;  is open and its items should be emitted.
; ----------------------------------------------------------------------
Procedure.i Neon_MenuBegin(*title)
  Protected idx.i
  Protected tw.i
  Protected tabW.i
  Protected tabX.i
  Protected over.i
  Protected isOpen.i
  Protected th.i
  Protected firstLayout.i
  Protected availH.i
  Protected panelH.i
  Protected maxScroll.i
  Protected upY.i
  Protected dnY.i

  Neon_MenuRootIdx = Neon_MenuRootIdx + 1
  idx = Neon_MenuRootIdx
  If idx >= #NEON_MENU_MAXROOTS
    Neon_DropOpen = 0
    ProcedureReturn 0
  EndIf

  tw   = Neon_TextWidth(#NEON_FONT_UI, *title)
  tabW = tw + Neon_S(24)
  tabX = Neon_MenuCursorX
  neon_menuTabX[idx] = tabX
  neon_menuTabW[idx] = tabW
  Neon_MenuCursorX = Neon_MenuCursorX + tabW

  over   = Neon_Hit(tabX, Neon_MenuBarY, tabW, Neon_MenuBarH)
  isOpen = 0
  If Neon_MenuOpenRoot = idx
    isOpen = 1
  EndIf
  Neon_HotZone(tabX, Neon_MenuBarY, tabW, Neon_MenuBarH, Neon_HotKey(2, idx, 0))

  If over <> 0 And Neon_MouseClicked <> 0
    If isOpen <> 0 And Neon_MenuPreflightRoot <> idx
      Neon_MenuCloseAll()
    ElseIf isOpen = 0
      Neon_MenuSelectRoot(idx)
    EndIf
    isOpen = 0
    If Neon_MenuOpenRoot = idx
      isOpen = 1
    EndIf
  ElseIf over <> 0 And Neon_MenuOpenRoot >= 0 And Neon_MenuOpenRoot <> idx
    ; Slide along the bar with a menu open.
    Neon_MenuSelectRoot(idx)
    isOpen = 1
  EndIf

  th = Neon_LineHeight(#NEON_FONT_UI)
  If isOpen <> 0
    Neon_Box(tabX, Neon_MenuBarY, tabW, Neon_MenuBarH, Neon_Mul3(Neon_C_Acc, 30, 30, 34))
    Neon_Box(tabX, Neon_MenuBarY + Neon_MenuBarH - 2, tabW, 2, Neon_C_Acc)
    Neon_TextCentre(#NEON_FONT_UI, tabX, tabW, Neon_MenuBarY + ((Neon_MenuBarH - th) / 2), *title, Neon_C_Acc)
  ElseIf over <> 0
    Neon_Box(tabX, Neon_MenuBarY, tabW, Neon_MenuBarH, Neon_C_Line)
    Neon_TextCentre(#NEON_FONT_UI, tabX, tabW, Neon_MenuBarY + ((Neon_MenuBarH - th) / 2), *title, Neon_C_Text)
  Else
    Neon_TextCentre(#NEON_FONT_UI, tabX, tabW, Neon_MenuBarY + ((Neon_MenuBarH - th) / 2), *title, Neon_C_Text)
  EndIf

  Neon_DropOpen = isOpen
  If isOpen = 0
    ProcedureReturn 0
  EndIf

  ; ---- layout, from LAST frame's measurement -------------------------
  firstLayout = 0
  If neon_menuMeasH[idx] <= 0
    firstLayout = 1
  EndIf
  Neon_DropW = neon_menuMeasW[idx]
  If Neon_DropW <= 0
    Neon_DropW = Neon_S(420)
  EndIf
  If Neon_DropW < Neon_S(160)
    Neon_DropW = Neon_S(160)
  EndIf
  If Neon_DropW > (neon_w - 6)
    Neon_DropW = neon_w - 6
  EndIf
  Neon_DropX = tabX
  If (Neon_DropX + Neon_DropW) > (neon_w - 4)
    Neon_DropX = neon_w - 4 - Neon_DropW
  EndIf
  If Neon_DropX < 2
    Neon_DropX = 2
  EndIf
  Neon_DropY = Neon_MenuBarY + Neon_MenuBarH

  neon_dropWantH = neon_menuMeasH[idx]
  availH = neon_h - Neon_DropY - 8
  If firstLayout <> 0
    neon_dropWantH = availH - 8
  ElseIf neon_dropWantH < Neon_S(24)
    neon_dropWantH = Neon_S(24)
  EndIf
  If neon_dropWantH < Neon_S(24)
    neon_dropWantH = Neon_S(24)
  EndIf

  Neon_DropScrolls = 0
  If neon_dropWantH > availH
    Neon_DropScrolls = 1
  EndIf
  Neon_DropViewY = Neon_DropY + 4
  If Neon_DropScrolls <> 0
    Neon_DropViewH = availH - 8 - (Neon_S(16) * 2)
    Neon_DropViewY = Neon_DropY + 4 + Neon_S(16)
  Else
    Neon_DropViewH = neon_dropWantH
  EndIf
  panelH = Neon_DropViewH + 8
  If Neon_DropScrolls <> 0
    panelH = panelH + (Neon_S(16) * 2)
  EndIf

  ; ---- the panel: shadow, body, border -------------------------------
  Neon_Glow(Neon_DropX, Neon_DropY, Neon_DropW, panelH, Neon_C_Black, 450)
  Neon_Box(Neon_DropX, Neon_DropY, Neon_DropW, panelH, Neon_C_Head)
  Neon_Frame(Neon_DropX, Neon_DropY, Neon_DropW, panelH, Neon_Mul(Neon_C_Acc, 55, 100))

  Neon_MenuBlockActive = 1
  Neon_MenuBlockX = Neon_DropX
  Neon_MenuBlockY = Neon_DropY
  Neon_MenuBlockW = Neon_DropW
  Neon_MenuBlockH = panelH

  ; ---- the wheel and the arrow strips --------------------------------
  If Neon_DropScrolls <> 0
    If Neon_Wheel <> 0
      If Neon_Hit(Neon_DropX, Neon_DropY, Neon_DropW, panelH) <> 0
        Neon_DropScroll = Neon_DropScroll - (Neon_Wheel * (Neon_S(24) * 2))
        Neon_Wheel = 0
      EndIf
    EndIf
  Else
    Neon_DropScroll = 0
  EndIf
  maxScroll = neon_dropWantH - Neon_DropViewH
  If maxScroll < 0
    maxScroll = 0
  EndIf
  If Neon_DropScroll < 0
    Neon_DropScroll = 0
  EndIf
  If Neon_DropScroll > maxScroll
    Neon_DropScroll = maxScroll
  EndIf

  If Neon_DropScrolls <> 0
    upY = Neon_DropY + 4
    dnY = Neon_DropY + panelH - 4 - Neon_S(16)
    Neon_Box(Neon_DropX + 1, upY, Neon_DropW - 2, Neon_S(16), Neon_C_Line)
    Neon_Box(Neon_DropX + 1, dnY, Neon_DropW - 2, Neon_S(16), Neon_C_Line)
    Neon_TextCentre(#NEON_FONT_SMALL, Neon_DropX, Neon_DropW, upY, "^", Neon_C_Acc)
    Neon_TextCentre(#NEON_FONT_SMALL, Neon_DropX, Neon_DropW, dnY, "v", Neon_C_Acc)
    If Neon_Hit(Neon_DropX, upY, Neon_DropW, Neon_S(16)) <> 0
      Neon_DropScroll = Neon_DropScroll - 6
    EndIf
    If Neon_Hit(Neon_DropX, dnY, Neon_DropW, Neon_S(16)) <> 0
      Neon_DropScroll = Neon_DropScroll + 6
    EndIf
    If Neon_DropScroll < 0
      Neon_DropScroll = 0
    EndIf
    If Neon_DropScroll > maxScroll
      Neon_DropScroll = maxScroll
    EndIf
  EndIf

  Neon_DropCursorY = 0
  Neon_DropMaxW    = 0
  Neon_DropRows    = 0
  Neon_SubActive   = 0
  Neon_ScissorSet(Neon_DropX, Neon_DropViewY, Neon_DropW, Neon_DropViewH)
  ProcedureReturn 1
EndProcedure

; ----------------------------------------------------------------------
;  Neon_MenuItem - GlUIChrome.pbi:817-897. Returns 1 on a click, and a
;  click closes the whole menu.
;
;  THE CHECK MARK IS SEVEN GREEN BOXES and not a glyph (:864-886). The
;  engine's own comment explains why and the same reason holds harder
;  here: a one-bit font has no tick.
; ----------------------------------------------------------------------
Procedure.i Neon_MenuItem(*label, *shortcut, enabled.i, checked.i)
  Protected x.i
  Protected w.i
  Protected rowY.i
  Protected viewY.i
  Protected viewH.i
  Protected rowH.i
  Protected need.i
  Protected over.i
  Protected col.i
  Protected th.i
  Protected ty.i
  Protected markU.i
  Protected markX.i
  Protected markY.i

  If Neon_DropOpen = 0
    ProcedureReturn 0
  EndIf
  rowH = Neon_S(24)

  If Neon_SubActive <> 0
    If Neon_SubOpen = 0
      ProcedureReturn 0
    EndIf
    x = Neon_SubX
    w = Neon_SubW
    rowY = Neon_SubViewY + Neon_SubCursorY - Neon_SubScroll
    viewY = Neon_SubViewY
    viewH = Neon_SubViewH
    Neon_SubCursorY = Neon_SubCursorY + rowH
    Neon_SubRows    = Neon_SubRows + rowH
  Else
    x = Neon_DropX
    w = Neon_DropW
    rowY = Neon_DropViewY + Neon_DropCursorY - Neon_DropScroll
    viewY = Neon_DropViewY
    viewH = Neon_DropViewH
    Neon_DropCursorY = Neon_DropCursorY + rowH
    Neon_DropRows    = Neon_DropRows + rowH
  EndIf

  ; The width this row would like, for NEXT frame's layout.
  need = (Neon_S(14) * 2) + Neon_S(18) + Neon_TextWidth(#NEON_FONT_UI, *label)
  If *shortcut <> 0
    If PeekA(*shortcut) <> 0
      need = need + Neon_S(46) + Neon_TextWidth(#NEON_FONT_SMALL, *shortcut)
    EndIf
  EndIf
  If Neon_SubActive <> 0
    If need > Neon_SubMaxW
      Neon_SubMaxW = need
    EndIf
  Else
    If need > Neon_DropMaxW
      Neon_DropMaxW = need
    EndIf
  EndIf

  ; MEASURED BUT NOT DRAWN when it is outside the view. The measuring
  ; above already happened, which is what lets a scrolled menu still
  ; know how wide it wants to be.
  If (rowY + rowH) < viewY
    ProcedureReturn 0
  EndIf
  If rowY > (viewY + viewH)
    ProcedureReturn 0
  EndIf

  over = 0
  If enabled <> 0
    If Neon_Hit(x, rowY, w, rowH) <> 0
      If Neon_MY >= viewY
        If Neon_MY < (viewY + viewH)
          over = 1
        EndIf
      EndIf
    EndIf
    Neon_HotZone(x, rowY, w, rowH, Neon_HotKey(3, x, rowY))
  EndIf
  If over <> 0
    Neon_Box(x + 1, rowY, w - 2, rowH, Neon_Mul3(Neon_C_Acc, 28, 28, 32))
  EndIf

  col = Neon_C_Text
  If enabled = 0
    col = Neon_C_Faint
  EndIf
  th = Neon_LineHeight(#NEON_FONT_UI)
  ty = rowY + ((rowH - th) / 2)

  If checked <> 0
    markU = Neon_S(2)
    If markU < 2
      markU = 2
    EndIf
    markX = x + Neon_S(4)
    markY = rowY + ((rowH - (markU * 7)) / 2)
    Neon_Box(markX,                 markY + (markU * 2), markU, markU * 3, Neon_C_Grn)
    Neon_Box(markX + markU,         markY + (markU * 3), markU, markU * 3, Neon_C_Grn)
    Neon_Box(markX + (markU * 2),   markY + (markU * 4), markU, markU * 3, Neon_C_Grn)
    Neon_Box(markX + (markU * 3),   markY + (markU * 3), markU, markU * 3, Neon_C_Grn)
    Neon_Box(markX + (markU * 4),   markY + (markU * 2), markU, markU * 3, Neon_C_Grn)
    Neon_Box(markX + (markU * 5),   markY + markU,       markU, markU * 3, Neon_C_Grn)
    Neon_Box(markX + (markU * 6),   markY,               markU, markU * 3, Neon_C_Grn)
  EndIf

  Neon_Text(#NEON_FONT_UI, x + Neon_S(14) + 4, ty, *label, col)
  If *shortcut <> 0
    If PeekA(*shortcut) <> 0
      Neon_TextRight(#NEON_FONT_SMALL, x + w - Neon_S(14), ty + 1, *shortcut, Neon_C_Faint)
    EndIf
  EndIf

  If over <> 0 And Neon_MouseClicked <> 0
    Neon_MenuCloseAll()
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

; GlUIChrome.pbi:899-913. Advances by Neon_S(9) and draws a one-unit
; rule inset ten units each side, all unscaled. No cull test - the
; scissor handles it, which is the engine's choice too.
Procedure Neon_MenuSeparator()
  Protected x.i
  Protected w.i
  Protected rowY.i
  Protected sepH.i

  If Neon_DropOpen = 0
    ProcedureReturn
  EndIf
  sepH = Neon_S(9)
  If Neon_SubActive <> 0
    If Neon_SubOpen = 0
      ProcedureReturn
    EndIf
    x = Neon_SubX
    w = Neon_SubW
    rowY = Neon_SubViewY + Neon_SubCursorY - Neon_SubScroll
    Neon_SubCursorY = Neon_SubCursorY + sepH
    Neon_SubRows    = Neon_SubRows + sepH
  Else
    x = Neon_DropX
    w = Neon_DropW
    rowY = Neon_DropViewY + Neon_DropCursorY - Neon_DropScroll
    Neon_DropCursorY = Neon_DropCursorY + sepH
    Neon_DropRows    = Neon_DropRows + sepH
  EndIf
  Neon_Box(x + 10, rowY + (sepH / 2), w - 20, 1, Neon_C_Line)
EndProcedure

; ----------------------------------------------------------------------
;  Neon_SubMenuBegin - GlUIChrome.pbi:917-1036. ONE LEVEL ONLY.
; ----------------------------------------------------------------------
Procedure.i Neon_SubMenuBegin(*label)
  Protected rowY.i
  Protected rowTop.i
  Protected rowH.i
  Protected need.i
  Protected isOpen.i
  Protected visible.i
  Protected over.i
  Protected th.i
  Protected ty.i
  Protected availH.i
  Protected panelH.i
  Protected maxScroll.i
  Protected upY.i
  Protected dnY.i

  If Neon_DropOpen = 0
    ProcedureReturn 0
  EndIf
  If Neon_SubActive <> 0
    ProcedureReturn 0
  EndIf

  rowH   = Neon_S(24)
  rowY   = Neon_DropViewY + Neon_DropCursorY - Neon_DropScroll
  rowTop = Neon_DropCursorY
  Neon_DropCursorY = Neon_DropCursorY + rowH
  Neon_DropRows    = Neon_DropRows + rowH

  need = (Neon_S(14) * 2) + Neon_S(40) + Neon_TextWidth(#NEON_FONT_UI, *label)
  If need > Neon_DropMaxW
    Neon_DropMaxW = need
  EndIf

  Neon_SubKey = ((Neon_MenuOpenRoot + 1) << 32) | Neon_HashStr(*label)
  isOpen = 0
  If Neon_SubOpenKey = Neon_SubKey
    isOpen = 1
  EndIf

  visible = 1
  If (rowY + rowH) < Neon_DropViewY
    visible = 0
  EndIf
  If rowY > (Neon_DropViewY + Neon_DropViewH)
    visible = 0
  EndIf

  over = 0
  If visible <> 0
    If Neon_Hit(Neon_DropX, rowY, Neon_DropW, rowH) <> 0
      If Neon_MY >= Neon_DropViewY
        If Neon_MY < (Neon_DropViewY + Neon_DropViewH)
          over = 1
        EndIf
      EndIf
    EndIf
    Neon_HotZone(Neon_DropX, rowY, Neon_DropW, rowH, Neon_HotKey(4, Neon_DropX, rowY))
  EndIf
  If over <> 0 And Neon_SubOpenKey <> Neon_SubKey
    Neon_SubOpenKey = Neon_SubKey
    Neon_StateSet(#NEON_ST_SUBSCROLL, Neon_SubKey, 0)
    isOpen = 1
  EndIf

  If visible <> 0
    If over <> 0 Or isOpen <> 0
      Neon_Box(Neon_DropX + 1, rowY, Neon_DropW - 2, rowH, Neon_Mul3(Neon_C_Acc, 28, 28, 32))
    EndIf
    th = Neon_LineHeight(#NEON_FONT_UI)
    ty = rowY + ((rowH - th) / 2)
    Neon_Text(#NEON_FONT_UI, Neon_DropX + Neon_S(14) + 4, ty, *label, Neon_C_Text)
    Neon_TextRight(#NEON_FONT_UI, Neon_DropX + Neon_DropW - 8, ty, ">", Neon_C_Dim)
  EndIf

  Neon_SubActive = 1
  Neon_SubOpen   = isOpen
  If isOpen = 0
    ProcedureReturn 0
  EndIf

  ; ---- the submenu panel ----------------------------------------------
  Neon_SubW = Neon_StateGet(#NEON_ST_SUBW, Neon_SubKey)
  If Neon_SubW < Neon_S(180)
    Neon_SubW = Neon_S(180)
  EndIf
  Neon_SubX = Neon_DropX + Neon_DropW - 2
  If (Neon_SubX + Neon_SubW) > (neon_w - 4)
    Neon_SubX = Neon_DropX - Neon_SubW + 2
    If Neon_SubX < 2
      Neon_SubX = 2
    EndIf
  EndIf

  neon_subWantH = Neon_StateGet(#NEON_ST_SUBH, Neon_SubKey)
  If neon_subWantH < Neon_S(24)
    neon_subWantH = Neon_S(24)
  EndIf
  Neon_SubY = Neon_DropViewY + rowTop - Neon_DropScroll - 4
  If Neon_SubY < (Neon_MenuBarY + Neon_MenuBarH)
    Neon_SubY = Neon_MenuBarY + Neon_MenuBarH
  EndIf
  availH = neon_h - Neon_SubY - 8
  Neon_SubScrolls = 0
  If neon_subWantH > availH
    Neon_SubScrolls = 1
  EndIf
  If Neon_SubScrolls <> 0
    Neon_SubViewH = availH - 8 - (Neon_S(16) * 2)
    Neon_SubViewY = Neon_SubY + 4 + Neon_S(16)
  Else
    Neon_SubViewH = neon_subWantH
    Neon_SubViewY = Neon_SubY + 4
    If (Neon_SubY + neon_subWantH + 8) > neon_h
      Neon_SubY = neon_h - neon_subWantH - 10
      Neon_SubViewY = Neon_SubY + 4
    EndIf
  EndIf
  panelH = Neon_SubViewH + 8
  If Neon_SubScrolls <> 0
    panelH = panelH + (Neon_S(16) * 2)
  EndIf

  ; THE PARENT'S CLIP COMES OFF FIRST, or the submenu is cut by the
  ; drop-down it hangs off (GlUIChrome.pbi:991).
  Neon_ScissorClear()
  Neon_Glow(Neon_SubX, Neon_SubY, Neon_SubW, panelH, Neon_C_Black, 450)
  Neon_Box(Neon_SubX, Neon_SubY, Neon_SubW, panelH, Neon_C_Head)
  Neon_Frame(Neon_SubX, Neon_SubY, Neon_SubW, panelH, Neon_Mul(Neon_C_Acc, 55, 100))

  ; The block rectangle grows to cover both panels.
  If (Neon_SubX + Neon_SubW) > (Neon_MenuBlockX + Neon_MenuBlockW)
    Neon_MenuBlockW = Neon_SubX + Neon_SubW - Neon_MenuBlockX
  EndIf
  If Neon_SubX < Neon_MenuBlockX
    Neon_MenuBlockW = Neon_MenuBlockW + (Neon_MenuBlockX - Neon_SubX)
    Neon_MenuBlockX = Neon_SubX
  EndIf
  If (Neon_SubY + panelH) > (Neon_MenuBlockY + Neon_MenuBlockH)
    Neon_MenuBlockH = Neon_SubY + panelH - Neon_MenuBlockY
  EndIf

  Neon_SubScroll = Neon_StateGet(#NEON_ST_SUBSCROLL, Neon_SubKey)
  If Neon_SubScrolls <> 0
    If Neon_Wheel <> 0
      Neon_SubScroll = Neon_SubScroll - (Neon_Wheel * (Neon_S(24) * 2))
      Neon_Wheel = 0
    EndIf
  Else
    Neon_SubScroll = 0
  EndIf
  maxScroll = neon_subWantH - Neon_SubViewH
  If maxScroll < 0
    maxScroll = 0
  EndIf
  If Neon_SubScrolls <> 0
    upY = Neon_SubY + 4
    dnY = Neon_SubY + panelH - 4 - Neon_S(16)
    Neon_Box(Neon_SubX + 1, upY, Neon_SubW - 2, Neon_S(16), Neon_C_Line)
    Neon_Box(Neon_SubX + 1, dnY, Neon_SubW - 2, Neon_S(16), Neon_C_Line)
    Neon_TextCentre(#NEON_FONT_SMALL, Neon_SubX, Neon_SubW, upY, "^", Neon_C_Acc)
    Neon_TextCentre(#NEON_FONT_SMALL, Neon_SubX, Neon_SubW, dnY, "v", Neon_C_Acc)
    If Neon_Hit(Neon_SubX, upY, Neon_SubW, Neon_S(16)) <> 0
      Neon_SubScroll = Neon_SubScroll - 6
    EndIf
    If Neon_Hit(Neon_SubX, dnY, Neon_SubW, Neon_S(16)) <> 0
      Neon_SubScroll = Neon_SubScroll + 6
    EndIf
  EndIf
  If Neon_SubScroll < 0
    Neon_SubScroll = 0
  EndIf
  If Neon_SubScroll > maxScroll
    Neon_SubScroll = maxScroll
  EndIf
  Neon_StateSet(#NEON_ST_SUBSCROLL, Neon_SubKey, Neon_SubScroll)

  Neon_SubCursorY = 0
  Neon_SubMaxW    = 0
  Neon_SubRows    = 0
  Neon_ScissorSet(Neon_SubX, Neon_SubViewY, Neon_SubW, Neon_SubViewH)
  ProcedureReturn 1
EndProcedure

; GlUIChrome.pbi:1038-1048. Records the measurement and restores the
; PARENT's clip.
Procedure Neon_SubMenuEnd()
  If Neon_DropOpen = 0
    ProcedureReturn
  EndIf
  If Neon_SubOpen <> 0
    Neon_StateSet(#NEON_ST_SUBW, Neon_SubKey, Neon_SubMaxW)
    Neon_StateSet(#NEON_ST_SUBH, Neon_SubKey, Neon_SubRows)
  EndIf
  Neon_SubActive = 0
  Neon_SubOpen   = 0
  Neon_ScissorSet(Neon_DropX, Neon_DropViewY, Neon_DropW, Neon_DropViewH)
EndProcedure

; ----------------------------------------------------------------------
;  Neon_MenuEnd - GlUIChrome.pbi:1050-1061. Draws nothing. MUST be
;  called whether or not Neon_MenuBegin returned true, because it is
;  what advances to the next root and what records the measurement.
; ----------------------------------------------------------------------
Procedure Neon_MenuEnd()
  Protected d.i
  If Neon_DropOpen = 0
    ProcedureReturn
  EndIf
  Neon_ScissorClear()
  If Neon_MenuRootIdx >= 0 And Neon_MenuRootIdx < #NEON_MENU_MAXROOTS
    d = neon_menuMeasW[Neon_MenuRootIdx] - Neon_DropMaxW
    If d < 0
      d = 0 - d
    EndIf
    If d > 0
      Neon_MenuLayoutChanged = 1
    EndIf
    d = neon_menuMeasH[Neon_MenuRootIdx] - Neon_DropRows
    If d < 0
      d = 0 - d
    EndIf
    If d > 0
      Neon_MenuLayoutChanged = 1
    EndIf
    neon_menuMeasW[Neon_MenuRootIdx] = Neon_DropMaxW
    neon_menuMeasH[Neon_MenuRootIdx] = Neon_DropRows
  EndIf
  Neon_DropOpen = 0
EndProcedure

; ----------------------------------------------------------------------
;  Neon_MenuBarEnd - GlUIChrome.pbi:1063-1082. Draws nothing.
;
;  A click that is neither on the bar nor inside the block rectangle
;  closes the menu, and that is the only place a menu closes by itself.
; ----------------------------------------------------------------------
Procedure Neon_MenuBarEnd()
  Protected onBar.i
  Protected onDrop.i

  If Neon_MenuOpenRoot >= 0 And Neon_MouseClicked <> 0
    onBar  = Neon_Hit(Neon_MenuBarX, Neon_MenuBarY, Neon_MenuBarW, Neon_MenuBarH)
    onDrop = 0
    If Neon_MenuBlockActive <> 0
      onDrop = Neon_Hit(Neon_MenuBlockX, Neon_MenuBlockY, Neon_MenuBlockW, Neon_MenuBlockH)
    EndIf
    If onBar = 0 And onDrop = 0
      Neon_MenuCloseAll()
    EndIf
  EndIf

  Neon_MenuRootCountLastFrame = Neon_MenuRootIdx + 1
  If Neon_MenuLayoutChanged <> 0
    If Neon_MenuOpenRoot >= 0
      Neon_AnimationActive = 1
    EndIf
  EndIf
  Neon_MenuAnyOpenLastFrame = 0
  If Neon_MenuOpenRoot >= 0
    Neon_MenuAnyOpenLastFrame = 1
  EndIf
  Neon_ScissorClear()
EndProcedure


; ======================================================================
;  THE LIST - GlUIChrome.pbi:1286-1363
;
;  Begin, then one ListItem per row, then End. The row count is
;  MEASURED by the items and remembered for next frame, which is how
;  the scrollbar knows the total before the caller has said what it is.
;
;  The list reserves Neon_S(10) on its right for the scrollbar, both in
;  the scissor (:1308) and in every row's width (:1322, :1332, :1335).
; ======================================================================
Global Neon_ListID.i = 0
Global neon_listX.i = 0
Global neon_listY.i = 0
Global neon_listW.i = 0
Global neon_listH.i = 0
Global neon_listRowH.i = 0
Global neon_listRow.i = 0
Global gNeonListTop.i = 0
Global neon_listInside.i = 0

Procedure Neon_ListBegin(id.i, x.i, y.i, w.i, h.i, rowH.i)
  Protected visible.i
  Protected total.i
  Protected maxTop.i
  Protected top.i

  If rowH < 1
    rowH = 1
  EndIf
  Neon_ListID   = id
  neon_listX    = x
  neon_listY    = y
  neon_listW    = w
  neon_listH    = h
  neon_listRowH = rowH
  neon_listRow  = 0
  neon_listInside = 1

  visible = h / rowH
  total   = Neon_StateGet(#NEON_ST_ROWS, id)      ; LAST frame's count
  maxTop  = total - visible
  If maxTop < 0
    maxTop = 0
  EndIf

  top = Neon_StateGet(#NEON_ST_SCROLL, id)
  ; Three rows a notch, GlUIChrome.pbi:1300, and the wheel is consumed
  ; so nothing underneath sees it.
  If Neon_Wheel <> 0
    If Neon_Hit(x, y, w, h) <> 0
      If Neon_MenuBlocksMouse() = 0
        top = top - (Neon_Wheel * 3)
        Neon_Wheel = 0
      EndIf
    EndIf
  EndIf
  If top < 0
    top = 0
  EndIf
  If top > maxTop
    top = maxTop
  EndIf
  Neon_StateSet(#NEON_ST_SCROLL, id, top)
  gNeonListTop = top

  Neon_Box(x, y, w, h, Neon_C_ListBg)
  Neon_ScissorSet(x, y, w - Neon_S(10), h)
EndProcedure

; ----------------------------------------------------------------------
;  Neon_ListItem - GlUIChrome.pbi:1312-1353. Returns 1 on a click.
;
;  ONLY A FULLY VISIBLE ROW REGISTERS A HOT ZONE (:1327-1329), so a row
;  half over the edge cannot be the thing a hover report names.
;
;  The list uses the SMALL font (:1339) and the indent step is
;  Neon_S(14) per depth level (:1347).
; ----------------------------------------------------------------------
Procedure.i Neon_ListItem(*label, depth.i, selected.i, group.i, *detail)
  Protected idx.i
  Protected rowY.i
  Protected over.i
  Protected rowKey.i
  Protected hover.i
  Protected rowW.i
  Protected th.i
  Protected col.i

  If neon_listInside = 0
    ProcedureReturn 0
  EndIf
  idx = neon_listRow
  neon_listRow = neon_listRow + 1

  rowY = neon_listY + ((idx - gNeonListTop) * neon_listRowH)
  If (rowY + neon_listRowH) < neon_listY
    ProcedureReturn 0
  EndIf
  If rowY > (neon_listY + neon_listH)
    ProcedureReturn 0
  EndIf

  rowW = neon_listW - Neon_S(10)
  over = 0
  If Neon_Hit(neon_listX, rowY, rowW, neon_listRowH) <> 0
    If Neon_MY >= neon_listY
      If Neon_MY < (neon_listY + neon_listH)
        If Neon_MenuBlocksMouse() = 0
          over = 1
        EndIf
      EndIf
    EndIf
  EndIf

  rowKey = Neon_HotKey(10, Neon_ListID, idx)
  hover  = Neon_Animate(5, rowKey, over * 1000, 2000, 0)
  If rowY >= neon_listY
    If (rowY + neon_listRowH) <= (neon_listY + neon_listH)
      Neon_HotZone(neon_listX, rowY, rowW, neon_listRowH, rowKey)
    EndIf
  EndIf

  If selected <> 0
    Neon_Box(neon_listX, rowY, rowW, neon_listRowH, Neon_Mul3(Neon_C_Acc, 30, 30, 34))
    Neon_Box(neon_listX, rowY, Neon_S(2), neon_listRowH, Neon_C_Acc)
  ElseIf hover > 0
    ; The row hover's ALPHA is the eased hover value itself, 0..1.
    Neon_Box(neon_listX, rowY, rowW, neon_listRowH, Neon_WithAlpha(Neon_C_Head, (hover * 255) / 1000))
  EndIf

  col = Neon_C_Text
  If group <> 0
    col = Neon_C_Amb
  ElseIf selected <> 0
    col = Neon_C_Acc
  EndIf

  th = Neon_LineHeight(#NEON_FONT_SMALL)
  Neon_Text(#NEON_FONT_SMALL, neon_listX + Neon_S(8) + (depth * Neon_S(14)), rowY + ((neon_listRowH - th) / 2), *label, col)
  If *detail <> 0
    If PeekA(*detail) <> 0
      Neon_TextRight(#NEON_FONT_SMALL, neon_listX + neon_listW - Neon_S(16), rowY + ((neon_listRowH - th) / 2), *detail, Neon_C_Faint)
    EndIf
  EndIf

  If over <> 0 And Neon_MouseClicked <> 0
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

; GlUIChrome.pbi:1355-1363. The scrollbar's id is the list's + 900000
; so it cannot collide with a caller's own.
Procedure Neon_ListEnd()
  Protected visible.i
  If neon_listInside = 0
    ProcedureReturn
  EndIf
  Neon_ScissorClear()
  Neon_StateSet(#NEON_ST_ROWS, Neon_ListID, neon_listRow)
  visible = neon_listH / neon_listRowH
  ; The bar shares the list's scroll state: same key, and the bar's own
  ; id is only used for its hot zone and its drag identity.
  Neon_StateSet(#NEON_ST_SCROLL, Neon_ListID + 900000, Neon_StateGet(#NEON_ST_SCROLL, Neon_ListID))
  Neon_ScrollBarV(Neon_ListID + 900000, neon_listX + neon_listW - Neon_S(10), neon_listY, Neon_S(10), neon_listH, neon_listRow, visible)
  Neon_StateSet(#NEON_ST_SCROLL, Neon_ListID, Neon_StateGet(#NEON_ST_SCROLL, Neon_ListID + 900000))
  neon_listInside = 0
EndProcedure

Procedure.i Neon_ListTop(id.i)
  ProcedureReturn Neon_StateGet(#NEON_ST_SCROLL, id)
EndProcedure

Procedure Neon_ListSetTop(id.i, v.i)
  Neon_StateSet(#NEON_ST_SCROLL, id, v)
EndProcedure


; ======================================================================
;  THE TAB STRIP - GlUIChrome.pbi:1095-1162
;
;  Labels are one string with '|' between them, exactly as the engine
;  takes them. Returns the index of the active tab after this frame's
;  clicks; Neon_TabClosed() reports a close-box click, or -1.
;
;  The engine takes *ClosedIndex as a ninth argument and this backend
;  passes at most eight, so it is an accessor. That is the only change.
; ======================================================================
Global gNeonTabClosed.i = -1

Procedure.i Neon_TabClosed()
  ProcedureReturn gNeonTabClosed
EndProcedure

; Copy field `n` of a '|' separated list into `*out`, zero terminated.
; Returns 1 if the field existed.
Procedure.i neon_Field(*s, n.i, *out, outMax.i)
  Protected i.i
  Protected f.i
  Protected o.i
  Protected c.i
  i = 0
  f = 0
  o = 0
  If *s = 0
    PokeA(*out, 0)
    ProcedureReturn 0
  EndIf
  Repeat
    c = PeekA(*s + i)
    If c = 0
      Break
    EndIf
    If c = 124                              ; 124 is the vertical bar
      f = f + 1
      If f > n
        Break
      EndIf
    ElseIf f = n
      If o < (outMax - 1)
        PokeA(*out + o, c)
        o = o + 1
      EndIf
    EndIf
    i = i + 1
    If i > 4096
      Break
    EndIf
  ForEver
  PokeA(*out + o, 0)
  If f < n
    ProcedureReturn 0
  EndIf
  ProcedureReturn 1
EndProcedure

Procedure.i neon_CountFields(*s)
  Protected i.i
  Protected n.i
  If *s = 0
    ProcedureReturn 0
  EndIf
  If PeekA(*s) = 0
    ProcedureReturn 0
  EndIf
  n = 1
  i = 0
  Repeat
    If PeekA(*s + i) = 0
      Break
    EndIf
    If PeekA(*s + i) = 124
      n = n + 1
    EndIf
    i = i + 1
    If i > 4096
      Break
    EndIf
  ForEver
  ProcedureReturn n
EndProcedure

Global Dim neon_tabBuf.a[128]

Procedure.i Neon_TabStrip(id.i, x.i, y.i, w.i, h.i, *labels, active.i, withClose.i)
  Protected count.i
  Protected i.i
  Protected cx.i
  Protected tw.i
  Protected tabW.i
  Protected isActive.i
  Protected over.i
  Protected tabKey.i
  Protected hover.i
  Protected th.i
  Protected result.i
  Protected activeX.i
  Protected activeW.i
  Protected bx.i
  Protected by.i
  Protected onX.i
  Protected skip.i

  gNeonTabClosed = -1
  Neon_Box(x, y, w, h, Neon_C_Bg)
  Neon_Box(x, y + h - 1, w, 1, Neon_C_Line)

  count = neon_CountFields(*labels)
  If count = 0
    ProcedureReturn active
  EndIf

  result  = active
  cx      = x + Neon_S(4)
  activeX = cx
  activeW = 0
  th      = Neon_LineHeight(#NEON_FONT_UI)

  Neon_ScissorSet(x, y, w, h)

  i = 0
  While i < count
    neon_Field(*labels, i, @neon_tabBuf[0], 128)
    tw   = Neon_TextWidth(#NEON_FONT_UI, @neon_tabBuf[0])
    tabW = tw + Neon_S(26)
    If withClose <> 0
      tabW = tabW + Neon_S(18)
    EndIf
    If tabW > Neon_S(300)
      tabW = Neon_S(300)
    EndIf

    isActive = 0
    If i = active
      isActive = 1
    EndIf
    over   = Neon_Hit(cx, y, tabW, h - 1)
    tabKey = Neon_HotKey(5, id, i)
    Neon_HotZone(cx, y, tabW, h - 1, tabKey)
    hover  = Neon_Animate(2, tabKey, over * 1000, 1800, 0)

    If isActive <> 0
      activeX = cx
      activeW = tabW
      Neon_Box(cx, y, tabW, h - 1, Neon_C_Panel)
      Neon_Box(cx, y, 1, h - 1, Neon_C_Line)
      Neon_Box(cx + tabW - 1, y, 1, h - 1, Neon_C_Line)
      Neon_Text(#NEON_FONT_UI, cx + Neon_S(12), y + ((h - th) / 2), @neon_tabBuf[0], Neon_C_Text)
    Else
      If hover > 0
        ; alpha IS the hover value, GlUIChrome.pbi:1133
        Neon_Box(cx, y + 2, tabW, h - 3, Neon_WithAlpha(Neon_C_Head, (hover * 255) / 1000))
      EndIf
      Neon_Text(#NEON_FONT_UI, cx + Neon_S(12), y + ((h - th) / 2), @neon_tabBuf[0], Neon_C_Dim)
    EndIf

    skip = 0
    If withClose <> 0
      bx = cx + tabW - 17                    ; unscaled, GlUIChrome.pbi:1139
      by = y + ((h - 14) / 2)                ; unscaled, :1140
      onX = Neon_Hit(bx - 2, by - 2, 18, 18)
      Neon_HotZone(bx - 2, by - 2, 18, 18, Neon_HotKey(6, id, i))
      If onX <> 0
        Neon_Box(bx - 2, by - 2, 18, 18, Neon_Mul3(Neon_C_Red, 50, 35, 35))
      EndIf
      Neon_Text(#NEON_FONT_SMALL, bx, by - 1, "x", Neon_C_Dim)
      If onX <> 0 And Neon_MouseClicked <> 0
        gNeonTabClosed = i
        skip = 1                             ; close beats select, :1147
      EndIf
    EndIf

    If skip = 0
      If over <> 0 And Neon_MouseClicked <> 0
        result = i
      EndIf
    EndIf

    cx = cx + tabW
    i = i + 1
  Wend

  If activeW > 0
    ; The underline slides. speed 22.0, and its initial is the current
    ; value so it does not fly in from zero on the first frame.
    activeX = Neon_Animate(3, Neon_HotKey(5, id, 30000), activeX, 2200, activeX)
    activeW = Neon_Animate(4, Neon_HotKey(5, id, 30001), activeW, 2200, activeW)
    Neon_Box(activeX, y, activeW, 2, Neon_C_Acc)
  EndIf

  Neon_ScissorClear()
  ProcedureReturn result
EndProcedure


; ======================================================================
;  THE TEXT FIELD - GlUIChrome.pbi:1173-1263
;
;  `*text` is a caller-owned, zero-terminated byte buffer of `bufMax`
;  bytes and the widget EDITS IT IN PLACE. The engine takes a
;  host-language string by reference; a bare-metal port has no such thing
;  and a buffer plus a length is the honest equivalent.
;
;  Returns 1 when Return was pressed.
;
;  The caret index lives in this file's state table under
;  #NEON_ST_CARET, keyed by the field's id.
; ======================================================================

Procedure.i neon_StrLen(*s)
  Protected i.i
  i = 0
  If *s = 0
    ProcedureReturn 0
  EndIf
  While PeekA(*s + i) <> 0
    i = i + 1
    If i > 4096
      Break
    EndIf
  Wend
  ProcedureReturn i
EndProcedure

; Delete one byte at `at`. The buffer is zero terminated and shrinks.
Procedure neon_StrDelete(*s, at.i)
  Protected n.i
  Protected i.i
  n = neon_StrLen(*s)
  If at < 0 Or at >= n
    ProcedureReturn
  EndIf
  i = at
  While i < n
    PokeA(*s + i, PeekA(*s + i + 1))
    i = i + 1
  Wend
EndProcedure

; Insert one byte at `at`, if it fits. Returns 1 if it went in.
Procedure.i neon_StrInsert(*s, at.i, ch.i, bufMax.i)
  Protected n.i
  Protected i.i
  n = neon_StrLen(*s)
  If (n + 1) >= bufMax
    ProcedureReturn 0
  EndIf
  If at < 0
    at = 0
  EndIf
  If at > n
    at = n
  EndIf
  i = n
  While i >= at
    PokeA(*s + i + 1, PeekA(*s + i))
    If i = 0
      Break
    EndIf
    i = i - 1
  Wend
  PokeA(*s + at, ch)
  ProcedureReturn 1
EndProcedure

Global Dim neon_caretBuf.a[512]

Procedure.i Neon_TextInput(id.i, x.i, y.i, w.i, h.i, *text, bufMax.i, *placeholder)
  Protected focused.i
  Protected over.i
  Protected caret.i
  Protected n.i
  Protected submitted.i
  Protected th.i
  Protected ty.i
  Protected cw.i
  Protected i.i

  focused = 0
  If Neon_FocusID = id
    focused = 1
  EndIf
  over = Neon_Hit(x, y, w, h)
  Neon_HotZone(x, y, w, h, Neon_HotKey(9, id, 0))
  If Neon_MouseClicked <> 0
    If over <> 0
      Neon_FocusID = id
      focused = 1
    ElseIf focused <> 0
      Neon_FocusID = 0
      focused = 0
    EndIf
  EndIf

  n = neon_StrLen(*text)
  caret = Neon_StateGet(#NEON_ST_CARET, id)
  If caret < 0
    caret = 0
  EndIf
  If caret > n
    caret = n
  EndIf
  submitted = 0

  If focused <> 0
    ; The blink. The engine advances a float phase at 3.4 rad/s and
    ; tests Sin(phase) > -0.2; here the phase is milliradians and the
    ; test is done on a triangle wave, which blinks at the same rate
    ; with the same asymmetric duty and needs no Sin().
    Neon_CaretPhase = Neon_CaretPhase + ((Neon_DeltaMs * 3400) / 1000)
    If Neon_CaretPhase > 6283
      Neon_CaretPhase = Neon_CaretPhase - 6283
    EndIf

    If Neon_KeyCode = #NEON_KEY_BACK
      If caret > 0
        neon_StrDelete(*text, caret - 1)
        caret = caret - 1
      EndIf
      Neon_KeyCode = 0
    ElseIf Neon_KeyCode = #NEON_KEY_DELETE
      If caret < n
        neon_StrDelete(*text, caret)
      EndIf
      Neon_KeyCode = 0
    ElseIf Neon_KeyCode = #NEON_KEY_LEFT
      If caret > 0
        caret = caret - 1
      EndIf
      Neon_KeyCode = 0
    ElseIf Neon_KeyCode = #NEON_KEY_RIGHT
      If caret < n
        caret = caret + 1
      EndIf
      Neon_KeyCode = 0
    ElseIf Neon_KeyCode = #NEON_KEY_HOME
      caret = 0
      Neon_KeyCode = 0
    ElseIf Neon_KeyCode = #NEON_KEY_END
      caret = neon_StrLen(*text)
      Neon_KeyCode = 0
    ElseIf Neon_KeyCode = #NEON_KEY_RETURN
      submitted = 1
      Neon_KeyCode = 0
    ElseIf Neon_KeyCode = #NEON_KEY_ESCAPE
      Neon_FocusID = 0
      focused = 0
      Neon_KeyCode = 0
    EndIf

    If Neon_KeyChar >= 32 And Neon_KeyChar <> 127
      If neon_StrInsert(*text, caret, Neon_KeyChar, bufMax) <> 0
        caret = caret + 1
      EndIf
      Neon_KeyChar = 0
      Neon_CaretPhase = 0                    ; typing restarts the blink
    EndIf
  EndIf
  Neon_StateSet(#NEON_ST_CARET, id, caret)

  Neon_Box(x, y, w, h, Neon_C_Field)
  If focused <> 0
    Neon_Frame(x, y, w, h, Neon_C_Acc)
  ElseIf over <> 0
    Neon_Frame(x, y, w, h, Neon_C_Dim)
  Else
    Neon_Frame(x, y, w, h, Neon_C_Line)
  EndIf

  th = Neon_LineHeight(#NEON_FONT_UI)
  ty = y + ((h - th) / 2)
  Neon_ScissorSet(x + 1, y + 1, w - 2, h - 2)
  If neon_StrLen(*text) = 0 And focused = 0
    Neon_Text(#NEON_FONT_UI, x + Neon_S(8), ty, *placeholder, Neon_C_Faint)
  Else
    Neon_Text(#NEON_FONT_UI, x + Neon_S(8), ty, *text, Neon_C_Text)
  EndIf

  ; The caret. On for roughly the same fraction of the cycle the
  ; engine's Sin(phase) > -0.2 gives - about 63 percent - taken here as
  ; the first 3950 of 6283 milliradians.
  If focused <> 0
    If Neon_CaretPhase < 3950
      i = 0
      While i < caret
        neon_caretBuf[i] = PeekA(*text + i)
        i = i + 1
        If i >= 511
          Break
        EndIf
      Wend
      neon_caretBuf[i] = 0
      cw = Neon_TextWidth(#NEON_FONT_UI, @neon_caretBuf[0])
      Neon_Box(x + Neon_S(8) + cw, ty, Neon_S(2), th, Neon_C_Acc)
    EndIf
  EndIf
  Neon_ScissorClear()

  ProcedureReturn submitted
EndProcedure

Procedure.i Neon_CaretPos(id.i)
  ProcedureReturn Neon_StateGet(#NEON_ST_CARET, id)
EndProcedure
