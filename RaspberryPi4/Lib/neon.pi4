EndProcedure

; Install one complete lifecycle family. The callback ABI is deliberately
; small: Init(), Begin(colour), End(), Shutdown(). The external owner may
; use its own prepared Vulkan/display resources; Neon only dispatches the
; established public calls and never claims native V3D ownership for it.
Procedure.i NeonLifecycleInstall(initProc.i, beginProc.i, endProc.i, shutdownProc.i)
  If gNeonReady <> 0 Or neon_inFrame <> 0 Or v3d_owner <> 0
    neon_err = #NEON_ERR_BACKEND
    ProcedureReturn #NEON_ERR_BACKEND
  EndIf
  If initProc = 0 Or beginProc = 0 Or endProc = 0 Or shutdownProc = 0
    neon_err = #NEON_ERR_ARGS
    ProcedureReturn #NEON_ERR_ARGS
  EndIf
  gNeonLifecycleInit = initProc
  gNeonLifecycleBegin = beginProc
  gNeonLifecycleEnd = endProc
  gNeonLifecycleShutdown = shutdownProc
  gNeonLifecycleError = #NEON_OK
  gNeonLifecycleMode = #NEON_BACKEND_EXTERNAL
  ProcedureReturn #NEON_OK
EndProcedure

Procedure.i NeonLifecycleUseNative()
  If gNeonReady <> 0 Or neon_inFrame <> 0 Or v3d_owner <> 0
    neon_err = #NEON_ERR_BACKEND
    ProcedureReturn #NEON_ERR_BACKEND
  EndIf
  gNeonLifecycleInit = @neon_LifecycleInitUnbound
  gNeonLifecycleBegin = @neon_LifecycleBeginUnbound
  gNeonLifecycleEnd = @neon_LifecycleEndUnbound
  gNeonLifecycleShutdown = @neon_LifecycleShutdownUnbound
  gNeonLifecycleError = #NEON_OK
  gNeonLifecycleMode = #NEON_BACKEND_NATIVE
  ProcedureReturn #NEON_OK
EndProcedure

Procedure.i NeonLifecycleBackend()
  ProcedureReturn gNeonLifecycleMode
EndProcedure

