; ======================================================================
;  led_act.pi4 - the Raspberry Pi 5 ACT (green status) LED. BCM2712 ONLY
;  (-t pi5, #PMF_CHIP = 2712).
;
;  THE FACTS (vault "Raspberry Pi 5/Sources", raspberrypi/linux
;  7e030b60792de1c15b9ec1d8d5d34d63f0f0f1d8):
;    bcm2712-rpi-5-b.dts   led_act: gpios = <&gio_aon 9 GPIO_ACTIVE_LOW>,
;                          label "ACT", default-state "off"; gio_aon line
;                          name AON_GPIO_09 "2712_STAT_LED". No pinctrl on
;                          the node: Linux drives it with the pin as the
;                          firmware left it, and so does this file.
;    bcm2712-rpi.dtsi      alias gpio2 = &gio_aon; gpiomem2 reg
;                          <0x7d517c00 0x40>; the compiled DTBs in
;                          "Boot staging" (C1 and D0) both carry
;                          gpio@7d517c00. Through the /soc ranges that is
;                          CPU $107D517C00 (the translation that puts gio
;                          at $107D508500 and the PL011 at $107D001000).
;    gpio-brcmstb.c        the block's registers - NOT restated here: every
;                          gio/gio_aon access is RaspberryPi4/Lib/gio.pi4's
;                          (rule 30), and this file names the pin only.
;
;  ACTIVE LOW: DATA bit 9 = 0 is LIT. gio.pi4 writes bit 9 alone:
;  gio_aon also carries RP1_RUN, SD power and the PMIC interrupt, and the
;  firmware watches that bank (the DTS deletes gio_aon's
;  interrupt-controller for exactly that reason).
;
;  ORDER: value, then direction - the LED is set OFF before the pin
;  becomes an output, so taking the pin never flashes it.
;
;  THE RED PWR LED is here too, below - RP1 GPIO44, active low (dts
;  led_pwr), in RP1 IO bank 2, driven through RaspberryPi4/Lib/gpio_rp1.pi4
;  (banks 1 and 2 since Anvil d4fb13c). Same shape as the ACT LED, no copy
;  of any GPIO encoding. Library level only: no seam until the owner rules
;  on the status-LED seam (vault morning list 2026-09-27, item 6).
;
;  WHAT IS NOT HERE, AND WHY. The power button: a press while the board is
;  off, and a long press, are the PMIC's and the firmware's; the running
;  system sees it as gio GPIO20, active low, pull-up (dts pwr_button
;  gpio-keys, KEY_POWER). Its read is gio.pi4's GioPwrButton(), not wired
;  to anything until the seam ruling (see the vault note).
;
;  NOT VERIFIED ON A Pi 5. Desk-proven (tools/a64/led_act_check.py).
;  REQUIRES: RaspberryPi4/Lib/gio.pi4 (the ACT LED's block) and
;  RaspberryPi4/Lib/gpio_rp1.pi4 (the PWR LED), both included before this.
; ======================================================================

CompilerIf #PMF_CHIP <> 2712
led_act_is_the_BCM2712_ACT_LED_build_with_t_pi5()
CompilerEndIf

#LED_ACT_PIN = 9                   ; gio_aon AON_GPIO_09 (#GIO_AON)

#LED_ACT_OK    = 0
#LED_ACT_STATE = -5                ; not begun
#LED_ACT_STUCK = -9                ; the readback disagrees with the write

Global led_act_on.i
Global led_act_begun.i

; 1 when the readback says the pin is an output.
Procedure.i LedActIsOutput()
  If GioIsOutput(#GIO_AON, #LED_ACT_PIN) = 1
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

; The level being DRIVEN, as lit (1) or dark (0) - active low undone here.
Procedure.i LedActLit()
  If GioRead(#GIO_AON, #LED_ACT_PIN) = 0
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

; Take the pin: an output driving HIGH (dark) - gio.pi4 sets the value
; before the direction, so taking it never flashes the LED.
Procedure.i LedActBegin()
  GioOutput(#GIO_AON, #LED_ACT_PIN, 1)
  If LedActIsOutput() = 0 Or LedActLit() <> 0
    led_act_begun = 0
    ProcedureReturn #LED_ACT_STUCK
  EndIf
  led_act_on = 0
  led_act_begun = 1
  ProcedureReturn #LED_ACT_OK
EndProcedure

; LedActSet(on) - 1 lit, 0 dark. Read back, and refuse by name if the
; level did not follow.
Procedure.i LedActSet(on.i)
  If led_act_begun = 0
    ProcedureReturn #LED_ACT_STATE
  EndIf
  If on <> 0
    on = 1
    GioWrite(#GIO_AON, #LED_ACT_PIN, 0)
  Else
    GioWrite(#GIO_AON, #LED_ACT_PIN, 1)
  EndIf
  If LedActLit() <> on
    ProcedureReturn #LED_ACT_STUCK
  EndIf
  led_act_on = on
  ProcedureReturn #LED_ACT_OK
EndProcedure

Procedure.i LedActToggle()
  ProcedureReturn LedActSet(1 - led_act_on)
EndProcedure

; ======================================================================
;  THE PWR LED - RP1 GPIO44, ACTIVE LOW.
;  bcm2712-rpi-5-b.dts led_pwr: gpios = <&rp1_gpio 44 GPIO_ACTIVE_LOW>,
;  label "PWR"; pinctrl-rp1.c PIN(44, ..., gpio, ...) - plain GPIO is
;  FUNCSEL 5 (#RP1_FUNCSEL_GPIO). The pin is gpio_rp1.pi4's
;  #RP1_GPIO_PWR_LED; every register touch is gpio_rp1.pi4's.
;
;  LIT IS READ FROM THE PAD (RIO_IN), not from what was written, so a pin
;  that did not follow is refused by name. Order as the ACT LED: the level
;  (high = dark) is set BEFORE the pin becomes a GPIO output, so taking
;  it never flashes the LED. Returns the #LED_ACT_* codes.
; ======================================================================
Global led_pwr_on.i
Global led_pwr_begun.i

Procedure.i LedPwrIsOutput()
  If Rp1FuncSelGet(#RP1_GPIO_PWR_LED) = #RP1_FUNCSEL_GPIO And Rp1PinModeGet(#RP1_GPIO_PWR_LED) = 1
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

Procedure.i LedPwrLit()
  If Rp1DigitalRead(#RP1_GPIO_PWR_LED) = #RP1_PIN_LOW
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

Procedure.i LedPwrBegin()
  led_pwr_begun = 0
  If Rp1DigitalWrite(#RP1_GPIO_PWR_LED, #RP1_PIN_HIGH) = 0
    ProcedureReturn #LED_ACT_STUCK
  EndIf
  If Rp1PinOutput(#RP1_GPIO_PWR_LED) = 0
    ProcedureReturn #LED_ACT_STUCK
  EndIf
  If LedPwrIsOutput() = 0 Or LedPwrLit() <> 0
    ProcedureReturn #LED_ACT_STUCK
  EndIf
  led_pwr_on = 0
  led_pwr_begun = 1
  ProcedureReturn #LED_ACT_OK
EndProcedure

Procedure.i LedPwrSet(on.i)
  If led_pwr_begun = 0
    ProcedureReturn #LED_ACT_STATE
  EndIf
  If on <> 0
    on = 1
    Rp1DigitalWrite(#RP1_GPIO_PWR_LED, #RP1_PIN_LOW)
  Else
    Rp1DigitalWrite(#RP1_GPIO_PWR_LED, #RP1_PIN_HIGH)
  EndIf
  If LedPwrLit() <> on
    ProcedureReturn #LED_ACT_STUCK
  EndIf
  led_pwr_on = on
  ProcedureReturn #LED_ACT_OK
EndProcedure

Procedure.i LedPwrToggle()
  ProcedureReturn LedPwrSet(1 - led_pwr_on)
EndProcedure
