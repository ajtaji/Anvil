; ======================================================================
;  led_act.pi4 - the Raspberry Pi 5 ACT (green status) LED. BCM2712 ONLY
;  (-t pi5, #PMF_CHIP = 2712).
;
;  THE FACTS (vault "Raspberry Pi 5/Sources", raspberrypi/linux
;  7e030b60792de1c15b9ec1d8d5d34d63f0f0f1d8):
;    bcm2712-rpi-5-b.dts   led_act: gpios = <&gio_aon 9 GPIO_ACTIVE_LOW>,
;                          label "ACT", default-state "off"; gio_aon line
;                          name AON_GPIO_09 "2712_STAT_LED". No pinctrl on
;                          the node: Linux drives it with the pin as the
;                          firmware left it, and so does this file.
;    bcm2712-rpi.dtsi      alias gpio2 = &gio_aon; gpiomem2 reg
;                          <0x7d517c00 0x40>; the compiled DTBs in
;                          "Boot staging" (C1 and D0) both carry
;                          gpio@7d517c00. Through the /soc ranges that is
;                          CPU $107D517C00 (the translation that puts gio
;                          at $107D508500 and the PL011 at $107D001000).
;    gpio-brcmstb.c        eight registers per bank, DATA +$04, IODIR +$08,
;                          IODIR 1 = input. Those two OFFSETS are NOT
;                          restated here: they are RaspberryPi4/Lib/
;                          sdio.pi4's #SDIO_GIO_DATA / #SDIO_GIO_IODIR, the
;                          one definition in this tree (the Wi-Fi lane's
;                          WL_ON on the main gio). Only the AON base is new.
;
;  ACTIVE LOW: DATA bit 9 = 0 is LIT. Every write is a read-modify-write of
;  bit 9 alone: gio_aon also carries RP1_RUN, SD power and the PMIC
;  interrupt, and the firmware watches that bank (the DTS deletes
;  gio_aon's interrupt-controller for exactly that reason).
;
;  ORDER: value, then direction - the LED is set OFF before the pin
;  becomes an output, so taking the pin never flashes it.
;
;  WHAT IS NOT HERE, AND WHY. The red PWR LED is RP1 GPIO44, active low
;  (dts led_pwr) - RP1 bank 1, which RaspberryPi4/Lib/gpio_rp1.pi4 does
;  not implement yet. The power button is NOT a GPIO this monitor owns: a
;  press while the board is off, and a long press, are the PMIC's and the
;  firmware's; the running system sees it as gio GPIO20, active low,
;  pull-up (dts pwr_button gpio-keys, KEY_POWER), and its pull is set by
;  the stepping-dependent main pinctrl. Reading it is left for the seam
;  ruling (see the vault note).
;
;  NOT VERIFIED ON A Pi 5. Desk-proven (tools/a64/led_act_check.py).
;  REQUIRES: RaspberryPi4/Lib/sdio.pi4 (the two gio offsets).
; ======================================================================

CompilerIf #PMF_CHIP <> 2712
led_act_is_the_BCM2712_ACT_LED_build_with_t_pi5()
CompilerEndIf

#LED_ACT_AON_BASE = $107D517C00    ; gio_aon, gpio@7d517c00
#LED_ACT_BIT      = 1 << 9         ; AON_GPIO_09, bank 0

#LED_ACT_OK    = 0
#LED_ACT_STATE = -5                ; not begun
#LED_ACT_STUCK = -9                ; the readback disagrees with the write

Global led_act_on.i
Global led_act_begun.i

; 1 when the readback says bit 9 is an output (IODIR 0).
Procedure.i LedActIsOutput()
  If (PeekN(#LED_ACT_AON_BASE + #SDIO_GIO_IODIR) & #LED_ACT_BIT) = 0
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

; The level being DRIVEN, as lit (1) or dark (0) - active low undone here.
Procedure.i LedActLit()
  If (PeekN(#LED_ACT_AON_BASE + #SDIO_GIO_DATA) & #LED_ACT_BIT) = 0
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

; Take the pin: DATA bit 9 high (dark), then IODIR bit 9 = output.
Procedure.i LedActBegin()
  Define v.i
  v = PeekN(#LED_ACT_AON_BASE + #SDIO_GIO_DATA)
  PokeL(#LED_ACT_AON_BASE + #SDIO_GIO_DATA, v | #LED_ACT_BIT)
  v = PeekN(#LED_ACT_AON_BASE + #SDIO_GIO_IODIR)
  PokeL(#LED_ACT_AON_BASE + #SDIO_GIO_IODIR, v & (~#LED_ACT_BIT))
  If LedActIsOutput() = 0 Or LedActLit() <> 0
    led_act_begun = 0
    ProcedureReturn #LED_ACT_STUCK
  EndIf
  led_act_on = 0
  led_act_begun = 1
  ProcedureReturn #LED_ACT_OK
EndProcedure

; LedActSet(on) - 1 lit, 0 dark. Read back, and refuse by name if the
; level did not follow.
Procedure.i LedActSet(on.i)
  Define v.i
  If led_act_begun = 0
    ProcedureReturn #LED_ACT_STATE
  EndIf
  v = PeekN(#LED_ACT_AON_BASE + #SDIO_GIO_DATA)
  If on <> 0
    v = v & (~#LED_ACT_BIT)
  Else
    v = v | #LED_ACT_BIT
  EndIf
  PokeL(#LED_ACT_AON_BASE + #SDIO_GIO_DATA, v)
  If on <> 0
    on = 1
  EndIf
  If LedActLit() <> on
    ProcedureReturn #LED_ACT_STUCK
  EndIf
  led_act_on = on
  ProcedureReturn #LED_ACT_OK
EndProcedure

Procedure.i LedActToggle()
  ProcedureReturn LedActSet(1 - led_act_on)
EndProcedure
