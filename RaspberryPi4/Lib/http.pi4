; Bounded monitor HTTP facade over the shared URL and streaming response code.
; GET/HEAD, one connection per call. Redirects are exposed to the caller.
; Content-Encoding is requested as identity; returned body bytes are not
; content-decoded. A finite caller buffer reports explicit truncation.
XIncludeFile "Anvil/Network/web_url.pbi"
XIncludeFile "Anvil/Network/web_response.pbi"
XIncludeFile "Anvil/Network/web_request.pbi"

#HTTP_PORT_DEFAULT = 80

; Sizes. The request line and headers are built in one buffer; the
; response's status line and each header line are assembled in another,
; one byte at a time, because a header can be split across any number of
; TCP segments and reassembling it at the byte is the only way that
; cannot be wrong.
#HTTP_REQ_MAX   = 512
#HTTP_LINE_MAX  = 4096
#HTTP_HOST_MAX  = 128
#HTTP_PATH_MAX  = 192
#HTTP_LOC_MAX   = 256
#HTTP_RXCHUNK   = 512

; Deadlines. Every one of them is a WHOLE-PHASE budget measured from the
; start of that phase, not a per-byte one: a server that dribbles a byte
; a second is a server this monitor should give up on, and a per-byte
; timer never would.
#HTTP_CONNECT_MS = 10000
#HTTP_SEND_MS    = 10000
#HTTP_RESP_MS    = 20000
#HTTP_SLICE_MS   = 5

; The framing decision (RFC 9112 6.3).
#HTTP_FRAME_NONE    = 0    ; no body by status or by method
#HTTP_FRAME_LENGTH  = 1    ; Content-Length
#HTTP_FRAME_CHUNKED = 2    ; Transfer-Encoding: chunked
#HTTP_FRAME_CLOSE   = 3    ; until the connection closes

; The parser's state.
#HTTP_ST_IDLE     = 0
#HTTP_ST_STATUS   = 1
#HTTP_ST_HEADERS  = 2
#HTTP_ST_BODY_LEN = 3
#HTTP_ST_BODY_CHK = 4
#HTTP_ST_CHUNKSZ  = 5
#HTTP_ST_CHUNKEND = 6
#HTTP_ST_BODY_EOF = 7
#HTTP_ST_DONE     = 8

; Refusals. Negative, numbered from -400 so they cannot be confused with
; tcp.pi4's -300s or net.pi4's -100s, and every one has a full sentence
; in HttpErrorText() that carries the number.
#HTTP_OK            =    0
#HTTP_E_ARG         = -400
#HTTP_E_URL         = -401  ; not a URL this can parse
#HTTP_E_SCHEME      = -402  ; https, or something that is not http
#HTTP_E_LONG        = -403  ; the host or path is longer than the buffer
#HTTP_E_NOSOCK      = -404  ; no free TCP socket
#HTTP_E_CONNECT     = -405  ; the connection was never established
#HTTP_E_RESET       = -406  ; the peer reset it
#HTTP_E_SEND        = -407  ; the request could not be pushed out in time
#HTTP_E_TIMEOUT     = -408  ; no response in time
#HTTP_E_CLOSED      = -409  ; the peer closed before the message finished
#HTTP_E_STATUS      = -410  ; the status line is not HTTP/x.y NNN
#HTTP_E_FRAMING     = -411  ; chunked AND Content-Length. Refused.
#HTTP_E_CHUNK       = -412  ; a chunk size that is not hexadecimal
#HTTP_E_TRUNC       = -413  ; SOFT: everything parsed, body was cut short

Global Dim http_req.a[#HTTP_REQ_MAX]
Global http_reqlen.i
Global http_reqover.i

Global Dim http_line.a[#HTTP_LINE_MAX]
Global http_linelen.i
Global http_lineover.i

Global Dim http_host.a[#HTTP_HOST_MAX]
Global http_hostlen.i
Global Dim http_path.a[#HTTP_PATH_MAX]
Global http_pathlen.i
Global Dim http_loc.a[#HTTP_LOC_MAX]
Global http_loclen.i
Global http_locover.i

Global http_state.i
Global http_status.i
Global http_framing.i
Global http_clen.i            ; the Content-Length that was announced
Global http_haveclen.i
Global http_chunked.i
Global http_headonly.i
Global http_hdrcount.i
Global http_hdrdropped.i      ; header lines too long to parse. NOT
                              ; truncated and NOT guessed at - counted.
Global http_err.i
Global http_tcperr.i
Global http_truncated.i
Global http_sock.i = -1
Global http_port.i = #HTTP_PORT_DEFAULT
Global http_ip.i

Global http_dst.i             ; the caller's body buffer
Global http_dstmax.i
Global http_bodylen.i         ; bytes KEPT
Global http_bodyseen.i        ; bytes that ARRIVED
Global http_chunkleft.i
Global http_chunkhex.i
Global http_chunkdigits.i
Global http_requests.i
Global http_oks.i
Global http_rxbytes.i         ; every byte TcpRead handed over

Global Dim http_rx.a[#HTTP_RXCHUNK]
Global Dim http_decoded.a[#HTTP_RXCHUNK]
Global Dim http_headers.a[#WEB_RESPONSE_MAX_METADATA]
Global http_request.WebRequest
Global http_response.WebResponse
Global http_url.WebUrl

Procedure.i http_Broke()

  ProcedureReturn NetBreakCheck()

EndProcedure

Procedure http_ReqReset()
  http_reqlen = 0
  http_reqover = 0
EndProcedure

Procedure http_ReqPutC(c.i)
  If http_reqlen >= #HTTP_REQ_MAX
    http_reqover = 1
    ProcedureReturn
  EndIf
  http_req[http_reqlen] = c & $FF
  http_reqlen = http_reqlen + 1
EndProcedure

Procedure http_ReqPut(s.i)
  Define i.i
  Define c.i
  i = 0
  While 1 = 1
    c = PeekA(s + i) & $FF
    If c = 0
      Break
    EndIf
    http_ReqPutC(c)
    i = i + 1
  Wend
EndProcedure

Procedure http_ReqPutBytes(p.i, n.i)
  Define i.i
  i = 0
  While i < n
    http_ReqPutC(PeekA(p + i) & $FF)
    i = i + 1
  Wend
EndProcedure

Procedure http_ReqCrLf()
  http_ReqPutC(13)
  http_ReqPutC(10)
EndProcedure

; ----------------------------------------------------------------------
;  HttpParseUrl - "http://host[:port]/path" into the three parts.
;
;  IT IS DELIBERATELY NARROW. No userinfo, no query-string handling
;  beyond passing it through as part of the path, no percent-decoding, no
;  IPv6 literal in brackets. Each of those is refused or passed through
;  whole rather than half-understood.
;
;  AN https URL IS ITS OWN REFUSAL (#HTTP_E_SCHEME). Fetching it over
;  port 80 because the port is what we know how to do would answer a
;  different question from the one asked, and on a URL somebody chose
;  https for.
; ----------------------------------------------------------------------
Procedure.i HttpParseUrl(url.i)
  Define n.i,rc.i
  http_hostlen=0 : http_pathlen=0 : http_port=#HTTP_PORT_DEFAULT
  If url=0 : ProcedureReturn #HTTP_E_ARG : EndIf
  While n<=#WEB_URL_LIMIT
    If PeekA(url+n)=0 : Break : EndIf
    n=n+1
  Wend
  If n>#WEB_URL_LIMIT : ProcedureReturn #HTTP_E_LONG : EndIf
  http_url\host=@http_host[0] : http_url\hostCapacity=#HTTP_HOST_MAX
  http_url\target=@http_path[0] : http_url\targetCapacity=#HTTP_PATH_MAX
  rc=WebUrlParse(url,n,0,@http_url)
  If rc=#WEB_URL_CAPACITY : ProcedureReturn #HTTP_E_LONG : EndIf
  If rc=#WEB_URL_SCHEME : ProcedureReturn #HTTP_E_SCHEME : EndIf
  If rc<0 : ProcedureReturn #HTTP_E_URL : EndIf
  If http_url\secure<>0 : ProcedureReturn #HTTP_E_SCHEME : EndIf
  http_hostlen=http_url\hostLength : http_pathlen=http_url\targetLength
  http_port=http_url\port
  ProcedureReturn #HTTP_OK
EndProcedure

Procedure.i HttpHost()
  ProcedureReturn @http_host[0]
EndProcedure

Procedure.i HttpHostLen()
  ProcedureReturn http_hostlen
EndProcedure

Procedure.i HttpPath()
  ProcedureReturn @http_path[0]
EndProcedure

Procedure.i HttpPathLen()
  ProcedureReturn http_pathlen
EndProcedure

Procedure.i HttpUrlPort()
  ProcedureReturn http_port
EndProcedure

Procedure http_ResponseMetadata()
  Define rc.i
  http_status=http_response\status
  http_haveclen=http_response\haveLength : http_clen=http_response\contentLength
  http_chunked=http_response\chunked
  If http_status>=200 And http_response\state<>#WEB_RESPONSE_HEADERS
    http_hdrcount=WebResponseHeaderCount(@http_response)
    rc=WebResponseHeader(@http_response,"location",0,@http_loc[0],#HTTP_LOC_MAX)
    If rc>=0 : http_loclen=rc : EndIf
    If rc=#WEB_RESPONSE_LIMIT : http_locover=1 : EndIf
    If http_headonly Or http_status=204 Or http_status=304
      http_framing=#HTTP_FRAME_NONE
    ElseIf http_chunked
      http_framing=#HTTP_FRAME_CHUNKED
    ElseIf http_haveclen
      http_framing=#HTTP_FRAME_LENGTH
    Else
      http_framing=#HTTP_FRAME_CLOSE
    EndIf
  EndIf
  If http_response\state=#WEB_RESPONSE_DONE : http_state=#HTTP_ST_DONE : EndIf
EndProcedure

Procedure http_Reset(dst.i, maxlen.i)
  http_state = #HTTP_ST_IDLE
  http_status = 0
  http_framing = #HTTP_FRAME_NONE
  http_clen = 0
  http_haveclen = 0
  http_chunked = 0
  http_hdrcount = 0
  http_hdrdropped = 0
  http_err = #HTTP_OK
  http_tcperr = 0
  http_truncated = 0
  http_bodylen = 0
  http_bodyseen = 0
  http_rxbytes = 0
  http_chunkleft = 0
  http_chunkhex = 0
  http_chunkdigits = 0
  http_loclen = 0
  http_locover = 0
  http_loc[0] = 0
  http_dst = dst
  http_dstmax = maxlen
  http_err=WebResponseInit(@http_response,@http_line[0],#HTTP_LINE_MAX,@http_headers[0],#WEB_RESPONSE_MAX_METADATA,http_headonly)
  http_ReqReset()
EndProcedure

; THE ROUTE IS RESOLVED HERE AND THE INTERFACE IS PASSED DOWN. TCP
; latches the interface with the rest of the peer, so it has to be told
; which one - and the destination is what decides it, on a board holding
; an address on a cable and another on a radio at once. NONE means no
; interface can reach this host at all, which is a connect failure and
; not an ARP wait.
Procedure.i http_Connect(ip.i, port.i)
  Define t0.i
  Define rc.i
  Define k.i
  k = NetIfForDest(ip)
  If k = #HW_LINK_NONE
    http_tcperr = #NET_TCP_E_ROUTE
    ProcedureReturn #HTTP_E_CONNECT
  EndIf
  t0 = millis()
  While 1 = 1
    If TcpState() = #TCP_CLOSED
      rc = TcpConnect(k, ip, port)
      If rc <> #NET_TCP_OK
        If rc <> #NET_TCP_E_ARP
          http_tcperr = rc
          ProcedureReturn #HTTP_E_CONNECT
        EndIf
      EndIf
    EndIf
    TcpPoll(#HTTP_SLICE_MS)
    If TcpState() = #TCP_ESTABLISHED
      ProcedureReturn #HTTP_OK
    EndIf
    If TcpWasReset() <> 0
      http_tcperr = TcpError()
      ProcedureReturn #HTTP_E_RESET
    EndIf
    If TcpError() <> 0
      If TcpState() = #TCP_CLOSED
        http_tcperr = TcpError()
        ProcedureReturn #HTTP_E_CONNECT
      EndIf
    EndIf
    If http_Broke() <> 0
      ProcedureReturn #HTTP_E_CONNECT
    EndIf
    If (millis() - t0) > #HTTP_CONNECT_MS
      ProcedureReturn #HTTP_E_CONNECT
    EndIf
  Wend
  ProcedureReturn #HTTP_E_CONNECT
EndProcedure

; TcpSend's short return is documented and is NOT an error, so this
; loops on it within the fixed send-phase deadline.
Procedure.i http_SendAll(src.i, len.i)
  Define off.i
  Define k.i
  Define t0.i
  off = 0
  t0 = millis()
  While off < len
    k = TcpSend(src + off, len - off)
    If k > 0
      off = off + k
    EndIf
    TcpPoll(#HTTP_SLICE_MS)
    If TcpWasReset() <> 0
      http_tcperr = TcpError()
      ProcedureReturn #HTTP_E_RESET
    EndIf
    If TcpState() = #TCP_CLOSED
      http_tcperr = TcpError()
      ProcedureReturn #HTTP_E_SEND
    EndIf
    If http_Broke() <> 0
      ProcedureReturn #HTTP_E_SEND
    EndIf
    If (millis() - t0) > #HTTP_SEND_MS
      ProcedureReturn #HTTP_E_SEND
    EndIf
  Wend
  ProcedureReturn #HTTP_OK
EndProcedure

Procedure.i http_ReadResponse()
  Define t0.i,n.i,i.i,rc.i,st.i,offset.i
  t0=millis() : http_state=#HTTP_ST_STATUS
  While 1=1
    If http_Broke() Or ((millis()-t0) & $FFFFFFFF)>#HTTP_RESP_MS
      ProcedureReturn #HTTP_E_TIMEOUT
    EndIf
    n=TcpRead(@http_rx[0],#HTTP_RXCHUNK)
    If n>0
      http_rxbytes=http_rxbytes+n : offset=0
      While offset<n
        rc=WebResponseFeed(@http_response,@http_rx[offset],n-offset,@http_decoded[0],#HTTP_RXCHUNK)
        If rc<0 : ProcedureReturn rc : EndIf
        offset=offset+rc
        For i=0 To http_response\written-1
          http_bodyseen=http_bodyseen+1
          If http_bodylen<http_dstmax
            PokeA(http_dst+http_bodylen,http_decoded[i]) : http_bodylen=http_bodylen+1
          Else
            http_truncated=1
          EndIf
        Next
        http_ResponseMetadata()
        If http_state=#HTTP_ST_DONE : ProcedureReturn #HTTP_OK : EndIf
        If rc=0 And http_response\written=0 : ProcedureReturn #HTTP_E_FRAMING : EndIf
      Wend
    Else
      TcpPoll(#HTTP_SLICE_MS)
      If TcpAvailable()=0
        If TcpWasReset()
          http_tcperr=TcpError() : ProcedureReturn #HTTP_E_RESET
        EndIf
        st=TcpState()
        If st<>#TCP_ESTABLISHED And st<>#TCP_SYN_SENT And st<>#TCP_SYN_RECEIVED
          rc=WebResponseEof(@http_response) : http_ResponseMetadata()
          If rc<0 : http_tcperr=TcpError() : ProcedureReturn rc : EndIf
          ProcedureReturn #HTTP_OK
        EndIf
      EndIf
    EndIf
  Wend
  ProcedureReturn #HTTP_E_TIMEOUT
EndProcedure

; The one entry point both HttpGet and HttpHead go through. `method` is
; a pointer to the method token; the URL has already been parsed into
; http_host / http_path / http_port by HttpParseUrl, and `ip` is what
; the caller resolved that host to.
Procedure.i http_Run(method.i, ip.i, dst.i, maxlen.i)
  Define r.i
  Define s.i
  Define keep.i,divisor.i,digit.i

  http_Reset(dst, maxlen)
  If ip = 0 Or maxlen<0 Or (maxlen>0 And dst=0)
    http_err = #HTTP_E_ARG
    ProcedureReturn #HTTP_E_ARG
  EndIf
  If http_hostlen = 0 Or http_pathlen = 0
    http_err = #HTTP_E_URL
    ProcedureReturn #HTTP_E_URL
  EndIf
  http_ip = ip

  r=3 : If http_headonly : r=4 : EndIf
  r=WebRequestInit(@http_request,@http_url,method,r,0,0,@http_req[0],#HTTP_REQ_MAX)
  If r=0 : r=WebRequestHeader(@http_request,"Accept-Encoding",15,"identity",8) : EndIf
  If r=0 : r=WebRequestHeader(@http_request,"User-Agent",10,"PureMetalAnvil/1.0",17) : EndIf
  If r=0 : r=WebRequestFinishHeaders(@http_request) : EndIf
  If r<0 : http_err=r : ProcedureReturn r : EndIf
  http_reqlen=http_request\length

  keep = TcpCurrent()
  s = TcpAlloc()
  If s < 0
    TcpUse(keep)
    http_err = #HTTP_E_NOSOCK
    ProcedureReturn #HTTP_E_NOSOCK
  EndIf
  http_sock = s
  TcpUse(s)
  http_requests = http_requests + 1

  r = http_Connect(ip, http_port)
  If r = #HTTP_OK
    r = http_SendAll(@http_req[0], http_reqlen)
  EndIf
  If r = #HTTP_OK
    r = http_ReadResponse()
  EndIf

  ; The teardown runs whatever happened, and it runs in this order: a
  ; polite FIN, two slices to let the peer's answer arrive, then an
  ; abort so the socket is never left holding a half-closed connection
  ; the next command cannot use.
  TcpClose()
  TcpPoll(#HTTP_SLICE_MS)
  TcpPoll(#HTTP_SLICE_MS)
  TcpAbort()
  TcpUse(keep)

  If r = #HTTP_OK
    If http_truncated <> 0
      ; SOFT. The status, the headers and the framing are all valid and
      ; usable; only the body was longer than the buffer. Reporting this
      ; as a hard failure would throw away a correct answer.
      http_err = #HTTP_E_TRUNC
      ProcedureReturn #HTTP_E_TRUNC
    EndIf
    http_oks = http_oks + 1
  EndIf
  http_err = r
  ProcedureReturn r
EndProcedure

Procedure.i HttpGet(ip.i, dst.i, maxlen.i)
  http_headonly = 0
  ProcedureReturn http_Run("GET", ip, dst, maxlen)
EndProcedure

Procedure.i HttpHead(ip.i)
  http_headonly = 1
  ProcedureReturn http_Run("HEAD", ip, 0, 0)
EndProcedure

Procedure HttpInit()
  http_Reset(0, 0)
  http_sock = -1
  http_port = #HTTP_PORT_DEFAULT
  http_ip = 0
  http_requests = 0
  http_oks = 0
  http_hostlen = 0
  http_pathlen = 0
EndProcedure

Procedure.i HttpStatus()
  ProcedureReturn http_status
EndProcedure

Procedure.i HttpBodyLen()
  ProcedureReturn http_bodylen
EndProcedure

Procedure.i HttpBodySeen()
  ProcedureReturn http_bodyseen
EndProcedure

Procedure.i HttpContentLength()
  If http_haveclen = 0
    ProcedureReturn -1
  EndIf
  ProcedureReturn http_clen
EndProcedure

Procedure.i HttpFraming()
  ProcedureReturn http_framing
EndProcedure

Procedure.i HttpTruncated()
  ProcedureReturn http_truncated
EndProcedure

Procedure.i HttpHeaderCount()
  ProcedureReturn http_hdrcount
EndProcedure

Procedure.i HttpHeadersDropped()
  ProcedureReturn http_hdrdropped
EndProcedure

Procedure.i HttpRxBytes()
  ProcedureReturn http_rxbytes
EndProcedure

Procedure.i HttpLocation()
  ProcedureReturn @http_loc[0]
EndProcedure

Procedure.i HttpLocationLen()
  ProcedureReturn http_loclen
EndProcedure

Procedure.i HttpIsRedirect()
  If http_status >= 300 And http_status <= 399
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

Procedure.i HttpError()
  ProcedureReturn http_err
EndProcedure

Procedure.i HttpTcpError()
  ProcedureReturn http_tcperr
EndProcedure

Procedure.i HttpFramingName(f.i)
  If f = #HTTP_FRAME_NONE
    ProcedureReturn "no body"
  EndIf
  If f = #HTTP_FRAME_LENGTH
    ProcedureReturn "Content-Length"
  EndIf
  If f = #HTTP_FRAME_CHUNKED
    ProcedureReturn "chunked"
  EndIf
  ProcedureReturn "until the connection closed"
EndProcedure

; House rule of 2026-09-03: a full sentence that keeps the number and says
; what to check first.
Procedure.i HttpErrorText(e.i)
  Select e
    Case -540
      ProcedureReturn "http -540: invalid request arguments. No complete request was sent."
    Case -541
      ProcedureReturn "http -541: invalid method or forbidden request header. No complete request was sent."
    Case -542
      ProcedureReturn "http -542: request headers exceed the bounded storage. No complete request was sent."
    Case -543
      ProcedureReturn "http -543: request serialization called in the wrong state. No complete request was sent."
    Case -544
      ProcedureReturn "http -544: request body does not match its declared length. No complete request was sent."
    Case -520
      ProcedureReturn "http -520: invalid response storage arguments. The response was refused."
    Case -521
      ProcedureReturn "http -521: malformed HTTP response syntax. The response was refused."
    Case -522
      ProcedureReturn "http -522: ambiguous or invalid response framing. The response was refused."
    Case -523
      ProcedureReturn "http -523: response metadata exceeds the bounded storage. The response was refused."
    Case -524
      ProcedureReturn "http -524: connection ended before the response completed. The response was refused."
    Case -525
      ProcedureReturn "http -525: unsupported transfer coding. The response was refused."
    Case -526
      ProcedureReturn "http -526: protocol upgrade is not supported by this command. The response was refused."
    Case #HTTP_OK
      ProcedureReturn "http: no refusal recorded"
    Case #HTTP_E_ARG
      ProcedureReturn "http -400: a null pointer or an empty address reached the client, which is a fault in the monitor and not in what you typed"
    Case #HTTP_E_URL
      ProcedureReturn "http -401: that is not a URL this can parse. It wants http://host[:port]/path - a bare host works too, and the path defaults to /"
    Case #HTTP_E_SCHEME
      ProcedureReturn "http -402: this fetches PLAIN http only and that URL is https or another scheme, so nothing was fetched. It was refused rather than fetched over port 80, because that would answer a different question from the one asked"
    Case #HTTP_E_LONG
      ProcedureReturn "http -403: the host name or the path is longer than this client's buffer, so nothing was sent. Shorten it, or fetch by address"
    Case #HTTP_E_NOSOCK
      ProcedureReturn "http -404: every TCP socket is in use, so nothing was fetched. tcp status shows what is holding them; tcp close frees one"
    Case #HTTP_E_CONNECT
      ProcedureReturn "http -405: the connection was never established. Either nothing is listening on that port, or the address is not reachable - ping it to find out which"
    Case #HTTP_E_RESET
      ProcedureReturn "http -406: the server reset the connection. That is its answer and not a fault on this board; a server that resets instead of replying usually did not like the request line"
    Case #HTTP_E_SEND
      ProcedureReturn "http -407: the request could not be pushed out in ten seconds, so nothing was fetched. The connection came up and then stopped accepting data, which is the far end or the path to it"
    Case #HTTP_E_TIMEOUT
      ProcedureReturn "http -408: no response in twenty seconds, so nothing was fetched. The request went out and the server has not answered; check it is serving that path"
    Case #HTTP_E_CLOSED
      ProcedureReturn "http -409: the server closed the connection before the message it had announced was complete, so what arrived is not a whole response and is not being reported as one"
    Case #HTTP_E_STATUS
      ProcedureReturn "http -410: the first line back was not an HTTP status line, so nothing could be read. Something is listening on that port but it is not an HTTP server"
    Case #HTTP_E_FRAMING
      ProcedureReturn "http -411: the response announced BOTH a chunked transfer encoding and a Content-Length. Those can disagree, and choosing between them is how request smuggling works, so this refuses instead of guessing"
    Case #HTTP_E_CHUNK
      ProcedureReturn "http -412: a chunk size that is not hexadecimal, so the body could not be framed. The response is malformed"
    Case #HTTP_E_TRUNC
      ProcedureReturn "http -413: the status, the headers and the framing are all good and the BODY was longer than the buffer, so it was cut short. This is not a failure of the fetch - ask for fewer bytes, or read the length that arrived"
    Default
      ProcedureReturn "http: an unnumbered refusal, which is itself a defect"
  EndSelect
EndProcedure

DataSection
  ; The three header names this client looks for, as plain bytes so that
  ; no character literal appears in the source and each is checkable
  ; against the RFC by eye.
  http_nm_clen:
    Data.b 67,111,110,116,101,110,116,45,76,101,110,103,116,104,0   ; Content-Length
  http_nm_te:
    Data.b 84,114,97,110,115,102,101,114,45,69,110,99,111,100,105,110,103,0 ; Transfer-Encoding
  http_nm_loc:
    Data.b 76,111,99,97,116,105,111,110,0                            ; Location
EndDataSection
