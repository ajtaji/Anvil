; ======================================================================
;  rp1_pwm.pi4 - RP1's two PWM blocks: the Raspberry Pi 5 fan connector
;  (PWM1 channel 3 on RP1 GPIO45, with the fan's tachometer on RP1 GPIO29,
;  counted by polling) and the 40-pin header's PWM0 on GPIO 12, 13, 18 and
;  19. BCM2712 ONLY (-t pi5, #PMF_CHIP = 2712). One file for both blocks
;  (rule 30): the same IP twice, at two bases.
;
;  ---- THE HEADER'S PWM0 (2026-09-27) ---------------------------------
;  rp1.dtsi:397-405  rp1_pwm0: pwm@98000, reg <0xc0 0x40098000 0x0 0x100>,
;                    "raspberrypi,rp1-pwm", RP1_CLK_PWM0 assigned 50 MHz,
;                    status disabled (no pinctrl group in rp1.dtsi)
;  rp1-peripherals.pdf 3.1 GPIO function table (vault References):
;                    GPIO12 PWM0[0] and GPIO13 PWM0[1] in function a0,
;                    GPIO18 PWM0[2] and GPIO19 PWM0[3] in function a3;
;                    the same columns as pinctrl-rp1.c:494-501
;  THE CLOCK. drivers/clk/clk-rp1.c (vault Sources, pinned 2026-09-27 at
;  the same commit; the datasheet's 2.5.6 defers to it): CLK_PWM0_CTRL
;  $74, DIV_INT $78, DIV_FRAC $7C (:70-73), and clk_pwm0's parents are
;  clk_pwm1's - aux index 2 is the crystal (:1661-1684 against :1687-1710),
;  so rp1pwm_Clock programs it exactly as it does clk_pwm1. Should an
;  offset ever be unknown again (0), a header Begin refuses with
;  #RP1PWM_ERR_CLOCK_OWED before any write.
;  The header pins are driven NOT inverted (no DT polarity) and their
;  pull is left as found (rp1.dtsi names no pull for pwm0).
;
;  WHY THIS IS A SEPARATE LIBRARY AND NOT A #PMF_CHIP BRANCH OF pwm.pi4.
;  RaspberryPi4/Lib/pwm.pi4 drives the BCM2711's own PWM blocks: a CTL
;  byte per channel, RNG/DAT pairs, a status register whose BERR bit is
;  the only way to see a start that did not happen, and a clock manager
;  that needs a password on every write. RP1's PWM is a different IP -
;  a GLOBAL_CTRL enable per channel with a self-clearing SET_UPDATE, four
;  channels of CTRL/RANGE/PHASE/DUTY, per-channel output inversion, and
;  a clock in RP1's own clock manager with no password at all. Not one
;  register offset or bit is shared. A branch inside pwm.pi4 would be two
;  drivers in one file; this is the other driver, and it exists once.
;  The fan POLICY is not here and not duplicated: Anvil/Core/fan.pbi and
;  Anvil/Core/fan_cmd.pbi are the same files on both boards.
;
;  SOURCES (pinned: vault "Raspberry Pi 5/Sources", and raspberrypi/linux
;  commit 7e030b60792de1c15b9ec1d8d5d34d63f0f0f1d8):
;    bcm2712-rpi-5-b.dts   cooling_fan: pwms = <&rp1_pwm1 3 41566
;                          PWM_POLARITY_INVERTED>; &rp1_pwm1 pinctrl
;                          rp1_pwm1_gpio45; gpio-line-names GPIO29
;                          "FAN_TACH", GPIO45 "FAN_PWM".
;    rp1.dtsi              pwm@9c000 reg <0xc0 0x4009c000 ...>,
;                          assigned-clock-rates <50000000>;
;                          rp1_pwm1_gpio45 { function = "pwm1";
;                          bias-pull-down; }; rp1_gpio reg d0000/e0000/
;                          f0000 (IO_BANK, SYS_RIO, PADS).
;    drivers/pwm/pwm-rp1.c the reference implementation the RP1 manual
;                          itself points to (rp1-peripherals.pdf 3.4.5):
;                          CHANNEL_CTRL(x) 0x14+16x, RANGE(x) 0x18+16x,
;                          DUTY(x) 0x20+16x, default ctrl BIT(8)+BIT(0),
;                          polarity BIT(3), SET_UPDATE BIT(31), and the
;                          arithmetic: clk_period = round(1e9 / rate),
;                          RANGE = round(period / clk_period),
;                          DUTY = round(duty / clk_period).
;    drivers/clk/clk-rp1.c CLK_PWM1_CTRL 0x84, DIV_INT 0x88, DIV_FRAC
;                          0x8c (:76-79); CLK_CTRL_ENABLE BIT(11), AUXSRC
;                          bits 9:5 (:261-262); clk_pwm1's aux parent 2 is
;                          the crystal (:1687-1710). Pinned in the vault
;                          since 2026-09-27.
;    pinctrl-rp1.c         PIN(45, pwm1, ...) = FUNCSEL 0; the pins'
;                          bank/CTRL/PAD/RIO arithmetic is NOT here - it is
;                          RaspberryPi4/Lib/gpio_rp1.pi4's (rule 30, since
;                          2026-09-27; this file used to carry its own copy).
;    rp1-peripherals.pdf   3.4 PWM, Tables 25, 26, 31.
;  RP1's window: rp1.dtsi 0xc0_40xxxxxx is CPU $1F_00xxxxxx (vault
;  HARDWARE-BRINGUP.md; the same reach uart.pi4 uses for RP1 UART0).
;
;  THE POLARITY IS THE DEVICE TREE'S. The connector's FAN_PWM line is
;  inverted on the board, so the channel's INVERT bit is set and DUTY is
;  the fan's own duty: DUTY = 0 is a stopped fan, DUTY = RANGE is full.
;  That is exactly how Linux drives it (pwm-fan writes duty_cycle =
;  period * level / 255 into an INVERTED pwm).
;
;  THE TACHOMETER. The Linux device tree reads RPM from rp1_pwm1 + 0x3c
;  (rpm-regmap / rpm-offset), which the RP1 manual lists only as
;  CHAN2_PHASE - a value some firmware maintains, undocumented. The
;  measurement this file stands behind does NOT read it: it counts the tach
;  line's rising edges itself, by
;  polling GPIO29 through SYS_RIO, over a window measured with Micros(),
;  at two pulses per revolution (pwm-fan.c's default). A window in which
;  the polls were too far apart to be sure of every edge answers
;  #RP1_TACH_COARSE, not a number - an under-sampled tach silently reads
;  low, which is the one wrong answer a fan report must not give.
;  Rp1FanRpmRegister() (end of file) reads the $3C word raw, as the device
;  tree names it, for the seam ruling still owed (vault morning list
;  2026-09-27, item 4). It is not converted and not trusted here.
;
;  NOT VERIFIED ON A Pi 5. Desk-proven only (tools/a64/a64_fan_pi5_check.py
;  against a register model built from the sources above). Silicon owed.
;
;  REQUIRES (house rule 10 - the board lists every library):
;      RaspberryPi4/Lib/timer.pi4     Micros() for Rp1TachMeasure
;      RaspberryPi4/Lib/gpio_rp1.pi4  GPIO45 and GPIO29 (before this file)
; ======================================================================

; A BUILD FOR ANY OTHER CHIP IS REFUSED, BY NAME. The dialect has no
; CompilerError, so the refusal is a call to a procedure that does not
; exist and whose name is the sentence: the compiler's "is not defined"
; error then says what went wrong and what to include instead.
CompilerIf #PMF_CHIP <> 2712
rp1_pwm_is_the_BCM2712_fan_driver_build_with_t_pi5_a_BCM2711_board_uses_pwm_pi4()
CompilerEndIf

; ----------------------------------------------------------------------
;  RP1 blocks, CPU addresses ($1F_00xxxxxx = RP1 $c0_40xxxxxx).
; ----------------------------------------------------------------------
#RP1PWM_BASE   = $1F0009C000   ; rp1.dtsi pwm@9c000 (rp1_pwm1)
#RP1PWM0_BASE  = $1F00098000   ; rp1.dtsi pwm@98000 (rp1_pwm0, the header)
#RP1PWM_CLOCKS = $1F00018000   ; rp1.dtsi clocks@18000

; ----------------------------------------------------------------------
;  PWM registers (pwm-rp1.c; rp1-peripherals.pdf Table 25).
; ----------------------------------------------------------------------
#RP1PWM_GLOBAL_CTRL = $00
#RP1PWM_CHAN        = 3            ; cooling_fan pwms = <&rp1_pwm1 3 ...>
#RP1PWM_CHAN_CTRL   = $14 + 16 * #RP1PWM_CHAN   ; $44
#RP1PWM_CHAN_RANGE  = $18 + 16 * #RP1PWM_CHAN   ; $48
#RP1PWM_CHAN_DUTY   = $20 + 16 * #RP1PWM_CHAN   ; $50
#RP1PWM_SET_UPDATE  = $80000000    ; GLOBAL_CTRL bit 31, self-clearing
#RP1PWM_CHAN_EN     = 1 << #RP1PWM_CHAN
#RP1PWM_CTRL_DEFAULT = $101        ; FIFO_POP_MASK | MODE 1 trailing edge
#RP1PWM_CTRL_INVERT  = 8           ; PWM_POLARITY, BIT(3)

; ----------------------------------------------------------------------
;  clk_pwm1 (clk-rp1.c). No password, no BUSY bit: RP1's clock manager
;  is not the BCM2711's CPRMAN.
; ----------------------------------------------------------------------
#RP1PWM_CLK_CTRL     = $84
#RP1PWM_CLK_DIV_INT  = $88
#RP1PWM_CLK_DIV_FRAC = $8C
#RP1PWM_CLK_ENABLE   = $800        ; CLK_CTRL_ENABLE, BIT(11)
#RP1PWM_CLK_AUXSRC   = $3E0        ; CLK_CTRL_AUXSRC_MASK, GENMASK(9, 5)
#RP1PWM_CLK_XOSC     = 2 << 5      ; aux parent 2 = the 50 MHz crystal
#RP1PWM_XOSC_HZ      = 50000000
#RP1PWM_CLK_HZ       = 50000000    ; rp1.dtsi assigned-clock-rates, DIV 1

; clk_pwm0 (clk-rp1.c:70-73). A 0 here would make a PWM0 Begin refuse.
#RP1PWM0_CLK_CTRL     = $74
#RP1PWM0_CLK_DIV_INT  = $78
#RP1PWM0_CLK_DIV_FRAC = $7C

; ----------------------------------------------------------------------
;  The two pins (dts gpio-line-names GPIO45 "FAN_PWM", GPIO29 "FAN_TACH").
;  Every register touch on them goes through gpio_rp1.pi4.
; ----------------------------------------------------------------------
#RP1PWM_FAN_GPIO   = 45            ; = gpio_rp1.pi4 #RP1_GPIO_FAN_PWM
#RP1PWM_FAN_FSEL   = 0             ; pwm1 (= #RP1_FUNCSEL_PWM1_45)
#RP1PWM_TACH_GPIO  = 29

; The header's PWM0 pins: channel and FUNCSEL (rp1-peripherals.pdf 3.1).
#RP1PWM_HDR_GPIO0 = 12             ; PWM0[0], a0
#RP1PWM_HDR_GPIO1 = 13             ; PWM0[1], a0
#RP1PWM_HDR_GPIO2 = 18             ; PWM0[2], a3
#RP1PWM_HDR_GPIO3 = 19             ; PWM0[3], a3

; ----------------------------------------------------------------------
;  Design choices, not citations.
;  RANGE_MIN: a range of at least 1000 counts gives every permille step
;  its own count, so the fan command's resolution is never a lie. At
;  50 MHz that caps the frequency at 50 kHz; a four-pin fan wants 25.
; ----------------------------------------------------------------------
#RP1PWM_RANGE_MIN = 1000
#RP1PWM_RANGE_MAX = $FFFFFFFF
#RP1PWM_DUTY_MAX  = 1000
#RP1PWM_SPIN_MAX  = 100000         ; SET_UPDATE polls before giving up

#RP1PWM_OK        = 0
#RP1PWM_ERR_HZ    = -2
#RP1PWM_ERR_DUTY  = -3
#RP1PWM_ERR_STATE = -5
#RP1PWM_ERR_CLOCK = -7             ; clk_pwm1 did not read back as asked
#RP1PWM_ERR_START = -8             ; SET_UPDATE never self-cleared
#RP1PWM_ERR_PIN   = -4             ; not a PWM pin on this board
#RP1PWM_ERR_INUSE = -6             ; the one modulator is on another pin
#RP1PWM_ERR_CLOCK_OWED = -9        ; PWM0's clock register is not pinned

; The tachometer.
#RP1_TACH_PPR       = 2            ; pwm-fan.c default pulses-per-revolution
#RP1_TACH_WINDOW_US = 1000000      ; one measurement per second
#RP1_TACH_GAP_US    = 1000         ; a longer gap between polls = coarse
#RP1_TACH_NONE      = -1           ; no complete window yet
#RP1_TACH_COARSE    = -2           ; polled too slowly to trust a count

Global rp1pwm_on.i
Global rp1pwm_range.i
Global rp1pwm_permille.i
Global rp1pwm_counts.i
Global rp1pwm_pin.i                ; the pin in use (0 = none yet)
Global rp1pwm_base.i               ; its block
Global rp1pwm_coff.i               ; 16 * its channel
Global rp1pwm_cbit.i               ; 1 << its channel
; What rp1pwm_Pick found for a pin, before Begin commits to it.
Global rp1pwm_pBlk.i
Global rp1pwm_pChan.i
Global rp1pwm_pFsel.i
Global rp1pwm_pInv.i

Global rp1tach_on.i
Global rp1tach_last.i
Global rp1tach_edges.i
Global rp1tach_total.i
Global rp1tach_winStart.i
Global rp1tach_lastPoll.i
Global rp1tach_maxGap.i
Global rp1tach_rpm.i = #RP1_TACH_NONE

; ======================================================================
;  THE ARITHMETIC - pwm-rp1.c's, restated, and pure so a gate can walk it
; ======================================================================
; The nanosecond period the seam's hertz asks for, rounded to nearest.
Procedure.i Rp1PwmPeriodNs(hz.i)
  If hz <= 0
    ProcedureReturn 0
  EndIf
  ProcedureReturn (1000000000 + hz / 2) / hz
EndProcedure

; RANGE for a period: DIV_ROUND_CLOSEST(period, clk_period) with
; clk_period = DIV_ROUND_CLOSEST(NSEC_PER_SEC, rate) - 20 ns at 50 MHz.
; 0 when the result is outside the envelope.
Procedure.i Rp1PwmRangeFor(hz.i)
  Define clkNs.i
  Define r.i
  clkNs = (1000000000 + #RP1PWM_CLK_HZ / 2) / #RP1PWM_CLK_HZ
  r = (Rp1PwmPeriodNs(hz) + clkNs / 2) / clkNs
  If r < #RP1PWM_RANGE_MIN Or r > #RP1PWM_RANGE_MAX
    ProcedureReturn 0
  EndIf
  ProcedureReturn r
EndProcedure

; DUTY counts for a permille. The rails are exact - 0 is 0 and 1000 is
; the whole range - and everything between rounds to nearest.
Procedure.i Rp1PwmCounts(range.i, permille.i)
  If permille <= 0
    ProcedureReturn 0
  EndIf
  If permille >= #RP1PWM_DUTY_MAX
    ProcedureReturn range
  EndIf
  ProcedureReturn (range * permille + #RP1PWM_DUTY_MAX / 2) / #RP1PWM_DUTY_MAX
EndProcedure

; ======================================================================
;  THE CHANNEL
; ======================================================================
; rp1pwm_Pick(pin) - the block, channel, function and polarity of a PWM
; pin, into rp1pwm_p*. 1, or 0 for a pin that has no PWM here.
Procedure.i rp1pwm_Pick(pin.i)
  rp1pwm_pBlk = 0
  rp1pwm_pInv = 0
  Select pin
    Case #RP1PWM_FAN_GPIO
      rp1pwm_pBlk = 1
      rp1pwm_pChan = #RP1PWM_CHAN
      rp1pwm_pFsel = #RP1PWM_FAN_FSEL
      rp1pwm_pInv = 1
    Case #RP1PWM_HDR_GPIO0
      rp1pwm_pChan = 0
      rp1pwm_pFsel = 0
    Case #RP1PWM_HDR_GPIO1
      rp1pwm_pChan = 1
      rp1pwm_pFsel = 0
    Case #RP1PWM_HDR_GPIO2
      rp1pwm_pChan = 2
      rp1pwm_pFsel = 3
    Case #RP1PWM_HDR_GPIO3
      rp1pwm_pChan = 3
      rp1pwm_pFsel = 3
    Default
      ProcedureReturn 0
  EndSelect
  ProcedureReturn 1
EndProcedure

; rp1pwm_Update(base) - request a settings update and wait for the PWM
; clock domain to take it. SET_UPDATE self-clears only when the block's
; clock is running, so a bit that never clears is a channel that never
; started: the RP1 form of the BCM2711's BERR lesson, answered loudly.
Procedure.i rp1pwm_Update(base.i)
  Define n.i
  PokeL(base + #RP1PWM_GLOBAL_CTRL, PeekN(base + #RP1PWM_GLOBAL_CTRL) | #RP1PWM_SET_UPDATE)
  n = 0
  While (PeekN(base + #RP1PWM_GLOBAL_CTRL) & #RP1PWM_SET_UPDATE) <> 0
    n = n + 1
    If n > #RP1PWM_SPIN_MAX
      ProcedureReturn #RP1PWM_ERR_START
    EndIf
  Wend
  ProcedureReturn #RP1PWM_OK
EndProcedure

; The block's clock: crystal with ENABLE clear, divide by one, then
; ENABLE, then read back. ctrl/divi/divf are clk-rp1.c's offsets.
Procedure.i rp1pwm_Clock(ctrl.i, divi.i, divf.i)
  Define v.i
  v = PeekN(#RP1PWM_CLOCKS + ctrl)
  v = (v & (~(#RP1PWM_CLK_ENABLE | #RP1PWM_CLK_AUXSRC))) | #RP1PWM_CLK_XOSC
  PokeL(#RP1PWM_CLOCKS + ctrl, v)
  PokeL(#RP1PWM_CLOCKS + divi, 1)
  PokeL(#RP1PWM_CLOCKS + divf, 0)
  PokeL(#RP1PWM_CLOCKS + ctrl, v | #RP1PWM_CLK_ENABLE)
  v = PeekN(#RP1PWM_CLOCKS + ctrl)
  If (v & (#RP1PWM_CLK_ENABLE | #RP1PWM_CLK_AUXSRC)) <> (#RP1PWM_CLK_ENABLE | #RP1PWM_CLK_XOSC)
    ProcedureReturn #RP1PWM_ERR_CLOCK
  EndIf
  If PeekN(#RP1PWM_CLOCKS + divi) <> 1
    ProcedureReturn #RP1PWM_ERR_CLOCK
  EndIf
  ProcedureReturn #RP1PWM_OK
EndProcedure

; ----------------------------------------------------------------------
;  Rp1PwmBeginPin(pin, hz) - clock, channel, then pin; the output starts
;  at DUTY 0 (a fan STOPPED; a header pin low) and the first Duty call is
;  what turns it. One pin at a time, as the seam has one modulator: a
;  second pin while one is on is refused, the same pin again restarts it.
; ----------------------------------------------------------------------
Procedure.i Rp1PwmBeginPin(pin.i, hz.i)
  Define r.i
  Define c.i
  Define base.i
  Define coff.i
  Define ctl.i
  r = Rp1PwmRangeFor(hz)
  If r = 0
    ProcedureReturn #RP1PWM_ERR_HZ
  EndIf
  If rp1pwm_Pick(pin) = 0
    ProcedureReturn #RP1PWM_ERR_PIN
  EndIf
  If rp1pwm_on <> 0 And pin <> rp1pwm_pin
    ProcedureReturn #RP1PWM_ERR_INUSE
  EndIf

  If rp1pwm_pBlk = 1
    base = #RP1PWM_BASE
    c = rp1pwm_Clock(#RP1PWM_CLK_CTRL, #RP1PWM_CLK_DIV_INT, #RP1PWM_CLK_DIV_FRAC)
  Else
    base = #RP1PWM0_BASE
    If #RP1PWM0_CLK_CTRL = 0
      ProcedureReturn #RP1PWM_ERR_CLOCK_OWED
    EndIf
    c = rp1pwm_Clock(#RP1PWM0_CLK_CTRL, #RP1PWM0_CLK_DIV_INT, #RP1PWM0_CLK_DIV_FRAC)
  EndIf
  If c <> #RP1PWM_OK
    ProcedureReturn c
  EndIf

  ; The channel, in pwm-rp1.c's order: mode, duty, range, polarity,
  ; enable, update.
  coff = 16 * rp1pwm_pChan
  ctl = #RP1PWM_CTRL_DEFAULT
  If rp1pwm_pInv <> 0
    ctl = #RP1PWM_CTRL_DEFAULT | #RP1PWM_CTRL_INVERT
  EndIf
  PokeL(base + $14 + coff, #RP1PWM_CTRL_DEFAULT)
  PokeL(base + $20 + coff, 0)
  PokeL(base + $18 + coff, r)
  PokeL(base + $14 + coff, ctl)
  PokeL(base + #RP1PWM_GLOBAL_CTRL, PeekN(base + #RP1PWM_GLOBAL_CTRL) | (1 << rp1pwm_pChan))
  If rp1pwm_Update(base) <> #RP1PWM_OK
    PokeL(base + #RP1PWM_GLOBAL_CTRL, PeekN(base + #RP1PWM_GLOBAL_CTRL) & (~(1 << rp1pwm_pChan)))
    ProcedureReturn #RP1PWM_ERR_START
  EndIf

  ; The pin, last, so the pad first sees a configured channel: its PWM
  ; function with the override fields at "peripheral", input on, output
  ; on (Rp1FuncSelSet, as rp1_set_fsel); the fan's pad then takes the
  ; dtsi's bias-pull-down, the header's is left as found.
  If Rp1FuncSelSet(pin, rp1pwm_pFsel) = 0
    ProcedureReturn #RP1PWM_ERR_START
  EndIf
  If pin = #RP1PWM_FAN_GPIO
    Rp1PinPull(#RP1PWM_FAN_GPIO, #RP1_PULL_DOWN)
  EndIf

  rp1pwm_pin = pin
  rp1pwm_base = base
  rp1pwm_coff = coff
  rp1pwm_cbit = 1 << rp1pwm_pChan
  rp1pwm_range = r
  rp1pwm_permille = 0
  rp1pwm_counts = 0
  rp1pwm_on = 1
  ProcedureReturn #RP1PWM_OK
EndProcedure

; Rp1PwmBegin(hz) - the fan connector (the pre-2026-09-27 entry point).
Procedure.i Rp1PwmBegin(hz.i)
  ProcedureReturn Rp1PwmBeginPin(#RP1PWM_FAN_GPIO, hz)
EndProcedure

; DUTY has its own update strobe (Table 26) - no SET_UPDATE needed.
Procedure.i Rp1PwmDuty(permille.i)
  If rp1pwm_on = 0
    ProcedureReturn #RP1PWM_ERR_STATE
  EndIf
  If permille < 0 Or permille > #RP1PWM_DUTY_MAX
    ProcedureReturn #RP1PWM_ERR_DUTY
  EndIf
  rp1pwm_counts = Rp1PwmCounts(rp1pwm_range, permille)
  PokeL(rp1pwm_base + $20 + rp1pwm_coff, rp1pwm_counts)
  rp1pwm_permille = permille
  ProcedureReturn #RP1PWM_OK
EndProcedure

; Rp1PwmEnd() - release, leaving the output at FULL. The seam's contract
; is "the state the board considers safe for a fan", and on the fan
; connector the one level whose meaning the device tree fixes is DUTY =
; RANGE with the channel inverted and running: full speed. A disabled
; channel's idle level is not documented, so it is not relied on. A
; header pin is left the same way - high, which is what a fan transistor
; on it wants (the Pi 4 header's software channel parks HIGH too).
Procedure.i Rp1PwmEnd()
  If rp1pwm_on = 0
    ProcedureReturn #RP1PWM_ERR_STATE
  EndIf
  PokeL(rp1pwm_base + $20 + rp1pwm_coff, rp1pwm_range)
  rp1pwm_counts = rp1pwm_range
  rp1pwm_permille = #RP1PWM_DUTY_MAX
  rp1pwm_on = 0
  ProcedureReturn #RP1PWM_OK
EndProcedure

Procedure.i Rp1PwmOn()
  ProcedureReturn rp1pwm_on
EndProcedure

Procedure.i Rp1PwmRange()
  ProcedureReturn rp1pwm_range
EndProcedure

Procedure.i Rp1PwmDutyNow()
  ProcedureReturn rp1pwm_permille
EndProcedure

Procedure.i Rp1PwmHz()
  If rp1pwm_range = 0
    ProcedureReturn 0
  EndIf
  ProcedureReturn #RP1PWM_CLK_HZ / rp1pwm_range
EndProcedure

Procedure.i Rp1PwmPin()
  ProcedureReturn rp1pwm_pin
EndProcedure

; 1 if pin has a PWM channel on this board (the fan or a header pin).
Procedure.i Rp1PwmPinValid(pin.i)
  ProcedureReturn rp1pwm_Pick(pin)
EndProcedure

; The clock READ BACK, not remembered: crystal / DIV_INT (0 means 65536,
; clk-rp1.c), or -1 when clk_pwm1 is off or not on the crystal.
Procedure.i Rp1PwmDivisor()
  Define d.i
  If rp1pwm_on <> 0 And rp1pwm_base = #RP1PWM0_BASE
    If #RP1PWM0_CLK_CTRL = 0
      ProcedureReturn -1
    EndIf
    d = PeekN(#RP1PWM_CLOCKS + #RP1PWM0_CLK_DIV_INT) & $FFFF
    If d = 0
      d = 65536
    EndIf
    ProcedureReturn d
  EndIf
  d = PeekN(#RP1PWM_CLOCKS + #RP1PWM_CLK_DIV_INT) & $FFFF
  If d = 0
    d = 65536
  EndIf
  ProcedureReturn d
EndProcedure

Procedure.i Rp1PwmClockHz()
  Define v.i
  If rp1pwm_on <> 0 And rp1pwm_base = #RP1PWM0_BASE
    If #RP1PWM0_CLK_CTRL = 0
      ProcedureReturn -1
    EndIf
    v = PeekN(#RP1PWM_CLOCKS + #RP1PWM0_CLK_CTRL)
    If (v & (#RP1PWM_CLK_ENABLE | #RP1PWM_CLK_AUXSRC)) <> (#RP1PWM_CLK_ENABLE | #RP1PWM_CLK_XOSC)
      ProcedureReturn -1
    EndIf
    ProcedureReturn #RP1PWM_XOSC_HZ / Rp1PwmDivisor()
  EndIf
  v = PeekN(#RP1PWM_CLOCKS + #RP1PWM_CLK_CTRL)
  If (v & (#RP1PWM_CLK_ENABLE | #RP1PWM_CLK_AUXSRC)) <> (#RP1PWM_CLK_ENABLE | #RP1PWM_CLK_XOSC)
    ProcedureReturn -1
  EndIf
  ProcedureReturn #RP1PWM_XOSC_HZ / Rp1PwmDivisor()
EndProcedure

; ======================================================================
;  THE TACHOMETER
; ======================================================================
Procedure.i Rp1TachLevel()
  If Rp1DigitalRead(#RP1PWM_TACH_GPIO) = #RP1_PIN_HIGH
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

; Rp1TachBegin(nowUs) - GPIO29 as a plain input (FUNCSEL 5, SYS_RIO OE
; cleared), input enabled, output disabled, pulled UP: the tach output of
; a four-wire fan is open-collector. The pull is a choice, not a citation.
Procedure Rp1TachBegin(nowUs.i)
  ; gpio_rp1.pi4: GPIO function + SYS_RIO OE cleared (input), then the pad's
  ; output driver off and the pull up. Rp1PinInput enables the pad's output
  ; driver as rp1_set_fsel does, so OUT_DISABLE is set after it; OE is
  ; already clear by then, so the pin never drives.
  Rp1PinInput(#RP1PWM_TACH_GPIO)
  Rp1PinOutputDisable(#RP1PWM_TACH_GPIO, 1)
  Rp1PinPull(#RP1PWM_TACH_GPIO, #RP1_PULL_UP)
  rp1tach_last = Rp1TachLevel()
  rp1tach_edges = 0
  rp1tach_total = 0
  rp1tach_winStart = nowUs
  rp1tach_lastPoll = nowUs
  rp1tach_maxGap = 0
  rp1tach_rpm = #RP1_TACH_NONE
  rp1tach_on = 1
EndProcedure

; Rp1TachPollWindow(nowUs, windowUs) - one sample; closes the window when
; it has run its length. Rising edges only, two per revolution.
Procedure Rp1TachPollWindow(nowUs.i, windowUs.i)
  Define lv.i
  Define gap.i
  Define el.i
  If rp1tach_on = 0
    ProcedureReturn
  EndIf
  gap = nowUs - rp1tach_lastPoll
  If gap > rp1tach_maxGap
    rp1tach_maxGap = gap
  EndIf
  rp1tach_lastPoll = nowUs
  lv = Rp1TachLevel()
  If lv = 1 And rp1tach_last = 0
    rp1tach_edges = rp1tach_edges + 1
    rp1tach_total = rp1tach_total + 1
  EndIf
  rp1tach_last = lv
  el = nowUs - rp1tach_winStart
  If el >= windowUs
    If rp1tach_maxGap > #RP1_TACH_GAP_US
      rp1tach_rpm = #RP1_TACH_COARSE
    Else
      rp1tach_rpm = (rp1tach_edges * 60000000) / (#RP1_TACH_PPR * el)
    EndIf
    rp1tach_edges = 0
    rp1tach_maxGap = 0
    rp1tach_winStart = nowUs
  EndIf
EndProcedure

; The periodic form, for the monitor's tick.
Procedure Rp1TachPoll(nowUs.i)
  Rp1TachPollWindow(nowUs, #RP1_TACH_WINDOW_US)
EndProcedure

; Rp1TachMeasure(windowUs) - a blocking measurement: poll as fast as the
; core can for one window and answer it. For the report and the bench.
Procedure.i Rp1TachMeasure(windowUs.i)
  Define t.i
  If rp1tach_on = 0
    Rp1TachBegin(Micros())
  EndIf
  t = Micros()
  rp1tach_edges = 0
  rp1tach_maxGap = 0
  rp1tach_winStart = t
  rp1tach_lastPoll = t
  rp1tach_last = Rp1TachLevel()
  rp1tach_rpm = #RP1_TACH_NONE
  While rp1tach_rpm = #RP1_TACH_NONE
    Rp1TachPollWindow(Micros(), windowUs)
  Wend
  ProcedureReturn rp1tach_rpm
EndProcedure

Procedure.i Rp1TachRpm()
  ProcedureReturn rp1tach_rpm
EndProcedure

Procedure.i Rp1TachEdges()
  ProcedureReturn rp1tach_total
EndProcedure

; ======================================================================
;  THE FIRMWARE'S RPM WORD - rp1_pwm1 + $3C, READ RAW.
;  bcm2712-rpi-5-b.dts cooling_fan: rpm-regmap = <&rp1_pwm1>,
;  rpm-offset = <0x3c>. rp1-peripherals.pdf Table 25 names $3C CHAN2_PHASE:
;  whatever keeps an RPM there is firmware the manual does not describe,
;  and whether it counts at all on this board is owed to silicon. One
;  32-bit read, no write, no scaling: the seam decision (morning list
;  item 4) chooses between this word and Rp1TachMeasure's counted edges.
; ======================================================================
#RP1PWM_RPM_REG = $3C              ; dts rpm-offset

Procedure.i Rp1FanRpmRegister()
  ProcedureReturn PeekN(#RP1PWM_BASE + #RP1PWM_RPM_REG) & $FFFFFFFF
EndProcedure
