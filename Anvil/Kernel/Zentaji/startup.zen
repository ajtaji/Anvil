.org ZEN_VECTOR_BASE+4032
  LI r200,63
  JMP anvil_zen_fault

.org ZEN_VECTOR_BASE+4096
anvil_zen_entry:
  ; Only the documented boot table pointer is dereferenced.
  LIQ r4,$FFFF000000010000
  BNE r1,r4,anvil_bad_table
  MFCR r4,STATUS
  BNEI r4,0,anvil_bad_status
  MFCR r4,COREID
  BNEI r4,0,anvil_bad_core
  MFCR r4,PROT
  BNEI r4,0,anvil_bad_protection
  LD64 r4,[r1]
  LIQ r5,$00494A41544E455A
  BNE r4,r5,anvil_bad_table
  LD16U r4,[r1+8]
  BNEI r4,1,anvil_bad_table
  LD16U r4,[r1+10]
  BNEI r4,64,anvil_bad_table
  LD32U r4,[r1+20]
  BNEI r4,64,anvil_bad_table
  LD32U r4,[r1+16]
  BEQI r4,0,anvil_bad_table
  LI r5,1023
  BLTU r5,r4,anvil_bad_table
  LI r5,6
  SHL r4,r4,r5
  ADDI r4,r4,64
  LD32U r5,[r1+12]
  BLTU r5,r4,anvil_bad_table
  LI r4,65536
  BLTU r4,r5,anvil_bad_table
  LI r4,3
  BGEU r2,r4,anvil_bad_source
  LD8U r4,[r1+35]
  BNE r2,r4,anvil_bad_source
  LD64 r4,[r1+24]
  LI r5,$200000
  BLTU r4,r5,anvil_bad_ram
  LIQ r5,$8000000000000000
  BGEU r4,r5,anvil_bad_ram
  ; Preserve the ROM's top 1MB work area, including its service storage.
  LI r5,-16
  AND r6,r4,r5
  ADDI r6,r6,-1048576
  LI r5,ZEN_STACK_BYTES
  SUB r7,r6,r5
  LIQ r15,anvil_zen_image_end
  BLTU r7,r15,anvil_bad_overlap
  LIQ r3,anvil_zen_context
  ST64 r1,[r3+24]
  ST64 r2,[r3+32]
  ST64 r4,[r3+40]
  ST64 r255,[r3+48]
  ST64 r7,[r3+56]
  ST64 r6,[r3+64]
  MFCR r4,STATUS
  ST64 r4,[r3+88]
  LIQ r4,anvil_zen_vectors
  MTCR r0,r4,EVEC
  OR r255,r6,r0
  ; r1/r2 stay the loader's values; r3 is the owned context. Clear other
  ; argument registers so compiled entry never inherits validation scratch.
  LI r4,0
  LI r5,0
  LI r6,0
  LI r7,0
  LI r8,0
  LI r9,0
  LI r10,0
  LI r11,0
  LI r12,0
  LI r13,0
  LI r14,0
  LI r15,0
  LIQ r16,ZEN_COMPILED_ENTRY
  CALLR r16,r254
anvil_zen_returned:
  ; Callable startup may return; ordinary Forge startup already halts itself.
  HALT r1
anvil_bad_table:
  LI r200,1
  JMP anvil_zen_refuse
anvil_bad_status:
  LI r200,2
  JMP anvil_zen_refuse
anvil_bad_core:
  LI r200,3
  JMP anvil_zen_refuse
anvil_bad_protection:
  LI r200,4
  JMP anvil_zen_refuse
anvil_bad_source:
  LI r200,5
  JMP anvil_zen_refuse
anvil_bad_ram:
  LI r200,6
  JMP anvil_zen_refuse
anvil_bad_overlap:
  LI r200,7
anvil_zen_refuse:
  LIQ r1,anvil_zen_refusal_text
  CALL r254,anvil_zen_puts
  OR r1,r200,r0
  CALL r254,anvil_zen_hex
  LI r1,13
  CALL r254,anvil_zen_putc
  LI r1,10
  CALL r254,anvil_zen_putc
  HALT r200

anvil_zen_fault:
  ; No stack or ordinary monitor/console state is trusted by this path.
  LI r4,13
  BLTU r200,r4,anvil_zen_sync_fault
  LI r4,16
  BGEU r200,r4,anvil_zen_sync_fault
  MFCR r201,NEPC
  MFCR r202,NEINFO
  JMP anvil_zen_fault_report
anvil_zen_sync_fault:
  MFCR r201,EPC
  MFCR r202,EINFO
anvil_zen_fault_report:
  LIQ r1,anvil_zen_fault_text
  CALL r254,anvil_zen_puts
  OR r1,r200,r0
  CALL r254,anvil_zen_hex
  LIQ r1,anvil_zen_pc_text
  CALL r254,anvil_zen_puts
  OR r1,r201,r0
  CALL r254,anvil_zen_hex
  LIQ r1,anvil_zen_info_text
  CALL r254,anvil_zen_puts
  OR r1,r202,r0
  CALL r254,anvil_zen_hex
  LI r1,13
  CALL r254,anvil_zen_putc
  LI r1,10
  CALL r254,anvil_zen_putc
  ADDI r200,r200,256
  HALT r200

; Best-effort raw serial0 output. Each byte has a finite 4096-probe budget;
; full/busy transport drops that byte. No stack, timer or interrupt is needed.
anvil_zen_putc:
  LIQ r16,$FFFF000000100000
  LI r17,4096
anvil_zen_putc_probe:
  LD64 r18,[r16+8]
  LI r19,16
  AND r18,r18,r19
  BNEI r18,0,anvil_zen_putc_done
  LD64 r18,[r16+$58]
  BNEI r18,0,anvil_zen_putc_write
  ADDI r17,r17,-1
  BNEI r17,0,anvil_zen_putc_probe
anvil_zen_putc_done:
  JR r254
anvil_zen_putc_write:
  ST64 r1,[r16+$40]
  JR r254
anvil_zen_puts:
  OR r21,r254,r0
  OR r22,r1,r0
anvil_zen_puts_next:
  LD8U r1,[r22]
  BEQI r1,0,anvil_zen_puts_done
  CALL r254,anvil_zen_putc
  ADDI r22,r22,1
  JMP anvil_zen_puts_next
anvil_zen_puts_done:
  JR r21
anvil_zen_hex:
  OR r20,r254,r0
  OR r8,r1,r0
  LI r9,16
  LI r10,60
  LI r11,15
anvil_zen_hex_next:
  SHR r1,r8,r10
  AND r1,r1,r11
  LI r12,10
  BLTU r1,r12,anvil_zen_hex_digit
  ADDI r1,r1,55
  JMP anvil_zen_hex_emit
anvil_zen_hex_digit:
  ADDI r1,r1,48
anvil_zen_hex_emit:
  CALL r254,anvil_zen_putc
  ADDI r10,r10,-4
  ADDI r9,r9,-1
  BNEI r9,0,anvil_zen_hex_next
  JR r20
anvil_zen_refusal_text:
  .ascii "Anvil startup refused code="
  .byte 0
anvil_zen_fault_text:
  .ascii "Anvil exception cause="
  .byte 0
anvil_zen_pc_text:
  .ascii " pc="
  .byte 0
anvil_zen_info_text:
  .ascii " info="
  .byte 0
; CPU payload handover. State is in the monitor image, never its foreign stack.
; Core policy validates entry/stack and board policy must quiesce/recover devices.

.align 8
anvil_zen_payload_call:
LIQ r16,anvil_zen_payload_save
ADDI r16,r16,63
LI r17,-64
AND r16,r16,r17
STM r128-r255,[r16]
MFCR r17,EVEC
ST64 r17,[r16+3072]
MFCR r17,FPCR
ST64 r17,[r16+3080]
MFCR r17,FPSR
ST64 r17,[r16+3088]
KMOV r17,r1,1
ST64 r17,[r16+3104]
KMOV r17,r2,1
ST64 r17,[r16+3112]
KMOV r17,r3,1
ST64 r17,[r16+3120]
KMOV r17,r4,1
ST64 r17,[r16+3128]
KMOV r17,r5,1
ST64 r17,[r16+3136]
KMOV r17,r6,1
ST64 r17,[r16+3144]
KMOV r17,r7,1
ST64 r17,[r16+3152]
ADDI r17,r16,1024
VST v32,r17,r0,0,0,7,0
ADDI r17,r16,1088
VST v33,r17,r0,0,0,7,0
ADDI r17,r16,1152
VST v34,r17,r0,0,0,7,0
ADDI r17,r16,1216
