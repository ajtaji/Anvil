LI r15,0
CALLR r18,r254
zen_payload_return:
LI r16,1
MTCR.CLEAR r0,r16,STATUS
MFCR r16,STATUS
BNEI r16,0,zen_payload_bad_context
MFCR r16,PROT
BNEI r16,0,zen_payload_bad_protection
LIQ r16,anvil_zen_payload_save
ADDI r16,r16,63
LI r17,-64
AND r16,r16,r17
ST64 r1,[r16+3096]
LD64 r17,[r16+3072]
MTCR r0,r17,EVEC
LD64 r17,[r16+3080]
MTCR r0,r17,FPCR
