LDM r128-r255,[r16]
LD64 r1,[r16+3096]
JR r254
zen_payload_bad_context:
LI r16,$5A01
HALT r16
zen_payload_bad_protection:
LI r16,$5A02
HALT r16

.align 64
anvil_zen_payload_save:
  .org anvil_zen_payload_save+3160
.align 16
anvil_zen_context:
  ; magic, version, size; device table/source/RAM/loader SP/stack bottom/top;
  ; vectors, compiled entry, saved STATUS, image extent, stack size, call boundary.
  .word $4E455A4C49564E41,2,128,0,0,0,0,0,0
  .word anvil_zen_vectors,ZEN_COMPILED_ENTRY,0,ZEN_IMAGE_LOAD,anvil_zen_image_end,ZEN_STACK_BYTES,anvil_zen_payload_call
anvil_zen_image_end:
