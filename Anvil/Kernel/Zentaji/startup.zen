VST v60,r17,r0,0,0,7,0
ADDI r17,r16,2880
VST v61,r17,r0,0,0,7,0
ADDI r17,r16,2944
VST v62,r17,r0,0,0,7,0
ADDI r17,r16,3008
VST v63,r17,r0,0,0,7,0
OR r18,r1,r0
OR r1,r2,r0
OR r255,r3,r0
MTCR r0,r0,FPCR
MTCR r0,r0,FPSR
LI r2,0
LI r3,0
LI r4,0
LI r5,0
LI r6,0
LI r7,0
LI r8,0
LI r9,0
