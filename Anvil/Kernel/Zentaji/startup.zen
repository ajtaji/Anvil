LD64 r17,[r16+3152]
KMOV r7,r17,0
LDM r128-r255,[r16]
LD64 r1,[r16+3096]
JR r254
zen_payload_bad_context:
LI r16,$5A01
HALT r16
zen_payload_bad_protection:
LI r16,$5A02
HALT r16


; Private supervisor diagnostic vectors. Only core 0 may install this table.
; The monitor checks ownership and prepares the one-shot timer interrupt.
; All other causes jump to their ordinary vector by a fixed assembler branch.
.align 4096
anvil_diag_vectors:
.org anvil_diag_vectors+0
  JMP anvil_zen_vectors+0
.org anvil_diag_vectors+64
  JMP anvil_zen_vectors+64
.org anvil_diag_vectors+128
  JMP anvil_zen_vectors+128
.org anvil_diag_vectors+192
  JMP anvil_zen_vectors+192
.org anvil_diag_vectors+256
  JMP anvil_zen_vectors+256
.org anvil_diag_vectors+320
  JMP anvil_zen_vectors+320
.org anvil_diag_vectors+384
  JMP anvil_zen_vectors+384
.org anvil_diag_vectors+448
  JMP anvil_zen_vectors+448
.org anvil_diag_vectors+512
  JMP anvil_zen_vectors+512
.org anvil_diag_vectors+576
  JMP anvil_zen_vectors+576
.org anvil_diag_vectors+640
  JMP anvil_zen_vectors+640
