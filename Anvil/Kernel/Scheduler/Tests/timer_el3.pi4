XIncludeFile "RaspberryPi4/Lib/interrupts.pi4"
XIncludeFile "Anvil/Kernel/Scheduler/timer_el3.pbi"
Procedure Main()
  PokeI($6000000, InterruptInit($8000))
  PokeI($6000008, AtPrepare(5000))
  PokeI($6000010, AtControl())
  PokeI($6000018, AtArm())
  PokeI($6000020, AtAcknowledge())
  PokeI($6000100, 1)
  PokeI($6000028, AtAcknowledge())
  PokeI($6000100, 2)
  PokeI($6000030, AtAcknowledge())
  PokeI($6000038, AtRelease())
  PokeI($6000040, AtControl())
  PokeI($6000048, AtCompare())
  PokeI($6000100, 3)
  PokeI($6000050, AtPrepare(5000))
  PokeI($6000100, 4)
  PokeI($6000058, AtPrepare(5000))
  PokeI($6000100, 5)
  PokeI($6000060, AtPrepare(5000))
  PokeI($6000100, 6)
  PokeI($6000068, AtPrepare(5000))
EndProcedure
