XIncludeFile "Anvil/Kernel/Scheduler/scheduler.pbi"
XIncludeFile "Anvil/Kernel/Scheduler/cooperative_a64.pbi"
XIncludeFile "Anvil/Kernel/Scheduler/Tests/register_probe.pbi"
Global checks.i
Global failures.i
Global fp_control.i
Global fp_status.i
ProcedureNaked TestFpSet()
  ASM
    adrp x9, global_fp_control
    add x9, x9, #:lo12:global_fp_control
    ldr x10, [x9]
    msr fpcr, x10
    adrp x9, global_fp_status
    add x9, x9, #:lo12:global_fp_status
    ldr x10, [x9]
    msr fpsr, x10
    ret
  ENDASM
EndProcedure
ProcedureNaked TestFpRead()
  ASM
    adrp x9, global_fp_control
    add x9, x9, #:lo12:global_fp_control
    mrs x10, fpcr
    str x10, [x9]
    adrp x9, global_fp_status
    add x9, x9, #:lo12:global_fp_status
    mrs x10, fpsr
    str x10, [x9]
    ret
  ENDASM
EndProcedure
Global Dim addresses.i[2]
Global Dim progress.i[2]
Procedure Check(a.i, b.i)
  checks = checks + 1
  If a <> b : failures = failures + 1 : EndIf
EndProcedure
Procedure.i Application()
  Protected id.i
  Protected persistent.i
  Protected n.i
  id = ScArgument()
  persistent = 100 + id
  addresses[id] = @persistent
  For n = 0 To 2
    persistent = persistent + id + 1
    progress[id] = progress[id] + 1
    Check(ScYield(), 1)
    TestFpRead()
    Check(fp_control, (id + 1) * 4194304)
    Check(fp_status, id + 1)
    Check(persistent, 100 + id + (n + 1) * (id + 1))
  Next
  Check(ScWait(77 + id, 100), 1)
  Check(persistent, 103 + id * 4)
  ProcedureReturn persistent
EndProcedure
Procedure Main()
  Protected a.i
  Protected b.i
  Protected n.i
  Protected old.i
  Check(ScConfigure(0, 16), 0)
  Check(ScConfigure($7FFFFFFFFFFFFFFC, 16), 0)
  Check(ScConfigure($400000, $200000), 1)
  Check(ScCreate($300000, 0), 0)
  Check(ScCreate($600000, 0), 0)
  Check(ScCreate(0, 0), 0)
  Check(ScCreate(3, 0), 0)
  Check(ScYield(), 0)
  fp_control = 4194304 : fp_status = 1 : TestFpSet()
  a = ScCreate(@Application, 0)
  fp_control = 8388608 : fp_status = 2 : TestFpSet()
  b = ScCreate(@Application, 1)
  fp_control = 0 : fp_status = 0 : TestFpSet()
  Check(a > 0, 1)
  Check(b > 0, 1)
  For n = 0 To 2
    Check(ScRunOne(), a)
    Check(ScRunOne(), b)
  Next
  Check(addresses[0] <> addresses[1], 1)
  Check(progress[0], 3)
  Check(progress[1], 3)
  TestFpRead()
  Check(fp_control, 0)
  Check(fp_status, 0)
  Check(ScRunOne(), a)
  Check(ScRunOne(), b)
  Check(SchedState(a), #SCHED_WAITING)
  Check(SchedState(b), #SCHED_WAITING)
  Check(ScRunOne(), 0)
  Check(SchedWake(77, 1), 1)
  Check(ScRunOne(), a)
  Check(SchedState(a), #SCHED_DONE)
  Check(ScResult(a), 103)
  Check(SchedAdvance(100), 1)
  Check(ScRunOne(), b)
  Check(SchedState(b), #SCHED_DONE)
  Check(ScResult(b), 107)
  Check(ScReap(a), 1)
  Check(ScReap(b), 1)
  Check(PeekI(addresses[0]), 0)
  Check(PeekI(addresses[1]), 0)
  old = a
  a = ScCreate(@Application, 0)
  Check(a <> old, 1)
  Check(ScReap(old), 0)
  PokeI(ScStack(SchedSlot(a)), 0)
  Check(ScRunOne(), a)
  Check(SchedState(a), #SCHED_DONE)
  Check(ScResult(a), -1)
  Check(ScReap(a), 1)
  a = ScCreate(@Application, 0)
  PokeI(ScContext(SchedSlot(a)) + 104, 3)
  Check(ScRunOne(), a)
  Check(SchedState(a), #SCHED_DONE)
  Check(ScResult(a), -1)
  Check(ScReap(a), 1)
  For n = 8 To 15
    probe_vectors[(n - 8) * 2] = 1024 + n
    probe_vectors[(n - 8) * 2 + 1] = 2048 + n
  Next
  a = ScCreate(@RegisterProbe, 0)
  Check(ScRunOne(), a)
  Check(SchedState(a), #SCHED_READY)
  Check(ScRunOne(), a)
  Check(ScResult(a), 1)
  Check(ScReap(a), 1)
  PokeI($6000000, checks)
  PokeI($6000008, failures)
EndProcedure
