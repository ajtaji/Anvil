  NipCheck(nipEvent\code,8)
  NipCheck(nipEvent\value,0)
  NipCheck(nipEvent\x,70)
  NipCheck(nipEvent\y,80)
  NipCheck(InputUiDevicePush(7,1,26,3,-1,-1,0,1,700),0)
  NipCheck(InputFeedByte(#AIS_PHYSICAL,119),0)
  NipCheck(InputUiPop(@nipEvent),1)
  NipCheck(nipEvent\kind,1)
  NipCheck(nipEvent\code,119)
  NipCheck(InputUiPop(@nipEvent),1)
  NipCheck(NativeInputEventValid(@nipEvent),1)
  NipCheck(nipEvent\kind,7)
  NipCheck(nipEvent\code,26)
  NipCheck(nipEvent\value,1)
  NipCheck(nipEvent\modifiers,3)
  NipCheck(InputUiDevicePush(7,1,26,0,-1,-1,0,0,701),0)
  NipCheck(InputUiPop(@nipEvent),1)
  NipCheck(NativeInputEventValid(@nipEvent),1)
  NipCheck(nipEvent\kind,7)
  NipCheck(nipEvent\code,26)
  NipCheck(nipEvent\value,0)
