  NipShape(7,1,26,0,0,-1,0,1)
  NipCheck(NativeInputEventValid(@nipEvent),0)
  NipShape(7,1,26,0,-1,-1,1,1)
  NipCheck(NativeInputEventValid(@nipEvent),0)
  total=0 : order=0 : shape=0 : sumX=0
  For round=1 To 2
    For i=1 To 64
      total=total+InputUiDevicePush(5,4,0,0,i,20,0,4,500+round*64+i)
    Next
    For i=1 To 64
      total=total+InputUiPop(@nipEvent)
      If nipEvent\x<>i : order=order+1 : EndIf
      shape=shape+1-NativeInputEventValid(@nipEvent)
      sumX=sumX+nipEvent\x
    Next
  Next
  NipCheck(total,128)
  NipCheck(order,0)
  NipCheck(shape,0)
  NipCheck(sumX,4160)
  NipCheck(InputUiPop(@nipEvent),0)
