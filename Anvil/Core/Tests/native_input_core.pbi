; SPDX-License-Identifier: MIT
; Deterministic normalized-input and payload-lifetime qualification.
; Executes real shared code on the CPU; no physical-input actuation claim.
Global nipClock.i=1000,gLastCR.i
Procedure.i Ticks()
  nipClock=nipClock+1 : ProcedureReturn nipClock
EndProcedure
XIncludeFile "Anvil/Core/input_events.pbi"
XIncludeFile "Anvil/Core/input_ui.pbi"
XIncludeFile "Anvil/Hal/input_service.pbi"
Global nipChecks.i,nipFailure.i,nipResult.i,nipResetResult.i,nipNested.i,nipCalls.i
Global nipEvent.NativeInputEvent
Global Dim nipTyped.q[4]
Global Dim nipGuard.q[8]
Procedure NipCheck(actual.i,expected.i)
  nipChecks=nipChecks+1
  PokeI(#NIP_REPORT+112+nipChecks*16,actual)
  PokeI(#NIP_REPORT+120+nipChecks*16,expected)
  If actual<>expected And nipFailure=0 : nipFailure=nipChecks : EndIf
  PokeI(#NIP_REPORT+16,nipChecks) : PokeI(#NIP_REPORT+24,nipFailure)
EndProcedure
Procedure.i NipProvider(op.i,context.i,request.i,bytes.i)
  nipCalls=nipCalls+1
  If request=99
    nipNested=InputServiceEnter()
  EndIf
  ProcedureReturn nipResult
EndProcedure
Procedure.i NipReset()
  ProcedureReturn nipResetResult
EndProcedure
Procedure NipShape(kind.i,source.i,code.i,mods.i,x.i,y.i,buttons.i,value.i)
  nipEvent\kind=kind : nipEvent\source=source : nipEvent\code=code : nipEvent\modifiers=mods
  nipEvent\x=x : nipEvent\y=y : nipEvent\buttons=buttons : nipEvent\value=value
  nipEvent\ticks=100 : nipEvent\generation=1 : nipEvent\reserved=0
EndProcedure
Procedure.i Main(services.i)
  Protected i.i,total.i,round.i,order.i,shape.i,sumX.i
  For i=0 To 8191 Step 8 : PokeI(#NIP_REPORT+i,0) : Next
  PokeI(#NIP_REPORT,$4E495031) : PokeI(#NIP_REPORT+8,1)

  NipCheck(SizeOf(NativeInputEvent),48)
  NipCheck(SizeOf(NativeInputApi),32)
  NipCheck(SizeOf(NativeInputOpenRequest),40)
  NipCheck(#AIK_ENTER,1)
