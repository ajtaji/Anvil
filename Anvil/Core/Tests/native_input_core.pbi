  NipCheck(InputUiPop(@nipEvent),-22401)
  NipCheck(InputEventsPop(@nipTyped[0]),1)
  NipCheck(PeekL(@nipTyped[0]),4)
  NipCheck(InputEventsPop(@nipTyped[0]),1)
  NipCheck(PeekL(@nipTyped[0]+8),90)
  NipCheck(InputUiBegin(),0)
  NipCheck(InputFocusGeneration(),6)
  total=0
  For i=1 To 64 : total=total+InputUiDevicePush(5,4,0,0,i,20,0,4,200+i) : Next
  NipCheck(total,0)
  NipCheck(InputUiDevicePush(5,4,0,0,65,20,0,4,265),-22405)
  NipCheck(InputUiOverflowCount(),1)
  NipCheck(InputUiPop(@nipEvent),1)
