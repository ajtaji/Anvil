; SPDX-License-Identifier: MIT
; Controlled native event records on real target CPU; no physical input claim.
EnableFloatingPoint
XIncludeFile "Anvil/Graphics/neon_canvas_input.pbi"
Global ci.NeonCanvasInput,vp.NeonCanvasViewport,ev.NativeInputEvent
Global ciCount.i,ciFailure.i
Procedure CiCheck(actual.i,expected.i)
  PokeI(#NIP_REPORT+128+ciCount*16,actual) : PokeI(#NIP_REPORT+136+ciCount*16,expected)
  ciCount=ciCount+1
  If actual<>expected And ciFailure=0 : ciFailure=ciCount : EndIf
  PokeI(#NIP_REPORT+16,ciCount) : PokeI(#NIP_REPORT+24,ciFailure)
EndProcedure
Procedure CiShape(kind.i,source.i,code.i,mods.i,x.i,y.i,buttons.i,value.i,ticks.i,generation.i)
  ev\kind=kind : ev\source=source : ev\code=code : ev\modifiers=mods
  ev\x=x : ev\y=y : ev\buttons=buttons : ev\value=value
  ev\ticks=ticks : ev\generation=generation : ev\reserved=0
EndProcedure

Procedure.i Main(services.i)
  Protected i.i
  For i=0 To 8191 Step 8 : PokeI(#NIP_REPORT+i,0) : Next
  PokeI(#NIP_REPORT,$4E434931) : PokeI(#NIP_REPORT+8,1)
