  CiCheck(ci\pointer\down,1)
  CiCheck(Bool(ci\pointer\x<0.0),1)
  CiShape(5,4,0,0,50,400,0,2,7,1)
  CiCheck(NeonCanvasInputFeed(@ci,@ev),0)
  CiCheck(ci\pointer\down,0)
  CiCheck(ci\pointer\released,1)
  CiCheck(Bool(ci\pointer\x<0.0),1)
