Global Dim nifWork.q[1026]
Global Dim nifOutput.q[8194]
Global nifState.NeonInflateState,nifFailure.i,nifChecks.i
Procedure NifCheck(actual.i,expected.i)
  PokeI(#NIF_REPORT+256+nifChecks*16,actual) : PokeI(#NIF_REPORT+264+nifChecks*16,expected)
  nifChecks=nifChecks+1
  If actual<>expected And nifFailure=0 : nifFailure=nifChecks : EndIf
EndProcedure
Procedure NifCase(index.i,source.i,bytes.i,mode.i,capacity.i,expected.i,outputOffset.i)
  Protected rc.i,i.i,p.i=#NIF_REPORT+4096+index*64
  For i=0 To 65551 : PokeA(@nifOutput[0]+i,165) : Next
  For i=0 To 8207 : PokeA(@nifWork[0]+i,90) : Next
  If mode=0
    rc=NeonInflateRaw(@nifState,@nifWork[1],8192,source,bytes,@nifOutput[1],capacity)
  Else
    rc=NeonInflateZlib(@nifState,@nifWork[1],8192,source,bytes,@nifOutput[1],capacity)
  EndIf
  NifCheck(rc,expected)
  PokeI(p,rc) : PokeI(p+8,nifState\produced) : PokeI(p+16,nifState\error) : PokeI(p+24,nifState\offset)
  PokeI(p+32,PeekI(@nifOutput[0])) : PokeI(p+40,PeekA(@nifOutput[1]+capacity) & 255)
  PokeI(p+48,PeekI(@nifWork[0])) : PokeI(p+56,PeekI(@nifWork[1025]))
  If rc>=0
    For i=0 To rc-1 : PokeA(#NIF_REPORT+outputOffset+i,PeekA(@nifOutput[1]+i)) : Next
  EndIf
EndProcedure
