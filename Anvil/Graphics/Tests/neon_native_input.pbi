; SPDX-License-Identifier: MIT
; Pure event translation qualification with explicit controlled input records.
EnableFloatingPoint
XIncludeFile "Anvil/Graphics/neon_native_input.pbi"
Global nnChecks.i,nnFailure.i
Global nnPointer.NeonPointerState,nnInput.NeonNativeInputState,nnEvent.NativeInputEvent
Procedure NnCheck(actual.i,expected.i)
  nnChecks=nnChecks+1
  PokeI(#NIP_REPORT+112+nnChecks*16,actual)
  PokeI(#NIP_REPORT+120+nnChecks*16,expected)
  If actual<>expected And nnFailure=0 : nnFailure=nnChecks : EndIf
  PokeI(#NIP_REPORT+16,nnChecks) : PokeI(#NIP_REPORT+24,nnFailure)
EndProcedure
Procedure NnShape(kind.i,source.i,code.i,mods.i,x.i,y.i,buttons.i,value.i,ticks.i,generation.i)
  nnEvent\kind=kind : nnEvent\source=source : nnEvent\code=code : nnEvent\modifiers=mods
  nnEvent\x=x : nnEvent\y=y : nnEvent\buttons=buttons : nnEvent\value=value
  nnEvent\ticks=ticks : nnEvent\generation=generation : nnEvent\reserved=0
EndProcedure
Procedure.i Main(services.i)
  Protected i.i
  For i=0 To 8191 Step 8 : PokeI(#NIP_REPORT+i,0) : Next
  PokeI(#NIP_REPORT,$4E4E4931) : PokeI(#NIP_REPORT+8,1)
  NnCheck(NeonPointerConfigure(@nnPointer,1280,800,640,400),0)
  NnShape(5,4,0,0,200,100,0,4,10,1)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(MathBitsOf(nnPointer\x),1120403456)
  NnCheck(MathBitsOf(nnPointer\y),1112014848)
  NnCheck(nnPointer\down,0)
  NnCheck(nnPointer\pressed,0)
  NnCheck(nnPointer\changed,1)
  NnCheck(nnInput\generation,1)
  NnShape(5,4,0,0,200,100,1,0,11,1)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnPointer\down,1)
  NnCheck(nnPointer\pressed,1)
  NnCheck(nnPointer\contact,0)
  NnShape(5,4,0,0,220,110,3,1,12,1)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnPointer\down,1)
  NnCheck(nnPointer\pressed,0)
  NnCheck(nnPointer\released,0)
  NnShape(5,4,0,0,220,110,2,1,13,1)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnPointer\down,0)
  NnCheck(nnPointer\released,1)
  NnCheck(nnPointer\contact,-1)
  NnShape(5,4,0,0,220,110,0,2,14,1)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnPointer\down,0)
  NnCheck(nnPointer\released,0)
  NnCheck(NeonNativeInputIdle(@nnPointer,@nnInput),0)
  NnCheck(nnPointer\changed,0)
  NnCheck(MathBitsOf(nnPointer\x),1121714176)
  NnShape(5,5,8,0,400,200,1,0,20,1)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnPointer\down,1)
  NnCheck(nnPointer\contact,8)
  NnCheck(MathBitsOf(nnPointer\x),1128792064)
  NnShape(5,4,0,0,100,100,0,4,21,1)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnPointer\down,1)
  NnCheck(nnPointer\contact,8)
  NnCheck(nnPointer\changed,0)
  NnShape(5,5,9,0,400,200,0,2,22,1)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnPointer\down,1)
  NnCheck(nnPointer\changed,0)
  NnShape(5,5,8,0,400,200,0,2,23,1)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnPointer\down,0)
  NnCheck(nnPointer\released,1)
  NnShape(6,4,0,0,400,200,0,-3,24,1)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnInput\wheel,-3)
  NnCheck(MathBitsOf(nnPointer\x),1128792064)
  NnShape(6,4,0,0,100,100,0,5,23,1)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnInput\wheel,0)
  NnCheck(nnPointer\changed,0)
  NnCheck(MathBitsOf(nnPointer\x),1128792064)
  NnShape(4,1,4,0,-1,-1,0,0,25,2)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnPointer\cancelled,1)
  NnCheck(nnPointer\down,0)
  NnCheck(nnPointer\released,0)
  NnCheck(nnInput\generation,2)
  NnShape(1,1,65,0,-1,-1,0,0,26,1)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),-22301)
  NnCheck(nnInput\scalar,0)
  NnCheck(nnPointer\cancelled,1)
  nnEvent\generation=3
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),-22301)
  NnShape(4,1,4,0,-1,-1,0,0,27,3)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnInput\generation,3)
  NnShape(1,1,65,0,-1,-1,0,0,28,3)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnInput\scalar,65)
  NnCheck(nnInput\key,0)
  NnCheck(nnPointer\cancelled,0)
  NnShape(2,1,1,0,-1,-1,0,0,30,3)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnInput\key,7)
  NnCheck(nnInput\scalar,0)
  NnShape(2,1,2,0,-1,-1,0,0,30,3)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnInput\key,1)
  NnCheck(nnInput\scalar,0)
  NnShape(2,1,3,0,-1,-1,0,0,30,3)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnInput\key,2)
  NnCheck(nnInput\scalar,0)
  NnShape(2,1,4,0,-1,-1,0,0,30,3)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnInput\key,3)
  NnCheck(nnInput\scalar,0)
  NnShape(2,1,5,0,-1,-1,0,0,30,3)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnInput\key,4)
  NnCheck(nnInput\scalar,0)
  NnShape(2,1,6,0,-1,-1,0,0,30,3)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnInput\key,5)
  NnCheck(nnInput\scalar,0)
  NnShape(2,1,7,0,-1,-1,0,0,30,3)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnInput\key,6)
  NnCheck(nnInput\scalar,0)
  NnShape(2,1,9,0,-1,-1,0,0,30,3)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnInput\key,8)
  NnCheck(nnInput\scalar,0)
  NnShape(2,1,8,0,-1,-1,0,0,30,3)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnInput\key,0)
  NnCheck(nnInput\scalar,0)
  NnShape(2,1,11,0,-1,-1,0,0,30,3)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnInput\key,0)
  NnCheck(nnInput\scalar,0)
  NnShape(2,1,15,0,-1,-1,0,0,30,3)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnInput\key,0)
  NnCheck(nnInput\scalar,0)
  NnShape(7,1,4,2,-1,-1,0,1,31,3)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnInput\key,9)
  NnCheck(nnInput\ctrl,1)
  NnCheck(nnInput\scalar,0)
  NnShape(7,1,6,2,-1,-1,0,1,31,3)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnInput\key,10)
  NnCheck(nnInput\ctrl,1)
  NnCheck(nnInput\scalar,0)
  NnShape(7,1,27,2,-1,-1,0,1,31,3)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnInput\key,11)
  NnCheck(nnInput\ctrl,1)
  NnCheck(nnInput\scalar,0)
  NnShape(7,1,25,2,-1,-1,0,1,31,3)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnInput\key,12)
  NnCheck(nnInput\ctrl,1)
  NnCheck(nnInput\scalar,0)
  NnShape(7,1,4,2,-1,-1,0,0,32,3)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnInput\key,0)
  NnShape(7,1,4,0,-1,-1,0,1,33,3)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),0)
  NnCheck(nnInput\key,0)
  NnCheck(nnInput\scalar,0)
  NnShape(5,4,0,0,1280,100,0,4,34,3)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),-22300)
  nnEvent\x=100 : nnEvent\reserved=1
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,@nnEvent),-22300)
  NnCheck(NeonNativeInputIdle(@nnPointer,0),-22300)
  NnCheck(NeonNativeInputFeed(@nnPointer,@nnInput,0),-22300)
  NnCheck(NeonNativeInputIdle(@nnPointer,@nnInput),0)
  NnCheck(nnInput\key,0)
  NnCheck(nnInput\scalar,0)
  NnCheck(nnInput\ctrl,0)
  NnCheck(nnInput\wheel,0)
  ProcedureReturn nnFailure
EndProcedure
