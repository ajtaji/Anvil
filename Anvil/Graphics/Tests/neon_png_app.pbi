; Entire PNG containers, exact RGBA/masks, transactional failures and resident images.
EnableFloatingPoint
#CRC_POLY=$EDB88320
XIncludeFile "Anvil/Core/crc.pbi"
XIncludeFile "Anvil/Math/float32.pbi"
