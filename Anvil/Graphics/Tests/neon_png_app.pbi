Global Dim nptRgba.q[130]
Global Dim nptMask.q[34]
Global Dim nptScratch.q[4098]
Global Dim nptHandles.i[8]
Global Dim nptEncoded.q[514]
Global nptFailure.i,nptChecks.i
Procedure NptCheck(actual.i,expected.i)
  PokeI(#NPT_REPORT+256+nptChecks*16,actual) : PokeI(#NPT_REPORT+264+nptChecks*16,expected)
  nptChecks=nptChecks+1 : If actual<>expected And nptFailure=0 : nptFailure=nptChecks : EndIf
EndProcedure
Procedure NptCase(index.i,source.i,bytes.i,key.i,inspectRc.i,decodeRc.i,rgbaCapacity.i,maskCapacity.i,scratchCapacity.i,native.i)
  Protected info.NeonPngInfo,out.NeonSpriteAssetInfo,rc.i,i.i,p.i=#NPT_REPORT+16384+index*1536,h.i
  For i=0 To SizeOf(NeonPngInfo)-1 : PokeA(@info+i,165) : Next
  For i=0 To 1039 : PokeA(@nptRgba[0]+i,165) : Next
  For i=0 To 271 : PokeA(@nptMask[0]+i,90) : Next
  For i=0 To 32783 : PokeA(@nptScratch[0]+i,60) : Next
  out\width=991 : out\height=992
  rc=NeonPngInspect(@info,source,bytes) : NptCheck(rc,inspectRc) : PokeI(p,rc)
  For i=0 To 103 : PokeA(p+64+i,PeekA(@info+i)) : Next
  PokeI(p+48,source)
  rc=NeonPngDecode(@out,source,bytes,@nptRgba[1],rgbaCapacity,key,@nptMask[1],maskCapacity,@nptScratch[1],scratchCapacity)
  NptCheck(rc,decodeRc) : PokeI(p+8,rc) : PokeI(p+16,out\width) : PokeI(p+24,out\height)
  PokeI(p+32,PeekI(@nptScratch[0])) : PokeI(p+40,PeekI(@nptScratch[4097]))
  For i=0 To 1039 : PokeA(p+192+i,PeekA(@nptRgba[0]+i)) : Next
  For i=0 To 271 : PokeA(p+1248+i,PeekA(@nptMask[0]+i)) : Next
  If native>0
    h=NeonServiceSpriteLoadPNGMemory(native,source,bytes,@nptRgba[1],1024,key,@nptMask[1],256,@nptScratch[1],32768)
    NptCheck(Bool(h>0),1) : nptHandles[native-1]=h
  EndIf
  For i=0 To 1023 : PokeA(@nptRgba[1]+i,0) : Next
  For i=0 To 32767 : PokeA(@nptScratch[1]+i,0) : Next
EndProcedure
Procedure NptArgs(source.i,bytes.i)
  Protected out.NeonSpriteAssetInfo,meta.NeonPngInfo,i.i,bad.i
  out\width=991 : out\height=992
  For i=0 To 103 : PokeA(@meta+i,165) : Next
  For i=0 To 1023 : PokeA(@nptRgba[1]+i,165) : Next
  For i=0 To 255 : PokeA(@nptMask[1]+i,90) : Next
  For i=0 To 32767 : PokeA(@nptScratch[1]+i,60) : Next
  For i=0 To bytes-1 : PokeA(@nptEncoded[1]+i,PeekA(source+i)) : Next
  NptCheck(NeonPngDecode(0,source,bytes,@nptRgba[1],1024,-1,@nptMask[1],256,@nptScratch[1],32768),#NEON_PNG_ERR_ARGUMENT)
  NptCheck(NeonPngDecode(@out+1,source,bytes,@nptRgba[1],1024,-1,@nptMask[1],256,@nptScratch[1],32768),#NEON_PNG_ERR_ARGUMENT)
  NptCheck(NeonPngDecode(@out,0,bytes,@nptRgba[1],1024,-1,@nptMask[1],256,@nptScratch[1],32768),#NEON_PNG_ERR_ARGUMENT)
  NptCheck(NeonPngDecode(@out,source,0,@nptRgba[1],1024,-1,@nptMask[1],256,@nptScratch[1],32768),#NEON_PNG_ERR_ARGUMENT)
  NptCheck(NeonPngDecode(@out,source,16777217,@nptRgba[1],1024,-1,@nptMask[1],256,@nptScratch[1],32768),#NEON_PNG_ERR_ARGUMENT)
  NptCheck(NeonPngDecode(@out,source,bytes,0,1024,-1,@nptMask[1],256,@nptScratch[1],32768),#NEON_PNG_ERR_ARGUMENT)
  NptCheck(NeonPngDecode(@out,source,bytes,source,1024,-1,@nptMask[1],256,@nptScratch[1],32768),#NEON_PNG_ERR_ARGUMENT)
  NptCheck(NeonPngDecode(@out,source,bytes,@nptRgba[1],1024,-2,@nptMask[1],256,@nptScratch[1],32768),#NEON_PNG_ERR_ARGUMENT)
  NptCheck(NeonPngDecode(@out,source,bytes,@nptRgba[1],1024,16777216,@nptMask[1],256,@nptScratch[1],32768),#NEON_PNG_ERR_ARGUMENT)
  NptCheck(NeonPngDecode(@out,source,bytes,@nptRgba[1],1024,-1,@nptRgba[1],256,@nptScratch[1],32768),#NEON_PNG_ERR_ARGUMENT)
  NptCheck(NeonPngDecode(@out,source,bytes,@nptRgba[1],1024,-1,@nptMask[1],256,@nptScratch[1]+1,32768),#NEON_PNG_ERR_ARGUMENT)
  NptCheck(NeonPngDecode(@out,source,bytes,@nptRgba[1],1024,-1,@nptMask[1],256,@nptRgba[1],32768),#NEON_PNG_ERR_ARGUMENT)
  NptCheck(NeonPngDecode(@nptRgba[1],source,bytes,@nptRgba[1],1024,-1,@nptMask[1],256,@nptScratch[1],32768),#NEON_PNG_ERR_ARGUMENT)
  NptCheck(NeonPngDecode(@out,$7FFFFFFFFFFFFFFF,bytes,@nptRgba[1],1024,-1,@nptMask[1],256,@nptScratch[1],32768),#NEON_PNG_ERR_ARGUMENT)
  NptCheck(NeonPngInspect(@meta+1,source,bytes),#NEON_PNG_ERR_ARGUMENT)
  NptCheck(NeonPngInspect(@nptEncoded[1],@nptEncoded[1],bytes),#NEON_PNG_ERR_ARGUMENT)
  NptCheck(out\width,991) : NptCheck(out\height,992)
  For i=0 To 103 : If (PeekA(@meta+i) & 255)<>165 : bad=bad+1 : EndIf : Next
  NptCheck(bad,0) : bad=0
  For i=0 To 1023
    If (PeekA(@nptRgba[1]+i) & 255)<>165 : bad=bad+1 : EndIf
    PokeA(#NPT_REPORT+4096+i,PeekA(@nptRgba[1]+i))
  Next
  For i=0 To 255
    If (PeekA(@nptMask[1]+i) & 255)<>90 : bad=bad+1 : EndIf
    PokeA(#NPT_REPORT+5120+i,PeekA(@nptMask[1]+i))
  Next
  NptCheck(bad,0) : bad=0
  For i=0 To 32767 : If (PeekA(@nptScratch[1]+i) & 255)<>60 : bad=bad+1 : EndIf : Next
  NptCheck(bad,0)
EndProcedure
