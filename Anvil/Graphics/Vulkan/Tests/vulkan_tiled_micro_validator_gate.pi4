; SPDX-License-Identifier: MIT
; Pure UIF microcopy byte-window preflight, without hardware access.
Procedure.i V3dTfuBegin(w.i, h.i, kind.i) : ProcedureReturn -1 : EndProcedure
Procedure.i V3dTfuSourceRaster(base.i, stride.i, bytes.i) : ProcedureReturn -1 : EndProcedure
Procedure.i V3dTfuSourceUifNoXor(base.i, h.i, bytes.i) : ProcedureReturn -1 : EndProcedure
Procedure.i V3dTfuDest(base.i, fmt.i, bytes.i) : ProcedureReturn -1 : EndProcedure
Procedure.i V3dTfuSubmit() : ProcedureReturn -1 : EndProcedure
Procedure.i V3dTfuWait(us.i) : ProcedureReturn -1 : EndProcedure
XIncludeFile "Anvil/Graphics/Vulkan/vk_v3d_texture.pi4"

Procedure.i Main()
  Define rect.AvkV3dTextureRectCopy, plan.AvkV3dTexturePlan
  rect\windowBase = $06000000 : rect\windowBytes = $00100000
  rect\sourceBase = $06001000 : rect\sourceBytes = 2048
  rect\destinationBase = $06002000 : rect\destinationBytes = 2048
  rect\width = 16 : rect\height = 16 : rect\paddedWidth = 32 : rect\paddedHeight = 16
  rect\sourceX = 5 : rect\sourceY = 6 : rect\destinationX = 10 : rect\destinationY = 9
  rect\regionWidth = 2 : rect\regionHeight = 2
  If AnvilVkV3dTextureTiledMicroValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 1 : EndIf
  If plan\destinationBytes <> 2048 Or AnvilVkV3dTextureUifOffset(5, 6, 16) <> 228 Or AnvilVkV3dTextureUifOffset(10, 9, 16) <> 1304 : ProcedureReturn 2 : EndIf
  rect\sourceX = 7
  If AnvilVkV3dTextureTiledMicroValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_ARGS : ProcedureReturn 3 : EndIf
  rect\sourceX = 5 : rect\destinationX = 11
  If AnvilVkV3dTextureTiledMicroValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_ARGS : ProcedureReturn 4 : EndIf
  rect\destinationX = 10 : rect\destinationBase = rect\sourceBase
  If AnvilVkV3dTextureTiledMicroValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_OVERLAP : ProcedureReturn 5 : EndIf
  rect\destinationBase = $06002000 : rect\destinationBytes = 2047
  If AnvilVkV3dTextureTiledMicroValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_RANGE : ProcedureReturn 6 : EndIf
  rect\destinationBytes = 2048 : rect\sourceBytes = 2047
  If AnvilVkV3dTextureTiledMicroValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_RANGE : ProcedureReturn 7 : EndIf
  rect\sourceBytes = 2048 : rect\windowBytes = $2000
  If AnvilVkV3dTextureTiledMicroValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_RANGE : ProcedureReturn 8 : EndIf
  ProcedureReturn 0
EndProcedure
