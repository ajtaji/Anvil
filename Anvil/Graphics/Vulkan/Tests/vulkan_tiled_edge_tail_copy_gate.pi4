; SPDX-License-Identifier: MIT
; Public optimal-to-optimal edge-tail copy through the state-only backend.
XIncludeFile "Anvil/Graphics/Vulkan/vk_api.pbi"
XIncludeFile "Anvil/Graphics/Vulkan/vk_backend_test.pbi"

Procedure.i Main()
  Define ici.VkInstanceCreateInfo, qci.VkDeviceQueueCreateInfo, dci.VkDeviceCreateInfo
  Define pci.VkCommandPoolCreateInfo, cbai.VkCommandBufferAllocateInfo, bi.VkCommandBufferBeginInfo
  Define imgci.VkImageCreateInfo, req.VkMemoryRequirements, mai.VkMemoryAllocateInfo
  Define bar.VkImageMemoryBarrier, region.VkImageCopy, si.VkSubmitInfo
  Define inst.i, phys.i, dev.i, queue.i, pool.i, cmd.i, src.i, dst.i, aliasImage.i, smem.i, dmem.i
  Define count.i, priority.l, caps.i, calls.i, op.i, savedMem.i

  AnvilVkTestBackendHeap($06200000, $00100000)
  ici\sType = #VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO
  If vkCreateInstance(@ici, 0, @inst) <> #VK_SUCCESS : ProcedureReturn 1 : EndIf
  count = 1
  If vkEnumeratePhysicalDevices(inst, @count, @phys) <> #VK_SUCCESS : ProcedureReturn 2 : EndIf
  qci\sType = #VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO : qci\queueCount = 1 : qci\pQueuePriorities = @priority
  dci\sType = #VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO : dci\queueCreateInfoCount = 1 : dci\pQueueCreateInfos = @qci
  If vkCreateDevice(phys, @dci, 0, @dev) <> #VK_SUCCESS : ProcedureReturn 3 : EndIf
  vkGetDeviceQueue(dev, 0, 0, @queue)
  pci\sType = #VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO : pci\flags = #VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT
  If vkCreateCommandPool(dev, @pci, 0, @pool) <> #VK_SUCCESS : ProcedureReturn 4 : EndIf
  cbai\sType = #VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO
  cbai\commandPool = pool : cbai\level = #VK_COMMAND_BUFFER_LEVEL_PRIMARY : cbai\commandBufferCount = 1
  If vkAllocateCommandBuffers(dev, @cbai, @cmd) <> #VK_SUCCESS : ProcedureReturn 5 : EndIf
  bi\sType = #VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO

  imgci\sType = #VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO : imgci\imageType = #VK_IMAGE_TYPE_2D
  imgci\format = #VK_FORMAT_B8G8R8A8_UNORM
  imgci\extent\width = 13 : imgci\extent\height = 13 : imgci\extent\depth = 1
  imgci\mipLevels = 1 : imgci\arrayLayers = 1 : imgci\samples = #VK_SAMPLE_COUNT_1_BIT
  imgci\tiling = #VK_IMAGE_TILING_OPTIMAL
  imgci\usage = #VK_IMAGE_USAGE_TRANSFER_SRC_BIT | #VK_IMAGE_USAGE_TRANSFER_DST_BIT
  imgci\sharingMode = #VK_SHARING_MODE_EXCLUSIVE : imgci\initialLayout = #VK_IMAGE_LAYOUT_UNDEFINED
  If vkCreateImage(dev, @imgci, 0, @src) <> #VK_SUCCESS : ProcedureReturn 6 : EndIf
  vkGetImageMemoryRequirements(dev, src, @req)
  mai\sType = #VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO : mai\allocationSize = req\size : mai\memoryTypeIndex = 0
  If vkAllocateMemory(dev, @mai, 0, @smem) <> #VK_SUCCESS : ProcedureReturn 7 : EndIf
  If vkBindImageMemory(dev, src, smem, 0) <> #VK_SUCCESS : ProcedureReturn 8 : EndIf
  If vkCreateImage(dev, @imgci, 0, @dst) <> #VK_SUCCESS : ProcedureReturn 9 : EndIf
  vkGetImageMemoryRequirements(dev, dst, @req)
  mai\allocationSize = req\size
  If vkAllocateMemory(dev, @mai, 0, @dmem) <> #VK_SUCCESS : ProcedureReturn 10 : EndIf
  If vkBindImageMemory(dev, dst, dmem, 0) <> #VK_SUCCESS : ProcedureReturn 11 : EndIf

  bar\sType = #VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER
  bar\oldLayout = #VK_IMAGE_LAYOUT_UNDEFINED
  bar\srcQueueFamilyIndex = #VK_QUEUE_FAMILY_IGNORED : bar\dstQueueFamilyIndex = #VK_QUEUE_FAMILY_IGNORED
  bar\subresourceRange\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT
  bar\subresourceRange\levelCount = 1 : bar\subresourceRange\layerCount = 1
  If vkBeginCommandBuffer(cmd, @bi) <> #VK_SUCCESS : ProcedureReturn 12 : EndIf
  bar\image = src : bar\newLayout = #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL : bar\dstAccessMask = #VK_ACCESS_TRANSFER_READ_BIT
  vkCmdPipelineBarrier(cmd, #VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, #VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, 0, 0, 0, 1, @bar)
  bar\image = dst : bar\newLayout = #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL : bar\dstAccessMask = #VK_ACCESS_TRANSFER_WRITE_BIT
  vkCmdPipelineBarrier(cmd, #VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, #VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, 0, 0, 0, 1, @bar)
  If vkEndCommandBuffer(cmd) <> #VK_SUCCESS : ProcedureReturn 13 : EndIf
  si\sType = #VK_STRUCTURE_TYPE_SUBMIT_INFO : si\commandBufferCount = 1 : si\pCommandBuffers = @cmd
  If vkQueueSubmit(queue, 1, @si, 0) <> #VK_SUCCESS Or vkQueueWaitIdle(queue) <> #VK_SUCCESS : ProcedureReturn 14 : EndIf

  region\srcSubresource\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT : region\srcSubresource\layerCount = 1
  region\dstSubresource\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT : region\dstSubresource\layerCount = 1
  region\srcOffset\x = 8 : region\srcOffset\y = 8
  region\dstOffset\x = 8 : region\dstOffset\y = 8
  region\extent\width = 5 : region\extent\height = 5 : region\extent\depth = 1
  calls = AnvilVkTestBackendCalls() : caps = avkTbCaps
  AnvilVkTestBackendCapabilities(caps | #ANVIL_VK_CAP_TILED_RECT_COPY)
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyImage(cmd, src, #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, dst, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @region)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_UNSUPPORTED Or AnvilVkTestBackendCalls() <> calls : ProcedureReturn 15 : EndIf
  AnvilVkTestBackendCapabilities(caps | #ANVIL_VK_CAP_TILED_EDGE_TAIL_COPY)
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyImage(cmd, src, #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, dst, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @region)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_UNSUPPORTED : ProcedureReturn 16 : EndIf

  AnvilVkTestBackendCapabilities(caps | #ANVIL_VK_CAP_TILED_RECT_COPY | #ANVIL_VK_CAP_TILED_EDGE_TAIL_COPY)
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyImage(cmd, src, #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, dst, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @region)
  If vkEndCommandBuffer(cmd) <> #VK_SUCCESS : ProcedureReturn 17 : EndIf
  op = avkCbOpHead[avkCmdSlot(cmd)]
  If avkOpRows[op] <> 6 Or avkOpImageX[op] <> 8 Or avkOpImageY[op] <> 8 Or avkOpBufferOffset[op] <> 8 Or avkOpBufferPitch[op] <> 8 Or avkOpSourceBytes[op] <> 20 Or avkOpSourcePitch[op] <> 5 : ProcedureReturn 18 : EndIf
  AnvilVkTestBackendCapabilities(caps | #ANVIL_VK_CAP_TILED_RECT_COPY)
  If vkQueueSubmit(queue, 1, @si, 0) <> #ANVIL_VK_ERR_UNSUPPORTED Or AnvilVkTestBackendCalls() <> calls : ProcedureReturn 19 : EndIf
  AnvilVkTestBackendCapabilities(caps | #ANVIL_VK_CAP_TILED_RECT_COPY | #ANVIL_VK_CAP_TILED_EDGE_TAIL_COPY)
  If vkQueueSubmit(queue, 1, @si, 0) <> #VK_SUCCESS Or vkQueueWaitIdle(queue) <> #VK_SUCCESS : ProcedureReturn 20 : EndIf
  If AnvilVkTestBackendCalls() <> calls + 1 Or avkTbTiledEdgeTailCopies <> 1 Or avkTbLastRectSourceX <> 8 Or avkTbLastRectSourceY <> 8 Or avkTbLastRectDestinationX <> 8 Or avkTbLastRectDestinationY <> 8 Or avkTbLastRectWidth <> 5 Or avkTbLastRectHeight <> 5 : ProcedureReturn 21 : EndIf
  calls = AnvilVkTestBackendCalls()
  avkOpImageX[op] = 4
  If vkQueueSubmit(queue, 1, @si, 0) <> #ANVIL_VK_ERR_STATE Or AnvilVkTestBackendCalls() <> calls : ProcedureReturn 22 : EndIf
  avkOpImageX[op] = 8
  savedMem = avkImgMemSlot[avkImgSlot(dst)]
  avkImgMemSlot[avkImgSlot(dst)] = avkImgMemSlot[avkImgSlot(src)]
  If vkQueueSubmit(queue, 1, @si, 0) <> #ANVIL_VK_ERR_ARGS Or AnvilVkTestBackendCalls() <> calls : ProcedureReturn 29 : EndIf
  avkImgMemSlot[avkImgSlot(dst)] = savedMem
  region\srcOffset\x = 4
  region\srcOffset\y = 4 : region\dstOffset\x = 4 : region\dstOffset\y = 4
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyImage(cmd, src, #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, dst, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @region)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_UNSUPPORTED Or AnvilVkTestBackendCalls() <> calls : ProcedureReturn 23 : EndIf
  region\srcOffset\x = 7 : region\srcOffset\y = 8 : region\dstOffset\x = 8 : region\dstOffset\y = 8
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyImage(cmd, src, #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, dst, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @region)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_UNSUPPORTED : ProcedureReturn 24 : EndIf
  region\srcOffset\x = 8

  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyImage(cmd, src, #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, dst, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @region)
  vkCmdCopyImage(cmd, src, #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, dst, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @region)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_UNSUPPORTED Or AnvilVkTestBackendCalls() <> calls : ProcedureReturn 25 : EndIf

  If vkCreateImage(dev, @imgci, 0, @aliasImage) <> #VK_SUCCESS : ProcedureReturn 26 : EndIf
  If vkBindImageMemory(dev, aliasImage, smem, 0) <> #VK_SUCCESS : ProcedureReturn 27 : EndIf
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyImage(cmd, src, #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, aliasImage, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @region)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_ARGS : ProcedureReturn 28 : EndIf
  ProcedureReturn 0
EndProcedure
