; SPDX-License-Identifier: MIT
; Pure up-to-sixteen-utile grid preflight, with no DMA access.
Procedure.i V3dTfuBegin(w.i, h.i, kind.i) : ProcedureReturn -1 : EndProcedure
Procedure.i V3dTfuSourceRaster(base.i, stride.i, bytes.i) : ProcedureReturn -1 : EndProcedure
Procedure.i V3dTfuSourceUifNoXor(base.i, h.i, bytes.i) : ProcedureReturn -1 : EndProcedure
Procedure.i V3dTfuDest(base.i, fmt.i, bytes.i) : ProcedureReturn -1 : EndProcedure
Procedure.i V3dTfuSubmit() : ProcedureReturn -1 : EndProcedure
Procedure.i V3dTfuWait(us.i) : ProcedureReturn -1 : EndProcedure
XIncludeFile "Anvil/Graphics/Vulkan/vk_v3d_texture.pi4"

Procedure.i Main()
  Define rect.AvkV3dTextureLinearRectCopy, plan.AvkV3dTexturePlan
  rect\windowBase = $06000000 : rect\windowBytes = $00100000
  rect\sourceBase = $06001040 : rect\sourceBytes = 148 : rect\sourcePitch = 32
  rect\sourceViewWidth = 5 : rect\sourceViewHeight = 5
  rect\destinationBase = $06002000 : rect\destinationBytes = 2048
  rect\width = 16 : rect\height = 16 : rect\paddedWidth = 32 : rect\paddedHeight = 16
  rect\sourceX = 0 : rect\sourceY = 0 : rect\destinationX = 3 : rect\destinationY = 3
  rect\regionWidth = 5 : rect\regionHeight = 5
  If AnvilVkV3dTextureGridValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 1 : EndIf
  If AnvilVkV3dTextureUifOffset(3, 3, 16) <> 60 Or AnvilVkV3dTextureUifOffset(4, 3, 16) <> 112 Or AnvilVkV3dTextureUifOffset(3, 4, 16) <> 140 Or AnvilVkV3dTextureUifOffset(4, 4, 16) <> 192 Or plan\destinationBytes <> 2048 : ProcedureReturn 2 : EndIf
  ; The last intersection starts at source offset 36 and ends at 148.
  rect\sourceBytes = 147
  If AnvilVkV3dTextureGridValidate(@rect, @plan) = #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 3 : EndIf
  rect\sourceBytes = 148 : rect\destinationBytes = 2047
  If AnvilVkV3dTextureGridValidate(@rect, @plan) = #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 4 : EndIf
  rect\destinationBytes = 2048 : rect\destinationBase = $06001000
  If AnvilVkV3dTextureGridValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_OVERLAP : ProcedureReturn 5 : EndIf
  ; At x=4 the first 4-column tile fits; the later 1-column tile breaks stride.
  rect\destinationBase = $06080000 : rect\destinationX = 4
  rect\sourcePitch = 32772 : rect\sourceBytes = 131108
  If AnvilVkV3dTextureGridValidate(@rect, @plan) = #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 6 : EndIf
  rect\sourcePitch = 32768 : rect\sourceBytes = 131092
  If AnvilVkV3dTextureGridValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 7 : EndIf
  rect\destinationX = 3 : rect\sourcePitch = 32 : rect\sourceBytes = 184
  rect\regionWidth = 6 : rect\regionHeight = 6 : rect\sourceViewWidth = 6 : rect\sourceViewHeight = 6
  If AnvilVkV3dTextureGridValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 8 : EndIf
  rect\regionWidth = 9 : rect\regionHeight = 9 : rect\sourceViewWidth = 9 : rect\sourceViewHeight = 9
  rect\sourcePitch = 48 : rect\sourceBytes = 420
  If AnvilVkV3dTextureGridValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 9 : EndIf
  rect\regionWidth = 13 : rect\regionHeight = 13 : rect\sourceViewWidth = 13 : rect\sourceViewHeight = 13
  rect\sourcePitch = 64 : rect\sourceBytes = 820
  If AnvilVkV3dTextureGridValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 10 : EndIf
  rect\regionWidth = 9 : rect\sourceViewWidth = 9 : rect\sourcePitch = 48 : rect\sourceBytes = 612
  If AnvilVkV3dTextureGridValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 13 : EndIf
  rect\regionWidth = 13 : rect\regionHeight = 9 : rect\sourceViewWidth = 13 : rect\sourceViewHeight = 9
  rect\sourcePitch = 64 : rect\sourceBytes = 564
  If AnvilVkV3dTextureGridValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 14 : EndIf
  ; A one-column final intersection controls the skip even after two full tiles.
  rect\regionWidth = 10 : rect\sourceViewWidth = 10
  rect\sourcePitch = 32772 : rect\sourceBytes = 262216
  If AnvilVkV3dTextureGridValidate(@rect, @plan) = #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 15 : EndIf
  rect\sourcePitch = 32768 : rect\sourceBytes = 262184
  If AnvilVkV3dTextureGridValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 16 : EndIf
  rect\width = 32 : rect\height = 32 : rect\paddedHeight = 32 : rect\destinationBytes = 4096
  rect\regionWidth = 17 : rect\regionHeight = 13 : rect\sourceViewWidth = 17 : rect\sourceViewHeight = 13
  rect\sourcePitch = 80 : rect\sourceBytes = 1028
  If AnvilVkV3dTextureGridValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_ARGS : ProcedureReturn 11 : EndIf
  rect\regionWidth = 13 : rect\regionHeight = 17 : rect\sourceViewWidth = 13 : rect\sourceViewHeight = 17
  rect\sourcePitch = 64 : rect\sourceBytes = 1076
  If AnvilVkV3dTextureGridValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_ARGS : ProcedureReturn 12 : EndIf
  ProcedureReturn 0
EndProcedure
