; SPDX-License-Identifier: MIT
; Public partial buffer-to-optimal upload on the state-only backend.
XIncludeFile "Anvil/Graphics/Vulkan/vk_api.pbi"
XIncludeFile "Anvil/Graphics/Vulkan/vk_backend_test.pbi"

Procedure.i Main()
  Define ici.VkInstanceCreateInfo, qci.VkDeviceQueueCreateInfo, dci.VkDeviceCreateInfo
  Define pci.VkCommandPoolCreateInfo, cbai.VkCommandBufferAllocateInfo, bi.VkCommandBufferBeginInfo
  Define imgci.VkImageCreateInfo, bufci.VkBufferCreateInfo, req.VkMemoryRequirements
  Define mai.VkMemoryAllocateInfo, bar.VkImageMemoryBarrier, r.VkBufferImageCopy, si.VkSubmitInfo
  Define inst.i, phys.i, dev.i, queue.i, pool.i, cmd.i, img.i, imem.i, imgTail.i, imemTail.i, buf.i, bmem.i, aliasBuf.i
  Define count.i, priority.l, calls.i, caps.i, first.i, second.i

  AnvilVkTestBackendHeap($06200000, $00100000)
  ici\sType = #VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO
  If vkCreateInstance(@ici, 0, @inst) <> #VK_SUCCESS : ProcedureReturn 1 : EndIf
  count = 1
  If vkEnumeratePhysicalDevices(inst, @count, @phys) <> #VK_SUCCESS : ProcedureReturn 2 : EndIf
  qci\sType = #VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO : qci\queueCount = 1 : qci\pQueuePriorities = @priority
  dci\sType = #VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO : dci\queueCreateInfoCount = 1 : dci\pQueueCreateInfos = @qci
  If vkCreateDevice(phys, @dci, 0, @dev) <> #VK_SUCCESS : ProcedureReturn 3 : EndIf
  vkGetDeviceQueue(dev, 0, 0, @queue)
  pci\sType = #VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO : pci\flags = #VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT
  If vkCreateCommandPool(dev, @pci, 0, @pool) <> #VK_SUCCESS : ProcedureReturn 4 : EndIf
  cbai\sType = #VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO
  cbai\commandPool = pool : cbai\level = #VK_COMMAND_BUFFER_LEVEL_PRIMARY : cbai\commandBufferCount = 1
  If vkAllocateCommandBuffers(dev, @cbai, @cmd) <> #VK_SUCCESS : ProcedureReturn 5 : EndIf
  bi\sType = #VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO

  imgci\sType = #VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO : imgci\imageType = #VK_IMAGE_TYPE_2D
  imgci\format = #VK_FORMAT_B8G8R8A8_UNORM
  imgci\extent\width = 16 : imgci\extent\height = 16 : imgci\extent\depth = 1
  imgci\mipLevels = 1 : imgci\arrayLayers = 1 : imgci\samples = #VK_SAMPLE_COUNT_1_BIT
  imgci\tiling = #VK_IMAGE_TILING_OPTIMAL : imgci\usage = #VK_IMAGE_USAGE_TRANSFER_DST_BIT
  imgci\sharingMode = #VK_SHARING_MODE_EXCLUSIVE : imgci\initialLayout = #VK_IMAGE_LAYOUT_UNDEFINED
  If vkCreateImage(dev, @imgci, 0, @img) <> #VK_SUCCESS : ProcedureReturn 6 : EndIf
  vkGetImageMemoryRequirements(dev, img, @req)
  mai\sType = #VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO : mai\allocationSize = req\size : mai\memoryTypeIndex = 0
  If vkAllocateMemory(dev, @mai, 0, @imem) <> #VK_SUCCESS : ProcedureReturn 7 : EndIf
  If vkBindImageMemory(dev, img, imem, 0) <> #VK_SUCCESS : ProcedureReturn 8 : EndIf
  bufci\sType = #VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO : bufci\size = 4096
  bufci\usage = #VK_BUFFER_USAGE_TRANSFER_SRC_BIT : bufci\sharingMode = #VK_SHARING_MODE_EXCLUSIVE
  If vkCreateBuffer(dev, @bufci, 0, @buf) <> #VK_SUCCESS : ProcedureReturn 9 : EndIf
  vkGetBufferMemoryRequirements(dev, buf, @req)
  mai\allocationSize = req\size
  If vkAllocateMemory(dev, @mai, 0, @bmem) <> #VK_SUCCESS : ProcedureReturn 10 : EndIf
  If vkBindBufferMemory(dev, buf, bmem, 0) <> #VK_SUCCESS : ProcedureReturn 11 : EndIf
  bar\sType = #VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER
  bar\oldLayout = #VK_IMAGE_LAYOUT_UNDEFINED : bar\newLayout = #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL
  bar\dstAccessMask = #VK_ACCESS_TRANSFER_WRITE_BIT
  bar\srcQueueFamilyIndex = #VK_QUEUE_FAMILY_IGNORED : bar\dstQueueFamilyIndex = #VK_QUEUE_FAMILY_IGNORED
  bar\image = img : bar\subresourceRange\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT
  bar\subresourceRange\levelCount = 1 : bar\subresourceRange\layerCount = 1
  If vkBeginCommandBuffer(cmd, @bi) <> #VK_SUCCESS : ProcedureReturn 12 : EndIf
  vkCmdPipelineBarrier(cmd, #VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, #VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, 0, 0, 0, 1, @bar)
  If vkEndCommandBuffer(cmd) <> #VK_SUCCESS : ProcedureReturn 13 : EndIf
  si\sType = #VK_STRUCTURE_TYPE_SUBMIT_INFO : si\commandBufferCount = 1 : si\pCommandBuffers = @cmd
  If vkQueueSubmit(queue, 1, @si, 0) <> #VK_SUCCESS : ProcedureReturn 14 : EndIf
  If vkQueueWaitIdle(queue) <> #VK_SUCCESS : ProcedureReturn 15 : EndIf

  r\bufferOffset = 64 : r\bufferRowLength = 8 : r\bufferImageHeight = 8
  r\imageSubresource\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT : r\imageSubresource\layerCount = 1
  r\imageOffset\x = 8 : r\imageOffset\y = 8
  r\imageExtent\width = 4 : r\imageExtent\height = 4 : r\imageExtent\depth = 1
  calls = AnvilVkTestBackendCalls() : caps = avkTbCaps
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_UNSUPPORTED Or AnvilVkTestBackendCalls() <> calls : ProcedureReturn 16 : EndIf

  AnvilVkTestBackendCapabilities(caps | #ANVIL_VK_CAP_BUFFER_TO_TILED_RECT_COPY)
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #VK_SUCCESS : ProcedureReturn 17 : EndIf
  first = avkCbOpHead[avkCmdSlot(cmd)]
  If avkOpDstOffset[first] <> #ANVIL_VK_BUFFER_TILED_RECT_TAG Or avkOpSourceBytes[first] <> 112 Or avkOpBufferPitch[first] <> 32 Or avkOpImageX[first] <> 8 Or avkOpImageY[first] <> 8 : ProcedureReturn 18 : EndIf
  AnvilVkTestBackendCapabilities(caps)
  If vkQueueSubmit(queue, 1, @si, 0) <> #ANVIL_VK_ERR_UNSUPPORTED Or AnvilVkTestBackendCalls() <> calls : ProcedureReturn 19 : EndIf
  AnvilVkTestBackendCapabilities(caps | #ANVIL_VK_CAP_BUFFER_TO_TILED_RECT_COPY)
  If vkQueueSubmit(queue, 1, @si, 0) <> #VK_SUCCESS : ProcedureReturn 20 : EndIf
  If vkQueueWaitIdle(queue) <> #VK_SUCCESS : ProcedureReturn 21 : EndIf
  If AnvilVkTestBackendCalls() <> calls + 1 Or avkTbLinearTiledRectCopies <> 1 Or avkTbLastLinearRectSourceBytes <> 112 Or avkTbLastLinearRectSourcePitch <> 32 Or avkTbLastLinearRectSourceViewWidth <> 4 Or avkTbLastLinearRectSourceViewHeight <> 4 Or avkTbLastLinearRectDestinationX <> 8 Or avkTbLastLinearRectDestinationY <> 8 : ProcedureReturn 22 : EndIf

  ; Zero rowLength is tightly packed: the same 4x4 region occupies 64 bytes.
  r\bufferRowLength = 0 : r\bufferImageHeight = 0
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #VK_SUCCESS : ProcedureReturn 38 : EndIf
  If vkQueueSubmit(queue, 1, @si, 0) <> #VK_SUCCESS : ProcedureReturn 39 : EndIf
  If vkQueueWaitIdle(queue) <> #VK_SUCCESS Or avkTbLastLinearRectSourceBytes <> 64 Or avkTbLastLinearRectSourcePitch <> 16 Or avkTbLinearTiledRectCopies <> 2 : ProcedureReturn 40 : EndIf
  r\bufferRowLength = 8 : r\bufferImageHeight = 8

  r\bufferOffset = 4
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_ARGS : ProcedureReturn 23 : EndIf
  r\bufferOffset = 64 : r\imageOffset\x = 6
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_UNSUPPORTED : ProcedureReturn 24 : EndIf
  r\imageOffset\x = 8 : r\bufferImageHeight = 3
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_ARGS : ProcedureReturn 25 : EndIf
  r\bufferImageHeight = 8 : r\bufferRowLength = 3
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_ARGS : ProcedureReturn 26 : EndIf
  r\bufferRowLength = 536870912
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_ARGS : ProcedureReturn 41 : EndIf
  r\bufferRowLength = 8 : r\bufferOffset = 4032
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_STATE : ProcedureReturn 27 : EndIf

  r\bufferOffset = 64
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_ARGS : ProcedureReturn 28 : EndIf

  ; A full upload followed by a corrupt partial one must start no backend job.
  r\imageOffset\x = 0 : r\imageOffset\y = 0 : r\imageExtent\width = 16 : r\imageExtent\height = 16
  r\bufferRowLength = 0 : r\bufferImageHeight = 0
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  r\imageOffset\x = 8 : r\imageOffset\y = 8 : r\imageExtent\width = 4 : r\imageExtent\height = 4
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #VK_SUCCESS : ProcedureReturn 29 : EndIf
  first = avkCbOpHead[avkCmdSlot(cmd)] : second = avkOpNext[first]
  If second = 0 : ProcedureReturn 30 : EndIf
  avkOpImageX[second] = 6
  If vkQueueSubmit(queue, 1, @si, 0) <> #ANVIL_VK_ERR_STATE Or AnvilVkTestBackendCalls() <> calls + 2 : ProcedureReturn 31 : EndIf

  ; Whole-image TFU stays available with the new partial capability off.
  AnvilVkTestBackendCapabilities(caps)
  r\imageOffset\x = 0 : r\imageOffset\y = 0 : r\imageExtent\width = 16 : r\imageExtent\height = 16
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #VK_SUCCESS : ProcedureReturn 32 : EndIf
  If vkQueueSubmit(queue, 1, @si, 0) <> #VK_SUCCESS : ProcedureReturn 33 : EndIf
  If vkQueueWaitIdle(queue) <> #VK_SUCCESS Or AnvilVkTestBackendCopies() <> 1 : ProcedureReturn 34 : EndIf

  ; A transfer-source buffer sharing the destination image's allocation is refused.
  AnvilVkTestBackendCapabilities(caps | #ANVIL_VK_CAP_BUFFER_TO_TILED_RECT_COPY)
  bufci\size = 256
  If vkCreateBuffer(dev, @bufci, 0, @aliasBuf) <> #VK_SUCCESS : ProcedureReturn 35 : EndIf
  If vkBindBufferMemory(dev, aliasBuf, imem, 0) <> #VK_SUCCESS : ProcedureReturn 36 : EndIf
  r\bufferOffset = 64 : r\bufferRowLength = 8 : r\bufferImageHeight = 8
  r\imageOffset\x = 8 : r\imageOffset\y = 8 : r\imageExtent\width = 4 : r\imageExtent\height = 4
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, aliasBuf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_ARGS : ProcedureReturn 37 : EndIf
  ; Two separate calls retain their order and lower as two bounded backend jobs.
  r\bufferOffset = 64 : r\imageOffset\x = 0 : r\imageOffset\y = 0
  calls = AnvilVkTestBackendCalls()
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  r\bufferOffset = 256 : r\imageOffset\x = 8 : r\imageOffset\y = 8
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #VK_SUCCESS : ProcedureReturn 42 : EndIf
  first = avkCbOpHead[avkCmdSlot(cmd)] : second = avkOpNext[first]
  If second = 0 Or avkOpNext[second] <> 0 Or avkOpBufferOffset[first] <> 64 Or avkOpBufferOffset[second] <> 256 Or avkOpImageX[first] <> 0 Or avkOpImageX[second] <> 8 : ProcedureReturn 43 : EndIf
  If vkQueueSubmit(queue, 1, @si, 0) <> #VK_SUCCESS : ProcedureReturn 44 : EndIf
  If vkQueueWaitIdle(queue) <> #VK_SUCCESS Or AnvilVkTestBackendCalls() <> calls + 2 Or avkTbLastLinearRectDestinationX <> 8 Or avkTbLastLinearRectDestinationY <> 8 : ProcedureReturn 45 : EndIf

  ; A later full tile overlapping the first aborts before any backend job.
  calls = AnvilVkTestBackendCalls()
  avkOpImageX[second] = 0 : avkOpImageY[second] = 0
  If vkQueueSubmit(queue, 1, @si, 0) <> #ANVIL_VK_ERR_STATE Or AnvilVkTestBackendCalls() <> calls : ProcedureReturn 46 : EndIf

  ; A third partial call cannot exceed this command-buffer subset.
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  r\bufferOffset = 64 : r\imageOffset\x = 0 : r\imageOffset\y = 0
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  r\bufferOffset = 256 : r\imageOffset\x = 8 : r\imageOffset\y = 8
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  r\bufferOffset = 512 : r\imageOffset\x = 0 : r\imageOffset\y = 8
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_UNSUPPORTED Or AnvilVkTestBackendCalls() <> calls : ProcedureReturn 47 : EndIf

  ; Distinct destinations do not license overlapping source byte spans.
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  r\bufferOffset = 64 : r\imageOffset\x = 0 : r\imageOffset\y = 0
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  r\bufferOffset = 128 : r\imageOffset\x = 8 : r\imageOffset\y = 8
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_ARGS Or AnvilVkTestBackendCalls() <> calls : ProcedureReturn 48 : EndIf

  ; The cumulative tile budget is checked before any source or destination work.
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  r\bufferOffset = 64 : r\imageOffset\x = 0 : r\imageOffset\y = 0
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  r\bufferOffset = 256 : r\imageOffset\x = 8 : r\imageOffset\y = 8
  vkCmdCopyBufferToImage(cmd, buf, img, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #VK_SUCCESS : ProcedureReturn 49 : EndIf
  first = avkCbOpHead[avkCmdSlot(cmd)]
  avkOpSourcePitch[first] = 4096
  If vkQueueSubmit(queue, 1, @si, 0) <> #ANVIL_VK_ERR_UNSUPPORTED Or AnvilVkTestBackendCalls() <> calls : ProcedureReturn 50 : EndIf

  ; Edge tails use a separate backend bit and the exact final pitched row.
  imgci\extent\width = 13 : imgci\extent\height = 13
  If vkCreateImage(dev, @imgci, 0, @imgTail) <> #VK_SUCCESS : ProcedureReturn 51 : EndIf
  vkGetImageMemoryRequirements(dev, imgTail, @req)
  mai\allocationSize = req\size
  If vkAllocateMemory(dev, @mai, 0, @imemTail) <> #VK_SUCCESS : ProcedureReturn 52 : EndIf
  If vkBindImageMemory(dev, imgTail, imemTail, 0) <> #VK_SUCCESS : ProcedureReturn 53 : EndIf
  bar\image = imgTail
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdPipelineBarrier(cmd, #VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, #VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, 0, 0, 0, 1, @bar)
  If vkEndCommandBuffer(cmd) <> #VK_SUCCESS : ProcedureReturn 54 : EndIf
  If vkQueueSubmit(queue, 1, @si, 0) <> #VK_SUCCESS Or vkQueueWaitIdle(queue) <> #VK_SUCCESS : ProcedureReturn 55 : EndIf
  r\bufferOffset = 64 : r\bufferRowLength = 8 : r\bufferImageHeight = 8
  r\imageOffset\x = 8 : r\imageOffset\y = 8 : r\imageExtent\width = 5 : r\imageExtent\height = 5
  calls = AnvilVkTestBackendCalls()
  AnvilVkTestBackendCapabilities(caps | #ANVIL_VK_CAP_BUFFER_TO_TILED_RECT_COPY)
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, imgTail, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_UNSUPPORTED Or AnvilVkTestBackendCalls() <> calls : ProcedureReturn 56 : EndIf
  AnvilVkTestBackendCapabilities(caps | #ANVIL_VK_CAP_BUFFER_TO_TILED_RECT_COPY | #ANVIL_VK_CAP_BUFFER_TO_TILED_TAIL_COPY)
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, imgTail, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #VK_SUCCESS : ProcedureReturn 57 : EndIf
  first = avkCbOpHead[avkCmdSlot(cmd)]
  If avkOpSourceBytes[first] <> 148 Or avkOpSourcePitch[first] <> 20 Or avkOpBufferPitch[first] <> 32 : ProcedureReturn 58 : EndIf
  AnvilVkTestBackendCapabilities(caps | #ANVIL_VK_CAP_BUFFER_TO_TILED_RECT_COPY)
  If vkQueueSubmit(queue, 1, @si, 0) <> #ANVIL_VK_ERR_UNSUPPORTED Or AnvilVkTestBackendCalls() <> calls : ProcedureReturn 59 : EndIf
  AnvilVkTestBackendCapabilities(caps | #ANVIL_VK_CAP_BUFFER_TO_TILED_RECT_COPY | #ANVIL_VK_CAP_BUFFER_TO_TILED_TAIL_COPY)
  If vkQueueSubmit(queue, 1, @si, 0) <> #VK_SUCCESS Or vkQueueWaitIdle(queue) <> #VK_SUCCESS : ProcedureReturn 60 : EndIf
  If AnvilVkTestBackendCalls() <> calls + 1 Or avkTbLastLinearRectWidth <> 5 Or avkTbLastLinearRectHeight <> 5 Or avkTbLastLinearRectSourceBytes <> 148 : ProcedureReturn 61 : EndIf

  ; A nonedge short extent is refused even when the tail capability is on.
  r\imageOffset\x = 4
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, imgTail, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_UNSUPPORTED : ProcedureReturn 62 : EndIf
  r\imageOffset\x = 8 : r\imageOffset\y = 4
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyBufferToImage(cmd, buf, imgTail, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_UNSUPPORTED : ProcedureReturn 63 : EndIf

  ; Complete tile followed by a short edge tail remains ordered and atomic.
  calls = AnvilVkTestBackendCalls()
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  r\bufferOffset = 64 : r\imageOffset\x = 0 : r\imageOffset\y = 0 : r\imageExtent\width = 4 : r\imageExtent\height = 4
  vkCmdCopyBufferToImage(cmd, buf, imgTail, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  r\bufferOffset = 256 : r\imageOffset\x = 8 : r\imageOffset\y = 8 : r\imageExtent\width = 5 : r\imageExtent\height = 5
  vkCmdCopyBufferToImage(cmd, buf, imgTail, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #VK_SUCCESS : ProcedureReturn 64 : EndIf
  first = avkCbOpHead[avkCmdSlot(cmd)] : second = avkOpNext[first]
  If second = 0 Or avkOpNext[second] <> 0 : ProcedureReturn 65 : EndIf
  If vkQueueSubmit(queue, 1, @si, 0) <> #VK_SUCCESS Or vkQueueWaitIdle(queue) <> #VK_SUCCESS : ProcedureReturn 66 : EndIf
  If AnvilVkTestBackendCalls() <> calls + 2 Or avkTbLastLinearRectWidth <> 5 Or avkTbLastLinearRectHeight <> 5 : ProcedureReturn 67 : EndIf
  calls = AnvilVkTestBackendCalls()
  avkOpImageX[second] = 4
  If vkQueueSubmit(queue, 1, @si, 0) <> #ANVIL_VK_ERR_STATE Or AnvilVkTestBackendCalls() <> calls : ProcedureReturn 68 : EndIf
  ; A one-texel right/bottom tail may follow a distinct complete tile.
  calls = AnvilVkTestBackendCalls()
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  r\bufferOffset = 64 : r\imageOffset\x = 0 : r\imageOffset\y = 0 : r\imageExtent\width = 4 : r\imageExtent\height = 4
  vkCmdCopyBufferToImage(cmd, buf, imgTail, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  r\bufferOffset = 256 : r\imageOffset\x = 12 : r\imageOffset\y = 12 : r\imageExtent\width = 1 : r\imageExtent\height = 1
  vkCmdCopyBufferToImage(cmd, buf, imgTail, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @r)
  If vkEndCommandBuffer(cmd) <> #VK_SUCCESS : ProcedureReturn 69 : EndIf
  first = avkCbOpHead[avkCmdSlot(cmd)] : second = avkOpNext[first]
  If second = 0 Or avkOpSourceBytes[second] <> 4 Or avkOpRows[second] <> 1 : ProcedureReturn 70 : EndIf
  If vkQueueSubmit(queue, 1, @si, 0) <> #VK_SUCCESS Or vkQueueWaitIdle(queue) <> #VK_SUCCESS : ProcedureReturn 71 : EndIf
  If AnvilVkTestBackendCalls() <> calls + 2 Or avkTbLastLinearRectWidth <> 1 Or avkTbLastLinearRectHeight <> 1 Or avkTbLastLinearRectSourceBytes <> 4 : ProcedureReturn 72 : EndIf
  calls = AnvilVkTestBackendCalls()
  avkOpImageX[second] = 8
  If vkQueueSubmit(queue, 1, @si, 0) <> #ANVIL_VK_ERR_STATE Or AnvilVkTestBackendCalls() <> calls : ProcedureReturn 73 : EndIf
  ProcedureReturn 0
EndProcedure
