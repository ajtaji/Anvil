XIncludeFile "Anvil/Graphics/Vulkan/vk_api.pbi"
XIncludeFile "Anvil/Graphics/Vulkan/vk_backend_test.pbi"
Procedure.i Main()
  If SizeOf(AnvilVkRecordedDraw) <> 240 Or OffsetOf(AnvilVkRecordedDraw\kind) <> 8 Or OffsetOf(AnvilVkRecordedDraw\viewportX) <> 80 Or OffsetOf(AnvilVkRecordedDraw\pushWord) <> 208 Or OffsetOf(AnvilVkRecordedDraw\instanceCount) <> 224
    ProcedureReturn 1
  EndIf
  If SizeOf(AnvilVkBackendDraw) <> 304 Or OffsetOf(AnvilVkBackendDraw\pipeline) <> 8 Or OffsetOf(AnvilVkBackendDraw\clearRectX) <> 248 Or OffsetOf(AnvilVkBackendDraw\clearRectBgra) <> 280 Or OffsetOf(AnvilVkBackendDraw\instanceCount) <> 288
    ProcedureReturn 2
  EndIf
  ProcedureReturn 0
EndProcedure
