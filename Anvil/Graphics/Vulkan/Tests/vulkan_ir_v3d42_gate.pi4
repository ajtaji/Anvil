; Emitted desk gate for the isolated typed-IR -> V3D 4.2 lowerer.
; The fixtures populate AvkIrModule records directly; there is no parser,
; Vulkan pipeline, MMIO, cache or GPU dependency in this proof.

XIncludeFile "../vk_ir_v3d42.pi4"

#LG_MAGIC = $49523432
#LG_CASES = 6
Global Dim lgTypes.AvkIrType[20]
Global Dim lgConstants.AvkIrConstant[12]
Global Dim lgVariables.AvkIrVariable[12]
Global Dim lgDecorations.AvkIrDecoration[20]
Global Dim lgBlocks.AvkIrBlock[2]
Global Dim lgNodes.AvkIrNode[20]
Global Dim lgInputs.AvkIrV3d42Io[4]
Global Dim lgOutputs.AvkIrV3d42Io[4]
Global Dim lgCode.i[1024]
Global Dim lgUniform.l[384]
Global Dim lgReport.i[256]
Global lgChecks.i = 0
Global lgFails.i = 0

Procedure lgCheck(ok.i)
  lgReport[64 + lgChecks] = ok
  lgChecks = lgChecks + 1
  If ok = 0 : lgFails = lgFails + 1 : EndIf
EndProcedure

Procedure lgZero()
  Protected i.i
  i=0:While i<SizeOf(AvkIrType)*20:PokeA(@lgTypes[0]+i,0):i=i+1:Wend
  i=0:While i<SizeOf(AvkIrConstant)*12:PokeA(@lgConstants[0]+i,0):i=i+1:Wend
  i=0:While i<SizeOf(AvkIrVariable)*12:PokeA(@lgVariables[0]+i,0):i=i+1:Wend
  i=0:While i<SizeOf(AvkIrDecoration)*20:PokeA(@lgDecorations[0]+i,0):i=i+1:Wend
  i=0:While i<SizeOf(AvkIrBlock)*2:PokeA(@lgBlocks[0]+i,0):i=i+1:Wend
  i=0:While i<SizeOf(AvkIrNode)*20:PokeA(@lgNodes[0]+i,0):i=i+1:Wend
  i=0:While i<SizeOf(AvkIrV3d42Io)*4:PokeA(@lgInputs[0]+i,0):PokeA(@lgOutputs[0]+i,0):i=i+1:Wend
EndProcedure

Procedure lgType(index.i, sourceId.i, sourceOp.i, irKind.i)
  lgTypes[index]\sourceId = sourceId
  lgTypes[index]\sourceOpcode = sourceOp
  lgTypes[index]\kind = irKind
EndProcedure
Procedure lgNode(index.i, sourceId.i, sourceOp.i, irKind.i, resultType.i, operandCount.i)
  lgNodes[index]\sourceId = sourceId
  lgNodes[index]\sourceOpcode = sourceOp
  lgNodes[index]\kind = irKind
  lgNodes[index]\resultType = resultType
  lgNodes[index]\blockId = 21
  lgNodes[index]\operandCount = operandCount
EndProcedure
Procedure lgBase(*m.AvkIrModule)
  Protected clearOffset.i
  clearOffset=0
  While clearOffset<SizeOf(AvkIrModule)
    PokeA(*m+clearOffset,0)
    clearOffset=clearOffset+1
  Wend
  *m\idBound = 64
  *m\stage = #ANVIL_IR_STAGE_FRAGMENT
  *m\entryFunctionId = 20
  *m\entryFunctionOpcode = 54
  *m\functionTypeId = 6
  *m\returnTypeId = 1
  *m\entryBlockId = 21
  *m\types = @lgTypes[0]
  *m\constants = @lgConstants[0]
  *m\variables = @lgVariables[0]
  *m\decorations = @lgDecorations[0]
  *m\blocks = @lgBlocks[0]
  *m\nodes = @lgNodes[0]
EndProcedure

; vec4 Input -> vec4 Output, usable as VPM vertex or varying fragment.
Procedure lgPass(*m.AvkIrModule, shaderStage.i)
  lgZero()
  lgBase(*m)
  *m\stage = shaderStage
  *m\typeCount=6:*m\variableCount=2:*m\decorationCount=2:*m\blockCount=1:*m\nodeCount=3
  lgType(0,1,19,#ANVIL_IR_TYPE_VOID)
  lgType(1,2,22,#ANVIL_IR_TYPE_FLOAT):lgTypes[1]\width=32
  lgType(2,3,23,#ANVIL_IR_TYPE_VECTOR):lgTypes[2]\componentType=2:lgTypes[2]\componentCount=4
  lgType(3,4,32,#ANVIL_IR_TYPE_POINTER):lgTypes[3]\storageClass=1:lgTypes[3]\pointeeType=3
  lgType(4,5,32,#ANVIL_IR_TYPE_POINTER):lgTypes[4]\storageClass=3:lgTypes[4]\pointeeType=3
  lgType(5,6,33,#ANVIL_IR_TYPE_FUNCTION):lgTypes[5]\returnType=1
  lgVariables[0]\sourceId=10:lgVariables[0]\sourceOpcode=59:lgVariables[0]\pointerType=4:lgVariables[0]\storageClass=1
  lgVariables[1]\sourceId=11:lgVariables[1]\sourceOpcode=59:lgVariables[1]\pointerType=5:lgVariables[1]\storageClass=3
  lgDecorations[0]\sourceId=10:lgDecorations[0]\sourceOpcode=71:lgDecorations[0]\member=-1
  lgDecorations[0]\kind=#ANVIL_IR_DEC_LOCATION
  lgDecorations[1]\sourceId=11:lgDecorations[1]\sourceOpcode=71:lgDecorations[1]\member=-1
  lgDecorations[1]\kind=#ANVIL_IR_DEC_LOCATION
  lgBlocks[0]\sourceId=21:lgBlocks[0]\sourceOpcode=248:lgBlocks[0]\nodeCount=3
  lgNode(0,30,61,#ANVIL_IR_OP_LOAD,3,1):lgNodes[0]\operand0=10
  lgNode(1,0,62,#ANVIL_IR_OP_STORE,0,2):lgNodes[1]\operand0=11:lgNodes[1]\operand1=30
  lgNode(2,0,253,#ANVIL_IR_OP_RETURN,0,0)
EndProcedure

Procedure lgBlock(*m.AvkIrModule, storageClass.i)
  lgZero():lgBase(*m):*m\typeCount=9:*m\constantCount=1:*m\variableCount=2:*m\decorationCount=5:*m\blockCount=1:*m\nodeCount=4
  lgType(0,1,19,1):lgType(1,2,22,3):lgTypes[1]\width=32
  lgType(2,3,23,4):lgTypes[2]\componentType=2:lgTypes[2]\componentCount=4
  lgType(3,4,30,5):lgTypes[3]\memberCount=1:lgTypes[3]\member0=3
  lgType(4,5,32,6)
  lgTypes[4]\storageClass=storageClass
  lgTypes[4]\pointeeType=4
  lgType(5,6,32,6)
  lgTypes[5]\storageClass=storageClass
  lgTypes[5]\pointeeType=3
  lgType(6,7,32,6):lgTypes[6]\storageClass=3:lgTypes[6]\pointeeType=3
  lgType(7,8,21,2):lgTypes[7]\width=32:lgTypes[7]\signedness=1
  lgType(8,9,33,7):lgTypes[8]\returnType=1:*m\functionTypeId=9
  lgConstants[0]\sourceId=12:lgConstants[0]\sourceOpcode=43:lgConstants[0]\typeId=8:lgConstants[0]\wordCount=1
  lgVariables[0]\sourceId=15:lgVariables[0]\sourceOpcode=59:lgVariables[0]\pointerType=5
  lgVariables[0]\storageClass=storageClass
  lgVariables[1]\sourceId=16:lgVariables[1]\sourceOpcode=59:lgVariables[1]\pointerType=7:lgVariables[1]\storageClass=3
  lgDecorations[0]\sourceId=4:lgDecorations[0]\sourceOpcode=71:lgDecorations[0]\member=-1:lgDecorations[0]\kind=2
  lgDecorations[1]\sourceId=4:lgDecorations[1]\sourceOpcode=72:lgDecorations[1]\member=0:lgDecorations[1]\kind=10
  lgDecorations[2]\sourceId=16:lgDecorations[2]\sourceOpcode=71:lgDecorations[2]\member=-1:lgDecorations[2]\kind=7
  lgDecorations[3]\sourceId=15:lgDecorations[3]\sourceOpcode=71:lgDecorations[3]\member=-1:lgDecorations[3]\kind=8
  lgDecorations[4]\sourceId=15:lgDecorations[4]\sourceOpcode=71:lgDecorations[4]\member=-1:lgDecorations[4]\kind=9
  If storageClass=9:*m\decorationCount=3:EndIf
  lgBlocks[0]\sourceId=21:lgBlocks[0]\sourceOpcode=248:lgBlocks[0]\nodeCount=4
  lgNode(0,30,65,2,6,2):lgNodes[0]\operand0=15:lgNodes[0]\operand1=12
  lgNode(1,31,61,1,3,1):lgNodes[1]\operand0=30
  lgNode(2,0,62,6,0,2):lgNodes[2]\operand0=16:lgNodes[2]\operand1=31
  lgNode(3,0,253,7,0,0)
EndProcedure

Procedure lgSample(*m.AvkIrModule)
  lgZero():lgBase(*m):*m\typeCount=10:*m\functionTypeId=10:*m\variableCount=3:*m\decorationCount=4:*m\blockCount=1:*m\nodeCount=5
  lgType(0,1,19,1):lgType(1,2,22,3):lgTypes[1]\width=32
  lgType(2,3,23,4):lgTypes[2]\componentType=2:lgTypes[2]\componentCount=2
  lgType(3,4,23,4):lgTypes[3]\componentType=2:lgTypes[3]\componentCount=4
  lgType(4,5,25,8):lgTypes[4]\componentType=2:lgTypes[4]\imageDim=1:lgTypes[4]\imageSampled=1
  lgType(5,6,27,9):lgTypes[5]\componentType=5
  lgType(6,7,32,6):lgTypes[6]\storageClass=0:lgTypes[6]\pointeeType=6
  lgType(7,8,32,6):lgTypes[7]\storageClass=1:lgTypes[7]\pointeeType=3
  lgType(8,9,32,6):lgTypes[8]\storageClass=3:lgTypes[8]\pointeeType=4
  lgType(9,10,33,7):lgTypes[9]\returnType=1
  lgVariables[0]\sourceId=15:lgVariables[0]\sourceOpcode=59:lgVariables[0]\pointerType=7:lgVariables[0]\storageClass=0
  lgVariables[1]\sourceId=16:lgVariables[1]\sourceOpcode=59:lgVariables[1]\pointerType=8:lgVariables[1]\storageClass=1
  lgVariables[2]\sourceId=17:lgVariables[2]\sourceOpcode=59:lgVariables[2]\pointerType=9:lgVariables[2]\storageClass=3
  lgDecorations[0]\sourceId=15:lgDecorations[0]\sourceOpcode=71:lgDecorations[0]\member=-1:lgDecorations[0]\kind=8
  lgDecorations[1]\sourceId=15:lgDecorations[1]\sourceOpcode=71:lgDecorations[1]\member=-1:lgDecorations[1]\kind=9
  lgDecorations[2]\sourceId=16:lgDecorations[2]\sourceOpcode=71:lgDecorations[2]\member=-1:lgDecorations[2]\kind=7
  lgDecorations[3]\sourceId=17:lgDecorations[3]\sourceOpcode=71:lgDecorations[3]\member=-1:lgDecorations[3]\kind=7
  lgBlocks[0]\sourceId=21:lgBlocks[0]\sourceOpcode=248:lgBlocks[0]\nodeCount=5
  lgNode(0,30,61,1,6,1):lgNodes[0]\operand0=15
  lgNode(1,31,61,1,3,1):lgNodes[1]\operand0=16
  lgNode(2,32,87,5,4,2):lgNodes[2]\operand0=30:lgNodes[2]\operand1=31
  lgNode(3,0,62,6,0,2):lgNodes[3]\operand0=17:lgNodes[3]\operand1=32
  lgNode(4,0,253,7,0,0)
EndProcedure

; Two scalar VPM inputs -> vec2 construct -> extract lane one -> scalar VPM
; output. This covers both composite operations and distinct IO mappings.
Procedure lgComposite(*m.AvkIrModule)
  lgZero():lgBase(*m)
  *m\stage=#ANVIL_IR_STAGE_VERTEX
  *m\typeCount=6:*m\functionTypeId=6
  *m\variableCount=3:*m\decorationCount=3:*m\blockCount=1:*m\nodeCount=6
  lgType(0,1,19,#ANVIL_IR_TYPE_VOID)
  lgType(1,2,22,#ANVIL_IR_TYPE_FLOAT):lgTypes[1]\width=32
  lgType(2,3,23,#ANVIL_IR_TYPE_VECTOR):lgTypes[2]\componentType=2:lgTypes[2]\componentCount=2
  lgType(3,4,32,#ANVIL_IR_TYPE_POINTER):lgTypes[3]\storageClass=1:lgTypes[3]\pointeeType=2
  lgType(4,5,32,#ANVIL_IR_TYPE_POINTER):lgTypes[4]\storageClass=3:lgTypes[4]\pointeeType=2
  lgType(5,6,33,#ANVIL_IR_TYPE_FUNCTION):lgTypes[5]\returnType=1
  lgVariables[0]\sourceId=10:lgVariables[0]\sourceOpcode=59:lgVariables[0]\pointerType=4:lgVariables[0]\storageClass=1
  lgVariables[1]\sourceId=12:lgVariables[1]\sourceOpcode=59:lgVariables[1]\pointerType=4:lgVariables[1]\storageClass=1
  lgVariables[2]\sourceId=11:lgVariables[2]\sourceOpcode=59:lgVariables[2]\pointerType=5:lgVariables[2]\storageClass=3
  lgDecorations[0]\sourceId=10:lgDecorations[0]\sourceOpcode=71:lgDecorations[0]\member=-1:lgDecorations[0]\kind=7
  lgDecorations[1]\sourceId=12:lgDecorations[1]\sourceOpcode=71:lgDecorations[1]\member=-1:lgDecorations[1]\kind=7:lgDecorations[1]\value=1
  lgDecorations[2]\sourceId=11:lgDecorations[2]\sourceOpcode=71:lgDecorations[2]\member=-1:lgDecorations[2]\kind=7
  lgBlocks[0]\sourceId=21:lgBlocks[0]\sourceOpcode=248:lgBlocks[0]\nodeCount=6
  lgNode(0,30,61,#ANVIL_IR_OP_LOAD,2,1):lgNodes[0]\operand0=10
  lgNode(1,31,61,#ANVIL_IR_OP_LOAD,2,1):lgNodes[1]\operand0=12
  lgNode(2,32,80,#ANVIL_IR_OP_COMPOSITE_CONSTRUCT,3,2):lgNodes[2]\operand0=30:lgNodes[2]\operand1=31
  lgNode(3,33,81,#ANVIL_IR_OP_COMPOSITE_EXTRACT,2,1):lgNodes[3]\operand0=32:lgNodes[3]\literalCount=1:lgNodes[3]\literal0=1
  lgNode(4,0,62,#ANVIL_IR_OP_STORE,0,2):lgNodes[4]\operand0=11:lgNodes[4]\operand1=33
  lgNode(5,0,253,#ANVIL_IR_OP_RETURN,0,0)
EndProcedure

; A valid passive-IR FAdd used to prove this existing-operation commit refuses
; arithmetic loudly until the separately reviewed lowering extension lands.
Procedure lgArithmetic(*m.AvkIrModule)
  lgZero():lgBase(*m)
  *m\typeCount=4:*m\constantCount=2:*m\functionTypeId=6
  *m\variableCount=1:*m\decorationCount=1:*m\blockCount=1:*m\nodeCount=3
  lgType(0,1,19,#ANVIL_IR_TYPE_VOID)
  lgType(1,2,22,#ANVIL_IR_TYPE_FLOAT):lgTypes[1]\width=32
  lgType(2,5,32,#ANVIL_IR_TYPE_POINTER):lgTypes[2]\storageClass=3:lgTypes[2]\pointeeType=2
  lgType(3,6,33,#ANVIL_IR_TYPE_FUNCTION):lgTypes[3]\returnType=1
  lgConstants[0]\sourceId=10:lgConstants[0]\sourceOpcode=43:lgConstants[0]\typeId=2:lgConstants[0]\wordCount=1:lgConstants[0]\word0=$3F800000
  lgConstants[1]\sourceId=12:lgConstants[1]\sourceOpcode=43:lgConstants[1]\typeId=2:lgConstants[1]\wordCount=1:lgConstants[1]\word0=$40000000
  lgVariables[0]\sourceId=15:lgVariables[0]\sourceOpcode=59:lgVariables[0]\pointerType=5:lgVariables[0]\storageClass=3
  lgDecorations[0]\sourceId=15:lgDecorations[0]\sourceOpcode=71:lgDecorations[0]\member=-1:lgDecorations[0]\kind=7
  lgBlocks[0]\sourceId=21:lgBlocks[0]\sourceOpcode=248:lgBlocks[0]\nodeCount=3
  lgNode(0,30,#ANVIL_IR_SPV_FADD,#ANVIL_IR_OP_FADD,2,2):lgNodes[0]\operand0=10:lgNodes[0]\operand1=12
  lgNode(1,0,62,#ANVIL_IR_OP_STORE,0,2):lgNodes[1]\operand0=15:lgNodes[1]\operand1=30
  lgNode(2,0,253,#ANVIL_IR_OP_RETURN,0,0)
EndProcedure

Procedure lgTarget(*t.AvkIrV3d42Target, targetIndex.i, targetRole.i, inputId.i, inputComps.i, outputId.i, outputComps.i)
  Protected clearOffset.i
  clearOffset=0
  While clearOffset<SizeOf(AvkIrV3d42Target)
    PokeA(*t+clearOffset,0)
    clearOffset=clearOffset+1
  Wend
  clearOffset=0
  While clearOffset<SizeOf(AvkIrV3d42Io)*4
    PokeA(@lgInputs[0]+clearOffset,0)
    PokeA(@lgOutputs[0]+clearOffset,0)
    clearOffset=clearOffset+1
  Wend
  *t\role=targetRole
  *t\codeBase=@lgCode[targetIndex*128]
  *t\codeCapacity=1024
  *t\uniformBase=@lgUniform[targetIndex*64]
  *t\uniformCapacity=256
  *t\tlbConfig=$FFFFFFFF
  *t\inputCount=Bool(inputId<>0)
  *t\inputs=@lgInputs[0]
  *t\outputCount=1
  *t\outputs=@lgOutputs[0]
  lgInputs[0]\variableId=inputId
  lgInputs[0]\member=-1
  lgInputs[0]\firstSlot=0
  lgInputs[0]\components=inputComps
  lgOutputs[0]\variableId=outputId
  lgOutputs[0]\member=-1
  lgOutputs[0]\firstSlot=0
  lgOutputs[0]\components=outputComps
EndProcedure

Procedure lgRecord(targetIndex.i, resultCode.i, *r.AvkIrV3d42Result, *t.AvkIrV3d42Target)
  Protected reportBase.i
  reportBase=targetIndex*8
  lgReport[reportBase]=resultCode
  lgReport[reportBase+1]=*t\codeBase
  lgReport[reportBase+2]=*r\codeBytes
  lgReport[reportBase+3]=*t\uniformBase
  lgReport[reportBase+4]=*r\uniformWords
  lgReport[reportBase+5]=*r\uniformAddressWord
  lgReport[reportBase+6]=*r\textureStateWord
  lgReport[reportBase+7]=*r\tlbConfigWord
EndProcedure

Procedure.i Main()
  Protected m.AvkIrModule
  Protected t.AvkIrV3d42Target
  Protected r.AvkIrV3d42Result
  Protected rc.i
  Protected sentinel.i

  lgPass(@m,#ANVIL_IR_STAGE_VERTEX)
  lgTarget(@t,0,1,10,4,11,4)
  t\tlbConfig=0
  rc=AnvilVkIrV3d42Lower(@m,@t,@r)
  lgRecord(0,rc,@r,@t)
  lgCheck(rc=0 And r\codeBytes>0 And r\uniformWords=0)
  lgPass(@m,#ANVIL_IR_STAGE_FRAGMENT)
  lgTarget(@t,1,2,10,4,11,4)
  rc=AnvilVkIrV3d42Lower(@m,@t,@r)
  lgRecord(1,rc,@r,@t)
  lgCheck(rc=0 And r\tlbConfigWord=0 And r\uniformWords=1)
  lgBlock(@m,9)
  lgTarget(@t,2,2,0,0,16,4)
  t\pushWordCount=4:t\push0=$3F800000:t\push1=$40000000:t\push2=$40400000:t\push3=$3F800000
  rc=AnvilVkIrV3d42Lower(@m,@t,@r)
  lgRecord(2,rc,@r,@t)
  lgCheck(rc=0 And r\pushFirstWord=0 And r\uniformWords=5)
  lgBlock(@m,2)
  lgTarget(@t,3,2,0,0,16,4)
  t\uniformBlockAddress=$00102000
  rc=AnvilVkIrV3d42Lower(@m,@t,@r)
  lgRecord(3,rc,@r,@t)
  lgCheck(rc=0 And r\uniformAddressWord=0 And r\uniformConfigWord=1 And r\uniformWords=3)
  lgSample(@m)
  lgTarget(@t,4,2,16,2,17,4)
  t\textureStateAddress=$00200000:t\samplerStateAddress=$00200100
  rc=AnvilVkIrV3d42Lower(@m,@t,@r)
  lgRecord(4,rc,@r,@t)
  lgCheck(rc=0 And r\textureStateWord=0 And r\samplerStateWord=1 And r\uniformWords=3)
  lgComposite(@m)
  lgTarget(@t,5,1,10,1,11,1)
  t\inputCount=2
  lgInputs[1]\variableId=12:lgInputs[1]\member=-1:lgInputs[1]\firstSlot=1:lgInputs[1]\components=1
  t\tlbConfig=0
  rc=AnvilVkIrV3d42Lower(@m,@t,@r)
  lgRecord(5,rc,@r,@t)
  lgCheck(rc=0 And r\codeBytes>0 And r\uniformWords=0)

  ; Arithmetic nodes are represented by the passive IR but deliberately not
  ; lowered in this first commit.
  lgArithmetic(@m):lgTarget(@t,5,2,0,0,15,1)
  lgCheck(AnvilVkIrV3d42Lower(@m,@t,@r)=#ANVIL_IR_V3D42_ERR_UNSUPPORTED And AnvilVkIrV3d42SourceId()=30 And AnvilVkIrV3d42SourceOpcode()=129)
  lgPass(@m,2):lgTarget(@t,5,1,10,4,11,4)
  t\tlbConfig=0
  lgCheck(AnvilVkIrV3d42Lower(@m,@t,@r)=#ANVIL_IR_V3D42_ERR_LAYOUT)
  lgPass(@m,2):lgTarget(@t,5,2,10,4,11,4)
  m\decorationCount=3:lgDecorations[2]\sourceId=30:lgDecorations[2]\sourceOpcode=71:lgDecorations[2]\member=-1:lgDecorations[2]\kind=1
  lgCheck(AnvilVkIrV3d42Lower(@m,@t,@r)=#ANVIL_IR_V3D42_ERR_UNSUPPORTED And AnvilVkIrV3d42SourceId()=30)
  lgPass(@m,2):lgTarget(@t,5,2,10,4,11,4)
  t\codeBase=t\codeBase+4
  lgCheck(AnvilVkIrV3d42Lower(@m,@t,@r)=#ANVIL_IR_V3D42_ERR_RANGE And r\codeBytes=0)
  lgPass(@m,2):lgTarget(@t,5,2,10,4,11,4)
  t\codeCapacity=8
  lgCheck(AnvilVkIrV3d42Lower(@m,@t,@r)=#ANVIL_IR_V3D42_ERR_RANGE)
  lgPass(@m,2):lgTarget(@t,5,2,10,4,11,4)
  t\codeBase=$7FFFFFFFFFFFFFF8
  lgCheck(AnvilVkIrV3d42Lower(@m,@t,@r)=#ANVIL_IR_V3D42_ERR_RANGE And r\codeBytes=0)
  lgPass(@m,2):lgTarget(@t,5,2,10,4,11,4)
  t\uniformBase=t\codeBase+8
  lgCheck(AnvilVkIrV3d42Lower(@m,@t,@r)=#ANVIL_IR_V3D42_ERR_RANGE)
  lgPass(@m,2):lgTarget(@t,5,2,10,4,11,4)
  t\inputCount=2:lgInputs[1]\variableId=10:lgInputs[1]\member=-1:lgInputs[1]\firstSlot=4:lgInputs[1]\components=4
  lgCheck(AnvilVkIrV3d42Lower(@m,@t,@r)=#ANVIL_IR_V3D42_ERR_LAYOUT And AnvilVkIrV3d42SourceId()=10)
  lgComposite(@m):lgTarget(@t,5,1,10,1,11,1)
  t\inputCount=2
  lgInputs[1]\variableId=12:lgInputs[1]\member=-1:lgInputs[1]\firstSlot=0:lgInputs[1]\components=1
  t\tlbConfig=0
  lgCheck(AnvilVkIrV3d42Lower(@m,@t,@r)=#ANVIL_IR_V3D42_ERR_LAYOUT And AnvilVkIrV3d42SourceId()=12)
  lgPass(@m,2):lgTarget(@t,5,2,10,4,11,4)
  lgInputs[0]\components=3
  lgCheck(AnvilVkIrV3d42Lower(@m,@t,@r)=#ANVIL_IR_V3D42_ERR_LAYOUT)
  lgPass(@m,2):lgTarget(@t,5,2,10,4,11,4)
  t\uniformBlockAddress=$00102000
  lgCheck(AnvilVkIrV3d42Lower(@m,@t,@r)=#ANVIL_IR_V3D42_ERR_LAYOUT And AnvilVkIrV3d42Stage()=6)
  lgSample(@m):lgTarget(@t,5,2,16,2,17,4)
  t\textureStateAddress=$100000000:t\samplerStateAddress=$200100
  lgCheck(AnvilVkIrV3d42Lower(@m,@t,@r)=#ANVIL_IR_V3D42_ERR_LAYOUT And AnvilVkIrV3d42SourceOpcode()=87)
  lgSample(@m):lgTarget(@t,5,2,16,2,17,4)
  t\textureStateAddress=$200004:t\samplerStateAddress=$200100
  lgCheck(AnvilVkIrV3d42Lower(@m,@t,@r)=#ANVIL_IR_V3D42_ERR_LAYOUT)
  lgPass(@m,2):lgTarget(@t,5,2,10,4,11,4)
  t\codeBase=@lgCode[600]
  sentinel=PeekI(t\codeBase)
  PokeI(t\codeBase,$55AA55AA)
  t\codeCapacity=8
  rc=AnvilVkIrV3d42Lower(@m,@t,@r)
  lgCheck(rc<>0 And PeekI(t\codeBase)=$55AA55AA)
  PokeI(t\codeBase,sentinel)
  lgCheck(AnvilVkIrV3d42Lower(0,@t,@r)=#ANVIL_IR_V3D42_ERR_ARGS)

  lgReport[200]=#LG_MAGIC
  lgReport[201]=lgChecks
  lgReport[202]=lgFails
  ProcedureReturn @lgReport[0]
EndProcedure
