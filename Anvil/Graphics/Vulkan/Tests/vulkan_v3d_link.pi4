; Compile/link witness for the development lowering against the real Neon/V3D
; implementation. Main performs no MMIO; hardware execution remains root-only.
#ANVIL_VK_TEST_BACKEND = 0

XIncludeFile "RaspberryPi4/Lib/uart.pi4"
XIncludeFile "RaspberryPi4/Lib/timer.pi4"
XIncludeFile "RaspberryPi4/Lib/safety.pi4"
XIncludeFile "RaspberryPi4/Lib/mailbox.pi4"
#DSP_DMA_LINKED = 0
XIncludeFile "RaspberryPi4/Lib/display.pi4"
XIncludeFile "RaspberryPi4/Lib/v3dqpu.pi4"
XIncludeFile "RaspberryPi4/Lib/v3d.pi4"
XIncludeFile "RaspberryPi4/Lib/neon.pi4"
XIncludeFile "Anvil/Graphics/Vulkan/vk_v3d_development.pi4"

Procedure.i Main()
  ProcedureReturn AnvilVkV3dDevelopmentFormat() - #VK_FORMAT_B8G8R8A8_UNORM
EndProcedure
