  dlPut(58,Bool(*d1\scissorX=-2 And *d1\scissorY=14 And *d1\scissorW=5 And *d1\scissorH=5))
  dlPut(62,Bool(*d0\viewportX=0 And *d0\viewportY=0 And *d0\viewportW=#DL_W And *d0\viewportH=#DL_H))
  dlPut(63,Bool(*d1\viewportX=0 And *d1\viewportY=0 And *d1\viewportW=#DL_W And *d1\viewportH=#DL_H))
