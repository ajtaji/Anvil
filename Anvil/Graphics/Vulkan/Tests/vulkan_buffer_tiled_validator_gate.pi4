; SPDX-License-Identifier: MIT
; Pure exact-span buffer-view to UIF-utile preflight, without DMA access.
Procedure.i V3dTfuBegin(w.i, h.i, kind.i) : ProcedureReturn -1 : EndProcedure
Procedure.i V3dTfuSourceRaster(base.i, stride.i, bytes.i) : ProcedureReturn -1 : EndProcedure
Procedure.i V3dTfuSourceUifNoXor(base.i, h.i, bytes.i) : ProcedureReturn -1 : EndProcedure
Procedure.i V3dTfuDest(base.i, fmt.i, bytes.i) : ProcedureReturn -1 : EndProcedure
Procedure.i V3dTfuSubmit() : ProcedureReturn -1 : EndProcedure
Procedure.i V3dTfuWait(us.i) : ProcedureReturn -1 : EndProcedure
XIncludeFile "Anvil/Graphics/Vulkan/vk_v3d_texture.pi4"

Procedure.i Main()
  Define rect.AvkV3dTextureLinearRectCopy, plan.AvkV3dTexturePlan
  rect\windowBase = $06000000 : rect\windowBytes = $00100000
  rect\sourceBase = $06001040 : rect\sourceBytes = 112 : rect\sourcePitch = 32
  rect\sourceViewWidth = 4 : rect\sourceViewHeight = 4
  rect\destinationBase = $06002000 : rect\destinationBytes = 2048
  rect\width = 16 : rect\height = 16 : rect\paddedWidth = 32 : rect\paddedHeight = 16
  rect\sourceX = 0 : rect\sourceY = 0 : rect\destinationX = 8 : rect\destinationY = 8
  rect\regionWidth = 4 : rect\regionHeight = 4
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 1 : EndIf
  If plan\destinationBytes <> 2048 Or AnvilVkV3dTextureUifOffset(8, 8, 16) <> 1280 : ProcedureReturn 2 : EndIf
  rect\sourceBytes = 111
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_RANGE : ProcedureReturn 3 : EndIf
  rect\sourceBytes = 64 : rect\sourcePitch = 16
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 4 : EndIf
  rect\sourcePitch = 32 : rect\sourceBytes = 112 : rect\destinationX = 6
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_ARGS : ProcedureReturn 5 : EndIf
  rect\destinationX = 8 : rect\sourceViewWidth = 3
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_ARGS : ProcedureReturn 6 : EndIf
  rect\sourceViewWidth = 4 : rect\destinationBase = $06001000
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_OVERLAP : ProcedureReturn 7 : EndIf

  ; 256 tiles work; a 257th tile is refused before any transfer.
  rect\sourceBase = $06001040 : rect\sourcePitch = 16 : rect\sourceBytes = 16384
  rect\sourceViewWidth = 4 : rect\sourceViewHeight = 1024
  rect\destinationBase = $06030000 : rect\destinationBytes = 132096
  rect\width = 4 : rect\height = 1028 : rect\paddedWidth = 32 : rect\paddedHeight = 1032
  rect\destinationX = 0 : rect\destinationY = 0
  rect\regionWidth = 4 : rect\regionHeight = 1024
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 8 : EndIf
  rect\sourceViewHeight = 1028 : rect\sourceBytes = 16448 : rect\regionHeight = 1028
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_ARGS : ProcedureReturn 9 : EndIf
  ; The final utile writes only valid rows and columns at image edges.
  rect\sourceBase = $06001040 : rect\sourceBytes = 148 : rect\sourcePitch = 32
  rect\sourceViewWidth = 5 : rect\sourceViewHeight = 5
  rect\destinationBase = $06002000 : rect\destinationBytes = 2048
  rect\width = 13 : rect\height = 13 : rect\paddedWidth = 32 : rect\paddedHeight = 16
  rect\sourceX = 0 : rect\sourceY = 0 : rect\destinationX = 8 : rect\destinationY = 8
  rect\regionWidth = 5 : rect\regionHeight = 5
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 10 : EndIf
  rect\sourceBytes = 147
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_RANGE : ProcedureReturn 11 : EndIf
  rect\sourceBytes = 148 : rect\destinationX = 4
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_ARGS : ProcedureReturn 12 : EndIf
  rect\destinationX = 8 : rect\destinationY = 4
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_ARGS : ProcedureReturn 13 : EndIf
  rect\destinationY = 8 : rect\regionWidth = 4 : rect\sourceViewWidth = 4 : rect\sourceBytes = 144
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 14 : EndIf
  rect\regionWidth = 5 : rect\sourceViewWidth = 5 : rect\sourceBytes = 148
  rect\regionHeight = 4 : rect\sourceViewHeight = 4 : rect\sourceBytes = 116
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 15 : EndIf
  rect\regionHeight = 5 : rect\sourceViewHeight = 5
  rect\destinationBase = $06080000 : rect\sourcePitch = 32772 : rect\sourceBytes = 131108
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_ARGS : ProcedureReturn 16 : EndIf
  rect\destinationBase = $06002000 : rect\sourcePitch = 16
  rect\destinationX = 12 : rect\destinationY = 8 : rect\regionHeight = 5 : rect\sourceViewHeight = 5
  rect\width = 13 : rect\regionWidth = 1 : rect\sourceViewWidth = 1 : rect\sourceBytes = 68
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 17 : EndIf
  rect\width = 14 : rect\regionWidth = 2 : rect\sourceViewWidth = 2 : rect\sourceBytes = 72
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 18 : EndIf
  rect\width = 15 : rect\regionWidth = 3 : rect\sourceViewWidth = 3 : rect\sourceBytes = 76
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 19 : EndIf
  ; Bottom-only tails retain 16-byte tile rows and their wider stride limit.
  rect\width = 13 : rect\destinationX = 8 : rect\regionWidth = 4 : rect\sourceViewWidth = 4
  rect\destinationBase = $06080000 : rect\sourcePitch = 32780 : rect\sourceBytes = 131136
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 20 : EndIf
  rect\sourcePitch = 32784 : rect\sourceBytes = 131152
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_ARGS : ProcedureReturn 21 : EndIf
  ProcedureReturn 0
EndProcedure
