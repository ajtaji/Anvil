; SPDX-License-Identifier: MIT
; Public edge-tail recording and submission against the state-only backend.
XIncludeFile "Anvil/Graphics/Vulkan/vk_api.pbi"
XIncludeFile "Anvil/Graphics/Vulkan/vk_backend_test.pbi"

Procedure.i Main()
  Define ici.VkInstanceCreateInfo, qci.VkDeviceQueueCreateInfo
  Define dci.VkDeviceCreateInfo, pci.VkCommandPoolCreateInfo
  Define cbai.VkCommandBufferAllocateInfo, bi.VkCommandBufferBeginInfo
  Define imgci.VkImageCreateInfo, bufci.VkBufferCreateInfo
  Define req.VkMemoryRequirements, mai.VkMemoryAllocateInfo
  Define bar.VkImageMemoryBarrier, r.VkBufferImageCopy
  Define si.VkSubmitInfo
  Define inst.i, phys.i, dev.i, queue.i, pool.i, cmd.i
  Define img.i, imem.i, buf.i, bmem.i, count.i, priority.l
  Define calls.i, beforeByte.i, rc.i

  AnvilVkTestBackendHeap($06200000, $00100000)
  ici\sType = #VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO
  If vkCreateInstance(@ici, 0, @inst) <> #VK_SUCCESS : ProcedureReturn 1 : EndIf
  count = 1
  If vkEnumeratePhysicalDevices(inst, @count, @phys) <> #VK_SUCCESS : ProcedureReturn 2 : EndIf
  qci\sType = #VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO
  qci\queueCount = 1 : qci\pQueuePriorities = @priority
  dci\sType = #VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO
  dci\queueCreateInfoCount = 1 : dci\pQueueCreateInfos = @qci
  If vkCreateDevice(phys, @dci, 0, @dev) <> #VK_SUCCESS : ProcedureReturn 3 : EndIf
  vkGetDeviceQueue(dev, 0, 0, @queue)
  pci\sType = #VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO
  pci\flags = #VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT
  If vkCreateCommandPool(dev, @pci, 0, @pool) <> #VK_SUCCESS : ProcedureReturn 4 : EndIf
  cbai\sType = #VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO
  cbai\commandPool = pool : cbai\level = #VK_COMMAND_BUFFER_LEVEL_PRIMARY
  cbai\commandBufferCount = 1
  If vkAllocateCommandBuffers(dev, @cbai, @cmd) <> #VK_SUCCESS : ProcedureReturn 5 : EndIf
  bi\sType = #VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO

  imgci\sType = #VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO
  imgci\imageType = #VK_IMAGE_TYPE_2D
  imgci\format = #VK_FORMAT_B8G8R8A8_UNORM
  imgci\extent\width = 37 : imgci\extent\height = 13 : imgci\extent\depth = 1
  imgci\mipLevels = 1 : imgci\arrayLayers = 1
  imgci\samples = #VK_SAMPLE_COUNT_1_BIT
  imgci\tiling = #VK_IMAGE_TILING_OPTIMAL
  imgci\usage = #VK_IMAGE_USAGE_TRANSFER_SRC_BIT
  imgci\sharingMode = #VK_SHARING_MODE_EXCLUSIVE
  imgci\initialLayout = #VK_IMAGE_LAYOUT_UNDEFINED
  If vkCreateImage(dev, @imgci, 0, @img) <> #VK_SUCCESS : ProcedureReturn 6 : EndIf
  vkGetImageMemoryRequirements(dev, img, @req)
  mai\sType = #VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO
  mai\allocationSize = req\size : mai\memoryTypeIndex = 0
  If vkAllocateMemory(dev, @mai, 0, @imem) <> #VK_SUCCESS : ProcedureReturn 7 : EndIf
  If vkBindImageMemory(dev, img, imem, 0) <> #VK_SUCCESS : ProcedureReturn 8 : EndIf

  bufci\sType = #VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO
  bufci\size = 4096 : bufci\usage = #VK_BUFFER_USAGE_TRANSFER_DST_BIT
  bufci\sharingMode = #VK_SHARING_MODE_EXCLUSIVE
  If vkCreateBuffer(dev, @bufci, 0, @buf) <> #VK_SUCCESS : ProcedureReturn 9 : EndIf
  vkGetBufferMemoryRequirements(dev, buf, @req)
  mai\allocationSize = req\size : mai\memoryTypeIndex = 0
  If vkAllocateMemory(dev, @mai, 0, @bmem) <> #VK_SUCCESS : ProcedureReturn 10 : EndIf
  If vkBindBufferMemory(dev, buf, bmem, 0) <> #VK_SUCCESS : ProcedureReturn 11 : EndIf
  PokeA(AnvilVkBufferAddress(buf) + 64, $A5)
  beforeByte = PeekA(AnvilVkBufferAddress(buf) + 64)

  bar\sType = #VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER
  bar\oldLayout = #VK_IMAGE_LAYOUT_UNDEFINED
  bar\newLayout = #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL
  bar\dstAccessMask = #VK_ACCESS_TRANSFER_READ_BIT
  bar\srcQueueFamilyIndex = #VK_QUEUE_FAMILY_IGNORED
  bar\dstQueueFamilyIndex = #VK_QUEUE_FAMILY_IGNORED
  bar\image = img
  bar\subresourceRange\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT
  bar\subresourceRange\levelCount = 1 : bar\subresourceRange\layerCount = 1
  If vkBeginCommandBuffer(cmd, @bi) <> #VK_SUCCESS : ProcedureReturn 12 : EndIf
  vkCmdPipelineBarrier(cmd, #VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, #VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, 0, 0, 0, 1, @bar)
  If vkEndCommandBuffer(cmd) <> #VK_SUCCESS : ProcedureReturn 13 : EndIf
  si\sType = #VK_STRUCTURE_TYPE_SUBMIT_INFO
  si\commandBufferCount = 1 : si\pCommandBuffers = @cmd
  If vkQueueSubmit(queue, 1, @si, 0) <> #VK_SUCCESS : ProcedureReturn 14 : EndIf
  If vkQueueWaitIdle(queue) <> #VK_SUCCESS : ProcedureReturn 15 : EndIf
  If AnvilVkImageLayout(img) <> #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL : ProcedureReturn 16 : EndIf

  r\bufferOffset = 64 : r\bufferRowLength = 8
  r\imageSubresource\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT
  r\imageSubresource\layerCount = 1
  r\imageOffset\x = 32 : r\imageOffset\y = 8
  r\imageExtent\width = 5 : r\imageExtent\height = 5 : r\imageExtent\depth = 1
  calls = AnvilVkTestBackendCalls()
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyImageToBuffer(cmd, img, #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, buf, 1, @r)
  If vkEndCommandBuffer(cmd) <> #VK_SUCCESS : ProcedureReturn 17 : EndIf
  If vkQueueSubmit(queue, 1, @si, 0) <> #VK_SUCCESS : ProcedureReturn 18 : EndIf
  If vkQueueWaitIdle(queue) <> #VK_SUCCESS : ProcedureReturn 19 : EndIf
  If AnvilVkTestBackendCalls() <> calls + 1 Or PeekA(AnvilVkBufferAddress(buf) + 64) <> beforeByte : ProcedureReturn 20 : EndIf

  ; A short dimension away from its image edge refuses before any work.
  r\imageOffset\x = 28 : r\imageOffset\y = 4
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyImageToBuffer(cmd, img, #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, buf, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_UNSUPPORTED Or AnvilVkTestBackendCalls() <> calls + 1 : ProcedureReturn 21 : EndIf

  ; Misaligned source coordinates remain unsupported even at the edge.
  r\imageOffset\x = 32 : r\imageOffset\y = 9
  r\imageExtent\height = 4
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyImageToBuffer(cmd, img, #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, buf, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_UNSUPPORTED Or AnvilVkTestBackendCalls() <> calls + 1 : ProcedureReturn 22 : EndIf

  ; Aligned partial and whole odd extents retain their existing support.
  r\imageOffset\x = 4 : r\imageOffset\y = 4
  r\imageExtent\width = 4 : r\imageExtent\height = 4
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyImageToBuffer(cmd, img, #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, buf, 1, @r)
  If vkEndCommandBuffer(cmd) <> #VK_SUCCESS : ProcedureReturn 23 : EndIf
  r\imageOffset\x = 0 : r\imageOffset\y = 0
  r\imageExtent\width = 37 : r\imageExtent\height = 13
  r\bufferRowLength = 40
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyImageToBuffer(cmd, img, #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, buf, 1, @r)
  If vkEndCommandBuffer(cmd) <> #VK_SUCCESS : ProcedureReturn 24 : EndIf

  ; The destination span is 12*160+148 bytes, measured from bufferOffset.
  r\bufferOffset = 4096 - 2068
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyImageToBuffer(cmd, img, #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, buf, 1, @r)
  If vkEndCommandBuffer(cmd) <> #VK_SUCCESS : ProcedureReturn 25 : EndIf
  r\bufferOffset = 4096 - 2068 + 4
  vkResetCommandBuffer(cmd, 0) : vkBeginCommandBuffer(cmd, @bi)
  vkCmdCopyImageToBuffer(cmd, img, #VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, buf, 1, @r)
  If vkEndCommandBuffer(cmd) <> #ANVIL_VK_ERR_STATE Or AnvilVkTestBackendCalls() <> calls + 1 : ProcedureReturn 26 : EndIf
  ProcedureReturn 0
EndProcedure
