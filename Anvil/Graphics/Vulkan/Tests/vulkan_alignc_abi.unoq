; Core Vulkan C-layout ABI check for an AArch64 target.
; pmf:target unoq
XIncludeFile "Anvil/Graphics/Vulkan/vk_core_1_0.pbi"

Procedure.i Main()
  If SizeOf(VkBufferCopy) <> 24 : ProcedureReturn 1 : EndIf
  If OffsetOf(VkBufferCopy\dstOffset) <> 8 : ProcedureReturn 2 : EndIf
  If OffsetOf(VkBufferCopy\size) <> 16 : ProcedureReturn 3 : EndIf
  If SizeOf(VkBufferImageCopy) <> 56 : ProcedureReturn 4 : EndIf
  If OffsetOf(VkBufferImageCopy\imageSubresource) <> 16 : ProcedureReturn 5 : EndIf
  If OffsetOf(VkBufferImageCopy\imageOffset) <> 32 : ProcedureReturn 6 : EndIf
  If OffsetOf(VkBufferImageCopy\imageExtent) <> 44 : ProcedureReturn 7 : EndIf
  If SizeOf(VkMemoryBarrier) <> 24 : ProcedureReturn 8 : EndIf
  If OffsetOf(VkMemoryBarrier\pNext) <> 8 : ProcedureReturn 9 : EndIf
  If OffsetOf(VkMemoryBarrier\srcAccessMask) <> 16 : ProcedureReturn 10 : EndIf
  If SizeOf(VkPipelineCacheHeaderVersionOne) <> 32 : ProcedureReturn 11 : EndIf
  If OffsetOf(VkPipelineCacheHeaderVersionOne\pipelineCacheUUID) <> 16 : ProcedureReturn 12 : EndIf
  ProcedureReturn 0
EndProcedure