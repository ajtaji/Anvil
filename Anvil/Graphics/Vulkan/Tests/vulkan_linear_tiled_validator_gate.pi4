; SPDX-License-Identifier: MIT
; Pure linear-row to UIF-utile preflight, without hardware access.
Procedure.i V3dTfuBegin(w.i, h.i, kind.i) : ProcedureReturn -1 : EndProcedure
Procedure.i V3dTfuSourceRaster(base.i, stride.i, bytes.i) : ProcedureReturn -1 : EndProcedure
Procedure.i V3dTfuSourceUifNoXor(base.i, h.i, bytes.i) : ProcedureReturn -1 : EndProcedure
Procedure.i V3dTfuDest(base.i, fmt.i, bytes.i) : ProcedureReturn -1 : EndProcedure
Procedure.i V3dTfuSubmit() : ProcedureReturn -1 : EndProcedure
Procedure.i V3dTfuWait(us.i) : ProcedureReturn -1 : EndProcedure
XIncludeFile "Anvil/Graphics/Vulkan/vk_v3d_texture.pi4"

Procedure.i Main()
  Define rect.AvkV3dTextureLinearRectCopy, plan.AvkV3dTexturePlan
  rect\windowBase = $06000000 : rect\windowBytes = $00100000
  rect\sourceBase = $06001000 : rect\sourceBytes = 1024 : rect\sourcePitch = 64
  rect\destinationBase = $06002000 : rect\destinationBytes = 2048
  rect\width = 16 : rect\height = 16
  rect\paddedWidth = 32 : rect\paddedHeight = 16
  rect\sourceX = 3 : rect\sourceY = 5
  rect\destinationX = 8 : rect\destinationY = 8
  rect\regionWidth = 4 : rect\regionHeight = 4
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 1 : EndIf
  If plan\destinationBytes <> 2048 Or AnvilVkV3dTextureUifOffset(8, 8, 16) <> 1280 : ProcedureReturn 2 : EndIf
  rect\sourcePitch = 80 : rect\sourceBytes = 1280
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 11 : EndIf
  rect\sourcePitch = 64 : rect\sourceBytes = 1024
  rect\destinationX = 6
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_ARGS : ProcedureReturn 3 : EndIf
  rect\destinationX = 8 : rect\sourceX = 13
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_ARGS : ProcedureReturn 4 : EndIf
  rect\sourceX = 3 : rect\destinationBase = rect\sourceBase
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_OVERLAP : ProcedureReturn 5 : EndIf
  rect\destinationBase = $06002000 : rect\sourceBytes = 1023
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_RANGE : ProcedureReturn 6 : EndIf
  rect\sourceBytes = 1024 : rect\destinationBytes = 2047
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_RANGE : ProcedureReturn 7 : EndIf
  rect\destinationBytes = 2048 : rect\sourcePitch = 32800
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_ARGS : ProcedureReturn 8 : EndIf

  ; The last 4-byte-aligned DMA stride below the signed 16-bit limit works;
  ; the next aligned pitch exceeds it before a descriptor can be emitted.
  rect\width = 4 : rect\height = 4
  rect\paddedWidth = 32 : rect\paddedHeight = 8
  rect\sourcePitch = 32780 : rect\sourceBytes = 131120
  rect\destinationBase = $06030000 : rect\destinationBytes = 1024
  rect\sourceX = 0 : rect\sourceY = 0 : rect\destinationX = 0 : rect\destinationY = 0
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 12 : EndIf
  rect\sourcePitch = 32784 : rect\sourceBytes = 131136
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_ARGS : ProcedureReturn 13 : EndIf

  ; 4 x 1024 texels are 256 tiles; one more tile is refused.
  rect\sourcePitch = 16 : rect\sourceBytes = 16448
  rect\width = 4 : rect\height = 1028
  rect\paddedWidth = 32 : rect\paddedHeight = 1032
  rect\destinationBase = $06030000 : rect\destinationBytes = 132096
  rect\sourceX = 0 : rect\sourceY = 0
  rect\destinationX = 0 : rect\destinationY = 0
  rect\regionWidth = 4 : rect\regionHeight = 1024
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn 9 : EndIf
  rect\regionHeight = 1028
  If AnvilVkV3dTextureLinearRectValidate(@rect, @plan) <> #ANVIL_V3D_TEXTURE_ERR_ARGS : ProcedureReturn 10 : EndIf
  ProcedureReturn 0
EndProcedure
