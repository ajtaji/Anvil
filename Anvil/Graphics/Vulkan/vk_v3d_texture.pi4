; ======================================================================
;  V3D 4.2 optimal-tiled texture transfers and layout
; ======================================================================
; SPDX-License-Identifier: MIT
;
; The Pi 4 Vulkan backend uses this component to plan and transfer exact
; four-byte texels between raster staging and V3D UIF_NO_XOR level-zero images.
; TFU handles writes to tiled memory; guarded 2D DMA reads utile rows back
; into linear images because TFU cannot produce raster output.
;
; REQUIRES RaspberryPi4/Lib/v3d.pi4 before this file. House rule 10 keeps
; libraries from including libraries, so the Pi 4 composition lists both.
; The five V3dTfu* calls below are the TFU hardware seam.
;
; SOURCE CONTRACT (Mesa 24.3.4 files saved in the Pi 4 Reference vault):
;   v3dx_tfu.c:57-77,92-156
;     - TFU copies are exact: no scaling or pixel conversion;
;     - a four-byte copy deliberately selects R32_FLOAT only to describe the
;       texel width accepted by TFU;
;     - raster IIS is byte pitch divided by cpp;
;     - output cannot be raster; UIF_NO_XOR is output code 6;
;     - level-zero UIF OPAD is extra padded-height blocks beyond align(h,8).
;   v3d_tiling.h:29-63 and v3d_tiling.c:35-61,149-210
;     - a 32-bit utile is 4x4 and 64 bytes;
;     - a UIF block is 2x2 utiles: 8x8 and 256 bytes;
;     - UIF blocks are grouped in four columns, hence width alignment 32.
;   v3d_resource.c:575-698
;     - a level-zero UIF slice aligns width to four UIF blocks and height to
;       one UIF block, and its byte size is padded_width * cpp * padded_height.
;
; UIF_NO_XOR is one of Mesa's two normal UIF layouts, not a linear or UBLINEAR
; shortcut. Fixing it here deliberately avoids Mesa's optional bank-placement
; padding/XOR policy. Because paddedHeight is exactly align(height, 8), OPAD is
; zero, matching the existing V3dTfuBegin encoder rather than leaving a hidden
; resource-layout dependency.
;
; FORMAT OWNERSHIP. This file does NOT call the bytes BGRA8. R32_FLOAT=29 is
; named RAW32_TTYPE because Mesa uses it for every exact four-byte copy and
; states that no format conversion occurs. A later Vulkan owner must prove
; that its VkFormat's byte representation is the one its sampler state names.
;
; CACHE OWNERSHIP. V3dTfuSubmit cleans the exact source and destination spans
; before launch; V3dTfuWait invalidates the destination after the bounded wait.
; Duplicating either operation here would create two owners that can drift.

#ANVIL_V3D_TEXTURE_OK             = 0
#ANVIL_V3D_TEXTURE_ERR_ARGS       = -23101
#ANVIL_V3D_TEXTURE_ERR_RANGE      = -23102
#ANVIL_V3D_TEXTURE_ERR_OVERLAP    = -23103

#ANVIL_V3D_TEXTURE_TEXEL_BYTES    = 4
#ANVIL_V3D_TEXTURE_UTILE_W        = 4
#ANVIL_V3D_TEXTURE_UTILE_H        = 4
#ANVIL_V3D_TEXTURE_UIF_BLOCK_W    = 8
#ANVIL_V3D_TEXTURE_UIF_BLOCK_H    = 8
#ANVIL_V3D_TEXTURE_UIF_COLUMNS    = 4
#ANVIL_V3D_TEXTURE_WIDTH_ALIGN    = 32
#ANVIL_V3D_TEXTURE_HEIGHT_ALIGN   = 8
#ANVIL_V3D_TEXTURE_DEST_ALIGN     = 4096
#ANVIL_V3D_TEXTURE_SOURCE_ALIGN   = 64
#ANVIL_V3D_TEXTURE_MAX_DIM        = 4096
#ANVIL_V3D_TEXTURE_MAX_TIMEOUT_US = 1000000
#ANVIL_V3D_TEXTURE_MAX_RECT_UTILES = 256
#ANVIL_V3D_TEXTURE_GPU_LIMIT      = $100000000

; V3D 4.2 packet values. These names state their role in this module rather
; than pretending that an opaque raw-word copy has a Vulkan color format.
#ANVIL_V3D_TEXTURE_RAW32_TTYPE    = 29
#ANVIL_V3D_TEXTURE_TFU_UIF_NO_XOR = 6
#ANVIL_V3D_TEXTURE_MEM_UIF_NO_XOR = 4

Structure AvkV3dTexturePlan Align #PB_Structure_AlignC
  width.i
  height.i
  sourcePitch.i
  sourceStrideTexels.i
  sourceReadBytes.i
  paddedWidth.i
  paddedHeight.i
  destinationBytes.i
  texelBytes.i
  rawTextureType.i
  tfuOutputFormat.i
  textureMemoryFormat.i
  outputPadBlocks.i
EndStructure

Structure AvkV3dTextureTransfer Align #PB_Structure_AlignC
  windowBase.i
  windowBytes.i
  sourceBase.i
  sourceBytes.i
  destinationBase.i
  destinationBytes.i
  width.i
  height.i
  sourcePitch.i
  timeoutUs.i
EndStructure

Structure AvkV3dTextureTiledCopy Align #PB_Structure_AlignC
  windowBase.i
  windowBytes.i
  sourceBase.i
  sourceBytes.i
  destinationBase.i
  destinationBytes.i
  width.i
  height.i
  paddedWidth.i
  paddedHeight.i
  timeoutUs.i
EndStructure

Structure AvkV3dTextureReadback Align #PB_Structure_AlignC
  windowBase.i
  windowBytes.i
  sourceBase.i
  sourceBytes.i
  destinationBase.i
  destinationBytes.i
  destinationPitch.i
  width.i
  height.i
  paddedWidth.i
  paddedHeight.i
  sourceX.i
  sourceY.i
  regionWidth.i
  regionHeight.i
EndStructure

Structure AvkV3dTextureRectCopy Align #PB_Structure_AlignC
  windowBase.i
  windowBytes.i
  sourceBase.i
  sourceBytes.i
  destinationBase.i
  destinationBytes.i
  width.i
  height.i
  paddedWidth.i
  paddedHeight.i
  sourceX.i
  sourceY.i
  destinationX.i
  destinationY.i
  regionWidth.i
  regionHeight.i
EndStructure

Structure AvkV3dTextureLinearRectCopy Align #PB_Structure_AlignC
  windowBase.i
  windowBytes.i
  sourceBase.i
  sourceBytes.i
  sourcePitch.i
  sourceViewWidth.i
  sourceViewHeight.i
  destinationBase.i
  destinationBytes.i
  width.i
  height.i
  paddedWidth.i
  paddedHeight.i
  sourceX.i
  sourceY.i
  destinationX.i
  destinationY.i
  regionWidth.i
  regionHeight.i
EndStructure

Procedure avkV3dTexturePlanClear(*plan.AvkV3dTexturePlan)
  If *plan = 0 : ProcedureReturn 0 : EndIf
  *plan\width = 0
  *plan\height = 0
  *plan\sourcePitch = 0
  *plan\sourceStrideTexels = 0
  *plan\sourceReadBytes = 0
  *plan\paddedWidth = 0
  *plan\paddedHeight = 0
  *plan\destinationBytes = 0
  *plan\texelBytes = 0
  *plan\rawTextureType = 0
  *plan\tfuOutputFormat = 0
  *plan\textureMemoryFormat = 0
  *plan\outputPadBlocks = 0
EndProcedure

; Pure, side-effect-free layout planning. The 4096 bound is this component's
; supported subset, not a claim that IOS's 16-bit dimensions are exhausted.
; It also makes every multiplication below provably fit a signed 64-bit .i.
Procedure.i AnvilVkV3dTexturePlanBuild(width.i, height.i, sourcePitch.i, *plan.AvkV3dTexturePlan)
  Protected rowBytes.i
  Protected paddedW.i
  Protected paddedH.i
  Protected readBytes.i
  Protected dstBytes.i

  If *plan = 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  avkV3dTexturePlanClear(*plan)

  If width < 1 Or width > #ANVIL_V3D_TEXTURE_MAX_DIM
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS
  EndIf
  If height < 1 Or height > #ANVIL_V3D_TEXTURE_MAX_DIM
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS
  EndIf

  rowBytes = width * #ANVIL_V3D_TEXTURE_TEXEL_BYTES
  If sourcePitch < rowBytes Or (sourcePitch % #ANVIL_V3D_TEXTURE_TEXEL_BYTES) <> 0
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS
  EndIf
  ; IIS is one 32-bit register. Keeping the byte pitch below the 32-bit GPU
  ; address-space limit prevents silent truncation before division by four.
  If sourcePitch >= #ANVIL_V3D_TEXTURE_GPU_LIMIT
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS
  EndIf

  paddedW = ((width + #ANVIL_V3D_TEXTURE_WIDTH_ALIGN - 1) / #ANVIL_V3D_TEXTURE_WIDTH_ALIGN) * #ANVIL_V3D_TEXTURE_WIDTH_ALIGN
  paddedH = ((height + #ANVIL_V3D_TEXTURE_HEIGHT_ALIGN - 1) / #ANVIL_V3D_TEXTURE_HEIGHT_ALIGN) * #ANVIL_V3D_TEXTURE_HEIGHT_ALIGN
  readBytes = (sourcePitch * (height - 1)) + rowBytes
  dstBytes = paddedW * paddedH * #ANVIL_V3D_TEXTURE_TEXEL_BYTES

  If readBytes < rowBytes Or readBytes >= #ANVIL_V3D_TEXTURE_GPU_LIMIT
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE
  EndIf
  If dstBytes < rowBytes Or dstBytes >= #ANVIL_V3D_TEXTURE_GPU_LIMIT
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE
  EndIf

  *plan\width = width
  *plan\height = height
  *plan\sourcePitch = sourcePitch
  *plan\sourceStrideTexels = sourcePitch / #ANVIL_V3D_TEXTURE_TEXEL_BYTES
  *plan\sourceReadBytes = readBytes
  *plan\paddedWidth = paddedW
  *plan\paddedHeight = paddedH
  *plan\destinationBytes = dstBytes
  *plan\texelBytes = #ANVIL_V3D_TEXTURE_TEXEL_BYTES
  *plan\rawTextureType = #ANVIL_V3D_TEXTURE_RAW32_TTYPE
  *plan\tfuOutputFormat = #ANVIL_V3D_TEXTURE_TFU_UIF_NO_XOR
  *plan\textureMemoryFormat = #ANVIL_V3D_TEXTURE_MEM_UIF_NO_XOR
  *plan\outputPadBlocks = 0
  ProcedureReturn #ANVIL_V3D_TEXTURE_OK
EndProcedure

; True only when [address, address+bytes) lies wholly in the declared mapped
; GPU window. Written with differences, not unchecked end-address additions.
Procedure.i avkV3dTextureRangeInWindow(windowBase.i, windowBytes.i, address.i, bytes.i)
  If windowBase <= 0 Or (windowBase % #ANVIL_V3D_TEXTURE_DEST_ALIGN) <> 0 : ProcedureReturn 0 : EndIf
  If windowBytes < 1 Or windowBytes > (#ANVIL_V3D_TEXTURE_GPU_LIMIT - windowBase) : ProcedureReturn 0 : EndIf
  If address < windowBase Or bytes < 1 Or bytes > windowBytes : ProcedureReturn 0 : EndIf
  If (address - windowBase) > (windowBytes - bytes) : ProcedureReturn 0 : EndIf
  ProcedureReturn 1
EndProcedure

; Exact half-open overlap test, also expressed without end-address overflow.
Procedure.i avkV3dTextureRangesOverlap(a.i, aBytes.i, b.i, bBytes.i)
  If a <= b
    If (b - a) < aBytes : ProcedureReturn 1 : EndIf
  Else
    If (a - b) < bBytes : ProcedureReturn 1 : EndIf
  EndIf
  ProcedureReturn 0
EndProcedure

; The queue can validate a whole ordered upload before the first TFU job.
Procedure.i AnvilVkV3dTextureValidate(*transfer.AvkV3dTextureTransfer, *plan.AvkV3dTexturePlan)
  Protected rc.i

  If *plan <> 0 : avkV3dTexturePlanClear(*plan) : EndIf
  If *transfer = 0 Or *plan = 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf

  rc = AnvilVkV3dTexturePlanBuild(*transfer\width, *transfer\height, *transfer\sourcePitch, *plan)
  If rc <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn rc : EndIf

  If *transfer\timeoutUs < 1 Or *transfer\timeoutUs > #ANVIL_V3D_TEXTURE_MAX_TIMEOUT_US
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS
  EndIf
  If (*transfer\sourceBase % #ANVIL_V3D_TEXTURE_SOURCE_ALIGN) <> 0
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS
  EndIf
  If (*transfer\destinationBase % #ANVIL_V3D_TEXTURE_DEST_ALIGN) <> 0
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS
  EndIf
  If *transfer\sourceBytes < *plan\sourceReadBytes
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE
  EndIf
  If *transfer\destinationBytes < *plan\destinationBytes
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE
  EndIf
  If avkV3dTextureRangeInWindow(*transfer\windowBase, *transfer\windowBytes, *transfer\sourceBase, *plan\sourceReadBytes) = 0
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE
  EndIf
  If avkV3dTextureRangeInWindow(*transfer\windowBase, *transfer\windowBytes, *transfer\destinationBase, *plan\destinationBytes) = 0
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE
  EndIf
  If avkV3dTextureRangesOverlap(*transfer\sourceBase, *plan\sourceReadBytes, *transfer\destinationBase, *plan\destinationBytes) <> 0
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_OVERLAP
  EndIf

  ProcedureReturn #ANVIL_V3D_TEXTURE_OK
EndProcedure

; Issue the five low-level operations in Mesa's job order only after validation.
Procedure.i AnvilVkV3dTextureConvert(*transfer.AvkV3dTextureTransfer, *plan.AvkV3dTexturePlan)
  Protected rc.i
  rc = AnvilVkV3dTextureValidate(*transfer, *plan)
  If rc <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn rc : EndIf

  rc = V3dTfuBegin(*plan\width, *plan\height, *plan\rawTextureType)
  If rc <> 0 : ProcedureReturn rc : EndIf
  rc = V3dTfuSourceRaster(*transfer\sourceBase, *plan\sourceStrideTexels, *plan\sourceReadBytes)
  If rc <> 0 : ProcedureReturn rc : EndIf
  rc = V3dTfuDest(*transfer\destinationBase, *plan\tfuOutputFormat, *plan\destinationBytes)
  If rc <> 0 : ProcedureReturn rc : EndIf
  rc = V3dTfuSubmit()
  If rc <> 0 : ProcedureReturn rc : EndIf
  ProcedureReturn V3dTfuWait(*transfer\timeoutUs)
EndProcedure

; A level-zero UIF_NO_XOR image can be copied to another compatible optimal
; image by TFU without visiting a raster buffer. The source IIS field is the
; padded height in eight-texel UIF blocks, not a row pitch.
Procedure.i AnvilVkV3dTextureTiledValidate(*copy.AvkV3dTextureTiledCopy, *plan.AvkV3dTexturePlan)
  Protected rc.i
  If *plan <> 0 : avkV3dTexturePlanClear(*plan) : EndIf
  If *copy = 0 Or *plan = 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  rc = AnvilVkV3dTexturePlanBuild(*copy\width, *copy\height, *copy\width * #ANVIL_V3D_TEXTURE_TEXEL_BYTES, *plan)
  If rc <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn rc : EndIf
  If *copy\paddedWidth <> *plan\paddedWidth Or *copy\paddedHeight <> *plan\paddedHeight Or *copy\timeoutUs < 1 Or *copy\timeoutUs > #ANVIL_V3D_TEXTURE_MAX_TIMEOUT_US
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS
  EndIf
  If (*copy\sourceBase % #ANVIL_V3D_TEXTURE_SOURCE_ALIGN) <> 0 Or (*copy\destinationBase % #ANVIL_V3D_TEXTURE_DEST_ALIGN) <> 0
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS
  EndIf
  If *copy\sourceBytes < *plan\destinationBytes Or *copy\destinationBytes < *plan\destinationBytes
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE
  EndIf
  If avkV3dTextureRangeInWindow(*copy\windowBase, *copy\windowBytes, *copy\sourceBase, *plan\destinationBytes) = 0 Or avkV3dTextureRangeInWindow(*copy\windowBase, *copy\windowBytes, *copy\destinationBase, *plan\destinationBytes) = 0
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE
  EndIf
  If avkV3dTextureRangesOverlap(*copy\sourceBase, *plan\destinationBytes, *copy\destinationBase, *plan\destinationBytes) <> 0
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_OVERLAP
  EndIf
  ProcedureReturn #ANVIL_V3D_TEXTURE_OK
EndProcedure

Procedure.i AnvilVkV3dTextureTiledConvert(*copy.AvkV3dTextureTiledCopy, *plan.AvkV3dTexturePlan)
  Protected rc.i
  rc = AnvilVkV3dTextureTiledValidate(*copy, *plan)
  If rc <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn rc : EndIf
  rc = V3dTfuBegin(*plan\width, *plan\height, *plan\rawTextureType)
  If rc <> 0 : ProcedureReturn rc : EndIf
  rc = V3dTfuSourceUifNoXor(*copy\sourceBase, *plan\paddedHeight, *plan\destinationBytes)
  If rc <> 0 : ProcedureReturn rc : EndIf
  rc = V3dTfuDest(*copy\destinationBase, *plan\tfuOutputFormat, *plan\destinationBytes)
  If rc <> 0 : ProcedureReturn rc : EndIf
  rc = V3dTfuSubmit()
  If rc <> 0 : ProcedureReturn rc : EndIf
  ProcedureReturn V3dTfuWait(*copy\timeoutUs)
EndProcedure

; A UIF_NO_XOR surface is arranged in columns of four 8x8 UIF blocks.
; Each block has four 4x4, 64-byte utiles in row-major order. Addressing
; one utile at a time lets the DMA controller scatter tiled rows into raster
; rows without a processor pixel-copy loop.
Procedure.i AnvilVkV3dTextureUifOffset(x.i, y.i, paddedHeight.i)
  Protected bx.i, by.i, blocksHigh.i, blockIndex.i
  Protected localX.i, localY.i, utileIndex.i
  bx = x / 8 : by = y / 8
  blocksHigh = paddedHeight / 8
  blockIndex = (bx / 4) * (4 * blocksHigh) + by * 4 + (bx % 4)
  localX = x % 8 : localY = y % 8
  utileIndex = (localY / 4) * 2 + (localX / 4)
  ProcedureReturn blockIndex * 256 + utileIndex * 64 + (localY % 4) * 16 + (localX % 4) * 4
EndProcedure

; Every admitted rectangle consists solely of complete 64-byte UIF utiles.
; Validate the entire list of tile addresses before the first DMA operation.
Procedure.i AnvilVkV3dTextureRectValidate(*copy.AvkV3dTextureRectCopy, *plan.AvkV3dTexturePlan)
  Protected rc.i, x.i, y.i, sourceOffset.i, destinationOffset.i
  If *plan <> 0 : avkV3dTexturePlanClear(*plan) : EndIf
  If *copy = 0 Or *plan = 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  rc = AnvilVkV3dTexturePlanBuild(*copy\width, *copy\height, *copy\width * 4, *plan)
  If rc <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn rc : EndIf
  If *copy\paddedWidth <> *plan\paddedWidth Or *copy\paddedHeight <> *plan\paddedHeight
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS
  EndIf
  If *copy\regionWidth < 4 Or *copy\regionHeight < 4 Or (*copy\regionWidth % 4) <> 0 Or (*copy\regionHeight % 4) <> 0 Or *copy\sourceX < 0 Or *copy\sourceY < 0 Or *copy\destinationX < 0 Or *copy\destinationY < 0
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS
  EndIf
  If (*copy\sourceX % 4) <> 0 Or (*copy\sourceY % 4) <> 0 Or (*copy\destinationX % 4) <> 0 Or (*copy\destinationY % 4) <> 0 Or *copy\sourceX > *copy\width - *copy\regionWidth Or *copy\sourceY > *copy\height - *copy\regionHeight Or *copy\destinationX > *copy\width - *copy\regionWidth Or *copy\destinationY > *copy\height - *copy\regionHeight
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS
  EndIf
  If (*copy\regionWidth / 4) * (*copy\regionHeight / 4) > #ANVIL_V3D_TEXTURE_MAX_RECT_UTILES
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS
  EndIf
  If (*copy\sourceBase % #ANVIL_V3D_TEXTURE_DEST_ALIGN) <> 0 Or (*copy\destinationBase % #ANVIL_V3D_TEXTURE_DEST_ALIGN) <> 0 Or *copy\sourceBytes < *plan\destinationBytes Or *copy\destinationBytes < *plan\destinationBytes
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE
  EndIf
  If avkV3dTextureRangeInWindow(*copy\windowBase, *copy\windowBytes, *copy\sourceBase, *plan\destinationBytes) = 0 Or avkV3dTextureRangeInWindow(*copy\windowBase, *copy\windowBytes, *copy\destinationBase, *plan\destinationBytes) = 0
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE
  EndIf
  If avkV3dTextureRangesOverlap(*copy\sourceBase, *plan\destinationBytes, *copy\destinationBase, *plan\destinationBytes) <> 0
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_OVERLAP
  EndIf
  For y = 0 To *copy\regionHeight - 1 Step 4
    For x = 0 To *copy\regionWidth - 1 Step 4
      sourceOffset = AnvilVkV3dTextureUifOffset(*copy\sourceX + x, *copy\sourceY + y, *copy\paddedHeight)
      destinationOffset = AnvilVkV3dTextureUifOffset(*copy\destinationX + x, *copy\destinationY + y, *copy\paddedHeight)
      If sourceOffset < 0 Or destinationOffset < 0 Or sourceOffset > *plan\destinationBytes - 64 Or destinationOffset > *plan\destinationBytes - 64 Or (sourceOffset % 64) <> 0 Or (destinationOffset % 64) <> 0
        ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE
      EndIf
    Next
  Next
  ProcedureReturn #ANVIL_V3D_TEXTURE_OK
EndProcedure

; Copy only addressed texels between two different UIF utiles. Validate both
; complete utile windows and the actual last byte of each row span first.
Procedure.i AnvilVkV3dTextureTiledMicroValidate(*copy.AvkV3dTextureRectCopy, *plan.AvkV3dTexturePlan)
  Protected rc.i, sourceLocalX.i, sourceLocalY.i, destinationLocalX.i, destinationLocalY.i
  Protected sourceTile.i, destinationTile.i, sourceOffset.i, destinationOffset.i, rowBytes.i, rowSpan.i
  If *plan <> 0 : avkV3dTexturePlanClear(*plan) : EndIf
  If *copy = 0 Or *plan = 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  rc = AnvilVkV3dTexturePlanBuild(*copy\width, *copy\height, *copy\width * 4, *plan)
  If rc <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn rc : EndIf
  If *copy\paddedWidth <> *plan\paddedWidth Or *copy\paddedHeight <> *plan\paddedHeight : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  If *copy\regionWidth < 1 Or *copy\regionWidth > 4 Or *copy\regionHeight < 1 Or *copy\regionHeight > 4 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  If *copy\sourceX < 0 Or *copy\sourceY < 0 Or *copy\destinationX < 0 Or *copy\destinationY < 0 Or *copy\sourceX > *copy\width - *copy\regionWidth Or *copy\sourceY > *copy\height - *copy\regionHeight Or *copy\destinationX > *copy\width - *copy\regionWidth Or *copy\destinationY > *copy\height - *copy\regionHeight : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  sourceLocalX = *copy\sourceX % 4 : sourceLocalY = *copy\sourceY % 4
  destinationLocalX = *copy\destinationX % 4 : destinationLocalY = *copy\destinationY % 4
  If sourceLocalX + *copy\regionWidth > 4 Or sourceLocalY + *copy\regionHeight > 4 Or destinationLocalX + *copy\regionWidth > 4 Or destinationLocalY + *copy\regionHeight > 4 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  If (*copy\sourceBase % #ANVIL_V3D_TEXTURE_DEST_ALIGN) <> 0 Or (*copy\destinationBase % #ANVIL_V3D_TEXTURE_DEST_ALIGN) <> 0 Or *copy\sourceBytes < *plan\destinationBytes Or *copy\destinationBytes < *plan\destinationBytes : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE : EndIf
  If avkV3dTextureRangeInWindow(*copy\windowBase, *copy\windowBytes, *copy\sourceBase, *plan\destinationBytes) = 0 Or avkV3dTextureRangeInWindow(*copy\windowBase, *copy\windowBytes, *copy\destinationBase, *plan\destinationBytes) = 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE : EndIf
  If avkV3dTextureRangesOverlap(*copy\sourceBase, *copy\sourceBytes, *copy\destinationBase, *copy\destinationBytes) <> 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_OVERLAP : EndIf
  sourceTile = AnvilVkV3dTextureUifOffset(*copy\sourceX - sourceLocalX, *copy\sourceY - sourceLocalY, *copy\paddedHeight)
  destinationTile = AnvilVkV3dTextureUifOffset(*copy\destinationX - destinationLocalX, *copy\destinationY - destinationLocalY, *copy\paddedHeight)
  sourceOffset = AnvilVkV3dTextureUifOffset(*copy\sourceX, *copy\sourceY, *copy\paddedHeight)
  destinationOffset = AnvilVkV3dTextureUifOffset(*copy\destinationX, *copy\destinationY, *copy\paddedHeight)
  rowBytes = *copy\regionWidth * 4 : rowSpan = (*copy\regionHeight - 1) * 16 + rowBytes
  If sourceTile < 0 Or destinationTile < 0 Or sourceTile > *plan\destinationBytes - 64 Or destinationTile > *plan\destinationBytes - 64 Or (sourceTile % 64) <> 0 Or (destinationTile % 64) <> 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE : EndIf
  If sourceOffset <> sourceTile + sourceLocalY * 16 + sourceLocalX * 4 Or destinationOffset <> destinationTile + destinationLocalY * 16 + destinationLocalX * 4 Or sourceOffset + rowSpan > sourceTile + 64 Or destinationOffset + rowSpan > destinationTile + 64 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE : EndIf
  If avkV3dTextureRangeInWindow(*copy\windowBase, *copy\windowBytes, *copy\sourceBase + sourceOffset, rowSpan) = 0 Or avkV3dTextureRangeInWindow(*copy\windowBase, *copy\windowBytes, *copy\destinationBase + destinationOffset, rowSpan) = 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE : EndIf
  ProcedureReturn #ANVIL_V3D_TEXTURE_OK
EndProcedure

; Preflight every source 4-row span and destination utile before the first
; guarded DMA descriptor. The source XY is a texel coordinate, not a tile.
Procedure.i AnvilVkV3dTextureLinearRectValidate(*copy.AvkV3dTextureLinearRectCopy, *plan.AvkV3dTexturePlan)
  Protected rc.i, x.i, y.i, cols.i, rows.i, minRowBytes.i, sourceOffset.i, destinationOffset.i, sourceSpan.i
  If *plan <> 0 : avkV3dTexturePlanClear(*plan) : EndIf
  If *copy = 0 Or *plan = 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  rc = AnvilVkV3dTexturePlanBuild(*copy\width, *copy\height, *copy\width * 4, *plan)
  If rc <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn rc : EndIf
  If *copy\sourceViewWidth < 1 Or *copy\sourceViewHeight < 1 Or *copy\sourceViewWidth > #ANVIL_V3D_TEXTURE_MAX_DIM Or *copy\sourceViewHeight > #ANVIL_V3D_TEXTURE_MAX_DIM Or *copy\sourcePitch < *copy\sourceViewWidth * 4 Or (*copy\sourcePitch % 4) <> 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  If *copy\paddedWidth <> *plan\paddedWidth Or *copy\paddedHeight <> *plan\paddedHeight : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  If *copy\regionWidth < 1 Or *copy\regionHeight < 1 Or *copy\sourceX < 0 Or *copy\sourceY < 0 Or *copy\destinationX < 0 Or *copy\destinationY < 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  If (*copy\destinationX % 4) <> 0 Or (*copy\destinationY % 4) <> 0 Or *copy\sourceX > *copy\sourceViewWidth - *copy\regionWidth Or *copy\sourceY > *copy\sourceViewHeight - *copy\regionHeight Or *copy\destinationX > *copy\width - *copy\regionWidth Or *copy\destinationY > *copy\height - *copy\regionHeight : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  If ((*copy\regionWidth % 4) <> 0 And *copy\destinationX <> *copy\width - *copy\regionWidth) Or ((*copy\regionHeight % 4) <> 0 And *copy\destinationY <> *copy\height - *copy\regionHeight) : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  If ((*copy\regionWidth - 1) / 4 + 1) * ((*copy\regionHeight - 1) / 4 + 1) > #ANVIL_V3D_TEXTURE_MAX_RECT_UTILES : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  minRowBytes = 16
  If (*copy\regionWidth % 4) <> 0 : minRowBytes = (*copy\regionWidth % 4) * 4 : EndIf
  If *copy\sourcePitch - minRowBytes > 32767 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  If (*copy\sourceBase % 4) <> 0 Or (*copy\destinationBase % #ANVIL_V3D_TEXTURE_DEST_ALIGN) <> 0 Or *copy\sourceBytes < (*copy\sourceViewHeight - 1) * *copy\sourcePitch + *copy\sourceViewWidth * 4 Or *copy\destinationBytes < *plan\destinationBytes : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE : EndIf
  If avkV3dTextureRangeInWindow(*copy\windowBase, *copy\windowBytes, *copy\sourceBase, *copy\sourceBytes) = 0 Or avkV3dTextureRangeInWindow(*copy\windowBase, *copy\windowBytes, *copy\destinationBase, *plan\destinationBytes) = 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE : EndIf
  If avkV3dTextureRangesOverlap(*copy\sourceBase, *copy\sourceBytes, *copy\destinationBase, *copy\destinationBytes) <> 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_OVERLAP : EndIf
  For y = 0 To *copy\regionHeight - 1 Step 4
    For x = 0 To *copy\regionWidth - 1 Step 4
      cols = *copy\regionWidth - x : If cols > 4 : cols = 4 : EndIf
      rows = *copy\regionHeight - y : If rows > 4 : rows = 4 : EndIf
      If *copy\sourcePitch - cols * 4 > 32767 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
      sourceOffset = (*copy\sourceY + y) * *copy\sourcePitch + (*copy\sourceX + x) * 4
      sourceSpan = (rows - 1) * *copy\sourcePitch + cols * 4
      destinationOffset = AnvilVkV3dTextureUifOffset(*copy\destinationX + x, *copy\destinationY + y, *copy\paddedHeight)
      If sourceOffset < 0 Or sourceOffset + sourceSpan > *copy\sourceBytes Or destinationOffset < 0 Or destinationOffset > *plan\destinationBytes - 64 Or (destinationOffset % 64) <> 0 Or destinationOffset + (rows - 1) * 16 + cols * 4 > *plan\destinationBytes : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE : EndIf
      If avkV3dTextureRangeInWindow(*copy\windowBase, *copy\windowBytes, *copy\sourceBase + sourceOffset, sourceSpan) = 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE : EndIf
    Next
  Next
  ProcedureReturn #ANVIL_V3D_TEXTURE_OK
EndProcedure

; A micro upload writes only the addressed texels within one UIF utile.
; The source rows and destination byte window are checked before DMA.
Procedure.i AnvilVkV3dTextureMicroValidate(*copy.AvkV3dTextureLinearRectCopy, *plan.AvkV3dTexturePlan)
  Protected rc.i, localX.i, localY.i, rowBytes.i, sourceOffset.i, sourceSpan.i
  Protected tileOffset.i, destinationOffset.i
  If *plan <> 0 : avkV3dTexturePlanClear(*plan) : EndIf
  If *copy = 0 Or *plan = 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  rc = AnvilVkV3dTexturePlanBuild(*copy\width, *copy\height, *copy\width * 4, *plan)
  If rc <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn rc : EndIf
  If *copy\paddedWidth <> *plan\paddedWidth Or *copy\paddedHeight <> *plan\paddedHeight : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  If *copy\regionWidth < 1 Or *copy\regionWidth > 4 Or *copy\regionHeight < 1 Or *copy\regionHeight > 4 Or *copy\sourceViewWidth < 1 Or *copy\sourceViewHeight < 1 Or *copy\sourceViewWidth > #ANVIL_V3D_TEXTURE_MAX_DIM Or *copy\sourceViewHeight > #ANVIL_V3D_TEXTURE_MAX_DIM : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  If *copy\sourceX < 0 Or *copy\sourceY < 0 Or *copy\destinationX < 0 Or *copy\destinationY < 0 Or *copy\sourceX > *copy\sourceViewWidth - *copy\regionWidth Or *copy\sourceY > *copy\sourceViewHeight - *copy\regionHeight Or *copy\destinationX > *copy\width - *copy\regionWidth Or *copy\destinationY > *copy\height - *copy\regionHeight : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  localX = *copy\destinationX % 4 : localY = *copy\destinationY % 4
  If localX + *copy\regionWidth > 4 Or localY + *copy\regionHeight > 4 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  rowBytes = *copy\regionWidth * 4
  If *copy\sourcePitch < *copy\sourceViewWidth * 4 Or (*copy\sourcePitch % 4) <> 0 Or *copy\sourcePitch - rowBytes > 32767 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  If (*copy\sourceBase % 4) <> 0 Or (*copy\destinationBase % #ANVIL_V3D_TEXTURE_DEST_ALIGN) <> 0 Or *copy\sourceBytes < (*copy\sourceViewHeight - 1) * *copy\sourcePitch + *copy\sourceViewWidth * 4 Or *copy\destinationBytes < *plan\destinationBytes : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE : EndIf
  If avkV3dTextureRangeInWindow(*copy\windowBase, *copy\windowBytes, *copy\sourceBase, *copy\sourceBytes) = 0 Or avkV3dTextureRangeInWindow(*copy\windowBase, *copy\windowBytes, *copy\destinationBase, *plan\destinationBytes) = 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE : EndIf
  If avkV3dTextureRangesOverlap(*copy\sourceBase, *copy\sourceBytes, *copy\destinationBase, *copy\destinationBytes) <> 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_OVERLAP : EndIf
  sourceOffset = *copy\sourceY * *copy\sourcePitch + *copy\sourceX * 4
  sourceSpan = (*copy\regionHeight - 1) * *copy\sourcePitch + rowBytes
  tileOffset = AnvilVkV3dTextureUifOffset(*copy\destinationX - localX, *copy\destinationY - localY, *copy\paddedHeight)
  destinationOffset = AnvilVkV3dTextureUifOffset(*copy\destinationX, *copy\destinationY, *copy\paddedHeight)
  If sourceOffset < 0 Or sourceOffset + sourceSpan > *copy\sourceBytes Or tileOffset < 0 Or tileOffset > *plan\destinationBytes - 64 Or (tileOffset % 64) <> 0 Or destinationOffset <> tileOffset + localY * 16 + localX * 4 Or destinationOffset + (*copy\regionHeight - 1) * 16 + rowBytes > tileOffset + 64 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE : EndIf
  If avkV3dTextureRangeInWindow(*copy\windowBase, *copy\windowBytes, *copy\sourceBase + sourceOffset, sourceSpan) = 0 Or avkV3dTextureRangeInWindow(*copy\windowBase, *copy\windowBytes, *copy\destinationBase + destinationOffset, (*copy\regionHeight - 1) * 16 + rowBytes) = 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE : EndIf
  ProcedureReturn #ANVIL_V3D_TEXTURE_OK
EndProcedure

; Decompose an interior rectangle into at most four micro tile intersections.
; Every source row span and destination utile is checked before DMA starts.
Procedure.i AnvilVkV3dTextureGridValidate(*copy.AvkV3dTextureLinearRectCopy, *plan.AvkV3dTexturePlan)
  Protected tile.AvkV3dTextureLinearRectCopy
  Protected firstX.i, firstY.i, lastX.i, lastY.i, tileX.i, tileY.i
  Protected ix.i, iy.i, endX.i, endY.i, rc.i
  If *copy = 0 Or *plan = 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  If *copy\regionWidth < 1 Or *copy\regionHeight < 1 Or *copy\destinationX < 0 Or *copy\destinationY < 0 Or *copy\sourceX <> 0 Or *copy\sourceY <> 0 Or *copy\sourceViewWidth <> *copy\regionWidth Or *copy\sourceViewHeight <> *copy\regionHeight : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  If *copy\destinationX > *copy\width - *copy\regionWidth Or *copy\destinationY > *copy\height - *copy\regionHeight Or *copy\sourcePitch < *copy\regionWidth * 4 Or *copy\sourceBytes <> (*copy\regionHeight - 1) * *copy\sourcePitch + *copy\regionWidth * 4 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  firstX = (*copy\destinationX / 4) * 4 : firstY = (*copy\destinationY / 4) * 4
  lastX = ((*copy\destinationX + *copy\regionWidth - 1) / 4) * 4
  lastY = ((*copy\destinationY + *copy\regionHeight - 1) / 4) * 4
  If lastX - firstX > 4 Or lastY - firstY > 4 Or (lastX = firstX And lastY = firstY) : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  tile\windowBase = *copy\windowBase : tile\windowBytes = *copy\windowBytes
  tile\sourceBase = *copy\sourceBase : tile\sourceBytes = *copy\sourceBytes : tile\sourcePitch = *copy\sourcePitch
  tile\sourceViewWidth = *copy\sourceViewWidth : tile\sourceViewHeight = *copy\sourceViewHeight
  tile\destinationBase = *copy\destinationBase : tile\destinationBytes = *copy\destinationBytes
  tile\width = *copy\width : tile\height = *copy\height
  tile\paddedWidth = *copy\paddedWidth : tile\paddedHeight = *copy\paddedHeight
  For tileY = firstY To lastY Step 4
    For tileX = firstX To lastX Step 4
      ix = tileX : If ix < *copy\destinationX : ix = *copy\destinationX : EndIf
      iy = tileY : If iy < *copy\destinationY : iy = *copy\destinationY : EndIf
      endX = tileX + 4 : If endX > *copy\destinationX + *copy\regionWidth : endX = *copy\destinationX + *copy\regionWidth : EndIf
      endY = tileY + 4 : If endY > *copy\destinationY + *copy\regionHeight : endY = *copy\destinationY + *copy\regionHeight : EndIf
      tile\sourceX = ix - *copy\destinationX : tile\sourceY = iy - *copy\destinationY
      tile\destinationX = ix : tile\destinationY = iy
      tile\regionWidth = endX - ix : tile\regionHeight = endY - iy
      rc = AnvilVkV3dTextureMicroValidate(@tile, *plan)
      If rc <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn rc : EndIf
    Next
  Next
  ProcedureReturn #ANVIL_V3D_TEXTURE_OK
EndProcedure

Procedure.i AnvilVkV3dTextureReadbackValidate(*read.AvkV3dTextureReadback, *plan.AvkV3dTexturePlan)
  Protected rc.i, destinationSpan.i, regionWidth.i, regionHeight.i
  If *plan <> 0 : avkV3dTexturePlanClear(*plan) : EndIf
  If *read = 0 Or *plan = 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  rc = AnvilVkV3dTexturePlanBuild(*read\width, *read\height, *read\width * 4, *plan)
  If rc <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn rc : EndIf
  If *read\paddedWidth <> *plan\paddedWidth Or *read\paddedHeight <> *plan\paddedHeight
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS
  EndIf
  regionWidth = *read\regionWidth : regionHeight = *read\regionHeight
  If regionWidth = 0 And regionHeight = 0 And *read\sourceX = 0 And *read\sourceY = 0
    regionWidth = *read\width : regionHeight = *read\height
  EndIf
  If regionWidth < 1 Or regionHeight < 1 Or *read\sourceX < 0 Or *read\sourceY < 0 Or *read\sourceX > *read\width - regionWidth Or *read\sourceY > *read\height - regionHeight
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS
  EndIf
  If (*read\sourceX % 4) <> 0 Or (*read\sourceY % 4) <> 0 Or ((regionWidth % 4) <> 0 And *read\sourceX <> *read\width - regionWidth) Or ((regionHeight % 4) <> 0 And *read\sourceY <> *read\height - regionHeight)
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS
  EndIf
  If *read\destinationPitch < regionWidth * 4 Or (*read\destinationPitch % 4) <> 0
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS
  EndIf
  If (*read\sourceBase % #ANVIL_V3D_TEXTURE_DEST_ALIGN) <> 0 Or (*read\destinationBase % 4) <> 0
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS
  EndIf
  destinationSpan = (regionHeight - 1) * *read\destinationPitch + regionWidth * 4
  If destinationSpan < regionWidth * 4 Or *read\sourceBytes < *plan\destinationBytes Or *read\destinationBytes < destinationSpan
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE
  EndIf
  If avkV3dTextureRangeInWindow(*read\windowBase, *read\windowBytes, *read\sourceBase, *plan\destinationBytes) = 0 Or avkV3dTextureRangeInWindow(*read\windowBase, *read\windowBytes, *read\destinationBase, destinationSpan) = 0
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE
  EndIf
  If avkV3dTextureRangesOverlap(*read\sourceBase, *plan\destinationBytes, *read\destinationBase, destinationSpan) <> 0
    ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_OVERLAP
  EndIf
  ProcedureReturn #ANVIL_V3D_TEXTURE_OK
EndProcedure

; One interior source utile may be read into exact pitched buffer rows.
; Validate its complete 64-byte tile and the last addressed byte first.
Procedure.i AnvilVkV3dTextureMicroReadbackValidate(*read.AvkV3dTextureReadback, *plan.AvkV3dTexturePlan)
  Protected rc.i, localX.i, localY.i, rowBytes.i, destinationSpan.i
  Protected sourceTile.i, sourceOffset.i, sourceSpan.i
  If *plan <> 0 : avkV3dTexturePlanClear(*plan) : EndIf
  If *read = 0 Or *plan = 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  rc = AnvilVkV3dTexturePlanBuild(*read\width, *read\height, *read\width * 4, *plan)
  If rc <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn rc : EndIf
  If *read\paddedWidth <> *plan\paddedWidth Or *read\paddedHeight <> *plan\paddedHeight : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  If *read\regionWidth < 1 Or *read\regionWidth > 4 Or *read\regionHeight < 1 Or *read\regionHeight > 4 Or *read\sourceX < 0 Or *read\sourceY < 0 Or *read\sourceX > *read\width - *read\regionWidth Or *read\sourceY > *read\height - *read\regionHeight : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  localX = *read\sourceX % 4 : localY = *read\sourceY % 4
  If localX + *read\regionWidth > 4 Or localY + *read\regionHeight > 4 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  rowBytes = *read\regionWidth * 4
  If *read\destinationPitch < rowBytes Or (*read\destinationPitch % 4) <> 0 Or *read\destinationPitch - rowBytes > 32767 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  If (*read\sourceBase % #ANVIL_V3D_TEXTURE_DEST_ALIGN) <> 0 Or (*read\destinationBase % 4) <> 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_ARGS : EndIf
  destinationSpan = (*read\regionHeight - 1) * *read\destinationPitch + rowBytes
  If destinationSpan < rowBytes Or *read\sourceBytes < *plan\destinationBytes Or *read\destinationBytes < destinationSpan : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE : EndIf
  If avkV3dTextureRangeInWindow(*read\windowBase, *read\windowBytes, *read\sourceBase, *plan\destinationBytes) = 0 Or avkV3dTextureRangeInWindow(*read\windowBase, *read\windowBytes, *read\destinationBase, destinationSpan) = 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE : EndIf
  If avkV3dTextureRangesOverlap(*read\sourceBase, *read\sourceBytes, *read\destinationBase, destinationSpan) <> 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_OVERLAP : EndIf
  sourceTile = AnvilVkV3dTextureUifOffset(*read\sourceX - localX, *read\sourceY - localY, *read\paddedHeight)
  sourceOffset = AnvilVkV3dTextureUifOffset(*read\sourceX, *read\sourceY, *read\paddedHeight)
  sourceSpan = (*read\regionHeight - 1) * 16 + rowBytes
  If sourceTile < 0 Or sourceTile > *plan\destinationBytes - 64 Or (sourceTile % 64) <> 0 Or sourceOffset <> sourceTile + localY * 16 + localX * 4 Or sourceOffset + sourceSpan > sourceTile + 64 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE : EndIf
  If avkV3dTextureRangeInWindow(*read\windowBase, *read\windowBytes, *read\sourceBase + sourceTile, 64) = 0 Or avkV3dTextureRangeInWindow(*read\windowBase, *read\windowBytes, *read\sourceBase + sourceOffset, sourceSpan) = 0 : ProcedureReturn #ANVIL_V3D_TEXTURE_ERR_RANGE : EndIf
  ProcedureReturn #ANVIL_V3D_TEXTURE_OK
EndProcedure
