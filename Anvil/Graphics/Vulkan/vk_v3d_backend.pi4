; ======================================================================
;  The Raspberry Pi 4 V3D graphics backend for Anvil's Vulkan surface
; ======================================================================
; SPDX-License-Identifier: MIT
;
; This is the hardware half of the seam declared in vk_foundation.pbi. It
; turns one closed, already validated colour clear into real V3D work and
; it does nothing else. It is the ONLY file in the Vulkan tree that knows
; what a render target, a control list or a tile is.
;
; THE EXECUTION PATH IS THE ONE THIS TREE ALREADY PROVES ON SILICON.
; NeonRebindSurface transactionally points the engine at the image and its
; geometry; NeonFrameBegin sets the clear colour and builds a bin list with no
; draws; NeonFrameEnd cleans
; the caches for what it produced, submits the bin job (V3dBinSubmit),
; waits for it (V3dBinWait), submits the render job (V3dRenderSubmit) and
; waits for it (V3dRenderWait). The tile clear and the tile store are
; what write the image; V3dRenderWait performs the V3D cache clean and
; the processor-side maintenance for the target. The console and
; NeonArcade drive the same path at 1920x1080 on this board.
;
; THERE IS NO PROCESSOR-SIDE AND NO DMA FALLBACK. If the GPU does not do
; it, this file reports a device loss and the image is left alone. A
; fallback here would mean a green test could be a test of memcpy.
;
; WHAT THIS BACKEND CANNOT DO, and says so through
; avkBackendClearSupported rather than by guessing:
;   * an image whose width, height and row pitch do not fit the declared
;     render capacity, mapped span and V3D packet fields. The same pure planner
;     owns these limits for Neon rebind, Vulkan creation and the public image-
;     format query. Every refusal occurs before live engine state is changed.
;   * an image that is the framebuffer the display is scanning out. This
;     backend is offscreen by contract; presentation stays with the
;     display layer, which is where the page flip and the rotation live.
;
; PROVENANCE. Semantics come from the Vulkan specification:
;   https://docs.vulkan.org/spec/latest/chapters/clears.html  (a colour
;   clear outside a render pass, and the layouts it is permitted in)
;   https://docs.vulkan.org/spec/latest/chapters/memory.html   (the heap
;   and allocation contract this backend reports into)
;
; The hardware behaviour comes from THIS TREE'S OWN V3D driver, read for
; what the engine does rather than re-derived:
;   RaspberryPi4/Lib/v3d.pi4    blob 032047a96ec132a7d64a7535d0d4787eebc96afd
;   RaspberryPi4/Lib/neon.pi4   blob 5116984292bf5840aae2d27d66cad80312b86cdb
;   RaspberryPi4/Lib/v3dqpu.pi4 blob 9b493319fca51449e6ea49880804d42d5904b185
; all three unchanged across Anvil main 887681a..73a7e01. Two findings in
; them are load-bearing here and are quoted where they are used: that the
; clear colour reaches memory verbatim because TILE_RENDERING_MODE_CFG
; carries a packed word (v3d.pi4, V3dClTrmcClearColor1), and that the
; display wants byte 0 to be blue (neon.pi4, the CHANNEL ORDER note,
; measured on this board).
;
; Those files cite the Mesa sources and the V3D packet documentation they
; were written against, next to each packet. Mesa was consulted for how
; the hardware behaves and is NOT a runtime dependency; NO third-party
; code is used here and nothing is copied from any implementation.
; PROVENANCE.json therefore owes this file one `mesa-24.3.4: consulted`
; row, the same classification vk_core_1_0.pbi carries for khronos-vulkan.

; REQUIRES Anvil/Graphics/Vulkan/vk_v3d_shader.pi4, INCLUDED BEFORE THIS
; FILE. That is the QPU emitter, and the three pipeline entries of the
; seam below are thin wrappers over it. It is not included from here:
; house rule 10 says a library does not include another library, so the
; main source lists both and a build that forgets the emitter fails to
; resolve AnvilVkV3dCompile by name rather than linking something odd.

XIncludeFile "Anvil/Graphics/Vulkan/vk_foundation.pbi"
XIncludeFile "Anvil/Graphics/Vulkan/vk_v3d_texture.pi4"

; The clear colour word this backend hands V3dRenderClear lands in the
; target VERBATIM: TILE_RENDERING_MODE_CFG carries a packed word, not
; four components, so nothing reorders it (RaspberryPi4/Lib/v3d.pi4,
; V3dClTrmcClearColor1 and the CHANNEL ORDER note in neon.pi4 at Anvil
; main 887681a, both measured on this board). The engine hands over
; (A<<24)|(R<<16)|(G<<8)|B, whose little-endian bytes are B, G, R, A -
; which is exactly VK_FORMAT_B8G8R8A8_UNORM storage order. Neon's
; red/blue swap setting changes only SHADER colours and cannot reach a
; clear, so this path does not depend on it.

Global avkV3dWindowBase.i = 0
Global avkV3dWindowBytes.i = 0
Global avkV3dNative.i = 0
Global avkV3dJobs.i = 0

; Declare the offscreen window this backend may suballocate as Vulkan
; device memory. It must already be inside the span NeonSurfaceMapSpan
; covered before NeonInit built the V3D page table, because the GPU
; reaches it through that identity mapping and an unmapped page is an
; MMU fault rather than a wrong picture. Nothing here maps memory and
; nothing here takes display ownership.
Procedure.i AnvilVkV3dWindow(base.i, bytes.i)
  If base <= 0 Or (base % 4096) <> 0
    ProcedureReturn avkFault(#ANVIL_VK_ERR_ARGS, "the Pi 4 Vulkan backend was given an offscreen window that is not page aligned (Anvil code -20001, invalid window); the V3D MMU maps 4096-byte pages, so the window base must be a multiple of 4096.")
  EndIf
  If bytes < 4096
    ProcedureReturn avkFault(#ANVIL_VK_ERR_ARGS, "the Pi 4 Vulkan backend was given an offscreen window smaller than one page (Anvil code -20001, invalid window); reserve at least one whole screen of memory above the framebuffer and map it with NeonSurfaceMapSpan before NeonInit.")
  EndIf
  avkV3dWindowBase = base
  avkV3dWindowBytes = bytes
  ProcedureReturn #VK_SUCCESS
EndProcedure

Procedure.i avkBackendCaps()
  If avkV3dWindowBase <= 0 Or avkV3dWindowBytes <= 0 : ProcedureReturn 0 : EndIf
  If Neon_Ready() = 0 : ProcedureReturn 0 : EndIf
  ProcedureReturn #ANVIL_VK_CAP_DEVICE | #ANVIL_VK_CAP_CLEAR_COLOR | #ANVIL_VK_CAP_GPU | #ANVIL_VK_CAP_DRAW
EndProcedure

Procedure.i avkBackendName()
  ProcedureReturn "the Raspberry Pi 4 V3D 4.2 backend: colour clears are executed by the GPU through the bin and render control lists, and nothing is cleared on the processor"
EndProcedure

Procedure.i avkBackendPrepare()
  If Neon_Ready() = 0
    avkFault(#VK_ERROR_INITIALIZATION_FAILED, "vkCreateDevice found the Pi 4 graphics engine not initialised (VkResult -3, VK_ERROR_INITIALIZATION_FAILED); no device was created. Call NeonArena, NeonSurface, NeonSurfaceMapSpan and NeonInit, and check Neon_Error(), before creating a Vulkan device.")
    ProcedureReturn #VK_ERROR_INITIALIZATION_FAILED
  EndIf
  If avkV3dWindowBase <= 0
    avkFault(#VK_ERROR_INITIALIZATION_FAILED, "vkCreateDevice found no offscreen window declared for the Pi 4 Vulkan backend (VkResult -3, VK_ERROR_INITIALIZATION_FAILED); no device was created. Call AnvilVkV3dWindow with a page-aligned region that NeonSurfaceMapSpan already mapped.")
    ProcedureReturn #VK_ERROR_INITIALIZATION_FAILED
  EndIf
  ProcedureReturn #VK_SUCCESS
EndProcedure

Procedure.i avkBackendHeapBase()
  ProcedureReturn avkV3dWindowBase
EndProcedure

Procedure.i avkBackendHeapBytes()
  ProcedureReturn avkV3dWindowBytes
EndProcedure

; The processor and the GPU share DRAM on this part and the window is
; identity mapped in the V3D page table. This backend reports HOST_COHERENT
; because it implements that API promise: every GPU-read pipeline, uniform
; and vertex range is cleaned before submission, and V3dRenderWait cleans
; the GPU caches then cleans+invalidates the ARM view of the whole render
; target before completion is reported. Hardware coherence is not assumed;
; the mandatory maintenance at the host/device synchronization edges is
; what supplies the observable coherent behavior.
Procedure.i avkBackendMemoryTypeCount()
  ProcedureReturn 1
EndProcedure

Procedure.i avkBackendMemoryTypeFlags(index.i)
  If index <> 0 : ProcedureReturn 0 : EndIf
  ProcedureReturn #VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT | #VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | #VK_MEMORY_PROPERTY_HOST_COHERENT_BIT
EndProcedure

Procedure.i avkBackendMemoryTypeHeap(index.i)
  ProcedureReturn 0
EndProcedure

Procedure.i avkBackendHeapCount()
  ProcedureReturn 1
EndProcedure

Procedure.i avkBackendHeapSizeOf(index.i)
  If index <> 0 : ProcedureReturn 0 : EndIf
  ProcedureReturn avkV3dWindowBytes
EndProcedure

Procedure.i avkBackendHeapFlagsOf(index.i)
  If index <> 0 : ProcedureReturn 0 : EndIf
  ProcedureReturn #VK_MEMORY_HEAP_DEVICE_LOCAL_BIT
EndProcedure

; Page granular, because the V3D MMU is.
Procedure.i avkBackendImageAlignment()
  ProcedureReturn 4096
EndProcedure

; TFU raster input is cleaned and issued by cache-line. This requirement is
; backend-owned so another Vulkan target can publish its own transfer engine's
; alignment without inheriting a Pi 4 constant in the command layer.
Procedure.i avkBackendImageCopySourceAlignment()
  ProcedureReturn 64
EndProcedure

; Linear BGRA8 images use a tight four-byte row.  The transactional Neon
; rebind installs this pitch in the V3D store packet; it is no longer copied
; from the display surface.
Procedure.i avkBackendRowPitchFor(width.i)
  ProcedureReturn width * 4
EndProcedure

Procedure.i avkBackendMaxImageDimension2D()
  Define n.i
  n = Neon_CapacityPhysicalW()
  If Neon_CapacityPhysicalH() < n : n = Neon_CapacityPhysicalH() : EndIf
  ProcedureReturn n
EndProcedure

; This first real texture tranche accepts one texel only. For a one-texel
; image the sole BGRA word at the linear image's base is also the sole useful
; texel of V3D's LINEARTILE level; every coordinate clamps to it. Wider images
; require an optimal-tiled representation and a transfer operation and remain
; outside the advertised/queryable limit rather than being misread as tiled.
Procedure.i avkBackendSampledMaxDimension2D(tiling.i)
  Define n.i
  If tiling = #VK_IMAGE_TILING_LINEAR : ProcedureReturn 1 : EndIf
  If tiling <> #VK_IMAGE_TILING_OPTIMAL : ProcedureReturn 0 : EndIf
  n = avkBackendMaxImageDimension2D()
  If n > #ANVIL_V3D_TEXTURE_MAX_DIM : n = #ANVIL_V3D_TEXTURE_MAX_DIM : EndIf
  ProcedureReturn n
EndProcedure

Procedure.i avkBackendImagePlan(width.i, height.i, format.i, tiling.i, usage.i, *plan.AnvilVkBackendImagePlan)
  Define vp.AvkV3dTexturePlan
  Define rc.i
  If *plan = 0 : ProcedureReturn #ANVIL_VK_ERR_ARGS : EndIf
  *plan\bytes = 0 : *plan\alignment = 0 : *plan\rowPitch = 0
  *plan\backendLayout = 0 : *plan\paddedWidth = 0 : *plan\paddedHeight = 0
  If format <> #VK_FORMAT_B8G8R8A8_UNORM : ProcedureReturn #VK_ERROR_FORMAT_NOT_SUPPORTED : EndIf
  If width < 1 Or height < 1 Or width > avkBackendMaxImageDimension2D() Or height > avkBackendMaxImageDimension2D()
    ProcedureReturn #VK_ERROR_FORMAT_NOT_SUPPORTED
  EndIf
  *plan\alignment = avkBackendImageAlignment()
  If tiling = #VK_IMAGE_TILING_LINEAR
    *plan\rowPitch = avkBackendRowPitchFor(width)
    *plan\bytes = *plan\rowPitch * height
    *plan\paddedWidth = width : *plan\paddedHeight = height
    ProcedureReturn #VK_SUCCESS
  EndIf
  If tiling <> #VK_IMAGE_TILING_OPTIMAL : ProcedureReturn #VK_ERROR_FORMAT_NOT_SUPPORTED : EndIf
  If usage = 0 Or (usage & (~(#VK_IMAGE_USAGE_TRANSFER_DST_BIT | #VK_IMAGE_USAGE_SAMPLED_BIT))) <> 0
    ProcedureReturn #VK_ERROR_FORMAT_NOT_SUPPORTED
  EndIf
  rc = AnvilVkV3dTexturePlanBuild(width, height, width * 4, @vp)
  If rc <> #ANVIL_V3D_TEXTURE_OK : ProcedureReturn #VK_ERROR_FORMAT_NOT_SUPPORTED : EndIf
  *plan\bytes = vp\destinationBytes
  *plan\backendLayout = vp\textureMemoryFormat
  *plan\paddedWidth = vp\paddedWidth
  *plan\paddedHeight = vp\paddedHeight
  ProcedureReturn #VK_SUCCESS
EndProcedure

Procedure.i avkBackendSubmitImageCopy(*copy.AnvilVkBackendImageCopy)
  Define t.AvkV3dTextureTransfer
  Define p.AvkV3dTexturePlan
  Define rc.i
  avkV3dNative = 0
  If *copy = 0 : avkV3dNative = #ANVIL_V3D_TEXTURE_ERR_ARGS : ProcedureReturn -1 : EndIf
  If *copy\destinationLayout <> #ANVIL_V3D_TEXTURE_MEM_UIF_NO_XOR
    avkV3dNative = #ANVIL_V3D_TEXTURE_ERR_ARGS
    ProcedureReturn -1
  EndIf
  t\windowBase = *copy\windowBase : t\windowBytes = *copy\windowBytes
  t\sourceBase = *copy\sourceBase : t\sourceBytes = *copy\sourceBytes
  t\destinationBase = *copy\destinationBase : t\destinationBytes = *copy\destinationBytes
  t\width = *copy\width : t\height = *copy\height
  t\sourcePitch = *copy\sourcePitch : t\timeoutUs = *copy\timeoutUs
  rc = AnvilVkV3dTextureConvert(@t, @p)
  If rc <> #ANVIL_V3D_TEXTURE_OK
    avkV3dNative = rc
    ProcedureReturn -1
  EndIf
  If p\textureMemoryFormat <> *copy\destinationLayout Or p\paddedWidth <> *copy\paddedWidth Or p\paddedHeight <> *copy\paddedHeight
    avkV3dNative = #ANVIL_V3D_TEXTURE_ERR_ARGS
    ProcedureReturn -1
  EndIf
  avkV3dJobs = avkV3dJobs + 1
  ProcedureReturn #ANVIL_VK_JOB_DONE
EndProcedure

Procedure.i avkBackendClearSupported(base.i, bytes.i, w.i, h.i, pitch.i)
  If Neon_Ready() = 0 : ProcedureReturn #VK_ERROR_DEVICE_LOST : EndIf
  If base <= 0 Or bytes <= 0 : ProcedureReturn #VK_ERROR_FEATURE_NOT_PRESENT : EndIf
  ; Inside the declared window, written as differences so that a base
  ; plus size which wraps cannot pass the check.
  If base < avkV3dWindowBase Or bytes > avkV3dWindowBytes : ProcedureReturn #VK_ERROR_FEATURE_NOT_PRESENT : EndIf
  If (base - avkV3dWindowBase) > (avkV3dWindowBytes - bytes) : ProcedureReturn #VK_ERROR_FEATURE_NOT_PRESENT : EndIf
  If w < 8 Or h < 8 : ProcedureReturn #VK_ERROR_FEATURE_NOT_PRESENT : EndIf
  If w > Neon_CapacityPhysicalW() Or h > Neon_CapacityPhysicalH() : ProcedureReturn #VK_ERROR_FEATURE_NOT_PRESENT : EndIf
  If pitch <> (w * 4) : ProcedureReturn #VK_ERROR_FEATURE_NOT_PRESENT : EndIf
  If bytes < (pitch * h) : ProcedureReturn #VK_ERROR_FEATURE_NOT_PRESENT : EndIf
  ; This backend is offscreen. The buffer the engine is currently
  ; targeting is the display's, and rendering into it from here would
  ; take ownership the presentation layer holds.
  If base = Neon_SurfaceBase() : ProcedureReturn #VK_ERROR_FEATURE_NOT_PRESENT : EndIf
  ProcedureReturn #VK_SUCCESS
EndProcedure

; Run the clear. The engine's previous target is saved and restored even
; when the frame fails, because leaving the console pointed at a Vulkan
; image would be a far worse failure than the one that caused it.
Procedure.i avkBackendSubmitClear(base.i, bytes.i, w.i, h.i, pitch.i, bgra.i)
  Define rc.i
  Define restoreRc.i
  Define oldBase.i
  Define oldBytes.i
  Define oldW.i
  Define oldH.i
  Define oldPitch.i
  Define oldFormat.i
  Define oldRotation.i

  avkV3dNative = 0
  rc = avkBackendClearSupported(base, bytes, w, h, pitch)
  If rc <> #VK_SUCCESS
    avkV3dNative = rc
    ProcedureReturn -1
  EndIf

  oldBase = Neon_SurfaceBase()
  oldBytes = Neon_SurfaceBytes()
  oldW = Neon_SurfaceW()
  oldH = Neon_SurfaceH()
  oldPitch = Neon_SurfacePitch()
  oldFormat = Neon_SurfaceFormat()
  oldRotation = Neon_SurfaceRotation()

  rc = NeonRebindSurface(base, w, h, pitch, bytes, #V3D_OFMT_RGBA8, 0)
  If rc = #NEON_OK
    rc = NeonFrameBegin(bgra)
  EndIf
  If rc = #NEON_OK
    rc = NeonFrameEnd()
  EndIf
  If rc <> #NEON_OK : avkV3dNative = rc : EndIf

  restoreRc = NeonRebindSurface(oldBase, oldW, oldH, oldPitch, oldBytes, oldFormat, oldRotation)
  If restoreRc <> #NEON_OK And avkV3dNative = 0
    avkV3dNative = restoreRc
  EndIf
  If rc <> #NEON_OK Or restoreRc <> #NEON_OK
    ProcedureReturn -1
  EndIf

  avkV3dJobs = avkV3dJobs + 1
  ; NeonFrameEnd already waited for both jobs and did the cache
  ; maintenance, so the work is finished by the time this returns. That
  ; is a real property of the current engine, not an assumption: the
  ; waits are bounded inside V3dBinWait and V3dRenderWait, and a timeout
  ; there comes back as a Neon error above rather than as a completion.
  ProcedureReturn #ANVIL_VK_JOB_DONE
EndProcedure

Procedure.i avkBackendPoll()
  ProcedureReturn 1
EndProcedure

Procedure.i avkBackendLastNativeError()
  ProcedureReturn avkV3dNative
EndProcedure

Procedure.i avkBackendJobs()
  ProcedureReturn avkV3dJobs
EndProcedure

; Microseconds from the architected generic timer, through the V3D
; library's own reader. The guard is the one V3D and Neon already use:
; CNTFRQ_EL0 is 54,000,000 on this part and zero on a part where nothing
; set it, and dividing by zero in a wait loop is a board that stops
; answering.
Procedure.i avkBackendTicksUs()
  Define hz.i
  hz = V3dCounterHz() / 1000000
  If hz < 1 : hz = 1 : EndIf
  ProcedureReturn V3dTicks() / hz
EndProcedure

; ======================================================================
;  THE GRAPHICS HALF: one render pass, one triangle list
; ======================================================================
;  It runs the SAME frame the clear already proves on silicon, with one
;  draw added between the prologue and the submit:
;
;    NeonRebindSurface  point the engine at the colour attachment and geometry
;    NeonFrameBegin     build the render list, set the clear colour and
;                       write the frame prologue - clip window, clipper
;                       scaling, viewport offset, write masks
;    (this file)        undo the prologue's alpha blend, declare the
;                       varyings' interpolation, clean the caches for
;                       what the processor wrote, then emit GL_SHADER_
;                       STATE and VERTEX_ARRAY_PRIMS
;    NeonFrameEnd       submit the bin job, wait, submit the render job,
;                       wait, and maintain the caches
;    NeonRebindSurface  put the engine's complete previous surface back
;
;  THE PROLOGUE'S BLEND IS TURNED OFF HERE AND THAT IS DELIBERATE. The
;  engine's frame prologue enables SRC_ALPHA / INV_SRC_ALPHA blending,
;  because every rectangle a user interface draws wants it.
;  vkCreateGraphicsPipelines refuses a pipeline that asks for blending,
;  so leaving the prologue's equation in place would blend a triangle
;  the caller asked to be written straight through - a picture that is
;  right everywhere the background is opaque and wrong everywhere it is
;  not. Both packets that carry it are re-emitted: CFG_BITS without its
;  blend-enable bit, and BLEND_ENABLES with no render target selected.
;
;  THE VIEWPORT MUST BE THE RENDER GEOMETRY. The clipper's half width
;  and the viewport offset are written by the prologue from the engine's
;  own surface, and the emitted coordinate shader scales by the
;  pipeline's viewport. If those two disagree the clipper and the
;  rasteriser work on different geometry, which is a wrong picture and
;  not a slow one, so the draw is refused rather than reconciled.

; Neon's frame prologue writes CFG_BITS with both facings enabled, no
; clockwise winding and depth function ALWAYS, and then ORs in the blend
; enable at bit 19. These two constants are that same word without the
; blend bit, and the empty render-target mask that goes with it.
#AVK_V3D_CFG_FWD = 1
#AVK_V3D_CFG_REV = 1
#AVK_V3D_CFG_CW = 0
#AVK_V3D_CFG_DEPTH_ALWAYS = 7

Global avkV3dDraws.i = 0
Global avkV3dLastRecord.i = 0

; The three pipeline entries of the seam are thin: the emitter owns the
; encoding and this file owns the hardware.
Procedure.i avkBackendPipelineBytes()
  ProcedureReturn AnvilVkV3dPipelineBytes()
EndProcedure

Procedure.i avkBackendPipelineBuild(*build.AnvilVkBackendPipelineBuildInfo)
  If *build = 0 : ProcedureReturn #ANVIL_VK_ERR_ARGS : EndIf
  If *build\fragmentIr = 0 : ProcedureReturn #ANVIL_VK_ERR_ARGS : EndIf
  ProcedureReturn AnvilVkV3dCompile(*build)
EndProcedure

Procedure avkBackendPipelineRelease(pipe.i)
  AnvilVkV3dRelease(pipe)
EndProcedure

Procedure.i avkBackendDrawSupported(base.i, bytes.i, w.i, h.i, pitch.i)
  ; The rules are the clear's, in the same order and for the same
  ; reasons: the render target is configured once at NeonInit and this
  ; backend is offscreen by contract.
  ProcedureReturn avkBackendClearSupported(base, bytes, w, h, pitch)
EndProcedure

Procedure.i avkBackendSubmitDraw(*d.AnvilVkBackendDraw)
  Define rc.i
  Define restoreRc.i
  Define oldBase.i
  Define oldBytes.i
  Define oldW.i
  Define oldH.i
  Define oldPitch.i
  Define oldFormat.i
  Define oldRotation.i
  Define pipe.i
  Define pbase.i
  Define varyComps.i
  Define lastVertex.i
  Define vertexBytes.i
  Define b.i
  Define *bind.AnvilVkBackendBinding
  Define *sampled.AnvilVkBackendSampledImage
  Define texturePlan.AvkV3dTexturePlan

  avkV3dNative = 0
  If *d = 0
    ProcedureReturn -1
  EndIf
  pipe = *d\pipeline
  If pipe < 1 Or pipe > #ANVIL_VK_MAX_PIPELINES
    avkFault(#ANVIL_VK_ERR_ARGS, "the Pi 4 Vulkan backend was handed a draw naming a pipeline slot it never compiled (Anvil code -20001, invalid pipeline); nothing was submitted.")
    ProcedureReturn -1
  EndIf
  pbase = AnvilVkV3dCodeBase(pipe)
  If pbase = 0
    avkFault(#ANVIL_VK_ERR_STATE, "the Pi 4 Vulkan backend was handed a draw for a pipeline whose compiled shaders have been released (Anvil code -20004, pipeline not compiled); nothing was submitted. Create the pipeline again before drawing with it.")
    ProcedureReturn -1
  EndIf

  rc = avkBackendDrawSupported(*d\targetBase, *d\targetBytes, *d\width, *d\height, *d\pitch)
  If rc <> #VK_SUCCESS
    avkV3dNative = rc
    ProcedureReturn -1
  EndIf
  If AnvilVkPipelineViewportWidth(pipe) <> *d\width Or AnvilVkPipelineViewportHeight(pipe) <> *d\height
    avkFault(#VK_ERROR_FEATURE_NOT_PRESENT, "the Pi 4 Vulkan backend was handed a draw whose viewport is not the framebuffer render geometry (VkResult -8, VK_ERROR_FEATURE_NOT_PRESENT); nothing was submitted. This tranche requires one whole-frame viewport, so the pipeline viewport and framebuffer must be the same rectangle.")
    avkV3dNative = #VK_ERROR_FEATURE_NOT_PRESENT
    ProcedureReturn -1
  EndIf

  ; EVERY vertex array must be inside the window the GPU can reach. The
  ; portable layer has already checked each is inside its own VkBuffer;
  ; this is the check that the buffer is inside the mapped span, which
  ; only this file knows about, and it is made once per binding because
  ; two bindings are two allocations that were placed separately.
  lastVertex = *d\firstVertex + *d\vertexCount
  If *d\bindingCount < 1 Or *d\bindingCount > #ANVIL_VK_MAX_BINDINGS Or *d\bindings = 0
    avkFault(#ANVIL_VK_ERR_ARGS, "the Pi 4 Vulkan backend was handed a draw with no vertex input bindings, more than four, or no binding array at all (Anvil code -20001, invalid draw); nothing was submitted.")
    ProcedureReturn -1
  EndIf
  b = 0
  While b < *d\bindingCount
    *bind = *d\bindings + (b * SizeOf(AnvilVkBackendBinding))
    vertexBytes = lastVertex * *bind\stride
    If *bind\stride <= 0 Or vertexBytes <= 0
      avkFault(#ANVIL_VK_ERR_ARGS, "the Pi 4 Vulkan backend was handed a draw with no vertex stride on one of its bindings, or no vertices (Anvil code -20001, empty draw); nothing was submitted.")
      ProcedureReturn -1
    EndIf
    If *bind\base < avkV3dWindowBase Or (*bind\base - avkV3dWindowBase) > (avkV3dWindowBytes - vertexBytes)
      avkFault(#VK_ERROR_FEATURE_NOT_PRESENT, "the Pi 4 Vulkan backend was handed a draw one of whose vertex arrays is outside the offscreen window the V3D page table maps (VkResult -8, VK_ERROR_FEATURE_NOT_PRESENT); nothing was submitted. The vertex fetcher reaches memory through that mapping, and an unmapped page is an MMU fault rather than a wrong picture.")
      avkV3dNative = #VK_ERROR_FEATURE_NOT_PRESENT
      ProcedureReturn -1
    EndIf
    b = b + 1
  Wend

  varyComps = avkqVaryComps[pipe]
  ; Push constants, a UBO and a sampled image are independent resources in
  ; typed IR. Validate each live resource on its own instead of selecting one
  ; overloaded colour source; arithmetic shaders may consume combinations.
  If AnvilVkPipelineUsesPushConstants(pipe) <> 0
    If *d\pushBase = 0 Or *d\pushBytes < 16
      avkFault(#ANVIL_VK_ERR_ARGS, "the Pi 4 Vulkan backend was handed a draw whose fragment shader reads push constants but no complete sixteen-byte block was supplied (Anvil code -20001, invalid push constants); nothing was submitted.")
      ProcedureReturn -1
    EndIf
  EndIf
  If AnvilVkPipelineUsesUniformBuffer(pipe) <> 0
    If *d\uniformBase = 0 Or *d\uniformBytes < 16
      avkFault(#ANVIL_VK_ERR_ARGS, "the Pi 4 Vulkan backend was handed a draw whose fragment colour comes from a uniform buffer with no address or a range shorter than sixteen bytes (Anvil code -20001, invalid descriptor); nothing was submitted.")
      ProcedureReturn -1
    EndIf
    If avkV3dWindowBytes < 16 Or *d\uniformBase < avkV3dWindowBase
      avkFault(#VK_ERROR_FEATURE_NOT_PRESENT, "the Pi 4 Vulkan backend was handed a uniform-buffer descriptor outside the offscreen window the V3D page table maps (VkResult -8, VK_ERROR_FEATURE_NOT_PRESENT); nothing was submitted. A TMU general load reaches the descriptor through that mapping, and an unmapped page is an MMU fault rather than a wrong colour.")
      avkV3dNative = #VK_ERROR_FEATURE_NOT_PRESENT
      ProcedureReturn -1
    EndIf
    If (*d\uniformBase - avkV3dWindowBase) > (avkV3dWindowBytes - 16)
      avkFault(#VK_ERROR_FEATURE_NOT_PRESENT, "the Pi 4 Vulkan backend was handed a uniform-buffer descriptor outside the offscreen window the V3D page table maps (VkResult -8, VK_ERROR_FEATURE_NOT_PRESENT); nothing was submitted. A TMU general load reaches the descriptor through that mapping, and an unmapped page is an MMU fault rather than a wrong colour.")
      avkV3dNative = #VK_ERROR_FEATURE_NOT_PRESENT
      ProcedureReturn -1
    EndIf
  EndIf
  *sampled = 0
  If AnvilVkPipelineUsesSampledImage(pipe) <> 0
    *sampled = *d\sampledImage
    If *sampled = 0
      avkFault(#ANVIL_VK_ERR_ARGS, "the Pi 4 Vulkan backend was handed a sampled pipeline without its closed sampled-image record (Anvil code -20001, missing sampled image); nothing was submitted.")
      ProcedureReturn -1
    EndIf
    If *sampled\tiling = #VK_IMAGE_TILING_LINEAR
      If *sampled\width <> 1 Or *sampled\height <> 1 Or *sampled\pitch <> 4 Or *sampled\bytes < 4
        avkFault(#VK_ERROR_FEATURE_NOT_PRESENT, "the Pi 4 Vulkan backend was handed a linear sampled image outside its one-texel contract (VkResult -8, VK_ERROR_FEATURE_NOT_PRESENT); nothing was submitted. Larger sampled images must use the optimal UIF layout produced by vkCmdCopyBufferToImage.")
        avkV3dNative = #VK_ERROR_FEATURE_NOT_PRESENT
        ProcedureReturn -1
      EndIf
    ElseIf *sampled\tiling = #VK_IMAGE_TILING_OPTIMAL
      If AnvilVkV3dTexturePlanBuild(*sampled\width, *sampled\height, *sampled\width * 4, @texturePlan) <> #ANVIL_V3D_TEXTURE_OK
        avkV3dNative = #VK_ERROR_FEATURE_NOT_PRESENT
        ProcedureReturn -1
      EndIf
      If *sampled\backendLayout <> #ANVIL_V3D_TEXTURE_MEM_UIF_NO_XOR Or *sampled\pitch <> 0 Or *sampled\bytes < texturePlan\destinationBytes Or *sampled\paddedWidth <> texturePlan\paddedWidth Or *sampled\paddedHeight <> texturePlan\paddedHeight
        avkFault(#VK_ERROR_FEATURE_NOT_PRESENT, "the Pi 4 Vulkan backend was handed an optimal sampled image whose retained UIF plan is incomplete or inconsistent (VkResult -8, VK_ERROR_FEATURE_NOT_PRESENT); nothing was submitted. Recreate and fill it through the supported optimal-image copy path.")
        avkV3dNative = #VK_ERROR_FEATURE_NOT_PRESENT
        ProcedureReturn -1
      EndIf
    Else
      avkFault(#VK_ERROR_FEATURE_NOT_PRESENT, "the Pi 4 Vulkan backend was handed a sampled image with an unknown physical tiling (VkResult -8, VK_ERROR_FEATURE_NOT_PRESENT); nothing was submitted.")
      avkV3dNative = #VK_ERROR_FEATURE_NOT_PRESENT
      ProcedureReturn -1
    EndIf
    If *sampled\format <> #VK_FORMAT_B8G8R8A8_UNORM Or *sampled\layout <> #VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL
      avkFault(#ANVIL_VK_ERR_ARGS, "the Pi 4 Vulkan backend was handed a sampled image with the wrong format or layout (Anvil code -20001, invalid sampled state); nothing was submitted. This path accepts one B8G8R8A8_UNORM texel in VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL.")
      ProcedureReturn -1
    EndIf
    If (*sampled\magFilter <> #VK_FILTER_NEAREST And *sampled\magFilter <> #VK_FILTER_LINEAR) Or (*sampled\minFilter <> #VK_FILTER_NEAREST And *sampled\minFilter <> #VK_FILTER_LINEAR)
      avkFault(#ANVIL_VK_ERR_ARGS, "the Pi 4 Vulkan backend was handed sampled filter state outside nearest or linear (Anvil code -20001, invalid sampler state); nothing was submitted.")
      ProcedureReturn -1
    EndIf
    If *sampled\bytes < 4 Or *sampled\bytes > avkV3dWindowBytes Or *sampled\base < avkV3dWindowBase Or (*sampled\base - avkV3dWindowBase) > (avkV3dWindowBytes - *sampled\bytes)
      avkFault(#VK_ERROR_FEATURE_NOT_PRESENT, "the Pi 4 Vulkan backend was handed a sampled texel outside the offscreen window mapped by the V3D page table (VkResult -8, VK_ERROR_FEATURE_NOT_PRESENT); nothing was submitted. An unmapped texture request is an MMU fault, not a wrong pixel.")
      avkV3dNative = #VK_ERROR_FEATURE_NOT_PRESENT
      ProcedureReturn -1
    EndIf
  EndIf
  rc = AnvilVkV3dFragmentUniforms(pipe, pbase, *d\pushBase, *d\uniformBase, *sampled)
  If rc <> #VK_SUCCESS
    avkV3dNative = rc
    avkFault(rc, "the Pi 4 Vulkan backend refused inconsistent fragment uniform metadata or missing per-draw resources; no uniform word and no control list was submitted.")
    ProcedureReturn -1
  EndIf
  rc = AnvilVkV3dBuildRecord(pipe, pbase, *d, lastVertex - 1, varyComps)
  If rc <> #V3D_OK
    avkV3dNative = rc
    avkFault(#VK_ERROR_INITIALIZATION_FAILED, "the Pi 4 Vulkan backend could not build this draw's GL shader state record (VkResult -3, VK_ERROR_INITIALIZATION_FAILED); nothing was submitted. V3dError() carries the control-list builder's own code.")
    ProcedureReturn -1
  EndIf
  avkV3dLastRecord = pbase + #AVKQ_OFF_SHREC

  oldBase = Neon_SurfaceBase()
  oldBytes = Neon_SurfaceBytes()
  oldW = Neon_SurfaceW()
  oldH = Neon_SurfaceH()
  oldPitch = Neon_SurfacePitch()
  oldFormat = Neon_SurfaceFormat()
  oldRotation = Neon_SurfaceRotation()

  rc = NeonRebindSurface(*d\targetBase, *d\width, *d\height, *d\pitch, *d\targetBytes, #V3D_OFMT_RGBA8, 0)
  If rc = #NEON_OK
    rc = NeonFrameBegin(*d\clearBgra)
  EndIf
  If rc = #NEON_OK
    ; Undo the prologue's alpha blend, both packets that carry it.
    V3dClCfgBits(V3dCfgBitsWord(#AVK_V3D_CFG_FWD, #AVK_V3D_CFG_REV, #AVK_V3D_CFG_CW, #AVK_V3D_CFG_DEPTH_ALWAYS))
    V3dClBlendEnables(0)
    ; The varyings this fragment shader reads with a plain add against
    ; r5 are non-perspective ones. With every W equal to one the two
    ; interpolations are the same number, and this is the shape the
    ; engine's textured program already runs on this board.
    If varyComps > 0
      V3dClNonperspFlags((1 << varyComps) - 1)
    EndIf
    V3dCacheRange(pbase, #AVKQ_BYTES)
    ; The QPU, not the processor, reads a descriptor-backed colour. Make
    ; the sixteen bytes visible before the TMU is allowed to fetch them.
    If AnvilVkPipelineUsesUniformBuffer(pipe) <> 0
      V3dCacheRange(*d\uniformBase, 16)
    EndIf
    ; The QPU's texture request reads the application's mapped texel directly.
    ; Clean that exact range before the control list can launch the request.
    If *sampled <> 0
      V3dCacheRange(*sampled\base, *sampled\bytes)
    EndIf
    ; One cache maintenance per binding: the processor wrote each of
    ; these buffers and the vertex fetcher reads all of them.
    b = 0
    While b < *d\bindingCount
      *bind = *d\bindings + (b * SizeOf(AnvilVkBackendBinding))
      V3dCacheRange(*bind\base, lastVertex * *bind\stride)
      b = b + 1
    Wend
    ; A null pSampleMask means all samples; with one sample, bit zero is
    ; the complete fragment coverage. When it is clear the render pass
    ; clear still executes, but no primitive may enter rasterisation.
    If *d\sampleMask <> 0
      V3dClGlShaderState(pbase + #AVKQ_OFF_SHREC, AnvilVkV3dRecordCount(pipe))
      V3dClVertexArrayPrims(#AVKQ_PRIM_TRIANGLES, *d\vertexCount, *d\firstVertex)
    EndIf
    If V3dClError() <> #V3D_OK
      rc = #NEON_ERR_LIST
    EndIf
  EndIf
  If rc = #NEON_OK
    rc = NeonFrameEnd()
  EndIf
  If rc <> #NEON_OK : avkV3dNative = rc : EndIf

  restoreRc = NeonRebindSurface(oldBase, oldW, oldH, oldPitch, oldBytes, oldFormat, oldRotation)
  If restoreRc <> #NEON_OK And avkV3dNative = 0
    avkV3dNative = restoreRc
  EndIf
  If rc <> #NEON_OK Or restoreRc <> #NEON_OK
    ProcedureReturn -1
  EndIf

  avkV3dJobs = avkV3dJobs + 1
  avkV3dDraws = avkV3dDraws + 1
  ProcedureReturn #ANVIL_VK_JOB_DONE
EndProcedure

Procedure.i avkBackendDraws()
  ProcedureReturn avkV3dDraws
EndProcedure

; Where the last draw's GL shader state record was built, so a board
; diagnostic can read the bytes the GPU was pointed at.
Procedure.i AnvilVkV3dLastShaderRecord()
  ProcedureReturn avkV3dLastRecord
EndProcedure
