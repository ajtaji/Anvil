; ======================================================================
;  Development-only V3D lowering for one transfer command sequence
; ======================================================================
; SPDX-License-Identifier: MIT
;
; This file is not a Vulkan implementation or a production backend. It lowers
; exactly this recorded sequence against one explicitly bound OFFSCREEN image:
;
;   UNDEFINED -> TRANSFER_DST_OPTIMAL image barrier
;   full-range clear of one B8G8R8A8_UNORM color image
;
; The real execution path is NeonFrameBegin + NeonFrameEnd with no draws. That
; produces and submits V3D bin/render control lists; the tile clear and tile
; store write the image. NeonFrameEnd waits for both jobs and V3dRenderWait
; performs the V3D clean plus the ARM-side target cache maintenance. There is
; no CPU image-writing fallback here.
;
; The caller must include v3dqpu.pi4, v3d.pi4 and neon.pi4 before this file,
; must have initialized Neon, and must reserve an identity-mapped offscreen
; window. Binding never maps memory and never takes display ownership. Submit
; saves and restores Neon's current render target synchronously.

XIncludeFile "Anvil/Graphics/Vulkan/vk_foundation.pbi"

#ANVIL_VK_V3D_DEV_CMD_NONE = 0
#ANVIL_VK_V3D_DEV_CMD_TRANSITION_CLEAR = 1

Global avkV3dDevMapBase.i
Global avkV3dDevMapBytes.i
Global avkV3dDevImageBound.i
Global avkV3dDevImageDevice.i
Global avkV3dDevImageBase.i
Global avkV3dDevImageBytes.i
Global avkV3dDevImageW.i
Global avkV3dDevImageH.i
Global avkV3dDevImagePitch.i
Global avkV3dDevImageLayout.i
Global avkV3dDevLastNative.i
Global avkV3dDevSubmits.i

Global Dim avkV3dDevCmdKind.a[#ANVIL_VK_MAX_COMMAND_BUFFERS]
Global Dim avkV3dDevCmdOldLayout.i[#ANVIL_VK_MAX_COMMAND_BUFFERS]
Global Dim avkV3dDevCmdNewLayout.i[#ANVIL_VK_MAX_COMMAND_BUFFERS]
Global Dim avkV3dDevCmdColor.i[#ANVIL_VK_MAX_COMMAND_BUFFERS]

Procedure.i AnvilVkV3dDevelopmentEnable(mappedBase.i, mappedBytes.i)
  Define rc.i
  If mappedBase <= 0 Or mappedBytes < 4096
    ProcedureReturn #ANVIL_VK_ERR_ARGS
  EndIf
  rc = avkBackendEnable(#ANVIL_VK_BACKEND_V3D_DEVELOPMENT)
  If rc <> #ANVIL_VK_OK : ProcedureReturn rc : EndIf
  avkV3dDevMapBase = mappedBase
  avkV3dDevMapBytes = mappedBytes
  ProcedureReturn #ANVIL_VK_OK
EndProcedure

Procedure.i AnvilVkV3dDevelopmentFormat()
  ProcedureReturn #VK_FORMAT_B8G8R8A8_UNORM
EndProcedure

; Attach metadata for memory already owned and mapped by the caller. The image
; must fit wholly inside the declared development window; arithmetic is written
; as differences so an address+size wrap cannot pass the check.
Procedure.i AnvilVkV3dDevelopmentImageBind(device.i, base.i, bytes.i, width.i, height.i, pitch.i, initialLayout.i)
  If avkBackendKind <> #ANVIL_VK_BACKEND_V3D_DEVELOPMENT
    ProcedureReturn #ANVIL_VK_ERR_UNSUPPORTED
  EndIf
  If avkDevSlot(device) = 0 : ProcedureReturn #ANVIL_VK_ERR_HANDLE : EndIf
  If base < avkV3dDevMapBase Or bytes <= 0 Or bytes > avkV3dDevMapBytes
    ProcedureReturn #ANVIL_VK_ERR_ARGS
  EndIf
  If (base - avkV3dDevMapBase) > (avkV3dDevMapBytes - bytes)
    ProcedureReturn #ANVIL_VK_ERR_ARGS
  EndIf
  If width < 1 Or height < 1 Or pitch < (width * 4)
    ProcedureReturn #ANVIL_VK_ERR_ARGS
  EndIf
  If height > (bytes / pitch)
    ProcedureReturn #ANVIL_VK_ERR_ARGS
  EndIf
  ; Only UNDEFINED is accepted in this first slice: discarding all prior
  ; contents needs no unimplemented source-stage/source-access dependency.
  If initialLayout <> #VK_IMAGE_LAYOUT_UNDEFINED
    ProcedureReturn #ANVIL_VK_ERR_ARGS
  EndIf
  avkV3dDevImageDevice = device
  avkV3dDevImageBase = base
  avkV3dDevImageBytes = bytes
  avkV3dDevImageW = width
  avkV3dDevImageH = height
  avkV3dDevImagePitch = pitch
  avkV3dDevImageLayout = initialLayout
  avkV3dDevImageBound = 1
  ProcedureReturn #VK_SUCCESS
EndProcedure

; Record the two-command subset. r/g/b/a are exact 8-bit UNORM endpoint or
; quantized values. The packed word is AARRGGBB, whose little-endian byte order
; is B,G,R,A: exactly VK_FORMAT_B8G8R8A8_UNORM storage order.
Procedure.i AnvilVkV3dDevelopmentCmdTransitionClear(commandBuffer.i, oldLayout.i, r.i, g.i, b.i, a.i)
  Define c.i
  c = avkCmdSlot(commandBuffer)
  If c = 0 : ProcedureReturn #ANVIL_VK_ERR_HANDLE : EndIf
  If avkCmdState[c] <> #ANVIL_VK_CB_RECORDING Or avkCmdOps[c] <> 0
    ProcedureReturn #ANVIL_VK_ERR_STATE
  EndIf
  If avkV3dDevImageBound = 0 : ProcedureReturn #ANVIL_VK_ERR_STATE : EndIf
  If oldLayout <> #VK_IMAGE_LAYOUT_UNDEFINED
    ProcedureReturn #ANVIL_VK_ERR_ARGS
  EndIf
  If r < 0 Or r > 255 Or g < 0 Or g > 255 Or b < 0 Or b > 255 Or a < 0 Or a > 255
    ProcedureReturn #ANVIL_VK_ERR_ARGS
  EndIf
  avkV3dDevCmdKind[c] = #ANVIL_VK_V3D_DEV_CMD_TRANSITION_CLEAR
  avkV3dDevCmdOldLayout[c] = oldLayout
  avkV3dDevCmdNewLayout[c] = #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL
  avkV3dDevCmdColor[c] = (a << 24) | (r << 16) | (g << 8) | b
  avkCmdOps[c] = 2
  ProcedureReturn #VK_SUCCESS
EndProcedure

Procedure.i AnvilVkV3dDevelopmentQueueSubmit(queue.i, commandBuffer.i)
  Define q.i
  Define c.i
  Define p.i
  Define d.i
  Define oldBase.i
  Define oldBytes.i
  Define rc.i
  Define restoreRc.i

  If avkBackendKind <> #ANVIL_VK_BACKEND_V3D_DEVELOPMENT
    ProcedureReturn #ANVIL_VK_ERR_UNSUPPORTED
  EndIf
  q = avkQueueSlot(queue)
  c = avkCmdSlot(commandBuffer)
  If q = 0 Or c = 0 : ProcedureReturn #ANVIL_VK_ERR_HANDLE : EndIf
  p = avkCmdPool[c]
  d = avkQueueDev[q]
  If avkPoolDev[p] <> d : ProcedureReturn #ANVIL_VK_ERR_OWNER : EndIf
  If avkDevSlot(avkV3dDevImageDevice) <> d : ProcedureReturn #ANVIL_VK_ERR_OWNER : EndIf
  If avkCmdLevel[c] <> #VK_COMMAND_BUFFER_LEVEL_PRIMARY Or avkCmdState[c] <> #ANVIL_VK_CB_EXECUTABLE
    ProcedureReturn #ANVIL_VK_ERR_STATE
  EndIf
  If avkCmdOps[c] <> 2 Or avkV3dDevCmdKind[c] <> #ANVIL_VK_V3D_DEV_CMD_TRANSITION_CLEAR
    ProcedureReturn #VK_ERROR_FEATURE_NOT_PRESENT
  EndIf
  If avkV3dDevImageLayout <> avkV3dDevCmdOldLayout[c]
    ProcedureReturn #ANVIL_VK_ERR_STATE
  EndIf
  If Neon_Ready() = 0 : ProcedureReturn #VK_ERROR_DEVICE_LOST : EndIf
  If Neon_SurfacePhysicalW() <> avkV3dDevImageW Or Neon_SurfacePhysicalH() <> avkV3dDevImageH
    ProcedureReturn #VK_ERROR_FEATURE_NOT_PRESENT
  EndIf
  If Neon_SurfacePitch() <> avkV3dDevImagePitch
    ProcedureReturn #VK_ERROR_FEATURE_NOT_PRESENT
  EndIf

  oldBase = Neon_SurfaceBase()
  oldBytes = Neon_SurfacePitch() * Neon_SurfacePhysicalH()
  ; This first backend is deliberately offscreen. WSI/display images remain
  ; owned by the existing presentation layer.
  If oldBase = avkV3dDevImageBase : ProcedureReturn #ANVIL_VK_ERR_OWNER : EndIf

  avkCmdState[c] = #ANVIL_VK_CB_PENDING
  avkV3dDevLastNative = 0
  rc = NeonRetarget(avkV3dDevImageBase, avkV3dDevImageBytes)
  If rc = #NEON_OK
    rc = NeonFrameBegin(avkV3dDevCmdColor[c])
  EndIf
  If rc = #NEON_OK
    rc = NeonFrameEnd()
  EndIf
  If rc <> #NEON_OK : avkV3dDevLastNative = rc : EndIf

  restoreRc = NeonRetarget(oldBase, oldBytes)
  If restoreRc <> #NEON_OK And avkV3dDevLastNative = 0
    avkV3dDevLastNative = restoreRc
  EndIf
  If rc <> #NEON_OK Or restoreRc <> #NEON_OK
    avkCmdState[c] = #ANVIL_VK_CB_INVALID
    ProcedureReturn #VK_ERROR_DEVICE_LOST
  EndIf

  avkV3dDevImageLayout = avkV3dDevCmdNewLayout[c]
  avkV3dDevSubmits = avkV3dDevSubmits + 1
  If (avkCmdBeginFlags[c] & #VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT) <> 0
    avkCmdState[c] = #ANVIL_VK_CB_INVALID
  Else
    avkCmdState[c] = #ANVIL_VK_CB_EXECUTABLE
  EndIf
  ProcedureReturn #VK_SUCCESS
EndProcedure

Procedure.i AnvilVkV3dDevelopmentImageLayout()
  If avkV3dDevImageBound = 0 : ProcedureReturn #ANVIL_VK_ERR_STATE : EndIf
  ProcedureReturn avkV3dDevImageLayout
EndProcedure

Procedure.i AnvilVkV3dDevelopmentLastNativeError()
  ProcedureReturn avkV3dDevLastNative
EndProcedure

Procedure.i AnvilVkV3dDevelopmentSubmits()
  ProcedureReturn avkV3dDevSubmits
EndProcedure
