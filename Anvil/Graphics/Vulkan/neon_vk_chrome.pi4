Procedure.i nvcFail(code.i)
  nvcError = code
  ProcedureReturn code
EndProcedure

Procedure.i NeonVkChromeError()
  ProcedureReturn nvcError
EndProcedure

Procedure.i NeonVkChromeReady()
  ProcedureReturn nvcReady
EndProcedure

Procedure.i NeonVkChromeExternalProducerAttach()
  If nvcReady = 0 Or nvcInFrame <> 0 Or nvcFrameAbortable <> 0 Or nvcExternalProducerAttached <> 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  nvcExternalProducerAttached = 1
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

; The producer calls this before a submit whose completion may be uncertain.
Procedure.i NeonVkChromeExternalProducerQuarantine()
  If nvcReady = 0 Or nvcInFrame <> 0 Or nvcFrameAbortable <> 0 Or nvcExternalProducerAttached = 0 Or nvcExternalProducerQuarantined <> 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  nvcExternalProducerQuarantined = 1
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

; Only the producer can establish completed compute and successful cache clean.
Procedure.i NeonVkChromeExternalProducerUnquarantine()
  If nvcReady = 0 Or nvcInFrame <> 0 Or nvcFrameAbortable <> 0 Or nvcExternalProducerAttached = 0 Or nvcExternalProducerQuarantined = 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  nvcExternalProducerQuarantined = 0
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

; Call only after the producer has proved idle and released its allocations.
Procedure.i NeonVkChromeExternalProducerDetach()
  Define rc.i
  If nvcReady = 0 Or nvcInFrame <> 0 Or nvcFrameAbortable <> 0 Or nvcExternalProducerAttached = 0 Or nvcExternalProducerQuarantined <> 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  rc = vkDeviceWaitIdle(nvcDevice)
  If rc <> #VK_SUCCESS : ProcedureReturn nvcFail(rc) : EndIf
  nvcExternalProducerAttached = 0
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

Procedure.i NeonVkChromeLogoSource(*rgb, width.i, height.i)
  If nvcReady <> 0 Or nvcInFrame <> 0 : ProcedureReturn #NEON_VK_CHROME_ERR_STATE : EndIf
  If *rgb = 0 And width = 0 And height = 0
    nvcLogoSource = 0 : nvcLogoW = 0 : nvcLogoH = 0 : nvcLogoChannels = 0
    ProcedureReturn #NEON_VK_CHROME_OK
  EndIf
  If *rgb = 0 Or width < 1 Or width > (#NEON_VK_CHROME_TT_ATLAS_W - 32) Or height < 1 Or height > 256
    ProcedureReturn #NEON_VK_CHROME_ERR_ARGS
  EndIf
  nvcLogoSource = *rgb : nvcLogoW = width : nvcLogoH = height : nvcLogoChannels = 3
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

; Register one tightly packed RGBA8 image before Create. The atlas upload
; copies it, but this registration persists across Destroy/Create. Keep the
; source valid for each later Create, replace it, or clear it explicitly.
Procedure.i NeonVkChromeSpriteSource(*rgba, width.i, height.i)
  If nvcReady <> 0 Or nvcInFrame <> 0 : ProcedureReturn #NEON_VK_CHROME_ERR_STATE : EndIf
  If *rgba = 0 And width = 0 And height = 0
    nvcLogoSource = 0 : nvcLogoW = 0 : nvcLogoH = 0 : nvcLogoChannels = 0
    ProcedureReturn #NEON_VK_CHROME_OK
  EndIf
  If *rgba = 0 Or width < 1 Or width > (#NEON_VK_CHROME_TT_ATLAS_W - 32) Or height < 1 Or height > 256
    ProcedureReturn #NEON_VK_CHROME_ERR_ARGS
  EndIf
  nvcLogoSource = *rgba : nvcLogoW = width : nvcLogoH = height : nvcLogoChannels = 4
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

; Stable IDs are 1..16. Source memory must remain valid for
; every later Create until replaced or cleared. Registration may be changed
; only while Chrome is destroyed. The legacy source is independent.
Procedure.i NeonVkChromeSpriteRegister(id.i, *rgba, width.i, height.i)
  If nvcReady <> 0 Or nvcInFrame <> 0 : ProcedureReturn #NEON_VK_CHROME_ERR_STATE : EndIf
  If id < 1 Or id > #NVC_MULTI_SPRITE_MAX : ProcedureReturn #NEON_VK_CHROME_ERR_ARGS : EndIf
  If *rgba = 0 And width = 0 And height = 0
    nvcSpriteSource[id] = 0 : nvcSpriteW[id] = 0 : nvcSpriteH[id] = 0
    nvcSpriteX[id] = 0 : nvcSpriteY[id] = 0
    ProcedureReturn #NEON_VK_CHROME_OK
  EndIf
  If *rgba = 0 Or width < 1 Or width > (#NEON_VK_CHROME_TT_ATLAS_W - 32) Or height < 1 Or height > #NVC_SPRITE_SHELF_H
    ProcedureReturn #NEON_VK_CHROME_ERR_ARGS
  EndIf
  nvcSpriteSource[id] = *rgba : nvcSpriteW[id] = width : nvcSpriteH[id] = height
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

Procedure.i NeonVkChromeWsiAttach(device.i, swapchain.i, imageIndex.i)
  If nvcReady = 0 Or nvcExternalProducerQuarantined <> 0 Or nvdPresentPending() <> 0
    ProcedureReturn #NEON_VK_CHROME_ERR_STATE
  EndIf
  ProcedureReturn nvdWsiAttach(device, swapchain, imageIndex, nvcTargetGeneration)
EndProcedure

; Rebind is a failure-atomic target transaction. The caller owns the
; framebuffer extent and attachment lifetime; this adapter records the
; identity and validated logical/physical geometry but does not create or
; resize the framebuffer. The active target remains untouched until every
; check passes.
Procedure.i NeonVkChromeRebind(framebuffer.i, logicalW.i, logicalH.i, physicalW.i, physicalH.i, pitch.i, rotation.i)
  Define expectedW.i
  Define expectedH.i
  If nvcReady = 0 Or nvcInFrame <> 0 Or nvcExternalProducerQuarantined <> 0 Or nvdPresentPending() <> 0 Or nvdWsiEnabled() <> 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  If framebuffer = 0 Or logicalW < 1 Or logicalH < 1 Or physicalW < 1 Or physicalH < 1
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If physicalW > $1FFFFFFFFFFFFFFF Or pitch < physicalW * 4
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If rotation <> 0 And rotation <> 90 And rotation <> 180 And rotation <> 270
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If rotation = 90 Or rotation = 270
    expectedW = logicalH : expectedH = logicalW
  Else
    expectedW = logicalW : expectedH = logicalH
  EndIf
  If physicalW <> expectedW Or physicalH <> expectedH
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If nvcNextTargetGeneration = #NVC_MAX_GENERATION
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  nvcFramebuffer = framebuffer
  nvcLogicalW = logicalW : nvcLogicalH = logicalH
  nvcPhysicalW = physicalW : nvcPhysicalH = physicalH
  nvcPitch = pitch : nvcRotation = rotation
  nvcWidth = logicalW : nvcHeight = logicalH
  nvcNextTargetGeneration = nvcNextTargetGeneration + 1
  nvcTargetGeneration = nvcNextTargetGeneration
  nvcError = 0
  ProcedureReturn #VK_SUCCESS
EndProcedure

Procedure.i NeonVkChromeDrawCount()
  ProcedureReturn nvcDrawCount
EndProcedure

Procedure.i NeonVkChromeVertexCount()
  ProcedureReturn nvcVertices + nvcExternalVertices
EndProcedure

Procedure.i NeonVkChromePresentPending()
  ProcedureReturn nvdPresentPending()
EndProcedure

Procedure.i NeonVkChromePresentConsume()
  If nvdPresentPending() = 0
    ProcedureReturn 0
  EndIf
  If nvdPresentMatches(nvcTargetGeneration, nvcFramebuffer) = 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  If nvdPresentConsume(nvcTargetGeneration, nvcFramebuffer) = 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  ProcedureReturn 1
EndProcedure

Procedure.i nvcHostMemoryType(typeBits.i)
  Define mp.VkPhysicalDeviceMemoryProperties
  Define i.i
  vkGetPhysicalDeviceMemoryProperties(nvcPhysical, @mp)
  i = 0
  While i < mp\memoryTypeCount
    If (typeBits & (1 << i)) <> 0
      If (mp\memoryTypes[i]\propertyFlags & #VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) <> 0
        If (mp\memoryTypes[i]\propertyFlags & #VK_MEMORY_PROPERTY_HOST_COHERENT_BIT) <> 0
          ProcedureReturn i
        EndIf
      EndIf
    EndIf
    i = i + 1
  Wend
  ProcedureReturn -1
EndProcedure

Procedure.i nvcBufferCreate(bytes.i, usage.i, *outBuffer, *outMemory)
  Define bci.VkBufferCreateInfo
  Define req.VkMemoryRequirements
  Define mai.VkMemoryAllocateInfo
  Define buffer.i
  Define memory.i
  Define mt.i
  Define rc.i

  If bytes <= 0 Or *outBuffer = 0 Or *outMemory = 0
    ProcedureReturn #NEON_VK_CHROME_ERR_ARGS
  EndIf
  bci\sType = #VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO
  bci\size = bytes
  bci\usage = usage
  bci\sharingMode = #VK_SHARING_MODE_EXCLUSIVE
  rc = vkCreateBuffer(nvcDevice, @bci, 0, @buffer)
  If rc <> #VK_SUCCESS : ProcedureReturn rc : EndIf
  vkGetBufferMemoryRequirements(nvcDevice, buffer, @req)
  mt = nvcHostMemoryType(req\memoryTypeBits)
  If mt < 0
    vkDestroyBuffer(nvcDevice, buffer, 0)
    ProcedureReturn #NEON_VK_CHROME_ERR_VULKAN
  EndIf
  mai\sType = #VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO
  mai\allocationSize = req\size
  mai\memoryTypeIndex = mt
  rc = vkAllocateMemory(nvcDevice, @mai, 0, @memory)
  If rc = #VK_SUCCESS
    rc = vkBindBufferMemory(nvcDevice, buffer, memory, 0)
  EndIf
  If rc <> #VK_SUCCESS
    If memory <> 0 : vkFreeMemory(nvcDevice, memory, 0) : EndIf
    vkDestroyBuffer(nvcDevice, buffer, 0)
    ProcedureReturn rc
  EndIf
  PokeI(*outBuffer, buffer)
  PokeI(*outMemory, memory)
  ProcedureReturn #VK_SUCCESS
EndProcedure

; One ordered submission seam serves the one-time atlas upload at Create and
; each completed frame. Therefore frame End still has exactly one submission,
; while resource initialization does not duplicate queue/fence ownership.
Procedure.i nvcSubmitAndWait()
  Define si.VkSubmitInfo
  Define cmdHandle.i
  Define fenceHandle.i
  Define rc.i
  nvcSubmitStage = 2 : nvcSubmitRc = #VK_SUCCESS
  fenceHandle = nvcFence
  rc = vkResetFences(nvcDevice, 1, @fenceHandle)
  cmdHandle = nvcCommand
  si\sType = #VK_STRUCTURE_TYPE_SUBMIT_INFO
  si\commandBufferCount = 1 : si\pCommandBuffers = @cmdHandle
  If rc = #VK_SUCCESS
    nvcSubmitStage = 3
    ; From this point a failed queue call may have submitted GPU work.
    If nvcFrameAbortable <> 0 : nvcFrameAbortable = 0 : EndIf
    rc = vkQueueSubmit(nvcQueue, 1, @si, nvcFence)
  EndIf
  If rc = #VK_SUCCESS
    nvcSubmitStage = 4
    rc = vkWaitForFences(nvcDevice, 1, @fenceHandle, 1, #NEON_VK_CHROME_WAIT_NS)
  EndIf
  nvcSubmitRc = rc
  ProcedureReturn rc
EndProcedure

; The bitmap atlas publishes exact power-of-two normalized texel edges. Recover
; its integer source coordinate before dividing by the widened image extent.
Procedure.i nvcF32Pixel(bits.i, dimension.i)
  Define exponent.i
  Define mantissa.i
  Define dimShift.i
  Define shift.i
  If bits = 0 Or dimension < 1 : ProcedureReturn 0 : EndIf
  While (1 << dimShift) < dimension : dimShift + 1 : Wend
  If (1 << dimShift) <> dimension : ProcedureReturn -1 : EndIf
  exponent = (bits >> 23) & $FF
  mantissa = (bits & $7FFFFF) | $800000
  shift = exponent - 150 + dimShift
  If shift >= 0
    ProcedureReturn mantissa << shift
  EndIf
  ProcedureReturn mantissa >> (0 - shift)
EndProcedure

Procedure.i nvcAtlasMapBitmapUV(*uv.NeonAtlasGlyphUV, bold.i)
  Define x0.i, x1.i, y0.i, y1.i
  If *uv = 0 Or nvcAtlasBaseW < 1 Or nvcAtlasBaseH < 1
    ProcedureReturn 0
  EndIf
  x0 = nvcF32Pixel(*uv\left, nvcAtlasBaseW)
  x1 = nvcF32Pixel(*uv\right, nvcAtlasBaseW)
  y0 = nvcF32Pixel(*uv\top, nvcAtlasBaseH)
  y1 = nvcF32Pixel(*uv\bottom, nvcAtlasBaseH)
  If x0 < 0 Or x1 < x0 Or x1 > nvcAtlasBaseW Or y0 < 0 Or y1 < y0 Or y1 > nvcAtlasBaseH
    ProcedureReturn 0
  EndIf
  If bold <> 0 : x0 = x0 + 16 : x1 = x1 + 16 : EndIf
  *uv\left = neon_F32Ratio(x0, nvcAtlasW)
  *uv\right = neon_F32Ratio(x1, nvcAtlasW)
  *uv\top = neon_F32Ratio(y0, nvcAtlasH)
  *uv\bottom = neon_F32Ratio(y1, nvcAtlasH)
  ProcedureReturn 1
EndProcedure

; One conservative partial shape works with the bounded optimal-image copy
; contract: tile-aligned interior, one region, no more than 256 4x4 tiles.
; The source offset is checked against the public device alignment query.
; Any unsupported shape takes the established full-atlas transfer path.
Procedure.i nvcTTPartialPlan(*copy.VkBufferImageCopy)
  Define props.VkPhysicalDeviceProperties
  Define x0.i, y0.i, x1.i, y1.i, width.i, height.i, align.i, offset.i, caps.i, required.i
  If *copy = 0 Or nvcTTDirtyRectValid = 0 Or nvcTTForceFull <> 0 Or nvcPhysical = 0
    ProcedureReturn 0
  EndIf
  If nvcTTDirtyLeft < 32 Or nvcTTDirtyTop < 0 Or nvcTTDirtyRight > nvcAtlasW Or nvcTTDirtyBottom > nvcAtlasH
    ProcedureReturn 0
  EndIf
  required = #ANVIL_VK_CAP_BUFFER_TRANSFER | #ANVIL_VK_CAP_LINEAR_TRANSFER | #ANVIL_VK_CAP_BUFFER_TO_TILED_RECT_COPY
  caps = avkBackendCaps()
  If (caps & required) <> required : ProcedureReturn 0 : EndIf
  x0 = (nvcTTDirtyLeft / 16) * 16
  y0 = (nvcTTDirtyTop / 4) * 4
  x1 = ((nvcTTDirtyRight + 3) / 4) * 4
  y1 = ((nvcTTDirtyBottom + 3) / 4) * 4
  width = x1 - x0 : height = y1 - y0
  If x0 < 32 Or y0 < 0 Or x1 > nvcAtlasW Or y1 > nvcAtlasH Or width < 4 Or height < 4
    ProcedureReturn 0
  EndIf
  If (width / 4) * (height / 4) > #NVC_TT_PARTIAL_MAX_TILES
    ProcedureReturn 0
  EndIf
  vkGetPhysicalDeviceProperties(nvcPhysical, @props)
  align = props\limits\optimalBufferCopyOffsetAlignment
  If align < 1 Or (align & (align - 1)) <> 0 : ProcedureReturn 0 : EndIf
  offset = #NEON_VK_CHROME_ATLAS_PAD + ((y0 * nvcAtlasW + x0) * 4)
  If (offset % align) <> 0 : ProcedureReturn 0 : EndIf
  *copy\bufferOffset = offset
  *copy\bufferRowLength = nvcAtlasW
  *copy\imageOffset\x = x0 : *copy\imageOffset\y = y0
  *copy\imageExtent\width = width : *copy\imageExtent\height = height
  ProcedureReturn 1
EndProcedure

; Dynamic glyph misses are uploaded only before a frame begins. The mapped
; staging allocation remains the complete atlas; the copy rectangle may be
; smaller. Callers never mutate sampled texels during a render pass.
Procedure.i nvcAtlasUploadWarm(allowPartial.i)
  Define bi.VkCommandBufferBeginInfo
  Define bar.VkImageMemoryBarrier
  Define copy.VkBufferImageCopy
  Define rc.i, partial.i
  If nvcInFrame <> 0 Or nvcAtlasUploadMapped = 0 Or nvcUploadBuffer = 0 Or nvcAtlasFaulted <> 0
    ProcedureReturn #NEON_VK_CHROME_ERR_STATE
  EndIf
  rc = vkResetCommandBuffer(nvcCommand, 0)
  bi\sType = #VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO
  bi\flags = #VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT
  If rc = #VK_SUCCESS : rc = vkBeginCommandBuffer(nvcCommand, @bi) : EndIf
  bar\sType = #VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER
  bar\srcAccessMask = #VK_ACCESS_SHADER_READ_BIT
  bar\dstAccessMask = #VK_ACCESS_TRANSFER_WRITE_BIT
  bar\oldLayout = #VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL
  bar\newLayout = #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL
  bar\srcQueueFamilyIndex = #VK_QUEUE_FAMILY_IGNORED
  bar\dstQueueFamilyIndex = #VK_QUEUE_FAMILY_IGNORED
  bar\image = nvcAtlasImage
  bar\subresourceRange\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT
  bar\subresourceRange\levelCount = 1 : bar\subresourceRange\layerCount = 1
  copy\bufferOffset = #NEON_VK_CHROME_ATLAS_PAD
  copy\imageSubresource\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT
  copy\imageSubresource\layerCount = 1
  copy\imageExtent\width = nvcAtlasW : copy\imageExtent\height = nvcAtlasH : copy\imageExtent\depth = 1
  If allowPartial <> 0 : partial = nvcTTPartialPlan(@copy) : EndIf
  If rc = #VK_SUCCESS
    vkCmdPipelineBarrier(nvcCommand, #VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, #VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, 0, 0, 0, 1, @bar)
    vkCmdCopyBufferToImage(nvcCommand, nvcUploadBuffer, nvcAtlasImage, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @copy)
    bar\srcAccessMask = #VK_ACCESS_TRANSFER_WRITE_BIT
    bar\dstAccessMask = #VK_ACCESS_SHADER_READ_BIT
    bar\oldLayout = #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL
    bar\newLayout = #VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL
    vkCmdPipelineBarrier(nvcCommand, #VK_PIPELINE_STAGE_TRANSFER_BIT, #VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, 0, 0, 0, 0, 0, 1, @bar)
    rc = vkEndCommandBuffer(nvcCommand)
  EndIf
  If rc = #VK_SUCCESS : rc = nvcSubmitAndWait() : EndIf
  If rc = #VK_SUCCESS
    nvcAtlasUploadCount + 1
    nvcAtlasLastUploadBytes = copy\imageExtent\width * copy\imageExtent\height * 4
    If partial <> 0
      nvcAtlasPartialUploadCount + 1
    Else
      nvcAtlasFullUploadCount + 1
    EndIf
  Else
    nvcAtlasFaulted = 1
  EndIf
  ProcedureReturn rc
EndProcedure

; Refresh the bitmap-owned atlas columns only while the frame is quiescent.
; TrueType glyphs live from x=32 onward. A failed GPU upload poisons this
; owner because the prior image contents can no longer be trusted.
Procedure.i nvcAtlasRefresh()
  Define source.i, width.i, height.i, bytes.i, generation.i
  Define x.i, y.i, target.i, rc.i
  Define white.NeonAtlasGlyphUV
  If nvcInFrame <> 0 Or nvcAtlasFaulted <> 0 : ProcedureReturn #NEON_VK_CHROME_ERR_STATE : EndIf
  rc = Neon_AtlasRasterEnsure()
  If rc <> #NEON_OK Or Neon_AtlasRasterReady() = 0 : ProcedureReturn #NEON_VK_CHROME_ERR_ATLAS : EndIf
  generation = Neon_AtlasRasterGeneration()
  If generation = nvcAtlasGeneration : ProcedureReturn #NEON_VK_CHROME_OK : EndIf
  width = Neon_AtlasRasterWidth() : height = Neon_AtlasRasterHeight()
  bytes = Neon_AtlasRasterBytes() : source = Neon_AtlasRasterBase()
  If source = 0 Or width < 1 Or width > 16 Or height < 1 Or height > nvcAtlasH Or bytes <> width * height * 4
    ProcedureReturn #NEON_VK_CHROME_ERR_ATLAS
  EndIf
  If Neon_AtlasRasterWhiteUV(@white) = 0 : ProcedureReturn #NEON_VK_CHROME_ERR_ATLAS : EndIf
  For y = 0 To nvcAtlasH - 1
    For x = 0 To 127
      target = y * nvcAtlasW * 4 + x
      PokeA(nvcAtlasUploadMapped + #NEON_VK_CHROME_ATLAS_PAD + target, 0)
    Next
  Next
  If nvcBitmapStageCopy(source, width, height) = 0 : ProcedureReturn #NEON_VK_CHROME_ERR_ATLAS : EndIf
  rc = nvcAtlasUploadWarm(0)
  If rc <> #VK_SUCCESS
    nvcAtlasFaulted = 1
    ProcedureReturn #NEON_VK_CHROME_ERR_VULKAN
  EndIf
  nvcAtlasBaseW = width : nvcAtlasBaseH = height
  nvcWhiteU0 = neon_F32Ratio(nvcF32Pixel(white\left, width), nvcAtlasW)
  nvcWhiteU1 = neon_F32Ratio(nvcF32Pixel(white\right, width), nvcAtlasW)
  nvcWhiteV0 = neon_F32Ratio(nvcF32Pixel(white\top, height), nvcAtlasH)
  nvcWhiteV1 = neon_F32Ratio(nvcF32Pixel(white\bottom, height), nvcAtlasH)
  nvcAtlasGeneration = generation
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

; The native bold bitmap ORs each row with a one-pixel right shift. Reserve
; columns 16..31 for that mask, keeping glyph cells independent at their edge.
Procedure.i nvcBitmapStageCopy(source.i, width.i, height.i)
  Define uv.NeonAtlasGlyphUV
  Define cellW.i, x.i, y.i, src.i, base.i, ink.i, boldInk.i
  If source = 0 Or width < 1 Or width > 16 Or height < 1 Or nvcAtlasUploadMapped = 0
    ProcedureReturn 0
  EndIf
  If Neon_AtlasRasterGlyphUV(Neon_AtlasRasterFirstGlyph(), @uv) = 0
    ProcedureReturn 0
  EndIf
  cellW = nvcF32Pixel(uv\right, width) - nvcF32Pixel(uv\left, width)
  If cellW < 1 Or cellW > 8 Or (width % cellW) <> 0 : ProcedureReturn 0 : EndIf
  For y = 0 To height - 1
    For x = 0 To width - 1
      src = source + ((y * width + x) * 4)
      base = nvcAtlasUploadMapped + #NEON_VK_CHROME_ATLAS_PAD + ((y * nvcAtlasW + x) * 4)
      ink = PeekL(src) : boldInk = ink
      If boldInk = 0 And (x % cellW) <> 0 : boldInk = PeekL(src - 4) : EndIf
      PokeL(base, ink)
      PokeL(base + (16 * 4), boldInk)
    Next
  Next
  ProcedureReturn 1
EndProcedure

; Fragment shader:
;   sampled atlas * per-draw RGBA push tint + a persistent zero UBO.
; The zero UBO keeps the exact proven sampled/push lowering used by the
; atlas acceptance path while leaving every visible colour draw-owned.
Procedure.i nvcBuildFragmentShader()
  vtpBuf = @nvcFs[0]
  vtpHeader(35)
  vtpIns(#VTP_OpCapability, 1) : vtpW(#VTP_CapShader)
  vtpIns(#VTP_OpMemoryModel, 2) : vtpW(#VTP_AddrLogical) : vtpW(#VTP_MemGLSL450)
  vtpIns(#VTP_OpEntryPoint, 6) : vtpW(#VTP_EmFragment) : vtpW(24) : vtpW(#VTP_NAME0) : vtpW(#VTP_NAME1) : vtpW(12) : vtpW(13)
  vtpIns(#VTP_OpExecutionMode, 2) : vtpW(24) : vtpW(#VTP_ModeOriginUpperLeft)
  vtpIns(#VTP_OpDecorate, 3) : vtpW(11) : vtpW(#VTP_DecDescriptorSet) : vtpW(0)
  vtpIns(#VTP_OpDecorate, 3) : vtpW(11) : vtpW(#VTP_DecBinding) : vtpW(1)
  vtpIns(#VTP_OpDecorate, 3) : vtpW(12) : vtpW(#VTP_DecLocation) : vtpW(0)
  vtpIns(#VTP_OpDecorate, 3) : vtpW(13) : vtpW(#VTP_DecLocation) : vtpW(0)
  vtpIns(#VTP_OpDecorate, 2) : vtpW(14) : vtpW(#VTP_DecBlock)
  vtpIns(#VTP_OpMemberDecorate, 4) : vtpW(14) : vtpW(0) : vtpW(#VTP_DecOffset) : vtpW(0)
  vtpIns(#VTP_OpDecorate, 3) : vtpW(16) : vtpW(#VTP_DecDescriptorSet) : vtpW(0)
  vtpIns(#VTP_OpDecorate, 3) : vtpW(16) : vtpW(#VTP_DecBinding) : vtpW(0)
  vtpIns(#VTP_OpDecorate, 2) : vtpW(20) : vtpW(#VTP_DecBlock)
  vtpIns(#VTP_OpMemberDecorate, 4) : vtpW(20) : vtpW(0) : vtpW(#VTP_DecOffset) : vtpW(0)
  vtpIns(#VTP_OpTypeVoid, 1) : vtpW(1)
  vtpIns(#VTP_OpTypeFunction, 2) : vtpW(2) : vtpW(1)
  vtpIns(#VTP_OpTypeFloat, 2) : vtpW(3) : vtpW(32)
  vtpIns(#VTP_OpTypeVector, 3) : vtpW(4) : vtpW(3) : vtpW(2)
  vtpIns(#VTP_OpTypeVector, 3) : vtpW(5) : vtpW(3) : vtpW(4)
  vtpIns(#VTP_OpTypeImage, 8) : vtpW(6) : vtpW(3) : vtpW(1) : vtpW(0) : vtpW(0) : vtpW(0) : vtpW(1) : vtpW(0)
  vtpIns(#VTP_OpTypeSampledImage, 2) : vtpW(7) : vtpW(6)
  vtpIns(#VTP_OpTypePointer, 3) : vtpW(8) : vtpW(#VTP_ScUniformConstant) : vtpW(7)
  vtpIns(#VTP_OpTypePointer, 3) : vtpW(9) : vtpW(#VTP_ScInput) : vtpW(4)
  vtpIns(#VTP_OpTypePointer, 3) : vtpW(10) : vtpW(#VTP_ScOutput) : vtpW(5)
  vtpIns(#VTP_OpTypeStruct, 2) : vtpW(14) : vtpW(5)
  vtpIns(#VTP_OpTypePointer, 3) : vtpW(15) : vtpW(#VTP_ScUniform) : vtpW(14)
  vtpIns(#VTP_OpTypePointer, 3) : vtpW(17) : vtpW(#VTP_ScUniform) : vtpW(5)
  vtpIns(#VTP_OpTypeInt, 3) : vtpW(18) : vtpW(32) : vtpW(1)
  vtpIns(#VTP_OpConstant, 3) : vtpW(18) : vtpW(19) : vtpW(0)
  vtpIns(#VTP_OpTypeStruct, 2) : vtpW(20) : vtpW(5)
  vtpIns(#VTP_OpTypePointer, 3) : vtpW(21) : vtpW(#VTP_ScPushConstant) : vtpW(20)
  vtpIns(#VTP_OpTypePointer, 3) : vtpW(23) : vtpW(#VTP_ScPushConstant) : vtpW(5)
  vtpIns(#VTP_OpVariable, 3) : vtpW(8) : vtpW(11) : vtpW(#VTP_ScUniformConstant)
  vtpIns(#VTP_OpVariable, 3) : vtpW(9) : vtpW(12) : vtpW(#VTP_ScInput)
  vtpIns(#VTP_OpVariable, 3) : vtpW(10) : vtpW(13) : vtpW(#VTP_ScOutput)
  vtpIns(#VTP_OpVariable, 3) : vtpW(15) : vtpW(16) : vtpW(#VTP_ScUniform)
  vtpIns(#VTP_OpVariable, 3) : vtpW(21) : vtpW(22) : vtpW(#VTP_ScPushConstant)
  vtpIns(#VTP_OpFunction, 4) : vtpW(1) : vtpW(24) : vtpW(0) : vtpW(2)
  vtpIns(#VTP_OpLabel, 1) : vtpW(25)
  vtpIns(#VTP_OpLoad, 3) : vtpW(7) : vtpW(26) : vtpW(11)
  vtpIns(#VTP_OpLoad, 3) : vtpW(4) : vtpW(27) : vtpW(12)
  vtpIns(#VTP_OpImageSampleImplicitLod, 4) : vtpW(5) : vtpW(28) : vtpW(26) : vtpW(27)
  vtpIns(#VTP_OpAccessChain, 4) : vtpW(17) : vtpW(29) : vtpW(16) : vtpW(19)
  vtpIns(#VTP_OpLoad, 3) : vtpW(5) : vtpW(30) : vtpW(29)
  vtpIns(#VTP_OpAccessChain, 4) : vtpW(23) : vtpW(31) : vtpW(22) : vtpW(19)
  vtpIns(#VTP_OpLoad, 3) : vtpW(5) : vtpW(32) : vtpW(31)
  vtpIns(133, 4) : vtpW(5) : vtpW(33) : vtpW(28) : vtpW(32)
  vtpIns(129, 4) : vtpW(5) : vtpW(34) : vtpW(33) : vtpW(30)
  vtpIns(#VTP_OpStore, 2) : vtpW(13) : vtpW(34)
  vtpIns(#VTP_OpReturn, 0)
  vtpIns(#VTP_OpFunctionEnd, 0)
  ProcedureReturn vtpN * 4
EndProcedure

Procedure.i nvcSpriteShelfPlan()
  Define slot.i, itemSource.i, itemW.i, itemH.i, itemChannels.i
  Define shelfX.i, shelfY.i, shelfRowH.i, shelfUsedH.i
  nvcTTLimitY = nvcAtlasH
  nvcLogoX = 0 : nvcLogoY = 0
  shelfX = 32 : shelfY = 0 : shelfRowH = 0 : shelfUsedH = 0
  ; Pack in ID order, leaving one texel between entries and rows. The layout
  ; is fully validated before any Vulkan image or staging allocation.
  For slot = 0 To #NVC_MULTI_SPRITE_MAX
    itemSource = 0 : itemW = 0 : itemH = 0 : itemChannels = 4
    If slot = 0
      itemSource = nvcLogoSource : itemW = nvcLogoW : itemH = nvcLogoH : itemChannels = nvcLogoChannels
    Else
      itemSource = nvcSpriteSource[slot] : itemW = nvcSpriteW[slot] : itemH = nvcSpriteH[slot]
    EndIf
    If itemSource <> 0
      If itemW < 1 Or itemW > nvcAtlasW - 32 Or itemH < 1 Or itemH > #NVC_SPRITE_SHELF_H Or (itemChannels <> 3 And itemChannels <> 4)
        ProcedureReturn #NEON_VK_CHROME_ERR_ARGS
      EndIf
      If shelfX + itemW > nvcAtlasW
        shelfX = 32 : shelfY = shelfY + shelfRowH + 1 : shelfRowH = 0
      EndIf
      If shelfY + itemH > #NVC_SPRITE_SHELF_H : ProcedureReturn #NEON_VK_CHROME_ERR_CAPACITY : EndIf
      If slot = 0
        nvcLogoX = shelfX : nvcLogoY = shelfY
      Else
        nvcSpriteX[slot] = shelfX : nvcSpriteY[slot] = shelfY
      EndIf
      If itemH > shelfRowH : shelfRowH = itemH : EndIf
      If shelfY + shelfRowH > shelfUsedH : shelfUsedH = shelfY + shelfRowH : EndIf
      shelfX = shelfX + itemW + 1
    EndIf
  Next
  If shelfUsedH > 0
    nvcTTLimitY = nvcAtlasH - shelfUsedH - 1
    If nvcTTLimitY < 2 : ProcedureReturn #NEON_VK_CHROME_ERR_CAPACITY : EndIf
    If nvcLogoSource <> 0 : nvcLogoY = nvcLogoY + nvcTTLimitY + 1 : EndIf
    For slot = 1 To #NVC_MULTI_SPRITE_MAX
      If nvcSpriteSource[slot] <> 0 : nvcSpriteY[slot] = nvcSpriteY[slot] + nvcTTLimitY + 1 : EndIf
    Next
  EndIf
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

Procedure.i nvcAtlasCreateAndUpload()
  Define ici.VkImageCreateInfo
  Define imageProps.VkImageFormatProperties
  Define req.VkMemoryRequirements
  Define mai.VkMemoryAllocateInfo
  Define ivci.VkImageViewCreateInfo
  Define sci.VkSamplerCreateInfo
  Define bci.VkBufferCreateInfo
  Define bar.VkImageMemoryBarrier
  Define copy.VkBufferImageCopy
  Define bi.VkCommandBufferBeginInfo
  Define stage.i
  Define stageMem.i
  Define mapped.i
  Define source.i
  Define sourceBytes.i
  Define bytes.i
  Define mt.i
  Define i.i
  Define x.i
  Define y.i
  Define target.i
  Define rc.i
  Define logoX.i
  Define logoR.i
  Define logoG.i
  Define logoB.i
  Define logoA.i
  Define slot.i
  Define itemSource.i
  Define itemW.i
  Define itemH.i
  Define itemChannels.i
  Define itemX.i
  Define itemY.i
  Define white.NeonAtlasGlyphUV

  rc = Neon_AtlasRasterEnsure()
  If rc <> #NEON_OK Or Neon_AtlasRasterReady() = 0
    ProcedureReturn #NEON_VK_CHROME_ERR_ATLAS
  EndIf
  source = Neon_AtlasRasterBase()
  nvcAtlasBaseW = Neon_AtlasRasterWidth()
  nvcAtlasBaseH = Neon_AtlasRasterHeight()
  sourceBytes = Neon_AtlasRasterBytes()
  If source = 0 Or nvcAtlasBaseW < 1 Or nvcAtlasBaseW > 16 Or nvcAtlasBaseH < 1 Or sourceBytes <> nvcAtlasBaseW * nvcAtlasBaseH * 4
    ProcedureReturn #NEON_VK_CHROME_ERR_ATLAS
  EndIf
  nvcAtlasW = #NEON_VK_CHROME_TT_ATLAS_W
  nvcAtlasH = #NEON_VK_CHROME_TT_ATLAS_H
  If nvcAtlasBaseH > nvcAtlasH : ProcedureReturn #NEON_VK_CHROME_ERR_CAPACITY : EndIf
  nvcAtlasBytes = nvcAtlasW * nvcAtlasH * 4
  bytes = nvcAtlasBytes
  If bytes < sourceBytes Or bytes > 8388608
    ProcedureReturn #NEON_VK_CHROME_ERR_CAPACITY
  EndIf
  nvcCreateStage = 410
  rc = vkGetPhysicalDeviceImageFormatProperties(nvcPhysical, #VK_FORMAT_B8G8R8A8_UNORM, #VK_IMAGE_TYPE_2D, #VK_IMAGE_TILING_OPTIMAL, #VK_IMAGE_USAGE_TRANSFER_DST_BIT | #VK_IMAGE_USAGE_SAMPLED_BIT, 0, @imageProps)
  If rc <> #VK_SUCCESS Or imageProps\maxExtent\width < nvcAtlasW Or imageProps\maxExtent\height < nvcAtlasH Or imageProps\maxResourceSize < bytes
    ProcedureReturn #NEON_VK_CHROME_ERR_CAPACITY
  EndIf

  ici\sType = #VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO
  ici\imageType = #VK_IMAGE_TYPE_2D
  ici\format = #VK_FORMAT_B8G8R8A8_UNORM
  ici\extent\width = nvcAtlasW : ici\extent\height = nvcAtlasH : ici\extent\depth = 1
  ici\mipLevels = 1 : ici\arrayLayers = 1 : ici\samples = #VK_SAMPLE_COUNT_1_BIT
  ici\tiling = #VK_IMAGE_TILING_OPTIMAL
  ici\usage = #VK_IMAGE_USAGE_TRANSFER_DST_BIT | #VK_IMAGE_USAGE_SAMPLED_BIT
  ici\sharingMode = #VK_SHARING_MODE_EXCLUSIVE
  ici\initialLayout = #VK_IMAGE_LAYOUT_UNDEFINED
  nvcCreateStage = 411
  rc = vkCreateImage(nvcDevice, @ici, 0, @nvcAtlasImage)
  If rc <> #VK_SUCCESS : ProcedureReturn rc : EndIf
  vkGetImageMemoryRequirements(nvcDevice, nvcAtlasImage, @req)
  mai\sType = #VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO
  mai\allocationSize = req\size
  mai\memoryTypeIndex = 0
  nvcCreateStage = 412
  rc = vkAllocateMemory(nvcDevice, @mai, 0, @nvcAtlasMemory)
  If rc = #VK_SUCCESS
    nvcCreateStage = 413
    rc = vkBindImageMemory(nvcDevice, nvcAtlasImage, nvcAtlasMemory, 0)
  EndIf
  If rc <> #VK_SUCCESS : ProcedureReturn rc : EndIf

  nvcCreateStage = 414
  rc = nvcBufferCreate(#NEON_VK_CHROME_ATLAS_PAD + bytes, #VK_BUFFER_USAGE_TRANSFER_SRC_BIT, @stage, @stageMem)
  If rc <> #VK_SUCCESS : ProcedureReturn rc : EndIf
  nvcUploadBuffer = stage : nvcUploadMemory = stageMem
  nvcCreateStage = 415
  rc = vkMapMemory(nvcDevice, stageMem, 0, #VK_WHOLE_SIZE, 0, @mapped)
  If rc <> #VK_SUCCESS : ProcedureReturn rc : EndIf
  i = 0
  While i < bytes
    PokeA(mapped + #NEON_VK_CHROME_ATLAS_PAD + i, 0)
    i + 1
  Wend
  nvcAtlasUploadMapped = mapped
  If nvcBitmapStageCopy(source, nvcAtlasBaseW, nvcAtlasBaseH) = 0 : ProcedureReturn #NEON_VK_CHROME_ERR_ATLAS : EndIf
  For slot = 0 To #NVC_MULTI_SPRITE_MAX
    itemSource = 0 : itemW = 0 : itemH = 0 : itemChannels = 4 : itemX = 0 : itemY = 0
    If slot = 0
      itemSource = nvcLogoSource : itemW = nvcLogoW : itemH = nvcLogoH
      itemChannels = nvcLogoChannels : itemX = nvcLogoX : itemY = nvcLogoY
    Else
      itemSource = nvcSpriteSource[slot] : itemW = nvcSpriteW[slot] : itemH = nvcSpriteH[slot]
      itemX = nvcSpriteX[slot] : itemY = nvcSpriteY[slot]
    EndIf
    If itemSource <> 0
      For y = 0 To itemH - 1
        For x = 0 To itemW - 1
          i = itemSource + (y * itemW + x) * itemChannels
          logoR = PeekA(i) : logoG = PeekA(i + 1) : logoB = PeekA(i + 2)
          logoA = 255
          If itemChannels = 4 : logoA = PeekA(i + 3) : EndIf
          logoX = nvcAtlasUploadMapped + #NEON_VK_CHROME_ATLAS_PAD + (((itemY + y) * nvcAtlasW + itemX + x) * 4)
          PokeL(logoX, (logoA << 24) | (logoR << 16) | (logoG << 8) | logoB)
        Next
      Next
    EndIf
  Next
  nvcTTNextX = 32 : nvcTTNextY = 1 : nvcTTRowH = 0 : nvcTTCount = 0 : nvcTTDirty = 0
  nvcTTForceFull = 0 : nvcTTDirtyRectValid = 0
  For i = 0 To #NVC_TT_INDEX_SIZE - 1 : nvcTTIndex[i] = 0 : Next
  If Neon_AtlasRasterWhiteUV(@white) = 0 : ProcedureReturn #NEON_VK_CHROME_ERR_ATLAS : EndIf
  nvcWhiteU0 = neon_F32Ratio(nvcF32Pixel(white\left, nvcAtlasBaseW), nvcAtlasW)
  nvcWhiteU1 = neon_F32Ratio(nvcF32Pixel(white\right, nvcAtlasBaseW), nvcAtlasW)
  nvcWhiteV0 = neon_F32Ratio(nvcF32Pixel(white\top, nvcAtlasBaseH), nvcAtlasH)
  nvcWhiteV1 = neon_F32Ratio(nvcF32Pixel(white\bottom, nvcAtlasBaseH), nvcAtlasH)

  ivci\sType = #VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO
  ivci\image = nvcAtlasImage : ivci\viewType = #VK_IMAGE_VIEW_TYPE_2D
  ivci\format = #VK_FORMAT_B8G8R8A8_UNORM
  ivci\subresourceRange\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT
  ivci\subresourceRange\levelCount = 1 : ivci\subresourceRange\layerCount = 1
  nvcCreateStage = 416
  rc = vkCreateImageView(nvcDevice, @ivci, 0, @nvcAtlasView)
  If rc <> #VK_SUCCESS : ProcedureReturn rc : EndIf
  sci\sType = #VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO
  sci\magFilter = #VK_FILTER_NEAREST : sci\minFilter = #VK_FILTER_NEAREST
  sci\mipmapMode = #VK_SAMPLER_MIPMAP_MODE_NEAREST
  sci\addressModeU = #VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE
  sci\addressModeV = #VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE
  sci\addressModeW = #VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE
  nvcCreateStage = 417
  rc = vkCreateSampler(nvcDevice, @sci, 0, @nvcSampler)
  If rc <> #VK_SUCCESS : ProcedureReturn rc : EndIf

  bar\sType = #VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER
  bar\dstAccessMask = #VK_ACCESS_TRANSFER_WRITE_BIT
  bar\oldLayout = #VK_IMAGE_LAYOUT_UNDEFINED
  bar\newLayout = #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL
  bar\srcQueueFamilyIndex = #VK_QUEUE_FAMILY_IGNORED
  bar\dstQueueFamilyIndex = #VK_QUEUE_FAMILY_IGNORED
  bar\image = nvcAtlasImage
  bar\subresourceRange\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT
  bar\subresourceRange\levelCount = 1 : bar\subresourceRange\layerCount = 1
  copy\bufferOffset = #NEON_VK_CHROME_ATLAS_PAD
  copy\imageSubresource\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT
  copy\imageSubresource\layerCount = 1
  copy\imageExtent\width = nvcAtlasW : copy\imageExtent\height = nvcAtlasH : copy\imageExtent\depth = 1
  bi\sType = #VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO
  bi\flags = #VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT
  nvcCreateStage = 418
  rc = vkResetCommandBuffer(nvcCommand, 0)
  If rc = #VK_SUCCESS : rc = vkBeginCommandBuffer(nvcCommand, @bi) : EndIf
  If rc = #VK_SUCCESS
    vkCmdPipelineBarrier(nvcCommand, #VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, #VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, 0, 0, 0, 1, @bar)
    vkCmdCopyBufferToImage(nvcCommand, stage, nvcAtlasImage, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @copy)
    bar\srcAccessMask = #VK_ACCESS_TRANSFER_WRITE_BIT
    bar\dstAccessMask = #VK_ACCESS_SHADER_READ_BIT
    bar\oldLayout = #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL
    bar\newLayout = #VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL
    vkCmdPipelineBarrier(nvcCommand, #VK_PIPELINE_STAGE_TRANSFER_BIT, #VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, 0, 0, 0, 0, 0, 1, @bar)
    rc = vkEndCommandBuffer(nvcCommand)
  EndIf
  If rc = #VK_SUCCESS
    nvcCreateStage = 419
    rc = nvcSubmitAndWait()
  EndIf
  If rc = #VK_SUCCESS
    nvcAtlasUploadCount = 1
    nvcAtlasFullUploadCount = 1 : nvcAtlasPartialUploadCount = 0
    nvcAtlasLastUploadBytes = nvcAtlasBytes
    nvcAtlasGeneration = Neon_AtlasRasterGeneration()
    nvcAtlasFaulted = 0
  EndIf
  ProcedureReturn rc
EndProcedure

Procedure.i nvcDescriptorsAndPipeline()
  Define Dim bindings.VkDescriptorSetLayoutBinding[2]
  Define dslci.VkDescriptorSetLayoutCreateInfo
  Define Dim sizes.VkDescriptorPoolSize[2]
  Define dpci.VkDescriptorPoolCreateInfo
  Define dsai.VkDescriptorSetAllocateInfo
  Define dbi.VkDescriptorBufferInfo
  Define dii.VkDescriptorImageInfo
  Define Dim writes.VkWriteDescriptorSet[2]
  Define plci.VkPipelineLayoutCreateInfo
  Define pcr.VkPushConstantRange
  Define smci.VkShaderModuleCreateInfo
  Define Dim stages.VkPipelineShaderStageCreateInfo[2]
  Define bind.VkVertexInputBindingDescription
  Define Dim attrs.VkVertexInputAttributeDescription[2]
  Define vi.VkPipelineVertexInputStateCreateInfo
  Define ia.VkPipelineInputAssemblyStateCreateInfo
  Define vp.VkViewport
  Define vpstate.VkPipelineViewportStateCreateInfo
  Define rs.VkPipelineRasterizationStateCreateInfo
  Define ms.VkPipelineMultisampleStateCreateInfo
  Define cba.VkPipelineColorBlendAttachmentState
  Define cb.VkPipelineColorBlendStateCreateInfo
  Define dyn.VkPipelineDynamicStateCreateInfo
  ; VkDynamicState is a Vulkan enum (32 bits); native-width .i entries make
  ; the API's 4-byte walk read the high half of VIEWPORT twice.
  Dim dynStates.l[2]
  Define gp.VkGraphicsPipelineCreateInfo
  Define vs.i
  Define fs.i
  Define layoutArray.i
  Define mapped.i
  Define rc.i
  Define vsBytes.i
  Define fsBytes.i

  rc = nvcBufferCreate(16, #VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT, @nvcUniformBuffer, @nvcUniformMemory)
  If rc <> #VK_SUCCESS : ProcedureReturn rc : EndIf
  rc = vkMapMemory(nvcDevice, nvcUniformMemory, 0, 16, 0, @mapped)
  If rc <> #VK_SUCCESS : ProcedureReturn rc : EndIf
  PokeL(mapped + 0, 0) : PokeL(mapped + 4, 0) : PokeL(mapped + 8, 0) : PokeL(mapped + 12, 0)
  vkUnmapMemory(nvcDevice, nvcUniformMemory)

  bindings[0]\binding = 0 : bindings[0]\descriptorType = #VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER
  bindings[0]\descriptorCount = 1 : bindings[0]\stageFlags = #VK_SHADER_STAGE_FRAGMENT_BIT
  bindings[1]\binding = 1 : bindings[1]\descriptorType = #VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER
  bindings[1]\descriptorCount = 1 : bindings[1]\stageFlags = #VK_SHADER_STAGE_FRAGMENT_BIT
  dslci\sType = #VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO
  dslci\bindingCount = 2 : dslci\pBindings = @bindings[0]
  rc = vkCreateDescriptorSetLayout(nvcDevice, @dslci, 0, @nvcSetLayout)
  If rc <> #VK_SUCCESS : ProcedureReturn rc : EndIf
  ; Atlas, sixteen resident images and one unpublished replacement may
  ; coexist. Individual sets retire after the bounded wait.
  sizes[0]\type = #VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER : sizes[0]\descriptorCount = #NVC_MULTI_SPRITE_MAX + 3
  sizes[1]\type = #VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER : sizes[1]\descriptorCount = #NVC_MULTI_SPRITE_MAX + 3
  dpci\sType = #VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO
  dpci\flags = #VK_DESCRIPTOR_POOL_CREATE_FREE_DESCRIPTOR_SET_BIT
  dpci\maxSets = #NVC_MULTI_SPRITE_MAX + 3 : dpci\poolSizeCount = 2 : dpci\pPoolSizes = @sizes[0]
  rc = vkCreateDescriptorPool(nvcDevice, @dpci, 0, @nvcDescriptorPool)
  If rc <> #VK_SUCCESS : ProcedureReturn rc : EndIf
  layoutArray = nvcSetLayout
  dsai\sType = #VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO
  dsai\descriptorPool = nvcDescriptorPool : dsai\descriptorSetCount = 1 : dsai\pSetLayouts = @layoutArray
  rc = vkAllocateDescriptorSets(nvcDevice, @dsai, @nvcDescriptorSet)
  If rc <> #VK_SUCCESS : ProcedureReturn rc : EndIf
  dbi\buffer = nvcUniformBuffer : dbi\range = 16
  dii\sampler = nvcSampler : dii\imageView = nvcAtlasView : dii\imageLayout = #VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL
  writes[0]\sType = #VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET
  writes[0]\dstSet = nvcDescriptorSet : writes[0]\dstBinding = 0
  writes[0]\descriptorCount = 1 : writes[0]\descriptorType = #VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER
  writes[0]\pBufferInfo = @dbi
  writes[1]\sType = #VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET
  writes[1]\dstSet = nvcDescriptorSet : writes[1]\dstBinding = 1
  writes[1]\descriptorCount = 1 : writes[1]\descriptorType = #VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER
  writes[1]\pImageInfo = @dii
  AnvilVkFaultClear() : vkUpdateDescriptorSets(nvcDevice, 1, @writes[0], 0, 0)
  If AnvilVkFaultCode() <> #ANVIL_VK_OK : ProcedureReturn #NEON_VK_CHROME_ERR_VULKAN : EndIf
  AnvilVkFaultClear() : vkUpdateDescriptorSets(nvcDevice, 1, @writes[1], 0, 0)
  If AnvilVkFaultCode() <> #ANVIL_VK_OK : ProcedureReturn #NEON_VK_CHROME_ERR_VULKAN : EndIf

  pcr\stageFlags = #VK_SHADER_STAGE_FRAGMENT_BIT : pcr\size = 16
  plci\sType = #VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO
  plci\setLayoutCount = 1 : plci\pSetLayouts = @layoutArray
  plci\pushConstantRangeCount = 1 : plci\pPushConstantRanges = @pcr
  rc = vkCreatePipelineLayout(nvcDevice, @plci, 0, @nvcPipelineLayout)
  If rc <> #VK_SUCCESS : ProcedureReturn rc : EndIf

  vsBytes = vtpBuildVsD()
  fsBytes = nvcBuildFragmentShader()
  smci\sType = #VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO
  smci\pCode = @vtpVsD[0] : smci\codeSize = vsBytes
  rc = vkCreateShaderModule(nvcDevice, @smci, 0, @vs)
  If rc = #VK_SUCCESS
    smci\pCode = @nvcFs[0] : smci\codeSize = fsBytes
    rc = vkCreateShaderModule(nvcDevice, @smci, 0, @fs)
  EndIf
  If rc <> #VK_SUCCESS
    If vs <> 0 : vkDestroyShaderModule(nvcDevice, vs, 0) : EndIf
    If fs <> 0 : vkDestroyShaderModule(nvcDevice, fs, 0) : EndIf
    ProcedureReturn rc
  EndIf

  stages[0]\sType = #VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO
  stages[0]\stage = #VK_SHADER_STAGE_VERTEX_BIT : stages[0]\module = vs
  stages[1]\sType = #VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO
  stages[1]\stage = #VK_SHADER_STAGE_FRAGMENT_BIT : stages[1]\module = fs
  bind\binding = 0 : bind\stride = #NEON_VK_CHROME_VERTEX_BYTES : bind\inputRate = #VK_VERTEX_INPUT_RATE_VERTEX
  attrs[0]\location = 0 : attrs[0]\binding = 0 : attrs[0]\format = #VK_FORMAT_R32G32_SFLOAT
  attrs[1]\location = 1 : attrs[1]\binding = 0 : attrs[1]\format = #VK_FORMAT_R32G32_SFLOAT : attrs[1]\offset = 8
  vi\sType = #VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO
  vi\vertexBindingDescriptionCount = 1 : vi\pVertexBindingDescriptions = @bind
  vi\vertexAttributeDescriptionCount = 2 : vi\pVertexAttributeDescriptions = @attrs[0]
  ia\sType = #VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO
  ia\topology = #VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST
  PokeL(@vp\width, neon_F32Int(nvcWidth))
  PokeL(@vp\height, neon_F32Int(nvcHeight))
  PokeL(@vp\maxDepth, #NEON_VK_CHROME_F_ONE)
  vpstate\sType = #VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO
  vpstate\viewportCount = 1 : vpstate\pViewports = @vp
  vpstate\scissorCount = 1 : vpstate\pScissors = 0
  dynStates[0] = #VK_DYNAMIC_STATE_VIEWPORT
  dynStates[1] = #VK_DYNAMIC_STATE_SCISSOR
  dyn\sType = #VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO
  dyn\dynamicStateCount = 2 : dyn\pDynamicStates = @dynStates[0]
  rs\sType = #VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO
  rs\polygonMode = #VK_POLYGON_MODE_FILL : rs\cullMode = #VK_CULL_MODE_NONE
  rs\frontFace = #VK_FRONT_FACE_COUNTER_CLOCKWISE
  PokeL(@rs\lineWidth, #NEON_VK_CHROME_F_ONE)
  ms\sType = #VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO
  ms\rasterizationSamples = #VK_SAMPLE_COUNT_1_BIT
  cba\blendEnable = #VK_TRUE
  cba\srcColorBlendFactor = #VK_BLEND_FACTOR_SRC_ALPHA
  cba\dstColorBlendFactor = #VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA
  cba\colorBlendOp = #VK_BLEND_OP_ADD
  cba\srcAlphaBlendFactor = #VK_BLEND_FACTOR_SRC_ALPHA
  cba\dstAlphaBlendFactor = #VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA
  cba\alphaBlendOp = #VK_BLEND_OP_ADD
  cba\colorWriteMask = #VK_COLOR_COMPONENT_R_BIT | #VK_COLOR_COMPONENT_G_BIT | #VK_COLOR_COMPONENT_B_BIT | #VK_COLOR_COMPONENT_A_BIT
  cb\sType = #VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO
  cb\attachmentCount = 1 : cb\pAttachments = @cba
  gp\sType = #VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO
  gp\stageCount = 2 : gp\pStages = @stages[0]
  gp\pVertexInputState = @vi : gp\pInputAssemblyState = @ia
  gp\pViewportState = @vpstate : gp\pRasterizationState = @rs
  gp\pMultisampleState = @ms : gp\pColorBlendState = @cb : gp\pDynamicState = @dyn
  gp\layout = nvcPipelineLayout : gp\renderPass = nvcRenderPass : gp\subpass = 0 : gp\basePipelineIndex = -1
  rc = vkCreateGraphicsPipelines(nvcDevice, 0, 1, @gp, 0, @nvcPipeline)
  vkDestroyShaderModule(nvcDevice, vs, 0)
  vkDestroyShaderModule(nvcDevice, fs, 0)
  ProcedureReturn rc
EndProcedure

Procedure nvcImageSpriteRelease(setHandle.i, view.i, image.i, memory.i)
  Define handle.i
  If nvcDevice = 0
    ProcedureReturn
  EndIf
  If setHandle <> 0 And nvcDescriptorPool <> 0
    handle = setHandle
    vkFreeDescriptorSets(nvcDevice, nvcDescriptorPool, 1, @handle)
  EndIf
  If view <> 0 : vkDestroyImageView(nvcDevice, view, 0) : EndIf
  If image <> 0 : vkDestroyImage(nvcDevice, image, 0) : EndIf
  If memory <> 0 : vkFreeMemory(nvcDevice, memory, 0) : EndIf
EndProcedure

; A necessary byte and table preflight over the caller's actual heap window.
; Individual Vulkan allocations remain authoritative if fragmentation keeps
; two aligned runs from fitting even though their aggregate bytes fit.
Procedure.i nvcImageSpritePreflight(imageBytes.i, stagingBytes.i)
  Define props.VkPhysicalDeviceMemoryProperties
  Define used.i, freeRows.i, i.i, alignment.i
  If imageBytes < 1 Or stagingBytes < 1 Or avkHeapBind() <> #VK_SUCCESS
    ProcedureReturn #NEON_VK_CHROME_ERR_CAPACITY
  EndIf
  vkGetPhysicalDeviceMemoryProperties(nvcPhysical, @props)
  If props\memoryHeapCount < 1 Or props\memoryHeaps[0]\size <> avkHeapBytes
    ProcedureReturn #NEON_VK_CHROME_ERR_CAPACITY
  EndIf
  For i = 1 To #ANVIL_VK_MAX_MEMORY
    If avkMemLive[i] <> 0
      used = used + avkMemSize[i]
    Else
      freeRows = freeRows + 1
    EndIf
  Next
  alignment = avkBackendImageAlignment()
  If freeRows < 2 Or alignment < 1 Or used < 0 Or used > avkHeapBytes
    ProcedureReturn #NEON_VK_CHROME_ERR_CAPACITY
  EndIf
  If imageBytes > avkHeapBytes - used Or stagingBytes > avkHeapBytes - used - imageBytes
    ProcedureReturn #NEON_VK_CHROME_ERR_CAPACITY
  EndIf
  ; Leave one alignment gap for each new allocation. This may refuse a
  ; borderline fit but never approves a request larger than free bytes.
  If avkHeapBytes - used - imageBytes - stagingBytes < alignment * 2
    ProcedureReturn #NEON_VK_CHROME_ERR_CAPACITY
  EndIf
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

; The target has no CopyMemory or 64-bit Poke intrinsic. Copy aligned BGRA
; words without channel conversion, or bytes for unaligned source buffers.
Procedure.i nvcCopyBgraStaging(*source, *target, byteCount.i)
  Define offset.i
  If *source = 0 Or *target = 0 Or byteCount < 4 Or byteCount > 2048 * 2048 * 4 Or (byteCount & 3) <> 0
    ProcedureReturn #NEON_VK_CHROME_ERR_ARGS
  EndIf
  If ((*source | *target) & 3) = 0
    While offset < byteCount
      PokeL(*target + offset, PeekL(*source + offset))
      offset = offset + 4
    Wend
  Else
    While offset < byteCount
      PokeA(*target + offset, PeekA(*source + offset))
      offset = offset + 1
    Wend
  EndIf
  ProcedureReturn #VK_SUCCESS
EndProcedure

; Replace the one independently owned sprite while no frame or present
; transaction is active. Old handles remain published until image upload,
; view creation and descriptor writes all succeed. Source bytes are copied
; during this call and need not remain live afterwards.
Procedure.i nvcImageSpriteReplace(id.i, *pixels, width.i, height.i, sourceBgra.i)
  Define ici.VkImageCreateInfo
  Define imageProps.VkImageFormatProperties
  Define imageReq.VkMemoryRequirements
  Define bufferReq.VkMemoryRequirements
  Define mai.VkMemoryAllocateInfo
  Define bci.VkBufferCreateInfo
  Define ivci.VkImageViewCreateInfo
  Define dsai.VkDescriptorSetAllocateInfo
  Define dbi.VkDescriptorBufferInfo
  Define dii.VkDescriptorImageInfo
  Define write.VkWriteDescriptorSet
  Define bar.VkImageMemoryBarrier
  Define copy.VkBufferImageCopy
  Define bi.VkCommandBufferBeginInfo
  Define image.i, imageMemory.i, view.i, setHandle.i
  Define stage.i, stageMemory.i, mapped.i, layoutHandle.i
  Define oldImage.i, oldMemory.i, oldView.i, oldSet.i
  Define pixelBytes.i, x.i, y.i, src.i, dst.i, rc.i, generation.i

  If id < 1 Or id > #NVC_MULTI_SPRITE_MAX : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS) : EndIf
  If nvcReady = 0 Or nvcInFrame <> 0 Or nvdPresentPending() <> 0 Or nvcImageSpritePendingImage <> 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  If *pixels = 0 Or width < 1 Or height < 1 Or width > 2048 Or height > 2048 Or (sourceBgra <> 0 And sourceBgra <> 1)
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If id = 1 : generation = nvcImageSpriteGeneration : Else : generation = nvcImageSpriteGenerations[id] : EndIf
  If generation = #NVC_MAX_GENERATION
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  pixelBytes = width * height * 4
  rc = vkGetPhysicalDeviceImageFormatProperties(nvcPhysical, #VK_FORMAT_B8G8R8A8_UNORM, #VK_IMAGE_TYPE_2D, #VK_IMAGE_TILING_OPTIMAL, #VK_IMAGE_USAGE_TRANSFER_DST_BIT | #VK_IMAGE_USAGE_SAMPLED_BIT, 0, @imageProps)
  If rc <> #VK_SUCCESS Or imageProps\maxExtent\width < width Or imageProps\maxExtent\height < height Or imageProps\maxResourceSize < pixelBytes
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY)
  EndIf
  ; The shared command buffer is reusable only after the preceding submit.
  rc = vkDeviceWaitIdle(nvcDevice)
  If rc <> #VK_SUCCESS : ProcedureReturn nvcFail(rc) : EndIf
  ici\sType = #VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO
  ici\imageType = #VK_IMAGE_TYPE_2D : ici\format = #VK_FORMAT_B8G8R8A8_UNORM
  ici\extent\width = width : ici\extent\height = height : ici\extent\depth = 1
  ici\mipLevels = 1 : ici\arrayLayers = 1 : ici\samples = #VK_SAMPLE_COUNT_1_BIT
  ici\tiling = #VK_IMAGE_TILING_OPTIMAL
  ici\usage = #VK_IMAGE_USAGE_TRANSFER_DST_BIT | #VK_IMAGE_USAGE_SAMPLED_BIT
  ici\sharingMode = #VK_SHARING_MODE_EXCLUSIVE
  ici\initialLayout = #VK_IMAGE_LAYOUT_UNDEFINED
  rc = vkCreateImage(nvcDevice, @ici, 0, @image)
  If rc <> #VK_SUCCESS : ProcedureReturn nvcFail(rc) : EndIf
  vkGetImageMemoryRequirements(nvcDevice, image, @imageReq)
  bci\sType = #VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO
  bci\size = #NEON_VK_CHROME_ATLAS_PAD + pixelBytes
  bci\usage = #VK_BUFFER_USAGE_TRANSFER_SRC_BIT
  bci\sharingMode = #VK_SHARING_MODE_EXCLUSIVE
  rc = vkCreateBuffer(nvcDevice, @bci, 0, @stage)
  If rc = #VK_SUCCESS : vkGetBufferMemoryRequirements(nvcDevice, stage, @bufferReq) : EndIf
  If rc = #VK_SUCCESS : rc = nvcImageSpritePreflight(imageReq\size, bufferReq\size) : EndIf
  If rc <> #VK_SUCCESS
    If stage <> 0 : vkDestroyBuffer(nvcDevice, stage, 0) : EndIf
    vkDestroyImage(nvcDevice, image, 0)
    ProcedureReturn nvcFail(rc)
  EndIf
  mai\sType = #VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO
  mai\allocationSize = imageReq\size : mai\memoryTypeIndex = nvcHostMemoryType(imageReq\memoryTypeBits)
  If mai\memoryTypeIndex < 0 : rc = #NEON_VK_CHROME_ERR_VULKAN : Else : rc = vkAllocateMemory(nvcDevice, @mai, 0, @imageMemory) : EndIf
  If rc = #VK_SUCCESS : rc = vkBindImageMemory(nvcDevice, image, imageMemory, 0) : EndIf
  If rc = #VK_SUCCESS
    mai\allocationSize = bufferReq\size : mai\memoryTypeIndex = nvcHostMemoryType(bufferReq\memoryTypeBits)
    If mai\memoryTypeIndex < 0 : rc = #NEON_VK_CHROME_ERR_VULKAN : Else : rc = vkAllocateMemory(nvcDevice, @mai, 0, @stageMemory) : EndIf
  EndIf
  If rc = #VK_SUCCESS : rc = vkBindBufferMemory(nvcDevice, stage, stageMemory, 0) : EndIf
  If rc = #VK_SUCCESS : rc = vkMapMemory(nvcDevice, stageMemory, 0, #VK_WHOLE_SIZE, 0, @mapped) : EndIf
  If rc = #VK_SUCCESS
    If sourceBgra <> 0
      rc = nvcCopyBgraStaging(*pixels, mapped + #NEON_VK_CHROME_ATLAS_PAD, pixelBytes)
    Else
      For y = 0 To height - 1
        For x = 0 To width - 1
          src = *pixels + (y * width + x) * 4
          dst = mapped + #NEON_VK_CHROME_ATLAS_PAD + (y * width + x) * 4
          PokeL(dst, (PeekA(src + 3) << 24) | (PeekA(src) << 16) | (PeekA(src + 1) << 8) | PeekA(src + 2))
        Next
      Next
    EndIf
  EndIf
  If rc = #VK_SUCCESS
    bar\sType = #VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER
    bar\dstAccessMask = #VK_ACCESS_TRANSFER_WRITE_BIT
    bar\oldLayout = #VK_IMAGE_LAYOUT_UNDEFINED
    bar\newLayout = #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL
    bar\srcQueueFamilyIndex = #VK_QUEUE_FAMILY_IGNORED
    bar\dstQueueFamilyIndex = #VK_QUEUE_FAMILY_IGNORED
    bar\image = image
    bar\subresourceRange\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT
    bar\subresourceRange\levelCount = 1 : bar\subresourceRange\layerCount = 1
    copy\bufferOffset = #NEON_VK_CHROME_ATLAS_PAD
    copy\imageSubresource\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT
    copy\imageSubresource\layerCount = 1
    copy\imageExtent\width = width : copy\imageExtent\height = height : copy\imageExtent\depth = 1
    bi\sType = #VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO
    bi\flags = #VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT
    rc = vkResetCommandBuffer(nvcCommand, 0)
    If rc = #VK_SUCCESS : rc = vkBeginCommandBuffer(nvcCommand, @bi) : EndIf
    If rc = #VK_SUCCESS
      vkCmdPipelineBarrier(nvcCommand, #VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, #VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, 0, 0, 0, 1, @bar)
      vkCmdCopyBufferToImage(nvcCommand, stage, image, #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, @copy)
      bar\srcAccessMask = #VK_ACCESS_TRANSFER_WRITE_BIT
      bar\dstAccessMask = #VK_ACCESS_SHADER_READ_BIT
      bar\oldLayout = #VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL
      bar\newLayout = #VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL
      vkCmdPipelineBarrier(nvcCommand, #VK_PIPELINE_STAGE_TRANSFER_BIT, #VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, 0, 0, 0, 0, 0, 1, @bar)
      rc = vkEndCommandBuffer(nvcCommand)
    EndIf
    If rc = #VK_SUCCESS : rc = nvcSubmitAndWait() : EndIf
  EndIf
  If mapped <> 0 : vkUnmapMemory(nvcDevice, stageMemory) : mapped = 0 : EndIf
  If rc = #VK_SUCCESS
    ivci\sType = #VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO
    ivci\image = image : ivci\viewType = #VK_IMAGE_VIEW_TYPE_2D
    ivci\format = #VK_FORMAT_B8G8R8A8_UNORM
    ivci\subresourceRange\aspectMask = #VK_IMAGE_ASPECT_COLOR_BIT
    ivci\subresourceRange\levelCount = 1 : ivci\subresourceRange\layerCount = 1
    rc = vkCreateImageView(nvcDevice, @ivci, 0, @view)
  EndIf
  If rc = #VK_SUCCESS
    layoutHandle = nvcSetLayout
    dsai\sType = #VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO
    dsai\descriptorPool = nvcDescriptorPool
    dsai\descriptorSetCount = 1 : dsai\pSetLayouts = @layoutHandle
    rc = vkAllocateDescriptorSets(nvcDevice, @dsai, @setHandle)
  EndIf
  If rc = #VK_SUCCESS
    dbi\buffer = nvcUniformBuffer : dbi\range = 16
    write\sType = #VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET
    write\dstSet = setHandle : write\dstBinding = 0
    write\descriptorCount = 1 : write\descriptorType = #VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER
    write\pBufferInfo = @dbi
    AnvilVkFaultClear() : vkUpdateDescriptorSets(nvcDevice, 1, @write, 0, 0)
    If AnvilVkFaultCode() <> #ANVIL_VK_OK : rc = #NEON_VK_CHROME_ERR_VULKAN : EndIf
  EndIf
  If rc = #VK_SUCCESS
    dii\sampler = nvcSampler : dii\imageView = view
    dii\imageLayout = #VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL
    write\dstBinding = 1 : write\descriptorType = #VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER
    write\pBufferInfo = 0 : write\pImageInfo = @dii
    AnvilVkFaultClear() : vkUpdateDescriptorSets(nvcDevice, 1, @write, 0, 0)
    If AnvilVkFaultCode() <> #ANVIL_VK_OK : rc = #NEON_VK_CHROME_ERR_VULKAN : EndIf
  EndIf
  ; The transfer has completed before staging is retired. A failed transfer
  ; must reach idle before candidate handles are released.
  If rc <> #VK_SUCCESS
    If vkDeviceWaitIdle(nvcDevice) <> #VK_SUCCESS
      ; The transfer may still reference staging and image memory. Keep all
      ; candidate handles until a later successful device-idle retirement.
      nvcImageSpritePendingImage = image : nvcImageSpritePendingMemory = imageMemory
      nvcImageSpritePendingView = view : nvcImageSpritePendingSet = setHandle
      nvcImageSpritePendingStage = stage : nvcImageSpritePendingStageMemory = stageMemory
      ProcedureReturn nvcFail(rc)
    EndIf
  EndIf
  If stage <> 0 : vkDestroyBuffer(nvcDevice, stage, 0) : EndIf
  If stageMemory <> 0 : vkFreeMemory(nvcDevice, stageMemory, 0) : EndIf
  If rc <> #VK_SUCCESS
    nvcImageSpriteRelease(setHandle, view, image, imageMemory)
    ProcedureReturn nvcFail(rc)
  EndIf
  If id = 1
    oldImage = nvcImageSpriteImage : oldMemory = nvcImageSpriteMemory
    oldView = nvcImageSpriteView : oldSet = nvcImageSpriteSet
    nvcImageSpriteImage = image : nvcImageSpriteMemory = imageMemory
    nvcImageSpriteView = view : nvcImageSpriteSet = setHandle
    nvcImageSpriteW = width : nvcImageSpriteH = height
    nvcImageSpriteGeneration = generation + 1
  Else
    oldImage = nvcImageSpriteImages[id] : oldMemory = nvcImageSpriteMemories[id]
    oldView = nvcImageSpriteViews[id] : oldSet = nvcImageSpriteSets[id]
    nvcImageSpriteImages[id] = image : nvcImageSpriteMemories[id] = imageMemory
    nvcImageSpriteViews[id] = view : nvcImageSpriteSets[id] = setHandle
    nvcImageSpriteWidths[id] = width : nvcImageSpriteHeights[id] = height
    nvcImageSpriteGenerations[id] = generation + 1
  EndIf
  nvcImageSpriteRelease(oldSet, oldView, oldImage, oldMemory)
  nvcError = 0
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

Procedure.i NeonVkChromeImageSpriteReplace(*rgba, width.i, height.i)
  ProcedureReturn nvcImageSpriteReplace(1, *rgba, width, height, 0)
EndProcedure

Procedure.i NeonVkChromeImageSpriteReplaceBGRA(*bgra, width.i, height.i)
  ProcedureReturn nvcImageSpriteReplace(1, *bgra, width, height, 1)
EndProcedure

Procedure.i NeonVkChromeImageSpriteReplaceId(id.i, *rgba, width.i, height.i)
  ProcedureReturn nvcImageSpriteReplace(id, *rgba, width, height, 0)
EndProcedure

Procedure.i NeonVkChromeImageSpriteReplaceBGRAId(id.i, *bgra, width.i, height.i)
  ProcedureReturn nvcImageSpriteReplace(id, *bgra, width, height, 1)
EndProcedure

Procedure.i NeonVkChromeImageSpriteGeneration()
  ProcedureReturn nvcImageSpriteGeneration
EndProcedure

Procedure.i NeonVkChromeImageSpriteGenerationId(id.i)
  If id < 1 Or id > #NVC_MULTI_SPRITE_MAX : ProcedureReturn -1 : EndIf
  If id = 1 : ProcedureReturn nvcImageSpriteGeneration : EndIf
  ProcedureReturn nvcImageSpriteGenerations[id]
EndProcedure

Procedure.i nvcImageSpriteClear(id.i)
  Define rc.i, generation.i, setHandle.i
  If id < 1 Or id > #NVC_MULTI_SPRITE_MAX : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS) : EndIf
  If id = 1
    generation = nvcImageSpriteGeneration : setHandle = nvcImageSpriteSet
  Else
    generation = nvcImageSpriteGenerations[id] : setHandle = nvcImageSpriteSets[id]
  EndIf
  If nvcReady = 0 Or nvcInFrame <> 0 Or nvdPresentPending() <> 0 Or nvcImageSpritePendingImage <> 0 Or generation = #NVC_MAX_GENERATION
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  If setHandle = 0 : ProcedureReturn #NEON_VK_CHROME_OK : EndIf
  rc = vkDeviceWaitIdle(nvcDevice)
  If rc <> #VK_SUCCESS : ProcedureReturn nvcFail(rc) : EndIf
  If id = 1
    nvcImageSpriteRelease(nvcImageSpriteSet, nvcImageSpriteView, nvcImageSpriteImage, nvcImageSpriteMemory)
    nvcImageSpriteSet = 0 : nvcImageSpriteView = 0
    nvcImageSpriteImage = 0 : nvcImageSpriteMemory = 0
    nvcImageSpriteW = 0 : nvcImageSpriteH = 0
    nvcImageSpriteGeneration = generation + 1
  Else
    nvcImageSpriteRelease(nvcImageSpriteSets[id], nvcImageSpriteViews[id], nvcImageSpriteImages[id], nvcImageSpriteMemories[id])
    nvcImageSpriteSets[id] = 0 : nvcImageSpriteViews[id] = 0
    nvcImageSpriteImages[id] = 0 : nvcImageSpriteMemories[id] = 0
    nvcImageSpriteWidths[id] = 0 : nvcImageSpriteHeights[id] = 0
    nvcImageSpriteGenerations[id] = generation + 1
  EndIf
  nvcError = 0
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

Procedure.i NeonVkChromeImageSpriteClear()
  ProcedureReturn nvcImageSpriteClear(1)
EndProcedure

Procedure.i NeonVkChromeImageSpriteClearId(id.i)
  ProcedureReturn nvcImageSpriteClear(id)
EndProcedure

Procedure.i NeonVkChromeCreateWithCapacities(physicalDevice.i, device.i, queue.i, commandPool.i, renderPass.i, framebuffer.i, width.i, height.i, maxDraws.i, maxVertexQuads.i)
  Define cbai.VkCommandBufferAllocateInfo
  Define fci.VkFenceCreateInfo
  Define rc.i

  If nvcReady <> 0 Or nvcInFrame <> 0 Or nvcDevice <> 0 Or nvcCommand <> 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  If NeonDrawBackendActive() <> 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  If physicalDevice = 0 Or device = 0 Or queue = 0 Or commandPool = 0 Or renderPass = 0 Or framebuffer = 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If width < 1 Or height < 1 Or maxDraws < 1 Or maxDraws > #NEON_VK_CHROME_MAX_QUADS
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If maxVertexQuads < 1 Or maxVertexQuads > #NEON_VK_CHROME_MAX_VERTEX_QUADS
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If nvcNextTargetGeneration = #NVC_MAX_GENERATION
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  nvcLogicalW = width : nvcLogicalH = height
  nvcPhysicalW = width : nvcPhysicalH = height : nvcPitch = width * 4 : nvcRotation = 0
  nvcWidth = width : nvcHeight = height
  nvcMaxQuads = maxDraws : nvcMaxVertexQuads = maxVertexQuads
  nvcGridBatchActive = 0 : nvcGridBatchFirst = 0 : nvcGridBatchSlot = -1 : nvcGridBatchGeneration = 0
  nvcBoxBatchActive = 0 : nvcBoxBatchCount = 0
  nvcRetainedBatchActive = 0 : nvcRetainedBatchCount = 0
  nvcError = 0
  nvcCreateStage = 0 : nvcCreateFaultCode = 0 : nvcCreateFaultText = 0
  nvcAtlasW = #NEON_VK_CHROME_TT_ATLAS_W : nvcAtlasH = #NEON_VK_CHROME_TT_ATLAS_H
  rc = nvcSpriteShelfPlan()
  If rc <> #NEON_VK_CHROME_OK : ProcedureReturn nvcFail(rc) : EndIf
  ; Only publish the device after the allocation-free shelf preflight passes.
  ; A refused layout may then be corrected and retried without a false live
  ; device state, while the guard above still protects a failed teardown.
  nvcPhysical = physicalDevice : nvcDevice = device : nvcQueue = queue : nvcCommandPool = commandPool
  nvcRenderPass = renderPass : nvcFramebuffer = framebuffer
  nvdPresentClear()

  cbai\sType = #VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO
  cbai\commandPool = commandPool : cbai\level = #VK_COMMAND_BUFFER_LEVEL_PRIMARY : cbai\commandBufferCount = 1
  nvcCreateStage = 1
  rc = vkAllocateCommandBuffers(device, @cbai, @nvcCommand)
  If rc = #VK_SUCCESS
    nvcCreateStage = 2
    fci\sType = #VK_STRUCTURE_TYPE_FENCE_CREATE_INFO
    rc = vkCreateFence(device, @fci, 0, @nvcFence)
  EndIf
  If rc = #VK_SUCCESS
    nvcCreateStage = 3
    rc = nvcBufferCreate(maxVertexQuads * 6 * #NEON_VK_CHROME_VERTEX_BYTES, #VK_BUFFER_USAGE_VERTEX_BUFFER_BIT, @nvcVertexBuffer, @nvcVertexMemory)
  EndIf
  If rc = #VK_SUCCESS
    nvcCreateStage = 4
    rc = nvcAtlasCreateAndUpload()
  EndIf
  If rc = #VK_SUCCESS
    nvcCreateStage = 5
    rc = nvcDescriptorsAndPipeline()
  EndIf
  If rc <> #VK_SUCCESS
    nvcError = rc
    nvcCreateFaultCode = AnvilVkFaultCode()
    nvcCreateFaultText = AnvilVkFaultText()
    NeonVkChromeDestroy()
    nvcError = rc
    ProcedureReturn rc
  EndIf
  ; The family goes in as parameters, never through a structure: see
  ; NeonDrawBackendInstall and forum 915.
  rc = NeonDrawBackendInstall(@NeonVkChromeBox, @NeonVkChromeText, @NeonVkChromeTextTex, @NeonVkChromeScissorSet, @NeonVkChromeScissorClear, @NeonVkChromeFanBegin, @NeonVkChromeFanPoint, @NeonVkChromeFanEnd, @NeonVkChromeFanOutline, @NeonVkChromeLinesBegin, @NeonVkChromeLine, @NeonVkChromeLinesEnd)
  If rc <> #NEON_OK
    nvcError = #NEON_VK_CHROME_ERR_STATE
    NeonVkChromeDestroy()
    nvcError = #NEON_VK_CHROME_ERR_STATE
    ProcedureReturn #NEON_VK_CHROME_ERR_STATE
  EndIf
  nvcHooksInstalled = 1
  rc = NeonMeasureBackendInstall(@NeonVkChromeMeasureWidth, @NeonVkChromeMeasureLineHeight)
  If rc <> #NEON_OK
    nvcError = #NEON_VK_CHROME_ERR_STATE
    NeonVkChromeDestroy()
    nvcError = #NEON_VK_CHROME_ERR_STATE
    ProcedureReturn #NEON_VK_CHROME_ERR_STATE
  EndIf
  nvcNextTargetGeneration = nvcNextTargetGeneration + 1
  nvcTargetGeneration = nvcNextTargetGeneration
  nvcReady = 1
  ProcedureReturn #VK_SUCCESS
EndProcedure

; Compatibility entry keeps the original one-capacity contract for existing
; demos and the proof fixture. Resident grid mode opts into a larger vertex
; buffer without raising the independent Vulkan draw-record ceiling.
Procedure.i NeonVkChromeCreate(physicalDevice.i, device.i, queue.i, commandPool.i, renderPass.i, framebuffer.i, width.i, height.i, maxQuads.i)
  ProcedureReturn NeonVkChromeCreateWithCapacities(physicalDevice, device, queue, commandPool, renderPass, framebuffer, width, height, maxQuads, maxQuads)
EndProcedure

Procedure.i NeonVkChromeBegin(*clearValue)
  Define bi.VkCommandBufferBeginInfo
  Define rpbi.VkRenderPassBeginInfo
  Define viewport.VkViewport
  Define Dim clear.l[4]
  Define setHandle.i
  Define bufferHandle.i
  Define offset.q
  Define rc.i

  If nvcReady = 0 Or nvcInFrame <> 0 Or nvcFrameAbortable <> 0 Or nvcExternalProducerQuarantined <> 0 Or nvcGridBatchActive <> 0 Or nvdPresentPending() <> 0 Or nvcImageSpritePendingImage <> 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  If nvcTTDirty <> 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  rc = nvcAtlasRefresh()
  If rc <> #NEON_VK_CHROME_OK : ProcedureReturn nvcFail(rc) : EndIf
  clear[0] = 0 : clear[1] = 0 : clear[2] = 0 : clear[3] = 0
  If *clearValue <> 0
    clear[0] = PeekL(*clearValue + 0) : clear[1] = PeekL(*clearValue + 4)
    clear[2] = PeekL(*clearValue + 8) : clear[3] = PeekL(*clearValue + 12)
  EndIf
  rc = vkMapMemory(nvcDevice, nvcVertexMemory, 0, #VK_WHOLE_SIZE, 0, @nvcMapped)
  If rc <> #VK_SUCCESS : ProcedureReturn nvcFail(rc) : EndIf
  rc = vkResetCommandBuffer(nvcCommand, 0)
  bi\sType = #VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO
  bi\flags = #VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT
  If rc = #VK_SUCCESS : rc = vkBeginCommandBuffer(nvcCommand, @bi) : EndIf
  If rc <> #VK_SUCCESS
    vkUnmapMemory(nvcDevice, nvcVertexMemory) : nvcMapped = 0
    ProcedureReturn nvcFail(rc)
  EndIf

  rpbi\sType = #VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO
  rpbi\renderPass = nvcRenderPass : rpbi\framebuffer = nvcFramebuffer
  rpbi\renderArea\extent\width = nvcPhysicalW : rpbi\renderArea\extent\height = nvcPhysicalH
  rpbi\clearValueCount = 1 : rpbi\pClearValues = @clear[0]
  vkCmdBeginRenderPass(nvcCommand, @rpbi, #VK_SUBPASS_CONTENTS_INLINE)
  ; VkViewport stores IEEE-754 bit words; keep zero offsets literal without
  ; asking the monitor frontend to enable its optional floating-point syntax.
  PokeL(@viewport\x, 0) : PokeL(@viewport\y, 0)
  PokeL(@viewport\width, neon_F32Int(nvcPhysicalW))
  PokeL(@viewport\height, neon_F32Int(nvcPhysicalH))
  PokeL(@viewport\minDepth, 0) : PokeL(@viewport\maxDepth, #NEON_VK_CHROME_F_ONE)
  vkCmdSetViewport(nvcCommand, 0, 1, @viewport)
  nvcViewportX = 0 : nvcViewportY = 0
  nvcViewportW = nvcPhysicalW : nvcViewportH = nvcPhysicalH
  vkCmdBindPipeline(nvcCommand, #VK_PIPELINE_BIND_POINT_GRAPHICS, nvcPipeline)
  bufferHandle = nvcVertexBuffer : offset = 0
  vkCmdBindVertexBuffers(nvcCommand, 0, 1, @bufferHandle, @offset)
  setHandle = nvcDescriptorSet
  vkCmdBindDescriptorSets(nvcCommand, #VK_PIPELINE_BIND_POINT_GRAPHICS, nvcPipelineLayout, 0, 1, @setHandle, 0, 0)
  nvcVertices = 0 : nvcExternalVertices = 0 : nvcDrawCount = 0
  nvcInFrame = 1 : nvcFrameAbortable = 1 : nvcError = 0
  nvcSubmitStage = 0 : nvcSubmitRc = #VK_SUCCESS
  nvcAtlasRasterCountAtFrame = AnvilTrueTypeRasterCount()
  nvcAtlasUploadAtFrame = nvcAtlasUploadCount
  nvcPathKind = #NVC_PATH_NONE : nvcPathCount = 0 : nvcPathError = 0
  NeonVkChromeScissorClear()
  ProcedureReturn #VK_SUCCESS
EndProcedure

; Place the current frame's normalized drawing coordinates in one physical
; rectangle. Call immediately after Begin, before any geometry or batch work.
; The render-pass clear still covers the full attachment, including the bars.
Procedure.i NeonVkChromeViewportSet(x.i, y.i, w.i, h.i)
  Define viewport.VkViewport
  Define faultCount.i
  If nvcReady = 0 Or nvcInFrame = 0 Or nvcFrameAbortable = 0 Or nvcDrawCount <> 0 Or nvcVertices <> 0 Or nvcExternalVertices <> 0 Or nvcGridBatchActive <> 0 Or nvcBoxBatchActive <> 0 Or nvcRetainedBatchActive <> 0 Or nvcPathKind <> #NVC_PATH_NONE
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  If x < 0 Or y < 0 Or w < 1 Or h < 1 Or x > nvcPhysicalW Or y > nvcPhysicalH Or w > nvcPhysicalW - x Or h > nvcPhysicalH - y
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  PokeL(@viewport\x, neon_F32Int(x)) : PokeL(@viewport\y, neon_F32Int(y))
  PokeL(@viewport\width, neon_F32Int(w)) : PokeL(@viewport\height, neon_F32Int(h))
  PokeL(@viewport\minDepth, 0) : PokeL(@viewport\maxDepth, #NEON_VK_CHROME_F_ONE)
  faultCount = AnvilVkFaultCount()
  vkCmdSetViewport(nvcCommand, 0, 1, @viewport)
  If AnvilVkFaultCount() <> faultCount
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  nvcViewportX = x : nvcViewportY = y
  nvcViewportW = w : nvcViewportH = h
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

Procedure.i nvcClipXBits2(x2.i)
  ProcedureReturn neon_F32Ratio(x2 - nvcPhysicalW, nvcPhysicalW)
EndProcedure

Procedure.i nvcClipYBits2(y2.i)
  ProcedureReturn neon_F32Ratio(y2 - nvcPhysicalH, nvcPhysicalH)
EndProcedure

Procedure nvcVertex(index.i, x.i, y.i, u.i, v.i)
  Define p.i
  Define tx.i
  Define ty.i
  If nvcRotation = 90
    tx = nvcLogicalH - y : ty = x
  ElseIf nvcRotation = 180
    tx = nvcLogicalW - x : ty = nvcLogicalH - y
  ElseIf nvcRotation = 270
    tx = y : ty = nvcLogicalW - x
  Else
    tx = x : ty = y
  EndIf
  p = nvcMapped + index * #NEON_VK_CHROME_VERTEX_BYTES
  PokeL(p + 0, nvcClipXBits2(tx * 2)) : PokeL(p + 4, nvcClipYBits2(ty * 2))
  PokeL(p + 8, u) : PokeL(p + 12, v)
  PokeL(p + 16, #NEON_VK_CHROME_F_ONE) : PokeL(p + 20, #NEON_VK_CHROME_F_ONE)
EndProcedure

Procedure nvcQuad(first.i, x0.i, y0.i, x1.i, y1.i, u0.i, v0.i, u1.i, v1.i)
  nvcVertex(first + 0, x0, y0, u0, v0)
  nvcVertex(first + 1, x0, y1, u0, v1)
  nvcVertex(first + 2, x1, y1, u1, v1)
  nvcVertex(first + 3, x0, y0, u0, v0)
  nvcVertex(first + 4, x1, y1, u1, v1)
  nvcVertex(first + 5, x1, y0, u1, v0)
EndProcedure

; Neon's DrawGLSprite rotates around the centre after camera translation and
; zoom. Q8 positions retain subpixel corners without changing the monitor's
; floating-point mode; the Vulkan vertex format stays float32.
Procedure nvcSpriteVertexQ8(index.i, xQ8.i, yQ8.i, u.i, v.i)
  Define p.i, txQ8.i, tyQ8.i
  If nvcRotation = 90
    txQ8 = nvcLogicalH * 256 - yQ8 : tyQ8 = xQ8
  ElseIf nvcRotation = 180
    txQ8 = nvcLogicalW * 256 - xQ8 : tyQ8 = nvcLogicalH * 256 - yQ8
  ElseIf nvcRotation = 270
    txQ8 = yQ8 : tyQ8 = nvcLogicalW * 256 - xQ8
  Else
    txQ8 = xQ8 : tyQ8 = yQ8
  EndIf
  p = nvcMapped + index * #NEON_VK_CHROME_VERTEX_BYTES
  PokeL(p + 0, neon_F32Ratio(txQ8 * 2 - nvcPhysicalW * 256, nvcPhysicalW * 256))
  PokeL(p + 4, neon_F32Ratio(tyQ8 * 2 - nvcPhysicalH * 256, nvcPhysicalH * 256))
  PokeL(p + 8, u) : PokeL(p + 12, v)
  PokeL(p + 16, #NEON_VK_CHROME_F_ONE) : PokeL(p + 20, #NEON_VK_CHROME_F_ONE)
EndProcedure

; Sixteen CORDIC steps resolve the radians argument to Q16 sine/cosine.
; Its constants are round(atan(2^-step) * 65536); 39797 is the inverse
; cumulative CORDIC gain in Q16. The range reduction preserves signed turns.
Procedure nvcSpriteTrigQ16(angleQ16.i, *cosQ16, *sinQ16)
  Define z.i, x.i, y.i, nextX.i, nextY.i, i.i, divisor.i, flipCos.i
  If nvcSpriteAtanReady = 0
    nvcSpriteAtanQ16[0] = 51472 : nvcSpriteAtanQ16[1] = 30386
    nvcSpriteAtanQ16[2] = 16055 : nvcSpriteAtanQ16[3] = 8150
    nvcSpriteAtanQ16[4] = 4091 : nvcSpriteAtanQ16[5] = 2047
    nvcSpriteAtanQ16[6] = 1024 : nvcSpriteAtanQ16[7] = 512
    nvcSpriteAtanQ16[8] = 256 : nvcSpriteAtanQ16[9] = 128
    nvcSpriteAtanQ16[10] = 64 : nvcSpriteAtanQ16[11] = 32
    nvcSpriteAtanQ16[12] = 16 : nvcSpriteAtanQ16[13] = 8
    nvcSpriteAtanQ16[14] = 4 : nvcSpriteAtanQ16[15] = 2
    nvcSpriteAtanReady = 1
  EndIf
  z = angleQ16 - (angleQ16 / #NVC_SPRITE_TAU_Q16) * #NVC_SPRITE_TAU_Q16
  If z > #NVC_SPRITE_PI_Q16 : z = z - #NVC_SPRITE_TAU_Q16 : EndIf
  If z < -#NVC_SPRITE_PI_Q16 : z = z + #NVC_SPRITE_TAU_Q16 : EndIf
  If z > #NVC_SPRITE_HALF_PI_Q16
    z = #NVC_SPRITE_PI_Q16 - z : flipCos = 1
  ElseIf z < -#NVC_SPRITE_HALF_PI_Q16
    z = -#NVC_SPRITE_PI_Q16 - z : flipCos = 1
  EndIf
  x = 39797 : y = 0
  For i = 0 To 15
    divisor = 1 << i
    If z >= 0
      nextX = x - y / divisor : nextY = y + x / divisor
      z = z - nvcSpriteAtanQ16[i]
    Else
      nextX = x + y / divisor : nextY = y - x / divisor
      z = z + nvcSpriteAtanQ16[i]
    EndIf
    x = nextX : y = nextY
  Next
  If flipCos <> 0 : x = -x : EndIf
  PokeI(*cosQ16, x) : PokeI(*sinQ16, y)
EndProcedure

Procedure nvcSpriteCornerQ8(centerXQ8.i, centerYQ8.i, localXQ8.i, localYQ8.i, cosQ16.i, sinQ16.i, *xQ8, *yQ8)
  PokeI(*xQ8, centerXQ8 + (localXQ8 * cosQ16 - localYQ8 * sinQ16) / 65536)
  PokeI(*yQ8, centerYQ8 + (localXQ8 * sinQ16 + localYQ8 * cosQ16) / 65536)
EndProcedure

; The public Vulkan pipeline is triangle-list only. These helpers lower solid
; fan triangles and one-pixel line quads through the atlas's owned white texel;
; no native Neon/V3D record or CPU framebuffer path is reachable here.
Procedure nvcSolidTriangle(first.i, x0.i, y0.i, x1.i, y1.i, x2.i, y2.i)
  nvcVertex(first + 0, x0, y0, nvcWhiteU0, nvcWhiteV0)
  nvcVertex(first + 1, x1, y1, nvcWhiteU0, nvcWhiteV0)
  nvcVertex(first + 2, x2, y2, nvcWhiteU0, nvcWhiteV0)
EndProcedure

Procedure nvcSolidQuad(x0.i, y0.i, x1.i, y1.i, x2.i, y2.i, x3.i, y3.i)
  nvcSolidTriangle(nvcVertices + 0, x0, y0, x1, y1, x2, y2)
  nvcSolidTriangle(nvcVertices + 3, x0, y0, x2, y2, x3, y3)
EndProcedure

; Half-pixel positions keep a one-pixel triangle strip centred on the
; corresponding V3D line, whose integer coordinates describe its centre.
Procedure nvcLineVertex(index.i, x2.i, y2.i)
  Define p.i
  Define tx2.i
  Define ty2.i
  If nvcRotation = 90
    tx2 = nvcLogicalH * 2 - y2 : ty2 = x2
  ElseIf nvcRotation = 180
    tx2 = nvcLogicalW * 2 - x2 : ty2 = nvcLogicalH * 2 - y2
  ElseIf nvcRotation = 270
    tx2 = y2 : ty2 = nvcLogicalW * 2 - x2
  Else
    tx2 = x2 : ty2 = y2
  EndIf
  p = nvcMapped + index * #NEON_VK_CHROME_VERTEX_BYTES
  PokeL(p + 0, nvcClipXBits2(tx2))
  PokeL(p + 4, nvcClipYBits2(ty2))
  PokeL(p + 8, nvcWhiteU0) : PokeL(p + 12, nvcWhiteV0)
  PokeL(p + 16, #NEON_VK_CHROME_F_ONE) : PokeL(p + 20, #NEON_VK_CHROME_F_ONE)
EndProcedure

Procedure nvcLineQuad(x0.i, y0.i, x1.i, y1.i)
  Define dx.i
  Define dy.i
  Define a.i
  Define b.i
  Define c.i
  Define d.i
  dx = x1 - x0 : If dx < 0 : dx = 0 - dx : EndIf
  dy = y1 - y0 : If dy < 0 : dy = 0 - dy : EndIf
  If dx = 0 And dy = 0
    nvcSolidQuad(x0, y0, x0 + 1, y0, x0 + 1, y0 + 1, x0, y0 + 1)
  ElseIf dx >= dy
    a = y0 * 2 - 1 : b = y1 * 2 - 1 : c = y1 * 2 + 1 : d = y0 * 2 + 1
    nvcLineVertex(nvcVertices + 0, x0 * 2, a)
    nvcLineVertex(nvcVertices + 1, x1 * 2, b)
    nvcLineVertex(nvcVertices + 2, x1 * 2, c)
    nvcLineVertex(nvcVertices + 3, x0 * 2, a)
    nvcLineVertex(nvcVertices + 4, x1 * 2, c)
    nvcLineVertex(nvcVertices + 5, x0 * 2, d)
  Else
    a = x0 * 2 - 1 : b = x1 * 2 - 1 : c = x1 * 2 + 1 : d = x0 * 2 + 1
    nvcLineVertex(nvcVertices + 0, a, y0 * 2)
    nvcLineVertex(nvcVertices + 1, b, y1 * 2)
    nvcLineVertex(nvcVertices + 2, c, y1 * 2)
    nvcLineVertex(nvcVertices + 3, a, y0 * 2)
    nvcLineVertex(nvcVertices + 4, c, y1 * 2)
    nvcLineVertex(nvcVertices + 5, d, y0 * 2)
  EndIf
EndProcedure

; Neon colours are logical packed 0xAARRGGBB. The sampled fragment shader
; consumes float RGBA, independent of the attachment's BGRA byte layout.
Procedure nvcTint(colour.i, *push)
  PokeL(*push + 0, neon_F32Byte((colour >> 16) & $FF))
  PokeL(*push + 4, neon_F32Byte((colour >> 8) & $FF))
  PokeL(*push + 8, neon_F32Byte(colour & $FF))
  PokeL(*push + 12, neon_F32Byte((colour >> 24) & $FF))
EndProcedure

Procedure.i nvcDrawSet(first.i, count.i, colour.i, setHandle.i)
  Define sc.VkRect2D
  Define Dim push.l[4]
  If nvcBoxBatchActive <> 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
  If nvcDrawCount >= nvcMaxQuads Or nvcVertices > nvcMaxVertexQuads * 6
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY)
  EndIf
  ; Keep the default full-target path unchanged. A placed viewport maps the
  ; logical scissor's two endpoints into the same physical rectangle.
  If nvcViewportX = 0 And nvcViewportY = 0 And nvcViewportW = nvcPhysicalW And nvcViewportH = nvcPhysicalH
    sc\offset\x = nvcClipX : sc\offset\y = nvcClipY
    sc\extent\width = nvcClipW : sc\extent\height = nvcClipH
  Else
    sc\offset\x = nvcViewportX + (nvcClipX * nvcViewportW + nvcPhysicalW / 2) / nvcPhysicalW
    sc\offset\y = nvcViewportY + (nvcClipY * nvcViewportH + nvcPhysicalH / 2) / nvcPhysicalH
    sc\extent\width = nvcViewportX + ((nvcClipX + nvcClipW) * nvcViewportW + nvcPhysicalW / 2) / nvcPhysicalW - sc\offset\x
    sc\extent\height = nvcViewportY + ((nvcClipY + nvcClipH) * nvcViewportH + nvcPhysicalH / 2) / nvcPhysicalH - sc\offset\y
  EndIf
  vkCmdSetScissor(nvcCommand, 0, 1, @sc)
  vkCmdBindDescriptorSets(nvcCommand, #VK_PIPELINE_BIND_POINT_GRAPHICS, nvcPipelineLayout, 0, 1, @setHandle, 0, 0)
  nvcTint(colour, @push[0])
  vkCmdPushConstants(nvcCommand, nvcPipelineLayout, #VK_SHADER_STAGE_FRAGMENT_BIT, 0, 16, @push[0])
  vkCmdDraw(nvcCommand, count, 1, first, 0)
  nvcDrawCount = nvcDrawCount + 1
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

Procedure.i nvcDraw(first.i, count.i, colour.i)
  ProcedureReturn nvcDrawSet(first, count, colour, nvcDescriptorSet)
EndProcedure

; Shared source-rectangle, destination-size and tint path for the legacy slot
; and every stable-ID atlas entry.
Procedure.i nvcSpriteRegion(x.i, y.i, sourceX.i, sourceY.i, sourceW.i, sourceH.i, drawW.i, drawH.i, colour.i, atlasX.i, atlasY.i, spriteW.i, spriteH.i)
  Define first.i
  Define u0.i, v0.i, u1.i, v1.i
  If nvcInFrame = 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  If sourceX < 0 Or sourceY < 0 Or sourceW < 1 Or sourceH < 1 Or drawW < 1 Or drawH < 1
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If sourceX >= spriteW Or sourceY >= spriteH Or sourceW > spriteW - sourceX Or sourceH > spriteH - sourceY
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If nvcGridBatchActive <> 0 Or nvcBoxBatchActive <> 0 Or nvcDrawCount >= nvcMaxQuads Or nvcVertices + 6 > nvcMaxVertexQuads * 6
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY)
  EndIf
  u0 = neon_F32Ratio(atlasX + sourceX, nvcAtlasW) : u1 = neon_F32Ratio(atlasX + sourceX + sourceW, nvcAtlasW)
  v0 = neon_F32Ratio(atlasY + sourceY, nvcAtlasH) : v1 = neon_F32Ratio(atlasY + sourceY + sourceH, nvcAtlasH)
  first = nvcVertices
  nvcQuad(first, x, y, x + drawW, y + drawH, u0, v0, u1, v1)
  nvcVertices = nvcVertices + 6
  ProcedureReturn nvcDraw(first, 6, colour)
EndProcedure

Procedure.i NeonVkChromeSprite(x.i, y.i, sourceX.i, sourceY.i, sourceW.i, sourceH.i, drawW.i, drawH.i, colour.i)
  If nvcLogoSource = 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
  ProcedureReturn nvcSpriteRegion(x, y, sourceX, sourceY, sourceW, sourceH, drawW, drawH, colour, nvcLogoX, nvcLogoY, nvcLogoW, nvcLogoH)
EndProcedure

Procedure.i NeonVkChromeSpriteDraw(id.i, x.i, y.i, sourceX.i, sourceY.i, sourceW.i, sourceH.i, drawW.i, drawH.i, colour.i)
  If id < 1 Or id > #NVC_MULTI_SPRITE_MAX : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS) : EndIf
  If nvcSpriteSource[id] = 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
  ProcedureReturn nvcSpriteRegion(x, y, sourceX, sourceY, sourceW, sourceH, drawW, drawH, colour, nvcSpriteX[id], nvcSpriteY[id], nvcSpriteW[id], nvcSpriteH[id])
EndProcedure

Procedure.i NeonVkChromeImageSpriteDrawId(id.i, x.i, y.i, sourceX.i, sourceY.i, sourceW.i, sourceH.i, drawW.i, drawH.i, colour.i)
  Define first.i, u0.i, u1.i, v0.i, v1.i, setHandle.i, imageW.i, imageH.i
  If id < 1 Or id > #NVC_MULTI_SPRITE_MAX : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS) : EndIf
  If id = 1
    setHandle = nvcImageSpriteSet : imageW = nvcImageSpriteW : imageH = nvcImageSpriteH
  Else
    setHandle = nvcImageSpriteSets[id] : imageW = nvcImageSpriteWidths[id] : imageH = nvcImageSpriteHeights[id]
  EndIf
  If nvcInFrame = 0 Or setHandle = 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  If sourceX < 0 Or sourceY < 0 Or sourceW < 1 Or sourceH < 1 Or drawW < 1 Or drawH < 1
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If sourceX >= imageW Or sourceY >= imageH Or sourceW > imageW - sourceX Or sourceH > imageH - sourceY
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If nvcGridBatchActive <> 0 Or nvcBoxBatchActive <> 0 Or nvcDrawCount >= nvcMaxQuads Or nvcVertices + 6 > nvcMaxVertexQuads * 6
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY)
  EndIf
  u0 = neon_F32Ratio(sourceX, imageW) : u1 = neon_F32Ratio(sourceX + sourceW, imageW)
  v0 = neon_F32Ratio(sourceY, imageH) : v1 = neon_F32Ratio(sourceY + sourceH, imageH)
  first = nvcVertices
  nvcQuad(first, x, y, x + drawW, y + drawH, u0, v0, u1, v1)
  nvcVertices = nvcVertices + 6
  ProcedureReturn nvcDrawSet(first, 6, colour, setHandle)
EndProcedure

Procedure.i NeonVkChromeImageSpriteDraw(x.i, y.i, sourceX.i, sourceY.i, sourceW.i, sourceH.i, drawW.i, drawH.i, colour.i)
  ProcedureReturn NeonVkChromeImageSpriteDrawId(1, x, y, sourceX, sourceY, sourceW, sourceH, drawW, drawH, colour)
EndProcedure

; `x,y` and `drawW,drawH` are Neon's pre-camera top-left and scaled size.
; Camera coordinates are in the same logical canvas. A positive Q16 radian
; angle rotates clockwise on the screen, as in DrawGLSprite. `zoomQ16=65536`
; is 1.0. This records vertices only; V3D samples/blends the image.
Procedure.i nvcSpriteTransformRegion(x.i, y.i, sourceX.i, sourceY.i, sourceW.i, sourceH.i, drawW.i, drawH.i, colour.i, angleQ16.i, cameraX.i, cameraY.i, zoomQ16.i, ignoreCamera.i, atlasX.i, atlasY.i, spriteW.i, spriteH.i, textureW.i, textureH.i, setHandle.i, dryRun.i)
  Define xQ8.i, yQ8.i, wQ8.i, hQ8.i, centerXQ8.i, centerYQ8.i
  Define halfWQ8.i, halfHQ8.i, cosQ16.i, sinQ16.i, first.i
  Define tlX.i, tlY.i, trX.i, trY.i, blX.i, blY.i, brX.i, brY.i
  Define u0.i, u1.i, v0.i, v1.i
  If nvcInFrame = 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  If sourceX < 0 Or sourceY < 0 Or sourceW < 1 Or sourceH < 1 Or drawW < 1 Or drawH < 1
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If sourceX >= spriteW Or sourceY >= spriteH Or sourceW > spriteW - sourceX Or sourceH > spriteH - sourceY
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If textureW < 1 Or textureH < 1 Or setHandle = 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  ; These input limits precede every fixed-point product and turn reduction.
  ; They keep all Q8 and Q16 intermediates in signed 64-bit range.
  If x < -16384 Or x > 16384 Or y < -16384 Or y > 16384
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If drawW > 4096 Or drawH > 4096 Or angleQ16 < -#NVC_SPRITE_MAX_ANGLE_Q16 Or angleQ16 > #NVC_SPRITE_MAX_ANGLE_Q16
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If nvcLogicalW < 1 Or nvcLogicalH < 1 Or nvcLogicalW > 8192 Or nvcLogicalH > 8192 Or nvcPhysicalW < 1 Or nvcPhysicalH < 1 Or nvcPhysicalW > 8192 Or nvcPhysicalH > 8192
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If ignoreCamera = 0
    If cameraX < -16384 Or cameraX > 16384 Or cameraY < -16384 Or cameraY > 16384 Or zoomQ16 < 1 Or zoomQ16 > 1048576
      ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
    EndIf
  EndIf
  If nvcGridBatchActive <> 0 Or nvcBoxBatchActive <> 0 Or nvcDrawCount >= nvcMaxQuads Or nvcVertices + 6 > nvcMaxVertexQuads * 6
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY)
  EndIf
  xQ8 = x * 256 : yQ8 = y * 256
  wQ8 = drawW * 256 : hQ8 = drawH * 256
  If ignoreCamera = 0
    centerXQ8 = nvcLogicalW * 128 : centerYQ8 = nvcLogicalH * 128
    xQ8 = centerXQ8 + ((xQ8 - cameraX * 256 - centerXQ8) * zoomQ16) / 65536
    yQ8 = centerYQ8 + ((yQ8 - cameraY * 256 - centerYQ8) * zoomQ16) / 65536
    wQ8 = (wQ8 * zoomQ16) / 65536 : hQ8 = (hQ8 * zoomQ16) / 65536
  EndIf
  If wQ8 < 1 Or hQ8 < 1 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS) : EndIf
  halfWQ8 = wQ8 / 2 : halfHQ8 = hQ8 / 2
  centerXQ8 = xQ8 + halfWQ8 : centerYQ8 = yQ8 + halfHQ8
  nvcSpriteTrigQ16(angleQ16, @cosQ16, @sinQ16)
  nvcSpriteCornerQ8(centerXQ8, centerYQ8, -halfWQ8, -halfHQ8, cosQ16, sinQ16, @tlX, @tlY)
  nvcSpriteCornerQ8(centerXQ8, centerYQ8, halfWQ8, -halfHQ8, cosQ16, sinQ16, @trX, @trY)
  nvcSpriteCornerQ8(centerXQ8, centerYQ8, -halfWQ8, halfHQ8, cosQ16, sinQ16, @blX, @blY)
  nvcSpriteCornerQ8(centerXQ8, centerYQ8, halfWQ8, halfHQ8, cosQ16, sinQ16, @brX, @brY)
  If tlX < -#NVC_SPRITE_Q8_LIMIT Or tlX > #NVC_SPRITE_Q8_LIMIT Or tlY < -#NVC_SPRITE_Q8_LIMIT Or tlY > #NVC_SPRITE_Q8_LIMIT Or trX < -#NVC_SPRITE_Q8_LIMIT Or trX > #NVC_SPRITE_Q8_LIMIT Or trY < -#NVC_SPRITE_Q8_LIMIT Or trY > #NVC_SPRITE_Q8_LIMIT
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If blX < -#NVC_SPRITE_Q8_LIMIT Or blX > #NVC_SPRITE_Q8_LIMIT Or blY < -#NVC_SPRITE_Q8_LIMIT Or blY > #NVC_SPRITE_Q8_LIMIT Or brX < -#NVC_SPRITE_Q8_LIMIT Or brX > #NVC_SPRITE_Q8_LIMIT Or brY < -#NVC_SPRITE_Q8_LIMIT Or brY > #NVC_SPRITE_Q8_LIMIT
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If dryRun <> 0 : ProcedureReturn #NEON_VK_CHROME_OK : EndIf
  u0 = neon_F32Ratio(atlasX + sourceX, textureW) : u1 = neon_F32Ratio(atlasX + sourceX + sourceW, textureW)
  v0 = neon_F32Ratio(atlasY + sourceY, textureH) : v1 = neon_F32Ratio(atlasY + sourceY + sourceH, textureH)
  first = nvcVertices
  nvcSpriteVertexQ8(first + 0, tlX, tlY, u0, v0)
  nvcSpriteVertexQ8(first + 1, blX, blY, u0, v1)
  nvcSpriteVertexQ8(first + 2, brX, brY, u1, v1)
  nvcSpriteVertexQ8(first + 3, tlX, tlY, u0, v0)
  nvcSpriteVertexQ8(first + 4, brX, brY, u1, v1)
  nvcSpriteVertexQ8(first + 5, trX, trY, u1, v0)
  nvcVertices = nvcVertices + 6
  ProcedureReturn nvcDrawSet(first, 6, colour, setHandle)
EndProcedure

Procedure.i NeonVkChromeSpriteTransform(x.i, y.i, sourceX.i, sourceY.i, sourceW.i, sourceH.i, drawW.i, drawH.i, colour.i, angleQ16.i, cameraX.i, cameraY.i, zoomQ16.i, ignoreCamera.i)
  If nvcLogoSource = 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
  ProcedureReturn nvcSpriteTransformRegion(x, y, sourceX, sourceY, sourceW, sourceH, drawW, drawH, colour, angleQ16, cameraX, cameraY, zoomQ16, ignoreCamera, nvcLogoX, nvcLogoY, nvcLogoW, nvcLogoH, nvcAtlasW, nvcAtlasH, nvcDescriptorSet, 0)
EndProcedure

Procedure.i NeonVkChromeSpriteDrawTransform(id.i, x.i, y.i, sourceX.i, sourceY.i, sourceW.i, sourceH.i, drawW.i, drawH.i, colour.i, angleQ16.i, cameraX.i, cameraY.i, zoomQ16.i, ignoreCamera.i)
  If id < 1 Or id > #NVC_MULTI_SPRITE_MAX : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS) : EndIf
  If nvcSpriteSource[id] = 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
  ProcedureReturn nvcSpriteTransformRegion(x, y, sourceX, sourceY, sourceW, sourceH, drawW, drawH, colour, angleQ16, cameraX, cameraY, zoomQ16, ignoreCamera, nvcSpriteX[id], nvcSpriteY[id], nvcSpriteW[id], nvcSpriteH[id], nvcAtlasW, nvcAtlasH, nvcDescriptorSet, 0)
EndProcedure

Procedure.i NeonVkChromeImageSpriteDrawTransformId(id.i, x.i, y.i, sourceX.i, sourceY.i, sourceW.i, sourceH.i, drawW.i, drawH.i, colour.i, angleQ16.i, cameraX.i, cameraY.i, zoomQ16.i, ignoreCamera.i)
  Define setHandle.i, imageW.i, imageH.i
  If id < 1 Or id > #NVC_MULTI_SPRITE_MAX : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS) : EndIf
  If id = 1
    setHandle = nvcImageSpriteSet : imageW = nvcImageSpriteW : imageH = nvcImageSpriteH
  Else
    setHandle = nvcImageSpriteSets[id] : imageW = nvcImageSpriteWidths[id] : imageH = nvcImageSpriteHeights[id]
  EndIf
  If setHandle = 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
  ProcedureReturn nvcSpriteTransformRegion(x, y, sourceX, sourceY, sourceW, sourceH, drawW, drawH, colour, angleQ16, cameraX, cameraY, zoomQ16, ignoreCamera, 0, 0, imageW, imageH, imageW, imageH, setHandle, 0)
EndProcedure

Procedure.i NeonVkChromeImageSpriteDrawTransform(x.i, y.i, sourceX.i, sourceY.i, sourceW.i, sourceH.i, drawW.i, drawH.i, colour.i, angleQ16.i, cameraX.i, cameraY.i, zoomQ16.i, ignoreCamera.i)
  ProcedureReturn NeonVkChromeImageSpriteDrawTransformId(1, x, y, sourceX, sourceY, sourceW, sourceH, drawW, drawH, colour, angleQ16, cameraX, cameraY, zoomQ16, ignoreCamera)
EndProcedure

; Begin and Add retain commands only. End appends the entire group after all
; intervening draws, using the clip active at End. IDs refer to live images;
; replacing or clearing one invalidates the group rather than sampling a new
; generation under old geometry. The group may be submitted in later frames
; while its target geometry and image generations remain unchanged.
Procedure.i NeonVkChromeSpriteBatchBegin()
  If nvcReady = 0 Or nvcInFrame = 0 Or nvcGridBatchActive <> 0 Or nvcBoxBatchActive <> 0 Or nvcPathKind <> #NVC_PATH_NONE
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  nvcRetainedBatchLogicalW = nvcLogicalW : nvcRetainedBatchLogicalH = nvcLogicalH
  nvcRetainedBatchTargetGeneration = nvcTargetGeneration
  nvcRetainedBatchCount = 0 : nvcRetainedBatchActive = 1
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

Procedure.i NeonVkChromeSpriteBatchAdd(id.i, x.i, y.i, sourceX.i, sourceY.i, sourceW.i, sourceH.i, drawW.i, drawH.i, colour.i, angleQ16.i, cameraX.i, cameraY.i, zoomQ16.i, ignoreCamera.i)
  Define setHandle.i, imageW.i, imageH.i, generation.i
  Define *item.NvcRetainedSprite
  If nvcInFrame = 0 Or nvcRetainedBatchActive = 0 Or nvcLogicalW <> nvcRetainedBatchLogicalW Or nvcLogicalH <> nvcRetainedBatchLogicalH Or nvcTargetGeneration <> nvcRetainedBatchTargetGeneration
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  If nvcRetainedBatchCount >= #NVC_RETAINED_BATCH_MAX
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY)
  EndIf
  If id < 1 Or id > #NVC_MULTI_SPRITE_MAX
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If id = 1
    setHandle = nvcImageSpriteSet : imageW = nvcImageSpriteW : imageH = nvcImageSpriteH
    generation = nvcImageSpriteGeneration
  Else
    setHandle = nvcImageSpriteSets[id] : imageW = nvcImageSpriteWidths[id] : imageH = nvcImageSpriteHeights[id]
    generation = nvcImageSpriteGenerations[id]
  EndIf
  If setHandle = 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
  If sourceX < 0 Or sourceY < 0 Or sourceW < 1 Or sourceH < 1 Or drawW < 1 Or drawH < 1
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If sourceX >= imageW Or sourceY >= imageH Or sourceW > imageW - sourceX Or sourceH > imageH - sourceY
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  *item = @nvcRetainedItems[nvcRetainedBatchCount]
  *item\id = id : *item\generation = generation
  *item\x = x : *item\y = y
  *item\sourceX = sourceX : *item\sourceY = sourceY
  *item\sourceW = sourceW : *item\sourceH = sourceH
  *item\drawW = drawW : *item\drawH = drawH : *item\colour = colour
  *item\angleQ16 = angleQ16 : *item\cameraX = cameraX : *item\cameraY = cameraY
  *item\zoomQ16 = zoomQ16 : *item\ignoreCamera = ignoreCamera
  nvcRetainedBatchCount = nvcRetainedBatchCount + 1
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

Procedure.i NeonVkChromeSpriteBatchEnd()
  Define i.i, id.i, setHandle.i, imageW.i, imageH.i, generation.i, rc.i
  Define *item.NvcRetainedSprite
  If nvcInFrame = 0 Or nvcRetainedBatchActive = 0 Or nvcGridBatchActive <> 0 Or nvcBoxBatchActive <> 0 Or nvcPathKind <> #NVC_PATH_NONE
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  If nvcLogicalW <> nvcRetainedBatchLogicalW Or nvcLogicalH <> nvcRetainedBatchLogicalH Or nvcTargetGeneration <> nvcRetainedBatchTargetGeneration
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  If nvcRetainedBatchCount > nvcMaxQuads - nvcDrawCount Or nvcRetainedBatchCount * 6 > nvcMaxVertexQuads * 6 - nvcVertices
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY)
  EndIf
  If nvcRetainedBatchCount = 0 : ProcedureReturn #NEON_VK_CHROME_OK : EndIf
  ; The first pass is read-only: a bad later item cannot append an earlier one.
  For i = 0 To nvcRetainedBatchCount - 1
    *item = @nvcRetainedItems[i] : id = *item\id
    If id = 1
      setHandle = nvcImageSpriteSet : imageW = nvcImageSpriteW : imageH = nvcImageSpriteH
      generation = nvcImageSpriteGeneration
    Else
      setHandle = nvcImageSpriteSets[id] : imageW = nvcImageSpriteWidths[id] : imageH = nvcImageSpriteHeights[id]
      generation = nvcImageSpriteGenerations[id]
    EndIf
    If setHandle = 0 Or generation <> *item\generation
      ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
    EndIf
    rc = nvcSpriteTransformRegion(*item\x, *item\y, *item\sourceX, *item\sourceY, *item\sourceW, *item\sourceH, *item\drawW, *item\drawH, *item\colour, *item\angleQ16, *item\cameraX, *item\cameraY, *item\zoomQ16, *item\ignoreCamera, 0, 0, imageW, imageH, imageW, imageH, setHandle, 1)
    If rc <> #NEON_VK_CHROME_OK : ProcedureReturn rc : EndIf
  Next
  For i = 0 To nvcRetainedBatchCount - 1
    *item = @nvcRetainedItems[i] : id = *item\id
    If id = 1
      setHandle = nvcImageSpriteSet : imageW = nvcImageSpriteW : imageH = nvcImageSpriteH
    Else
      setHandle = nvcImageSpriteSets[id] : imageW = nvcImageSpriteWidths[id] : imageH = nvcImageSpriteHeights[id]
    EndIf
    rc = nvcSpriteTransformRegion(*item\x, *item\y, *item\sourceX, *item\sourceY, *item\sourceW, *item\sourceH, *item\drawW, *item\drawH, *item\colour, *item\angleQ16, *item\cameraX, *item\cameraY, *item\zoomQ16, *item\ignoreCamera, 0, 0, imageW, imageH, imageW, imageH, setHandle, 0)
    If rc <> #NEON_VK_CHROME_OK : ProcedureReturn rc : EndIf
  Next
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

; Preserve the original full-size, opaque RGB logo call.
Procedure.i NeonVkChromeLogo(x.i, y.i)
  ProcedureReturn NeonVkChromeSprite(x, y, 0, 0, nvcLogoW, nvcLogoH, nvcLogoW, nvcLogoH, Neon_RGB(255, 255, 255))
EndProcedure

Procedure.i NeonVkChromeBox(x.i, y.i, w.i, h.i, colour.i)
  Define first.i
  If nvcInFrame = 0 Or nvcGridBatchActive <> 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
  If w <= 0 Or h <= 0 : ProcedureReturn #NEON_VK_CHROME_OK : EndIf
  ; Reserve one draw for either this box or the complete active box span.
  If nvcDrawCount >= nvcMaxQuads Or nvcVertices + 6 > nvcMaxVertexQuads * 6
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY)
  EndIf
  If nvcBoxBatchActive <> 0
    If nvcBoxBatchCount = 0
      nvcBoxBatchFirst = nvcVertices : nvcBoxBatchColour = colour
      nvcBoxBatchClipX = nvcClipX : nvcBoxBatchClipY = nvcClipY
      nvcBoxBatchClipW = nvcClipW : nvcBoxBatchClipH = nvcClipH
    ElseIf colour <> nvcBoxBatchColour Or nvcClipX <> nvcBoxBatchClipX Or nvcClipY <> nvcBoxBatchClipY Or nvcClipW <> nvcBoxBatchClipW Or nvcClipH <> nvcBoxBatchClipH
      ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
    EndIf
    nvcQuad(nvcVertices, x, y, x + w, y + h, nvcWhiteU0, nvcWhiteV0, nvcWhiteU1, nvcWhiteV1)
    nvcVertices = nvcVertices + 6 : nvcBoxBatchCount = nvcBoxBatchCount + 6
    ProcedureReturn #NEON_VK_CHROME_OK
  EndIf
  first = nvcVertices
  ; Boxes sample only Neon's dedicated opaque-white atlas texel.
  nvcQuad(first, x, y, x + w, y + h, nvcWhiteU0, nvcWhiteV0, nvcWhiteU1, nvcWhiteV1)
  nvcVertices = nvcVertices + 6
  ProcedureReturn nvcDraw(first, 6, colour)
EndProcedure

; The table stores entry + 1, so zero remains an unambiguous empty marker.
; Identity checks use the full generation; the masked generation below only
; selects a starting bucket and collisions are resolved by bounded probing.
Procedure.i nvcTTCacheBucket(slot.i, generation.i, pixelHeight.i, glyph.i)
  ProcedureReturn (((slot & 1023) * 7) + ((generation & 1023) * 29) + ((pixelHeight & 1023) * 17) + ((glyph & 1023) * 131)) & (#NVC_TT_INDEX_SIZE - 1)
EndProcedure

Procedure.i nvcTTCacheFind(slot.i, generation.i, pixelHeight.i, glyph.i)
  Define bucket.i, probe.i, entry.i
  bucket = nvcTTCacheBucket(slot, generation, pixelHeight, glyph)
  For probe = 0 To #NVC_TT_INDEX_SIZE - 1
    entry = nvcTTIndex[bucket] - 1
    If entry < 0 : ProcedureReturn -1 : EndIf
    If entry >= nvcTTCount : ProcedureReturn -1 : EndIf
    If nvcTTSlot[entry] = slot And nvcTTGen[entry] = generation And nvcTTHeight[entry] = pixelHeight And nvcTTGlyph[entry] = glyph
      ProcedureReturn entry
    EndIf
    bucket = (bucket + 1) & (#NVC_TT_INDEX_SIZE - 1)
  Next
  ProcedureReturn -1
EndProcedure

Procedure.i nvcTTCacheVacant(slot.i, generation.i, pixelHeight.i, glyph.i)
  Define bucket.i, probe.i
  bucket = nvcTTCacheBucket(slot, generation, pixelHeight, glyph)
  For probe = 0 To #NVC_TT_INDEX_SIZE - 1
    If nvcTTIndex[bucket] = 0 : ProcedureReturn bucket : EndIf
    bucket = (bucket + 1) & (#NVC_TT_INDEX_SIZE - 1)
  Next
  ProcedureReturn -1
EndProcedure

Procedure.i nvcTTFixed16Floor(value.i)
  If value >= 0 : ProcedureReturn value >> 16 : EndIf
  ProcedureReturn 0 - (((0 - value) + $FFFF) >> 16)
EndProcedure

Procedure nvcTTDirtyRectMark(x.i, y.i, width.i, height.i)
  If nvcTTDirtyRectValid = 0
    nvcTTDirtyLeft = x : nvcTTDirtyTop = y
    nvcTTDirtyRight = x + width : nvcTTDirtyBottom = y + height
    nvcTTDirtyRectValid = 1
  Else
    If x < nvcTTDirtyLeft : nvcTTDirtyLeft = x : EndIf
    If y < nvcTTDirtyTop : nvcTTDirtyTop = y : EndIf
    If x + width > nvcTTDirtyRight : nvcTTDirtyRight = x + width : EndIf
    If y + height > nvcTTDirtyBottom : nvcTTDirtyBottom = y + height : EndIf
  EndIf
EndProcedure

Procedure nvcTTUploadCommitted()
  nvcTTDirty = 0 : nvcTTForceFull = 0 : nvcTTDirtyRectValid = 0
  nvcTTDirtyLeft = 0 : nvcTTDirtyTop = 0
  nvcTTDirtyRight = 0 : nvcTTDirtyBottom = 0
EndProcedure

Procedure.i nvcTTCacheClear()
  Define x.i, y.i, p.i
  If nvcInFrame <> 0 Or nvcAtlasUploadMapped = 0 : ProcedureReturn 0 : EndIf
  For y = 0 To nvcTTLimitY - 1
    p = nvcAtlasUploadMapped + #NEON_VK_CHROME_ATLAS_PAD + (y * nvcAtlasW + 32) * 4
    For x = 32 To nvcAtlasW - 1
      PokeL(p, 0) : p + 4
    Next
  Next
  nvcTTCount = 0 : nvcTTNextX = 32 : nvcTTNextY = 1 : nvcTTRowH = 0
  For x = 0 To #NVC_TT_INDEX_SIZE - 1 : nvcTTIndex[x] = 0 : Next
  nvcTTDirty = 1 : nvcTTForceFull = 1 : nvcTTDirtyRectValid = 0
  ProcedureReturn 1
EndProcedure

Procedure.i nvcTTAddGlyph(slot.i, generation.i, pixelHeight.i, glyph.i)
  Define width.i, height.i, stride.i, bearingX.i, bearingY.i, advance.i
  Define paddedW.i, paddedH.i, x.i, y.i, shelfHeight.i, copyRow.i, col.i, entry.i, p.i, bucket.i
  If nvcTTCount >= #NEON_VK_CHROME_TT_CACHE_MAX : ProcedureReturn -1 : EndIf
  bucket = nvcTTCacheVacant(slot, generation, pixelHeight, glyph)
  If bucket < 0 : ProcedureReturn -1 : EndIf
  If AnvilTrueTypeRasterizeGlyph(glyph, pixelHeight, @nvcTTCoverage[0], #NEON_VK_CHROME_TT_COVERAGE, @width, @height, @stride, @bearingX, @bearingY, @advance) = 0
    ProcedureReturn -1
  EndIf
  If width < 0 Or height < 0 Or stride < width Or stride * height > #NEON_VK_CHROME_TT_COVERAGE
    ProcedureReturn -1
  EndIf
  x = nvcTTNextX : y = nvcTTNextY : shelfHeight = nvcTTRowH
  paddedW = width + 2 : paddedH = height + 2
  If paddedW > nvcAtlasW - 32 Or paddedH > nvcTTLimitY - 1 : ProcedureReturn -1 : EndIf
  If x + paddedW > nvcAtlasW
    x = 32 : y = y + shelfHeight : shelfHeight = 0
  EndIf
  If y + paddedH > nvcTTLimitY : ProcedureReturn -1 : EndIf
  If width > 0 And height > 0
    For copyRow = 0 To height - 1
      For col = 0 To width - 1
        p = nvcAtlasUploadMapped + #NEON_VK_CHROME_ATLAS_PAD + (((y + 1 + copyRow) * nvcAtlasW + x + 1 + col) * 4)
        PokeL(p, $00FFFFFF | ((PeekA(@nvcTTCoverage[copyRow * stride + col]) & $FF) << 24))
      Next
    Next
  EndIf
  entry = nvcTTCount
  nvcTTSlot[entry] = slot : nvcTTGen[entry] = generation
  nvcTTHeight[entry] = pixelHeight : nvcTTGlyph[entry] = glyph
  If width > 0 And height > 0
    nvcTTX[entry] = x + 1 : nvcTTY[entry] = y + 1
  Else
    nvcTTX[entry] = 0 : nvcTTY[entry] = 0
  EndIf
  nvcTTW[entry] = width : nvcTTH[entry] = height
  nvcTTBearingX[entry] = bearingX : nvcTTBearingY[entry] = bearingY : nvcTTAdvance[entry] = advance
  nvcTTIndex[bucket] = entry + 1
  nvcTTCount = nvcTTCount + 1
  nvcTTNextX = x + paddedW
  nvcTTNextY = y
  If height + 2 > shelfHeight : shelfHeight = height + 2 : EndIf
  nvcTTRowH = shelfHeight
  nvcTTDirtyRectMark(x, y, paddedW, paddedH)
  nvcTTDirty = 1 : nvcTTCacheMisses + 1
  ProcedureReturn entry
EndProcedure

; Measure the printable console alphabet from the rasterizer's actual bitmap
; bounds before choosing terminal geometry. No cell may rescale a glyph: the
; width covers both advance and overhang when the advance is centered.
Procedure.i NeonVkChromeGridMeasure(pixelHeight.i, widthOut.i, heightOut.i, baselineOut.i)
  Define slot.i, generation.i, units.i, ascent.i, descent.i, gap.i
  Define cp.i, glyph.i, width.i, height.i, stride.i, bearingX.i, bearingY.i, advance.i
  Define needW.i, right.i, maxW.i, above.i, below.i, baseline.i, cellH.i
  If widthOut = 0 Or heightOut = 0 Or baselineOut = 0 Or pixelHeight < 1 Or pixelHeight > 512
    ProcedureReturn 0
  EndIf
  slot = AnvilTrueTypeSlotSelected()
  If slot < 0 Or AnvilTrueTypeSlotParserBound() = 0 : ProcedureReturn 0 : EndIf
  generation = AnvilTrueTypeSlotGeneration(slot)
  If slot = nvcGridMetricSlot And generation = nvcGridMetricGeneration And pixelHeight = nvcGridMetricPixels
    PokeI(widthOut, nvcGridMetricW) : PokeI(heightOut, nvcGridMetricH) : PokeI(baselineOut, nvcGridMetricBaseline)
    ProcedureReturn 1
  EndIf
  units = AnvilTrueTypeUnitsPerEm()
  If units < 1 : ProcedureReturn 0 : EndIf
  ascent = (AnvilTrueTypeAscender() * pixelHeight + units - 1) / units
  descent = (0 - AnvilTrueTypeDescender() * pixelHeight + units - 1) / units
  gap = (AnvilTrueTypeLineGap() * pixelHeight + units - 1) / units
  If ascent < 0 : ascent = 0 : EndIf
  If descent < 0 : descent = 0 : EndIf
  If gap < 0 : gap = 0 : EndIf
  maxW = 1 : above = 0 : below = 0
  For cp = 32 To 126
    glyph = AnvilTrueTypeGlyphForCodepoint(cp)
    If glyph < 0 Or glyph >= AnvilTrueTypeGlyphCount() : ProcedureReturn 0 : EndIf
    If AnvilTrueTypeRasterizeGlyph(glyph, pixelHeight, @nvcTTCoverage[0], #NEON_VK_CHROME_TT_COVERAGE, @width, @height, @stride, @bearingX, @bearingY, @advance) = 0
      ProcedureReturn 0
    EndIf
    needW = advance
    If bearingX < 0 And advance - 2 * bearingX > needW : needW = advance - 2 * bearingX : EndIf
    right = bearingX + width
    If right > advance And 2 * right - advance > needW : needW = 2 * right - advance : EndIf
    If needW > maxW : maxW = needW : EndIf
    If bearingY > above : above = bearingY : EndIf
    If height - bearingY > below : below = height - bearingY : EndIf
  Next
  baseline = ascent
  If above > baseline : baseline = above : EndIf
  baseline = baseline + 1
  If descent > below : below = descent : EndIf
  cellH = baseline + below + gap + 1
  nvcGridMetricSlot = slot : nvcGridMetricGeneration = generation : nvcGridMetricPixels = pixelHeight
  nvcGridMetricW = maxW + 2 : nvcGridMetricH = cellH : nvcGridMetricBaseline = baseline
  PokeI(widthOut, nvcGridMetricW) : PokeI(heightOut, nvcGridMetricH) : PokeI(baselineOut, baseline)
  ProcedureReturn 1
EndProcedure

; Warm complete UTF-8 runs before Begin. The cache key includes slot generation
; and pixel height; a miss is rasterized once and uploaded as one full-atlas
; transaction before any frame can reference the new UVs.
Procedure.i NeonVkChromeWarmTrueTypeText(pixelHeight.i, *s)
  Define length.i, decoded.i, i.i, slot.i, generation.i, glyph.i, entry.i
  If nvcReady = 0 Or nvcInFrame <> 0 Or *s = 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  slot = AnvilTrueTypeSlotSelected()
  If slot < 0 Or AnvilTrueTypeSlotParserBound() = 0 Or pixelHeight < 1 Or pixelHeight > 512
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  While length < 4096 And PeekA(*s + length) <> 0 : length + 1 : Wend
  If length >= 4096 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY) : EndIf
  decoded = AnvilTrueTypeDecodeUtf8(*s, length, @nvcTTDecoded[0], #NEON_VK_CHROME_TT_CACHE_MAX * 8)
  If decoded < 0 Or decoded > #NEON_VK_CHROME_TT_CACHE_MAX * 8
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ATLAS)
  EndIf
  If length > 0 And decoded = 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ATLAS) : EndIf
  generation = AnvilTrueTypeSlotGeneration(slot)
  For i = 0 To decoded - 1
    glyph = nvcTTDecoded[i]
    entry = nvcTTCacheFind(slot, generation, pixelHeight, glyph)
    If entry >= 0
      nvcTTCacheHits + 1
    Else
      entry = nvcTTAddGlyph(slot, generation, pixelHeight, glyph)
      If entry < 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY) : EndIf
    EndIf
  Next
  If nvcTTDirty <> 0
    If nvcAtlasUploadWarm(1) <> #VK_SUCCESS : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_VULKAN) : EndIf
    nvcTTUploadCommitted()
  EndIf
  ProcedureReturn decoded
EndProcedure

; Admit a deduplicated grid's glyph IDs before a render pass. The owner may
; build this list from the shared console grid, then append cached cells in
; the frame. The single upload here keeps atlas mutations outside the pass.
Procedure.i NeonVkChromeGridWarm(*glyphs, count.i, pixelHeight.i)
  Define i.i
  Define glyph.i
  Define slot.i
  Define generation.i
  Define entry.i
  If nvcReady = 0 Or nvcInFrame <> 0 Or nvcGridBatchActive <> 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  If count < 0 Or count > #NEON_VK_CHROME_TT_CACHE_MAX Or pixelHeight < 1 Or pixelHeight > 512
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If count > 0 And *glyphs = 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS) : EndIf
  slot = AnvilTrueTypeSlotSelected()
  If slot < 0 Or AnvilTrueTypeSlotParserBound() = 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
  generation = AnvilTrueTypeSlotGeneration(slot)
  For i = 0 To count - 1
    ; Console owners publish packed 32-bit glyph IDs in a `.l` array; `.i`
    ; is 64-bit in this compiler and would step beyond each element.
    glyph = PeekL(*glyphs + (i * 4))
    If glyph < 0 Or glyph >= AnvilTrueTypeGlyphCount()
      ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
    EndIf
    entry = nvcTTCacheFind(slot, generation, pixelHeight, glyph)
    If entry < 0
      entry = nvcTTAddGlyph(slot, generation, pixelHeight, glyph)
      If entry < 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY) : EndIf
    Else
      nvcTTCacheHits + 1
    EndIf
  Next
  If nvcTTDirty <> 0
    If nvcAtlasUploadWarm(1) <> #VK_SUCCESS : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_VULKAN) : EndIf
    nvcTTUploadCommitted()
  EndIf
  ProcedureReturn count
EndProcedure

; Begin a consecutive grid-text batch inside an active frame. A batch records
; no color until flush, so callers can traverse the grid once per ink color
; and keep each color in one contiguous vertex range / Vulkan draw.
Procedure.i NeonVkChromeGridBatchBegin()
  Define slot.i
  If nvcReady = 0 Or nvcInFrame = 0 Or nvcMapped = 0 Or nvcGridBatchActive <> 0 Or nvcBoxBatchActive <> 0 Or nvcTTDirty <> 0 Or nvcPathKind <> #NVC_PATH_NONE
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  slot = AnvilTrueTypeSlotSelected()
  If slot < 0 Or AnvilTrueTypeSlotParserBound() = 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  nvcGridBatchSlot = slot
  nvcGridBatchGeneration = AnvilTrueTypeSlotGeneration(slot)
  nvcGridBatchFirst = nvcVertices
  nvcGridBatchActive = 1
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

; Reserve the complete grid before the first append. `neededQuads` is a
; conservative count (including bounded UI quads); a refusal leaves both the
; vertex cursor and draw cursor unchanged, so callers cannot submit half a grid.
Procedure.i NeonVkChromeGridBatchReserve(neededQuads.i, drawSegments.i)
  If nvcInFrame = 0 Or nvcGridBatchActive = 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  If neededQuads < 0 Or neededQuads > #NEON_VK_CHROME_MAX_VERTEX_QUADS Or drawSegments < 0 Or drawSegments > 2
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  If nvcVertices > (nvcMaxVertexQuads - neededQuads) * 6 Or nvcDrawCount > nvcMaxQuads - drawSegments
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY)
  EndIf
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

; Append a previously warmed glyph inside its fixed cell. Preserve the full
; atlas rectangle and the font's vertical baseline. Fit wide bitmap bounds
; horizontally without also shrinking their cap height.
; The cache key is checked exactly; a miss during a render pass fails before
; touching the vertex buffer because raster/upload is pre-frame work.
Procedure.i nvcGridGlyphAppend(glyph.i, pixelHeight.i, cellX.i, cellY.i, cellW.i, cellH.i, nativeSize.i)
  Define slot.i
  Define entry.i
  Define units.i
  Define ascent.i
  Define lineHeight.i
  Define baseline.i
  Define glyphLeft.i
  Define glyphTop.i
  Define glyphRight.i
  Define glyphBottom.i
  Define cellRight.i
  Define cellBottom.i
  Define glyphW.i
  Define glyphH.i
  Define u0.i, v0.i, u1.i, v1.i
  If nvcReady = 0 Or nvcInFrame = 0 Or nvcMapped = 0 Or nvcGridBatchActive = 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  If pixelHeight < 1 Or pixelHeight > 512 Or cellW < 1 Or cellH < 1 Or glyph < 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  slot = AnvilTrueTypeSlotSelected()
  If slot <> nvcGridBatchSlot
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  If AnvilTrueTypeSlotParserBound() = 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  If AnvilTrueTypeSlotGeneration(slot) <> nvcGridBatchGeneration
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  entry = nvcTTCacheFind(slot, nvcGridBatchGeneration, pixelHeight, glyph)
  If entry < 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ATLAS) : EndIf
  If nvcTTW[entry] = 0 Or nvcTTH[entry] = 0 : ProcedureReturn #NEON_VK_CHROME_OK : EndIf
  If nvcVertices > (nvcMaxVertexQuads * 6) - 6
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY)
  EndIf
  units = AnvilTrueTypeUnitsPerEm()
  If units < 1 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ATLAS) : EndIf
  ascent = (AnvilTrueTypeAscender() * pixelHeight) / units
  lineHeight = ((AnvilTrueTypeAscender() - AnvilTrueTypeDescender()) * pixelHeight) / units
  If nativeSize <> 0
    If slot <> nvcGridMetricSlot Or nvcGridBatchGeneration <> nvcGridMetricGeneration Or pixelHeight <> nvcGridMetricPixels Or cellW <> nvcGridMetricW Or cellH <> nvcGridMetricH
      ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
    EndIf
    baseline = cellY + nvcGridMetricBaseline
  Else
    baseline = cellY + ((cellH - lineHeight) / 2) + ascent
  EndIf
  glyphLeft = cellX + ((cellW - nvcTTAdvance[entry]) / 2) + nvcTTBearingX[entry]
  glyphTop = baseline - nvcTTBearingY[entry]
  glyphW = nvcTTW[entry] : glyphH = nvcTTH[entry]
  cellRight = cellX + cellW : cellBottom = cellY + cellH
  If nativeSize <> 0
    ; The grid was measured from real raster bounds. A mismatch is an error,
    ; never an invitation to stretch, squeeze or clip a TrueType bitmap.
    If glyphLeft < cellX Or glyphLeft + glyphW > cellRight Or glyphTop < cellY Or glyphTop + glyphH > cellBottom
      ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
    EndIf
  Else
    If glyphW > cellW
      glyphW = cellW : glyphLeft = cellX
    Else
      If glyphLeft < cellX : glyphLeft = cellX : EndIf
      If glyphLeft + glyphW > cellRight : glyphLeft = cellRight - glyphW : EndIf
    EndIf
    If glyphH > cellH : glyphH = cellH : EndIf
    If glyphTop < cellY : glyphTop = cellY : EndIf
    If glyphTop + glyphH > cellBottom : glyphTop = cellBottom - glyphH : EndIf
  EndIf
  glyphRight = glyphLeft + glyphW : glyphBottom = glyphTop + glyphH
  u0 = neon_F32Ratio(nvcTTX[entry], nvcAtlasW)
  v0 = neon_F32Ratio(nvcTTY[entry], nvcAtlasH)
  u1 = neon_F32Ratio(nvcTTX[entry] + nvcTTW[entry], nvcAtlasW)
  v1 = neon_F32Ratio(nvcTTY[entry] + nvcTTH[entry], nvcAtlasH)
  nvcQuad(nvcVertices, glyphLeft, glyphTop, glyphRight, glyphBottom, u0, v0, u1, v1)
  nvcVertices = nvcVertices + 6
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

Procedure.i NeonVkChromeGridGlyphAppend(glyph.i, pixelHeight.i, cellX.i, cellY.i, cellW.i, cellH.i)
  ProcedureReturn nvcGridGlyphAppend(glyph, pixelHeight, cellX, cellY, cellW, cellH, 0)
EndProcedure

Procedure.i NeonVkChromeGridGlyphAppendNative(glyph.i, pixelHeight.i, cellX.i, cellY.i, cellW.i, cellH.i)
  ProcedureReturn nvcGridGlyphAppend(glyph, pixelHeight, cellX, cellY, cellW, cellH, 1)
EndProcedure

; Append at the font layout engine's actual 16.16 pen position. The atlas
; bitmap and its bearings are used unchanged; there is no fixed-width cell
; and no per-glyph rounding of the advance before the next glyph is placed.
Procedure.i NeonVkChromeGridGlyphAppendPositioned(glyph.i, pixelHeight.i, penXFixed.i, baselineY.i, placementYFixed.i)
  Define slot.i, entry.i, left.i, top.i, u0.i, v0.i, u1.i, v1.i
  If nvcReady = 0 Or nvcInFrame = 0 Or nvcMapped = 0 Or nvcGridBatchActive = 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  If pixelHeight < 1 Or pixelHeight > 512 Or glyph < 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  slot = AnvilTrueTypeSlotSelected()
  If slot <> nvcGridBatchSlot Or AnvilTrueTypeSlotParserBound() = 0 Or AnvilTrueTypeSlotGeneration(slot) <> nvcGridBatchGeneration
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  entry = nvcTTCacheFind(slot, nvcGridBatchGeneration, pixelHeight, glyph)
  If entry < 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ATLAS) : EndIf
  If nvcTTW[entry] = 0 Or nvcTTH[entry] = 0 : ProcedureReturn #NEON_VK_CHROME_OK : EndIf
  If nvcVertices > (nvcMaxVertexQuads * 6) - 6
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY)
  EndIf
  left = nvcTTFixed16Floor(penXFixed) + nvcTTBearingX[entry]
  top = baselineY - nvcTTFixed16Floor(placementYFixed) - nvcTTBearingY[entry]
  u0 = neon_F32Ratio(nvcTTX[entry], nvcAtlasW)
  v0 = neon_F32Ratio(nvcTTY[entry], nvcAtlasH)
  u1 = neon_F32Ratio(nvcTTX[entry] + nvcTTW[entry], nvcAtlasW)
  v1 = neon_F32Ratio(nvcTTY[entry] + nvcTTH[entry], nvcAtlasH)
  nvcQuad(nvcVertices, left, top, left + nvcTTW[entry], top + nvcTTH[entry], u0, v0, u1, v1)
  nvcVertices = nvcVertices + 6
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

Procedure.i NeonVkChromeGridBaseline()
  ProcedureReturn nvcGridMetricBaseline
EndProcedure

; Flush only the vertices appended since the last flush, then advance the
; segment boundary. Empty style passes consume no Vulkan draw record.
Procedure.i NeonVkChromeGridBatchFlush(colour.i)
  Define count.i
  Define rc.i
  If nvcInFrame = 0 Or nvcGridBatchActive = 0 Or nvcGridBatchFirst > nvcVertices
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  count = nvcVertices - nvcGridBatchFirst
  If count = 0 : ProcedureReturn #NEON_VK_CHROME_OK : EndIf
  If (count % 6) <> 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
  rc = nvcDraw(nvcGridBatchFirst, count, colour)
  If rc = #NEON_VK_CHROME_OK : nvcGridBatchFirst = nvcVertices : EndIf
  ProcedureReturn rc
EndProcedure

Procedure.i NeonVkChromeGridBatchEnd()
  If nvcInFrame = 0 Or nvcGridBatchActive = 0 Or nvcGridBatchFirst <> nvcVertices
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  nvcGridBatchActive = 0 : nvcGridBatchFirst = nvcVertices
  nvcGridBatchSlot = -1 : nvcGridBatchGeneration = 0
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

Procedure.i NeonVkChromeVertexQuadCapacity()
  ProcedureReturn nvcMaxVertexQuads
EndProcedure

Procedure.i NeonVkChromeTrueTypeSize(pixelHeight.i)
  If pixelHeight < 1 Or pixelHeight > 512
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  nvcTTFontPixels = pixelHeight
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

; Optional per-Neon-face pixel-height override for the regular Neon_Text
; callback. Zero restores a live Neon_LineHeight(font) lookup, which tracks
; face scaling such as the touch keyboard. Direct TrueType callers continue
; to use NeonVkChromeTrueTypeSize/NeonVkChromeTrueTypeText unchanged.
Procedure.i NeonVkChromeFontHeightSet(font.i, pixelHeight.i)
  If font < 0 Or font > 3 Or pixelHeight < 0 Or pixelHeight > 512
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  nvcTTFontHeight[font] = pixelHeight
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

; Resolve the same size as NeonVkChromeText. Use Neon's raw bitmap line height
; for the scaled Mono face, so this remains safe when the measurement hook is
; active and cannot recurse through Neon_LineHeight.
Procedure.i nvcTTFontHeightFor(font.i)
  Define pixels.i
  If font < 0 Or font > 3 : ProcedureReturn 0 : EndIf
  If nvcTTFontHeight[font] > 0
    pixels = nvcTTFontHeight[font]
  ElseIf font = #NEON_FONT_MONO
    pixels = NeonBitmapLineHeight(font)
  Else
    pixels = AnvilTrueTypePixelHeight()
    If pixels < 1 : pixels = NeonBitmapLineHeight(font) : EndIf
  EndIf
  If pixels < 1 Or pixels > 512 : ProcedureReturn 0 : EndIf
  ProcedureReturn pixels
EndProcedure

; Owner prewarm callers use this to match per-face drawing exactly without
; confusing the TT pixel raster size with the widget line-box height.
Procedure.i NeonVkChromeFontPixelHeight(font.i)
  ProcedureReturn nvcTTFontHeightFor(font)
EndProcedure

; UTF-8 width with the same pair positioning used by the draw callback. This
; path is intentionally CPU-only: it does not rasterize or touch the atlas.
Procedure.i NeonVkChromeMeasureWidthFixed(font.i, *s)
  Define length.i, pixels.i, count.i, lines.i, measured.i
  If *s = 0 Or AnvilTrueTypeSlotSelected() < 0 Or AnvilTrueTypeSlotParserBound() = 0
    ProcedureReturn -1
  EndIf
  pixels = nvcTTFontHeightFor(font)
  If pixels < 1 Or AnvilTrueTypeMetricsOpenState() = 0 Or AnvilTrueTypeCmapOpenState() = 0
    ProcedureReturn -1
  EndIf
  While length < 4096 And PeekA(*s + length) <> 0 : length + 1 : Wend
  If length >= 4096 : ProcedureReturn -1 : EndIf
  If AnvilTrueTypeLayoutUtf8(*s, length, pixels, 0, pixels + 2, @nvcTTLayoutGlyph[0], @nvcTTLayoutX[0], @nvcTTLayoutY[0], @nvcTTLayoutAdvance[0], #ANVIL_TTL_ALIGN_LEFT, #NEON_VK_CHROME_TT_RUN_GLYPHS, @count, @lines, @measured) = 0
    ProcedureReturn -1
  EndIf
  ProcedureReturn measured
EndProcedure

Procedure.i NeonVkChromeMeasureWidth(font.i, *s)
  Define measured.i = NeonVkChromeMeasureWidthFixed(font, *s)
  If measured < 0 : ProcedureReturn -1 : EndIf
  If measured = 0 : ProcedureReturn 0 : EndIf
  ProcedureReturn (measured + 65535) / 65536
EndProcedure

Procedure.i NeonVkChromeMeasureLineHeight(font.i)
  Define pixels.i
  If AnvilTrueTypeSlotSelected() < 0 Or AnvilTrueTypeSlotParserBound() = 0
    ProcedureReturn -1
  EndIf
  pixels = nvcTTFontHeightFor(font)
  If pixels < 1 Or AnvilTrueTypeMetricsOpenState() = 0 : ProcedureReturn -1 : EndIf
  ProcedureReturn pixels + 2
EndProcedure

Procedure.i NeonVkChromeAtlasUploadCount()
  ProcedureReturn nvcAtlasUploadCount
EndProcedure

; Explicit whole-cache eviction is allowed only between frames. Callers that
; need a different resident set reset once, then prewarm every run needed by
; the upcoming frame before Begin; no queued quad can reference evicted texels.
Procedure.i NeonVkChromeTTCacheReset()
  If nvcReady = 0 Or nvcInFrame <> 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
  If nvcTTCacheClear() = 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
  ; The next warm call uploads the reset page and all newly packed glyphs once.
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

Procedure.i NeonVkChromeFrameRasterDelta()
  ProcedureReturn AnvilTrueTypeRasterCount() - nvcAtlasRasterCountAtFrame
EndProcedure

Procedure.i NeonVkChromeFrameUploadDelta()
  ProcedureReturn nvcAtlasUploadCount - nvcAtlasUploadAtFrame
EndProcedure

Procedure.i NeonVkChromeTTCacheHits()
  ProcedureReturn nvcTTCacheHits
EndProcedure

Procedure.i NeonVkChromeTTCacheMisses()
  ProcedureReturn nvcTTCacheMisses
EndProcedure

Procedure.i nvcTTRoundDiv(numerator.i, denominator.i)
  If numerator < 0 : ProcedureReturn -((0 - numerator + denominator / 2) / denominator) : EndIf
  ProcedureReturn (numerator + denominator / 2) / denominator
EndProcedure

Procedure.i nvcTTTextMapped(xQ16.i, yQ16.i, *s, colour.i, mapped.i, spaceW.i, spaceH.i, targetW.i, targetH.i, cameraXQ16.i, cameraYQ16.i, zoomQ16.i, ignoreCamera.i)
  Define length.i, i.i, slot.i, generation.i, entry.i, rc.i
  Define count.i, lines.i, measured.i, visible.i, originX.i, baseline.i, anchorX.i, anchorY.i, lineAscent.i, units.i, first.i, uv0.i, uv1.i, vv0.i, vv1.i
  Define leftQ16.i, topQ16.i, rightQ16.i, bottomQ16.i, centerXQ16.i, centerYQ16.i
  nvcTTErrorStage = 0 : nvcTTUnitsProbe = 0 : nvcTTCountProbe = 0
  nvcTTLinesProbe = 0 : nvcTTMeasuredProbe = 0 : nvcTTMetricsStateProbe = 0
  If nvcGridBatchActive <> 0 Or nvcBoxBatchActive <> 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
  If *s = 0 : ProcedureReturn #NEON_VK_CHROME_OK : EndIf
  If nvcTTDirty <> 0 : nvcTTErrorStage = 1 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
  slot = AnvilTrueTypeSlotSelected()
  If slot < 0 Or AnvilTrueTypeSlotParserBound() = 0 : nvcTTErrorStage = 2 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
  While length < 4096 And PeekA(*s + length) <> 0 : length + 1 : Wend
  If length >= 4096 : nvcTTErrorStage = 3 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY) : EndIf
  ; Match NeonVkChromeMeasureWidth: chrome text stays on one line at the
  ; framebuffer edge and lets the scissor clip its overflow.
  rc = AnvilTrueTypeLayoutUtf8(*s, length, nvcTTFontPixels, 0, nvcTTFontPixels + 2, @nvcTTLayoutGlyph[0], @nvcTTLayoutX[0], @nvcTTLayoutY[0], @nvcTTLayoutAdvance[0], #ANVIL_TTL_ALIGN_LEFT, #NEON_VK_CHROME_TT_RUN_GLYPHS, @count, @lines, @measured)
  nvcTTLayoutRc = rc
  nvcTTLayoutError = AnvilTrueTypeLayoutError()
  nvcTTCountProbe = count : nvcTTLinesProbe = lines : nvcTTMeasuredProbe = measured
  nvcTTMetricsStateProbe = AnvilTrueTypeMetricsOpenState()
  If rc = 0 Or count < 0 Or count > #NEON_VK_CHROME_TT_RUN_GLYPHS : nvcTTErrorStage = 4 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ATLAS) : EndIf
  generation = AnvilTrueTypeSlotGeneration(slot)
  units = AnvilTrueTypeUnitsPerEm()
  nvcTTUnitsProbe = units
  If units < 1 : nvcTTErrorStage = 7 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ATLAS) : EndIf
  lineAscent = (AnvilTrueTypeAscender() * nvcTTFontPixels) / units
  If mapped <> 0
    If spaceW < 1 Or spaceH < 1 Or targetW < 1 Or targetH < 1 Or spaceW > 8192 Or spaceH > 8192 Or targetW > 8192 Or targetH > 8192 Or zoomQ16 < 1 Or zoomQ16 > 1048576
      nvcTTErrorStage = 9 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
    EndIf
    If xQ16 < -1000000000000 Or xQ16 > 1000000000000 Or yQ16 < -1000000000000 Or yQ16 > 1000000000000 Or cameraXQ16 < -1000000000000 Or cameraXQ16 > 1000000000000 Or cameraYQ16 < -1000000000000 Or cameraYQ16 > 1000000000000
      nvcTTErrorStage = 9 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY)
    EndIf
    centerXQ16 = spaceW * 32768 : centerYQ16 = spaceH * 32768
  Else
    anchorX = xQ16 / 65536 : anchorY = yQ16 / 65536
  EndIf
  For i = 0 To count - 1
    entry = nvcTTCacheFind(slot, generation, nvcTTFontPixels, nvcTTLayoutGlyph[i])
    If entry < 0 : nvcTTErrorStage = 5 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY) : EndIf
    If nvcTTW[entry] > 0 And nvcTTH[entry] > 0
      visible + 1
      If mapped <> 0
        leftQ16 = xQ16 + nvcTTLayoutX[i] + nvcTTBearingX[entry] * 65536
        topQ16 = yQ16 + lineAscent * 65536 - nvcTTLayoutY[i] - nvcTTBearingY[entry] * 65536
        ; Snap each positioned ink origin before camera, as the desktop face does.
        leftQ16 = nvcTTRoundDiv(leftQ16, 65536) * 65536
        topQ16 = nvcTTRoundDiv(topQ16, 65536) * 65536
        If leftQ16 < -1000000000000 Or leftQ16 > 1000000000000 Or topQ16 < -1000000000000 Or topQ16 > 1000000000000
          nvcTTErrorStage = 9 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY)
        EndIf
        If ignoreCamera = 0
          leftQ16 = centerXQ16 + ((leftQ16 - cameraXQ16 - centerXQ16) * zoomQ16) / 65536
          topQ16 = centerYQ16 + ((topQ16 - cameraYQ16 - centerYQ16) * zoomQ16) / 65536
          rightQ16 = leftQ16 + nvcTTW[entry] * zoomQ16
          bottomQ16 = topQ16 + nvcTTH[entry] * zoomQ16
        Else
          rightQ16 = leftQ16 + nvcTTW[entry] * 65536
          bottomQ16 = topQ16 + nvcTTH[entry] * 65536
        EndIf
        If leftQ16 < -1000000000000 Or leftQ16 > 1000000000000 Or topQ16 < -1000000000000 Or topQ16 > 1000000000000 Or rightQ16 < -1000000000000 Or rightQ16 > 1000000000000 Or bottomQ16 < -1000000000000 Or bottomQ16 > 1000000000000
          nvcTTErrorStage = 9 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY)
        EndIf
        nvcTTMapX0Q8[i] = nvcTTRoundDiv(leftQ16 * targetW, spaceW * 256)
        nvcTTMapY0Q8[i] = nvcTTRoundDiv(topQ16 * targetH, spaceH * 256)
        nvcTTMapX1Q8[i] = nvcTTRoundDiv(rightQ16 * targetW, spaceW * 256)
        nvcTTMapY1Q8[i] = nvcTTRoundDiv(bottomQ16 * targetH, spaceH * 256)
        If nvcTTMapX0Q8[i] < -#NVC_SPRITE_Q8_LIMIT Or nvcTTMapX0Q8[i] > #NVC_SPRITE_Q8_LIMIT Or nvcTTMapY0Q8[i] < -#NVC_SPRITE_Q8_LIMIT Or nvcTTMapY0Q8[i] > #NVC_SPRITE_Q8_LIMIT Or nvcTTMapX1Q8[i] < -#NVC_SPRITE_Q8_LIMIT Or nvcTTMapX1Q8[i] > #NVC_SPRITE_Q8_LIMIT Or nvcTTMapY1Q8[i] < -#NVC_SPRITE_Q8_LIMIT Or nvcTTMapY1Q8[i] > #NVC_SPRITE_Q8_LIMIT
          nvcTTErrorStage = 9 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY)
        EndIf
      EndIf
    EndIf
  Next
  If visible = 0 : ProcedureReturn #NEON_VK_CHROME_OK : EndIf
  If nvcDrawCount >= nvcMaxQuads Or nvcVertices + visible * 6 > nvcMaxVertexQuads * 6
    nvcTTErrorStage = 6 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY)
  EndIf
  first = nvcVertices
  For i = 0 To count - 1
    entry = nvcTTCacheFind(slot, generation, nvcTTFontPixels, nvcTTLayoutGlyph[i])
    If nvcTTW[entry] > 0 And nvcTTH[entry] > 0
      uv0 = neon_F32Ratio(nvcTTX[entry], nvcAtlasW)
      uv1 = neon_F32Ratio(nvcTTX[entry] + nvcTTW[entry], nvcAtlasW)
      vv0 = neon_F32Ratio(nvcTTY[entry], nvcAtlasH)
      vv1 = neon_F32Ratio(nvcTTY[entry] + nvcTTH[entry], nvcAtlasH)
      If mapped <> 0
        nvcSpriteVertexQ8(nvcVertices + 0, nvcTTMapX0Q8[i], nvcTTMapY0Q8[i], uv0, vv0)
        nvcSpriteVertexQ8(nvcVertices + 1, nvcTTMapX0Q8[i], nvcTTMapY1Q8[i], uv0, vv1)
        nvcSpriteVertexQ8(nvcVertices + 2, nvcTTMapX1Q8[i], nvcTTMapY1Q8[i], uv1, vv1)
        nvcSpriteVertexQ8(nvcVertices + 3, nvcTTMapX0Q8[i], nvcTTMapY0Q8[i], uv0, vv0)
        nvcSpriteVertexQ8(nvcVertices + 4, nvcTTMapX1Q8[i], nvcTTMapY1Q8[i], uv1, vv1)
        nvcSpriteVertexQ8(nvcVertices + 5, nvcTTMapX1Q8[i], nvcTTMapY0Q8[i], uv1, vv0)
      Else
        originX = anchorX + nvcTTFixed16Floor(nvcTTLayoutX[i])
        baseline = anchorY + lineAscent - nvcTTFixed16Floor(nvcTTLayoutY[i])
        nvcQuad(nvcVertices, originX + nvcTTBearingX[entry], baseline - nvcTTBearingY[entry], originX + nvcTTBearingX[entry] + nvcTTW[entry], baseline - nvcTTBearingY[entry] + nvcTTH[entry], uv0, vv0, uv1, vv1)
      EndIf
      nvcVertices + 6
    EndIf
  Next
  If visible = 0 : ProcedureReturn #NEON_VK_CHROME_OK : EndIf
  rc = nvcDraw(first, visible * 6, colour)
  If rc <> #NEON_VK_CHROME_OK : nvcTTErrorStage = 8 : EndIf
  ProcedureReturn rc
EndProcedure

Procedure.i nvcTTText(x.i, y.i, *s, colour.i)
  ProcedureReturn nvcTTTextMapped(x * 65536, y * 65536, *s, colour, 0, 1, 1, 1, 1, 0, 0, 65536, 1)
EndProcedure

; Apply canvas and camera geometry to each already-positioned TrueType glyph.
; The atlas raster size and source-space advances remain unchanged.
Procedure.i NeonVkChromeTextMapped(font.i, xQ16.i, yQ16.i, *s, colour.i, spaceW.i, spaceH.i, targetW.i, targetH.i, cameraXQ16.i, cameraYQ16.i, zoomQ16.i, ignoreCamera.i)
  If nvcInFrame = 0 Or font < 0 Or font > 3 Or spaceW < 1 Or spaceH < 1 Or targetW < 1 Or targetH < 1 Or zoomQ16 < 1
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS)
  EndIf
  nvcTTFontPixels = nvcTTFontHeightFor(font)
  If nvcTTFontPixels < 1 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ATLAS) : EndIf
  ProcedureReturn nvcTTTextMapped(xQ16, yQ16, *s, colour, 1, spaceW, spaceH, targetW, targetH, cameraXQ16, cameraYQ16, zoomQ16, ignoreCamera)
EndProcedure

Procedure.i NeonVkChromeTrueTypeText(pixelHeight.i, x.i, y.i, *s, colour.i)
  If nvcInFrame = 0 Or nvcGridBatchActive <> 0 Or nvcBoxBatchActive <> 0 Or pixelHeight < 1 Or pixelHeight > 512
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  nvcTTFontPixels = pixelHeight
  ProcedureReturn nvcTTText(x, y, *s, colour)
EndProcedure

; One NUL-terminated Neon text call becomes one ordered Vulkan draw containing
; every supported glyph quad, including the transparent atlas cell for space.
Procedure.i NeonVkChromeText(font.i, x.i, y.i, *s, colour.i)
  Define uv.NeonAtlasGlyphUV
  Define i.i
  Define ch.i
  Define cx.i
  Define first.i
  Define count.i
  Define glyphCount.i
  Define adv.i
  Define cellH.i
  If nvcInFrame = 0 Or nvcGridBatchActive <> 0 Or nvcBoxBatchActive <> 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
  If *s = 0 : ProcedureReturn #NEON_VK_CHROME_OK : EndIf
  If AnvilTrueTypeSlotSelected() < 0 And Neon_AtlasRasterGeneration() <> nvcAtlasGeneration
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ATLAS)
  EndIf
  If AnvilTrueTypeSlotSelected() >= 0
    If font < 0 Or font > 3 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ARGS) : EndIf
    nvcTTFontPixels = nvcTTFontHeightFor(font)
    If nvcTTFontPixels < 1 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ATLAS) : EndIf
    ProcedureReturn nvcTTText(x, y, *s, colour)
  EndIf
  adv = Neon_CharWidth(font) : cellH = Neon_LineHeight(font)
  If adv < 1 Or cellH < 1 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ATLAS) : EndIf
  ; Count the complete immutable run first. A capacity refusal must not leave
  ; half a string in reusable storage or advance either ordered cursor.
  i = 0
  While i < 4096
    ch = PeekA(*s + i)
    If ch = 0 : Break : EndIf
    If ch >= 32 And ch <> 127
      If ch >= Neon_AtlasRasterFirstGlyph() And ch <= Neon_AtlasRasterLastGlyph()
        glyphCount = glyphCount + 1
      EndIf
    EndIf
    i = i + 1
  Wend
  If glyphCount = 0 : ProcedureReturn #NEON_VK_CHROME_OK : EndIf
  If nvcDrawCount >= nvcMaxQuads Or nvcVertices + glyphCount * 6 > nvcMaxVertexQuads * 6
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY)
  EndIf
  first = nvcVertices : cx = x : i = 0
  While i < 4096
    ch = PeekA(*s + i)
    If ch = 0 : Break : EndIf
    If ch >= 32 And ch <> 127
      If Neon_AtlasRasterGlyphUV(ch, @uv) <> 0
        If nvcAtlasMapBitmapUV(@uv, NeonBitmapFontBold(font)) = 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ATLAS) : EndIf
        nvcQuad(nvcVertices, cx, y, cx + adv, y + cellH, uv\left, uv\top, uv\right, uv\bottom)
        nvcVertices = nvcVertices + 6 : count = count + 6
      EndIf
      cx = cx + adv
    EndIf
    i = i + 1
  Wend
  If count = 0 : ProcedureReturn #NEON_VK_CHROME_OK : EndIf
  ProcedureReturn nvcDraw(first, count, colour)
EndProcedure

; Consecutive boxes with one tint and scissor are one ordered triangle-list
; draw. This is opt-in so ordinary chrome draw counts remain unchanged.
Procedure.i NeonVkChromeBoxBatchBegin()
  If nvcInFrame = 0 Or nvcGridBatchActive <> 0 Or nvcBoxBatchActive <> 0 Or nvcPathKind <> #NVC_PATH_NONE
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  If nvcDrawCount >= nvcMaxQuads : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY) : EndIf
  nvcBoxBatchActive = 1 : nvcBoxBatchFirst = nvcVertices : nvcBoxBatchCount = 0
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

Procedure.i NeonVkChromeBoxBatchEnd()
  Define count.i, first.i, colour.i
  If nvcInFrame = 0 Or nvcBoxBatchActive = 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
  count = nvcBoxBatchCount : first = nvcBoxBatchFirst : colour = nvcBoxBatchColour
  nvcBoxBatchActive = 0 : nvcBoxBatchCount = 0
  If count = 0 : ProcedureReturn #NEON_VK_CHROME_OK : EndIf
  ProcedureReturn nvcDraw(first, count, colour)
EndProcedure

; The public textured-text primitive has native bitmap metrics and rejection
; rules. Preflight the visible run before touching the ordered vertex cursor.
Procedure.i NeonVkChromeTextTex(font.i, x.i, y.i, *s, colour.i)
  Define uv.NeonAtlasGlyphUV
  Define i.i, ch.i, cx.i, adv.i, cellH.i
  Define glyphCount.i, first.i, count.i, visible.i
  If nvcInFrame = 0 Or nvcGridBatchActive <> 0 Or nvcBoxBatchActive <> 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
  If *s = 0 Or Neon_A(colour) = 0 : ProcedureReturn #NEON_VK_CHROME_OK : EndIf
  If Neon_AtlasRasterReady() = 0 Or Neon_AtlasRasterGeneration() <> nvcAtlasGeneration
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ATLAS)
  EndIf
  adv = Neon_CharWidth(font) : cellH = Neon_LineHeight(font)
  If adv < 1 Or cellH < 1 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ATLAS) : EndIf
  If (y + cellH) <= 0 Or y >= nvcHeight : ProcedureReturn #NEON_VK_CHROME_OK : EndIf
  If neon_clipOn <> 0
    If (y + cellH) <= neon_clipY Or y >= (neon_clipY + neon_clipH) : ProcedureReturn #NEON_VK_CHROME_OK : EndIf
  EndIf
  cx = x : i = 0
  While i < 4096
    ch = PeekA(*s + i)
    If ch = 0 : Break : EndIf
    If ch >= 32 And ch <> 127
      If ch >= Neon_AtlasRasterFirstGlyph() And ch <= Neon_AtlasRasterLastGlyph()
        visible = 0
        If (cx + adv) > 0 And cx < nvcWidth
          If neon_clipOn = 0 : visible = 1
          ElseIf (cx + adv) > neon_clipX And cx < (neon_clipX + neon_clipW) : visible = 1
          EndIf
        EndIf
        If visible <> 0 : glyphCount = glyphCount + 1 : EndIf
      EndIf
      cx = cx + adv
    EndIf
    i = i + 1
  Wend
  If glyphCount = 0 : ProcedureReturn #NEON_VK_CHROME_OK : EndIf
  If nvcDrawCount >= nvcMaxQuads Or nvcVertices + glyphCount * 6 > nvcMaxVertexQuads * 6
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY)
  EndIf
  first = nvcVertices : cx = x : i = 0
  While i < 4096
    ch = PeekA(*s + i)
    If ch = 0 : Break : EndIf
    If ch >= 32 And ch <> 127
      visible = 0
      If (cx + adv) > 0 And cx < nvcWidth
        If neon_clipOn = 0 : visible = 1
        ElseIf (cx + adv) > neon_clipX And cx < (neon_clipX + neon_clipW) : visible = 1
        EndIf
      EndIf
      If visible <> 0 And Neon_AtlasRasterGlyphUV(ch, @uv) <> 0
        If nvcAtlasMapBitmapUV(@uv, 0) = 0 : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_ATLAS) : EndIf
        nvcQuad(nvcVertices, cx, y, cx + adv, y + cellH, uv\left, uv\top, uv\right, uv\bottom)
        nvcVertices = nvcVertices + 6 : count = count + 6
      EndIf
      cx = cx + adv
    EndIf
    i = i + 1
  Wend
  If count = 0 : ProcedureReturn #NEON_VK_CHROME_OK : EndIf
  ProcedureReturn nvcDraw(first, count, colour)
EndProcedure

; Fan and line builders retain only bounded logical points. End performs one
; complete capacity preflight, writes triangle-list geometry, then appends one
; ordered Vulkan draw. FanOutline deliberately keeps the fan cursor alive so
; the existing outline-then-fill call order reuses the same logical points.
Procedure.i NeonVkChromeFanBegin()
  If nvcInFrame = 0 Or nvcGridBatchActive <> 0 Or nvcBoxBatchActive <> 0 Or nvcPathKind <> #NVC_PATH_NONE
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  nvcPathKind = #NVC_PATH_FAN : nvcPathCount = 0 : nvcPathError = 0
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

Procedure NeonVkChromeFanPoint(x.i, y.i)
  If nvcPathKind <> #NVC_PATH_FAN
    nvcPathError = #NEON_VK_CHROME_ERR_STATE
    nvcFail(nvcPathError)
    ProcedureReturn
  EndIf
  If nvcPathCount >= #NEON_VK_CHROME_MAX_PATH_POINTS
    nvcPathError = #NEON_VK_CHROME_ERR_CAPACITY
    nvcFail(nvcPathError)
    ProcedureReturn
  EndIf
  nvcPathX[nvcPathCount] = x : nvcPathY[nvcPathCount] = y
  nvcPathCount = nvcPathCount + 1
EndProcedure

Procedure.i NeonVkChromeFanOutline(colour.i)
  Define first.i
  Define needed.i
  Define i.i
  Define j.i
  If nvcPathKind <> #NVC_PATH_FAN : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
  If nvcPathError <> 0 : ProcedureReturn nvcPathError : EndIf
  If nvcPathCount < 2 : ProcedureReturn #NEON_VK_CHROME_OK : EndIf
  needed = nvcPathCount * 6
  If nvcDrawCount >= nvcMaxQuads Or nvcVertices + needed > nvcMaxVertexQuads * 6
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_CAPACITY)
  EndIf
  first = nvcVertices : i = 0
  While i < nvcPathCount
    j = i + 1 : If j = nvcPathCount : j = 0 : EndIf
    nvcLineQuad(nvcPathX[i], nvcPathY[i], nvcPathX[j], nvcPathY[j])
    nvcVertices = nvcVertices + 6 : i = i + 1
  Wend
  ProcedureReturn nvcDraw(first, needed, colour)
EndProcedure

Procedure.i NeonVkChromeFanEnd(colour.i)
  Define first.i
  Define needed.i
  Define i.i
  Define rc.i
  If nvcPathKind <> #NVC_PATH_FAN : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
  If nvcPathError <> 0
    rc = nvcPathError
  ElseIf nvcPathCount < 3
    rc = #NEON_VK_CHROME_OK
  Else
    needed = (nvcPathCount - 2) * 3
    If nvcDrawCount >= nvcMaxQuads Or nvcVertices + needed > nvcMaxVertexQuads * 6
      rc = nvcFail(#NEON_VK_CHROME_ERR_CAPACITY)
    Else
      first = nvcVertices : i = 1
      While i < nvcPathCount - 1
        nvcSolidTriangle(nvcVertices, nvcPathX[0], nvcPathY[0], nvcPathX[i], nvcPathY[i], nvcPathX[i + 1], nvcPathY[i + 1])
        nvcVertices = nvcVertices + 3 : i = i + 1
      Wend
      rc = nvcDraw(first, needed, colour)
    EndIf
  EndIf
  nvcPathKind = #NVC_PATH_NONE : nvcPathCount = 0 : nvcPathError = 0
  ProcedureReturn rc
EndProcedure

Procedure.i NeonVkChromeLinesBegin()
  If nvcInFrame = 0 Or nvcGridBatchActive <> 0 Or nvcBoxBatchActive <> 0 Or nvcPathKind <> #NVC_PATH_NONE
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  nvcPathKind = #NVC_PATH_LINES : nvcPathCount = 0 : nvcPathError = 0
  ProcedureReturn #NEON_VK_CHROME_OK
EndProcedure

Procedure NeonVkChromeLine(x0.i, y0.i, x1.i, y1.i)
  If nvcPathKind <> #NVC_PATH_LINES
    nvcPathError = #NEON_VK_CHROME_ERR_STATE
    nvcFail(nvcPathError)
    ProcedureReturn
  EndIf
  If nvcPathCount + 2 > #NEON_VK_CHROME_MAX_PATH_POINTS
    nvcPathError = #NEON_VK_CHROME_ERR_CAPACITY
    nvcFail(nvcPathError)
    ProcedureReturn
  EndIf
  nvcPathX[nvcPathCount] = x0 : nvcPathY[nvcPathCount] = y0
  nvcPathX[nvcPathCount + 1] = x1 : nvcPathY[nvcPathCount + 1] = y1
  nvcPathCount = nvcPathCount + 2
EndProcedure

Procedure.i NeonVkChromeLinesEnd(colour.i)
  Define first.i
  Define needed.i
  Define i.i
  Define rc.i
  If nvcPathKind <> #NVC_PATH_LINES : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
  If nvcPathError <> 0
    rc = nvcPathError
  ElseIf nvcPathCount < 2
    rc = #NEON_VK_CHROME_OK
  Else
    needed = (nvcPathCount / 2) * 6
    If nvcDrawCount >= nvcMaxQuads Or nvcVertices + needed > nvcMaxVertexQuads * 6
      rc = nvcFail(#NEON_VK_CHROME_ERR_CAPACITY)
    Else
      first = nvcVertices : i = 0
      While i < nvcPathCount
        nvcLineQuad(nvcPathX[i], nvcPathY[i], nvcPathX[i + 1], nvcPathY[i + 1])
        nvcVertices = nvcVertices + 6 : i = i + 2
      Wend
      rc = nvcDraw(first, needed, colour)
    EndIf
  EndIf
  nvcPathKind = #NVC_PATH_NONE : nvcPathCount = 0 : nvcPathError = 0
  ProcedureReturn rc
EndProcedure

; Vulkan scissors use framebuffer coordinates. Legal negative/out-of-bounds
; rectangles are intersected in signed 64-bit arithmetic, preventing x+w
; overflow; an empty intersection becomes the Vulkan zero-size collapse.
Procedure NeonVkChromeScissorSet(x.i, y.i, w.i, h.i)
  Define x0.q : Define y0.q : Define spanX.q : Define spanY.q
  If nvcBoxBatchActive <> 0
    nvcFail(#NEON_VK_CHROME_ERR_STATE)
    ProcedureReturn
  EndIf
  x0 = x : y0 = y : spanX = w : spanY = h
  If w <= 0 Or h <= 0
    nvcClipX = 0 : nvcClipY = 0 : nvcClipW = 0 : nvcClipH = 0
    ProcedureReturn
  EndIf
  ; Clip negative origins by subtracting from the positive span before doing
  ; any endpoint addition. This stays defined even for hostile INT64 extrema.
  If x0 < 0
    If x0 <= (0 - spanX) : spanX = 0 : Else : spanX = spanX + x0 : EndIf
    x0 = 0
  EndIf
  If y0 < 0
    If y0 <= (0 - spanY) : spanY = 0 : Else : spanY = spanY + y0 : EndIf
    y0 = 0
  EndIf
  If x0 >= nvcWidth Or y0 >= nvcHeight Or spanX <= 0 Or spanY <= 0
    nvcClipX = 0 : nvcClipY = 0 : nvcClipW = 0 : nvcClipH = 0
  Else
    If spanX > (nvcWidth - x0) : spanX = nvcWidth - x0 : EndIf
    If spanY > (nvcHeight - y0) : spanY = nvcHeight - y0 : EndIf
    If nvcRotation = 90
      nvcClipX = nvcLogicalH - (y0 + spanY) : nvcClipY = x0
      nvcClipW = spanY : nvcClipH = spanX
    ElseIf nvcRotation = 180
      nvcClipX = nvcLogicalW - (x0 + spanX) : nvcClipY = nvcLogicalH - (y0 + spanY)
      nvcClipW = spanX : nvcClipH = spanY
    ElseIf nvcRotation = 270
      nvcClipX = y0 : nvcClipY = nvcLogicalW - (x0 + spanX)
      nvcClipW = spanY : nvcClipH = spanX
    Else
      nvcClipX = x0 : nvcClipY = y0 : nvcClipW = spanX : nvcClipH = spanY
    EndIf
  EndIf
EndProcedure

Procedure NeonVkChromeScissorClear()
  If nvcBoxBatchActive <> 0
    nvcFail(#NEON_VK_CHROME_ERR_STATE)
    ProcedureReturn
  EndIf
  nvcClipX = 0 : nvcClipY = 0 : nvcClipW = nvcPhysicalW : nvcClipH = nvcPhysicalH
EndProcedure

Procedure.i NeonVkChromeEnd()
  Define rc.i
  If nvcReady = 0 Or nvcInFrame = 0 Or nvcGridBatchActive <> 0 Or nvcBoxBatchActive <> 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  ; The current backend requires at least one draw in a render pass. An empty
  ; chrome frame still owns a clear/present transaction, so record one fully
  ; transparent quad; blending makes it a visual no-op.
  If nvcDrawCount = 0
    rc = NeonVkChromeBox(0, 0, nvcWidth, nvcHeight, 0)
  EndIf
  vkCmdEndRenderPass(nvcCommand)
  If nvcMapped <> 0
    vkUnmapMemory(nvcDevice, nvcVertexMemory) : nvcMapped = 0
  EndIf
  nvcSubmitStage = 1 : nvcSubmitRc = rc
  If rc = #VK_SUCCESS : rc = vkEndCommandBuffer(nvcCommand) : nvcSubmitRc = rc : EndIf
  If rc = #VK_SUCCESS : rc = nvcSubmitAndWait() : EndIf
  nvcInFrame = 0
  If rc <> #VK_SUCCESS : ProcedureReturn nvcFail(rc) : EndIf
  nvcNextFrameSequence = nvcNextFrameSequence + 1
  If nvdWsiEnabled() <> 0
    If nvdWsiMarkReady() <> #VK_SUCCESS : nvdWsiRollback() : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
    If nvdWsiReserve() <> #VK_SUCCESS : nvdWsiRollback() : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
    If nvdWsiCommit() <> #VK_SUCCESS : nvdWsiRollback() : ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE) : EndIf
  EndIf
  If nvdPresentPublish(nvcTargetGeneration, nvcFramebuffer, nvcNextFrameSequence, nvcLogicalW, nvcLogicalH, nvcPhysicalW, nvcPhysicalH, nvcPitch, nvcRotation) = 0
    If nvdWsiEnabled() <> 0 : nvdWsiRollback() : EndIf
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  ProcedureReturn #VK_SUCCESS
EndProcedure

; Discard only an unsubmitted frame, including a failed End before QueueSubmit.
; A queue-submit attempt clears nvcFrameAbortable before it can be ambiguous.
Procedure.i NeonVkChromeAbort()
  Define rc.i
  If nvcReady = 0 Or nvcFrameAbortable = 0 Or nvcCommand = 0
    ProcedureReturn nvcFail(#NEON_VK_CHROME_ERR_STATE)
  EndIf
  rc = vkResetCommandBuffer(nvcCommand, 0)
  If rc <> #VK_SUCCESS : ProcedureReturn nvcFail(rc) : EndIf
  If nvcMapped <> 0
    vkUnmapMemory(nvcDevice, nvcVertexMemory) : nvcMapped = 0
  EndIf
  nvcInFrame = 0 : nvcFrameAbortable = 0
  nvcVertices = 0 : nvcExternalVertices = 0 : nvcDrawCount = 0
  nvcGridBatchActive = 0 : nvcBoxBatchActive = 0
  nvcGridBatchFirst = 0 : nvcBoxBatchFirst = 0 : nvcBoxBatchCount = 0
  nvcRetainedBatchActive = 0 : nvcRetainedBatchCount = 0
  nvcPathKind = #NVC_PATH_NONE : nvcPathCount = 0 : nvcPathError = 0
  nvcSubmitStage = 0 : nvcSubmitRc = #VK_SUCCESS
  nvcError = 0
  ProcedureReturn #VK_SUCCESS
EndProcedure

Procedure NeonVkChromeDestroy()
  Define cmd.i, slot.i
  Define idleRc.i
  If nvcExternalProducerAttached <> 0 Or nvcExternalProducerQuarantined <> 0
    nvcFail(#NEON_VK_CHROME_ERR_STATE)
    ProcedureReturn
  EndIf
  nvdWsiRollback()
  nvdPresentClear()
  nvcBoxBatchActive = 0 : nvcBoxBatchCount = 0
  nvcRetainedBatchActive = 0 : nvcRetainedBatchCount = 0
  If nvcHooksInstalled <> 0
    NeonDrawBackendClear()
    nvcHooksInstalled = 0
  EndIf
  If nvcMapped <> 0 And nvcDevice <> 0 And nvcVertexMemory <> 0
    vkUnmapMemory(nvcDevice, nvcVertexMemory)
  EndIf
  nvcMapped = 0 : nvcInFrame = 0 : nvcFrameAbortable = 0 : nvcReady = 0
  nvcPathKind = #NVC_PATH_NONE : nvcPathCount = 0 : nvcPathError = 0
  If nvcDevice <> 0
    idleRc = vkDeviceWaitIdle(nvcDevice)
    If idleRc <> #VK_SUCCESS
      nvcFail(idleRc)
      ProcedureReturn
    EndIf
    If nvcImageSpritePendingStage <> 0 : vkDestroyBuffer(nvcDevice, nvcImageSpritePendingStage, 0) : EndIf
    If nvcImageSpritePendingStageMemory <> 0 : vkFreeMemory(nvcDevice, nvcImageSpritePendingStageMemory, 0) : EndIf
    nvcImageSpriteRelease(nvcImageSpritePendingSet, nvcImageSpritePendingView, nvcImageSpritePendingImage, nvcImageSpritePendingMemory)
    nvcImageSpriteRelease(nvcImageSpriteSet, nvcImageSpriteView, nvcImageSpriteImage, nvcImageSpriteMemory)
    nvcParticlePaletteRelease()
    For slot = 2 To #NVC_MULTI_SPRITE_MAX
      nvcImageSpriteRelease(nvcImageSpriteSets[slot], nvcImageSpriteViews[slot], nvcImageSpriteImages[slot], nvcImageSpriteMemories[slot])
    Next
    If nvcPipeline <> 0 : vkDestroyPipeline(nvcDevice, nvcPipeline, 0) : EndIf
    If nvcPipelineLayout <> 0 : vkDestroyPipelineLayout(nvcDevice, nvcPipelineLayout, 0) : EndIf
    If nvcDescriptorPool <> 0 : vkDestroyDescriptorPool(nvcDevice, nvcDescriptorPool, 0) : EndIf
    If nvcSetLayout <> 0 : vkDestroyDescriptorSetLayout(nvcDevice, nvcSetLayout, 0) : EndIf
    If nvcSampler <> 0 : vkDestroySampler(nvcDevice, nvcSampler, 0) : EndIf
    If nvcAtlasView <> 0 : vkDestroyImageView(nvcDevice, nvcAtlasView, 0) : EndIf
    If nvcAtlasUploadMapped <> 0 And nvcUploadMemory <> 0
      vkUnmapMemory(nvcDevice, nvcUploadMemory) : nvcAtlasUploadMapped = 0
    EndIf
    If nvcUploadBuffer <> 0 : vkDestroyBuffer(nvcDevice, nvcUploadBuffer, 0) : EndIf
    If nvcUploadMemory <> 0 : vkFreeMemory(nvcDevice, nvcUploadMemory, 0) : EndIf
    If nvcAtlasImage <> 0 : vkDestroyImage(nvcDevice, nvcAtlasImage, 0) : EndIf
    If nvcAtlasMemory <> 0 : vkFreeMemory(nvcDevice, nvcAtlasMemory, 0) : EndIf
    If nvcUniformBuffer <> 0 : vkDestroyBuffer(nvcDevice, nvcUniformBuffer, 0) : EndIf
    If nvcUniformMemory <> 0 : vkFreeMemory(nvcDevice, nvcUniformMemory, 0) : EndIf
    If nvcVertexBuffer <> 0 : vkDestroyBuffer(nvcDevice, nvcVertexBuffer, 0) : EndIf
    If nvcVertexMemory <> 0 : vkFreeMemory(nvcDevice, nvcVertexMemory, 0) : EndIf
    If nvcFence <> 0 : vkDestroyFence(nvcDevice, nvcFence, 0) : EndIf
    If nvcCommand <> 0 And nvcCommandPool <> 0
      cmd = nvcCommand
      vkFreeCommandBuffers(nvcDevice, nvcCommandPool, 1, @cmd)
    EndIf
  EndIf
  nvcCommand = 0 : nvcFence = 0 : nvcPipeline = 0 : nvcPipelineLayout = 0
  nvcDescriptorSet = 0 : nvcDescriptorPool = 0 : nvcSetLayout = 0
  nvcImageSpriteSet = 0 : nvcImageSpriteView = 0 : nvcImageSpriteImage = 0 : nvcImageSpriteMemory = 0
  nvcImageSpriteW = 0 : nvcImageSpriteH = 0 : nvcImageSpriteGeneration = 0
  For slot = 2 To #NVC_MULTI_SPRITE_MAX
    nvcImageSpriteSets[slot] = 0 : nvcImageSpriteViews[slot] = 0
    nvcImageSpriteImages[slot] = 0 : nvcImageSpriteMemories[slot] = 0
    nvcImageSpriteWidths[slot] = 0 : nvcImageSpriteHeights[slot] = 0
    nvcImageSpriteGenerations[slot] = 0
  Next
  nvcImageSpritePendingImage = 0 : nvcImageSpritePendingMemory = 0 : nvcImageSpritePendingView = 0 : nvcImageSpritePendingSet = 0
  nvcImageSpritePendingStage = 0 : nvcImageSpritePendingStageMemory = 0
  nvcParticleImage = 0 : nvcParticleMemory = 0 : nvcParticleView = 0 : nvcParticleSet = 0
  nvcParticleStage = 0 : nvcParticleStageMemory = 0 : nvcParticleMapped = 0
  nvcParticleCount = 0 : nvcParticlePrepared = 0
  nvcParticleUploaded = 0 : nvcParticleStageSafe = 0
  nvcParticleTargetGeneration = 0 : nvcParticleLogicalW = 0 : nvcParticleLogicalH = 0
  nvcSampler = 0 : nvcAtlasView = 0 : nvcAtlasImage = 0 : nvcAtlasMemory = 0
  nvcUploadBuffer = 0 : nvcUploadMemory = 0
  nvcUniformBuffer = 0 : nvcUniformMemory = 0 : nvcVertexBuffer = 0 : nvcVertexMemory = 0
  nvcPhysical = 0 : nvcDevice = 0 : nvcQueue = 0 : nvcCommandPool = 0
  nvcRenderPass = 0 : nvcFramebuffer = 0 : nvcWidth = 0 : nvcHeight = 0
  nvcLogicalW = 0 : nvcLogicalH = 0 : nvcPhysicalW = 0 : nvcPhysicalH = 0 : nvcPitch = 0 : nvcRotation = 0
  nvcViewportX = 0 : nvcViewportY = 0 : nvcViewportW = 0 : nvcViewportH = 0
  nvcMaxQuads = 0 : nvcMaxVertexQuads = 0 : nvcVertices = 0 : nvcExternalVertices = 0 : nvcDrawCount = 0
  nvcGridBatchActive = 0 : nvcGridBatchFirst = 0 : nvcGridBatchSlot = -1 : nvcGridBatchGeneration = 0
  nvcAtlasW = 0 : nvcAtlasH = 0 : nvcAtlasBaseW = 0 : nvcAtlasBaseH = 0 : nvcAtlasBytes = 0
  nvcAtlasUploadMapped = 0 : nvcAtlasUploadCount = 0 : nvcAtlasUploadAtFrame = 0 : nvcAtlasRasterCountAtFrame = 0
  nvcAtlasPartialUploadCount = 0 : nvcAtlasFullUploadCount = 0 : nvcAtlasLastUploadBytes = 0
  nvcAtlasGeneration = 0 : nvcAtlasFaulted = 0
  nvcTTCount = 0 : nvcTTDirty = 0 : nvcTTNextX = 32 : nvcTTNextY = 1 : nvcTTRowH = 0
  nvcTTForceFull = 0 : nvcTTDirtyRectValid = 0
  nvcTTDirtyLeft = 0 : nvcTTDirtyTop = 0 : nvcTTDirtyRight = 0 : nvcTTDirtyBottom = 0
  For slot = 0 To #NVC_TT_INDEX_SIZE - 1 : nvcTTIndex[slot] = 0 : Next
  nvcTTCacheHits = 0 : nvcTTCacheMisses = 0
  nvcTargetGeneration = 0
  nvcExternalProducerAttached = 0 : nvcExternalProducerQuarantined = 0
EndProcedure

; Optional public Neon lifecycle for a caller that already created Chrome
; against its own Vulkan device and target. The native V3D context remains the
; hardware executor underneath the Pi 4 Vulkan backend. The caller consumes
; each present intent and destroys its Vulkan objects after NeonShutdown;
; NeonLifecyclePreparedOwnerPending then names the returned native context.
Procedure.i nvcLifecycleInit()
  If nvcReady = 0 Or nvcInFrame <> 0 Or nvcHooksInstalled = 0 Or NeonDrawBackendActive() = 0 Or NeonVkChromePresentPending() <> 0
    ProcedureReturn #NEON_ERR_BACKEND
  EndIf
  ProcedureReturn #NEON_OK
EndProcedure

Procedure.i nvcLifecycleBegin(colour.i)
  If nvcReady = 0 Or nvcInFrame <> 0 Or NeonVkChromePresentPending() <> 0
    ProcedureReturn #NEON_ERR_BACKEND
  EndIf
  nvcLifecycleClear[0] = neon_F32Ratio(Neon_R(colour), 255)
  nvcLifecycleClear[1] = neon_F32Ratio(Neon_G(colour), 255)
  nvcLifecycleClear[2] = neon_F32Ratio(Neon_B(colour), 255)
  nvcLifecycleClear[3] = neon_F32Ratio(Neon_A(colour), 255)
  If NeonVkChromeBegin(@nvcLifecycleClear[0]) <> #VK_SUCCESS
    ProcedureReturn #NEON_ERR_BACKEND
  EndIf
  ProcedureReturn #NEON_OK
EndProcedure

Procedure.i nvcLifecycleEnd()
  If nvcReady = 0 Or nvcInFrame = 0
    ProcedureReturn #NEON_ERR_BACKEND
  EndIf
  If NeonVkChromeEnd() <> #VK_SUCCESS Or NeonVkChromePresentPending() <> 1
    ProcedureReturn #NEON_ERR_BACKEND
  EndIf
  ProcedureReturn #NEON_OK
EndProcedure

Procedure.i nvcLifecycleShutdown()
  If nvcInFrame <> 0 : ProcedureReturn #NEON_ERR_BACKEND : EndIf
  If nvcExternalProducerAttached <> 0 Or nvcExternalProducerQuarantined <> 0 : ProcedureReturn #NEON_ERR_BACKEND : EndIf
  If nvcDevice <> 0 And vkDeviceWaitIdle(nvcDevice) <> #VK_SUCCESS
    ProcedureReturn #NEON_ERR_BACKEND
  EndIf
  NeonVkChromeDestroy()
  If nvcReady <> 0 Or NeonDrawBackendActive() <> 0 Or NeonVkChromePresentPending() <> 0
    ProcedureReturn #NEON_ERR_BACKEND
  EndIf
  ProcedureReturn #NEON_OK
EndProcedure

Procedure.i NeonVkChromeLifecycleInstallPrepared()
  If nvcReady = 0 Or nvcInFrame <> 0 Or nvcHooksInstalled = 0 Or NeonVkChromePresentPending() <> 0
    ProcedureReturn #NEON_ERR_BACKEND
  EndIf
  ProcedureReturn NeonLifecycleInstallPrepared(@nvcLifecycleInit, @nvcLifecycleBegin, @nvcLifecycleEnd, @nvcLifecycleShutdown)
EndProcedure

XIncludeFile "Anvil/Graphics/Vulkan/neon_vk_particles.pi4"
