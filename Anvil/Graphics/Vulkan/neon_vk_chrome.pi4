; neon_vk_chrome.pi4 - resident Neon chrome renderer over public Vulkan.
;
; Include after neon.pi4, vk_api.pbi, vk_spirv_fixtures.pbi and the active
; Vulkan backend.  This layer owns its Vulkan resources and command buffer,
; but not the caller's device, queue, command pool, render pass or framebuffer.
; Presentation remains a display/WSI decision: End publishes one present
; intent after its one successful frame submission, and the owner consumes it.
;
; NeonFrameBegin/NeonFrameEnd are deliberately never called here.  Create
; installs Neon's renderer-neutral primitive hooks only after every
; persistent resource and the CPU-atlas upload are complete.

#NEON_VK_CHROME_OK             = 0
#NEON_VK_CHROME_ERR_ARGS       = -21201
#NEON_VK_CHROME_ERR_STATE      = -21202
#NEON_VK_CHROME_ERR_CAPACITY   = -21203
#NEON_VK_CHROME_ERR_ATLAS      = -21204
#NEON_VK_CHROME_ERR_VULKAN     = -21205

#NEON_VK_CHROME_VERTEX_BYTES   = 24
#NEON_VK_CHROME_ATLAS_PAD      = 64
#NEON_VK_CHROME_MAX_QUADS      = 4096
#NEON_VK_CHROME_MAX_VERTICES   = #NEON_VK_CHROME_MAX_QUADS * 6
; Draw records remain capped at 4096. The resident console counts actual ink
; quads before each frame and reserves this vertex budget plus UI headroom.
; At the current 24-byte vertex stride this reserves 3,022,848 bytes.
#NEON_VK_CHROME_MAX_VERTEX_QUADS = 20992
#NEON_VK_CHROME_MAX_PATH_POINTS = 4096
#NEON_VK_CHROME_WAIT_NS        = 2000000000
#NEON_VK_CHROME_F_ONE          = $3F800000
#NVC_SPRITE_Q8_LIMIT           = 1500000
#NVC_SPRITE_TAU_Q16            = 411775
#NVC_SPRITE_PI_Q16             = 205887
#NVC_SPRITE_HALF_PI_Q16        = 102944
#NVC_SPRITE_MAX_ANGLE_Q16      = 6588400 ; sixteen signed turns
#NVC_MULTI_SPRITE_MAX          = 16
#NVC_RETAINED_BATCH_MAX        = 128
#NVC_PARTICLE_MAX              = 10000
#NVC_PARTICLE_PALETTE_W        = 128
#NVC_PARTICLE_PALETTE_H        = 80
#NVC_PARTICLE_PALETTE_BYTES    = #NVC_PARTICLE_PALETTE_W * #NVC_PARTICLE_PALETTE_H * 4
#NVC_PARTICLE_CLIP_CACHE       = 4096
#NVC_SPRITE_SHELF_H            = 256
#NEON_VK_CHROME_TT_ATLAS_W     = 512
; Keep the image and persistent staging buffer within the shared 16 MiB
; Vulkan heap alongside renderer targets, vertices, and backend state. A
; 512x1024 RGBA atlas uses 2 MiB for each of those two allocations.
; Larger targets may fail allocation cleanly if the board heap is insufficient.
#NEON_VK_CHROME_TT_ATLAS_H     = 1024
#NEON_VK_CHROME_TT_CACHE_MAX   = 512
#NVC_TT_INDEX_SIZE             = 1024
#NVC_TT_PARTIAL_MAX_TILES      = 256
#NEON_VK_CHROME_TT_COVERAGE    = 1048576
#NEON_VK_CHROME_TT_RUN_GLYPHS  = 4096

#NVC_PATH_NONE                 = 0
#NVC_PATH_FAN                  = 1
#NVC_PATH_LINES                = 2

; A retained batch keeps draw parameters, not image ownership. An image ID
; must keep the generation captured by Add until each End submission.
Structure NvcRetainedSprite
  id.i
  generation.i
  x.i
  y.i
  sourceX.i
  sourceY.i
  sourceW.i
  sourceH.i
  drawW.i
  drawH.i
  colour.i
  angleQ16.i
  cameraX.i
  cameraY.i
  zoomQ16.i
  ignoreCamera.i
EndStructure

; Colour is packed AARRGGBB. The active chrome scissor clips the batch.
Structure NvcParticle
  x.i
  y.i
  width.i
  height.i
  colour.i
  angleQ16.i
  cameraX.i
  cameraY.i
  zoomQ16.i
  ignoreCamera.i
EndStructure

; Two fixed corner banks keep the currently prepared frame intact while a
; new list is validated. Each record has four transformed Q8 corners.
Structure NvcParticleCorners
  x0.i : y0.i
  x1.i : y1.i
  x2.i : y2.i
  x3.i : y3.i
EndStructure


