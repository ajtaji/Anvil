; Fail-closed binding fixture: deliberately no operational production services.
Procedure.i ForumRegServicesReady() : ProcedureReturn 0 : EndProcedure
Procedure.i ForumRegNow() : ProcedureReturn 0 : EndProcedure
Procedure.i ForumRegCanonicalEmail(e.i) : ProcedureReturn 0 : EndProcedure
Procedure.i ForumRegRandomToken(n.i) : ProcedureReturn 0 : EndProcedure
Procedure.i ForumRegTokenDigest(t.i) : ProcedureReturn 0 : EndProcedure
Procedure.i ForumRegPasswordVerifier(p.i) : ProcedureReturn 0 : EndProcedure
Procedure.i ForumRegStoreChallenge(e.i, o.i, t.i, d.i, n.i, x.i) : ProcedureReturn -1 : EndProcedure
Procedure.i ForumRegAdmitRedeem(o.i, n.i) : ProcedureReturn 0 : EndProcedure
Procedure.i ForumRegConsumeAndCreate(d.i, v.i, o.i, n.i) : ProcedureReturn -1 : EndProcedure
Procedure ForumRegRelease(h.i) : EndProcedure
XIncludeFile "Anvil/Applications/Forum/registration.pbi"
Procedure.i Main()
  If ForumRegBegin(1, 1) <> #FORUM_REG_UNAVAILABLE : ProcedureReturn 1 : EndIf
  If ForumRegRedeem(1, 1, 1) <> #FORUM_REG_UNAVAILABLE : ProcedureReturn 2 : EndIf
  ProcedureReturn 0
EndProcedure
