EnableFloatingPoint
; Zentaji serial/storage monitor composition. The ROM loads the owned startup
; envelope; Main receives its validated table/source/context, never ARM registers.
#ANVIL_BUILD = 42 ; pmf:build
#ANVIL_BUILD_DATE = 20261111 ; pmf:builddate
#ANVIL_BUILD_TIME = 213343 ; pmf:buildtime
#CAP_TOUCH=0
#CAP_PWM=0
#CAP_NET=1
#ANVIL_ZENTAJI_NET=1
#CAP_STORAGE=1
#CAP_GPIO=0
#CAP_I2C=0
#CAP_MMC=0
