Procedure.i ZentajiModulesDown()
 Protected rec.i
 For rec=gModRecordCount-1 To 0 Step -1
  If gModRecState[rec]=#MOD_STATE_ACTIVE
   If ModUnload(rec)<>#MOD_OK : ModSayRefusal() : ProcedureReturn 0 : EndIf
  EndIf
 Next
 ProcedureReturn 1
EndProcedure
XIncludeFile "Zentaji/Board/kernel_boot.pbi"
