Procedure ZentajiShellHelp()
 PrintN("Anvil Zentaji commands:")
 PrintN("  version [full], map, echo [-n] <words>, sleep <seconds>, messages")
 PrintN("  mount, load, save, ls/dir, cat, mkdir, rmdir, rm/del, rename/mv")
 PrintN("  settings, printenv, setenv, saveenv, env, setexpr, time, force")
 PrintN("  memory/md, write/poke, fill/mw, copy/cp, compare/cmp, base, crc32/checksum")
 PrintN("  uptime/up, last run, reset/reboot")
 PrintN("  net, dhcp, ping <host>, dns <name>")
 PrintN("  forge [command]       built-in Zentaji PureMetal compiler and editor")
 PrintN("  halt                 cleanly release storage and stop this monitor")
 PrintN("  boot <file> / mem <address>, boot status/ok/clear")
 PrintN("PMF service-table applications are supported; raw run is not available.")
EndProcedure
Procedure.i HwCommandLoopHook(phase.i)
 If phase=#ACMD_BEFORE_PROMPT
  If ziInstalled<>0 And (ziUp=0 Or ZentajiInputHardwareOwned()=0) : ZentajiPayloadRecoveryFailed($5B06,"Prompt input failed (0x5B06): native input ownership changed.") : EndIf
  ZentajiInputPromptResume()
  UartScreenStyle(#UART_SCREEN_STYLE_PROMPT)
 EndIf
 If phase=#ACMD_AFTER_PROMPT
  If ZentajiNeonConsolePump()<>1 : ZentajiPayloadRecoveryFailed($5C01,"Console graphics failed (0x5C01): the prompt could not be presented.") : EndIf
  UartScreenStyle(#UART_SCREEN_STYLE_NORMAL)
  UartDrain()
  NetConsoleFlush() : NetConsoleCommandDone()
 EndIf
 If phase=#ACMD_AFTER_INPUT : NetConsoleCommandBegin() : EndIf
 If phase=#ACMD_AFTER_COMMAND And zenShellStop<>0 : ProcedureReturn 0 : EndIf
 ProcedureReturn 1
EndProcedure
Procedure.i HwCommandDispatch(c.i)
 If DispatchStorageCommand()<>0 : ProcedureReturn 1 : EndIf
 If WordIs("help")<>0 Or WordIs("commands")<>0 Or LetterIs(104)<>0 Or LetterIs(63)<>0
  ZentajiShellHelp()
 ElseIf WordIs("version")<>0 Or WordIs("ver")<>0
  CmdVersion()
 ElseIf WordIs("map")<>0
  CmdMap()
 ElseIf WordIs("memory")<>0 Or WordIs("dump")<>0 Or WordIs("md")<>0 Or LetterIs(109)<>0
  CmdMem()
 ElseIf WordIs("write")<>0 Or WordIs("poke")<>0 Or LetterIs(119)<>0
  CmdWrite()
 ElseIf WordIs("fill")<>0 Or WordIs("mw")<>0
  CmdFill()
 ElseIf WordIs("copy")<>0 Or WordIs("cp")<>0
  CmdCopy()
 ElseIf WordIs("compare")<>0 Or WordIs("cmp")<>0
  CmdCompare()
 ElseIf WordIs("base")<>0
  CmdBase()
 ElseIf WordIs("crc32")<>0 Or WordIs("checksum")<>0
  CmdCrc32()
 ElseIf WordIs("echo")<>0
  CmdEcho()
 ElseIf WordIs("sleep")<>0
  CmdSleep()
 ElseIf WordIs("messages")<>0
  CmdMessages()
 ElseIf WordIs("settings")<>0
  CmdSettings()
 ElseIf WordIs("printenv")<>0
  CmdEnvPrint()
 ElseIf WordIs("setenv")<>0
  CmdEnvSet()
 ElseIf WordIs("saveenv")<>0
  CmdSettingsSave()
 ElseIf WordIs("env")<>0
  CmdEnv()
 ElseIf WordIs("setexpr")<>0
  CmdSetexpr()
 ElseIf WordIs("time")<>0
  CmdTime()
 ElseIf WordIs("net")<>0
  ZentajiNetworkStatus()
 ElseIf WordIs("dhcp")<>0
  CmdDhcp()
 ElseIf WordIs("ping")<>0
  CmdPing()
 ElseIf WordIs("dns")<>0
  CmdDns()
 ElseIf WordIs("force")<>0
  CmdForce()
 ElseIf WordIs("boot")<>0
  CmdBoot()
 ElseIf WordIs("forge")<>0
  CmdZentajiForge()
 ElseIf WordIs("uptime")<>0 Or WordIs("up")<>0
  SkipSpace()
  If gLine[gPos]<>0
   PrintN("!! uptime takes no arguments.")
  Else
   Print("uptime ") : PrintDec(msg_Secs()) : PrintN(" boots ?")
  EndIf
 ElseIf WordIs("last")<>0
  SkipSpace()
  gWordAt=gPos : SkipWord() : gWordLen=gPos-gWordAt
  SkipSpace()
  If WordIs("run")<>0 And gLine[gPos]=0
   ZentajiLastRun()
  Else
   PrintN("!! last takes exactly one word: last run.")
  EndIf
 ElseIf WordIs("halt")<>0 Or WordIs("reset")<>0 Or WordIs("reboot")<>0
  SkipSpace()
  If gLine[gPos]<>0
   PrintN("!! halt and reset take no arguments. The monitor is still running.")
  ElseIf ZentajiStorageDown()=0
   UartWriteStr(ZentajiStorageErrorText()) : PrintNl()
  Else
   zenShellReset=Bool(WordIs("halt")=0)
   zenShellStop=1
  EndIf
 Else
  ProcedureReturn 0
 EndIf
 ProcedureReturn 1
EndProcedure
Procedure.i Main(table.i,source.i,context.i)
 Protected graphicsWidth.i,graphicsHeight.i,graphicsBytes.i,graphicsAvailable.i
 If ZentajiMemoryBind(context)<>1
  ZentajiPayloadRecoveryFailed($5B04,"Startup memory layout failed (0x5B04): check the owned context and increase RAM to leave at least 4KB for payload staging.")
  ProcedureReturn 1
 EndIf
 If table<>PeekQ(context+#ZEN_BOOT_TABLE) Or source<>PeekQ(context+#ZEN_BOOT_SOURCE) : ProcedureReturn 1 : EndIf
 ; Admit one display owner before settings or payload staging. Use the
 ; existing cell-text provider only when the fitted RAM cannot hold graphics.
 graphicsWidth=PeekQ(#ZEN_DISPLAY+$50) : graphicsHeight=PeekQ(#ZEN_DISPLAY+$58)
 If graphicsWidth>=64 And graphicsWidth<=8192 And graphicsHeight>=64 And graphicsHeight<=8192
  graphicsBytes=graphicsWidth*graphicsHeight*16+$1000000
  If PeekQ(#ZEN_DISPLAY+$B0)<>0
   ; Reserve resize headroom before payload admission. Three scanout planes
   ; and two targets allow failure-atomic replacement of the live attachment.
   graphicsBytes=graphicsWidth*graphicsHeight*20+$1000000
   graphicsAvailable=(zenMemoryStackBottom-zenMemoryPayload-4096)*3/4
   If graphicsAvailable>graphicsBytes : graphicsBytes=graphicsAvailable&-4096 : EndIf
  EndIf
  If graphicsBytes<=zenMemoryStackBottom-zenMemoryPayload-4096
   If ZentajiMemoryGraphicsInit(graphicsBytes)<>1 : ProcedureReturn 5 : EndIf
  EndIf
 EndIf
 If zenMemoryGraphicsBase=0
  ZentajiMemoryTextInit(table) : ZentajiTextServiceStart()
 EndIf
 ; This board owns core0's timer/IRQ routing. No other core is started here.
 PokeQ(#ZEN_IDLE_INTC+$120,3) : PokeQ(#ZEN_IDLE_INTC+$220,3)
 PokeQ(#ZEN_IDLE_INTC+$228,1) : PokeQ(#ZEN_IDLE_INTC+$F008,514)
 If ZentajiPromptIdlePrepare(2000)<>1 Or UartAttach()<>1 : ProcedureReturn 2 : EndIf
 If zenMemoryGraphicsBase<>0
  If ZentajiNeonConsoleStart()<>1 Or ZentajiNeonConsoleBind()<>1 : ZentajiPayloadRecoveryFailed($5C01,"Console graphics failed (0x5C01): TrueType/Vulkan startup could not acquire the display.") : EndIf
 EndIf
 gBootTicks=Ticks()
 MessagesStart()
 If WallClockInit()<>1 : ProcedureReturn 3 : EndIf
 PutBuildIdLine(#ANVIL_BUILD,#ANVIL_BUILD_DATE,#ANVIL_BUILD_TIME)
 PutIdLine() : PutProcessorLine()
 ; A host-file ROM boot has no selected disk. It explicitly uses disk0;
 ; a disk ROM boot keeps the exact selected instance from the valid context.
 If source=1
  ZentajiStorageFromBoot(context,1)
 Else
  ZentajiStorageConfigure(0,1)
 EndIf
 If HwStorageUp()<>0
  If SettingsLoad()=0 And SettingsLastError()<>#SET_ERR_NO_FILE
   UartWriteStr(SettingsErrorText()) : PrintNl()
  EndIf
 EndIf
 If TimeBoot()=0 : UartWriteStr(TimeBootErrorText()) : PrintNl() : EndIf
 If ZentajiClockSeed()=0 : PrintN("RTC time is unavailable; the software clock keeps its existing source.") : EndIf
 ZentajiNetworkInit()
 If zenMemoryGraphicsBase=0
  If AnvilPromptServicesBind(@ZentajiNetworkService)<>1 : ProcedureReturn 2 : EndIf
 EndIf
 If ZentajiInputStart()=0 : PrintN("Native input is unavailable; serial input remains available.") : EndIf
 If AnvilPromptIdleWaitBind(@ZentajiPromptEventIdleWait)<>1 : ProcedureReturn 2 : EndIf
 BootFileWait()
 PrintN("Type help for the available commands.")
 AnvilCommandLoop()
 If zeOpen<>0
  If HwLinkClose()=0 : ZentajiPayloadRecoveryFailed($5B08,"Monitor exit failed (0x5B08): Ethernet ownership changed.") : EndIf
 EndIf
 If zenShellReset<>0
  PrintN("Resetting Zentaji through the boot ROM.")
 Else
  PrintN("Anvil stopped.")
 EndIf
 UartDrain()
 If ZentajiInputPayload(1,0)=0 : ZentajiPayloadRecoveryFailed($5B06,"Monitor exit failed (0x5B06): native input ownership changed.") : EndIf
 If ZentajiNeonConsoleStop()<>1 : ZentajiPayloadRecoveryFailed($5C01,"Monitor exit failed (0x5C01): graphics work could not retire.") : EndIf
 If ZentajiTextRelease()=0 : ZentajiPayloadRecoveryFailed($5B05,"Monitor exit failed (0x5B05): native text or display ownership changed.") : EndIf
 If ZentajiPromptIdleRelease()=0 : ProcedureReturn 4 : EndIf
 UartOff()
 If zenShellReset<>0
  PokeQ(#ZEN_MONITOR_POWER+$50,$5E7)
 EndIf
 ProcedureReturn 0
EndProcedure
