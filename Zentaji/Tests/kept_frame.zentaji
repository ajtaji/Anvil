; Publish two real Neon frames. The host checks every pixel of the second
; after the payload exits and the monitor has presented its own console.
EnableFloatingPoint
XIncludeFile "Anvil/Math/float32.pbi"
XIncludeFile "Anvil/Hal/neon_service_api.pbi"
XIncludeFile "Anvil/Graphics/neon_service_client.pbi"
Procedure.i Main(services.i)
 If NeonServiceBind(services,#NEON_SERVICE_VULKAN)<>0 : ProcedureReturn $BAD01 : EndIf
 If NeonServiceOpen()<>0 : ProcedureReturn $BAD02 : EndIf
 If NeonServiceBegin(0.0,0.0,1.0,1.0)<>0 : ProcedureReturn $BAD03 : EndIf
 If NeonServiceEnd()<>0 : ProcedureReturn $BAD04 : EndIf
 If NeonServiceBegin(0.0,1.0,0.0,1.0)<>0 : ProcedureReturn $BAD05 : EndIf
 If NeonServiceBox(128.0,96.0,128.0,64.0,1.0,0.0,0.0,1.0)<>0 : ProcedureReturn $BAD06 : EndIf
 If NeonServiceEnd()<>0 : ProcedureReturn $BAD07 : EndIf
 If NeonServiceClose()<>0 : ProcedureReturn $BAD08 : EndIf
 ProcedureReturn $123456780000002A
EndProcedure
