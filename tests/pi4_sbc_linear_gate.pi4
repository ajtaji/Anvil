XIncludeFile "Anvil/Hal/aarch64_counter.pbi"

; Physical exact encoder differential:1024 full frames, both channel modes,
; history continuity, extremes, impulses, ramps and pseudorandom samples.
; UART never opened. E1C00000 holds framecount/oldticks/newticks at54MHz.
XIncludeFile "../RaspberryPi4/Lib/mmu.pi4"
XIncludeFile "../Anvil/Audio/sbc.pbi"
Global Dim BeforeHistory.w(80)
Global Dim RefHistory.w(80)
Global Dim RefSub.w(128)
Global Dim RefEncoded.a(68)
Procedure.i BenchTicks()
  ProcedureReturn A64CounterRead()
EndProcedure
Procedure SbcAnalyzeReference()
  Protected block.i,i.i,j.i,k.i,sum.i,v.i
  For block=0 To 15
    For i=79 To 8 Step -1 : SbcHistory(i)=SbcHistory(i-8) : Next
    For i=0 To 7 : SbcHistory(i)=SbcPcm(block*8+7-i) : Next
    For i=0 To 15
      sum=0
      For j=0 To 4 : k=i+j*16 : sum=sum+SbcHistory(k)*PeekW(?SbcProto+k*2) : Next
      SbcY(i)=SbcSar(sum,16)
    Next
    For k=0 To 7
      sum=0
      For i=0 To 15 : sum=sum+SbcY(i)*PeekW(?SbcCos+(k*16+i)*2) : Next
      v=SbcSar(sum,12)
      If v>32767 : v=32767 : ElseIf v< -32767 : v= -32767 : EndIf
      SbcSub(block*8+k)=v
    Next
  Next
EndProcedure
Procedure SbcEncodeReference()
  Protected i.i, k.i, crc.i, bit.i
  SbcAnalyzeReference()
  SbcScaleFactors()
  SbcAllocate()
  SbcEncoded(0)=$9C : SbcEncoded(1)=$F1|(SbcStereo<<3) : SbcEncoded(2)=28 : SbcEncoded(3)=0
  For k=0 To 3+SbcStereo*4 : SbcEncoded(4+k)=(SbcScale(k*2)<<4)|SbcScale(k*2+1) : Next
  If SbcCrcReady=0
    ; CRC-8, polynomial $1D, MSB first: table form of the bitwise update.
    For i=0 To 255
      crc=i
      For bit=0 To 7
        If crc&$80 : crc=((crc<<1)!$1D)&255 : Else : crc=(crc<<1)&255 : EndIf
      Next
      SbcCrcTable(i)=crc
    Next
    SbcCrcReady=1
  EndIf
  crc=15
  For i=1 To 7+SbcStereo*4
    If i<>3 : crc=SbcCrcTable((crc!SbcEncoded(i))&255) : EndIf
  Next
  SbcEncoded(3)=crc : SbcBitValue=0 : SbcBitCount=0 : SbcByte=8+SbcStereo*4
  SbcPack()
EndProcedure
Procedure.i Main(services.i)
 Protected stereo.i,mode.i,frame.i,i.i,v.i,seed.i=12345,count.i,*pet,begin.i,oldTicks.i,newTicks.i
 MmuClearNc() : MmuAddNc($08A00000,$09200000) : MmuAddNc($08100000,$08180000)
 If MmuBuildTables($00800000) : ProcedureReturn 12 : EndIf
 MmuEnableCached() : *pet=0
 For stereo=0 To 1
  SbcStereo=stereo : SbcStereo=stereo
  For mode=0 To 7
   For i=0 To 79 : SbcHistory(i)=0 : Next
   For frame=0 To 63
    For i=0 To 127
     Select mode
      Case 0 : v=0
      Case 1 : v=32767
      Case 2 : v=-32768
      Case 3 : v=32767 : If (i & 1)<>0 : v=-32768 : EndIf
      Case 4 : v=((frame*128+i)*47 & $FFFF)-32768
      Case 5 : seed=(seed*1664525+1013904223) & $FFFFFFFF : v=((seed>>16) & $FFFF)-32768
      Case 6 : v=0 : If i=(frame*11)%(128) : v=32767 : EndIf
      Case 7 : v=frame*511-16384
     EndSelect
     SbcPcm(i)=v
    Next
    For i=0 To 79 : BeforeHistory(i)=SbcHistory(i) : Next
    begin=BenchTicks() : SbcEncodeReference() : oldTicks=oldTicks+BenchTicks()-begin
    For i=0 To 67 : RefEncoded(i)=SbcEncoded(i) : Next
    For i=0 To 127 : RefSub(i)=SbcSub(i) : Next
    For i=0 To 79 : RefHistory(i)=SbcHistory(i) : SbcHistory(i)=BeforeHistory(i) : Next
    begin=BenchTicks() : SbcEncode() : newTicks=newTicks+BenchTicks()-begin
    For i=0 To 63+stereo*4
     If SbcEncoded(i)<>RefEncoded(i) : PokeI($E1C00020,mode) : PokeI($E1C00028,frame) : MmuDisableCachedFlushed() : ProcedureReturn 81 : EndIf
    Next
    For i=0 To 127
     If SbcSub(i)<>RefSub(i) : MmuDisableCachedFlushed() : ProcedureReturn 82 : EndIf
    Next
    For i=0 To 79
     If SbcHistory(i)<>RefHistory(i) : MmuDisableCachedFlushed() : ProcedureReturn 83 : EndIf
    Next
    count+1 : If *pet : pet() : EndIf
   Next
  Next
 Next
 PokeI($E1C00000,count) : PokeI($E1C00008,oldTicks) : PokeI($E1C00010,newTicks)
 MmuDisableCachedFlushed() : ProcedureReturn 0
EndProcedure
